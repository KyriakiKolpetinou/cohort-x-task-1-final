</person-group><article-title>Nutrition of neonates with congenital heart disease: Existing evidence, conflicts and concerns</article-title><source>J. Matern. Fetal Neonatal Med.</source><year>2020</year><volume>33</volume><fpage>2487</fpage><lpage>2492</lpage><pub-id pub-id-type="doi">10.1080/14767058.2018.1548602</pub-id><pub-id pub-id-type="pmid">30608033</pub-id>

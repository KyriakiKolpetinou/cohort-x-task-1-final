<article-id pub-id-type="publisher-id">995</article-id><article-id pub-id-type="doi">10.1186/s12245-025-00995-0</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>Novice point-of-care ultrasound for the assessment of acute dyspnea in the emergency department</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>O&#x02019;Brien</surname><given-names>Joseph</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Caja</surname><given-names>Kevin R.</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Tabbut</surname><given-names>Matthew P.</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0003-2818-190X</contrib-id><name><surname>Schrock</surname><given-names>Jon W.</given-names></name><address><email>jschrock@metrohealth.org</email></address><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01fbz6h17</institution-id><institution-id institution-id-type="GRID">grid.239638.5</institution-id><institution-id institution-id-type="ISNI">0000 0001 0369 638X</institution-id><institution>Department of Emergency Medicine, </institution><institution>Denver Health Medical Center, </institution></institution-wrap>Denver, CO USA </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05j4p5w63</institution-id><institution-id institution-id-type="GRID">grid.411931.f</institution-id><institution-id institution-id-type="ISNI">0000 0001 0035 4528</institution-id><institution>Deparment of Emergency Medicine, </institution><institution>MetroHealth Medical Center, </institution></institution-wrap>Cleveland, OH USA </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/051fd9666</institution-id><institution-id institution-id-type="GRID">grid.67105.35</institution-id><institution-id institution-id-type="ISNI">0000 0001 2164 3847</institution-id><institution>Case Western Reserve University School of Medicine, </institution></institution-wrap>Cleveland, OH USA </aff></contrib-group><pub-date pub-type="epub"><day>16</day><month>10</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>16</day><month>10</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>18</volume><elocation-id>204</elocation-id><history><date date-type="received"><day>20</day><month>4</month><year>2025</year></date><date date-type="accepted"><day>1</day><month>9</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">Dyspnea is one of the most common presentations to the ED. The goal of this study was to determine the diagnostic accuracy of POCUS examination completed by a medical student for several causes of dyspnea.</p></sec><sec><title>Methods</title><p id="Par2">A prospective observational study was conducted in the ED of an academic center. Adult patients (&#x02265;&#x02009;18 yo) who presented to the emergency room with dyspnea were enrolled in the study. The study investigator was a medical student who was blinded to the clinical work up. Standardized POCUS examinations were performed following a modified BLUE protocol to identify the dyspnea etiology as one of the following diagnoses: asthma/COPD, acute heart failure, pneumonia, pulmonary embolism, pneumothorax, and non-diagnostic. POCUS diagnoses were compared to the clinical diagnosis made by the treating emergency physician.</p></sec><sec><title>Results</title><p id="Par3">250 patients were enrolled in the study. 99 (39.6%) patients were male, and 136 (54.4%) patients identified as Black. POCUS demonstrated high sensitivity and specificity for diagnosing asthma/COPD, acute heart failure, pneumonia, and pneumothorax. Concordance was optimal (0.8&#x02009;&#x0003c;&#x02009;<italic>k</italic>&#x02009;&#x0003c;&#x02009;1) for the diagnosis of asthma/COPD, acute decompensated heart failure; good (0.6&#x02009;&#x0003c;&#x02009;<italic>k</italic>&#x02009;&#x0003c;&#x02009;0.8) for pneumonia and non-diagnostic; and moderate (0.4&#x02009;&#x0003c;&#x02009;<italic>k</italic>&#x02009;&#x0003c;&#x02009;0.6) for pneumothorax and pulmonary embolism. Overall concordance was optimal (<italic>k</italic>&#x02009;=&#x02009;0.84).</p></sec><sec><title>Conclusion</title><p id="Par4">POCUS examinations completed by a medical student demonstrated acceptable diagnostic accuracy for asthma/COPD, acute heart failure, and pneumonia. Medical student POCUS examinations could be used for risk stratification to identify patients that require additional diagnostic imaging.</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1186/s12245-025-00995-0.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Point-of-care-ultrasound (POCUS)</kwd><kwd>Dyspnea</kwd><kwd>Diagnostics</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer-Verlag GmbH Germany, part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par5">Dyspnea is one of the most common presenting symptoms in the emergency department. Numerous underlying diseases can present with a chief complaint of dyspnea, ranging from acute problems like pulmonary embolism to more chronic issues such as anemia [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>]. Due to the wide range of acuity, quickly and accurately determining the cause of the dyspnea is paramount. While physical examination and a thorough history can often elicit the cause of dyspnea, an estimated 30&#x02013;50% of cases require further diagnostic evaluation [<xref ref-type="bibr" rid="CR2">2</xref>]. Patients with dyspnea are often initially evaluated with a chest X-ray and may require subsequent chest CT scans, exposing the patient to radiation [<xref ref-type="bibr" rid="CR3">3</xref>]. These diagnostic tools have limited use in pregnant women and children, as well as the critically injured patient. Thus, there is a need for an early diagnostic tool to guide intervention for the dyspneic patient who presents to the emergency room.</p><p id="Par6">Point-of-care ultrasound (POCUS) represents a diagnostic tool to determine the underlying etiology of a patient&#x02019;s dyspnea and inform the appropriate intervention. Indeed, several studies have applied POCUS to evaluate dyspnea, with mixed results [<xref ref-type="bibr" rid="CR4">4</xref>&#x02013;<xref ref-type="bibr" rid="CR6">6</xref>]. Several of these studies only examined cardiac etiologies for dyspnea [<xref ref-type="bibr" rid="CR7">7</xref>, <xref ref-type="bibr" rid="CR8">8</xref>]whereas others were limited by small sample sizes [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR10">10</xref>]. Moreover, most of these studies were conducted by expert sonographers with years of ultrasound experience [<xref ref-type="bibr" rid="CR6">6</xref>]. While it is useful to know the diagnostic accuracy of POCUS from an experienced sonographer, there are relatively few fellowship trained emergency medicine physicians in ultrasound. Many institutions train emergency physicians in basic and advanced sonography techniques. However, emergency medicine physicians often face time constraints and a high caseload, requiring them to prioritize efficiently in their clinical decision-making process. In contrast, medical students typically have fewer responsibilities and more time to dedicate to tasks such as performing POCUS examinations. As a result, medical students can aid in the diagnosis and timely management of dyspnea patients in the emergency department by using POCUS. Thus, there is a need to determine the accuracy and prognostic value of POCUS completed by a novice sonographer in evaluating the dyspneic patient in the emergency room setting.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Study design</title><p id="Par7">This prospective observational study was conducted in the Emergency Department of MetroHealth Medical Center between January 2024&#x02014;April 2024. Patients eligible for inclusion included adults&#x02009;&#x02265;&#x02009;18 years of age who presented to the emergency room with dyspnea listed as one of their complaints. Patients&#x02009;&#x0003c;&#x02009;18 years of age, pregnant patients, non-English speaking patients, prisoners, and those with altered mental status were excluded from the study. The study investigator was blinded to the patient&#x02019;s clinical workup and only saw the chief complaint recorded in the triage note before scanning the patient. Demographic data, medical history, clinical data, and ultrasound findings were collected. Based on ultrasound findings, a diagnosis was made by the study investigator. The following diagnoses were considered: asthma/COPD, acute heart failure, pneumonia, pulmonary embolism, pneumothorax, and non-diagnostic. At a later time point, medical interventions in the emergency department, clinical diagnosis, and outcomes were collected through chart review. The final composite clinical diagnosis as determined by the treating emergency medicine physician was obtained through chart review and used as the gold standard to compare to the ultrasound diagnosis. A secondary analysis was performed to examine the time it took to perform the POCUS examination compared to the time it took to obtain a chest X-ray (CXR). Time-to-CXR was chosen because CXR is a commonly ordered diagnostic test for the dyspnea work up and strongly influences the clinical diagnosis. In other words, time-to-CXR acts as proxy for the time it takes the clinician to make a clinical diagnosis. In total, 250 patients were enrolled in this study. This study was reviewed and approved by the Institutional Review Board, ensuring compliance with ethical standards and regulatory requirements.</p></sec><sec id="Sec4"><title>Ultrasound protocol</title><p id="Par8">The study investigator was a fourth-year medical student who completed a one-month ultrasound clerkship to obtain basic proficiency. Each POCUS examination was performed using a multiprobe machine (Phillips Sparq Diagnostic Ultrasound System, 2014) following a systematic, standardized protocol. A modified bedside lung ultrasound examination (BLUE) protocol [<xref ref-type="bibr" rid="CR2">2</xref>] was developed through consultation with fellowship-trained emergency medicine physicians in ultrasound (Supplemental Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>). In this modified BLUE protocol, lung ultrasound was performed with a 6- to 13-MHz linear probe using longitudinal scans on the anterior chest, midaxillary line, and posterior (PLAPS point) line. Transthoracic echocardiography was performed with 1- to 5-MHz curved array probe to assess the heart in three windows&#x02014;the parasternal long axis, apical, and subxiphoid view. POCUS examination was performed with the patient in supine or near-to-supine position.</p></sec><sec id="Sec5"><title>Study definitions</title><p id="Par9">Ultrasound diagnoses were made following our standardized protocol (Supplemental Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>). Pulmonary edema was diagnosed with the presence of lung sliding with a B-profile, or at least 3 B lines which emanate from the pleural line, move with lung sliding, and extend to the periphery of the field [<xref ref-type="bibr" rid="CR1">1</xref>]. Pneumonia was diagnosed with the presence of shred sign, lung consolidation, hepatization of the lung, abolished lung sliding due to thickened pleura, dynamic air bronchograms, confluent B-lines, and/or subpleural consolidations [<xref ref-type="bibr" rid="CR1">1</xref>]. Pulmonary embolism was diagnosed with the presence of D-sign indicating right ventricle strain [<xref ref-type="bibr" rid="CR2">2</xref>]. Asthma or COPD were diagnosed as the presence of A-profile with lung sliding and/or atelectasis with static bronchograms in a patient with a suggestive medical history. Pneumothorax was diagnosed with the absence of lung sliding and identification of a lung point [<xref ref-type="bibr" rid="CR1">1</xref>]. A non-diagnostic, or rule-out, diagnosis was made in the absence of any of the above findings.</p></sec><sec id="Sec6"><title>Statistical analysis</title><p id="Par10">Patient characteristics are described as frequency counts and percentages, mean&#x02009;&#x000b1;&#x02009;standard deviation, or median and the interquartile range, as appropriate based on the univariable data distribution. The sensitivity, specificity, positive predictive value, negative predictive value, accuracy, positive likelihood ratio, and negative likelihood ratio were determined for asthma/COPD, acute heart failure, pneumonia, pulmonary embolism, pneumothorax, and non-diagnostic finding for POCUS by comparing to the ultimate clinical diagnosis made in the emergency department. Statistical analysis was conducted in R (Linux version 4.1.0, <ext-link ext-link-type="uri" xlink:href="http://www.r-project.org/">http://www.r-project.org/</ext-link>) using the <italic>dyplyr</italic> package. All statistical tests were two-sided, and <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05 was used to indicate statistical significance.</p></sec></sec><sec id="Sec7"><title>Results</title><sec id="Sec8"><title>Study population</title><p id="Par11">Two-hundred and fifty patients with dyspnea included in their chief complaint were evaluated using POCUS. Ninety-nine (39.6%) patients who participated were men (Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>). The majority of patients self-identified as Black, with White and Hispanic as the second and third most common groups, respectively. Eighty-seven (34.8%) patients were tachypneic and 75 (30%) patients were tachycardic upon initial presentation to the emergency department. Forty-nine (19.6%) patients had low oxygen saturation measurements (SpO2&#x02009;&#x0003c;&#x02009;92%) upon initial presentation. Patients presented with a variety of past comorbidities, with hypertension, hyperlipidemia, and prior pneumonia as the three most common comorbidities. During the ED evaluation, 219 (87.6%) patients underwent CXR, 49 (19.6%) underwent CT imaging, and 22 (8.8%) underwent formal ECHO imaging.</p><p id="Par12">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Baseline characteristics of the study population</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Characteristic</th><th align="left">Values</th></tr></thead><tbody><tr><td align="left">Age (years)</td><td align="left">56.6&#x02009;&#x000b1;&#x02009;16.02</td></tr><tr><td align="left">Men&#x02014;no. (%)</td><td align="left">99 (39.6)</td></tr><tr><td align="left" colspan="2">Race</td></tr><tr><td align="left">&#x02003;Black</td><td align="left">136 (54.4)</td></tr><tr><td align="left">&#x02003;White</td><td align="left">99 (39.6)</td></tr><tr><td align="left">&#x02003;Hispanic</td><td align="left">24 (9.6)</td></tr><tr><td align="left">&#x02003;Other</td><td align="left">14 (5.6)</td></tr><tr><td align="left">&#x02003;Short of breath duration (days)</td><td align="left">3 (5.75)</td></tr><tr><td align="left">&#x02003;Systolic blood pressure (mmHg)</td><td align="left">142.3&#x02009;&#x000b1;&#x02009;24.3</td></tr><tr><td align="left">&#x02003;Diastolic blood pressure (mmHg)</td><td align="left">84.5&#x02009;&#x000b1;&#x02009;15.2</td></tr><tr><td align="left">&#x02003;Heart rate (bpm)</td><td align="left">89.4&#x02009;&#x000b1;&#x02009;18.5</td></tr><tr><td align="left">&#x02003;Respiratory rate (breathes/min)</td><td align="left">19.4&#x02009;&#x000b1;&#x02009;3.79</td></tr><tr><td align="left">&#x02003;Oxygen saturation (%)</td><td align="left">95.8&#x02009;&#x000b1;&#x02009;7.6</td></tr><tr><td align="left">&#x02003;BMI (kg/m<sup>2</sup>)</td><td align="left">32.3&#x02009;&#x000b1;&#x02009;10.2</td></tr><tr><td align="left" colspan="2">Comorbidities</td></tr><tr><td align="left">&#x02003;Asthma&#x02014;no (%)</td><td align="left">92 (36.8)</td></tr><tr><td align="left">&#x02003;Alcohol use disorder&#x02014;no (%)</td><td align="left">45 (18.0)</td></tr><tr><td align="left">&#x02003;CABG&#x02014;no (%)</td><td align="left">5 (2.0)</td></tr><tr><td align="left">&#x02003;Coronary artery disease (CAD)&#x02014;no (%)</td><td align="left">39 (15.6)</td></tr><tr><td align="left">&#x02003;Congestive heart failure (CHF)&#x02014;no (%)</td><td align="left">51 (20.4)</td></tr><tr><td align="left">&#x02003;COPD&#x02014;no (%)</td><td align="left">76 (30.4)</td></tr><tr><td align="left">&#x02003;Hyperlipidemia&#x02014;no (%)</td><td align="left">113 (45.2)</td></tr><tr><td align="left">&#x02003;Hypertension&#x02014;no (%)</td><td align="left">151 (60.4)</td></tr><tr><td align="left">&#x02003;Percutaneous intervention&#x02014;no (%)</td><td align="left">15 (6.0)</td></tr><tr><td align="left">&#x02003;Pericarditis&#x02014;no (%)</td><td align="left">14 (5.6)</td></tr><tr><td align="left">&#x02003;Pleural effusion&#x02014;no (%)</td><td align="left">67 (26.8)</td></tr><tr><td align="left">&#x02003;Pneumonia&#x02014;no (%)</td><td align="left">116 (46.4)</td></tr><tr><td align="left">&#x02003;Pneumothorax&#x02014;no (%)</td><td align="left">8 (3.2)</td></tr><tr><td align="left">&#x02003;Pulmonary embolism&#x02014;no (%)</td><td align="left">34 (13.6)</td></tr><tr><td align="left">&#x02003;Pulmonary edema&#x02014;no (%)</td><td align="left">59 (23.6)</td></tr><tr><td align="left">&#x02003;Substance use disorder&#x02014;no (%)</td><td align="left">51 (20.4)</td></tr><tr><td align="left">&#x02003;Positive ultrasound findings&#x02014;no (%)</td><td align="left">98 (39.2)</td></tr><tr><td align="left">&#x02003;Ultrasound examination length (minutes)</td><td align="left">10.4&#x02009;&#x000b1;&#x02009;4.1</td></tr><tr><td align="left">&#x02003;Time to CXR (minutes)</td><td align="left">102.1&#x02009;&#x000b1;&#x02009;88.8</td></tr></tbody></table><table-wrap-foot><p>Numerical variables are displayed as mean&#x02009;&#x000b1;&#x02009;standard deviation or median (IQR), as appropriate. Categorical variables are displayed as number of patients, followed by percentage. Vital signs were collected as the patient&#x02019;s first set of vitals recorded in triage</p><p><italic>Abbreviations</italic>: <italic>BMI</italic>&#x000a0;body mass index, <italic>CABG</italic>&#x000a0;coronary artery bypass grafting, <italic>COPD&#x000a0;</italic>chronic obstructive pulmonary disease</p></table-wrap-foot></table-wrap>
</p></sec><sec id="Sec9"><title>Ultrasound findings</title><p id="Par13">Of the 250 patients who underwent POCUS examination, 152 (60.8%) were negative for any pathology, while 98 (39.2%) were positive for pathology. In our study, the most common final composite diagnosis was a non-diagnostic (<italic>n</italic>&#x02009;=&#x02009;121), or rule-out diagnosis, in which they had normal sonography findings and had another diagnosis causing their shortness of breath outside of the etiologies included in this study. (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). Other causes of shortness of breath not included in the study varied widely, including acute coronary syndrome, COVID-19, influenza, and anxiety. These etiologies were all categorized together as a &#x0201c;non-diagnostic&#x0201d; finding because they lack any abnormal pathology that can be reliably detected by sonography. The most common pathological finding was asthma/COPD exacerbation, occurring in 66 (26.4%) patients. Acute decompensated heart failure was the second most common pathology, occurring in 32 (12.8%) of patients. Pneumothorax and pulmonary embolism were relatively rare pathologies, occurring in 1 and 5 patients, respectively.</p><p id="Par14">The sensitivity, specificity, positive predictive value, negative predictive value, positive likelihood ratio, negative likelihood ratio, and accuracy of POCUS for the various dyspnea etiologies are reported in Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>. POCUS demonstrated high diagnostic accuracy across various etiologies of dyspnea, with sensitivity ranging from 60.0 to 100.0% and specificity ranging from 93.0 to 99.2%. POCUS showed excellent performance in diagnosing asthma/COPD, acute heart failure, and non-diagnostic cases, with sensitivity and specificity exceeding 80.00% and 90.0%, respectively. While sensitivity for pneumonia and pulmonary embolism was moderate (80% and 60%, respectively), specificity remained high (&#x0003e;&#x02009;97%). Pneumothorax was identified with 100% sensitivity and 99.20% specificity.</p><p id="Par15">
<table-wrap id="Tab2"><label>Table 2</label><caption><p>Diagnostic accuracy of POCUS for dyspnea etiologies</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Primary Diagnosis</th><th align="left">Prevalence</th><th align="left">Sensitivity, % (95% CI)</th><th align="left">Specificity, % (95% CI)</th><th align="left">PPV, % (95% CI)</th><th align="left">NPV, % (95% CI)</th><th align="left">+ LR (95% CI)</th><th align="left">&#x02014;LR (95% CI)</th><th align="left">Accuracy, % (95% CI)</th></tr></thead><tbody><tr><td align="left">Asthma/COPD</td><td align="left">26.4</td><td align="left">88.1 (77.8&#x02014;94.7)</td><td align="left">96.2 (92.3&#x02014;98.5)</td><td align="left">89.4 (80.2&#x02014;94.6)</td><td align="left">95.6 (91.9&#x02014;97.7)</td><td align="left">23.2 (11.1&#x02014;47.9)</td><td align="left">0.12 (0.06&#x02014;0.24)</td><td align="left">94.0 (90.3&#x02014;96.6)</td></tr><tr><td align="left">Acute Heart Failure</td><td align="left">12.8</td><td align="left">81.3 (63.4&#x02014;92.8)</td><td align="left">99.1 (96.7&#x02014;99.9)</td><td align="left">92.9 (76.4&#x02014;98.1)</td><td align="left">97.3 (94.6&#x02014;98.7)</td><td align="left">88.56 (22.1&#x02014;355.4)</td><td align="left">0.19 (0.1&#x02014;0.4)</td><td align="left">96.8 (93.8&#x02014;98.6)</td></tr><tr><td align="left">Pneumonia</td><td align="left">10.0</td><td align="left">80.0 (59.3&#x02014;93.2)</td><td align="left">97.33 (94.3&#x02014;99.0)</td><td align="left">76.92 (59.6&#x02014;88.3)</td><td align="left">97.77 (95.2&#x02014;98.9)</td><td align="left">30.0 (13.3&#x02014;67.7)</td><td align="left">0.21 (0.1&#x02014;0.4)</td><td align="left">95.6 (92.3&#x02014;97.8)</td></tr><tr><td align="left">Pulmonary embolism</td><td align="left">2.0</td><td align="left">60.0 (14.7&#x02014;94.7)</td><td align="left">99.18 (97.1&#x02014;99.9)</td><td align="left">60.0 (24.1&#x02014;87.7)</td><td align="left">99.18 (97.7&#x02014;99.7)</td><td align="left">73.50 (15.5&#x02014;347.9)</td><td align="left">0.40 (0.1&#x02014;1.2)</td><td align="left">98.4 (95.9&#x02014;99.5)</td></tr><tr><td align="left">Pneumothorax</td><td align="left">0.4</td><td align="left">100.0 (2.5&#x02014;100)</td><td align="left">99.2 (97.1&#x02014;99.9)</td><td align="left">33.33 (11.2&#x02014;66.5)</td><td align="left">100.0 (98.5&#x02014;100)</td><td align="left">124.5 (31.3&#x02014;495.1)</td><td align="left">0.0</td><td align="left">99.2 (97.1&#x02014;99.9)</td></tr><tr><td align="left">Non-diagnostic</td><td align="left">48.4</td><td align="left">83.47 (75.6&#x02014;89.6)</td><td align="left">93.02 (87.2&#x02014;96.8)</td><td align="left">91.82 (85.6&#x02014;95.5)</td><td align="left">85.71 (80.0&#x02014;89.9)</td><td align="left">11.96 (6.3&#x02014;22.5)</td><td align="left">0.18 (0.1&#x02014;0.3)</td><td align="left">88.4 (83.8&#x02014;92.1)</td></tr></tbody></table><table-wrap-foot><p>The final composite diagnosis made in the emergency department was used as the gold standard to assess the prognostic value of POCUS. Accuracy was calculated as the sum of the true positives and true negatives divided by the sum of the true positives, true negatives, false positives, and false negatives</p><p><italic>Abbreviations</italic>: <italic>COPD</italic>&#x000a0;chronic obstructive pulmonary disease, <italic>PPV</italic>&#x000a0;positive predictive value, <italic>NPV</italic>&#x000a0;negative predictive value, <italic>+ LR</italic>&#x000a0;positive likelihood ratio, <italic>LR</italic>&#x000a0;negative likelihood ratio</p></table-wrap-foot></table-wrap>
</p><p id="Par16">Concordance between the POCUS and clinical diagnoses for each disease is shown in Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>. Concordance was optimal (0.8&#x02009;&#x0003c;&#x02009;<italic>k</italic>&#x02009;&#x0003c;&#x02009;1) for the diagnosis of asthma/COPD, acute decompensated heart failure; good (0.6&#x02009;&#x0003c;&#x02009;<italic>k</italic>&#x02009;&#x0003c;&#x02009;0.8) for pneumonia and non-diagnostic; and moderate (0.4&#x02009;&#x0003c;&#x02009;<italic>k</italic>&#x02009;&#x0003c;&#x02009;0.6) for pneumothorax and pulmonary embolism. Overall concordance was optimal (<italic>k</italic>&#x02009;=&#x02009;0.84).</p><p id="Par17">
<table-wrap id="Tab3"><label>Table 3</label><caption><p>Concordance between POCUS diagnosis and clinical diagnosis</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Primary Diagnosis</th><th align="left">K value</th></tr></thead><tbody><tr><td align="left">Asthma/COPD</td><td align="left">0.85</td></tr><tr><td align="left">Acute Heart Failure</td><td align="left">0.85</td></tr><tr><td align="left">Pneumonia</td><td align="left">0.76</td></tr><tr><td align="left">Pulmonary embolism</td><td align="left">0.49</td></tr><tr><td align="left">Pneumothorax</td><td align="left">0.59</td></tr><tr><td align="left">Non-diagnostic</td><td align="left">0.78</td></tr><tr><td align="left">Total</td><td align="left">0.84</td></tr></tbody></table></table-wrap>
</p><p id="Par18">The receiver-operating characteristic (ROC) curve (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>) demonstrates the diagnostic accuracy of POCUS examinations performed by a medical student for identifying various causes of dyspnea. The area under the curve (AUC) was highest for pneumothorax (0.996), indicating near-perfect discrimination, followed by asthma/COPD (0.921) and acute heart failure (0.902), reflecting excellent diagnostic accuracy. POCUS also showed strong performance for pneumonia (0.887) and non-diagnostic cases (0.882). The lowest AUC was observed for pulmonary embolism (0.796), though it still demonstrated acceptable discrimination. Overall, the ROC curves indicate that POCUS examinations conducted by a medical student achieved good-to-excellent diagnostic accuracy across most dyspnea etiologies.</p><p id="Par19">
<fig id="Fig1"><label>Fig. 1</label><caption><p>Receiver operating characteristic (ROC) curves for dyspnea etiologies. AUC: area under the curve</p></caption><graphic xlink:href="12245_2025_995_Fig1_HTML" id="d33e801"/></fig>
</p><p id="Par20">In addition to providing accurate findings, POCUS examinations can be obtained quickly. The mean time it took to complete a POCUS scan in this study was 10.4&#x000a0;min, compared to the 102.1&#x000a0;min it took, on average, to obtain a CXR. The time to POCUS diagnosis was significantly shorter than the time it took to obtain a CXR (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.0001, Welch&#x02019;s Two Sample t-test).</p></sec></sec><sec id="Sec10"><title>Discussion</title><p id="Par21">In this study, we demonstrate that POCUS examinations completed by a novice sonographer offer reasonably accurate prognostic value. Of the 250 scans completed, 210 (84%) correctly identified the underlying diagnosis. This study demonstrated that ultrasound diagnosis was concordant with the clinical diagnosis, with a high concordance value (<italic>k</italic>&#x02009;=&#x02009;0.84) validating POCUS examination completed by a novice sonographer as a reliable early diagnosis tool in the dyspneic patient. The significant reduction in POCUS examination time compared to the time it took to obtain a CXR further illustrates the potential role of medical student-led POCUS examination in expediting diagnosis and early treatment.</p><p id="Par22">The most common pathology found in this study was asthma/COPD (26.4% of diagnoses). The sensitivity and specificity were similar to what have been reported in the published literature [<xref ref-type="bibr" rid="CR6">6</xref>, <xref ref-type="bibr" rid="CR11">11</xref>]. Similarly, POCUS exhibited favorable sensitivity, specificity, PPV, and NPV for acute heart failure and pneumonia. The specificity for acute heart failure was comparable to the pooled data (99.08% vs. 96%), but the sensitivity is lower compared to studies with POCUS examinations conducted by ultrasound experts (81.25% vs. 95%).<sup>5&#x02013;8</sup> Similarly, the sensitivity for diagnosing pneumonia was lower (80% vs. 92%) than published studies conducted by ultrasound experts [<xref ref-type="bibr" rid="CR6">6</xref>, <xref ref-type="bibr" rid="CR12">12</xref>&#x02013;<xref ref-type="bibr" rid="CR15">15</xref>]. </p><p id="Par23">Medical student POCUS examinations were highly specific (99%) for pulmonary embolism but demonstrated poor sensitivity (60%). The low sensitivity may be due to our standardized ultrasound protocol not performing a compression ultrasound to look for DVT. This compression ultrasound was not performed because it is more invasive and would require a chaperone to be present in the room while the medical student scanned the great saphenous vein; this increase in emergency department resources and personnel was antithetical to the goals of this study.</p><p id="Par24">In non-diagnostic cases, POCUS demonstrated moderate sensitivity (83%) and specificity (93%), with a low negative likelihood ratio (0.18), indicating its ability to effectively rule out certain conditions. Ruling out cases with POCUS could reduce the need for CXR, which would reduce cost, time spent in the emergency department, and unnecessary radiation exposure. Overall, these findings underscore the potential of POCUS as a valuable diagnostic tool in the evaluation of dyspnea, offering clinicians a rapid and accurate means of assessing various underlying pathologies.</p><p id="Par25">There are several limitations with this study. For example, it can be questioned whether the study investigator would still be considered a novice sonographer after 250 scans. However, it should be noted that the study investigator only received 1-month of formal sonography training. Over the course of the 250 scans, it is possible that the investigator was repeating the same mistakes. Over the first 125 scans, the study investigator accurately identified the cause of the dyspnea in 102 (81.6%) instances. Over the subsequent 125 scans, the study investigator correctly identified the etiology in 113 (90.4%) instances, indicating a modest improvement in performance.</p><p id="Par26">This study was conducted during influenza season, leading to many flu patients receiving non-diagnostic scans. This study may have also excluded the most acutely ill patients. Because informed consent is required to participate, acutely ill patients who were unconscious or had an altered mental status were ineligible for study inclusion. These patients would likely have had pathologic sonographic findings but were unable to be captured in the study population. Moreover, some patients who were acutely dyspneic declined to participate due to their condition, which may have influenced the results. The low number of pneumothorax and pulmonary embolism makes it difficult to draw conclusions on the diagnostic accuracy of medical student POCUS for these conditions. To overcome these limitations, we enrolled a large number of patients to try to capture a wide range of dyspnea etiologies. Out of the 49 published studies investigating the use of POCUS for determining the cause of dyspnea, this is the fourth largest study [<xref ref-type="bibr" rid="CR6">6</xref>]. </p><p id="Par27">This study demonstrated the important role of novice-conducted POCUS in the emergency room setting for assessing the etiology of dyspnea. The study showed good concordance between the POCUS diagnosis and clinical diagnosis, with the POCUS examination occurring much faster than the standard clinical work-up of obtaining a CXR for the dyspneic patient. The significant reduction in time is highly valuable, as a rapid diagnosis and early intervention can be critical for a patient&#x02019;s prognosis. Moreover, the reasonable prognostic values of medical student POCUS for asthma/COPD, acute heart failure, and pneumonia illustrate a potential role for medical students or other novice sonographers in early diagnosis and risk stratification to identify patients who should undergo further imaging. Future work should attempt to replicate this study with additional medical students acting as sonographers to determine the inter-user variability.</p></sec><sec id="Sec11" sec-type="supplementary-material"><title>Supplementary Information</title><p>
<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="12245_2025_995_MOESM1_ESM.docx"><caption><p>Supplementary Material 1.</p></caption></media></supplementary-material>
</p></sec></body><back><fn-group><fn><p><bold>Publisher&#x02019;s Note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn></fn-group><ack><title>Acknowledgements</title><p>The authors would like to thank the ultrasound division of the MetroHealth Emergency Department for technical support.</p></ack><notes notes-type="author-contribution"><title>Authors&#x02019; contributions</title><p>All authors have made significant contributions to the study and have read and approved the final manuscript. All authors contributed towards the conception, design, and methodology of this study. J.S. helped with conceptualization, methodology, logistical support, and technical support. M.P. and K.C. provided logistical and technical support, methodology, and ultrasound expertise and training. J.O. performed the data collection, analysis, and manuscript writing. All authors reviewed, provided feedback, and prepared the manuscript text.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>The authors have no funding sources to disclose for this research.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>Raw data are available upon request and can be obtained by contacting the primary investigator.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par28">This study was conducted in accordance with the ethical principles outlined in the Declaration of Helsinki and was approved by the MetroHealth Medical Center Institutional Review Board (Protocol Number: MOD00002150). All participants provided informed consent prior to the study.</p><p id="Par29">Written informed consent was obtained from all participants.</p></notes><notes id="FPar2"><title>Consent for publication</title><p id="Par30">The authors affirm that all participants provided informed consent for publication of their pooled demographic data.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests</title><p id="Par31">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Lichtenstein</surname><given-names>DA</given-names></name><name><surname>Mezi&#x000e8;re</surname><given-names>GA</given-names></name></person-group><article-title>Relevance of lung ultrasound in the diagnosis of acute respiratory failure the BLUE protocol</article-title><source>Chest</source><year>2008</year><volume>134</volume><fpage>117</fpage><lpage>25</lpage><pub-id pub-id-type="doi">10.1378/chest.07-2800</pub-id><pub-id pub-id-type="pmid">18403664</pub-id>

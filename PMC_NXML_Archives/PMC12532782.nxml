</mixed-citation></citation-alternatives></ref><ref id="CR9"><label>9.</label><citation-alternatives><element-citation id="ec-CR9" publication-type="journal"><person-group person-group-type="author"><name><surname>Kajimoto</surname><given-names>K</given-names></name><name><surname>Madeen</surname><given-names>K</given-names></name><name><surname>Nakayama</surname><given-names>T</given-names></name><name><surname>Tsudo</surname><given-names>H</given-names></name><name><surname>Kuroda</surname><given-names>T</given-names></name><name><surname>Abe</surname><given-names>T</given-names></name></person-group><article-title>Rapid evaluation by lung-cardiac-inferior Vena Cava (LCI) integrated ultrasound for differentiating heart failure from pulmonary disease as the cause of acute dyspnea in the emergency setting</article-title><source>Cardiovasc Ultrasound</source><year>2012</year><pub-id pub-id-type="doi">10.1186/1476-7120-10-49</pub-id><pub-id pub-id-type="pmid">23210515</pub-id>
</element-citation><mixed-citation id="mc-CR9" publication-type="journal">Kajimoto K, Madeen K, Nakayama T, Tsudo H, Kuroda T, Abe T. Rapid evaluation by lung-cardiac-inferior Vena Cava (LCI) integrated ultrasound for differentiating heart failure from pulmonary disease as the cause of acute dyspnea in the emergency setting. Cardiovasc Ultrasound. 2012. 10.1186/1476-7120-10-49.<pub-id pub-id-type="pmid">23210515</pub-id>

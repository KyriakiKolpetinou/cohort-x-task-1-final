</th><th align="left" valign="middle" style="border-top:solid thin;border-bottom:solid thin" rowspan="1" colspan="1">A</th><th align="left" valign="middle" style="border-top:solid thin;border-bottom:solid thin" rowspan="1" colspan="1">B</th><th align="left" valign="middle" style="border-top:solid thin;border-bottom:solid thin" rowspan="1" colspan="1">C</th></tr></thead><tbody><tr><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">1</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">Type BMI</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">=MAX(0, A1 &#x02212; 23.83)</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">=0.472 &#x000d7; B1</td></tr><tr><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">2</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">Type diabetic duration</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">=MAX(0, 12 &#x02212; A2)</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">=&#x02212;0.718 &#x000d7; B2</td></tr><tr><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">3</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">Type hemoglobin A1c</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">=MAX(6.7 &#x02212; A3)</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">=9.88 &#x000d7; B3</td></tr><tr><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">4</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">
</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">
</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">
</td></tr><tr><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">5</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">SSS</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">

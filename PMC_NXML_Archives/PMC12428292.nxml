<name><surname>Mark</surname><given-names>D.B.</given-names></name>
<name><surname>Shaw</surname><given-names>L.</given-names></name>
<name><surname>Harrell</surname><given-names>F.E.</given-names></name>
<name><surname>Hlatky</surname><given-names>M.A.</given-names><suffix>Jr.</suffix></name>
<name><surname>Lee</surname><given-names>K.L.</given-names></name>

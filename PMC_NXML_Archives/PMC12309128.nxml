</mixed-citation></citation-alternatives></ref><ref id="CR5"><label>5.</label><citation-alternatives><element-citation id="ec-CR5" publication-type="journal"><person-group person-group-type="author"><name><surname>Anand</surname><given-names>KJ</given-names></name><name><surname>Hickey</surname><given-names>PR</given-names></name></person-group><article-title>Halothane-morphine compared with high-dose sufentanil for anesthesia and postoperative analgesia in neonatal cardiac surgery</article-title><source>N Engl J Med</source><year>1992</year><volume>326</volume><fpage>1</fpage><lpage>9</lpage><pub-id pub-id-type="pmid">1530752</pub-id>

</mixed-citation></citation-alternatives></ref><ref id="CR10"><label>10.</label><citation-alternatives><element-citation id="ec-CR10" publication-type="journal"><person-group person-group-type="author"><name><surname>Kuhl</surname><given-names>C</given-names></name><name><surname>Csoszi</surname><given-names>T</given-names></name><name><surname>Piskorski</surname><given-names>W</given-names></name><name><surname>Miszalski</surname><given-names>T</given-names></name><name><surname>Lee</surname><given-names>JM</given-names></name><name><surname>Otto</surname><given-names>PM</given-names></name></person-group><article-title>Efficacy and safety of half-dose gadopiclenol versus full-dose gadobutrol for contrast-enhanced body MRI</article-title><source>Radiology</source><year>2023</year><volume>308</volume><issue>1</issue><fpage>e222612</fpage><pub-id pub-id-type="doi">10.1148/radiol.222612</pub-id><pub-id pub-id-type="pmid">37462494</pub-id>

br">17</xref>,<xref rid="B18-jcm-13-02859" ref-type="bibr">18</xref>,<xref rid="B19-jcm-13-02859" ref-type="bibr">19</xref>,<xref rid="B20-jcm-13-02859" ref-type="bibr">20</xref>,<xref rid="B21-jcm-13-02859" ref-type="bibr">21</xref>,<xref rid="B22-jcm-13-02859" ref-type="bibr">22</xref>,<xref rid="B23-jcm-13-02859" ref-type="bibr">23</xref>,<xref rid="B24-jcm-13-02859" ref-type="bibr">24</xref>,<xref rid="B25-jcm-13-02859" ref-type="bibr">25</xref>].</p></caption><graphic xlink:href="jcm-13-02859-g003" position="float"/></fig><fig position="float" id="jcm-13-02859-f004"><label>Figure 4</label><caption><p>Knee pain score results in subgroups: (<bold>a</bold>) method of administration; (<bold>b</bold>) type of control group. (<bold>a</bold>) Heterogeneity: Q Oral = 3.7, df = 4 (<italic toggle="yes">p</italic> = 0.45); Q IA = 1.6, df = 2 (<italic toggle="yes">p</italic> = 0.44); Q SC not applicable; Q Total = 1.05, df = 2 (<italic toggle="yes">p</italic> = 0.59). (<bold>b</bold>) Heterogeneity: Q Placebo = 4.1, df = 5 (<italic toggle="yes">p</italic> = 0.54); Q Active comparator = 1.1, df = 2 (<italic toggle="yes">p</italic> = 0.58); Q Total = 3.1, df = 1 (<italic toggle="yes">p</italic> = 0.08). CI&#x02014;confidence interval [<xref rid="B17-jcm-13-02859" ref-type="bibr">17</xref>,<xref rid="B18-jcm-13-02859" ref-type="bibr">18</xref>,<xref rid="B19-jcm-13-02859" ref-type="bibr">19</xref>,<xref rid="B20-jcm-13-02859" ref-type="bibr">20</xref>,<xref rid="B21-jcm-13-02859" ref-type="bibr">21</xref>,<xref rid="B22-jcm-13-02859" ref-type="bibr">22</xref>,<xref rid="B23-jcm-13-02859" ref-type="bibr">23</xref>,<xref rid="B24-jcm-13-02859" ref-type="bibr">24</xref>,<xref rid="B25-jcm-13-02859" ref-type="bibr">25</xref>].</p></caption><graphic xlink:href="jcm-13-02859-g004" position="float"/></fig><fig position="float" id="jcm-13-02859-f005"><label>Figure 5</label><caption><p>Knee function score results. Heterogeneity: Q = 16.2, df = 6 (<italic toggle="yes">p</italic> = 0.01); T2 = 0.04, I2 = 63.0%. CI&#x02014;confidence interval [<xref rid="B17-jcm-13-02859" ref-type="bibr">17</xref>,<xref rid="B18-jcm-13-02859" ref-type="bibr">18</xref>,<xref rid="B19-jcm-13-02859" ref-type="bibr">19</xref>,<xref rid="B20-jcm-13-02859" ref-type="bibr">20</xref>,<xref rid="B21-jcm-13-02859" ref-type="bibr">21</xref>,<xref rid="B23-jcm-13-02859" ref-type="bibr">23</xref>,<xref rid="B25-jcm-13-02859" ref-type="bibr">25</xref>].</p></caption><graphic xlink:href="jcm-13-02859-g005" position="float"/></fig><fig position="float" id="jcm-13-02859-f006"><label>Figure 6</label><caption><p>Knee function score results in subgroups: (<bold>a</bold>) method of administration; (<bold>b</bold>) type of control group. (<bold>a</bold>) Heterogeneity: Q Oral = 3.4, df = 4 (<italic toggle="yes">p</italic> = 0.50); Q IA not applicable; Q SC not applicable; Q Total = 7.1, df = 2 (<italic toggle="yes">p</italic> = 0.03). (<bold>b</bold>) Heterogeneity: Q Placebo = 2.8, df = 3 (<italic toggle="yes">p</italic> = 0.42); Q Active comparator = 0.7, df = 2 (<italic toggle="yes">p</italic> = 0.71); Q Total = 6.1, df = 1 (<italic toggle="yes">p</italic> = 0.01). CI&#x02014;confidence interval [<xref rid="B17-jcm-13-02859" ref-type="bibr">17</xref>,<xref rid="B18-jcm-13-02859" ref-type="bibr">18</xref>,<xref rid="B19-jcm-13-02859" ref-type="bibr">19</xref>,<xref rid="B20-jcm-13-02859" ref-type="bibr">20</xref>,<xref rid="B21-jcm-13-02859" ref-type="bibr">21</xref>,<xref rid="B23-jcm-13-02859" ref-type="bibr">23</xref>,<xref rid="B25-jcm-13-02859" ref-type="bibr">25</xref>].</p></caption><graphic xlink:href="jcm-13-02859-g006" position="float"/></fig><fig position="float" id="jcm-13-02859-f007"><label>Figure 7</label><caption><p>Knee stiffness score results. Heterogeneity: Q = 14.1, df = 5 (<italic toggle="yes">p</italic> = 0.01); T2 = 0.04, I2 = 64.6%. CI&#x02014;confidence interval [<xref rid="B17-jcm-13-02859" ref-type="bibr">17</xref>,<xref rid="B18-jcm-13-02859" ref-type="bibr"
<article-meta><article-id pub-id-type="pmid">41367653</article-id><article-id pub-id-type="pmc">12683548</article-id><article-id pub-id-type="doi">10.1183/23120541.00238-2025</article-id><article-id pub-id-type="publisher-id">00238-2025</article-id><article-version article-version-type="VoR" vocab="JAV" vocab-identifier="http://www.niso.org/publications/rp/RP-8-2008.pdf">Version of Record</article-version><article-categories><subj-group subj-group-type="heading"><subject>Original Research Article</subject><subj-group><subject>Cystic Fibrosis</subject></subj-group></subj-group><subj-group subj-group-type="hwp-journal-coll"><subject>3</subject></subj-group></article-categories><title-group><article-title>Early life elevations of methionine oxidation and ornithine track and predict cystic fibrosis structural lung disease</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Mansour</surname><given-names>Sarah</given-names></name><xref rid="af1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Slimmen</surname><given-names>Lisa J.M.</given-names></name><xref rid="af2" ref-type="aff">2</xref><xref rid="af3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Silva</surname><given-names>George L.</given-names></name><xref rid="af4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><name><surname>Collins</surname><given-names>Genoah L.</given-names></name><xref rid="af1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0002-3496-7776</contrib-id><name><surname>Giacalone</surname><given-names>Vincent D.</given-names></name><xref rid="af1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Margaroli</surname><given-names>Camilla</given-names></name><xref rid="af1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>H.A.N. Manai</surname><given-names>Badies</given-names></name><xref rid="af3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0002-2760-2867</contrib-id><name><surname>Mager</surname><given-names>David</given-names></name><xref rid="af3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Estev&#x000e3;o</surname><given-names>Silvia C.</given-names></name><xref rid="af2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>Kim</surname><given-names>Susan O.</given-names></name><xref rid="af1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Moncada-Giraldo</surname><given-names>Diego</given-names></name><xref rid="af1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0003-3111-6527</contrib-id><name><surname>Lyles</surname><given-names>James T.</given-names></name><xref rid="af1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>W.J. Unger</surname><given-names>Wendy</given-names></name><xref rid="af2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>Peng</surname><given-names>Limin</given-names></name><xref rid="af5" ref-type="aff">5</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0002-8081-2986</contrib-id><name><surname>Esther</surname><given-names>Charles R.</given-names></name><xref rid="af6" ref-type="aff">6</xref><xref rid="af7" ref-type="aff">7</xref></contrib><contrib contrib-type="author"><name><surname>Caudri</surname><given-names>Daan</given-names></name><xref rid="af3" ref-type="aff">3</xref><xref rid="af8" ref-type="aff">8</xref></contrib><contrib contrib-type="author"><name><surname>Rao</surname><given-names>Padma</given-names></name><xref rid="af9" ref-type="aff">9</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0001-6000-3180</contrib-id><name><surname>Shanthikumar</surname><given-names>Shivanthan</given-names></name><xref rid="af10" ref-type="aff">10</xref><xref rid="af11" ref-type="aff">11</xref><xref rid="af12" ref-type="aff">12</xref></contrib><contrib contrib-type="author"><name><surname>Ranganathan</surname><given-names>Sarath</given-names></name><xref rid="af10" ref-type="aff">10</xref><xref rid="af11" ref-type="aff">11</xref><xref rid="af12" ref-type="aff">12</xref></contrib><contrib contrib-type="author"><name><surname>Stick</surname><given-names>Stephen M.</given-names></name><xref rid="af13" ref-type="aff">13</xref></contrib><contrib contrib-type="author"><name><surname>Guglani</surname><given-names>Lokesh</given-names></name><xref rid="af1" ref-type="aff">1</xref><xref rid="af4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><name><surname>Tirouvanziam</surname><given-names>Rabindra</given-names></name><xref rid="af1" ref-type="aff">1</xref><xref rid="af4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0002-2210-9176</contrib-id><name><surname>Janssens</surname><given-names>Hettie M.</given-names></name><xref rid="af3" ref-type="aff">3</xref></contrib><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0003-3211-7935</contrib-id><name><surname>Chandler</surname><given-names>Joshua D.</given-names></name><xref rid="af1" ref-type="aff">1</xref><xref rid="af4" ref-type="aff">4</xref><xref rid="cor1" ref-type="corresp"/></contrib></contrib-group><aff id="af1"><label>1</label>Department of Pediatrics, Emory University School of Medicine, Atlanta, GA, USA</aff><aff id="af2"><label>2</label>Department of Pediatrics, Laboratory of Pediatrics, Erasmus MC-Sophia Children's Hospital, University Medical Center Rotterdam, Rotterdam, The Netherlands</aff><aff id="af3"><label>3</label>Department of Pediatrics, Division of Respiratory Medicine and Allergology, Erasmus MC-Sophia Children's Hospital, University Medical Center Rotterdam, Rotterdam, The Netherlands</aff><aff id="af4"><label>4</label>Center for CF and Airways Disease Research, Children's Healthcare of Atlanta, Atlanta, GA, USA</aff><aff id="af5"><label>5</label>Department of Biostatistics, Emory University School of Public Health, Atlanta, GA, USA</aff><aff id="af6"><label>6</label>Pediatric Pulmonology, University of North Carolina at Chapel Hill, Chapel Hill, NC, USA</aff><aff id="af7"><label>7</label>Marsico Lung Institute, University of North Carolina at Chapel Hill, Chapel Hill, NC, USA</aff><aff id="af8"><label>8</label>Department of Radiology and Nuclear Medicine, Erasmus MC, University Medical Center Rotterdam, Rotterdam, The Netherlands</aff><aff id="af9"><label>9</label>Medical Imaging, Royal Children's Hospital, Parkville, VIC, Australia</aff><aff id="af10"><label>10</label>Respiratory and Sleep Medicine, Royal Children's Hospital, Parkville, VIC, Australia</aff><aff id="af11"><label>11</label>Respiratory Diseases, Murdoch Children's Research Institute, Parkville, VIC, Australia</aff><aff id="af12"><label>12</label>Department of Paediatrics, University of Melbourne, Parkville, VIC, Australia</aff><aff id="af13"><label>13</label>Perth Children's Hospital, Perth, WA, Australia</aff><author-notes><corresp id="cor1">Corresponding author: Joshua Chandler (<email>joshua.chandler@emory.edu</email>)</corresp></author-notes><pub-date pub-type="collection"><month>11</month><year>2025</year></pub-date><pub-date pub-type="epub"><day>01</day><month>12</month><year>2025</year></pub-date><volume>11</volume><issue>6</issue><elocation-id>00238-2025</elocation-id><history><date date-type="received"><day>18</day><month>2</month><year>2025</year></date><date date-type="accepted"><day>09</day><month>3</month><year>2025</year></date></history><permissions><copyright-statement>Copyright &#x000a9;The authors 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbynclicense">https://creativecommons.org/licenses/by-nc/4.0/</ali:license_ref><license-p>This version is distributed under the terms of the Creative Commons Attribution Non-Commercial Licence 4.0. For commercial reproduction rights and permissions contact <email xlink:href="mailto:permissions@ersnet.org">permissions@ersnet.org</email></license-p></license></permissions><abstract abstract-type="graphical" id="abstract-11"><title id="title-11">Graphical abstract</title><p>
<fig position="anchor" id="GA1"><caption><p>Overview of the study. AUC: Area under the curve; BAL: bronchoalveolar lavage; MetO: Methionine sulfoxide; %OxMet: percentage of methionine oxidation.</p></caption><graphic xlink:href="00238-2025.GA01" position="float"/></fig>
</p></abstract><abstract><sec><title>Introduction</title><p>Early cystic fibrosis (CF) lung disease monitoring is crucial for understanding responses to therapy and preventing progressive pulmonary decline. Structural lung disease (SLD) is a major cause of pulmonary decline in CF. We aimed to identify metabolites in CF bronchoalveolar lavage (BAL) associated with and predictive of SLD.</p></sec><sec><title>Methods</title><p>We applied untargeted metabolomics to 84 BAL samples from a cross-sectional cohort of 67 clinically stable children with CF aged 1&#x02013;5&#x02005;years across two sites. We used a linear mixed-effects model to select metabolites associated with SLD, BAL neutrophils, and myeloperoxidase (MPO) and neutrophil elastase (NE) activities. An independent longitudinal cohort of infants who either did or did not exhibit bronchiectasis by age 9 years was analysed to determine whether metabolites associated with SLD could also predict future lung disease.</p></sec><sec><title>Results</title><p>In the cross-sectional cohort, 10 BAL metabolites, including methionine sulfoxide (MetO), ornithine and <italic toggle="yes">N</italic>-acetylmethionine (NAcMet), were associated with SLD, neutrophils, MPO and NE. The percentage of methionine oxidation (%OxMet) and the arginine&#x02013;ornithine ratio were also associated with these outcomes. In the longitudinal cohort, MetO, %OxMet, ornithine and NAcMet predicted bronchiectasis development, and MetO plus ornithine was a more sensitive predictor than either alone. At age 0&#x02013;2&#x02005;years, these metabolites outperformed established biomarkers such as NE, MPO and interleukin-8.</p></sec><sec><title>Conclusions</title><p>We identified BAL metabolites associated with SLD, MPO and NE, detectable in the earliest stages of CF. MetO, %OxMet, NAcMet and ornithine predicted bronchiectasis development, outperforming established biomarkers. These metabolites reflect oxidising, proteolytic and other enzymatic activities of neutrophils, highlighting potential therapeutic avenues.</p></sec></abstract><abstract abstract-type="short" id="abstract-1"><title id="title-1">Shareable abstract</title><p><bold>Methionine sulfoxide, ornithine and <italic toggle="yes">N</italic>-acetylmethionine measured in BAL fluid from infants with cystic fibrosis outperformed neutrophil elastase and other conventional biomarkers as predictors of bronchiectasis later in life</bold>
<ext-link xlink:href="https://bit.ly/48h7V3Y" ext-link-type="uri">https://bit.ly/48h7V3Y</ext-link></p></abstract><funding-group><award-group id="funding-1"><funding-source>
<institution-wrap><institution>Hertz Family Foundation</institution></institution-wrap>
</funding-source></award-group><award-group id="funding-2"><funding-source>
<institution-wrap><institution>American Society of Hematology</institution><institution-id institution-id-type="doi">http://dx.doi.org/10.13039/100001422</institution-id></institution-wrap>
</funding-source><award-id>0000066883</award-id></award-group><award-group id="funding-3"><funding-source>
<institution-wrap><institution>National Health and Medical Research Council</institution><institution-id institution-id-type="doi">http://dx.doi.org/10.13039/501100000925</institution-id></institution-wrap>
</funding-source><award-id>APP1183640</award-id></award-group><award-group id="funding-4"><funding-source>
<institution-wrap><institution>Dutch Cystic Fibrosis Foundation</institution></institution-wrap>
</funding-source><award-id>NCFS-HITCF</award-id></award-group><award-group id="funding-5"><funding-source>
<institution-wrap><institution>Sophia Foundation</institution><institution-id institution-id-type="doi">http://dx.doi.org/10.13039/100022790</institution-id></institution-wrap>
</funding-source><award-id>SSWO19-21</award-id></award-group><award-group id="funding-6"><funding-source>
<institution-wrap><institution>Cystic Fibrosis Foundation</institution><institution-id institution-id-type="doi">http://dx.doi.org/10.13039/100000897</institution-id></institution-wrap>
</funding-source><award-id>ESTHER22Y2-SVC</award-id><award-id>ESTHER24R0</award-id><award-id>TIROUV19A0</award-id></award-group><award-group id="funding-7"><funding-source>
<institution-wrap><institution>National Heart, Lung, and Blood Institute</institution><institution-id institution-id-type="doi">http://dx.doi.org/10.13039/100000050</institution-id></institution-wrap>
</funding-source><award-id>HL126603</award-id><award-id>HL150658</award-id><award-id>HL159058</award-id></award-group></funding-group></article-meta></front><body><sec sec-type="intro" id="s2"><title>Introduction</title><p>Cystic fibrosis (CF) is a genetic disorder caused by variants impacting the expression, stability and function of the CF transmembrane conductance regulator (CFTR) protein [<xref rid="C1" ref-type="bibr">1</xref>]. Insufficient CFTR anion channel activity leads to multiorgan disease, including airway obstruction, chronic inflammation and recurrent lung infections, culminating in progressive pulmonary decline [<xref rid="C2" ref-type="bibr">2</xref>, <xref rid="C3" ref-type="bibr">3</xref>]. From the earliest stages of postnatal life, CF lungs progressively develop structural lung disease (SLD) driven by neutrophilic inflammation [<xref rid="C4" ref-type="bibr">4</xref>]. Neutrophils entering CF airways undergo transcriptional and functional reprogramming, including enhanced primary granule exocytosis, releasing myeloperoxidase (MPO) and neutrophil elastase (NE) into the airway lumen [<xref rid="C5" ref-type="bibr">5</xref>, <xref rid="C6" ref-type="bibr">6</xref>]. In the airways, MPO and NE are robust predictors of CF lung disease severity and progression but may become measurable only after significant disease has occurred [<xref rid="C7" ref-type="bibr">7</xref>, <xref rid="C8" ref-type="bibr">8</xref>]. Paradoxically, CF neutrophils recruited to CF airways actively restrict their bacterial-killing capacity, leading to chronic colonisation [<xref rid="C9" ref-type="bibr">9</xref>].</p><p>Inflammation, infection and SLD remain at abnormally high levels in people with CF even after the initiation of CFTR modulators, although improvements from pre-treatment baseline have been noted in multiple studies [<xref rid="C10" ref-type="bibr">10</xref>, <xref rid="C11" ref-type="bibr">11</xref>, <xref rid="C12" ref-type="bibr">12</xref>, <xref rid="C13" ref-type="bibr">13</xref>]. Nevertheless, disease persists, and better monitoring and treatment of early-stage inflammatory pathology remains an unmet clinical need [<xref rid="C14" ref-type="bibr">14</xref>]. Unravelling pathways in lung inflammation offers valuable insights, potentially leading to new targets for anti-inflammatory therapies. However, assessing and monitoring airway inflammation in CF is still not common practice, as practical implementation is hampered by the complexity of analysis and a lack of consensus about the most sensitive biomarkers. Identifying biomarkers capable of sensitively predicting early CF SLD may be critical for optimising care and developing individualised treatment strategies [<xref rid="C15" ref-type="bibr">15</xref>].</p><p>Surveillance efforts in CF care programmes aim to slow or prevent progressive lung damage, targeting the earliest disease manifestations [<xref rid="C5" ref-type="bibr">5</xref>]. These initiatives have focused on SLD and airway fluid sampling to identify correlative and causative relationships between molecular, cellular and structural changes [<xref rid="C16" ref-type="bibr">16</xref>]. Metabolomics, the study of the small molecules of bioenergetics and cell signalling and their byproducts, is of increasing interest in CF research [<xref rid="C17" ref-type="bibr">17</xref>]. Multiple studies have demonstrated that CF-associated lung inflammation is correlated with the differential abundance of specific amino acids, phospholipids, ribonucleotides and oxidation products in bronchoalveolar lavage (BAL) fluid [<xref rid="C18" ref-type="bibr">18</xref>]. However, more research is needed to establish these metabolites as sensitive monitoring tools to track and predict early CF SLD.</p><p>Here, we applied mass spectrometry (MS)-based metabolomics to BAL fluid from very young children with CF and tested the relationships of metabolites with SLD and BAL neutrophils, MPO activity and NE activity. We used the Perth&#x02013;Rotterdam Annotated Grid Morphometric Analysis for CF (PRAGMA-CF) to quantify SLD, cytological determination of BAL leukocytes to quantify neutrophils, and assays of MPO and NE activities. Ultimately, metabolites selected by cross-sectional two-site analysis were applied in a third, longitudinal cohort to assess their potential as predictive biomarkers of future bronchiectasis, compared with conventional biomarkers of CF lung disease, such as NE.</p></sec><sec sec-type="methods" id="s3"><title>Methods</title><sec id="s3a"><title>Human subjects</title><p>The study was performed at CF care centres located at Emory University/Children's Healthcare of Atlanta (Emory/CHOA, Atlanta, USA), the Erasmus MC/Sophia Children's Hospital (Rotterdam, The Netherlands) and the Royal Children's Hospital (Melbourne, Australia) as part of the Integrated Monitoring Platform for Early Disease Events in Cystic Fibrosis (IMPEDE-CF; IRB00097352), the Inflammatory Markers in Broncho-Alveolar Lavage Fluid for Lung Disease in Infants with Cystic Fibrosis (I-BALL; ClinicalTrials.gov identifier NCT02907788) and the SYNERGY-PRESERVE sub-study of the Australian Respiratory Early Surveillance Team for Cystic Fibrosis (AREST-CF; Human Research Ethics Committee Approval Number 25054) programmes, respectively. BAL, chest computed tomography (CT) and clinical information were prospectively collected during clinically stable periods.</p></sec><sec id="s3b"><title>BAL collection</title><p>At all sites, BAL was performed under general anaesthesia after overnight fast. One mL of sterile saline per kg of body weight was instilled and recovered <italic toggle="yes">via</italic> a bronchoscope three times in the right middle lobe. A fourth rinse was performed in the most diseased lobe as judged by the bronchoscopist according to the chest CT, or in the lingula if no such lobe could be identified. BAL fluid was centrifuged to remove cells and then stored at &#x02212;80&#x02005;&#x002da;C until further analysis. Additional details are given in the <ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary information</ext-link>.</p></sec><sec id="s3c"><title>Chest CT</title><p>At Emory/CHOA, chest CTs with full inspiratory and expiratory breath holds were performed under sedation using a SOMATOM Flash scanner (Siemens). Free-breathing chest CT scans were acquired without anaesthesia using a SOMATOM Force ultra-fast scanner (Siemens) at the Erasmus MC/Sophia Children's Hospital and the Royal Children's Hospital. For both Emory/CHOA and Erasmus/Sophia sites, the PRAGMA-CF scoring was used to quantitatively determine total lung disease (%Dis), including bronchiectasis, bronchial wall thickening and mucus plugging [<xref rid="C16" ref-type="bibr">16</xref>]. CT scans from both sites were scored by a single blinded experienced observer.</p><sec id="s3c1"><title>Longitudinal cohort</title><p>At the Royal Children's Hospital, inspiratory CT scans from children aged 9&#x02005;years were reviewed by three clinicians, and scans were deemed as showing &#x0201c;no bronchiectasis&#x0201d; if all three reviewers agreed on the classification. Additional details are given in the <ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary information</ext-link>.</p></sec></sec><sec id="s3d"><title>Metabolomics</title><p>Metabolites were extracted from cell-free BAL fluid by mixing one volume of the fluid with two volumes of extraction solvent (50% acetonitrile, 50% methanol, and internal standards), vortexing and incubating on ice for 30&#x02005;min prior to centrifugation at 20&#x02009;000&#x02005;<italic toggle="yes">g</italic> and 4&#x02005;&#x000b0;C for 10&#x02005;min. Pooled quality controls (QCs) were generated from samples, and Standard Reference Material 1950 (SRM 1950; MilliporeSigma) was used as a reference control. Samples were processed in a randomised fashion to avoid bias. The extract was injected into iHILIC-p Classic (HILICON) columns prior to ionisation. Data were acquired using a Q Exactive High Field Orbitrap MS (ThermoFisher) in full scan for positive and negative modes. Metabolites were annotated, normalised and quantified using Compound Discoverer 3.3 (ThermoFisher). Reference standardisation was performed by comparison with SRM 1950 [<xref rid="C19" ref-type="bibr">19</xref>]. Additional details are given in the <ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary information</ext-link>.</p></sec><sec id="s3e"><title>Neutrophil effector protein assays</title><p>MPO activity was quantified by Amplex Red oxidation following immunocapture [<xref rid="C20" ref-type="bibr">20</xref>]. The results were calibrated using MPO from human neutrophils (Millipore). NE activity was measured using the FRET-based NEmo-1 probe (Sirius Fine Chemicals SiChem GmbH), except for PRESERVE samples assayed by conventional spectrophotometry [<xref rid="C14" ref-type="bibr">14</xref>]. Data were acquired using a SpectraMax iD3 and SoftMax Pro version 7.0.3 (Molecular Devices, San Jose, CA, USA). Samples were assayed with duplicate or triplicate technical replicates.</p></sec><sec id="s3f"><title>Statistics</title><p>Linear mixed-effects models, p-value calculation and false discovery rate adjustments by the method of Benjamini&#x02013;Hochberg were carried out in R (version 4.3.1). Receiver operating characteristic (ROC) analysis and curves were performed on GraphPad Prism (version 10.2.3). Additional details are given in the <ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary information</ext-link>.</p></sec></sec><sec sec-type="results" id="s4"><title>Results</title><sec id="s4a"><title>Subject demographics</title><p>Subject clinical characteristics for the Emory/CHOA and Erasmus MC/Sophia Children's Hospital cohorts are shown in <xref rid="TB1" ref-type="table">table 1</xref>. The former cohort had significantly more male participants, while the latter had a higher rate of reactive antibiotic use. 64 out of the 67 Erasmus subjects were receiving prophylactic antibiotic treatment. In addition, the latter cohort was generally older with a wider age range, but this difference was not statistically significant. There were no other significant differences. None of the listed variables was found to significantly influence or correlate with %Dis (<xref rid="TB1" ref-type="table">table 1</xref>), and the use of lumacaftor&#x02013;ivacaftor in a subset of patients did not appear to affect clinical outcomes such as airway neutrophils (<ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary table S1</ext-link>). Using principal component analysis, we did not observe global metabolome variation by study site (<ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary figure S1A</ext-link>). Using a linear mixed-effects model (LMM) that accounted for site as a covariate, 13 drugs, excipients and endogenous metabolites were identified as unequally distributed (<ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary figure S1B</ext-link>). These included <italic toggle="yes">N</italic>4-acetylsulfamethoxazole and sulfamethoxazole (antibiotics), paracetamol (anti-inflammatory), and vanillin, galactitol and saccharin (excipients), which could be explained by distinct treatment regimens at each site. Other metabolites that varied by site were endogenous, namely acylcarnitines 8:0, 12:1 and 18:0, glycochenodeoxycholic acid, lysophosphatidylethanolamine 22:6 and tyrosine. The basis of site differences in these metabolites is unclear but may be related to the aforementioned differences in antibiotic use or other treatment differences.</p><table-wrap position="float" id="TB1"><label>TABLE 1</label><caption><p>Cross-sectional cohort clinical and demographic information</p></caption><table frame="hsides" rules="groups"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><th align="left" rowspan="1" colspan="1"/><th align="center" colspan="2" rowspan="1">Emory</th><th align="center" colspan="2" rowspan="1">Erasmus</th><th align="center" rowspan="1" colspan="1">p-value</th></tr><tr><th align="left" rowspan="1" colspan="1">Categorical variable</th><th align="center" rowspan="1" colspan="1">n</th><th align="center" rowspan="1" colspan="1">%</th><th align="center" rowspan="1" colspan="1">n</th><th align="center" rowspan="1" colspan="1">%</th><th align="center" rowspan="1" colspan="1">Chi-square</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Visits</td><td align="center" rowspan="1" colspan="1">14</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">70</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Subjects</td><td align="center" rowspan="1" colspan="1">13</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">54</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Male</td><td align="center" rowspan="1" colspan="1">11</td><td align="center" rowspan="1" colspan="1">85</td><td align="center" rowspan="1" colspan="1">24</td><td align="center" rowspan="1" colspan="1">44</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Female</td><td align="center" rowspan="1" colspan="1">2</td><td align="center" rowspan="1" colspan="1">15</td><td align="center" rowspan="1" colspan="1">30</td><td align="center" rowspan="1" colspan="1">55</td><td align="center" rowspan="1" colspan="1">
<bold>0.022</bold>
</td></tr><tr><td align="left" rowspan="1" colspan="1">Pancreatic insufficiency</td><td align="center" rowspan="1" colspan="1">13</td><td align="center" rowspan="1" colspan="1">100</td><td align="center" rowspan="1" colspan="1">47</td><td align="center" rowspan="1" colspan="1">87</td><td align="center" rowspan="1" colspan="1">0.841</td></tr><tr><td align="left" rowspan="1" colspan="1">F508del homozygous</td><td align="center" rowspan="1" colspan="1">5</td><td align="center" rowspan="1" colspan="1">38</td><td align="center" rowspan="1" colspan="1">24</td><td align="center" rowspan="1" colspan="1">44</td><td align="center" rowspan="1" colspan="1">0.937</td></tr><tr><td align="left" rowspan="1" colspan="1">Using antibiotics (at time of visit)</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">7</td><td align="center" rowspan="1" colspan="1">47</td><td align="center" rowspan="1" colspan="1">67</td><td align="center" rowspan="1" colspan="1">
<bold>0.0242</bold>
</td></tr><tr><td align="left" rowspan="1" colspan="1">Modulator therapy (at time of visit)</td><td align="center" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">7</td><td align="center" rowspan="1" colspan="1">10</td><td align="center" rowspan="1" colspan="1">14</td><td align="center" rowspan="1" colspan="1">0.835</td></tr><tr><td align="left" rowspan="1" colspan="1">Positive BAL culture (at time of visit)<sup>#</sup></td><td align="center" rowspan="1" colspan="1">5</td><td align="center" rowspan="1" colspan="1">36</td><td align="center" rowspan="1" colspan="1">41</td><td align="center" rowspan="1" colspan="1">59</td><td align="center" rowspan="1" colspan="1">0.525</td></tr></tbody></table><table frame="hsides" rules="groups"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><th align="left" rowspan="1" colspan="1">Continuous variable</th><th align="center" rowspan="1" colspan="1">Median</th><th align="center" rowspan="1" colspan="1">IQR</th><th align="center" rowspan="1" colspan="1">Median</th><th align="center" rowspan="1" colspan="1">IQR</th><th align="center" rowspan="1" colspan="1">Mann&#x02013;Whitney U</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Age (months) at visit</td><td align="center" rowspan="1" colspan="1">29.5</td><td align="center" rowspan="1" colspan="1">25.7&#x02013;36.2</td><td align="center" rowspan="1" colspan="1">37.2</td><td align="center" rowspan="1" colspan="1">13.3&#x02013;59.8</td><td align="center" rowspan="1" colspan="1">0.322</td></tr><tr><td align="left" rowspan="1" colspan="1">Sweat chloride (mmol&#x000b7;l<sup>&#x02212;1</sup>)<sup>#</sup></td><td align="center" rowspan="1" colspan="1">99.0</td><td align="center" rowspan="1" colspan="1">89.0&#x02013;103</td><td align="center" rowspan="1" colspan="1">94.0</td><td align="center" rowspan="1" colspan="1">72.4&#x02013;112</td><td align="center" rowspan="1" colspan="1">0.705</td></tr><tr><td align="left" rowspan="1" colspan="1">%BAL neutrophils<sup>#</sup></td><td align="center" rowspan="1" colspan="1">11.3</td><td align="center" rowspan="1" colspan="1">4.7&#x02013;40.7</td><td align="center" rowspan="1" colspan="1">24</td><td align="center" rowspan="1" colspan="1">11.0&#x02013;40.0</td><td align="center" rowspan="1" colspan="1">0.22</td></tr><tr><td align="left" rowspan="1" colspan="1">%BAL macrophages<sup>#</sup></td><td align="center" rowspan="1" colspan="1">80.6</td><td align="center" rowspan="1" colspan="1">55.5&#x02013;82.5</td><td align="center" rowspan="1" colspan="1">69.0</td><td align="center" rowspan="1" colspan="1">47.1&#x02013;85.1</td><td align="center" rowspan="1" colspan="1">0.551</td></tr><tr><td align="left" rowspan="1" colspan="1">%BAL lymphocytes<sup>#</sup></td><td align="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">2.5&#x02013;10.8</td><td align="center" rowspan="1" colspan="1">4.3</td><td align="center" rowspan="1" colspan="1">3.0&#x02013;6.8</td><td align="center" rowspan="1" colspan="1">0.365</td></tr><tr><td align="left" rowspan="1" colspan="1">%BAL eosinophils<sup>#</sup></td><td align="center" rowspan="1" colspan="1">0</td><td align="center" rowspan="1" colspan="1">0.0&#x02013;0.7</td><td align="center" rowspan="1" colspan="1">0</td><td align="center" rowspan="1" colspan="1">0.0&#x02013;1.0</td><td align="center" rowspan="1" colspan="1">0.802</td></tr></tbody></table><table-wrap-foot><p>Clinical and demographic information for 84 visits by 67 clinically stable subjects across both sites (cross-sectional sample collections). Categorical variables were assessed using chi-square analysis, and continuous variables by were assessed using Mann&#x02013;Whitney U-test. Reported p-values indicate site differences for each variable. Fixed patient characteristics (sex, F508del status, sweat chloride and pancreatic insufficiency) were counted per unique subject, and variable characteristics (modulator status, BAL culture, antibiotic status, age and %BAL cell counts) were counted per visit. No Emory subject received prophylactic treatment. All subjects using cystic fibrosis transmembrane conductance regulator modulators were taking lumacaftor&#x02013;ivacaftor. IQR: interquartile range; BAL: bronchoalveolar lavage. <sup>#</sup>: Variable has incomplete data (one subject for sweat chloride and BAL culture, and another subject for leukocyte quantification); in addition, one subject's BAL cell counts were excluded because of a minor mucosal bleed during bronchoscopy that caused blood cell contamination of the BAL cells.</p></table-wrap-foot></table-wrap></sec><sec id="s4b"><title>Comparison of BAL metabolites from right middle lobe and lingula or most diseased lobe</title><p>A comparison of BAL metabolite content between the right middle lobe (RML; main study sample) and the lingula or the most diseased lobe by paired t-test revealed no statistically significant differences. Additionally, of the 208 BAL fluid metabolites detected, 146 (70.2%) showed positive correlations across both matrices (p&#x0003c;0.05, q&#x0003c;0.10), indicating highly comparable metabolomes across lung regions in early CF (<ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary figure S2</ext-link>). All subsequent analyses were conducted exclusively on the RML samples to maintain matrix consistency.</p></sec><sec id="s4c"><title>BAL metabolites associate with SLD and neutrophilic inflammation</title><p>Of the 84 collected BAL samples, 78 (Emory n=10, Erasmus n=68) had matching PRAGMA-CF scored chest CTs and were used to determine which metabolites associated with %Dis, a robust measure of total SLD. We focused on endogenous metabolites for this analysis, ignoring drugs and excipients (194 total). Using an LMM, 28 metabolites were selected as associated with %Dis, controlling for patient age (p&#x0003c;0.05 and q&#x0003c;0.10; <xref rid="F1" ref-type="fig">figure 1</xref> and <ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary figure S3</ext-link>). The most significant was <italic toggle="yes">N,N,N</italic>-trimethyllysine (TML; p=9.4&#x000d7;10<sup>&#x02212;11</sup>, q=0.000145), and most metabolites increased in abundance as %Dis increased. A similar approach was undertaken to identify metabolites associated with BAL neutrophils (%PMN) and macrophages (%Mac; n=83 each), as well as MPO (n=79) and NE (n=44) activities. 35 metabolites were significantly associated with %PMN and 34 were significantly associated with %Mac as determined by LMM, controlling for age (<xref rid="F2" ref-type="fig">figure 2</xref>), with 32 exhibiting opposing relationships across the two cell types (unsurprising considering that the pathogenesis of CF includes neutrophil dominance at the expense of macrophages) [<xref rid="C21" ref-type="bibr">21</xref>]. Forty-four metabolites were associated with MPO and 28 were associated with NE activities in BAL (<xref rid="F2" ref-type="fig">figure 2</xref>; detailed heatmaps are in <ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary figures S4 and S5</ext-link>). Taken together, metabolites associated with %PMN, MPO and NE overlap substantially and often correlate inversely with those associated with %Mac.</p><fig position="float" id="F1"><label>FIGURE 1</label><caption><p>Metabolites associated with structural lung disease measured by computed tomography (CT) (PRAGMA-CF %Dis). Linear mixed-effects model significant (p&#x0003c;0.05, q&#x0003c;0.10, n=78) metabolite names are listed to the left of the heatmap. Patient age distribution ranged from 12.2 to 64.1&#x02005;months (median 37.1&#x02005;months, interquartile range 15.4&#x02013;46.8 months). Peak areas within each row (metabolite) are auto-scaled by Z-scoring (red, high value; blue, low value). Corresponding %Dis for each subject are shown in the bar plot above the heatmap. Rows are ordered by ascending p-value (top row, smallest p-value; bottom row, largest p-value), with a total of 29 metabolites. PC: phosphatidylcholine; SM: sphingomyelin; AcCa: acylcarnitine.</p></caption><graphic xlink:href="00238-2025.01" position="float"/></fig><fig position="float" id="F2"><label>FIGURE 2</label><caption><p>Bronchoalveolar lavage (BAL) metabolomic composition in relation to neutrophil (PMN) and macrophage (Mac) content, myeloperoxidase (MPO) and neutrophil elastase (NE) activities. Bubble plot displaying metabolites associated with BAL fluid PMN and Mac percentages (n= 83), MPO activity (&#x000b5;g&#x000b7;mL<sup>&#x02212;1</sup>) (n=85) and NE activity (ng&#x000b7;mL<sup>&#x02212;1</sup>) (n=44). Metabolites were selected by linear mixed-effects model (p&#x0003c;0.05, q&#x0003c;0.10) for each dataset. Model coefficients are z-scored (negative coefficient, blue; positive coefficient, red). AcCa: acylcarnitine; LPC: lysophosphatidylcholine; LPE: lysophosphatidylethanolamine; SPH: sphingomyelin; PC: phosphatidylcholine.</p></caption><graphic xlink:href="00238-2025.02" position="float"/></fig><p>We next sought to determine which metabolites were robustly associated with SLD, inflammation and disease-associated effector proteins by comparing the results for the above tested variables (%Dis, %PMN, MPO and NE). We did not include %Mac in this analysis because it was consistently anti-correlated with %PMN. 10 metabolites were identified as significantly associated with all four variables: arginine, eicosadienoic acid, threonine, lysine, methionine, MetO, <italic toggle="yes">N</italic>-acetylmethionine (NAcMet), TML, ornithine and phenylalanine (<xref rid="F3" ref-type="fig">figure 3a</xref>). Significant metabolites from each variable list were submitted for KEGG pathway analysis (<xref rid="F3" ref-type="fig">figure 3b</xref>), which shows associations with arginine and proline metabolism (arginine, ornithine), methionine and cysteine metabolism (methionine, MetO, NAcMet), carnitine biosynthesis pathway (TML), lysine biosynthesis (lysine), and glycine, serine and threonine metabolism (threonine). Raw coefficients from pathway enrichment are shown in <ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary table S2</ext-link>.</p><fig position="float" id="F3"><label>FIGURE 3</label><caption><p>Metabolic signature of neutrophil-driven lung disease. a) Venn diagram representing all significant metabolites (p&#x0003c;0.05, q&#x0003c;0.10) with neutrophil elastase (NE) activity, myeloperoxidase (MPO) activity, neutrophil (PMN) content and/or PRAGMA-%Dis in bronchoalveolar lavage (BAL) fluid as dependent variables in a linear mixed-effects model (LMM). Metabolites significant in all models (10) are named to the right, in alphabetical order. b) KEGG pathway analysis results for significant metabolites (p&#x0003c;0.05, q&#x0003c;0.10) from models of PRAGMA-%Dis, PMN content, MPO activity or NE activity as dependent variable. Bubble sizes correspond to &#x02212;log<sub>10</sub>(p-value) for each metabolite per category. All metabolites are up-regulated in the pathways except ADP. Bubbles are color-coded based on the normalised coefficient within each dataset. GMP: guanosine monophosphate; CMP: cytidine monophosphate.</p></caption><graphic xlink:href="00238-2025.03" position="float"/></fig><p>We also tested whether these 10 metabolites, the percentage of methionine oxidation (%OxMet) and the arginine&#x02013;ornithine ratio (AOR) correlated with the same metabolites and ratios measured in matched blood (n=46 matched sample sets from a subset of the donors described in <xref rid="TB1" ref-type="table">table 1</xref>) and whether they performed as well as their BAL counterparts in the LMM for association with %Dis. Although NAcMet showed modest trends of correlation between blood and BAL and %Dis association, none of the metabolites tested passed FDR thresholds (<ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary table S3</ext-link>). Thus, blood-based analysis could not replace that of BAL.</p></sec><sec id="s4d"><title>BAL metabolites associated with neutrophil-driven SLD are impacted by pulmonary exacerbations and change with age</title><p>To determine whether the detected metabolites are affected by disease severity, we analysed the panel of 10 metabolites from <xref rid="F3" ref-type="fig">figure 3a</xref> and compared their concentrations in study subjects with those in CF subjects experiencing pulmonary exacerbations (PE) or with disease controls (DC) from the Emory/CHOA aerodigestive clinic (<xref rid="F4" ref-type="fig">figure 4a</xref>). Demographic information for PE and DC cohorts is shown in <ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary tables S4 and S5</ext-link>, respectively. All metabolites showed a significant increase in PE compared with CF or DC groups. We also analysed %OxMet and the AOR as important ratios giving insight into specific reaction mechanisms <italic toggle="yes">in vivo</italic> and negating any impact of variable BAL dilution [<xref rid="C20" ref-type="bibr">20</xref>, <xref rid="C22" ref-type="bibr">22</xref>]. %OxMet increased with PE, and was lower in DC than in CF, while AOR was lower in PE than in either CF or DC. Additionally, 9 out of 10 of these metabolites increased with CF patient age (the exception was NAcMet, which decreased), as did %OxMet, while AOR decreased with age (<xref rid="F4" ref-type="fig">figure 4b</xref>).</p><fig position="float" id="F4"><label>FIGURE 4</label><caption><p>Metabolite quantification across disease groups and age bins. a) Concentrations (log<sub>10</sub>(nM)) of the metabolites from the middle of the Venn diagram in <xref rid="F3" ref-type="fig">figure 3a</xref>. Metabolite peak areas were used to derive concentrations by comparison with Standard Reference Material (SRM) 1950. Cystic fibrosis (CF) patient samples are shown in blue, bronchoalveolar lavage (BAL) of CF pulmonary exacerbation (PE) visit samples in red, and BAL of disease controls from the Emory Aerodigestive (AD) clinic in green. All metabolites and ratios are statistically significant (p&#x0003c;0.05, q&#x0003c;0.1) between PE and other categories by Tukey's Honestly Significant Difference (HSD) <italic toggle="yes">post hoc</italic> test. Percentage of methionine oxidation (%OxMet) levels differ both between CF and PE and between CF and AD (p&#x0003c;0.05, q&#x0003c;0.1 each). b) Median peak areas for the core 10 metabolites were autoscaled within each metabolite and plotted row-wise. The z-scores, initially ranging from &#x02212;0.67 to 5.37, were adjusted to a scale of &#x02212;1 to 1 for enhanced visualisation. Age bins are shown at the bottom of the heatmap. Arginine, lysine and MetO demonstrated significant differences across all age bins, as determined by one-way analysis of variance (ANOVA) followed by Tukey's HSD <italic toggle="yes">post hoc</italic> test. Arginine, lysine and MetO demonstrated significant differences across all age bins, as determined by one-way ANOVA followed by Tukey's HSD <italic toggle="yes">post hoc</italic> test. AOR: arginine&#x02013;ornithine ratio; MetO: Methionine sulfoxide; NAcMet: <italic toggle="yes">N</italic>-acetylmethionine; NS: nonsignificant.</p></caption><graphic xlink:href="00238-2025.04" position="float"/></fig></sec><sec id="s4e"><title>Elevated MetO, %OxMet, NAcMet and ornithine predict later-life bronchiectasis</title><p>We sought to assess whether the metabolites selected by LMM could predict the development of bronchiectasis in later childhood. We analysed a longitudinal cohort of 28 well-matched individuals enrolled in the AREST-CF programme, called PRESERVE, who either did or did not exhibit bronchiectasis by age 9 years (<xref rid="TB2" ref-type="table">table 2</xref>). We analysed BAL fluid collected at 6&#x02005;months to 2&#x02005;years, averaging across repeated visits before conducting receiver operating characteristic (ROC) analysis, and compared the performance of the previously selected metabolites (except eicosadienoic acid, not detected in the longitudinal cohort) with well-established biomarkers of CF lung disease, <italic toggle="yes">i.e.</italic> NE and MPO activities, interleukin-8 (IL-8), and %PMN in BAL (<xref rid="F5" ref-type="fig">figure 5</xref>; n=12 who developed bronchiectasis and n=13 who did not). Subject visits from the same study aged 3&#x02013;6 years were analysed in the same way to compare performance at an older age (n=14, both groups). Metabolite abundances in the BAL samples were not impacted by variable durations of storage at &#x02212;80&#x02005;&#x002da;C (<ext-link xlink:href="https://publications.ersnet.org/lookup/doi/10.1183/23120541.00238-2025#supplementary" ext-link-type="uri">supplementary table S6</ext-link>).</p><fig position="float" id="F5"><label>FIGURE 5</label><caption><p>Receiver operating characteristics (ROC) curves for neutrophil (PMN), neutrophil elastase (NE), myeloperoxidase (MPO), interleukin-8 (IL-8), methionine sulfoxide (MetO), <italic toggle="yes">N</italic>-acetylmethionine (NAcMet), ornithine, percentage of methionine oxidation (%OxMet) and ornithine and MetO combination (p&#x0003c;0.05, ROC area&#x0003e;0.7, n BE&#x02212;=13, n BE+=12). a&#x02013;i) The curves were plotted based on the data from 13 subjects who developed bronchiectasis by age 9 years (BE+) and 12 subjects of the same age who did not develop bronchiectasis (BE&#x02212;). Data from repeat visits at ages &#x0003c;1, 1 and 2&#x02005;years were averaged when multiple visits were available. j&#x02013;r) ROC curves for the same variables as previous (p&#x0003c;0.05, ROC area&#x0003e;0.7, n BE&#x02212;=14, n BE+=14), but subjects are aged 3&#x02013;6 years. Data from repeated visits at age 3, 4, 5 or 6&#x02005;years were averaged when applicable.</p></caption><graphic xlink:href="00238-2025.05" position="float"/></fig><table-wrap position="float" id="TB2"><label>TABLE 2</label><caption><p>Longitudinal cohort clinical and demographic information</p></caption><table frame="hsides" rules="groups"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><th align="left" rowspan="1" colspan="1">Clinical variable</th><th align="center" rowspan="1" colspan="1">Bronchiectasis</th><th align="center" rowspan="1" colspan="1">No bronchiectasis</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Subjects</td><td align="center" rowspan="1" colspan="1">14</td><td align="center" rowspan="1" colspan="1">14</td></tr><tr><td align="left" rowspan="1" colspan="1">Male</td><td align="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">6</td></tr><tr><td align="left" rowspan="1" colspan="1">Female</td><td align="center" rowspan="1" colspan="1">8</td><td align="center" rowspan="1" colspan="1">8</td></tr><tr><td align="left" rowspan="1" colspan="1">Total visits</td><td align="center" rowspan="1" colspan="1">97</td><td align="center" rowspan="1" colspan="1">97</td></tr><tr><td align="left" rowspan="1" colspan="1">Pancreatic insufficiency</td><td align="center" rowspan="1" colspan="1">14</td><td align="center" rowspan="1" colspan="1">14</td></tr><tr><td align="left" rowspan="1" colspan="1">F508del homozygous</td><td align="center" rowspan="1" colspan="1">10</td><td align="center" rowspan="1" colspan="1">10</td></tr><tr><td align="left" rowspan="1" colspan="1">Using HEMT</td><td align="center" rowspan="1" colspan="1">0</td><td align="center" rowspan="1" colspan="1">0</td></tr><tr><td align="left" rowspan="1" colspan="1">Positive BAL culture</td><td align="center" rowspan="1" colspan="1">26</td><td align="center" rowspan="1" colspan="1">30</td></tr><tr><td align="left" rowspan="1" colspan="1">Antibiotic prophylaxis</td><td align="center" rowspan="1" colspan="1">14</td><td align="center" rowspan="1" colspan="1">14</td></tr><tr><td align="left" rowspan="1" colspan="1">Age at BAL (years)</td><td align="center" rowspan="1" colspan="1">3.0 (2.0&#x02013;4.5)</td><td align="center" rowspan="1" colspan="1">3.0 (1.9&#x02013;4.1)</td></tr></tbody></table><table-wrap-foot><p>Data are given as n or median (interquartile range). Clinical information for a total of 194 visits for 28 subjects equally distributed across the bronchiectasis group and no bronchiectasis group. Positive bronchoalveolar lavage (BAL) culture information and median age are given as a count out of total visits and not subjects. There are no missing data points. All BAL collections used for averaging are accounted for in this demographic table. HEMT: highly effective cystic fibrosis transmembrane conductance regulator modulator therapy.</p></table-wrap-foot></table-wrap><table-wrap position="float" id="TB3"><label>TABLE 3</label><caption><p>Pulmonary exacerbation (PE) and aerodigestive disease control (DC) cohort demographic and clinical information</p></caption><table frame="hsides" rules="groups"><colgroup span="1"><col align="left" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/><col align="center" span="1"/></colgroup><thead><tr><th align="left" rowspan="2" colspan="1">Categorical variable</th><th align="center" colspan="3" rowspan="1">PE</th><th align="center" colspan="3" rowspan="1">DC</th><th align="center" colspan="2" rowspan="1">CF</th></tr><tr><th align="center" rowspan="1" colspan="1">n</th><th align="center" rowspan="1" colspan="1">%</th><th align="center" rowspan="1" colspan="1">p-value</th><th align="center" rowspan="1" colspan="1">n</th><th align="center" rowspan="1" colspan="1">%</th><th align="center" rowspan="1" colspan="1">p-value</th><th align="center" rowspan="1" colspan="1">n</th><th align="center" rowspan="1" colspan="1">%</th></tr></thead><tbody><tr><td align="left" rowspan="1" colspan="1">Visits</td><td align="center" rowspan="1" colspan="1">11</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">17</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">84</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Patients</td><td align="center" rowspan="1" colspan="1">10</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">17</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">67</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Male</td><td align="center" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">60</td><td align="center" rowspan="1" colspan="1">0.707</td><td align="center" rowspan="1" colspan="1">12</td><td align="center" rowspan="1" colspan="1">70.6</td><td align="center" rowspan="1" colspan="1">0.277</td><td align="center" rowspan="1" colspan="1">35</td><td align="center" rowspan="1" colspan="1">52.2</td></tr><tr><td align="left" rowspan="1" colspan="1">Female</td><td align="center" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colsp
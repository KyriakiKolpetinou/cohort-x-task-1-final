<article-id pub-id-type="publisher-id">2075</article-id><article-id pub-id-type="doi">10.1007/s11547-025-02075-y</article-id><article-categories><subj-group subj-group-type="heading"><subject>Diagnostic Imaging in Oncology</subject></subj-group></article-categories><title-group><article-title>Recent advances in PET/MR imaging for head and neck tumors: a systematic review of the last three years</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0003-1176-9184</contrib-id><name><surname>Pizzuto</surname><given-names>Daniele Antonio</given-names></name><address><email>dapizzuto@gmail.com</email></address><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Becker</surname><given-names>Minerva</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Veit-Haibach</surname><given-names>Patrick</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Messerli</surname><given-names>Michael</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Liberini</surname><given-names>Virginia</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Gennari</surname><given-names>Antonio Giulio</given-names></name><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Lam</surname><given-names>Winnie Wing-Chuen</given-names></name><xref ref-type="aff" rid="Aff7">7</xref><xref ref-type="aff" rid="Aff8">8</xref></contrib><contrib contrib-type="author"><name><surname>Maurer</surname><given-names>Alexander</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Sekine</surname><gi
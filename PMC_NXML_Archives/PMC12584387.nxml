<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Trials</journal-id><journal-id journal-id-type="iso-abbrev">Trials</journal-id><journal-title-group><journal-title>Trials</journal-title></journal-title-group><issn pub-type="epub">1745-6215</issn><publisher><publisher-name>BioMed Central</publisher-name><publisher-loc>London</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41188948</article-id><article-id pub-id-type="pmc">12584387</article-id><article-id pub-id-type="publisher-id">9195</article-id><article-id pub-id-type="doi">10.1186/s13063-025-09195-w</article-id><article-categories><subj-group subj-group-type="heading"><subject>Update</subject></subj-group></article-categories><title-group><article-title>Efficacy and safety of combined lumbar plexus and quadratus lumborum block via Shamrock approach at L3 in total hip arthroplasty: a prospective randomized controlled trial</article-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-4184-0749</contrib-id><name><surname>Wang</surname><given-names>Xiaofeng</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Zhang</surname><given-names>Junfeng</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Xie</surname><given-names>Zhenwei</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Chen</surname><given-names>Yongzhu</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Yonglin-Chen</surname></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Rao</surname><given-names>Zhenghuan</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0003-0260-1793</contrib-id><name><surname>Zhang</surname><given-names>Hui</given-names></name><address><email>zhanghui@sjtu.edu.cn</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0220qvk04</institution-id><institution-id institution-id-type="GRID">grid.16821.3c</institution-id><institution-id institution-id-type="ISNI">0000 0004 0368 8293</institution-id><institution>Department of Anesthesiology, </institution><institution>Shanghai Jiao Tong University Affiliated Sixth People&#x02019;s Hospital, Xuhui District, </institution></institution-wrap>No.600 Yishan Road, Shanghai, 200233 China </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0220qvk04</institution-id><institution-id institution-id-type="GRID">grid.16821.3c</institution-id><institution-id institution-id-type="ISNI">0000 0004 0368 8293</institution-id><institution>Department of Anesthesiology, </institution><institution>Shanghai Jiao Tong University Affiliated Tongren Hospital, Changning District, </institution></institution-wrap>No. 1111 Xianxia Road, Shanghai, 200336 China </aff></contrib-group><pub-date pub-type="epub"><day>4</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>4</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>26</volume><elocation-id>467</elocation-id><history><date date-type="received"><day>7</day><month>3</month><year>2025</year></date><date date-type="accepted"><day>6</day><month>10</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par5">This study aimed to evaluate the efficacy and safety of ultrasound-guided lumbar plexus block (LPB) combined with transmuscular quadratus lumborum block (TQLB) at the L3 level using the Shamrock approach for total hip arthroplasty.</p></sec><sec><title>Methods</title><p id="Par6">Eighty-four patients were enrolled and randomly assigned into three groups at a 1:1:1 ratio: P group (LPB at L3 level), TP group (T12 paravertebral block combined with LPB at L3 and L4 levels) or PQ group (LPB combined with TQLB at L3 level). The primary outcome was the effective rate of sensory block, assessed via the cutaneous sensory block area. The secondary outcomes included postoperative pain intensity, intraoperative sufentanil consumption, incidence of hypotension, procedure time of block and complications.</p></sec><sec><title>Results</title><p id="Par7">The PQ group achieved a significantly higher effective rate of 67.6% compared to the P group, which was at 7.1% (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001), though lower than the TP group (89.3%, <italic>p</italic>&#x02009;=&#x02009;0.051). The PQ group demonstrated significantly lower postoperative visual analogue scales (VAS) during movement compared to the P group (PACU: <italic>p</italic>&#x02009;=&#x02009;0.009; 6&#x000a0;h: <italic>p&#x02009;</italic>=&#x02009;0.046; 24&#x000a0;h: <italic>p</italic>&#x02009;=&#x02009;0.006). However, no significant differences were observed between the PQ and TP groups under any condition (rest or movement). Sufentanil consumption remained comparable across the three groups. Notably, the PQ group experienced a lower frequency of intraoperative hypotension compared to the TP group (<italic>p</italic>&#x02009;=&#x02009;0.028). Regarding procedure time, the PQ group exhibited a significantly lower mean value compared to the TP group, but it was higher than that in the P group (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). Furthermore, no clinical signs of local anaesthetic systemic toxicity, nerve injury, haematoma or epidural block were observed in any of the groups.</p></sec><sec><title>Conclusions</title><p id="Par8">The combined technique may provide effective block with fewer technical challenges and hypotension risks compared to multi-level LPB, making it a feasible alternative for perioperative pain management in total hip arthroplasty.</p><p id="Par9">Trial registration</p><p id="Par10">ClinicalTrials.gov, NCT04266236. Registered on 10 February 2020. ClinicalTrials.gov PRS: Record Summary NCT04266236.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Analgesia</kwd><kwd>Hip arthroplasty</kwd><kwd>Lumbar plexus block</kwd><kwd>Quadratus lumborum block</kwd><kwd>Shamrock approach</kwd></kwd-group><funding-group><award-group><funding-source><institution-wrap><institution-id institution-id-type="FundRef">http://dx.doi.org/10.13039/100017950</institution-id><institution>Shanghai Municipal Health Commission</institution></institution-wrap></funding-source><award-id>202340082</award-id><principal-award-recipient><name><surname>Wang</surname><given-names>Xiaofeng</given-names></name></principal-award-recipient></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; BioMed Central Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Background</title><p id="Par11">Total hip arthroplasty (THA), a gold-standard surgical intervention for advanced hip joint pathologies, is frequently associated with moderate to severe early postoperative pain [<xref ref-type="bibr" rid="CR1">1</xref>]. Ultrasound-guided regional anaesthesia has emerged as an integral component of multimodal analgesic strategies for THA. Despite various described approaches being reported, clinical controversy persists regarding the optimal regional anaesthesia protocol that balances analgesic efficacy, technical feasibility and safety. This stems from the anatomical complexity of hip innervation and variable local anaesthetic spread characteristics.</p><p id="Par12">The hip region mainly receives innervation from the femoral, obturator and lateral femoral cutaneous nerves of the lumbar plexus, complemented by contributions from the iliohypogastric nerve and sacral plexus branches. Therefore, the lumbar plexus block (LPB) at a single level (L3 or L4), combined with the sacral plexus block (SPB), was a frequently employed technique for hip surgery [<xref ref-type="bibr" rid="CR2">2</xref>]. However, contemporary evidence revealed limitations of the single-level LPB. A magnetic resonance imaging study demonstrated restricted craniocaudal spread of local anaesthetic (LA), reporting confinement of injectate between L2 and L4 levels following L4 LPB, failing to adequately cover T12 and L1 segments [<xref ref-type="bibr" rid="CR3">3</xref>]. Sauter et al. [<xref ref-type="bibr" rid="CR4">4</xref>] calculated the ED<sub>95</sub> of 0.5% ropivacaine to achieve an effective block in single-level LPB to be 36.0&#x000a0;mL with a 95% confidence interval (CI) of 19.7&#x02013;55.2, which raised concerns about systemic toxicity and unintended epidural spread. On the other hand, while multi-level LPB techniques addressed coverage deficits, they might introduce procedural complexity and haemodynamic instability risks, particularly sympathetic block-induced hypotension in elderly populations [<xref ref-type="bibr" rid="CR5">5</xref>&#x02013;<xref ref-type="bibr" rid="CR7">7</xref>]. Therefore, the LPB technique was not even recommended for THA in recent years as the adverse effects outweighed the benefits [<xref ref-type="bibr" rid="CR8">8</xref>]. It also faced challenges from some new analgesic techniques.</p><p id="Par13">Nonetheless, it seems too early to say that LPB will be absolutely replaced. The perioperative analgesic efficacy of LPB has been well documented, and we believe that it retains considerable potential for further refinement and optimization. To balance the efficacy and safety, we conducted a combined technique of ultrasound-guided LPB and transmuscular quadratus lumborum block (TQLB) at the L3 level using the Shamrock approach (LPB-TQLB). It is feasible to block the branches from T12&#x02013;L2 via TQLB and L2&#x02013;L4 via LPB successively according to the previous anatomical studies [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR10">10</xref>]. This synergistic role theoretically achieves extensive lumbar plexus coverage (T12&#x02013;L4) with reduced procedural complexity compared to the multi-level techniques. Despite promising anatomical rationale, clinical validation in adult THA populations remains lacking so far [<xref ref-type="bibr" rid="CR11">11</xref>].</p><p id="Par14">Therefore, this randomized controlled trial (RCT) was specifically designed to evaluate three critical points: (1) anaesthetic efficacy of the combined LPB-TQLB technique through quantitative assessment of lumbar plexus coverage (primary outcome); (2) analgesic superiority over conventional LPB, measured by intraoperative opioid consumption and early postoperative pain intensity; (3) safety profile regarding haemodynamic stability and complication rates.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Study design</title><p id="Par15">This prospective, observer-blinded, randomized controlled trial received approval from the ethics committee of Shanghai Jiao Tong University Affiliated Sixth People&#x02019;s Hospital (No.2020-031) and registered at ClinicalTrials.gov (NCT04266236) on February 10, 2020. The first participant was enrolled on July 09, 2020. This study followed the applicable CONSORT guidelines. The protocol of this study has been published on <italic>Trials</italic> [<xref ref-type="bibr" rid="CR12">12</xref>].</p></sec><sec id="Sec4"><title>Participant recruitment and random allocation</title><p id="Par16">Patients with ASA I-II, aged 18 to 75&#x000a0;years, who presented for elective unilateral THA were consecutively and prospectively considered as eligible for inclusion.&#x000a0;Exclusion criteria encompassed the following: (1) refused to regional nerve block or general anaesthesia; (2) body mass index (BMI) exceeded the range of 18&#x02013;30&#x000a0;kg/m<sup>2</sup>; (3) known allergy to ropivacaine; (4) unable to communicate; (5) contraindications to peripheral nerve block (e.g. skin infection around the hip, neuromuscular disorders or coagulation dysfunction). Informed consents were obtained from all participants. Rejection criteria included the following: (1) operation time over 3&#x000a0;h; (2) voluntary withdrawal by patients; (3) transfer to the intensive care unit for unexpected reasons. The sealed, opaque envelopes with allocation details were opened after recruitment. The participants were randomly and equally distributed into one of the three groups with computer-generated random numbers: (1) P group (LPB at L3 transverse process level); (2) TP group (T12 paravertebral block combined with LPB at L3 and L4 levels); (3) PQ group (LPB combined with TQLB at L3). The outcome observers (Y-C and ZR) who assessed the cutaneous sensory block and collected intraoperative and postoperative data were kept blind to the intervention and group assignment.</p></sec><sec id="Sec5"><title>Interventions</title><p id="Par17">Preoperatively, each patient was instructed to fast for 8&#x000a0;h and refrain from liquids for 2&#x000a0;h. Electrocardiogram and pulse oximetry monitors were attached, and peripheral venous access was established. Continuous monitoring of arterial pressure was conducted via the radial artery. The patient was placed in the lateral decubitus position. Following routine skin sterilization, a curved array probe (frequency 2&#x02013;5&#x000a0;MHz, S-series, Sonosite, USA) and a 10&#x000a0;cm 22-gauge (G) block needle (KDL, Kindly group, China) were used. A pre-scan of the spinous processes of T12 and L3&#x02013;L5 was determined successively from the upper margin of the sacrum and the L5 transverse process, then marked on the skin. One mL of 1% lidocaine for skin numbing was given before each block. In addition, a hydro-dissection technique using 1&#x000a0;mL of 0.9% normal saline was employed to confirm the correct localization of the needle tip, and negative aspiration was proved for every 5&#x000a0;mL. Two anaesthetists (YC and ZX) with extensive experience in ultrasound-guided regional anaesthesia performed all the blocks strictly following the procedures below.</p><p id="Par18">The procedure for the P group, as described in literatures [<xref ref-type="bibr" rid="CR13">13</xref>, <xref ref-type="bibr" rid="CR14">14</xref>], involved aligning the ultrasound probe transversely at the midaxillary line, positioned above the iliac crest. Subsequently, the probe was shifted dorsally and slightly tilted to obtain a clear scan of the transverse process of L3. The quadratus lumborum muscle, psoas major and erector spinae muscle were visualized in a Shamrock shape. Then, the needle was inserted in-plane and advanced in a posterolateral to anteromedial direction, targeting the hyperechoic lumbar plexus situated between the thick anterior and thin posterior lamina of the psoas major. A total of 25&#x000a0;mL of 0.375% ropivacaine (Raropin&#x02122;, AstraZeneca AB, Sweden) was injected.</p><p id="Par19">In the procedure for TP group, the LPB at L3 and L4 (with 15&#x000a0;mL of 0.375% ropivacaine injected for each level) was performed consecutively via the Shamrock approach described above. Then, PVB at T12 level was followed [<xref ref-type="bibr" rid="CR15">15</xref>]. The probe was placed vertically against T12 and then moved laterally. Upon scanning the lateral border of the transverse process of T12 and superior rib transverse process ligament, the probe was slightly moved caudally to identify the thoracic paravertebral space. Utilizing the in-plane technique, 10&#x000a0;mL of 0.375% ropivacaine was injected into this space.</p><p id="Par20">The procedure for the PQ group was carried out as follows: LPB at L3 (25&#x000a0;mL of 0.375% ropivacaine) with Shamrock approach was firstly administered. Subsequently, the needle was withdrawn, redirected and advanced through the quadratus lumborum muscle until the needle tip reached the inter-fascial plane between the quadratus lumborum muscle and psoas major [<xref ref-type="bibr" rid="CR11">11</xref>]. Fifteen mL of 0.375% ropivacaine was injected.</p></sec><sec id="Sec6"><title>Anaesthesia application</title><p id="Par21">Thirty minutes after block, the cutaneous sensory block at the surgical area was assessed. General anaesthesia with tracheal intubation was then induced through intravenous administration of 2&#x02013;3&#x000a0;mg/kg of propofol, 0.5&#x000a0;&#x003bc;g/kg of sufentanil (Renfu, China) and 0.6&#x000a0;mg/kg of rocuronium. To maintain anaesthesia, inhaled sevoflurane at 1&#x02013;1.2 MAC was used. If the surgical stimuli caused the heart rate to increase by 10 beats per minute or systolic blood pressure to increase by 20&#x000a0;mmHg, additional sufentanil was given in increments of 5&#x000a0;&#x003bc;g. In the case of hypotension, which is defined as a reduction in mean arterial pressure by more than 30% from baseline or a systolic blood pressure falling below 90&#x000a0;mmHg, intravenous ephedrine or deoxyepinephrine was injected.</p><p id="Par22">Upon emergence from anaesthesia, the patient would receive&#x000a0;a prophylactic dose of&#x000a0;4&#x000a0;mg of ondansetron&#x000a0;intravenously to prevent&#x000a0;nausea&#x000a0;and&#x000a0;vomiting and then be monitored in the post-anaesthesia care unit for at least 1&#x000a0;h.</p><p id="Par23">Furthermore, we implemented postoperative multimodal analgesia for each patient. Specifically, 50&#x000a0;mg of flurbiprofen was administered intravenously 10&#x000a0;min before the end of the surgery. Additionally, a Baxter elastomeric infusion pump was utilized, delivering a fixed-dose, continuous infusion of tramadol at 5&#x000a0;mg/mL combined with lornoxicam at 0.16&#x000a0;mg/mL at the rate of 2&#x000a0;mL/h.</p></sec><sec id="Sec7"><title>Measurements</title><p id="Par24">To assess the primary outcome, the effective rate of different techniques, we evaluated the cutaneous sensory block area (CSBA) around the hip incision via a 3-point scale on cold stimulation testing, with the contralateral side serving as the control. Sensory responses were scored as follows: 0&#x02009;=&#x02009;normal sensation, 1&#x02009;=&#x02009;reduced cold sensation and 2&#x02009;=&#x02009;disappearance of cold sensation. The CSBAs were delineated as being innervated by four terminal nerves: the femoral nerve (anterior thigh), the lateral femoral cutaneous nerve (lateral thigh), the obturator nerve (medial thigh) and the iliohypogastric nerve (lateral hip) [<xref ref-type="bibr" rid="CR9">9</xref>]. An &#x0201c;effective&#x0201d; sensory block was defined as achieving a score of 1 or 2 in all four areas, whereas the presence of a score of 0 in any area was classified as an &#x0201c;inadequate&#x0201d; block. This scoring system ensured objective and reproducible assessment of block efficacy across the groups.</p><p id="Par25">The visual analogue scale (VAS, ranging from 0 to 10, where 0 means no pain and 10 means the worst pain) during rest and movement was recorded at several time points: 30&#x000a0;min after extubation in the post-anaesthesia care unit, at 6&#x000a0;h and 24&#x000a0;h postoperatively. Pain during movement was assessed by passive hip flexion at 15&#x000b0;. The other secondary outcomes included intraoperative sufentanil consumption (excluding anaesthetic induction dosage), the frequency of intraoperative hypotension, complications associated with nerve block (such as local anaesthetic systemic toxicity and epidural block), as well as the procedure time (commencing from ultrasound scanning to the end of injection).</p></sec><sec id="Sec8"><title>Statistical analysis and sample size estimation</title><p id="Par26">We applied an intention-to-treat strategy and performed the statistical analysis with SPSS version 24 (IBM, Armonk, NY, USA). The Kolmogorov&#x02013;Smirnov normality test was conducted for continuous variables. Continuous variables were presented as mean&#x02009;&#x000b1;&#x02009;SD if normally distributed, and as median with interquartile range (IQR, 25&#x02013;75% percentile) if not. Accordingly, pairwise comparisons used one-way analysis of variance with Tukey&#x02019;s correction in the post-hoc analyses or the Kruskal-Wallis test with Dunn&#x02019;s post hoc test as a non-parametric alternative. Categorical data were presented as frequencies and percentages. The comparison of multiple rates was carried out using the chi-square test or Fisher&#x02019;s exact test as appropriate. A two-tailed <italic>p</italic> value&#x02009;&#x0003c;&#x02009;0.05 was considered statistically significant.</p><p id="Par27">Calculation of the sample size was based on our pilot study with 8 patients in each group using PASS 15 software. The effective rates of the three groups were 20% in P group, 70% in TP group and 65% in PQ group, respectively. Therefore, using the chi-square test, 28 cases for each group were required to achieve 90% power to detect the difference with a two-tailed 5% significance level. Consequently, 84 patients were enrolled totally, including the possible dropouts.</p></sec></sec><sec id="Sec9"><title>Results</title><sec id="Sec10"><title>General information</title><p id="Par28">After applying inclusion and exclusion criteria, a total of 84 patients were recruited from July 2020 to June 2024 (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>). All the participants underwent the intervention and follow-up, with the exception of one patient who was rejected from the TP group due to massive haemorrhage. This patient was transferred to the intensive care unit after the surgery and sedated, resulting in his postoperative pain data not being collected. Therefore, the postoperative VAS of this patient was not recorded. The general information, including demographic characteristics and surgical data of the three groups, was comparable (Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>).<fig id="Fig1"><label>Fig.&#x000a0;1</label><caption><p>The CONSORT flow diagram. <italic>THA</italic>, total hip arthroplasty; <italic>PNB</italic>, peripheral nerve block; <italic>GA</italic>, general anaesthesia; <italic>LPB</italic>, lumbar plexus block; <italic>PVB</italic>, paravertebral block; <italic>TQLB</italic>, transmuscular quadratus lumborum block; <italic>ITT</italic>, intention-to-treat</p></caption><graphic xlink:href="13063_2025_9195_Fig1_HTML" id="MO1"/></fig><table-wrap id="Tab1"><label>Table&#x000a0;1</label><caption><p>Comparison of the baseline characteristics among the three groups</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">P (<italic>n</italic>&#x02009;=&#x02009;28)</th><th align="left">TP (<italic>n</italic>&#x02009;=&#x02009;28)</th><th align="left">PQ (<italic>n</italic>&#x02009;=&#x02009;28)</th><th align="left"><italic>p</italic> value</th></tr></thead><tbody><tr><td align="left">Age (years)</td><td align="left">58.1&#x02009;&#x000b1;&#x02009;14.8</td><td align="left">54.7&#x02009;&#x000b1;&#x02009;13.5</td><td align="left">57.0&#x02009;&#x000b1;&#x02009;14.0</td><td char="." align="char">0.651</td></tr><tr><td align="left">Gender (female/male)</td><td align="left">15/13</td><td align="left">14/14</td><td align="left">16/12</td><td char="." align="char">0.866</td></tr><tr><td align="left">Weight (kg)</td><td align="left">65.6&#x02009;&#x000b1;&#x02009;9.7</td><td align="left">66.1&#x02009;&#x000b1;&#x02009;12.0</td><td align="left">63.0&#x02009;&#x000b1;&#x02009;10.0</td><td char="." align="char">0.507</td></tr><tr><td align="left">Height (cm)</td><td align="left">163.7&#x02009;&#x000b1;&#x02009;8.6</td><td align="left">165.9&#x02009;&#x000b1;&#x02009;8.4</td><td align="left">164.0&#x02009;&#x000b1;&#x02009;7.7</td><td char="." align="char">0.561</td></tr><tr><td align="left">BMI (kg/m<sup>2</sup>)</td><td align="left">24.4&#x02009;&#x000b1;&#x02009;2.8</td><td align="left">23.8&#x02009;&#x000b1;&#x02009;2.5</td><td align="left">23.4&#x02009;&#x000b1;&#x02009;3.0</td><td char="." align="char">0.375</td></tr><tr><td align="left">ASA (I/II)</td><td align="left">11/17</td><td align="left">15/13</td><td align="left">10/18</td><td char="." align="char">0.360</td></tr><tr><td align="left">Hypertension history (%)</td><td align="left">35.7</td><td align="left">32.1</td><td align="left">39.3</td><td char="." align="char">0.856</td></tr><tr><td align="left">Surgical side (left/right)</td><td align="left">15/13</td><td align="left">16/12</td><td align="left">17/11</td><td char="." align="char">0.864</td></tr><tr><td align="left">Surgical time (min)</td><td align="left">86.3&#x02009;&#x000b1;&#x02009;31.9</td><td align="left">81.4&#x02009;&#x000b1;&#x02009;27.6</td><td align="left">70.9&#x02009;&#x000b1;&#x02009;17.4</td><td char="." align="char">0.090</td></tr><tr><td align="left">Intraoperative bleeding (mL)</td><td align="left">301.8&#x02009;&#x000b1;&#x02009;139.8</td><td align="left">380.4&#x02009;&#x000b1;&#x02009;249.2</td><td align="left">321.4&#x02009;&#x000b1;&#x02009;153.0</td><td char="." align="char">0.268</td></tr></tbody></table><table-wrap-foot><p>The values are presented as mean&#x02009;&#x000b1;&#x02009;SD, ratio or proportion (%)</p><p><italic>ASA&#x000a0;</italic>American Society of Anesthesiologists,&#x000a0;<italic>BMI&#x000a0;</italic>body mass index</p></table-wrap-foot></table-wrap></p></sec><sec id="Sec11"><title>Comparison of effective rates</title><p id="Par29">Thirty minutes after the block, the patients exhibited varying degrees of cutaneous sensory loss. Overall, the distributions of sensory block across four specific areas were significantly different among the three groups (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). According to the results of the cutaneous sensory block assessment, the effective rates in the TP and PQ groups were notably higher compared to the P group (89.3% vs. 7.1%, <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001, and 67.6% vs. 7.1%, <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001, respectively). However, despite the TP group exhibiting a higher effective rate compared to the PQ group, no statistically significant difference was observed (89.3% vs. 67.6%, <italic>p</italic>&#x02009;=&#x02009;0.051). The detailed findings of the CSBA and the effective rates are illustrated in Figs.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref> and <xref rid="Fig3" ref-type="fig">3</xref>.<fig id="Fig2"><label>Fig.&#x000a0;2</label><caption><p>Comparison of effective rates. The effective rates of TP and PQ groups were higher than that of P group (89.3 vs. 7.1%, <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001 and 67.6 vs. 7.1%, <italic>p&#x02009;</italic>&#x0003c;&#x02009;0.001). No significant difference in the effective rate presented between TP and PQ group although a higher effective rate was observed in TP group (89.3 vs. 67.6%, <italic>p</italic>&#x02009;=&#x02009;0.051). P group, LPB at L3; TP group, T12 PVB combined with LPB at L3 and L4 levels; PQ group, LPB combined with TQLB at L3</p></caption><graphic xlink:href="13063_2025_9195_Fig2_HTML" id="MO2"/></fig><fig id="Fig3"><label>Fig.&#x000a0;3</label><caption><p>The distribution of cutaneous sensory block. The result was described in three levels: normal, reduced cold sensation and disappearance of cold sensation. The cutaneous sensory block areas (CSBAs) were delineated as being innervated by the four terminal nerves: femoral nerve (FN, anterior thigh), lateral femoral cutaneous nerve (LFCN, lateral thigh), obturator nerve (ON, medial thigh) and iliohypogastric nerve (IHN, lateral hip)</p></caption><graphic xlink:href="13063_2025_9195_Fig3_HTML" id="MO3"/></fig></p></sec><sec id="Sec12"><title>Comparison of postoperative pain intensity</title><p id="Par30">The VAS of 83 patients at different time points was analysed. Whenever during the rest or movement status, the overall analysis of VAS demonstrated statistically significant differences (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). In pairwise comparisons of VAS during rest, no significant difference was observed between any pair of sequences except for the P-TP group pair (in PACU: <italic>p&#x02009;</italic>=&#x02009;0.028, at 6&#x000a0;h: <italic>p</italic>&#x02009;=&#x02009;0.026, at 24&#x000a0;h: <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). However, in pairwise comparisons of VAS during movement, significant differences were both revealed in the P-PQ and P-TP group pairs, while no significant difference was found in the TP-PQ group pair. The VAS at each time point in the PQ group was lower than that in the P group when the hip was passively flexed (in PACU: <italic>p</italic>&#x02009;=&#x02009;0.009, at 6&#x000a0;h: <italic>p</italic>&#x02009;=&#x02009;0.046, at 24&#x000a0;h: <italic>p</italic>&#x02009;=&#x02009;0.006). The detailed intergroup comparisons of pain scores during rest and movement are presented in Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref> and Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>.
<table-wrap id="Tab2"><label>Table&#x000a0;2</label><caption><p>Postoperative pain intensity at rest and movement in preselected time points</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2">VAS</th><th align="left" rowspan="2">Time point</th><th align="left" rowspan="2">P (<italic>n</italic>&#x02009;=&#x02009;28)</th><th align="left" rowspan="2">TP (<italic>n</italic>&#x02009;=&#x02009;27)</th><th align="left" rowspan="2">PQ (<italic>n</italic>&#x02009;=&#x02009;28)</th><th align="left" rowspan="2">Overall, <italic>p</italic> value</th><th align="left" colspan="3">Pairwise comparison, <italic>p</italic> value</th></tr><tr><th align="left">P vs TP</th><th align="left">TP vs PQ</th><th align="left">P vs PQ</th></tr></thead><tbody><tr><td align="left">Rest</td><td align="left">PACU</td><td align="left">3 (3&#x02013;4)</td><td align="left">2 (2&#x02013;3)</td><td align="left">3 (2&#x02013;3)</td><td char="." align="char">0.024*</td><td char="." align="char">0.028*</td><td char="." align="char">1.000</td><td char="." align="char">0.128</td></tr><tr><td align="left"/><td align="left">6&#x000a0;h</td><td align="left">3 (2.75&#x02013;4)</td><td align="left">2 (2&#x02013;3)</td><td align="left">3 (2&#x02013;3)</td><td char="." align="char">0.031*</td><td char="." align="char">0.026*</td><td char="." align="char">0.820</td><td char="." align="char">0.370</td></tr><tr><td align="left"/><td align="left">24&#x000a0;h</td><td align="left">4 (3.75&#x02013;5)</td><td align="left">3 (3&#x02013;4)</td><td align="left">3.5 (3&#x02013;4)</td><td char="." align="char">0.002*</td><td char="." align="char">0.001*</td><td char="." align="char">0.307</td><td char="." align="char">0.158</td></tr><tr><td align="left">Movement</td><td align="left">PACU</td><td align="left">4 (3&#x02013;5)</td><td align="left">3 (3&#x02013;3.5)</td><td align="left">3 (3&#x02013;4)</td><td char="." align="char">&#x02009;&#x0003c;&#x02009;0.001*</td><td char="." align="char">&#x02009;&#x0003c;&#x02009;0.001*</td><td char="." align="char">1.000</td><td char="." align="char">0.009*</td></tr><tr><td align="left"/><td align="left">6&#x000a0;h</td><td align="left">5 (4&#x02013;5)</td><td align="left">4 (3&#x02013;4)</td><td align="left">4 (3&#x02013;5)</td><td char="." align="char">&#x02009;&#x0003c;&#x02009;0.001*</td><td char="." align="char">&#x02009;&#x0003c;&#x02009;0.001*</td><td char="." align="char">0.770</td><td char="." align="char">0.046*</td></tr><tr><td align="left"/><td align="left">24&#x000a0;h</td><td align="left">5.5 (5&#x02013;6.25)</td><td align="left">4 (4&#x02013;5)</td><td align="left">5 (4&#x02013;5)</td><td char="." align="char">&#x02009;&#x0003c;&#x02009;0.001*</td><td char="." align="char">&#x02009;&#x0003c;&#x02009;0.001*</td><td char="." align="char">0.478</td><td char="." align="char">0.006*</td></tr></tbody></table><table-wrap-foot><p>Data are showed as median (IQR). The groups were compared using Kruskal-Wallis test and Dunn&#x02019;s post hoc test was used in pairwise comparisons. *<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.05</p><p><italic>VAS&#x000a0;</italic>visual analogue scale,&#x000a0;<italic>PACU&#x000a0;</italic>post-anaesthesia care unit</p></table-wrap-foot></table-wrap><fig id="Fig4"><label>Fig.&#x000a0;4</label><caption><p>The trends of postoperative pain intensity during rest and movement. *<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.05 <italic>VAS</italic>, visual analogue scale; <italic>PACU</italic>, post-anaesthesia care unit</p></caption><graphic xlink:href="13063_2025_9195_Fig4_HTML" id="MO4"/></fig></p></sec><sec id="Sec13"><title>Comparison of the other secondary outcomes (Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>)</title><p id="Par31">
<table-wrap id="Tab3"><label>Table&#x000a0;3</label><caption><p>The other secondary outcomes</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2"/><th align="left" rowspan="2">P (<italic>n</italic>&#x02009;=&#x02009;28)</th><th align="left" rowspan="2">TP (<italic>n</italic>&#x02009;=&#x02009;28)</th><th align="left" rowspan="2">PQ (<italic>n</italic>&#x02009;=&#x02009;28)</th><th align="left" rowspan="2">Overall, <italic>p</italic> value</th><th align="left" colspan="3">Pairwise comparison, <italic>p</italic> value</th></tr><tr><th align="left">P vs TP</th><th align="left">TP vs PQ</th><th align="left">P vs PQ</th></tr></thead><tbody><tr><td align="left">Sufentanil consumption(&#x003bc;g)</td><td align="left">10 (5&#x02013;15)</td><td align="left">5 (5&#x02013;10)</td><td align="left">5 (5&#x02013;10)</td><td char="." align="char">0.349</td><td char="." align="char">0.149</td><td char="." align="char">0.396</td><td char="." align="char">0.553</td></tr><tr><td align="left">Intraoperative hypotension (frequency)</td><td align="left">1 (0&#x02013;1.25)</td><td align="left">2 (1&#x02013;3)</td><td align="left">1 (0&#x02013;2)</td><td char="." align="char">0.028*</td><td char="." align="char">0.012*</td><td char="." align="char">0.042*</td><td char="." align="char">0.632</td></tr><tr><td align="left">Procedure time (s)</td><td align="left">122.5 (105&#x02013;151.25)</td><td align="left">607.5 (515&#x02013;666.25)</td><td align="left">192.5 (170&#x02013;210)</td><td char="." align="char">&#x02009;&#x0003c;&#x02009;0.001*</td><td char="." align="char">&#x02009;&#x0003c;&#x02009;0.001*</td><td char="." align="char">&#x02009;&#x0003c;&#x02009;0.001*</td><td char="." align="char">0.003*</td></tr><tr><td align="left">Complications</td><td align="left">0</td><td align="left">0</td><td align="left">0</td><td char="." align="char">1.000</td><td char="." align="char">1.000</td><td char="." align="char">1.000</td><td char="." align="char">1.000</td></tr></tbody></table><table-wrap-foot><p>The values are presented as median (IQR). *<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.05</p></table-wrap-foot></table-wrap></p><p id="Par32">Although statistically significant differences were observed in the effective rate and postoperative pain intensity, the sufentanil consumptions among the three groups remained comparable. The incidence of intraoperative hypotension in the TP group was higher than that in the other two groups (<italic>p</italic>&#x02009;=&#x02009;0.028). In terms of procedure time, the PQ group exhibited a significantly lower mean value compared to the TP group, but it was still higher than that of the P group (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). Additionally, no clinical signs of local anaesthetic systemic toxicity, nerve injury, haematoma or epidural block were observed in any of the groups.</p></sec></sec><sec id="Sec14"><title>Discussion</title><p id="Par33">Our study demonstrated that the combined LPB-TQLB technique achieved a higher effective rate compared to the single-level LPB in THA, albeit slightly lower than the multi-level LPB, without statistical significance. This finding supports the clinical efficacy of the combined technique, offering a potential strategy for perioperative analgesia in hip surgery.</p><p id="Par34">The CSBAs were not reliably covered in the P group, especially the lateral hip region, which was primarily innervated by the iliohypogastric nerve (IHN) [<xref ref-type="bibr" rid="CR9">9</xref>]. Its anatomical course, which diverges from the main lumbar plexus, makes it challenging to block with a single injection of LPB at L3. Moreover, neither the lateral nor the medial region of the thigh was adequately covered in the P group. This incomplete coverage aligns with previous studies highlighting the limitations of single-level LPB in achieving comprehensive block of the lumbar plexus [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR16">16</xref>, <xref ref-type="bibr" rid="CR17">17</xref>].</p><p id="Par35">Conversely, the combined LPB-TQLB technique provided more extensive coverage compared with single-level LPB in the aforementioned regions. However, the lateral hip areas in the patients of the PQ group were not consistently blocked, resulting in a lower effective rate compared with the multi-level LPB technique, without a significant statistical difference. This discrepancy may be explained by the volume of local anaesthetic and the anatomical course of the IHN. Occasionally, the IHN already pierces through the transversalis fascia and enters into the abdominal muscles above the L3 level, further affecting the success of the block [<xref ref-type="bibr" rid="CR18">18</xref>]. On the other hand, the previous researchers typically administered 20&#x02013;30&#x000a0;mL of local anaesthetic for the QLB, whereas in our study, we utilized only 15 mL [<xref ref-type="bibr" rid="CR19">19</xref>, <xref ref-type="bibr" rid="CR20">20</xref>]. However, a higher volume of local anaesthetic may result in a more extensive cephalic spread to thoracic nerves [<xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR22">22</xref>]. This finding is not necessarily beneficial for hip surgery. The aim of this trial was not to achieve maximal block range but rather to validate whether the combined technique could block the main branches of the lumbar plexus for the analgesia of hip surgery. At this point, an effective rate nearing 70% should suffice to demonstrate the validity of the technique for THA. It also validates our research hypothesis, namely, on the basis of LPB, TQLB can provide a more comprehensive block of the lumbar plexus [<xref ref-type="bibr" rid="CR12">12</xref>].</p><p id="Par36">Certainly, the effective rate of the block, as assessed by CSBA, alone is insufficient to establish its clinical efficacy. We supplemented our evaluation with postoperative pain assessments. The early analgesic effect of the combined LPB-TQLB technique was comparable to that of multi-level LPB and superior to single-level LPB during passive hip movement. This further validated the analgesic effectiveness of the combined technique, particularly during the initial phase of postoperative ambulation, which might be beneficial for recovery.</p><p id="Par37">Another noteworthy aspect was that this technique did not increase the incidence of intraoperative hypotension compared to single-level LPB, which could be beneficial for maintaining haemodynamic stability. Additionally, it might offer a safer alternative to the multi-level technique due to the lower incidence of hypotension. The Shamrock approach&#x02019;s precision in targeting anatomical structures likely contributed to this outcome by avoiding excessive spread of local anaesthetic to sympathetic fibres [<xref ref-type="bibr" rid="CR23">23</xref>]. This means that the combined technique achieved effective analgesia without compromising haemodynamic stability.</p><p id="Par38">A substantial number of studies have been published on peripheral nerve block techniques for analgesia in hip surgery, including LPB, TQLB, fascia iliaca compartment block [<xref ref-type="bibr" rid="CR24">24</xref>], anterior iliopsoas muscle space block [<xref ref-type="bibr" rid="CR7">7</xref>] and pericapsular nerve group block [<xref ref-type="bibr" rid="CR25">25</xref>]. To some extent, all of them have demonstrated promising analgesic efficacy, but controversies still exist [<xref ref-type="bibr" rid="CR26">26</xref>&#x02013;<xref ref-type="bibr" rid="CR29">29</xref>]. Among the regional analgesic options, LPB and TQLB remain the most extensively researched and well-established techniques in this field [<xref ref-type="bibr" rid="CR30">30</xref>]. Although there is an overlap in the theoretical block range of these two techniques, it does not affect their complementary roles during combined use. TQLB plays an important role for sensory areas not covered by LPB. The Shamrock approach refers to a straightforward way that enables the simultaneous administration of two procedures, each targeting different segments of the lumbar plexus, without relocation of the probe and alternating the injection site. The L3 is the longest of the lumbar transverse processes and provides a reliable landmark for ultrasound scan. The central location of the L3 level ensures effective block of the L2&#x02013;L4 nerve roots and the additional TQLB extends the block to include T12&#x02013;L1 segments. In addition, this approach offers several technical advantages, including improved visibility of anatomical structures, reduced needle insertions and shorter procedure time [<xref ref-type="bibr" rid="CR31">31</xref>]. This might decrease the risks of tissue injury and complications, although no serious adverse event was observed in our study.</p><p id="Par39">This study has several limitations. First, the CSBAs were not marked on the skin or calculated in this study because the aim of our study was to assess whether the combined technique could encompass the primary branches innervating the hip, rather than to determine the maximal extent of block. Second, the study population consisted of relatively healthy patients, limiting the generalizability of the findings to older or more fragile individuals with comorbidities. This might lead to selection bias and limit the external validity. Third, the conventional LPB techniques are being challenged by novel techniques such as the iliopsoas muscle space block and the pericapsular nerve group block in regard to analgesia, convenience, recovery of quadriceps strength, early ambulation and rehabilitation [<xref ref-type="bibr" rid="CR28">28</xref>, <xref ref-type="bibr" rid="CR29">29</xref>]. We did not set them as the control groups. Thus, the superiority of this combined technique may be overestimated for hip surgery. Further investigations focusing on the comparative analysis among these techniques are required.</p></sec><sec id="Sec15"><title>Conclusion</title><p id="Par40">In conclusion, the results of this study support the effectiveness of ultrasound-guided LPB combined with TQLB using the Shamrock approach at the L3 level for THA. This technique can provide comparable analgesia to multi-level LPB while avoiding the technical complexity and risks associated with multiple injections. It may offer a balance of efficacy, simplicity and safety, making it a viable alternative to conventional LPB techniques.</p></sec><sec id="Sec16"><title>What is known</title><p id="Par41">
<list list-type="bullet"><list-item><p id="Par42">The innervation of the hip is complex. Single-level LPB faces the limitation of restricted spread of local anaesthetic, while multi-level LPB introduces procedural complexity and haemodynamic instability risks.</p></list-item></list>
</p></sec><sec id="Sec17"><title>What is new</title><p id="Par43">
<list list-type="bullet"><list-item><p id="Par44">The combined LPB-TQLB technique achieved a higher effective rate of blockade and lower postoperative pain score during movement for the patients underwent THA compared to single-level LPB.</p></list-item><list-item><p id="Par45">The combined technique provided comparable analgesic efficacy to multi-level LPB while significantly reducing procedural complexity and maintained haemodynamic stability, offering a safer and more efficient alternative for postoperative pain management in THA.</p></list-item></list></p></sec></body><back><fn-group><fn><p><bold>Publisher&#x02019;s Note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn><fn><p>Xiaofeng Wang and Junfeng Zhang contributed equally to this work.</p></fn></fn-group><ack><title>Acknowledgements</title><p>Not applicable.</p></ack><notes notes-type="author-contribution"><title>Authors&#x02019; contributions</title><p>JZ contributed to the study design and revision of the manuscript. XW drafted the original manuscript and approved the final version. HZ finished the recruitments, obtained the informed consents from all the participants and administered the randomization and group allocation. YC and ZX performed the interventions. Y-C and ZR assessed the outcomes, collected and analysed the data. All authors read and approved the final manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>This trial was supported by the Research Foundations of Shanghai Municipal Health Commission (No. 202340082).</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>The datasets used or analysed during this study will be available from the corresponding author for reasonable purpose.</p></notes><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par46">This study was approved by the ethics committee of Shanghai Sixth People&#x02019;s Hospital (No.2020-031). Before enrolment, the written informed consent was obtained from all the participants.</p></notes><notes id="FPar2"><title>Consent for publication</title><p id="Par47">Not applicable.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests</title><p id="Par48">The authors declare that they have no competing interests.

<article-id pub-id-type="doi">10.1192/j.eurpsy.2024.1782</article-id><article-id pub-id-type="pii">S0924933824017826</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group></article-categories><title-group><article-title>Suicidal transition rates and their predictors in the adult general population: a repeated survey over 21&#x000a0;years in France</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid" authenticated="true">https://orcid.org/0000-0001-5809-4503</contrib-id><name><surname>Jollant</surname><given-names>Fabrice</given-names></name><xref rid="aff1" ref-type="aff">

<article-meta><article-id pub-id-type="pmid">39879613</article-id><article-id pub-id-type="pmc">11822309</article-id><article-id pub-id-type="publisher-id">v27i1e64687</article-id><article-id pub-id-type="doi">10.2196/64687</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Letter</subject></subj-group><subj-group subj-group-type="article-type"><subject>Research Letter</subject></subj-group></article-categories><title-group><article-title>Real-Time fMRI Neurofeedback Modulation of Dopaminergic Midbrain Activity in Young Adults With Elevated Internet Gaming Disorder Risk: Randomized Controlled Trial</article-title></title-group><contrib-group><contrib contrib-type="editor"><name><surname>Schwartz</surname><given-names>Amy</given-names></name></contrib></contrib-group><contrib-group><contrib contrib-type="reviewer"><name><surname>Beynel</surname><given-names>Lysianne</given-names></name></contrib><contrib contrib-type="reviewer"><name><surname>Rizvi</surname><given-names>Abid</given-names></name></contrib><contrib contrib-type="reviewer"><name><surname>Song</surname><given-names>Kunru</given-names></name></contrib></contrib-group><contrib-group><contrib id="contrib1" contrib-type="author"><name><surname>Gu</surname><given-names>Anqi</given-names></name><degrees>MSc</degrees><xref rid="aff1" ref-type="aff">1</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0007-5771-330X</contrib-id></contrib><contrib id="contrib2" contrib-type="author"><name><surname>Chan</surname><given-names>Cheng Lam</given-names></name><degrees>BS</degrees><xref rid="aff1" ref-type="aff">1</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0006-4430-4577</contrib-id></contrib><contrib id="contrib3" contrib-type="author"><name><surname>Xu</surname><given-names>Xiaolei</given-names></name><degrees>PhD</degrees><xref rid="aff2" ref-type="aff">2</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-3817-0411</contrib-id></contrib><contrib id="contrib4" contrib-type="author"><name><surname>Dexter</surname><given-names>Joseph P</given-names></name><degrees>PhD</degrees><xref rid="aff3" ref-type="aff">3</xref><xref rid="aff4" ref-type="aff">4</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0001-8524-5792</contrib-id></contrib><contrib id="contrib5" contrib-type="author"><name><surname>Becker</surname><given-names>Benjamin</given-names></name><degrees>PhD</degrees><xref rid="aff5" ref-type="aff">5</xref><xref rid="aff6" ref-type="aff">6</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-9014-9671</contrib-id></contrib><contrib id="contrib6" contrib-type="author" corresp="yes"><name><surname>Zhao</surname><given-names>Zhiying</given-names></name><degrees>PhD</degrees><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-0369-1308</contrib-id><xref rid="aff1" ref-type="aff">1</xref><address><institution>Centre for Cognitive and Brain Sciences</institution><institution>Institute of Collaborative Innovation</institution><institution>University of Macau</institution><addr-line>N21 Research building</addr-line><addr-line>Macau, 99078</addr-line><country>China</country><phone>853 8822 9182</phone><email>zhiyingzhao@um.edu.mo</email></address></contrib></contrib-group><aff id="aff1">

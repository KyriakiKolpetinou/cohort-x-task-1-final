<article-meta><article-id pub-id-type="pmid">40082668</article-id><article-id pub-id-type="pmc">11906790</article-id><article-id pub-id-type="publisher-id">93520</article-id><article-id pub-id-type="doi">10.1038/s41598-025-93520-5</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Human biodistribution and radiation dosimetry of two novel &#x003b1;-synuclein PET tracers, <sup>18</sup>F-SPAL-T-06 and <sup>18</sup>F-C05-05</article-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><name><surname>Goto</surname><given-names>Ryoji</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Matsuoka</surname><given-names>Kiwamu</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Kimura</surname><given-names>Yasuyuki</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Kataoka</surname><given-names>Yuko</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Oya</surname><given-names>Masaki</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Hirata</surname><given-names>Kosei</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Tagai</surname><given-names>Kenji</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Takahata</surname><given-names>Keisuke</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Seki</surname><given-names>Chie</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Kawamura</surname><given-names>Kazunori</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Zhang</surname><given-names>Ming-Rong</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Higuchi</surname><given-names>Makoto</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Endo</surname><given-names>Hironobu</given-names></name><address><email>endo.hironobu@qst.go.jp</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/020rbyg91</institution-id><institution-id institution-id-type="GRID">grid.482503.8</institution-id><institution-id institution-id-type="ISNI">0000 0004 5900 003X</institution-id><institution>Advanced Neuroimaging Center, Institute for Quantum Medical Science, </institution><institution>National Institutes for Quantum Science and Technology, </institution></institution-wrap>Chiba, Japan </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05h0rw812</institution-id><institution-id institution-id-type="GRID">grid.419257.c</institution-id><institution-id institution-id-type="ISNI">0000 0004 1791 9005</institution-id><institution>Department of Clinical and Experimental Neuroimaging, Center for Development of Advanced Medicine for Dementia, </institution><institution>National Center for Geriatrics and Gerontology, </institution></institution-wrap>Obu, Japan </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/020rbyg91</institution-id><institution-id institution-id-type="GRID">grid.482503.8</institution-id><institution-id institution-id-type="ISNI">0000 0004 5900 003X</institution-id><institution>Department of Advanced Nuclear Medicine Sciences, Institute for Quantum Medical Science, </institution><institution>National Institutes for Quantum Science and Technology, </institution></institution-wrap>Chiba, Japan </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01hvx5h04</institution-id><institution>Department of Neuroetiology and Diagnostic Science, </institution><institution>Osaka Metropolitan University Graduate School of Medicine, </institution></institution-wrap>Osaka, Japan </aff></contrib-group><pub-date pub-type="epub"><day>13</day><month>3</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>13</day><month>3</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>15</volume><elocation-id>8640</elocation-id><history><date date-type="received"><day>30</day><month>10</month><year>2024</year></date><date date-type="accepted"><day>7</day><month>3</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><p id="Par1"><sup>18</sup>F-SPAL-T-06 and <sup>18</sup>F-C05-05 are two novel positron emission tomography (PET) radioligands targeting &#x003b1;-synuclein fibrils. Our study aimed to evaluate the biodistribution, safety, and radiation dosimetry of each tracer in humans. Biodistribution and radiation dosimetry studies were carried out with two healthy volunteers for each tracer, <sup>18</sup>F-SPAL-T-06 (one female and one male volunteer, both aged 63 years) and <sup>18</sup>F-C05-05 (one female and one male volunteer, aged 63 and 73 years, respectively). After injection of either tracer, dynamic PET images were acquired from head to upper thigh. Effective dose of each tracer was estimated using OLINDA/EXM Version 2.2. Injection of either of the tracers caused no adverse effects. Greatest uptake of both tracers was observed in the liver and small intestine. The estimated absorbed doses were highest in the biliary tract, followed by the lower large intestinal wall. Effective doses were 35.9 &#x000b5;Sv/MBq for <sup>18</sup>F-SPAL-T-06 and 30.5 &#x000b5;Sv/MBq for <sup>18</sup>F-C05-05. <sup>18</sup>F-SPAL-T-06 and <sup>18</sup>F-C05-05 are safe for in vivo PET imaging of humans. Their mean effective doses were 6.6 mSv for <sup>18</sup>F-SPAL-T-06 and 5.6 mSv for <sup>18</sup>F-C05-05 when 185 MBq of either tracer was given to a subject, and they were comparable to other amyloid and tau PET tracers labelled with <sup>18</sup>F.</p><p id="Par2"><italic>Trial registration</italic> Trial registration number: jRCTs031210180, Registered date: 2nd July 2021 (<sup>18</sup>F-SPAL-T-06) <ext-link ext-link-type="uri" xlink:href="https://jrct.niph.go.jp/en-latest-detail/jRCTs031210180">https://jrct.niph.go.jp/en-latest-detail/jRCTs031210180</ext-link> and Trial registration number: jRCTs031220123, Registered date: 9th June 2022 (<sup>18</sup>F-C05-05) <ext-link ext-link-type="uri" xlink:href="https://jrct.niph.go.jp/en-latest-detail/jRCTs031220123">https://jrct.niph.go.jp/en-latest-detail/jRCTs031220123</ext-link>.</p><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1038/s41598-025-93520-5.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd><sup>18</sup>F-SPAL-T-06</kwd><kwd><sup>18</sup>F-C05-05</kwd><kwd>&#x003b1;-synuclein PET</kwd><kwd>Radiation dosimetry</kwd><kwd>Effective dose</kwd></kwd-group><kwd-group kwd-group-type="npg-subject"><title>Subject terms</title><kwd>Neuroscience</kwd><kwd>Biomarkers</kwd><kwd>Neurology</kwd></kwd-group><funding-group><award-group><funding-source><institution-wrap><institution-id institution-id-type="FundRef">http://dx.doi.org/10.13039/100009619</institution-id><institution>Japan Agency for Medical Research and Development</institution></institution-wrap></funding-source><award-id>JP21wm0425015</award-id><award-id>JP24wm0625001</award-id><principal-award-recipient><name><surname>Higuchi</surname><given-names>Makoto</given-names></name></principal-award-recipient></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer Nature Limited 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par8">Accumulation of &#x003b1;-synuclein is a common feature of various neurodegenerative diseases such as Parkinson&#x02019;s disease (PD), dementia with Lewy bodies (DLB), and multiple system atrophy (MSA)<sup><xref ref-type="bibr" rid="CR1">1</xref></sup>. Abnormal &#x003b1;-synuclein is known to be observed as a major component of Lewy bodies or Lewy neurites in PD and DLB<sup><xref ref-type="bibr" rid="CR2">2</xref>&#x02013;<xref ref-type="bibr" rid="CR4">4</xref></sup>, and of glial cytoplasmic inclusions (GCIs) in MSA<sup><xref ref-type="bibr" rid="CR5">5</xref></sup>. The aggregation of &#x003b1;-synuclein is considered to lead to neuronal death in those &#x003b1;-synucleinopathies<sup><xref ref-type="bibr" rid="CR6">6</xref></sup>, and it has therefore been studied not only as the pathological basis for a definitive diagnosis but also as a therapeutic target<sup><xref ref-type="bibr" rid="CR7">7</xref>,<xref ref-type="bibr" rid="CR8">8</xref></sup>. In vivo visualization of &#x003b1;-synuclein, which enables its detection without invasive biopsy, has been desired.</p><p id="Par9">Although several PET tracers have been reported to react with &#x003b1;-synuclein lesions, further validations also revealed their suboptimal binding affinity. We recently developed two new imaging tracers targeting &#x003b1;-synuclein fibrils, <sup>18</sup>F-SPAL-T-06 <sup><xref ref-type="bibr" rid="CR9">9</xref></sup> and <sup>18</sup>F-C05-05 <sup><xref ref-type="bibr" rid="CR10">10</xref></sup>, which could visualize &#x003b1;-synuclein pathologies with high contrast. Although these tracers may cross-react with tau aggregates, enhanced selectivity for &#x003b1;-synuclein compared to the tau PET tracer florzolotau has been demonstrated<sup><xref ref-type="bibr" rid="CR10">10</xref></sup>. <sup>18</sup>F-SPAL-T-06 enables high-contrast imaging of &#x003b1;-synuclein deposits in MSA patients with low background signals due to its rapid clearance. On the other hand, <sup>18</sup>F-C05-05 enables the detection of &#x003b1;-synuclein deposits in the midbrain of PD and DLB patients even with its relatively high background signals. Despite the potential clinical utility of both tracers, their human dosimetry data have not yet been published. In the present study, we aimed to evaluate the whole-body biodistribution of radioactivity, safety, and radiation dosimetry of <sup>18</sup>F-SPAL-T-06 and <sup>18</sup>F-C05-05 in healthy human subjects.</p></sec><sec id="Sec2"><title>Results</title><sec id="Sec3"><title>Safety monitoring</title><p id="Par10">We conducted PET assays for two subjects (subject A-1 and A-2) with <sup>18</sup>F-SPAL-T06 and two subjects (subjects B-1 and B-2) with <sup>18</sup>F-C05-05 (see Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref> for subject details). According to subject reports, single intravenous injection of either <sup>18</sup>F-SPAL-T-06 (179.6 MBq and 182.4 MBq) or <sup>18</sup>F-C05-05 (183.4 MBq and 173.3 MBq) caused no adverse or clinically detectable or pharmacological effects in any of the subjects during and after the PET scan. No significant changes in heart rate, blood pressure, respiratory rate, saturation of percutaneous oxygen, and blood tests were observed before and after the scan.</p><p id="Par11">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Study subject demographics and tracer administration characteristics for <sup>18</sup>F-SPAL-T-06 (A) and <sup>18</sup>F-C05-05 (B).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Subject ID</th><th align="left">Age (y)</th><th align="left">Sex</th><th align="left">Weight (kg)</th><th align="left">Dose (MBq)</th><th align="left">Molar activity<break/>(GBq/&#x000b5;mol)</th></tr></thead><tbody><tr><td align="left" colspan="6">A. <sup>18</sup>F-SPAL-T-06</td></tr><tr><td align="left">&#x000a0;A-1</td><td char="." align="char">63</td><td align="left">F</td><td align="left">58.0</td><td char="." align="char">179.6</td><td char="." align="char">75.7</td></tr><tr><td align="left">&#x000a0;A-2</td><td char="." align="char">63</td><td align="left">M</td><td align="left">68.2</td><td char="." align="char">182.4</td><td char="." align="char">315.1</td></tr><tr><td align="left" colspan="6">B. <sup>18</sup>F-C05-05</td></tr><tr><td align="left">&#x000a0;B-1</td><td char="." align="char">73</td><td align="left">M</td><td align="left">69.1</td><td char="." align="char">183.4</td><td char="." align="char">223.1</td></tr><tr><td align="left">&#x000a0;B-2</td><td char="." align="char">63</td><td align="left">F</td><td align="left">56.4</td><td char="." align="char">173.3</td><td char="." align="char">268.7</td></tr></tbody></table></table-wrap>
</p></sec><sec id="Sec4"><title>Biodistribution and radiation dosimetry of <sup>18</sup>F-SPAL-T-06</title><p id="Par12">Brain, thyroid, lungs, heart, liver, spleen, stomach, pancreas, kidneys, biliary tract, small intestine, large intestine, skeleton, and urinary bladder were visually identified on the PET images and treated as source organs of radioactivity for dosimetry calculations. Representative whole-body PET images in subject A-1 are shown in Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>A. Whole-body PET images in the other subject A-2 are shown in Supplementary Fig. <xref rid="MOESM1" ref-type="media">S1</xref>A. The tracer immediately distributed throughout the whole body greatly accumulated in the liver, and it was then gradually excreted through the biliary tract to the intestines. The large intestine showed the most uptake with a maximum of 43.4% of injected activity (%IA). Rapid washin and washout were observed in the lungs (peak activity: 25.5%IA), heart (15.4%IA), kidneys (5.0%IA), brain (4.2%IA), spleen (1.9%IA), pancreas (1.5%IA) and red marrow (0.7%IA), while radioactivity gradually increased and subsequently slowly washed out in the liver and biliary tract. Radioactivity accumulated slowly in the small intestine and urinary bladder. Exponential fitting of cumulative activity in the urinary bladder and urine indicated that 9.7% of injected activity was excreted via this route in an infinite time-course, with a biological half-life of 251&#x000a0;min. The time-activity curves of the decay-corrected %IA of each subject are presented in Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>A.</p><p id="Par13">
<fig id="Fig1"><label>Fig. 1</label><caption><p>Representative whole-body PET. The images at different time points after injection of (<bold>A</bold>) <sup>18</sup>F-SPAL-T-06 and (<bold>B</bold>) <sup>18</sup>F-C05-05 in the identical subjects (panel A, subject A-1; panel B, subject B-2) are shown. The images are decay-corrected and displayed using the same grey scale. All coronal slices were summed to create the images of each time point.</p></caption><graphic xlink:href="41598_2025_93520_Fig1_HTML" id="d33e507"/></fig>
</p><p id="Par14">
<fig id="Fig2"><label>Fig. 2</label><caption><p>Decay-corrected time-activity curves of selected organs afterinjection of (<bold>A</bold>) <sup>18</sup>F-SPAL-T-06 and (<bold>B</bold>) <sup>18</sup>F-C05-05. Decay-corrected activity in each organ is shown as % injected activity. Symbols represent mean radioactivity of the two subjects in each organ shown as % injected activity. &#x025cb; large intestine, &#x025cf; small intestine, &#x025a1; liver, &#x025a0; biliary tract, &#x025a0; lungs, &#x025c7; heart, &#x025c6; brain, &#x025bd; kidneys, &#x025cf; spleen, &#x025b2; pancreas, &#x025b3; stomach, &#x025b2; red marrow, &#x02605; urinary bladder, &#x02612; thyroid.</p></caption><graphic xlink:href="41598_2025_93520_Fig2_HTML" id="d33e528"/></fig>
</p><p id="Par15">The mean residence times of source organs and the remainder of the body determined by whole-body imaging are shown in Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>. The longest residence time was observed for the liver (0.52&#x000a0;h), followed by the small intestines (0.42&#x000a0;h), biliary tract (0.34&#x000a0;h), and large intestines (0.28&#x000a0;h). The estimation of absorbed radiation doses is shown in Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>. The greatest absorbed dose was observed for the biliary tract (633.5 &#x000b5;Sv/MBq), followed by the doses for lower large intestine wall (164.5 &#x000b5;Sv/MBq), small intestine (132.5 &#x000b5;Sv/MBq), upper large intestine wall (107.3 &#x000b5;Sv/MBq), and liver (91.9 &#x000b5;Sv/MBq). The effective dose per injected activity was 35.9 &#x000b5;Sv/MBq, calculated based on the recommendation in ICRP Publication 103<sup><xref ref-type="bibr" rid="CR11">11</xref></sup>.</p><p id="Par16">
<table-wrap id="Tab2"><label>Table 2</label><caption><p>Residence times of <sup>18</sup>F-SPAL-T-06 for measured source organs .</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2">Organ</th><th align="left" colspan="3">Residence time (h)</th></tr><tr><th align="left">Subject A-1</th><th align="left">Subject A-2</th><th align="left">Mean</th></tr></thead><tbody><tr><td align="left">Brain</td><td align="left">0.0391</td><td align="left">0.0242</td><td align="left">0.0317</td></tr><tr><td align="left">Thyroid</td><td align="left">0.0001</td><td align="left">0.0004</td><td align="left">0.0003</td></tr><tr><td align="left">Lungs</td><td align="left">0.0994</td><td align="left">0.1378</td><td align="left">0.1186</td></tr><tr><td align="left">Heart wall</td><td align="left">0.0422</td><td align="left">0.0338</td><td align="left">0.0380</td></tr><tr><td align="left">Liver</td><td align="left">0.5209</td><td align="left">0.5178</td><td align="left">0.5194</td></tr><tr><td align="left">Biliary tract</td><td align="left">0.3172</td><td align="left">0.3619</td><td align="left">0.3396</td></tr><tr><td align="left">Pancreas</td><td align="left">0.0037</td><td align="left">0.0058</td><td align="left">0.0048</td></tr><tr><td align="left">Spleen</td><td align="left">0.0036</td><td align="left">0.0044</td><td align="left">0.0040</td></tr><tr><td align="left">Stomach</td><td align="left">0.0078</td><td align="left">0.0091</td><td align="left">0.0085</td></tr><tr><td align="left">Small intestine</td><td align="left">0.3233</td><td align="left">0.5077</td><td align="left">0.4155</td></tr><tr><td align="left">Large intestine</td><td align="left">0.3752</td><td align="left">0.1890</td><td align="left">0.2821</td></tr><tr><td align="left">Kidneys</td><td align="left">0.0166</td><td align="left">0.0178</td><td align="left">0.0172</td></tr><tr><td align="left">Red marrow</td><td align="left">0.0398</td><td align="left">0.0722</td><td align="left">0.0560</td></tr><tr><td align="left">Urinary bladder</td><td align="left">0.0341</td><td align="left">0.0274</td><td align="left">0.0307</td></tr><tr><td align="left">Remainder</td><td align="left">0.7842</td><td align="left">0.7134</td><td align="left">0.7488</td></tr></tbody></table></table-wrap>
</p><p id="Par17">
<table-wrap id="Tab3"><label>Table 3</label><caption><p>Estimation of absorbed radiation doses of <sup>18</sup>F-SPAL-T-06 for measured source organs.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2">Target organs</th><th align="left" colspan="3">Absorbed dose (&#x000b5;Sv/MBq)</th></tr><tr><th align="left">Subject A-1</th><th align="left">Subject A-2</th><th align="left">Mean</th></tr></thead><tbody><tr><td align="left">Adrenals</td><td align="left">30.9</td><td align="left">28.8</td><td align="left">29.9</td></tr><tr><td align="left">Brain</td><td align="left">8.4</td><td align="left">5.1</td><td align="left">6.7</td></tr><tr><td align="left">Oesophagus</td><td align="left">16.0</td><td align="left">13.4</td><td align="left">14.7</td></tr><tr><td align="left">Eyes</td><td align="left">5.1</td><td align="left">3.7</td><td align="left">4.4</td></tr><tr><td align="left">Biliary tract</td><td align="left">647.0</td><td align="left">620.0</td><td align="left">633.5</td></tr><tr><td align="left">Lower large intestine wall</td><td align="left">207.0</td><td align="left">122.0</td><td align="left">164.5</td></tr><tr><td align="left">Small intestine</td><td align="left">121.0</td><td align="left">144.0</td><td align="left">132.5</td></tr><tr><td align="left">Stomach wall</td><td align="left">21.3</td><td align="left">17.9</td><td align="left">19.6</td></tr><tr><td align="left">Upper large intestine wall</td><td align="left">129.0</td><td align="left">85.6</td><td align="left">107.3</td></tr><tr><td align="left">Heart wall</td><td align="left">24.8</td><td align="left">21.8</td><td align="left">23.3</td></tr><tr><td align="left">Kidneys</td><td align="left">34.9</td><td align="left">26.0</td><td align="left">30.5</td></tr><tr><td align="left">Liver</td><td align="left">98.7</td><td align="left">85.0</td><td align="left">91.9</td></tr><tr><td align="left">Lungs</td><td align="left">26.3</td><td align="left">27.4</td><td align="left">26.9</td></tr><tr><td align="left">Pancreas</td><td align="left">36.3</td><td align="left">33.2</td><td align="left">34.8</td></tr><tr><td align="left">Red marrow</td><td align="left">14.8</td><td align="left">13.3</td><td align="left">14.1</td></tr><tr><td align="left">Osteogenic cells</td><td align="left">10.2</td><td align="left">9.7</td><td align="left">9.9</td></tr><tr><td align="left">Spleen</td><td align="left">18.3</td><td align="left">14.1</td><td align="left">16.2</td></tr><tr><td align="left">Thymus</td><td align="left">11.1</td><td align="left">9.5</td><td align="left">10.3</td></tr><tr><td align="left">Thyroid</td><td align="left">6.0</td><td align="left">8.2</td><td align="left">7.1</td></tr><tr><td align="left">Urinary bladder wall</td><td align="left">28.0</td><td align="left">20.4</td><td align="left">24.2</td></tr><tr><td align="left">Total body</td><td align="left">15.8</td><td align="left">10.6</td><td align="left">13.2</td></tr><tr><td align="left">Effective dose</td><td align="left">40.4</td><td align="left">31.4</td><td align="left">35.9</td></tr></tbody></table></table-wrap>
</p></sec><sec id="Sec5"><title>Biodistribution and radiation dosimetry of <sup>18</sup>F-C05-05</title><p id="Par18">All organs that were visually identified on<sup>18</sup>F-SPAL-T-06 PET images also showed identifiable uptake on the PET images and were treated as source organs of radioactivity for dosimetry calculations after<sup>18</sup>F-C05-05 injection. Representative whole-body PET images in subject B-2 are shown in Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>B. Whole-body PET images in the other subject B-1 are shown in Supplementary Fig. <xref rid="MOESM1" ref-type="media">S1</xref>B. The tracer was immediately distributed throughout the whole body, accumulated in the liver, and then was gradually excreted through the biliary tract to the intestines. The large intestine showed the greatest uptake with a maximum of 31.7%IA. Rapid washin and washout was observed in the lungs (peak activity: 12.7%IA), heart (12.4%IA), kidneys (3.7%IA), brain (5.6%IA), spleen (1.0%IA), pancreas (1.1%IA), and red marrow (0.9%IA), while the radioactivity gradually increased and subsequently slowly washed out in the liver and biliary tract. Radioactivity accumulated slowly in the small intestine and urinary bladder. Exponential fitting of cumulative activity in the urinary bladder and urine indicated that 20.2% of injected activity was excreted via this route in infinite time with a biological half-life of 2452&#x000a0;min. The time-activity curves of the decay-corrected %IA of each subject are presented in Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>B.</p><p id="Par19">The mean residence times of source organs and the remainder of the body determined by whole-body imaging are shown in Table&#x000a0;<xref rid="Tab4" ref-type="table">4</xref>. The longest residence time was observed for the liver (0.64&#x000a0;h), followed by the small intestine (0.28&#x000a0;h) and the large intestine (0.26&#x000a0;h). Estimation of the absorbed radiation doses is shown in Table&#x000a0;<xref rid="Tab5" ref-type="table">5</xref>. The greatest absorbed dose was observed for the biliary tract (212.0 &#x000b5;Sv/MBq), followed by the doses for the lower large intestine wall (151.5 &#x000b5;Sv/MBq), small intestine (94.2 &#x000b5;Sv/MBq), upper large intestine wall (95.1 &#x000b5;Sv/MBq), and liver (101.4 &#x000b5;Sv/MBq). The effective dose per injected activity was 30.5 &#x000b5;Sv/MBq.</p><p id="Par20">
<table-wrap id="Tab4"><label>Table 4</label><caption><p>Residence times of <sup>18</sup>F-C05-05 for measured source organs.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2">Organ</th><th align="left" colspan="3">Residence time (h)</th></tr><tr><th align="left">Subject B-1</th><th align="left">Subject B-2</th><th align="left">Mean</th></tr></thead><tbody><tr><td align="left">Brain</td><td align="left">0.0425</td><td align="left">0.0614</td><td align="left">0.0520</td></tr><tr><td align="left">Thyroid</td><td align="left">0.0011</td><td align="left">0.0004</td><td align="left">0.0007</td></tr><tr><td align="left">Lungs</td><td align="left">0.0805</td><td align="left">0.0723</td><td align="left">0.0764</td></tr><tr><td align="left">Heart wall</td><td align="left">0.0299</td><td align="left">0.0536</td><td align="left">0.0417</td></tr><tr><td align="left">Liver</td><td align="left">0.6611</td><td align="left">0.6116</td><td align="left">0.6364</td></tr><tr><td align="left">Biliary tract</td><td align="left">0.0456</td><td align="left">0.1447</td><td align="left">0.0952</td></tr><tr><td align="left">Pancreas</td><td align="left">0.0039</td><td align="left">0.0063</td><td align="left">0.0051</td></tr><tr><td align="left">Spleen</td><td align="left">0.0040</td><td align="left">0.0044</td><td align="left">0.0042</td></tr><tr><td align="left">Stomach</td><td align="left">0.0053</td><td align="left">0.0107</td><td align="left">0.0080</td></tr><tr><td align="left">Small intestine</td><td align="left">0.3491</td><td align="left">0.2124</td><td align="left">0.2808</td></tr><tr><td align="left">Large intestine</td><td align="left">0.2866</td><td align="left">0.2310</td><td align="left">0.2588</td></tr><tr><td align="left">Kidneys</td><td align="left">0.0209</td><td align="left">0.0180</td><td align="left">0.0195</td></tr><tr><td align="left">Red marrow</td><td align="left">0.1453</td><td align="left">0.0514</td><td align="left">0.0984</td></tr><tr><td align="left">Urinary bladder</td><td align="left">0.0090</td><td align="left">0.0088</td><td align="left">0.0089</td></tr><tr><td align="left">Remainder</td><td align="left">0.9451</td><td align="left">1.1444</td><td align="left">1.0448</td></tr></tbody></table></table-wrap>
</p><p id="Par21">
<table-wrap id="Tab5"><label>Table 5</label><caption><p>Estimation of absorbed radiation doses of<sup>18</sup>F-C05-05 for measured source organs.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2">Target organs</th><th align="left" colspan="3">Absorbed dose (&#x000b5;Sv/MBq)</th></tr><tr><th align="left">Subject B-1</th><th align="left">Subject B-2</th><th align="left">Mean</th></tr></thead><tbody><tr><td align="left">Adrenals</td><td align="left">28.7</td><td align="left">30.0</td><td align="left">29.4</td></tr><tr><td align="left">Brain</td><td align="left">8.4</td><td align="left">12.9</td><td align="left">10.6</td></tr><tr><td align="left">Oesophagus</td><td align="left">13.4</td><td align="left">17.7</td><td align="left">15.6</td></tr><tr><td align="left">Eyes</td><td align="left">5.1</td><td align="left">7.4</td><td align="left">6.3</td></tr><tr><td align="left">Biliary tract</td><td align="left">113.0</td><td align="left">311.0</td><td align="left">212.0</td></tr><tr><td align="left">Lower large intestine wall</td><td align="left">170.0</td><td align="left">133.0</td><td align="left">151.5</td></tr><tr><td align="left">Small intestine</td><td align="left">105.0</td><td align="left">83.4</td><td align="left">94.2</td></tr><tr><td align="left">Stomach wall</td><td align="left">17.1</td><td align="left">22.1</td><td align="left">19.6</td></tr><tr><td align="left">Upper large intestine wall</td><td align="left">105.0</td><td align="left">85.1</td><td align="left">95.1</td></tr><tr><td align="left">Heart wall</td><td align="left">21.0</td><td align="left">29.5</td><td align="left">25.3</td></tr><tr><td align="left">Kidneys</td><td align="left">27.5</td><td align="left">31.5</td><td align="left">29.5</td></tr><tr><td align="left">Liver</td><td align="left">93.7</td><td align="left">109.0</td><td align="left">101.4</td></tr><tr><td align="left">Lungs</td><td align="left">20.1</td><td align="left">23.1</td><td align="left">21.6</td></tr><tr><td align="left">Pancreas</td><td align="left">29.2</td><td align="left">35.8</td><td align="left">32.5</td></tr><tr><td align="left">Red marrow</td><td align="left">18.8</td><td align="left">16.2</td><td align="left">17.5</td></tr><tr><td align="left">Osteogenic cells</td><td align="left">13.4</td><td align="left">11.9</td><td align="left">12.7</td></tr><tr><td align="left">Spleen</td><td align="left">14.0</td><td align="left">18.1</td><td align="left">16.1</td></tr><tr><td align="left">Thymus</td><td align="left">9.6</td><td align="left">12.9</td><td align="left">11.2</td></tr><tr><td align="left">Thyroid</td><td align="left">13.7</td><td align="left">9.1</td><td align="left">11.4</td></tr><tr><td align="left">Urinary bladder wall</td><td align="left">12.3</td><td align="left">14.4</td><td align="left">13.4</td></tr><tr><td align="left">Total body</td><td align="left">10.9</td><td align="left">15.7</td><td align="left">13.3</td></tr><tr><td align="left">Effective dose</td><td align="left">29.6</td><td align="left">31.4</td><td align="left">30.5</td></tr></tbody></table></table-wrap>
</p></sec></sec><sec id="Sec6"><title>Discussion</title><p id="Par22">In this research, we evaluated the safety, biodistribution, and radiation dosimetry of two novel &#x003b1;-synuclein PET tracers, <sup>18</sup>F-SPAL-T-06 and <sup>18</sup>F-C05-05, in healthy volunteers for the first time. No adverse events were observed during the study and the injections were well tolerated by all subjects. The mean injected doses were 181.0 MBq for <sup>18</sup>F-SPAL-T-06 and 178.4 MBq for <sup>18</sup>F-C05-05, and their estimated effective doses were 35.9 &#x000b5;Sv/MBq for <sup>18</sup>F-SPAL-T-06 and 30.5&#x000a0;&#x000b5;Sv/MBq for <sup>18</sup>F-C05-05. Despite the small number of subjects in this research, the biodistribution and radiation dosimetry showed similar trends for the two tracers.</p><p id="Par23">According to our biodistribution study, both tracers appeared to distribute widely throughout the body and had rapid clearance mainly via the hepatobiliary system and gastrointestinal tract. The observed high uptake in the liver, biliary tract, and intestines of the two tracers confirms this predominant excretion pathway. The absorbed doses in the biliary tract were the highest in both tracers; those high absorbed doses were in line with that in several other amyloid and tau PET tracers (202&#x02013;508 &#x000b5;Sv/MBq) utilized in clinical settings<sup><xref ref-type="bibr" rid="CR12">12</xref>&#x02013;<xref ref-type="bibr" rid="CR16">16</xref></sup>. The male subject of <sup>18</sup>F-C05-05 showed lower uptake in the biliary tract and faster uptake in the small intestines compared to the second subject, which can be explained by the first subject&#x02019;s medical history of cholecystectomy. In other organs, including the brain, rapid washin and washout were observed with both tracers. Similar elimination pattern of the brain has been reported in other <sup>18</sup>F-labeled amyloid and tau PET tracers, including florbetapir<sup><xref ref-type="bibr" rid="CR12">12</xref></sup>, flutemetamol<sup><xref ref-type="bibr" rid="CR13">13</xref></sup>, THK-5351 <sup><xref ref-type="bibr" rid="CR14">14</xref></sup>, flortaucipir<sup><xref ref-type="bibr" rid="CR17">17</xref></sup>, MK-6240 <sup><xref ref-type="bibr" rid="CR15">15</xref></sup>, RO-948 <sup><xref ref-type="bibr" rid="CR18">18</xref></sup>, and florzolotau<sup><xref ref-type="bibr" rid="CR16">16</xref></sup>.</p><p id="Par24">The effective doses of the two tracers were comparable to the other <sup>18</sup>F-labelled tracers previously reported. The effective dose of <sup>18</sup>F-SPAL-T-06 was calculated as 35.9 &#x000b5;Sv/MBq using the tissue weighting factors in ICRP publication 103. Therefore, the mean effective dose was 6.6 mSv when 185 MBq was given to a subject. The effective dose of&#x000a0;<sup>18</sup>F-C05-05 was calculated as 30.5 &#x000b5;Sv/MBq when using the tissue weighting factors. Therefore, the mean effective dose was 5.6 mSv when 185 MBq was given to a subject. The doses were in line with those of other amyloid and tau PET tracers such as florbetapir (5.5 mSv/370 MBq), flutemetamol (6.5 mSv/185 MBq), flortaucipir (4.7 mSv/185 MBq), THK-5351 (8.4 mSv/370 MBq), MK-6240 (5.4 mSv/185 MBq), and PI-2620 (6.1 mSv/185 MBq). The doses were both below 10 mSv, which was suggested as the limit in volunteers for biomedical research with moderate benefit to society in ICRP publication 103. The effective doses of both tracers reported in the present study would allow scans with multiple tracers and multiple repeated scans in the same individual if the combined tracer and dose interval are appropriately set. In addition, radiation exposure combined with other tracers of a moderate effective dose for diagnostic purposes will be justified when disease-modifying therapy is established and implemented.</p><p id="Par25">One limitation of our study is the limited number of samples, compared with the common sample size (3&#x02013;12 subjects) of other studies<sup><xref ref-type="bibr" rid="CR12">12</xref>&#x02013;<xref ref-type="bibr" rid="CR19">19</xref></sup>. In addition, the previous cholecystectomy in the first <sup>18</sup>F-C05-05 subject may have influenced the analyses, as indicated by the 64% decrease in the absorbed dose in the biliary tract and the 26% increase in the small intestine compared with the second case. However, the difference in effective doses between the two samples was relatively small, at 29.6 and 31.4 &#x000b5;Sv/MBq, respectively.</p></sec><sec id="Sec7"><title>Conclusions</title><p id="Par26">Novel &#x003b1;-synuclein PET tracers <sup>18</sup>F-SPAL-T-06 and <sup>18</sup>F-C05-05 were both well tolerated. Their mean effective doses were 35.9 &#x000b5;Sv/MBq for <sup>18</sup>F-SPAL-T-06 and 30.5 &#x000b5;Sv/MBq for <sup>18</sup>F-C05-05.</p></sec><sec id="Sec8"><title>Materials and methods</title><sec id="Sec9"><title>Participants</title><p id="Par27">This study was approved by the Institutional Review Board of the National Institutes for Quantum Science and Technology and was performed in accordance with the ethical standards of the 1964 Declaration of Helsinki and its later amendments. Written informed consent was obtained from all participants. One female and one male healthy volunteer were enrolled for each ligand, <sup>18</sup>F-SPAL-T-06 (body weight 58.0 and 68.2&#x000a0;kg respectively, both 63 years of age) and <sup>18</sup>F-C05-05 (body weight 56.4 and 69.1&#x000a0;kg, age 63 and 73 years, respectively). The same female subject participated in the studies of both ligands. Apart from a history of cholecystectomy in the male subject of <sup>18</sup>F-C05-05, all subjects were free of medical or neuropsychiatric illnesses according to their medical history, physical examination, urinalysis, and blood tests including haematological parameters and blood biochemical test. Blood tests were repeated after the scan, and urine was also collected during the scan for pharmacokinetic measurements.</p></sec><sec id="Sec10"><title>PET scans</title><p id="Par28">After a single intravenous injection of either <sup>18</sup>F-SPAL-T-06 (179.6 MBq and 182.4 MBq) or <sup>18</sup>F-C05-05 (183.4 MBq and 173.3 MBq), 3-dimensional serial PET images were acquired with a Biograph mCT flow system (Siemens Healthcare; matrix size 400&#x02009;&#x000d7;&#x02009;400&#x02009;&#x000d7;&#x02009;575; voxel size [mm] 2&#x02009;&#x000d7;&#x02009;2&#x02009;&#x000d7;&#x02009;2). Individual injected doses are shown in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>. Dynamic PET scans of each subject were performed on a continuously moving bed from head to upper thigh, consisting of three imaging sessions with a 90-minute break between sessions (1.3&#x02013;10&#x000a0;mm/s for 1,150-mm field of view, 17 frames: 115&#x000a0;s &#x000d7; 3, 230&#x000a0;s &#x000d7; 2, 460&#x000a0;s &#x000d7; 3, 884.6&#x000a0;s &#x000d7; 5 frames for the first 120-min session, and 884.6&#x000a0;s &#x000d7; 2 frames for the second and third 30-min sessions).</p><p id="Par29">All PET images were reconstructed with a filtered back-projection (FBP) algorithm with a Hanning filter (4.0&#x000a0;mm full-width at half-maximum) and were corrected for attenuation based on CT images, for randoms using the delayed coincidence counting method, and for scatter using the single-scatter simulation method.</p></sec><sec id="Sec11"><title>Image analyses</title><p id="Par30">Source organs were visually identified on the PET images, including the brain, thyroid, lungs, heart, liver, spleen, stomach, pancreas, kidneys, biliary tract, small intestine, large intestine, urinary bladder, and skeleton. For each subject, regions of interest (ROIs) on source organs were drawn on a slice-by-slice basis on CT images registered with the PET images and adjusted to visually circumscribe most of the activity within the respective source organ of the PET images. CT images acquired prior to each of the three sessions were used as reference for the corresponding frames. As for each organ except for the biliary tract, intestines, and urinary bladder, we chose the most visible frame to adjust the ROI and applied it to the remaining frames. For the biliary tract, intestines, and urinary bladder, ROIs were drawn frame-by-frame on the PET images. For the skeleton, ROIs were drawn only on the bodies of the lumbar vertebrae. Images were analysed using PMOD 4.402 software (PMOD Technologies, Zurich, Switzerland).</p></sec><sec id="Sec12"><title>Residence time calculations</title><p id="Par31">The calculation of residence time was based on a previously reported method<sup><xref ref-type="bibr" rid="CR19">19</xref></sup>. The residence time in each source organ was calculated as the area under the curve (AUC) of the time-activity curve, which was created after removing the decay correction and expressed as a percentage of injected activity (%IA) after applying a recovery correction. The time-activity curves were created with time information that was estimated from the starting time of each frame and the distance from the top of the field-of-view to the centre of each ROI divided by the bed speed of each frame. The AUC to the end of imaging was calculated by the trapezoidal method, and from the end to infinity was calculated by assuming that further decline in radioactivity occurred only by physical decay without any biological clearance. This assumption should not introduce any significant bias as the activity was very minor at the last time point, which was approximately 360&#x000a0;min or more than three half-lives after the injection.</p><p id="Par32">The residence time of all red marrow in the body was estimated from that in the lumbar vertebrae. To estimate the absorbed radiation doses conservatively, we assigned all radioactivity in the lumbar vertebrae to red marrow. Because the mass of red marrow in the lumbar vertebrae is 12.3% of the mass of all red marrow in the body (ICRP Publication 89), the residence time in red marrow in the entire body was calculated by multiplying that of the lumbar vertebrae by 100/12.3.</p><p id="Par33">The residence time of the urinary bladder wall was calculated by applying the dynamic urinary bladder model<sup><xref ref-type="bibr" rid="CR20">20</xref></sup> to the combined data from images and urine samples. The decay-corrected cumulative urinary activity from all subjects was fit to a biexponential curve. The residence time was calculated on the basis of 2.4-h voiding intervals.</p><p id="Par34">To calculate the residence time of the remainder of the body, the residence time of all source organs was summed up and subtracted from the fixed theoretical value of <italic>T</italic><sub>1/2</sub> / ln 2, which equals 2.640&#x000a0;h for<sup>18</sup>F.</p></sec><sec id="Sec13"><title>Estimation of absorbed dose</title><p id="Par35">The absorbed radiation doses for both female and male subjects were calculated using the Medical Internal Radiation Dose scheme by entering the residence times into OLINDA/EXM 2.2 software (Hermes Medical Solutions, Stockholm, Sweden) according to the ICRP 89 models for adult females and males. Then, effective doses were calculated in OLINDA/EXM based on the recommendation in ICRP Publication 103. Mean effective doses of female and male subjects were reported.</p></sec></sec><sec id="Sec14" sec-type="supplementary-material"><title>Electronic supplementary material</title><p>Below is the link to the electronic supplementary material.</p><p>
<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="41598_2025_93520_MOESM1_ESM.pdf"><caption><p>Supplementary Material 1</p></caption></media></supplementary-material>
</p></sec></body><back><fn-group><fn><p><bold>Publisher&#x02019;s note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn><fn><p>Ryoji Goto and Kiwamu Matsuoka contributed equally to this work.</p></fn></fn-group><ack><title>Acknowledgements</title><p>We would like to thank all the subjects for participation in this study, and the staff of the Department of Advanced Nuclear Medicine Sciences at the National Institutes for Quantum Science and Technology for technical assistance.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>KM, MH, and HE conceptualized and designed the study. Material preparation and data collection were performed by KM, YK, MO, KH, KT, KT, CS, YK, KK, M-RZ, and HE. Formal analyses were performed by RG, KM, YK, and HE. The study was supervised by HE and MH. The first draft of the manuscript was written by RG, and all authors read and approved the final manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>This work was supported by Eisai Co., Ltd., Takeda Pharmaceutical Company Limited, Ono Pharmaceutical Co., Ltd.,&#x000a0;and Japan Agency for Medical Research and Development (AMED) under Grant Number JP21wm0425015 and JP24wm0625001.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>Data supporting the findings of this study are available from the corresponding author upon reasonable request.</p></notes><notes><title>Declarations</title><notes id="FPar2" notes-type="COI-statement"><title>Competing interests</title><p id="Par37">Ming-Rong Zhang and Makoto Higuchi are inventors of a patent application in relation to the imaging agents documented in this report, <sup>18</sup>F-SPAL-T-06 (PCT/JP2021/30899) and <sup>18</sup>F-C05-05 (2019-034997, PCT/JP2020/002607). All other authors have no conflicts of interest to declare.</p></notes><notes id="FPar3"><title>Ethics approval</title><p id="Par38">This study was approved by the Institutional Review Board of the National Institutes for Quantum Science and Technology and was performed in accordance with the ethical standards of the 1964 Declaration of Helsinki and its later amendments. The studies were registered with the Japan Registry for Clinical Trials (jRCTs031210180 and jRCTs031220123).</p></notes><notes id="FPar1"><title>Consent for publication</title><p id="Par36">All images are entirely unidentifiable and there are no details on the individuals reported.</p></notes><notes id="FPar4"><title>Consent to participate (including appropriate statements)</title><p id="Par39">Written informed consent was obtained from all participants or their caregivers.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Wakabayashi</surname><given-names>K</given-names></name><etal/></person-group><article-title>Accumulation of alpha-synuclein/NACP is a cytopathological feature common to lewy body disease and multiple system atrophy</article-title><source>Acta Neuropathol.</source><year>1998</year><volume>96</volume><fpage>445</fpage><lpage>452</lpage><pub-id pub-id-type="doi">10.1007/s004010050918</pub-id><pub-id pub-id-type="pmid">9829807</pub-id>

<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" dtd-version="1.3" xml:lang="en" article-type="research-article"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">BMJ Open</journal-id><journal-id journal-id-type="iso-abbrev">BMJ Open</journal-id><journal-id journal-id-type="hwp">bmjopen</journal-id><journal-id journal-id-type="publisher-id">bmjopen</journal-id><journal-title-group><journal-title>BMJ Open</journal-title></journal-title-group><issn pub-type="epub">2044-6055</issn><publisher><publisher-name>BMJ Publishing Group</publisher-name><publisher-loc>BMA House, Tavistock Square, London, WC1H 9JR</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">38365300</article-id><article-id pub-id-type="pmc">10875539</article-id>
<article-id pub-id-type="publisher-id">bmjopen-2023-077366</article-id><article-id pub-id-type="doi">10.1136/bmjopen-2023-077366</article-id><article-categories><subj-group subj-group-type="heading"><subject>Obstetrics and Gynaecology</subject></subj-group><subj-group subj-group-type="hwp-journal-coll"><subject>1506</subject><subject>1845</subject></subj-group><series-title>Protocol</series-title></article-categories><title-group><article-title>Pattern Recognition and Anomaly Detection in fetal morphology using Deep Learning and Statistical learning (PARADISE): protocol for the development of an intelligent decision support system using fetal morphology ultrasound scan to detect fetal congenital anomaly detection</article-title></title-group><contrib-group><contrib id="author-84028256" contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0003-2950-3501</contrib-id><name><surname>Belciug</surname><given-names>Smaranda</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib id="author-109513076" contrib-type="author"><name><surname>Ivanescu</surname><given-names>Renato Constantin</given-names></name><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-109513077" contrib-type="author"><name><surname>Serbanescu</surname><given-names>Mircea Sebastian</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-114234130" contrib-type="author"><name><surname>Ispas</surname><given-names>Florin</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib id="author-84028602" contrib-type="author"><name><surname>Nagy</surname><given-names>Rodica</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-109513080" contrib-type="author"><name><surname>Comanescu</surname><given-names>Cristina Maria</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-109513081" contrib-type="author"><name><surname>Istrate-Ofiteru</surname><given-names>Anca</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-109513082" contrib-type="author"><name><surname>Iliescu</surname><given-names>Dominic Gabriel</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib></contrib-group><aff id="aff1"><label>1</label><institution content-type="department">Department of Computer Science</institution>, <institution specific-use="Ringgold_91861">University of Craiova</institution>, <addr-line content-type="city">Craiova</addr-line>, <country>Romania</country></aff><aff id="aff2"><label>2</label><institution content-type="department">Department of Computers and Information Technology</institution>, <institution specific-use="Ringgold_91861">University of Craiova</institution>, <addr-line content-type="city">Craiova</addr-line>, <country>Romania</country></aff><aff id="aff3"><label>3</label><institution specific-use="Ringgold_121532">University of Medicine and Pharmacy of Craiova</institution>, <addr-line content-type="city">Craiova</addr-line>, <country>Romania</country></aff><author-notes><corresp><label>Correspondence to</label> Smaranda Belciug; <email>sbelciug@inf.ucv.ro</email></corresp></author-notes><pub-date pub-type="collection"><year>2024</year></pub-date><pub-date pub-type="epub"><day>15</day><month>2</month><year>2024</year></pub-date><volume>14</volume><issue>2</issue><elocation-id>e077366</elocation-id><history><date date-type="received"><day>04</day><month>7</month><year>2023</year></date><date date-type="accepted"><day>26</day><month>1</month><year>2024</year></date></history><permissions><copyright-statement>&#x000a9; Author(s) (or their employer(s)) 2024. Re-use permitted under CC BY-NC. No commercial re-use. See rights and permissions. Published by BMJ.</copyright-statement><copyright-year>2024</copyright-year><ali:free_to_read xmlns:ali="http://www.niso.org/schemas/ali/1.0/"/><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbynclicense" start_date="2024-02-15">https://creativecommons.org/licenses/by-nc/4.0/</ali:license_ref><license-p>This is an open access article distributed in accordance with the Creative Commons Attribution Non Commercial (CC BY-NC 4.0) license, which permits others to distribute, remix, adapt, build upon this work non-commercially, and license their derivative works on different terms, provided the original work is properly cited, appropriate credit is given, any changes made indicated, and the use is non-commercial. See:&#x000a0;<ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc/4.0/">http://creativecommons.org/licenses/by-nc/4.0/</ext-link>.</license-p></license></permissions><self-uri xlink:title="pdf" xlink:href="bmjopen-2023-077366.pdf"/><self-uri content-type="reviewers-comments-pdf" xlink:href="bmjopen-2023-077366.reviewer_comments.pdf"/><self-uri content-type="draft-revisions-pdf" xlink:href="bmjopen-2023-077366.draft_revisions.pdf"/><abstract><sec><title>Introduction</title><p>Congenital anomalies are the most encountered cause of fetal death, infant mortality and morbidity. 7.9&#x02009;million infants are born with congenital anomalies yearly. Early detection of congenital anomalies facilitates life-saving treatments and stops the progression of disabilities. Congenital anomalies can be diagnosed prenatally through morphology scans. A correct interpretation of the morphology scan allows a detailed discussion with the parents regarding the prognosis. The central feature of this project is the development of a specialised intelligent system that uses two-dimensional ultrasound movies obtained during the standard second trimester morphology scan to identify congenital anomalies in fetuses.</p></sec><sec><title>Methods and analysis</title><p>The project focuses on three pillars: committee of deep learning and statistical learning algorithms, statistical analysis, and operational research through learning curves. The cross-sectional study is divided into a training phase where the system learns to detect congenital anomalies using fetal morphology ultrasound scan, and then it is tested on previously unseen scans. In the training phase, the intelligent system will learn to answer the following specific objectives: (a) the system will learn to guide the sonographer&#x02019;s probe for better acquisition; (b) the fetal planes will be automatically detected, measured and stored and (c) unusual findings will be signalled. During the testing phase, the system will automatically perform the above tasks on previously unseen videos.</p><p>Pregnant patients in their second trimester admitted for their routine scan will be consecutively included in a 32-month study (4 May 2022&#x02013;31 December 2024). The number of patients is 4000, enrolled by 10 doctors/sonographers. We will develop an intelligent system that uses multiple artificial intelligence algorithms that interact between themselves, in bulk or individual. For each anatomical part, there will be an algorithm in charge of detecting it, followed by another algorithm that will detect whether anomalies are present or not. The sonographers will validate the findings at each intermediate step.</p></sec><sec><title>Ethics and dissemination</title><p>All protocols and the informed consent form comply with the Health Ministry and professional society ethics guidelines. The University of Craiova Ethics Committee has approved this study protocol as well as the Romanian Ministry of Research Innovation and Digitization that funded this research. The study will be implemented and reported in line with the STROBE (STrengthening the Reporting of OBservational studies in Epidemiology) statement.</p></sec><sec><title>Trial registration number</title><p>The study is registered under the name &#x02018;Pattern recognition and Anomaly Detection in fetal morphology using Deep Learning and Statistical Learning&#x02019;, project number 101PCE/2022, project code PN-III-P4-PCE-2021-0057. Trial registration: ClinicalTrials.gov, unique identifying number <ext-link xlink:href="NCT05738954" ext-link-type="ClinicalTrials.gov">NCT05738954</ext-link>, date of registration: 2 November 2023.</p></sec></abstract><kwd-group><kwd>Prenatal diagnosis</kwd><kwd>STATISTICS &#x00026; RESEARCH METHODS</kwd><kwd>Health informatics</kwd><kwd>Fetal medicine</kwd></kwd-group><funding-group specific-use="FundRef"><award-group id="funding-1"><funding-source>
<institution-wrap><institution-id institution-id-type="FundRef">http://dx.doi.org/10.13039/100018987</institution-id><institution>Ministerul Cercet&#x00103;rii, Inov&#x00103;rii &#x0015f;i Digitaliz&#x00103;rii</institution></institution-wrap>
</funding-source><award-id>PN-III-P4-PCE-2021-0057</award-id></award-group></funding-group><custom-meta-group><custom-meta><meta-name>special-feature</meta-name><meta-value>unlocked</meta-value></custom-meta></custom-meta-group></article-meta></front><body><boxed-text id="BX1" position="float"><caption><title>STRENGTHS AND LIMITATIONS OF THIS STUDY</title></caption><list list-type="bullet"><list-item><p>The study incorporates a gradient risk at several levels.</p></list-item><list-item><p>The study combines conventional classical artificial intelligence algorithms with novel approaches.</p></list-item><list-item><p>The study provides statistical comparison of the performances and operational research methods to test the system outside the lab.</p></list-item><list-item><p>Lack of experienced obstetrics-gynaecology (OB-GYN) sonographers.</p></list-item><list-item><p>Limited availability of the OB-GYN specialists to gather and label data.</p></list-item></list></boxed-text><sec sec-type="intro" id="s1"><title>Introduction</title><p>Worldwide, congenital anomalies (CAs) are the most encountered cause of fetal death, infant mortality and morbidity throughout infancy.<xref rid="R1" ref-type="bibr">1</xref> Within the first 28 days after birth, almost 295 000 neonates die due to CAs. According to the European Monitoring of Congenital Anomalies EUROCAT report,<xref rid="R2" ref-type="bibr">2</xref> every year, around the world 7.9&#x02009;million infants (6%) are born with CAs. Some CAs can be managed, controlled and even treated, but still 3.2&#x02009;million (40.50%) children out of 7.9 will remain disabled for life.<xref rid="R3" ref-type="bibr">3</xref> The detection rates of CAs vary from country to country, due to social, economic or racial reasons.<xref rid="R4" ref-type="bibr">4</xref></p><p>Early detection of CAs can enable life-saving treatments and stop the progression of certain disabilities. The study is intended to increase the diagnosing performance of CAs using deep learning (DL) and statistical learning (SL).</p><p>CAs can be diagnosed prenatally during a morphology scan (MS), also known as an ultrasound scan.<xref rid="R5" ref-type="bibr">5</xref> Towards this end, we propose a novel theory on how to build an advanced artificial intelligence (AI)-based MS system that is able to identify the presence of CAs, as well as methods to test this theory and develop it further. To simplify matters, we intend to explore two perspectives: what is MS and how can we make it &#x02018;smarter&#x02019;?</p><p>What do we know about MS? We know that is the most important prenatal diagnostic tool for detecting CAs. As the ultrasound waves sent back to the transducer create a moving picture of different anatomical parts of the fetus, the sonographer can evaluate the structure and functionality of that organ. This is not a routine procedure since it is crucial to be performed by a skilled sonographer. Sonographers are still far from an accurate detection of CAs during the second trimester MS. The results reported in literature show that the detection rate of some CAs for a sonographer with more than 2000 MS examination experience is of only 52%, while for a sonographer with less than 2000 MS examinations experience is 32.5%.<xref rid="R6" ref-type="bibr">6</xref> A recent study found an overall CA detection rate of 69% in a Danish region. The researchers used a cohort of 19 367 fetuses with a complete follow-up 6&#x02009;months after birth.<xref rid="R7" ref-type="bibr">7</xref></p><p>The importance of a correct interpretation of MS allows the possibility of having a detailed discussion with the soon-to-be parents regarding the fetus&#x02019; prognosis: procedural risks, long-term mortality, morbidity and quality of life.<xref rid="R8" ref-type="bibr">8&#x02013;18</xref> Having a correct prenatal diagnosis of CAs improves the neonatal and paediatric care, and thus the neurological and surgical outcome. The current approaches have limitations. A study of prenatal and postnatal diagnosis discrepancy of a CA obtained through a manually performed MS reported the sensitivity between 27.5% and 96%.<xref rid="R19" ref-type="bibr">19</xref> Having not enough experience, being tired, time-pressured, the involuntary movement of the fetus and other patient characteristics might make it difficult, if not impossible, for a sonographer to get a clear ultrasound image.</p><p>MS is regarded as observer dependent, but the use of videos recorded in a standardised manner might alleviate this issue. An Intelligent Decision Support System (IS), mainly a decision support system which uses AI, is able to collect and analyse data, establish communications with other IS, learn from experience and ultimately adapt to new cases. In this project, we are merging AI algorithms and statistics and apply them in video processing MS. The novel IS will have a major impact on medical practice and discovery. IS can be seen as a machine that observes and responds to the environment that it has been exposed to using AI. An effective diagnosis of CA through MS demands a strong liaison between the sonographer and the IS.</p><p>Even if the subject is critical, relatively little work has been published in this area. To clear matters, we shall present the quantitative and qualitative differences between our proposed project and other state-of-the-art studies. Fujitsu, the Cancer Translational Research Team and the Department of Obstetrics and Gynecology Showa University School of Medicine have made a joint venture and started a research project, which regards the fetal heart and uses only DL algorithms.<xref rid="R20" ref-type="bibr">20 21</xref> The authors reported that the obtained recall ranged between 61.9 and 100. In another study, Namburete <italic toggle="yes">et al</italic> proposed a fully convolutional neural network that is able to segment the three-dimensional (3D) fetal brain and to reconstruct it.<xref rid="R22" ref-type="bibr">22</xref> Since it is a reconstruction method, the authors did not report any performance measure. The fetal brain and lungs can be segmented by applying DL, sequential forward feature selection techniques and support vector machine mixture on magnetic resonance and ultrasound images, achieving a dice score of 0.78.<xref rid="R23" ref-type="bibr">23</xref> DL was used to segment the fetal head in,<xref rid="R24" ref-type="bibr">24</xref> where the authors reported a dice score that ranged between 0.70 and 0.76. The limitation of these studies is due to the use of only one AI method, DL. It can be easily seen that DL is now a very widespread technique when it comes to the medical imaging field, unfortunately, the use of only one AI technique per system does not fully emphasises its true computational power, which requires multiple methods working together to provide a better solution than a stand-alone one. To this end, we have obtained preliminary results that sustain our hypothesis. For instance, in Belciug,<xref rid="R25" ref-type="bibr">25</xref> we have created a merger between convolutional neural networks and differential evolution and applied it on five different imaging datasets. We have compared our method&#x02019;s results with four different state-of-the-art DL methods (VGG16, ResNet50, InceptionV3 and DenseNet169) and demonstrated that the merger obtained a better performance than the rest on two datasets: 96.20% vs 92.98% (the accuracy of the best-performing DL), 78.72% vs 74.02% and similar results on the other three. Another created merger was between DL and evolutionary computation (EC).<xref rid="R26" ref-type="bibr">26</xref> In this study, the statistical analysis revealed that the new system was performing better than the stand-alone methods (DenseNet201 and ResNet50), obtaining an accuracy of 74.62% vs 70.24% and 69.11%, respectively. Another new approach that uses multiple DL and SL was presented in Belciug and Iliescu.<xref rid="R27" ref-type="bibr">27</xref> In this case, we have created a DL and Gaussian mixture modelling (GMM) clustering mix which was compared with ResNet50, DenseNet121, InceptionV3, EfficientNetV2S, MobilneNetV3Large and Xception. Our method proved to be superior when applied on two datasets, 81.92% vs 78.88% (the accuracy of the best-performing DL) and 92.12% vs 90.02% (the accuracy of the best-performing DL).</p><p>Other differences consist in the fact that they are focusing on only one anatomical part, and not the fetus, and that they are using 3D/four-dimensional (4D) or MRIs which request specific training, special conditions, and more important expensive equipment and software. Our overall objective is to develop an advanced intelligent automatic interpretation of two-dimensional videos of MS sweeps, which represent a common practice in MS, while previous attempts were made using 4D acquisitions that are rarely present in general practice.</p><p>Our approach is bold and totally different from the others. The core objective of the project is the progress towards an IS that identifies and measures automatically all the anatomical parts of the fetus and detects CAs in MS examinations, as it is a clear step towards reducing the mortality and morbidity rates in infants and children. We propose a ground-breaking research: the development of a specialised IS that embeds a committee of DL and SL methods, which work together in a competitive/collaborative way to increase the accuracy of MS examinations through automated identification of anatomical organs and anomaly detection. We hypothesise that this advanced DL+SL system can be applied successfully in CA detection.</p><p>The goal of this project is to develop the first advanced IS for aiding the medical staff to diagnose CA through MS. This will require highly trained obstetrics-gynaecology (OB-GYN) doctors who have the know-how to diagnose CA using MS, non-trivial programming skills for developing the software, non-trivial mathematics for designing the AI models, non-trivial statistics for benchmarking and establishing the hierarchy of the competitors and know-how in operational research for determining the performance of the IS outside the lab.</p></sec><sec sec-type="methods" id="s2"><title>Methods and analysis</title><sec id="s2-1"><title>Aim</title><p>The rate of diagnosis through screening tests is still insufficient. We aim to build an intelligent system that will provide the sonographer aid in case of lack of experience, fatigue or time pressure. The system will constrain the doctor to acquire standard view planes, will keep track of all anatomical structures that have been examined and will indicate the ones that might have been missed. In the case where the system detects anomalies, it will signal the doctor, for double-checking that organ/functionality. In the end, we aim to:</p><list list-type="bullet"><list-item><p>Provide patient access to high-quality medical care. Most pregnant individuals do not afford antenatal care, and even more they cannot afford MS.</p></list-item><list-item><p>Provide a tool to bridge the gap between knowledge and expertise of sonographers in every small town, even in poor countries, so that we can trust the results of the MS examination.</p></list-item><list-item><p>Avoid misinterpretation due to fatigue, time, pressure, fetal involuntary movement, contractions and different patient characteristics.</p></list-item><list-item><p>Address specific difficulties in CAs diagnosis attributed to fetal constant motion and small size.</p></list-item></list><p>The IS will guide the sonographer&#x02019;s probe for better acquisition of the fetal biometric plane. The fetal plane will be automatically detected, measured and stored, after which the organs are automatically segmented, and unusual findings identified.</p></sec><sec id="s2-2"><title>Patient and public involvement</title><p>Patients or the public were not involved in the design, or conduct, or reporting, or dissemination plans of our research.</p></sec><sec id="s2-3"><title>Study design and setting</title><p>The study&#x02019;s idea is unique, and it focuses on three pillars, namely committee of DL and SL algorithms, statistical analysis and operational research through learning curves. This is high-risk research because of the cross-disciplinary methodology (combining medical practice with DL+SL, statistics and operational research) on a very sensitive and emotional subject, but it is also high gain. The study requires highly trained OB-GYN doctors who have the know-how to diagnose CAs, non-trivial programming skills for developing the software, and non-trivial mathematics for designing the DL+SL competitors, non-trivial statistics for benchmarking and establishing the hierarchy of the competitors, and know-how in the operation research for determining the performance of the IS outside the lab.</p><p>The screening and prenatal diagnosis will take place at the University Emergency County Hospital of Craiova, a tertiary maternity hospital.</p></sec><sec id="s2-4"><title>Participants characteristics</title><p>All pregnant patients who had their sex assigned at birth as female, aged between 18 and 50 years, in their second trimester are considered eligible for this study. Taking into account the availability of the US operators involved in this research, the patients will be consecutively included in the study. Multiple collaborators will be contacted to take part of the team and investigate as many fit cases as possible. Pregnant patients will be admitted for their second trimester anomaly scan between the 18th and 22nd weeks of pregnancy. Gestational age will be determined and confirmed using the ultrasound estimation as the gold standard. We shall also consider the last menstrual period as a secondary variable for determining it. We estimate around 4000 patients to be enrolled in the study.</p></sec><sec id="s2-5"><title>Procedures</title><sec id="s2-5-1"><title>Recruitment</title><p>During the regular second trimester consultations, the sonographer will verbally inform the patients about the research and will invite them to take part of the study. If they accept the invitation, the sonographer will provide further information about the purpose and nature of the present study. All patients will give written consent during their consult. The data will be anonymised and secured, since it will be treated as confidential. The patients will be recruited between 4 May 2022 and 31 December 2024.</p></sec><sec id="s2-5-2"><title>Interventions</title><p>The pregnant patients who are eligible will be examined by sonographers who have at least 3 years of experience in performing MS.</p></sec><sec id="s2-5-3"><title>Data set</title><sec id="s2-5-3-1"><title>Ultrasound examination</title><p>Experienced sonographers will perform the MS scans on pregnant patients who participate in the study, between weeks 18th and 22nd of pregnancy. The scans will be acquired using Voluson 730 Pro (GE Medical Systems, Zipf, Austria) and Logic e (GE Healthcare, China US machines) with 2&#x02013;5 MHz, 4&#x02013;8 MHz and 5&#x02013;9 MHz curvilinear transducers. The ultrasound examinations will be performed transabdominally (or transvaginal depending on the case). All safety guidelines will be followed.</p></sec><sec id="s2-5-3-2"><title>Dataset organisation</title><p>For the IS to perform with high performance, a high number of sample images are needed for each part of the fetus. The OB-GYN team divided the following anatomical planes of the fetal body. Each anatomical plane is split into different view planes. <xref rid="T1" ref-type="table">Table 1</xref> presents the anatomical planes used to complete the protocol for basic mid-trimester fetal anatomical survey, considering the ISUOG (International Society of Ultrasound in Obstetrics &#x00026; Gynecology) practice guidelines of the routine mid-trimester fetal ultrasound scan.<xref rid="R5" ref-type="bibr">5</xref></p><table-wrap position="float" id="T1"><label>Table 1</label><caption><p>Anatomical planes for basic mid-trimester fetal anatomical survey</p></caption><table frame="hsides" rules="groups"><tbody><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Head</td><td align="left" valign="bottom" rowspan="1" colspan="1">Intact cranium</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Head shape</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Cavum septi pellucidi</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Choroid plexus</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Midline falx</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Thalami</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Lateral cerebral ventricles</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Cerebellum</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Cisterna magna</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Nuchal fold</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Face</td><td align="left" valign="top" rowspan="1" colspan="1">Orbits and bulbi</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Midsagittal facial profile</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Nasal bone</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Upper lip</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Neck</td><td align="left" valign="top" rowspan="1" colspan="1">Absence of masses</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Chest/heart</td><td align="left" valign="top" rowspan="1" colspan="1">Shape/size of chest and lungs</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Heart activity</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Four-chamber view</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Aortic and pulmonary outflow tracts</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">LVOT, three-vessel and three-vessel and trachea</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">No evidence of diaphragmatic hernia</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Abdomen</td><td align="left" valign="top" rowspan="1" colspan="1">Stomach</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Bowel</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Kidney</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Urinary bladder</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Cord insertion into fetal abdomen</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Skeletal</td><td align="left" valign="top" rowspan="1" colspan="1">Transverse and sagittal vies</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Arms, hands, joint position</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Legs, feet, joint position</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Placenta</td><td align="left" valign="top" rowspan="1" colspan="1">Placental position and relation to cervix</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Umbilical cord</td><td align="left" valign="top" rowspan="1" colspan="1">Three-vessel cord</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1"/><td align="left" valign="top" rowspan="1" colspan="1">Cord insertion into placenta</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Genitalia</td><td align="left" valign="top" rowspan="1" colspan="1">Male or female genitalia</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Cervix</td><td align="left" valign="top" rowspan="1" colspan="1">Cervix length</td></tr></tbody></table><table-wrap-foot><fn id="T1_FN1"><p>LVOT, left ventricular outflow tract.</p></fn></table-wrap-foot></table-wrap><p>Besides the standard views of each plane, we will add another class named other, which will include frames that do not represent a particular frame. The US video will be split into frames. The sonographer will select the best frames and place them into the dedicated folder. All images will be uploaded into a shared folder in cloud storage, where all the members of the project have access. As the frames are uploaded into the cloud, the IT team will anonymise the images, secure them and upload the preprocessed version in another shared folder in the cloud storage. The sonographers will segment the anatomical structures on the clean version of the images.</p><p>A Hauppauge video recorder will be attached to the US machine, and as the sonographer starts performing an MS, the US video will be recorded. The video recorded captures only the ultrasound videos, without the sonographer&#x02019;s movements and/or ultrasound machine keyboard. These videos will serve for testing the IS on an MS, to see whether the standard view planes and anatomical structures are correctly identified and diagnosed.</p></sec><sec id="s2-5-3-3"><title>Data preprocessing</title><p>The OB-GYN team, while performing MS, will save all the frames that give the most information regarding the organs in each key view plane in separate folders and upload them into the cloud. The IT team will proceed with the anonymisation process and with the elimination of different artefacts from the images. The anonymisation process implies deleting the names and other sensitive information that regard the patient from the images. We will keep all types of images whether they are zoomed in or out, and whether the sonographer used Doppler or not. We will disregard images that are not in greyscale mode (ie, sepia). For this process, we will use CV2 (Computer Vision2) and Keras-OCR. The text from the images will be detected using Optical Character Recognition and removed from the image. The missing parts will be inpainted using the surrounding pixels. Because this algorithm is bound to produce in some cases false positives (detects text where there is none), we will manually recheck each image from the dataset to mend this issue. After the text is identified in the picture, a bounding box that contains its coordinates will be created. Each box will have a mask applied to, which the algorithm will afterward inpaint.</p><p><xref rid="F1" ref-type="fig">Figure 1</xref> presents a sample image before and after preprocessing.</p><fig position="float" id="F1"><label>Figure 1</label><caption><p>(A) Unprocessed image with text and other callipers which need to be removed; (B) Preprocessed image in which the text and callipers have been removed using CV2 and Keras OCR. OCR, Optical Character Recognition; CV2, Computer Vision 2.</p></caption><graphic xlink:href="bmjopen-2023-077366f01" position="float"/></fig><p>85% of whole dataset will be split into training and validation having as proportions 80% and 20%. The remaining 15% will represent the hold-out set, that is, never been part of the training set, hence those images have never been seen by the IS, and thus potential information leakage is avoided. All the hyperparameters of the DL models and SL algorithm are determined using the training set by cross-validation. All stand-alone and merged models will be evaluated and compared on the hold-out testing set. The same proportions will be kept for each class.</p><p>Besides all the classes presented in <xref rid="T1" ref-type="table">table 1</xref>, the IS will need another class to learn from, a class which contains image frames that do not contain a key plane, the other class. While the fetus breathes and moves it is possible that during a certain sweep to appear multiple classes. The class other will be used to make the IS learn to differentiate between the moment when the sonographer moves the transducer to change the view plane, and the involuntary changes produced by the fetus. Without this class, the algorithm will be forced to classify every &#x02018;between&#x02019; sweeps frame as a keyframe, which would be incorrect.</p></sec><sec id="s2-5-3-4"><title>Modus operandi</title><p>This project integrates computer science, medicine and mathematics. Because the project is multidisciplinary, in the research team, there will be OB-GYN doctors and computer scientists. The OB-GYN team will enrol the patients, perform MS, diagnose CAs and help the IT team label the anatomical structures and view planes. <xref rid="F2" ref-type="fig">Figure 2</xref> presents the project workflow, and <xref rid="F3" ref-type="fig">figure 3</xref> presents the IS architecture for MS.</p><fig position="float" id="F2"><label>Figure 2</label><caption><p>Project workflow. AI, artificial intelligence; IS, Intelligent Decision Support System; OB-GYN, obstetrics-gynaecology.</p></caption><graphic xlink:href="bmjopen-2023-077366f02" position="float"/></fig><fig position="float" id="F3"><label>Figure 3</label><caption><p>IS architecture for MS. IS, Intelligent Decision Support System; MS, morphology scan.</p></caption><graphic xlink:href="bmjopen-2023-077366f03" position="float"/></fig><p>To limit the risk and guarantee the success of the project, the research plan has been designed with a highly iterative approach, the issues that appear during a complete cycle will be corrected in the next cycle by modifying each phase accordingly to the lessons learnt in the previous step. This can be thought of as being a Markovian process. This process is designed to incorporate a gradient of risk at several levels by combining conventional classical AI algorithms with novel AI approaches, and statistical validation of each method and module.</p><p>The idea behind the committee of AI machines that work in a competitive/collaborative way proved to be a very good tool to differentiate between classes in previous results.<xref rid="R28" ref-type="bibr">28</xref> This technique is ready to be used in a more systematic approach in the MS examination. We use the competitive phase to establish the most suitable AI technique for identifying anomalies for each anatomical structure, and use the collaborative phase to make all these AI work together in providing a &#x02018;second&#x02019; opinion. This project allows us to go one step further, by having not one, but multiple such committees that work ensemble. This approach will provide us an AI tool that identifies exactly where the anomalies appear in the fetus&#x02019; body, whether it is on only one anatomical structure, or on multiple ones.</p></sec><sec id="s2-5-3-5"><title>DL and SL algorithms</title><p>At this stage of the study, we have already proposed and developed several DL merged with SL algorithms that have proved to be performant in comparison with other state-of-the-art techniques:</p><list list-type="alpha-lower"><list-item><p>We have proposed the use of differential evolution (DE) in determining the best DL architecture. DE is an optimisation method that mimics the biological evolution by generating a temporary individual having as starting point the differences within the populations. DE has proved to have a good global convergence and robustness. We have used DE to determine the best architecture of a DL. The method has been applied on several medical datasets and obtained competitive performance. Further details regarding the technical steps of this algorithm can be found in Belciug.<xref rid="R25" ref-type="bibr">25</xref></p></list-item><list-item><p>Another algorithm was created by merging EC with DL. We have used this of optimisation algorithm to establish the DL architecture. EC starts with a population of chromosomes that are subjected to different selection mechanism based on a certain fitness function, cross-over for new offspring production and mutation for escaping the local minima or maxima. Further details regarding the technical steps of this algorithm can be found in Ivanescu <italic toggle="yes">et al</italic>.<xref rid="R26" ref-type="bibr">26</xref></p></list-item><list-item><p>Another merger between DL and SL was developed by combining different state-of-the-art DLs with GMM. GMM is a clustering technique that uses the mean and SD to cluster the DL models. The final decision was given by a synergetic voting system of the best-performing methods clustered by GMM. Further details regarding the technical steps of this algorithm can be found in Belciug and Iliescu.<xref rid="R27" ref-type="bibr">27</xref></p></list-item></list></sec><sec id="s2-5-3-6"><title>Training phase objectives</title><p>In the training phase, the state-of-the art and newly developed DL+SL algorithm will work in a competitive/collaborative way. Following the &#x02018;no-free-lunch&#x02019; theorem,<xref rid="R29" ref-type="bibr">29</xref> we shall use the competitive phase to establish the most suitable DL/SL technique for identification and anomaly detection of each organ, and the collaborative phase to make all the algorithms work together in providing a &#x02018;second&#x02019; opinion.</p><p>All&#x02014;or at least all major of&#x02014;the above-mentioned modules must be incorporated in a realist advanced IS. This, in turn, results in a need to build new AI techniques and adapt classical AI algorithms to the issues that need to be solved. All these AI methods need to be statistically validated to avoid the reproducibility crisis, and to build the competitive/collaborative system. The complexity of the IS can be progressively increased to incorporate all the essential modules previously mentioned.</p><p>During the training phase, the intelligent system will learn to perform the following specific objectives and reach the subsequent key performance indicators presented in <xref rid="T2" ref-type="table">table 2</xref>.</p><table-wrap position="float" id="T2"><label>Table 2</label><caption><p>Specific objectives with key performance indicators (KPI)</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left" valign="bottom" rowspan="1" colspan="1">Specific objective (description)</td><td align="left" valign="bottom" rowspan="1" colspan="1">KPI (clinical utility)</td></tr></thead><tbody><tr><td align="left" valign="top" rowspan="1" colspan="1">Probe guidance: The IS guides the sonographer&#x02019;s probe for better acquisition of the fetal biometric plane</td><td align="left" valign="top" rowspan="1" colspan="1">Basic scanning to be performed by non-expert (&#x0003e;90% accuracy)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Fetal biometric plane finder: The fetal planes are automatically detected, measured and stored</td><td align="left" valign="top" rowspan="1" colspan="1">Insurance that all anatomical parts are checked (100% accuracy)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Anomaly detection: unusual findings are signalled</td><td align="left" valign="top" rowspan="1" colspan="1">Assistance in decision-making (&#x0003e;90% accuracy)</td></tr></tbody></table><table-wrap-foot><fn id="T2_FN1"><p>IS, Intelligent Decision Support System.</p></fn></table-wrap-foot></table-wrap></sec><sec id="s2-5-3-7"><title>Statistical validation of the IS performances</title><p>Each training phase is followed by statistical validation of the models involved. The statistical analysis focuses on the following three aspects: data screening, involving the suitability of the data for the type of statistical analysis that is intended (ie, Kolmogorov-Smirnov and Lilliefors, Shapiro-Wilk, Anderson-Darling, Cramer-von Mises, Jarque-Bera); hypothesis testing, involving the comparison between the testing performances obtained; overlearning control (ie, area under the ROC curve, t-test, Wilcoxon, Mann-Whitney, Welch, Cohen&#x02019;s k, one-way ANOVA (Analysis of Variance), Tukey&#x02019;s post hoc tests), involving the correlation between training and testing phases, enabling the statistical investigation of the ability of the IS to generalise well on new cases. An a priori statistical power analysis (two-tailed type of null hypothesis) will be performed to determine the appropriate sample size, in order to achieve adequate statistical power. Through this, we will find out the capability of a statistical test to detect a significant effect. In other words, the power of a test is the probability that that test&#x02019;s result obtained on a small dataset, will be the same when that test is applied on a larger dataset. The statistical power gives us the probability of correctly rejecting the null hypothesis.</p><p>The data screening process is important because different statistical tests cannot be applied if some prerequisites are not fulfilled. For instance, regression methods, comparison tests such as the t-test, one-way ANOVA, cannot be used unless the data samples are governed by the normal distribution and have equal variances. On the other hand, DL and SL algorithm are of stochastic nature, which means that we need statistical tests to compare the obtained performances (ie, accuracy, precision, F1-score). Each algorithm is run for certain number of times, and its performance metrics are recorded, forming a data sample. The same process is repeated with other state-of-the-art algorithms for comparison purposes.</p><p>All the hypotheses will be tested taking into account the p-level, considering as cut-off value 0.05.</p><p>The results will be described in terms of accuracy, loss, sensitivity, specificity, positive predictive value, negative predictive value, precision, recall and F1-score.</p><p>As for the size of the dataset, since most algorithms are from the DL family, the rule of thumb, based on the ImageNet dataset, is to have around 1000 samples images per class.</p></sec><sec id="s2-5-3-8"><title>Testing phase: assessing the IS&#x02019;s performance outside the lab</title><p>Confronting lab and modelling results to real-world situations will inevitably face numerous challenges. Difficulties might be expected when an unexperienced OB-GYN specialist, who performed less than 2000 examinations will start using the system. After each version of the IS is developed, we are going to test it outside the lab. This implies creating two sample groups of OB-GYN specialist doctors: the control group and the test group. The control group will follow the conventional teaching method, learning with a teacher. The test group will learn the conventional way, plus they will use the IS when performing MS. The working hypothesis are:</p><list list-type="bullet"><list-item><p><inline-formula><mml:math id="M1" overflow="scroll"><mml:mstyle displaystyle="true" scriptlevel="0"><mml:mrow><mml:msub><mml:mi>H</mml:mi><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mstyle></mml:math></inline-formula>: The control group performs as well as the test group.</p></list-item><list-item><p><inline-formula><mml:math id="M2" overflow="scroll"><mml:mstyle displaystyle="true" scriptlevel="0"><mml:mrow><mml:msub><mml:mi>H</mml:mi><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mstyle></mml:math></inline-formula>: The test group outperforms the control group.</p></list-item><list-item><p>Before starting to use the IS, the trial group will be trained in using IS for MS. Using operation research methods (ie, learning curves) and different statistical tools, we shall compare the evolution of the two sample groups.</p></list-item></list></sec></sec></sec><sec id="s2-6"><title>Outcome measures</title><p>Diagnosing CA through MS has long been and still is a puzzling phenomenon, with many unknowns. The rate of diagnosis through screening tests is still insufficient. A very large number of variables should be accounted for when trying to set such a diagnosis. By developing this advanced IS that uses AI, we hope to:</p><list list-type="bullet"><list-item><p>Avoid misinterpretations due to fatigue, time pressure, fetal involuntary movement, contractions, different patient characteristics.</p></list-item><list-item><p>Address specific difficulties in CA diagnosis, which are attributed to the complex anatomy of the fetal body, fetal constant motion and small size.</p></list-item><list-item><p>Provide patient access to high-quality medical care, since most pregnant individuals cannot afford antenatal care.</p></list-item></list><p>The IS will have to reach certain KPIs, regarding its capability of guiding the sonographer&#x02019;s probe for achieving better image acquisition (obtaining over 90% accuracy in finding standard textbook biometric plane images). The IS will have to reach 100% accuracy in detecting all anatomical parts and over 90% accuracy in identifying CAs.</p></sec><sec id="s2-7"><title>Study limitations</title><p>The continuous selecting appropriate image scans and label the anatomical organs is impaired by the lack of experienced OB-GYN specialists and/or their limited availability. We address this problem by trying to convince multiple OB-GYN doctors to join our project.</p><p>Because the project involves the development, deployment and /or use of AI we have used the Assessment List for Trustworthy AI (ALTAI) for self-assessment, Independent High-Level Expert Group on AI. The risk management strategy and ALTAI self-assessment are presented in <xref rid="F4" ref-type="fig">figure 4</xref>.</p><fig position="float" id="F4"><label>Figure 4</label><caption><p>Risk management strategy and ALTAI self-assessment. ALTAI, Assessment List for Trustworthy AI.</p></caption><graphic xlink:href="bmjopen-2023-077366f04" position="float"/></fig><p>Transparency: The end-users of the IS are the OB-GYN doctors. The IS only provides an opinion regarding the ultrasound scan that it is reviewing. The IS does not set a diagnosis. The IS is not interactive. Diversity, non-discrimination and fairness: The end-users are doctors who are still working in hospital or private practices. Hence, the end-users are not elderly persons or persons with disabilities or other special needs. The universal design principles will be taken into account during every step of the planning and development. There are no groups that might be disproportionately affected by the outcomes of the system. There is no risk of possible unfairness of the IS onto the end-user. Societal and environmental well-being: There are no potential positive or negative impact of the IS on the environment. Accountability: Developers and deployers will receive proper training about the legal framework of the IS. There will be no bias in the data since all the participants who fit the selection criteria are enrolled in the study. In the unlikely event that the data might be biased, the end-user will signal the research team and we shall mend this issue.</p></sec><sec id="s2-8"><title>Reporting of adverse events</title><p>The general principle is that ultrasound is safe for the pregnant patients and their fetus. There is a slight chance to initiate biological effects,<xref rid="R30" ref-type="bibr">30</xref> due to the energy deposition in the tissues.<xref rid="R31" ref-type="bibr">31</xref> Nevertheless, to by-pass this risk, we are going to analyse the ultrasound videos that have been recorded during the standard MS scan, no further evaluation being required. During the use of the colour Doppler, all the mechanical/thermal indices will be kept at a low level taking into account the ALARA principle and the safety guidelines.<xref rid="R32" ref-type="bibr">32 33</xref> If there will be any adverse event reported by a patient and/or seen by the doctor, measures will be taken to ensure the patient&#x02019;s safety.</p><supplementary-material id="SP1" position="float" content-type="local-data"><object-id pub-id-type="doi">10.1136/bmjopen-2023-077366.supp1</object-id><label>Supplementary data</label><p>
<inline-supplementary-material id="SS1" xlink:href="bmjopen-2023-077366supp001.pdf" content-type="local-data"/>
</p></supplementary-material></sec></sec><sec sec-type="supplementary-material"><title>Supplementary Material</title><supplementary-material content-type="local-data" id="d64e154"><caption><title>Reviewer comments</title></caption><media xlink:href="bmjopen-2023-077366.reviewer_comments.pdf"/></supplementary-material><supplementary-material content-type="local-data" id="d64e155"><caption><title>Author's
manuscript</title></caption><media xlink:href="bmjopen-2023-077366.draft_revisions.pdf"/></supplementary-material></sec></body><back><ack><p>We would like to thank the reviewers for taking the time and effort necessary to review the manuscript. We sincerely appreciate all valuable comments and suggestions, which helped us improve the quality of the manuscript.</p></ack><fn-group><fn fn-type="other"><p><bold>Contributors:</bold> SB and DGI designed, implemented and conceptualised the study&#x02019;s methodology. RCI, FI, MSS, RN, CMC and AI-O were involved in drafting and refining the study protocol. SB oversaw the statistical analysis. All the authors agreed to share their data and discussed and commented on the draft versions of the study protocol. The authors provided approval for the final version to be published.</p></fn><fn fn-type="other"><p><bold>Funding:</bold> This work was supported by a grant of the Ministry of Research Innovation and Digitization, CSNC-UEFISCDI, project number PN-III-P4-PCE-2021-0057, within PNCDI III.</p></fn><fn fn-type="COI-statement"><p><bold>Competing interests:</bold> None declared.</p></fn><fn fn-type="other"><p><bold>Patient and public involvement:</bold> Patients and/or the public were not involved in the design, or conduct, or reporting, or dissemination plans of this research.</p></fn><fn fn-type="other"><p><bold>Provenance and peer review:</bold> Not commissioned; externally peer reviewed.</p></fn><fn fn-type="other"><p><bold>Supplemental material:</bold> This content has been supplied by the author(s). It has not been vetted by BMJ Publishing Group Limited (BMJ) and may not have been peer-reviewed. Any opinions or recommendations discussed are solely those of the author(s) and are not endorsed by BMJ. BMJ disclaims all liability and responsibility arising from any reliance placed on the content. Where the content includes any translated material, BMJ does not warrant the accuracy and reliability of the translations (including but not limited to local regulations, clinical guidelines, terminology, drug names and drug dosages), and is not responsible for any error and/or omissions arising from translation and adaptation or otherwise.</p></fn></fn-group><sec sec-type="ethics-statement"><title>Ethics statements</title><sec><title>Patient consent for publication</title><p content-type="ethics-consent-to-publish">Not applicable.</p></sec></sec><ref-list><title>References</title><ref id="R1"><label>1</label><mixed-citation publication-type="journal"><person-group person-group-type="author"><string-name><surname>Boyle</surname>

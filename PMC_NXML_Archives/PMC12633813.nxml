<article-meta><article-id pub-id-type="pmid">41281176</article-id><article-id pub-id-type="pmc">12633813</article-id><article-id pub-id-type="publisher-id">IJNM-40-269</article-id><article-id pub-id-type="doi">10.4103/ijnm.ijnm_45_25</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Article</subject></subj-group></article-categories><title-group><article-title>Biodistribution and Semiquantitative Analysis of <sup>99m</sup>Tc-HYNIC-PSMA-11in Prostate Cancer Patients: A Retrospective Study</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Tayal</surname><given-names>Sachin</given-names></name><xref rid="aff1" ref-type="aff"/></contrib><contrib contrib-type="author"><name><surname>Sinha</surname><given-names>Ritwik</given-names></name><xref rid="aff1" ref-type="aff"/></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Shukla</surname><given-names>Varun</given-names></name><xref rid="aff2" ref-type="aff">1</xref><xref rid="cor1" ref-type="corresp"/></contrib><contrib contrib-type="author"><name><surname>Venkatachalam</surname><given-names>Manikandan Marappagounder</given-names></name><xref rid="aff1" ref-type="aff"/></contrib><contrib contrib-type="author"><name><surname>Suresh</surname><given-names>Arvind</given-names></name><xref rid="aff1" ref-type="aff"/></contrib><contrib contrib-type="author"><name><surname>Kumar</surname><given-names>Jay Prakash</given-names></name><xref rid="aff1" ref-type="aff"/></contrib><contrib contrib-type="author"><name><surname>Chauhan</surname><given-names>Manojkumar Ramsoorat</given-names></name><xref rid="aff1" ref-type="aff"/></contrib><contrib contrib-type="author"><name><surname>Jain</surname><given-names>Yash</given-names></name><xref rid="aff1" ref-type="aff"/></contrib><contrib contrib-type="author"><name><surname>Jha</surname><given-names>Uddeshya Narayan</given-names></name><xref rid="aff1" ref-type="aff"/></contrib><contrib contrib-type="author"><name><surname>Kalra</surname><given-names>Simran</given-names></name><xref rid="aff2" ref-type="aff">1</xref></contrib></contrib-group><aff id="aff1">
<italic toggle="yes">Department of Nuclear Medicine and Molecular Imaging, Homi Bhabha Cancer Hospital and Mahamana Pandit Madan Mohan Malaviya Cancer Centre, Tata Memorial Centre, Homi Bhabha National Institute, Varanasi, Uttar Pradesh, India</italic>

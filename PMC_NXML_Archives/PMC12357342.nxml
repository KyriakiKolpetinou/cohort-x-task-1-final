<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="review-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">BMC Musculoskelet Disord</journal-id><journal-id journal-id-type="iso-abbrev">BMC Musculoskelet Disord</journal-id><journal-title-group><journal-title>BMC Musculoskeletal Disorders</journal-title></journal-title-group><issn pub-type="epub">1471-2474</issn><publisher><publisher-name>BioMed Central</publisher-name><publisher-loc>London</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">40819086</article-id><article-id pub-id-type="pmc">12357342</article-id><article-id pub-id-type="publisher-id">9028</article-id><article-id pub-id-type="doi">10.1186/s12891-025-09028-6</article-id><article-categories><subj-group subj-group-type="heading"><subject>Systematic Review</subject></subj-group></article-categories><title-group><article-title>The effectiveness of Spencer muscle energy technique on pain, function and range of motion in patients with frozen shoulder: Systematic Reviews and Meta-analyses</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><name><surname>Takele</surname><given-names>Mihret Dejen</given-names></name><address><email>mihretdejen2017@gmail.com</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Kibret</surname><given-names>Alemu Kassaw</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Belay</surname><given-names>Gashaw Jember</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Baye</surname><given-names>Moges</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Getie</surname><given-names>Kefale</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Shiferaw</surname><given-names>Kassaw Belay</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Eriku</surname><given-names>Getachew Azeze</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0595gz585</institution-id><institution-id institution-id-type="GRID">grid.59547.3a</institution-id><institution-id institution-id-type="ISNI">0000 0000 8539 4635</institution-id><institution>Department of Physiotherapy, School of Medicine, College of Medicine and Health Sciences, </institution><institution>University of Gondar, </institution></institution-wrap>Gondar, 196 Ethiopia </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0595gz585</institution-id><institution-id institution-id-type="GRID">grid.59547.3a</institution-id><institution-id institution-id-type="ISNI">0000 0000 8539 4635</institution-id><institution>Program Coordinator Rotator Jaipur Limb Project, </institution><institution>at University of Gondar hospital, </institution></institution-wrap>Gondar, Ethiopia </aff></contrib-group><pub-date pub-type="epub"><day>16</day><month>8</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>16</day><month>8</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>26</volume><elocation-id>793</elocation-id><history><date date-type="received"><day>15</day><month>5</month><year>2025</year></date><date date-type="accepted"><day>21</day><month>7</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">Frozen shoulder, also clinically known as adhesive capsulitis, is characteri<bold>z</bold>ed by pain, stiffness, and gradual loss of passive or active glenohumeral range of motion. It leads to marked reduction in shoulder mobility, impacting daily activities and quality of life. This study aims to evaluate the effectiveness of the Spencer muscle energy technique (SMET) for frozen shoulder patients.</p></sec><sec><title>Methods</title><p id="Par2">For this systematic review and meta-analysis, we used PubMed, Cochrane Library, Embase, and Physiotherapy Evidence Database (PEDro) for searching from inception to January 20, 2025. This systematic review followed the Preferred Reporting Items for Systematic Reviews and Meta-Analyses (PRISMA) guidelines, and independent authors selected clinical control trials that compare the effect of the Spencer muscle energy technique and comparative treatment in individuals with frozen shoulder. The outcomes were pain, function, and shoulder range of motion (ROM). Two authors independently did data extraction. The risk of bias was assessed using the Cochrane Risk of Bias 2.0 tool, and the overall quality of the evidence was evaluated using the PEDro scale.</p></sec><sec><title>Results</title><p id="Par3">Nine studies were included in this review, and eight studies were included in the meta-analysis. Results indicated that SMET and other comparative treatments showed no statistical difference in the pain, flexion ROM, and abduction ROM standard mean difference (SMD). -0.19; 95% CI (-0.83, 0.45); I&#x000b2;=84%, (MD), 7.65; 95% CI (-11.7, 26.9); I&#x000b2;=95%, MD, 11.32; 95% CI (-9.10, 31.74); I&#x000b2;=96%, respectively. SMET was a statistically significant effect for shoulder function, SMD &#x02212;&#x02009;0.5; 95% CI (-0.78, -0.22); I&#x000b2; = 41%. SMET had an inferior effect on shoulder external rotation and extension ROM MD, 9.74; 95% CI (2.38, 17.10) I<sup>2</sup>&#x02009;=&#x02009;92, MD, 2.55; 95% CI (1.14, 3.96); I<sup>2</sup>&#x02009;=&#x02009;0 respectively.</p></sec><sec><title>Conclusion</title><p id="Par4">This systematic review and meta-analysis indicates that SMET shows promise in improving shoulder function in patients with frozen shoulder; however, evidence is inconsistent for pain and ROM outcomes compared to other manual therapies. Further studies should explore the effect of SMET across different phases of frozen shoulder to determine the optimal timing for intervention through large, high-quality, and well-designed randomized control trials.</p></sec><sec><title><italic>PROSPERO</italic><italic>registration number</italic></title><p id="Par5">: CRD42024605780.</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1186/s12891-025-09028-6.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Spencer muscle energy technique</kwd><kwd>Frozen shoulder</kwd><kwd>Adhesive capsulitis</kwd><kwd>Pain</kwd><kwd>Function</kwd><kwd>Range of motion</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; BioMed Central Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par21">Frozen shoulder, also clinically known as adhesive capsulitis, is characterized by pain, stiffness, and gradual loss of passive or active glenohumeral range of motion [<xref ref-type="bibr" rid="CR1">1</xref>]. The shoulder joint capsule is inflamed and thickened, with rigid connective tissue encasing the shoulder joint [<xref ref-type="bibr" rid="CR2">2</xref>]. The upper extremity committee of the International Society of Arthroscopy, Knee Surgery and Orthopedic Sports Medicine (ISAKOS) defined the term &#x0201c;frozen shoulder&#x0201d; as idiopathic stiff shoulder, that is, without any trauma or specific shoulder disease. Examples include predisposing factors such as diabetes, thyroid conditions, Dupuytren contracture, and smoking. Secondary stiff shoulder is a term that should be used to describe shoulder stiffness with a known cause, such as a stiff shoulder after trauma or surgery [<xref ref-type="bibr" rid="CR3">3</xref>]. The shoulder joint capsule&#x02019;s lining and related ligaments are thought to be inflamed and swollen, which causes contracture of the shoulder joint capsule and limits shoulder movement [<xref ref-type="bibr" rid="CR4">4</xref>].</p><p id="Par22">There are three phases for that patient with frozen shoulder: Painful Phase (Duration: 2&#x02013;9 months): This phase is marked by severe pain, often worsening at night, especially when lying down. The pain can be debilitating and may limit the patient&#x02019;s ability to move the shoulder. Freezing Phase (Duration: 4&#x02013;12 months): During this phase, the patient experiences increasing stiffness in the shoulder, making it difficult to perform simple activities of daily living. The pain may gradually decrease, but the range of motion continues to decline, leading to disuse and potential atrophy of the shoulder muscles. Thawing Phase (Duration: 5&#x02013;12 months): In this final phase, there is a gradual improvement in both range of motion and pain levels. Although some stiffness may persist, patients typically experience a return to normal function. Pain may occasionally reappear as the shoulder begins to thaw and regain movement [<xref ref-type="bibr" rid="CR2">2</xref>, <xref ref-type="bibr" rid="CR5">5</xref>].</p><p id="Par23">The prevalence of frozen shoulder in the general population is indeed estimated to be 2&#x02013;5%; when looking at gender differences, studies have shown that 8% of males and 10% of women have it, and in diabetic patients the risk of developing frozen shoulder is 10&#x02013;29% [<xref ref-type="bibr" rid="CR6">6</xref>, <xref ref-type="bibr" rid="CR7">7</xref>]. Most commonly affected individuals are between 40 and 60 years of age, and rarely affected people are under 40 years. Patients with hyperthyroidism and hypertriglyceridaemia have been found to have a higher incidence of frozen shoulder [<xref ref-type="bibr" rid="CR8">8</xref>]. This condition may experience bilateral frozen shoulder up to 16%, and recurrent frozen shoulder is also relatively uncommon [<xref ref-type="bibr" rid="CR9">9</xref>].</p><p id="Par24">The conventional approach to treating adhesive capsulitis involves reducing pain, preserving range of motion, and eventually regaining function. Exercise programs that include active and passive range of motion exercises, stretching exercises supervised by a physiotherapist, self-stretching, manipulation and mobilization techniques, strengthening exercises, patient education, and at-home exercises are among the recommended treatments for frozen shoulder. Other recommended treatments include electro-modalities and physiotherapy interventions like heat therapy.</p><p id="Par25">Based on the patients&#x02019; clinical condition, various forms of muscle energy technique are available for different joints and muscles. The latest osteopathic manual therapy method widely used is the Spencer Muscle Energy Technique (SMET), adopted in Western clinical practices for treating various shoulder ailments. It is a set of standardized shoulder treatments that can be used widely for prognosis, diagnosis, and treatment of frozen shoulder. It was developed by Spencer, D.O., in 1916. The evolution of this technique is traced from 1916 to date to try to identify factors in the development of manipulative methods [<xref ref-type="bibr" rid="CR10">10</xref>].</p><p id="Par26">SMET has gained popularity in recent years as an effective intervention for frozen shoulder. In this technique, the glenohumeral and scapula-thoracic joints are mobilized through osteopathic manipulative techniques. In addition to improving the functions of restricted joints, it provides positive effects on other emotional, social and cognitive areas [<xref ref-type="bibr" rid="CR11">11</xref>].</p><p id="Par27">Clinical outcomes suggest that the SMET improves shoulder range of motion more effectively than conventional physical therapy. A unique aspect of SMET is client involvement in the process. The technique involves two steps repeated in seven stages. The first step is rhythmic oscillation at the end of the available range, and the second step is isometric contractions of antagonist muscle at different ranges to achieve a new barrier. This technique works on the principle of reciprocal inhibition. The patient should be in a side-lying position with the affected shoulder facing upwards. The therapist should stand on the lateral side of the patient and stabilize the upper side of the shoulder girdle, which provides support so that the technique can be applied specifically at the joint level. It is necessary that during the application of this technique the wrist and forearm are well supported. It has seven stages to perform SMET:</p><p id="Par28">Step 1 to improve the extension, step 2 to improve the shoulder flexion, Step 3: Circumduction with compression, Step 4&#x02013; Circumduction with distraction, Step 5&#x02013;To improve the abduction, to improve the adduction with external rotation, Step 6&#x02013; Internal rotation, Step 7&#x02013; Distraction in abduction [<xref ref-type="bibr" rid="CR12">12</xref>]. In this technique, passive, smooth, rhythmic motion is designed to stretch contracted muscles, ligaments, and capsules, enhancing lymphatic flow and stimulating increased joint circulation [<xref ref-type="bibr" rid="CR13">13</xref>]. SMET improves the pain-free range of shoulder joint motion in frozen shoulder patients by increasing blood circulation in the shoulder joint, promoting lymphatic flow and muscle stretching, and affecting the capsule and ligaments of the shoulder joint. Many medical healthcare professionals in professional sports have recently adopted this method during training sessions to improve the performance of the athletes in various sports.</p><p id="Par29">As far as our search, we found two published systematic reviews on this topic [<xref ref-type="bibr" rid="CR14">14</xref>, <xref ref-type="bibr" rid="CR15">15</xref>]. They indicated the combined effect of SMET with other exercise groups and manual therapy. However, the aim of this systematic review was to specifically evaluate the effectiveness of SMET alone in comparison to other treatments across a diverse patient population for reducing pain and improving function and range of motion in individuals with frozen shoulder. Therefore, this review aims to fill the gap in existing literature by isolating the effects of SMET, providing clearer insights into its effectiveness as a standalone treatment. By doing so, we hope to offer valuable evidence that can inform clinical practice and guide future research in managing frozen shoulder.</p></sec><sec id="Sec2"><title>Methods</title><p id="Par30">This systematic review was done in accordance with the Cochrane Handbook for Systematic Reviews and presented according to the Preferred Reporting Items for Systematic Reviews and Meta-Analysis (PRISMA) statement [<xref ref-type="bibr" rid="CR16">16</xref>, <xref ref-type="bibr" rid="CR17">17</xref>]. In addition, the study was registered at the International Prospective Register of Systematic Reviews (PROSPERO; CRD42024605780).</p><sec id="Sec3"><title>Data source and search strategy</title><p id="Par31">We systematically searched PubMed, PEDro, Cochrane Library, and Embase were searched from inception to January 20, 2025. The search terms used included muscle energy technique, frozen shoulder, and adhesive capsulitis. The complete search strategy is provided in the supplementary file 1). To identify the relevant articles, titles and abstracts were exported to EndNote 20, and duplicates were identified and removed by one reviewer (MDT). Three authors (MB, AKK and KBS) independently screened the titles and abstracts and evaluated the articles in full for eligibility based on pre-specified criteria. Discrepancies were resolved in a panel discussion with a fourth author (GJB). Moreover, we also reviewed reference lists of included studies to identify additional eligible trials.</p></sec><sec id="Sec4"><title>Eligibility criteria</title><p id="Par32">We considered studies eligible for inclusion if they were clinical control trials, had a PEDro score greater than or equal to four, and were in the intervention group with the Spencer muscle energy technique, frozen shoulder patients, and studies in the English language. Duplicate data, study protocols, unpublished papers, non-full-text articles in peer-reviewed journals, non-RCTs, quasi-RCTs, unclear methodology, and conference papers were excluded.</p></sec><sec id="Sec5"><title>Data extraction</title><p id="Par33">Data extraction was independently done by three reviewers (MDT, KG, and KBS). A systematic extraction form was used for each article to collect the following data: sample size, intervention features (e.g., type of intervention, duration, frequency, and intensity of intervention), methodological factors (outcome and its measurement tool used to assess pain, functional level, and range of motion), evaluation time, and overall results. For further information see Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>.</p></sec><sec id="Sec6"><title>Assesment of studies quality</title><p id="Par34">To assess the quality of included studies, we used the Physiotherapy Evidence Database (PEDro) and Grading of Recommendation Assessment, Development, and Evaluation (GRADE) approach to determine the quality of each body of evidence. Three independent reviewers (MDT, GJB, and GAE) evaluated the quality of studies. Ten of the 11 items on the PEDro scale, which were evaluated using explicit decision rules, were extracted from the Physiotherapy Evidence Database (<ext-link ext-link-type="uri" xlink:href="http://www.PEDro.org.au">www.PEDro.org.au</ext-link><italic>)</italic> and used to evaluate the included trials critically. The PEDro scale evaluates a study&#x02019;s methodological quality using key factors such as concealed allocation, intention-to-treat analysis, and follow-up sufficiency. The PEDro scale is a valuable instrument for evaluating the methodological quality of physiotherapy and rehabilitation trials. The PEDro scale has eleven components. Items 2&#x02013;9 deal with a paper&#x02019;s internal validity, whereas items 10 and 11 deal with the statistical analysis, making sure there is enough information to allow for a suitable interpretation of the findings [<xref ref-type="bibr" rid="CR18">18</xref>] (see Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). The quality of evidence for each outcome was consequently graded as high (PEDro score 6&#x02013;10), Fair (PEDro score 4&#x02013;5), Poor (PEDro score&#x02009;&#x02264;&#x02009;3) (see Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>).</p></sec><sec id="Sec7"><title>Risk of bias</title><p id="Par35">The other method to assess the risk of bias of included studies with each respective outcome was to use the Cochrane Risk of Bias 2 tool (ROB2), an updated version of the Cochrane Handbook for Systematic Review of Interventions [<xref ref-type="bibr" rid="CR19">19</xref>], with three independent authors (MDT, GAE and GJB). The main types of risk assessed at the outcome level using the following domain are bias from the randomization process, deviations from intended interventions, missing outcome data, measurement of the outcome, and selection of the reported results. In case of disagreement, the 3 authors would discuss the study to reach a consensus, and for full details (see Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>).</p></sec><sec id="Sec8"><title>Statistical analysis</title><p id="Par36">A meta-analysis was done using the following outcome measurement tool: Visual analogue scale (VAS) and numerical pain rating scale (NPRS) for pain, the shoulder pain and disability index (SPADI) to assess shoulder-related pain and disabilities in terms of functional outcomes and active shoulder range of motion (ROM): flexion, abduction, external rotation, and extension. The included studies were only comparing Spencer muscle energy technique to other comparative interventions. This meta-analysis was performed using Review Manager Version 5.4.1 (The Cochrane Collaboration). Post-intervention continuous data were shown as mean difference (MD)&#x02009;&#x000b1;&#x02009;standard deviation (SD) with a 95% confidence interval (CI). <italic>P</italic> value&#x02009;&#x0003c;&#x02009;0.05 was considered significant. Heterogeneity tests were done using the chi-squared test and the I&#x000b2; test. The I<sup>2</sup> statistic was used to test for statistical heterogeneity and was assessed as follows: 0% &#x0003c; I<sup><italic>2</italic></sup>&#x02009;<italic>&#x0003c;</italic>&#x02009;25%, low heterogeneity; 25% &#x0003c; I<sup>2</sup>&#x02009;<italic>&#x0003c;</italic>&#x02009;50%, moderate heterogeneity; and I<sup>2</sup>&#x02009;<italic>&#x0003e;</italic>&#x02009;50%, high heterogeneity [<xref ref-type="bibr" rid="CR20">20</xref>]. An I<sup>2</sup>&#x02009;&#x0003e;&#x02009;50% in those cases applied a random effect model because there were varied follow-up times, and the stage of frozen shoulder between studies increases the risk of heterogeneity. On the other hand, at I<sup>2</sup>&#x02009;&#x0003c;&#x02009;50%, we applied a fixed -effect model. In case of high heterogeneity, a subgroup analysis was performed to assess the Spencer muscle energy technique with different comparative treatments groups in the control group. When there was high heterogeneity in a meta-analysis, the sensitivity analysis was performed, excluding studies with extreme results to explain potential heterogeneity. Sensitivity analysis was conducted to evaluate the reliability of the effects. One study was eliminated at that time, and studies with very heterogeneous findings were also eliminated. Small-study effects (publication bias) were examined in the funnel plot, and no publication bias was observed in this study.</p></sec></sec><sec id="Sec9"><title>Results</title><sec id="Sec10"><title>Study selection</title><p id="Par37">A total of 3780 studies was initially identified. After removing duplicates, 2490 remained for the screening process. A total of 2180 studies were excluded after screening the title and abstract. Three hundred and ten results were sought for retrieval. A full text of 157 was analysed, of which 8 studies were included in quantitative analysis (meta-analysis) (see Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>).</p><p id="Par38">
<fig id="Fig1"><label>Fig. 1</label><caption><p>A flow chart of study selection and adapted from PRISMA2020 statement</p></caption><graphic xlink:href="12891_2025_9028_Fig1_HTML" id="d33e481"/></fig>
</p></sec><sec id="Sec11"><title>Studies characteristics</title><p id="Par39">The included studies were published between 2016 and 2025. A total of 324 frozen shoulder patients from 9 publications were included for qualitative synthesis. 8 studies were used for quantitative analysis. The number of participants selected for each study varied from 20 to 60. All of the 9 studies were clinical control trials. Five of the studies were randomized control trials [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR21">21</xref>&#x02013;<xref ref-type="bibr" rid="CR24">24</xref>], and four studies were comparative clinical controlled trials [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR25">25</xref>&#x02013;<xref ref-type="bibr" rid="CR27">27</xref>]. The ages of the participants range from 30 to 70 years. Six studies (66.6%) included patients who were stiff and painful for the last 3 months [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR22">22</xref>&#x02013;<xref ref-type="bibr" rid="CR24">24</xref>, <xref ref-type="bibr" rid="CR27">27</xref>]. One study (11.1%) included patients who were stiff and painful for the last 2 months&#x02019; duration [<xref ref-type="bibr" rid="CR21">21</xref>]. The other study (11.1%) included patients who were stiff and painful for the last month [<xref ref-type="bibr" rid="CR25">25</xref>]. A study done by Chavan et al., 2017, found no information regarding the time duration on stiff and painful time [<xref ref-type="bibr" rid="CR26">26</xref>]. The characteristics of all included studies are summarized in the Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>.</p><p id="Par40">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>The characteristics of all included studies</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Authors&#x00026;<break/>country</th><th align="left">Group composition and patient characteristics</th><th align="left" colspan="2">Participants<break/>inclusion exclusion</th><th align="left">Experimental intervention</th><th align="left">Control<break/>intervention</th><th align="left">Dose</th><th align="left">Evaluation assessment</th><th align="left">Outcome measure</th><th align="left">Results</th></tr></thead><tbody><tr><td align="left">Iqbal et al.,2020 [<xref ref-type="bibr" rid="CR24">24</xref>] Pakistan</td><td align="left"><p>T 60 30&#x02013;55 Y</p><p>39&#x000a0;F (65%) 21 (35%) M</p><p>30 E 30&#x000a0;C</p></td><td align="left"><p>Idiopathic frozen shoulder Stage II and II, stiff painful shoulder joint for at</p><p>least 3 months</p></td><td align="left"><p>Rotator cuff tears, RA, GA, tumors, reflex sympathetic dystrophy</p><p>, TOS, PNI, shoulder girdle fractures, dislocations and those who were not taking any pain medication?</p></td><td align="left">SMET</td><td align="left">Passive stretching</td><td align="left"><p>F:3x/w</p><p>D:4w</p><p>I: 3&#x02013;5</p><p>I:3&#x02013;5 times/session rest b/n interval for E and 20&#x000a0;s with 10&#x000a0;s rest for C</p></td><td align="left">After 4 week treatment</td><td align="left"><p>Pain (NPRS)</p><p>ROM (<sup>0</sup>)</p><p>-flexion</p><p>-extension</p><p>-Abduction</p><p>-ER</p><p>-IR</p><p>Function (SPADI)</p></td><td align="left">All parameters SMET better than Passive stretching</td></tr><tr><td align="left">Prasanth et al., 2022 India[<xref ref-type="bibr" rid="CR25">25</xref>]</td><td align="left"><p>T 30</p><p>50&#x02013;60 Y</p><p>15 E 15&#x000a0;C</p><p>?</p><p>?</p></td><td align="left"><p>Unilateral frozen shoulder with pain lasting for more than 1 month.</p><p>Capsular pattern of motion restriction more than 50% loss of passive movement of the shoulder joint compared with the unaffected side</p></td><td align="left"><p>Trauma, reflex sympathetic dystrophy, rotator cuff tear, dislocation of the shoulder,</p><p>Recurrent dislocation, shoulder subluxation, upper limb fracture, and any history of shoulder surgery on the affected</p><p>Shoulder</p></td><td align="left">SMET</td><td align="left">Gong&#x02019;s mobilization technique</td><td align="left"><p>F:1x/day</p><p>D: 5&#x000a0;day</p><p>I: 3&#x02013;5 times/session rest b/n interval for E and 10&#x02013;15&#x000a0;s before the whole manoeuvre lasted roughly 2&#x02013;3&#x000a0;min for C</p></td><td align="left">At the end of the first week</td><td align="left"><p>Pain (VAS)</p><p>ROM (<sup>0</sup>)</p><p>-flexion</p><p>-Abduction</p><p>-IR</p><p>Function (SPADI)</p></td><td align="left">Gong&#x02019;s mobilization better reduction in pain intensity, improve shoulder function and ROM compared to SMET</td></tr><tr><td align="left"><p>Muhammd et al., 2024[<xref ref-type="bibr" rid="CR21">21</xref>]</p><p> Pakistan</p></td><td align="left"><p>T 40</p><p>40&#x02013;60 Y</p><p>20 E 20&#x000a0;C 14 (35%) M 26 (65%) F</p></td><td align="left"><p>Unilateral frozen shoulder</p><p>minimum two-month duration of symptoms</p></td><td align="left">Shoulder surgery, RA, history of trauma or fractures, neurological deficits, rotator cuff lesions, tendon calcification, and pain or disorders of the cervical spine, elbow, wrist, or hand on the affected side.</td><td align="left">SMET&#x02009;+&#x02009;Maitland Mobilization</td><td align="left">Maitland Mobilization only</td><td align="left"><p>F:3x/w</p><p>D: 6w</p><p>I: Not provided</p></td><td align="left">After the end of six-week</td><td align="left"><p>Pain(NPRS)</p><p>ROM (<sup>0</sup>)</p><p>-flexion</p><p>-Extension</p><p>-Abduction</p><p>-IR</p><p>-ER</p><p>Function (SPADI</p></td><td align="left"><p>Both Maitland Mobilization and SMET effectively reduced pain and improved ROM and functional capacity, but</p><p>Combined treatment of SMET with Maitland Mobilization was more effective</p></td></tr><tr><td align="left"><p>Arif et al.,</p><p>2023 [<xref ref-type="bibr" rid="CR22">22</xref>]</p><p>Pakistan</p></td><td align="left"><p>T 36</p><p>30&#x02013;65 Y</p><p>12 E1 12 E2 and 12&#x000a0;C</p><p>E1 5&#x000a0;M (41.66%) 7&#x000a0;F (58.34) (E2 7&#x000a0;M (58.34%) 5&#x000a0;F (41.66%) and C 5&#x000a0;M (41.66%) 7&#x000a0;F (58.34%)</p></td><td align="left"><p>DM patient</p><p>Symptoms present for more than 3</p><p>months</p><p>Restricted movements in ADLs</p></td><td align="left"><p>Cancer pregnancy, systemic disease,</p><p>vertebral fracture, nerve root irritation, rotator cuff rupture, open wound, skin infection</p></td><td align="left"><p>E1:SMET</p><p>E2:Mulligan&#x02019;s mobilization</p></td><td align="left">Conventional therapy</td><td align="left"><p>F:3x/w</p><p>D:4w</p><p>I: 3 sets of exercise with each 10 Rep and rest of 2&#x000a0;min between</p><p>each set</p></td><td align="left">At the baseline and and at the end of the forth week</td><td align="left">Pain (NPRS), and function SPADI</td><td align="left">Mulligan mobilization effective than SMET</td></tr><tr><td align="left"><p>Razaq et al.,2023 [<xref ref-type="bibr" rid="CR12">12</xref>]</p><p>Pakistan</p></td><td align="left"><p>T 44</p><p>30&#x02013;70 Y</p><p>11E1 11E2 11 E3 and 11&#x000a0;C</p><p>20 (45.5%) M and 24(54.5) F</p></td><td align="left">DM patients, Shoulder pain for at least three months, Restricted active and passive shoulder movements, with a reduction in external rotation of at least 50%</td><td align="left"><p>Shoulder surgical position Rupture/trauma of the rotator cuff</p><p>Pain or restricted motion from disorders in elbow/wrist</p><p>Calcification of tendons.</p><p>Osteoarthritis and RA</p><p>Osteoporosis</p><p>Pregnancy</p></td><td align="left"><p>E1:SMET</p><p>E2:Mulligan&#x02019;sMWM</p><p>E3: Combined</p></td><td align="left"><p>Conventional</p><p>therapy</p></td><td align="left"><p>F:2x/day</p><p>D:4w</p><p>I: 2 sets of 10 Rep 2 minutes&#x02019; rest between</p></td><td align="left">The assessment was done at the 1&#x02009;st week,2nd week, 3rd week 4th week and 6th week</td><td align="left"><p>Pain (VAS)</p><p>ROM (<sup>0</sup>)</p><p>-flexion</p><p>-Abduction</p><p>-IR</p><p>-ER</p><p>Function SPADI</p></td><td align="left">Both SMET and Mulligan&#x02019;s MWM effective but combined them it gives significantly better results</td></tr><tr><td align="left"><p>Chavan et al.,2017 [<xref ref-type="bibr" rid="CR26">26</xref>]</p><p>India</p></td><td align="left"><p>T 20</p><p>40&#x02013;70 Y</p><p>10E and 10&#x000a0;C</p><p>?</p><p>?</p></td><td align="left"><p>Subjects clinically</p><p>diagnosed with Unilateral primary adhesive capsulitis</p></td><td align="left"><p>Recent Hx of surgery on particular shoulder, HX RA,</p><p>fracture around shoulder complex Hx of Subjects</p><p>with DM, osteoporosis or malignancies</p><p>Secondary adhesive capsulitis</p></td><td align="left">SMET</td><td align="left">Myofascial arm pull technique</td><td align="left"><p>F:5 session/w</p><p>D:3w</p><p>I: Each procedure was repeated in 8-10x</p></td><td align="left">On the first day before intervention and after 3 weeks of interventions</td><td align="left"><p>Pain (VAS)</p><p>ROM (<sup>0</sup>)</p><p>-flexion</p><p>-Abduction</p><p>-ER</p><p>Function SPADI</p></td><td align="left">Both the techniques shown to have equal effect on improving pain and functional disability. However SMET is effective in improving shoulder mobility than Myofascial arm pull technique</td></tr><tr><td align="left"><p>Jivani et al., 2021[<xref ref-type="bibr" rid="CR27">27</xref>]</p><p>India</p></td><td align="left"><p>T 58</p><p>40-60Y</p><p>E 29&#x000a0;M (48.3%) F (51.7%)</p><p>C 29&#x000a0;M (51.7%) F (48.3%)</p></td><td align="left"><p>Unilateral Frozen shoulder (at least 3-month</p><p>duration)</p></td><td align="left"><p>Recent Hx of surgery on particular shoulder, HX RA,</p><p>fracture around shoulder complex</p><p>, osteoporosis or malignancies rotator cuff lesion and,</p><p>tendon calcification</p></td><td align="left">SMET</td><td align="left"><p>Maitland&#x02019;s</p><p>mobilization</p></td><td align="left"><p>F:5 session/w</p><p>D: 4w</p><p>I: 30&#x000a0;min</p><p>with rest for E</p><p>and 20&#x000a0;min with rest for C</p></td><td align="left">On the first day before intervention and after 3 weeks of interventions</td><td align="left"><p>Pain (VAS)</p><p>ROM (<sup>0</sup>)</p><p>-flexion</p><p>-Extension</p><p>-Abduction</p><p>-ER</p><p>-IR</p><p>Function SPADI</p></td><td align="left"><p>SMET is more effective compared to Maitland&#x02019;s</p><p>Mobilization in all parameter</p></td></tr><tr><td align="left"><p>Gasibat et al., 2022 [<xref ref-type="bibr" rid="CR23">23</xref>]</p><p>Libya</p></td><td align="left"><p>T 40</p><p>30-70Y</p><p>E 20</p><p>C 20</p><p>10 (35%)M</p><p>30 (65%) F</p></td><td align="left">Unilateral adhesive capsulitis, frozen shoulder phase 1 or 2, and patients with limited ROM (loss of at least 25% compared to non-involved shoulder in one or more directions)</td><td align="left">Hx of significant shoulder surgery, cervical neuropathy, neurological changes or paralysis of the afflicted upper limb, fractures or open sores and intra-articular injection pain management</td><td align="left">SMET</td><td align="left"><p>Conventional</p><p>Therapy</p></td><td align="left"><p>F:3 session/w</p><p>D:4w</p><p>I: 3&#x02013;5 times with rest periods</p></td><td align="left">The assessment was done before intervention and post intervention</td><td align="left"><p>Pain (NPRS)</p><p>ROM (<sup>0</sup>)</p><p>-flexion</p><p>-Extension</p><p>-Abduction</p><p>-ER</p><p>-IR</p><p>Function SPADI</p></td><td align="left">SME more effective in shoulder pain reduction, disability and conventional treatment showed more effectiveness in enhancing the shoulder ROM</td></tr><tr><td align="left"><p>Contractor et al.,2016 [<xref ref-type="bibr" rid="CR9">9</xref>]</p><p>India</p></td><td align="left"><p>T 40</p><p>40&#x02013;65 Y</p><p>E 20</p><p>C 20</p><p>?</p><p>?</p></td><td align="left">Stiff painful shoulder for at least 3 month duration, idiopathic frozen shoulder, DM, limited ROM of shoulder abduction and ER, bilateral/unilateral adhesive Capsulitis.</td><td align="left">Rotator cuff tears, Hx RA, Malignancies in the shoulder region, fracture, to dislocation, Periarthritis Periarthritis shoulder secondary to neurological disorder, TOS, PNI</td><td align="left"><p>SMET&#x02009;+&#x02009;Conventional</p><p>therapy</p></td><td align="left"><p>Conventional</p><p>therapy</p></td><td align="left"><p>F:3x/w</p><p>D:4w</p><p>I: once a day</p></td><td align="left">before the treatment and after 4 weeks post treatment</td><td align="left">VAS and SPADI</td><td align="left">SMET is more effective increasing functional ability as compared to conventional treatment, however no statistical difference for pain reduction</td></tr></tbody></table><table-wrap-foot><p>T: tal group study participants; Y: year of age; E: experimental group; C: control group; M: male; Female;?:information not provide Hx: history; RA: rheumatoid arthritis; TOS: thoracic outlet syndrome; PNI: peripheral nerve injurie; DM: diabetic mallets; ADLs: activity of daily living; GA: gout arthritis; SMET: spencer muscle energy technique; MWM: Mobilization with movement; F: frequency; D:duration; I:intensity; W: week; Rep: reputation; NPRS: numerical pain rating scale; VAS: visual analogues scale; ROM: range of motion; ER: external rotation; IR: internal rotation; SPADI: shoulder pain and disability index</p></table-wrap-foot></table-wrap>
</p><p id="Par41">
<table-wrap id="Tab2"><label>Table 2</label><caption><p>PEDro scale assessment of included studies</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Study</th><th align="left">Eligibility criteria</th><th align="left">Random allocation</th><th align="left">Concealed allocation</th><th align="left">Baseline comparably</th><th align="left">Blind subjects</th><th align="left">Blind therapists</th><th align="left">Blind assessor</th><th align="left">Adequate follow-up</th><th align="left">Intention-to-treat analysis</th><th align="left">Between-group comparison</th><th align="left">Point estimates and variability</th><th align="left">PEDro score</th></tr></thead><tbody><tr><td align="left">Iqbal et al.,2020 [<xref ref-type="bibr" rid="CR24">24</xref>]</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">8</td></tr><tr><td align="left">Prasanth et al., 2022 [<xref ref-type="bibr" rid="CR25">25</xref>]</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">9</td></tr><tr><td align="left">Muhammd et al., 2024 [<xref ref-type="bibr" rid="CR21">21</xref>]</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">5</td></tr><tr><td align="left">Arif et al.,2023 [<xref ref-type="bibr" rid="CR22">22</xref>]</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">5</td></tr><tr><td align="left">Razaq et al.,2023 [<xref ref-type="bibr" rid="CR12">12</xref>]</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">6</td></tr><tr><td align="left">Chavan et al.,2017 [<xref ref-type="bibr" rid="CR26">26</xref>]</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">5</td></tr><tr><td align="left">Jivani et al., 2021 [<xref ref-type="bibr" rid="CR27">27</xref>]</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">7</td></tr><tr><td align="left">Gasibat et al., 2022 [<xref ref-type="bibr" rid="CR23">23</xref>]</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">7</td></tr><tr><td align="left">Contractor et al. [<xref ref-type="bibr" rid="CR9">9</xref>]</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">1</td><td char="." align="char">4</td></tr></tbody></table></table-wrap>
</p></sec><sec id="Sec12"><title>Risk of bias</title><p id="Par42">The risk of bias assessment of all included studies is shown in Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>. For all-over risk of bias, 1 study (11.1%) was low risk of bias [<xref ref-type="bibr" rid="CR27">27</xref>], 5 studies (55.5%) were rated as some concern [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR22">22</xref>, <xref ref-type="bibr" rid="CR24">24</xref>, <xref ref-type="bibr" rid="CR25">25</xref>], and 3 studies (33.3%) were rated as high risk of bias [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR26">26</xref>]. In the randomization process five studies (55.5%) were rated as &#x0201c;some concern&#x0201d; [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR21">21</xref>&#x02013;<xref ref-type="bibr" rid="CR23">23</xref>], three studies (33%) were rated as &#x0201c;low risk of bias&#x0201d; [<xref ref-type="bibr" rid="CR24">24</xref>, <xref ref-type="bibr" rid="CR25">25</xref>, <xref ref-type="bibr" rid="CR27">27</xref>], and one study (11.1%) was rated as &#x0201c;high risk of bias&#x0201d; [<xref ref-type="bibr" rid="CR26">26</xref>].</p><p id="Par43">For the deviation from intended interventions, five studies (55.5%) were rated as &#x0201c;some concern&#x0201d; [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR24">24</xref>, <xref ref-type="bibr" rid="CR26">26</xref>], and four studies (44.5%) were rated as &#x0201c;low risk of bias&#x0201d; [<xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR22">22</xref>, <xref ref-type="bibr" rid="CR25">25</xref>, <xref ref-type="bibr" rid="CR27">27</xref>]. In addition, there is no bias in the missing outcome data across all studies. While in the measurement of outcome data, one study (11.1%) was rated as &#x0201c;some concern&#x0201d; [<xref ref-type="bibr" rid="CR25">25</xref>] and another study (11.1%) was rated as &#x0201c;high risk of bias&#x0201d; [<xref ref-type="bibr" rid="CR12">12</xref>]. Finally, for the selection of reported results, four studies (44.5%) were rated as &#x0201c;some concern&#x0201d; [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR24">24</xref>, <xref ref-type="bibr" rid="CR25">25</xref>], and five studies (55.5%) were rated as &#x0201c;low risk of bias&#x0201d; [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR22">22</xref>, <xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR26">26</xref>, <xref ref-type="bibr" rid="CR27">27</xref>].</p><p id="Par44">
<fig id="Fig2"><label>Fig. 2</label><caption><p>Risk of bias summary for each included study</p></caption><graphic xlink:href="12891_2025_9028_Fig2_HTML" id="d33e1440"/></fig>
</p></sec><sec id="Sec13"><title>Outcomes</title><sec id="Sec14"><title>Pain</title><p id="Par45">Eight studies [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR21">21</xref>&#x02013;<xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR25">25</xref>&#x02013;<xref ref-type="bibr" rid="CR27">27</xref>] investigated the effectiveness of the SMET compared to the control group for reducing pain in patients with frozen shoulders. One study [<xref ref-type="bibr" rid="CR24">24</xref>] was not included in the meta-analysis due to insufficient data. The pooled effect showed no statistically significant difference between SMET and the control group (<italic>N</italic>&#x02009;=&#x02009;234; SMD, &#x02212;0.19; 95% CI (&#x02212;0.83, 0.45); I&#x000b2;=84%; Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>). Subgroup analysis with each control group was performed and showed the SMET was statistically significant compared to Maitland mobilization in reducing pain (<italic>N</italic>&#x02009;=&#x02009;98; SMD,&#x02212;0.99; 95% CI (&#x02212;1.41,&#x02212;0.56); Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>). However, SMET is less statistically significant compared to Mulligan mobilization in reducing pain for treatment of frozen shoulder patients (Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>).</p></sec></sec><sec id="Sec15"><title>Functional disability</title><p id="Par46">Six studies [<xref ref-type="bibr" rid="CR21">21</xref>&#x02013;<xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR25">25</xref>&#x02013;<xref ref-type="bibr" rid="CR27">27</xref>] were included in the meta-analysis because two studies [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR12">12</xref>] didn&#x02019;t report enough data for this meta-analysis. The pooled effect showed SMET is statistically significant effect for improved shoulder functional capacity compared to the control group in frozen shoulder patients (<italic>N</italic>&#x02009;=&#x02009;212; SMD, &#x02212;0.5; 95% CI (&#x02212;0.78, &#x02212;0.22); I<sup>2</sup>&#x02009;=&#x02009;41% (Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>).</p></sec><sec id="Sec16"><title>Range of motion</title><p id="Par47">For shoulder flexion range of motion, six studies [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR25">25</xref>&#x02013;<xref ref-type="bibr" rid="CR27">27</xref>] were included in the meta-analysis, and the other two studies [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR22">22</xref>] didn&#x02019;t report enough data. The overall effect showed there is no statistically significant difference between SMET and the control group for increasing shoulder flexion range of motion (<italic>N</italic>&#x02009;=&#x02009;210; MD, 7.65; 95% CI (&#x02212;11.7, 26.9); Fig.&#x000a0;<xref rid="Fig5" ref-type="fig">5</xref>). Subgroup analysis for SMET compared to each control group were performed; the result showed Maitland mobilization and myofascial arm pull were statistically significant for increasing shoulder flexion range of motion compared to the SMET (Fig.&#x000a0;<xref rid="Fig5" ref-type="fig">5</xref>).</p><p id="Par48">For shoulder abduction range of motion, six studies [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR25">25</xref>&#x02013;<xref ref-type="bibr" rid="CR27">27</xref>] were included in this meta-analysis. The pooled effect showed there is no statistically significant difference between SMET and the control group for increasing shoulder abduction range of motion (<italic>N</italic>&#x02009;=&#x02009;210; MD,11.32; 95% CI (&#x02212;9.10, 31.74); Fig.&#x000a0;<xref rid="Fig6" ref-type="fig">6</xref>). Subgroup analysis were performed on SMET compared to each control group. The result revealed that Maitland mobilization and myofascial arm pull were statistically significant effects for improved shoulder abduction range of motion compared to the SMET (Fig.&#x000a0;<xref rid="Fig6" ref-type="fig">6</xref>).</p><p id="Par49">For shoulder external rotation range of motion, five studies [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR26">26</xref>, <xref ref-type="bibr" rid="CR27">27</xref>] were included in this meta-analysis. The overall effect of five studies showed the control group was statistically significant for increased shoulder external rotation range of motion compared to SMET (<italic>N</italic>&#x02009;=&#x02009;180; MD, 9.74; 95% CI (2.38, 17.10); Fig.&#x000a0;<xref rid="Fig7" ref-type="fig">7</xref>. Subgroup analysis were performed on SMET compared to each control group. The result showed Maitland mobilization and myofascial arm pull was significantly improved shoulder external rotation compared to the SMET (Fig.&#x000a0;<xref rid="Fig7" ref-type="fig">7</xref>). For shoulder extension range of motion, two studies [<xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR27">27</xref>] were included in the meta-analysis; the other studies were not included due to insufficient data. The pooled effect of the two studies showed the control group showed statistically significant effects for improved shoulder extension range of motion compared to the SMET (<italic>N</italic>&#x02009;=&#x02009;98; MD&#x02009;=&#x02009;2.55; 95% CI (1.14, 3.96); Fig.&#x000a0;<xref rid="Fig8" ref-type="fig">8</xref>).</p></sec></sec><sec id="Sec17"><title>Discussion</title><p id="Par50">To our knowledge, this is the first systematic review and meta-analysis study to specifically compare the effectiveness of the SMET versus other comparative treatment groups on pain, function, and ROM in patients with frozen shoulder. Nine trials were included in this study, with an early 1-month to late 6-month follow-up period. Five primary intervention categories were compared with SMET, including Maitland mobilization, Mulligan mobilization, conservative treatment, Gong mobilization, and myofascial arm pull. The pooled effect showed that there was no statistical difference between SMET and the control group for pain reduction (SMD, &#x02212;0.19; 95% CI (&#x02212;0.83, 0.45); I&#x000b2;=84%). However, it is important to consider the high heterogeneity of the trails. The possible reason for this heterogeneity might be the differences in control interventions. In subgroup analysis, SMET is statistically superior in reducing shoulder pain compared to Maitland mobilization. This finding is supported by a previous narrative review [<xref ref-type="bibr" rid="CR28">28</xref>] and a case report study [<xref ref-type="bibr" rid="CR29">29</xref>] indicating that SMET has a superior effect compared to Maitland mobilization for reducing pain in frozen shoulder patients. On the other hand, SMET is less effective compared to the Mulligan mobilization technique for reducing pain in frozen shoulder patients. This finding, supported by an RCT study, indicated that Mulligan mobilization was more effective for reducing pain compared to SMET in frozen shoulder patients [<xref ref-type="bibr" rid="CR30">30</xref>]. In addition, the finding of this study, supported by a previous systematic review and meta-analysis study, showed that Mulligan mobilization demonstrated statistical superiority compared to the control group for shoulder pathologies [<xref ref-type="bibr" rid="CR31">31</xref>].</p><p id="Par51">
<fig id="Fig3"><label>Fig. 3</label><caption><p>Forest plot of included studies comparing SMET with other comparative treatments for pain reduction in individuals with frozen shoulder</p></caption><graphic xlink:href="12891_2025_9028_Fig3_HTML" id="d33e1643"/></fig>
</p><p id="Par52">The second outcome in this systematic review and meta-analysis is functional disability. The SPADI questionnaire was utilized to find out functional disability. The pooled effect showed the SPADI score had statistical significance compared to the comparative treatment (SMD, &#x02212;0.5; 95% CI (&#x02212;0.78, &#x02212;0.22); I&#x000b2;=41%). This result is consistent with a previous case report study [<xref ref-type="bibr" rid="CR29">29</xref>]; SMET has effective treatment for improving shoulder function compared to other comparative treatments. Furthermore, the result of this study is supported by studies by Sheikh et al., 2015) and Vijayan et al., 2019, indicating the effectiveness of SMET for improvement of shoulder function in frozen shoulder patients [<xref ref-type="bibr" rid="CR32">32</xref>, <xref ref-type="bibr" rid="CR33">33</xref>].</p><p id="Par53">
<fig id="Fig4"><label>Fig. 4</label><caption><p>A forest plot of included studies comparing SMET with other comparative treatments for improving shoulder function in individuals with frozen shoulder</p></caption><graphic xlink:href="12891_2025_9028_Fig4_HTML" id="d33e1664"/></fig>
</p><p id="Par54">The third outcome in this systematic review and meta-analysis is shoulder ROM. Goniometry was used to measure shoulder range of motion. The pooled effect indicated that there is no statistically significant difference between SMET and the comparative group for improving shoulder flexion (MD, 7.65; 95% CI (&#x02212;11.70, 26.99); I&#x000b2;=95%) and abduction range of motion (MD, 11.32; 95% CI (&#x02212;9.10, &#x02212;26.99); I&#x000b2;=96%). Nevertheless, results should be interpreted with caution due to variable study quality and high heterogeneity.</p><p id="Par55">
<fig id="Fig5"><label>Fig. 5</label><caption><p>A forest plot of included studies comparing SMET with other comparative treatments for improving shoulder flexion range of motion individuals with frozen shoulder</p></caption><graphic xlink:href="12891_2025_9028_Fig5_HTML" id="d33e1676"/></fig>
</p><p id="Par56">
<fig id="Fig6"><label>Fig. 6</label><caption><p>A forest plot of included studies comparing SMET with other comparative treatments for improving shoulder abduction range of motion in individuals with frozen shoulder</p></caption><graphic xlink:href="12891_2025_9028_Fig6_HTML" id="d33e1686"/></fig>
</p><p id="Par57">In subgroup analysis, we found SMET is less effective compared with Maitland mobilization and myofascial arm pull for improving shoulder flexion and abduction range of motion for frozen shoulder patients. The result of this study is supported by a study done by Anwar et al., 2023 SMET showed that Maitland mobilization effective treatment for increasing range of motion [<xref ref-type="bibr" rid="CR34">34</xref>]. Furthermore, the result of this study is supported by Begum et al., 2020, who suggested that myofascial arm pull is an effective intervention for increasing shoulder flexion and abduction range of motion in frozen shoulder patients [<xref ref-type="bibr" rid="CR35">35</xref>]. We also found the pooled effectiveness of SMET versus the control group (Maitland mobilization, Mulligan mobilization, and myofascial arm pull) revealed that the control group was statistically significant effect compared to the SMET for improving shoulder external rotation (MD, 9.74; 95% CI (2.38, 17.0); I&#x000b2;=92%); however, results should be interpreted with caution due to variable study quality and high heterogeneity. The possible cause of the heterogeneity could be differences in control interventions across the trials.</p><p id="Par58">Subgroup analysis was performed for external rotation. We found that Maitland mobilization, Mulligan mobilization, and myofascial arm pull were superior in effect compared to SMET for improving shoulder external rotation range of motion. This result is consistent with a study done by Riaz et al.,2025 which indicated that Mulligan mobilization has a superior effect compared to SMET [<xref ref-type="bibr" rid="CR30">30</xref>]. In addition, the results of this study are supported by a study done by Begum et al. 2020, which revealed that the myofascial arm pull technique is an effective treatment for improving shoulder external range of motion [<xref ref-type="bibr" rid="CR35">35</xref>].</p><p id="Par59">
<fig id="Fig7"><label>Fig. 7</label><caption><p>A forest plot of included studies comparing SMET with other comparative treatments for improving shoulder external rotation range of motion in individuals with frozen shoulder</p></caption><graphic xlink:href="12891_2025_9028_Fig7_HTML" id="d33e1712"/></fig>
</p><p id="Par60">For extension range of motion, we only included two studies due to insufficient data on other studies. The result of this study indicated that the control group (Maitland mobilization) significantly improved shoulder extension compared to SMET. This finding of this result is supported by a study done by Ai Shehri et al.,2018, which indicated that Maitland mobilization was an effective treatment for improving shoulder range of motion for frozen shoulder patients [<xref ref-type="bibr" rid="CR36">36</xref>].</p><p id="Par61">
<fig id="Fig8"><label>Fig. 8</label><caption><p>A forest plot of included studies comparing SMET with other comparative treatments for improving shoulder extension range of motion in individuals with frozen shoulder</p></caption><graphic xlink:href="12891_2025_9028_Fig8_HTML" id="d33e1728"/></fig>
</p><sec id="Sec18"><title>Implications for clinicians and researchers</title><p id="Par62">SMET may be particularly useful for functional disability. Other techniques like Maitland or Myofascial arm pull might be more effective in improving ROM. SMET involves a series of mobilization and stretching maneuvers. So clinicians should ensure they are trained and confident in applying SMET safely. Further studies should explore the effect of SMET across different stages of frozen shoulder to determine optimal timing for intervention and investigate whether age or gender influences the effectiveness of SMET, which could provide insight to personalize the treatment approach. Pain scales (VAS, NPRS) can help quantify changes in pain level. ROM measuring before and after treatment sessions is crucial to assess immediate effects, and the functional assessment tool (SPADI) can provide insight into functional improvement.</p></sec><sec id="Sec19"><title>Limitation of the study</title><p id="Par63">Some potential limitations of this study should be acknowledged. Firstly, the search strategy in this study was limited to English-language publications. Therefore, relevant studies published in other languages may have been missed. Second, some comparisons in this study were made based on only 1 trial. Therefore, general conclusions cannot be drawn from these comparisons. Finally, the conclusions of some studies were based on fair quality trails, and therefore the current effect estimates may be changed by future research.</p></sec></sec><sec id="Sec20"><title>Conclusion</title><p id="Par64">This systematic review and meta-analysis indicates that SMET shows promise in improving shoulder function in patients with frozen shoulder; however, evidence is inconsistent for pain and ROM outcomes compared to other manual therapies. Further studies should explore the effect of SMET across different phases of frozen shoulder to determine the optimal timing for intervention through large, high-quality, and well-designed randomized control trials.</p></sec><sec id="Sec21" sec-type="supplementary-material"><title>Supplementary Information</title><p>Below is the link to the electronic supplementary material.</p><p>
<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="12891_2025_9028_MOESM1_ESM.docx"><caption><p>Supplementary Material 1</p></caption></media></supplementary-material>
</p><p>
<supplementary-material content-type="local-data" id="MOESM2"><media xlink:href="12891_2025_9028_MOESM2_ESM.docx"><caption><p>Supplementary Material 2</p></caption></media></supplementary-material>
</p></sec></body><back><glossary><title>Abbreviations</title><def-list><def-item><term>CI</term><def><p id="Par6">Confidence Interval</p></def></def-item><def-item><term>ISAKOS</term><def><p id="Par7">International Society of Arthroscopy, Knee Surgery and Orthopedic Sports Medicine</p></def></def-item><def-item><term>MD</term><def><p id="Par8">Mean Difference</p></def></def-item><def-item><term>MET</term><def><p id="Par9">Muscle Energy Technique</p></def></def-item><def-item><term>MWM</term><def><p id="Par10">Mobilization with Movement</p></def></def-item><def-item><term>NPRS</term><def><p id="Par11">Numeric Pain Rating Scale</p></def></def-item><def-item><term>PEDro</term><def><p id="Par12">Physiotherapy Evidence Data base</p></def></def-item><def-item><term>PRISMA</term><def><p id="Par13">Preferred Reporting Item for Systematic review and meta-analysis</p></def></def-item><def-item><term>PROSPERO</term><def><p id="Par14">International Prospective Registered of Systematic review</p></def></def-item><def-item><term>ROB2</term><def><p id="Par15">Cochrane Risk of Bias tool</p></def></def-item><def-item><term>ROM</term><def><p id="Par16">Range of Motion</p></def></def-item><def-item><term>SMD</term><def><p id="Par17">Standard Mean Difference</p></def></def-item><def-item><term>SMET</term><def><p id="Par18">Spencer Muscle Energy Technique</p></def></def-item><def-item><term>SPADI</term><def><p id="Par19">Shoulder Pain and Disability Index</p></def></def-item><def-item><term>VAS</term><def><p id="Par20">Visual Analogues scale</p></def></def-item></def-list></glossary><fn-group><fn><p><bold>Publisher&#x02019;s note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn></fn-group><ack><title>Acknowledgements</title><p>Not applicable.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>MDT conceived and designed the study. MDT, GAE, and AKK had full access to all data in the study and took responsibility for the integrity of the data and the accuracy of the data analysis. MDT, GJB, and KBS did the literature search. MB and KG assessed the eligibility of the article and edited Table&#x000a0;1. MDT, GAE, and AKK conducted the analyses, interpreted the data, and wrote the first draft of the manuscript. All authors contributed to the critical revision of the report for important intellectual content.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>The authors have not declared a specific grant for this research from any funding agency in the public, commercial or not- for- profit sectors.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>The data used to support this study are available from the corresponding author upon request.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title><bold>Human ethics and consent to participate</bold></title><p id="Par65">Not applicable.</p></notes><notes id="FPar2"><title><bold>Patient consent for publication</bold></title><p id="Par66">Not applicable.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests</title><p id="Par67">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Khyathi</surname><given-names>P</given-names></name><name><surname>Babu</surname><given-names>V</given-names></name><name><surname>Kumar</surname><given-names>N</given-names></name><name><surname>Asha</surname><given-names>D</given-names></name></person-group><article-title>Comparative effect of Spencer technique versus mulligans technique for subjects with frozen shoulder a single blind study</article-title><source>Int J Physiother</source><year>2015</year><volume>2</volume><issue>2</issue><fpage>448</fpage><lpage>58</lpage></element-citation><mixed-citation id="mc-CR1" publication-type="journal">Khyathi P, Babu V, Kumar N, Asha D. Comparative effect of Spencer technique versus mulligans technique for subjects with frozen shoulder a single blind study. Int J Physiother. 2015;2(2):448&#x02013;58.</mixed-citation></citation-alternatives></ref><ref id="CR2"><label>2.</label><citation-alternatives><element-citation id="ec-CR2" publication-type="journal"><person-group person-group-type="author"><name><surname>Neviaser</surname><given-names>AS</given-names></name><name><surname>Neviaser</surname><given-names>RJ</given-names></name></person-group><article-title>Adhesive capsulitis of the shoulder</article-title><source>JAAOS-Journal Am Acad Orthop Surg</source><year>2011</year><volume>19</volume><issue>9</issue><fpage>536</fpage><lpage>42</lpage></element-citation><mixed-citation id="mc-CR2" publication-type="journal">Neviaser AS, Neviaser RJ. Adhesive capsulitis of the shoulder. JAAOS-Journal Am Acad Orthop Surg. 2011;19(9):536&#x02013;42.</mixed-citation></citation-alternatives></ref><ref id="CR3"><label>3.</label><citation-alternatives><element-citation id="ec-CR3" publication-type="journal"><person-group person-group-type="author"><name><surname>Itoi</surname><given-names>E</given-names></name><name><surname>Arce</surname><given-names>G</given-names></name><name><surname>Bain</surname><given-names>GI</given-names></name><name><surname>Diercks</surname><given-names>RL</given-names></name><name><surname>Guttmann</surname><given-names>D</given-names></name><name><surname>Imhoff</surname><given-names>AB</given-names></name><etal/></person-group><article-title>Shoulder stiffness: current concepts and concerns</article-title><source>Arthroscopy: J Arthroscopic Relat Surg</source><year>2016</year><volume>32</volume><issue>7</issue><fpage>1402</fpage><lpage>14</lpage></element-citation><mixed-citation id="mc-CR3" publication-type="journal">Itoi E, Arce G, Bain GI, Diercks RL, Guttmann D, Imhoff AB, et al. Shoulder stiffness: current concepts and concerns. Arthroscopy: J Arthroscopic Relat Surg. 2016;32(7):1402&#x02013;14.</mixed-citation></citation-alternatives></ref><ref id="CR4"><label>4.</label><mixed-citation publication-type="other">ES D. de la periarthritis scapulohumerale et des radieurs de l&#x02019;&#x000e9;paule qui en sont la cons&#x000e9;quence. Arch Gen Med. 2015;20:513&#x02013;42. </mixed-citation></ref><ref id="CR5"><label>5.</label><mixed-citation publication-type="other"> Millar NL, Meakins A, Struyf F, Willmore E, Campbell AL, Kirwan PD et al. Frozen shoulder (Primer). Nat Reviews: Disease Primers. 2022; 8:1-2(1). </mixed-citation></ref><ref id="CR6"><label>6.</label><citation-alternatives><element-citation id="ec-CR6" publication-type="journal"><person-group person-group-type="author"><name><surname>Doly</surname><given-names>EA</given-names></name></person-group><article-title>Prevalence of frozen shoulder among diabetes mellitus patients: a cross cut survey</article-title><source>Orthop Rheumatol Open Access J</source><year>2017</year><volume>9</volume><fpage>38</fpage><lpage>40</lpage></element-citation><mixed-citation id="mc-CR6" publication-type="journal">Doly EA. Prevalence of frozen shoulder among diabetes mellitus patients: a cross cut survey. Orthop Rheumatol Open Access J. 2017;9:38&#x02013;40.</mixed-citation></citation-alternatives></ref><ref id="CR7"><label>7.</label><citation-alternatives><element-citation id="ec-CR7" publication-type="journal"><person-group person-group-type="author"><name><surname>De la Serna</surname><given-names>D</given-names></name><name><surname>Navarro-Ledesma</surname><given-names>S</given-names></name><name><surname>Alay&#x000f3;n</surname><given-names>F</given-names></name><name><surname>L&#x000f3;pez</surname><given-names>E</given-names></name><name><surname>Pruimboom</surname><given-names>L</given-names></name></person-group><article-title>A comprehensive vie
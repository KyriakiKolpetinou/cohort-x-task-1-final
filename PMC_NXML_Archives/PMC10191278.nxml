<bold>0</bold>.<bold>04</bold></td><td rowspan="1" colspan="1">1.31</td><td rowspan="1" colspan="1">67%</td><td rowspan="1" colspan="1">89%</td><td rowspan="1" colspan="1">89%</td><td rowspan="1" colspan="1">67%</td></tr><tr><td colspan="8" rowspan="1">

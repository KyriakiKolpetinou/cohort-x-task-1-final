<bold>&#x0003c;0</bold>.<bold>01</bold></td></tr><tr><td rowspan="1" colspan="1">&#x02003;STEMI</td><td rowspan="1" colspan="1">25 (15.0)</td><td rowspan="1" colspan="1">3 (13.6)</td><td rowspan="1" colspan="1">22 (15.2)</td><td rowspan="1" colspan="1">0.85</td></tr><tr><td rowspan="1" colspan="1">&#x02003;NSTEMI</td><td rowspan="1" colspan="1">56 (33.5)</td><td rowspan="1" colspan="1">9 (40.9)</td><td rowspan="1" colspan="1">47 (32.4)</td><td rowspan="1" colspan="1">0.43</td></tr><tr><td rowspan="1" colspan="1">&#x02003;LBBB</td><td rowspan="1" colspan="1">16 (9.6)</td><td rowspan="1" colspan="1">1 (4.5)</td><td rowspan="1" colspan="1">15 (10.3)</td><td rowspan="1" colspan="1">0.39</td></tr><tr><td rowspan="1" colspan="1">&#x02003;AFIB/flutter</td><td rowspan="1" colspan="1">41 (24.6)</td><td rowspan="1" colspan="1">1 (4.5)</td><td rowspan="1" colspan="1">40 (27.6)</td><td rowspan="1" colspan="1">
<bold>0</bold>.<bold>02</bold></td></tr><tr><td colspan="5" rowspan="1">
<bold>Risk factors</bold>
</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Diabetes mellitus</td><td rowspan="1" colspan="1">49 (28.7)</td><td rowspan="1" colspan="1">6 (27.3)</td><td rowspan="1" colspan="1">43 (29.0)</td><td rowspan="1" colspan="1">0.87</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Hypertension</td><td rowspan="1" colspan="1">143 (85.6)</td><td rowspan="1" colspan="1">16 (72.7)</td><td rowspan="1" colspan="1">127 (87.6)</td><td rowspan="1" colspan="1">0.65</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Hyperlipaemia</td><td rowspan="1" colspan="1">145 (86.8)</td><td rowspan="1" colspan="1">18 (81.8)</td><td rowspan="1" colspan="1">127 (87.6)</td><td rowspan="1" colspan="1">0.46</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Current smoker</td><td rowspan="1" colspan="1">14 (8.4)</td><td rowspan="1" colspan="1">2 (9.1)</td><td rowspan="1" colspan="1">12 (8.3)</td><td rowspan="1" colspan="1">0.90</td></tr><tr><td rowspan="1" colspan="1">&#x02003;CAD family history</td><td rowspan="1" colspan="1">88<sup><xref rid="oead044-B1" ref-type="bibr">1</xref></sup> (56.1)</td><td rowspan="1" colspan="1">13<sup><xref rid="oead044-B2" ref-type="bibr">2</xref></sup> (65.0)</td><td rowspan="1" colspan="1">74<sup><xref rid="oead044-B3" ref-type="bibr">3</xref></sup> (54.7)</td><td rowspan="1" colspan="1">0.39</td></tr><tr><td colspan="5" rowspan="1">

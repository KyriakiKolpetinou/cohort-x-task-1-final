</element-citation></ref><ref id="bib7"><label>7</label><element-citation publication-type="book" id="sref7"><person-group person-group-type="author"><name><surname>Blumgart</surname><given-names>L.H.</given-names></name><name><surname>Hann</surname><given-names>L.E.</given-names></name></person-group><part-title>Surgical and radiologic anatomy of the liver, biliary tract, and pancreas</part-title><person-group person-group-type="editor"><name><surname>Jarnagin WR</surname></name><name><surname>Blumgart LH</surname></name></person-group><source>Blumgart's Surgery of the Liver, Pancreas and Biliary Tract</source><year>2012</year><publisher-name>Elsevier</publisher-name><publisher-loc>Philadelphia</publisher-loc><fpage>31</fpage><lpage>57.e1</lpage></element-citation></ref><ref id="bib8"><label>8</label><element-citation publication-type="journal" id="sref8"><person-group person-group-type="author"><name><surname>Sharma</surname><given-names>M.</given-names></name><name><surname>Somani</surname><given-names>P.</given-names></name><name><surname>Rameshbabu</surname><given-names>C.S.</given-names></name></person-group><article-title>Linear endoscopic ultrasound evaluation of hepatic veins</article-title><source>World J Gastrointest Endosc</source><volume>10</volume><year>2018</year><fpage>283</fpage><lpage>293</lpage><pub-id pub-id-type="pmid">30364872</pub-id>
</element-citation></ref><ref id="bib9"><label>9</label><element-citation publication-type="book" id="sref9"><person-group person-group-type="author"><name><surname>Bilal</surname><given-names>O.A.-J.</given-names></name><name><surname>Samah</surname><given-names>K.H.</given-names></name></person-group><part-title>Segmental oriented liver surgery. In: Abdeldayem H, editor</part-title><year>2013</year><publisher-name>Hepatic Surgery: IntechOpen</publisher-name><publisher-loc>London</publisher-loc><comment>p. 223-56</comment></element-citation></ref><ref id="bib10"><label>10</label><element-citation publication-type="journal" id="sref10"><person-group person-group-type="author"><name><surname>Chavan</surname><given-names>R.</given-names></name><name><surname>Rajput</surname><given-names>S.</given-names></name></person-group><article-title>Pictorial essay of linear endoscopic ultrasound examination of pancreas anatomy</article-title><source>J Dig Endosc</source><volume>14</volume><year>2023</year><fpage>88</fpage><lpage>98</lpage></element-citation></ref><ref id="bib11"><label>11</label><element-citation publication-type="journal" id="sref11"><person-group person-group-type="author"><name><surname>Chavan</surname><given-names>R.</given-names></name><name><surname>Gandhi</surname><given-names>C.</given-names></name><name><surname>Patel</surname><given-names>M.</given-names></name><etal/></person-group><article-title>Linear endoscopic ultrasound examination of the biliary system and its clinical applications</article-title><source>J Dig Endosc</source><volume>14</volume><year>2023</year><fpage>211</fpage><lpage>220</lpage></element-citation></ref></ref-list><sec id="appsec1" sec-type="supplementary-material"><title>Supplementary data</title><p id="p0155">

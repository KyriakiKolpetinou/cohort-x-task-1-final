</person-group><article-title>Management of complications after angularly stable locking proximal humerus plate fixation</article-title><source>Chirurg</source><year>2007</year><volume>78</volume><fpage>40</fpage><lpage>46</lpage><pub-id pub-id-type="doi">10.1007/s00104-006-1241-0</pub-id><pub-id pub-id-type="pmid">16998660</pub-id></element-citation></ref><ref id="B11-medicina-59-00450"><label>11.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Kirousis</surname><given-names>G.</given-names></name>
<name><surname>Delis</surname><given-names>H.</given-names></name>
<name><surname>Megas</surname><given-names>P.</given-names></name>

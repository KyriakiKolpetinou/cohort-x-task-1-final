Frustum Supported miR-21 Assay
with Duplex-Specific Nuclease-Assisted Target Recycling</article-title></title-group><contrib-group id="CONTRIB-GROUP-d14e22-autogenerated"><contrib id="ath1" contrib-type="author"><contrib-id contrib-id-type="paragon-plus" authenticated="true">5939883</contrib-id><name><surname>Chai</surname><given-names>Hua</given-names></name><xref rid="aff1" ref-type="aff"/><xref rid="aff2" ref-type="aff"/></contrib><contrib id="ath2" contrib-type="author"><contrib-id contrib-id-type="paragon-plus" authenticated="true">7652325</contrib-id><name><surname>Yang</surname><given-names>Li</given-names></name><xref rid="aff1" ref-type="aff"/><xref rid="aff2" ref-type="aff"/></contrib><contrib id="ath3" contrib-type="author"><contrib-id contrib-id-type="paragon-plus" authenticated="true">7036083</contrib-id><name><surname>Qu</surname><given-names>Xiaolin</given-names></name><xref rid="aff2" ref-type="aff"/><xref rid="aff3" ref-type="aff"/></contrib><contrib id="ath4" contrib-type="author" corresp="yes"><contrib-id contrib-id-type="paragon-plus" authenticated="true">2031524</contrib-id><contrib-id contrib-id-type="orcid" authenticated="true">https://orcid.org/0000-0003-3993-4778</contrib-id><name><surname>Miao</surname><given-names>Peng</given-names></name><xref rid="cor1" ref-type="corresp"/><xref rid="aff1" ref-type="aff"/><xref rid="aff2" ref-type="aff"/></contrib><aff id="aff1">

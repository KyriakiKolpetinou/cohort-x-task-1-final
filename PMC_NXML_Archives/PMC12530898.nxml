<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" dtd-version="1.3" xml:lang="en" article-type="research-article"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">J Neuroendovasc Ther</journal-id><journal-id journal-id-type="iso-abbrev">J Neuroendovasc Ther</journal-id><journal-title-group><journal-title>JNET Journal of Neuroendovascular Therapy</journal-title></journal-title-group><issn pub-type="ppub">1882-4072</issn><issn pub-type="epub">2186-2494</issn><publisher><publisher-name>The Japanese Society for Neuroendovascular Therapy</publisher-name></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41112963</article-id><article-id pub-id-type="pmc">12530898</article-id><article-id pub-id-type="publisher-id">jnet.oa.2025-0105</article-id><article-id pub-id-type="doi">10.5797/jnet.oa.2025-0105</article-id><article-version vocab="JAV" vocab-identifier="http://www.niso.org/publications/rp/RP-8-2008.pdf" article-version-type="VoR" vocab-term="Version of Record">version-of-record</article-version><article-categories><subj-group subj-group-type="heading"><subject>Original Article</subject></subj-group></article-categories><title-group><article-title>Contact Aspiration Combined with a Stent Retriever versus Contact Aspiration Alone in Mechanical Thrombectomy for Acute Ischemic Strokes: A Nationwide Analysis Using the Diagnosis Procedure Combination Database</article-title><alt-title alt-title-type="running-head-verso">Nakashima S, et al.</alt-title><alt-title alt-title-type="running-head-recto">Direct Aspiration vs. Combined Techniques in Stroke Thrombectomy</alt-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Nakashima</surname><given-names>Saki</given-names></name><xref rid="AFF1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Egashira</surname><given-names>Shuhei</given-names></name><xref rid="AFF2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>Aso</surname><given-names>Shotaro</given-names></name><xref rid="AFF3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Yasunaga</surname><given-names>Hideo</given-names></name><xref rid="AFF4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><name><surname>Sato</surname><given-names>Kenichiro</given-names></name><xref rid="AFF5" ref-type="aff">5</xref><xref rid="AFF6" ref-type="aff">6</xref></contrib><contrib contrib-type="author"><name><surname>Niimi</surname><given-names>Yoshiki</given-names></name><xref rid="AFF5" ref-type="aff">5</xref><xref rid="AFF6" ref-type="aff">6</xref></contrib><contrib contrib-type="author"><name><surname>Isogai</surname><given-names>Toshiaki</given-names></name><xref rid="AFF3" ref-type="aff">3</xref><xref rid="AFF7" ref-type="aff">7</xref></contrib><contrib contrib-type="author"><name><surname>Matsui</surname><given-names>Hiroki</given-names></name><xref rid="AFF4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><name><surname>Shirota</surname><given-names>Yuichiro</given-names></name><xref rid="AFF1" ref-type="aff">1</xref><xref rid="AFF8" ref-type="aff">8</xref></contrib><contrib contrib-type="author"><name><surname>Hamada</surname><given-names>Masashi</given-names></name><xref rid="AFF1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Fushimi</surname><given-names>Kiyohide</given-names></name><xref rid="AFF9" ref-type="aff">9</xref></contrib><contrib contrib-type="author"><name><surname>Toda</surname><given-names>Tatsushi</given-names></name><xref rid="AFF1" ref-type="aff">1</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Kodama</surname><given-names>Satoshi</given-names></name><xref rid="AFF10" ref-type="aff">10</xref><xref rid="C1" ref-type="corresp"/></contrib><aff id="AFF1"><label>1</label><institution content-type="department">Department of Neurology, Graduate School of Medicine, The University of Tokyo</institution>, <addr-line content-type="city">Tokyo</addr-line>, <country>Japan</country></aff><aff id="AFF2"><label>2</label><institution content-type="department">Department of Neurology, Toranomon Hospital</institution>, <addr-line content-type="city">Tokyo</addr-line>, <country>Japan</country></aff><aff id="AFF3"><label>3</label><institution content-type="department">Department of Health Services Research, Graduate School of Medicine, The University of Tokyo</institution>, <addr-line content-type="city">Tokyo</addr-line>, <country>Japan</country></aff><aff id="AFF4"><label>4</label><institution content-type="department">Department of Clinical Epidemiology and Health Economics, School of Public Health, The University of Tokyo</institution>, <addr-line content-type="city">Tokyo</addr-line>, <country>Japan</country></aff><aff id="AFF5"><label>5</label><institution content-type="department">Unit for Early and Exploratory Clinical Development, The University of Tokyo Hospital</institution>, <addr-line content-type="city">Tokyo</addr-line>, <country>Japan</country></aff><aff id="AFF6"><label>6</label><institution content-type="department">Dementia Inclusion and Therapeutics, The University of Tokyo Hospital</institution>, <addr-line content-type="city">Tokyo</addr-line>, <country>Japan</country></aff><aff id="AFF7"><label>7</label><institution content-type="department">Department of Cardiology, Tokyo Metropolitan Tama Medical Center</institution>, <addr-line content-type="city">Tokyo</addr-line>, <country>Japan</country></aff><aff id="AFF8"><label>8</label><institution content-type="department">Department of Clinical Laboratory Medicine, Graduate School of Medicine, The University of Tokyo</institution>, <addr-line content-type="city">Tokyo</addr-line>, <country>Japan</country></aff><aff id="AFF9"><label>9</label><institution content-type="department">Department of Health Policy and Informatics, Institute of Science Tokyo Graduate School</institution>, <addr-line content-type="city">Tokyo</addr-line>, <country>Japan</country></aff><aff id="AFF10"><label>10</label><institution content-type="department">Department of Neurology, The University of Iowa Hospitals and Clinics</institution>, <addr-line content-type="city">Iowa, IA</addr-line>, <country>USA</country></aff></contrib-group><author-notes><corresp id="C1">Corresponding author: Satoshi Kodama. Department of Neurology, The University of Iowa Hospitals and Clinics, 200 Hawkins Drive, Iowa City, IA 52242, USA. Email: <email xlink:href="mailto:satoshi-kodama@uiowa.edu">satoshi-kodama@uiowa.edu</email></corresp></author-notes><pub-date pub-type="epub"><day>15</day><month>10</month><year>2025</year></pub-date><pub-date pub-type="ppub"><year>2025</year></pub-date><volume>19</volume><issue>1</issue><elocation-id>2025-0105</elocation-id><history><date date-type="received"><day>13</day><month>8</month><year>2025</year></date><date date-type="accepted"><day>18</day><month>9</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9;2025 The Japanese Society for Neuroendovascular Therapy</copyright-statement><copyright-year>2025</copyright-year><copyright-holder>The Japanese Society for Neuroendovascular Therapy</copyright-holder><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbynclicense">https://creativecommons.org/licenses/by-nc/4.0/</ali:license_ref><license-p>This work is licensed under a <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc/4.0/">Creative Commons Attribution-NonCommercial 4.0 International License</ext-link>.</license-p></license></permissions><abstract><sec id="st1"><title>Objective</title><p>The technique combining a stent retriever (SR) and contact aspiration (CA) has been widely used in mechanical thrombectomy for acute ischemic stroke. However, advancements in large-bore aspiration catheters suggest that CA alone may achieve comparable therapeutic outcomes, while streamlining the procedure. Nevertheless, real-world evidence directly comparing these approaches is limited.</p></sec><sec id="st2"><title>Methods</title><p>We identified patients hospitalized for ischemic stroke who underwent mechanical thrombectomy between April 2020 and March 2023 from the Japanese national inpatient Diagnosis Procedure Combination database. Patients treated with CA or CA combined with SR (CA + SR) were enrolled. Propensity score overlap weighting was performed to adjust for confounders. The outcomes were intracranial hemorrhage (ICH), functional independence at discharge, in-hospital mortality, and total hospitalization cost.</p></sec><sec id="st3"><title>Results</title><p>Among 17589 eligible patients, 14892 underwent CA + SR and 2697 received CA. The adjusted proportions of ICH were comparable between the groups (1.4% vs. 1.3%; adjusted risk difference [aRD], 0.1%; 95% confidence interval [CI], &#x02212;0.5% to 0.5%). The CA + SR group had a lower proportion of functional independence at discharge (28.7% vs. 36.2%; aRD, &#x02212;7.5%; 95% CI, &#x02212;9.5% to &#x02212;5.4%) and higher in-hospital mortality (11.4% vs. 9.2%; aRD, 2.2%; 95% CI, 1.0%&#x02013;3.5%). The total hospitalization costs (USD) were higher in the CA + SR group than in the CA group (21687 vs. 18317; difference, 3370; 95% CI, 2976&#x02013;3764).</p></sec><sec id="st4"><title>Conclusions</title><p>The proportion of patients with ICH did not differ significantly between the CA + SR group and CA groups. CA + SR was associated with worse functional outcomes, higher in-hospital mortality, and higher costs.</p></sec></abstract><kwd-group><title>Keywords</title><kwd>contact aspiration</kwd><kwd>direct aspiration</kwd><kwd>combined techniques</kwd><kwd>thrombectomy</kwd><kwd>acute ischemic stroke</kwd></kwd-group><funding-group><award-group id="awg1"><funding-source>Ministry of Health, Labour and Welfare, Japan</funding-source><award-id>23AA2003</award-id><award-id>24AA2006</award-id></award-group><funding-statement>This work was supported by grants from the Ministry of Health, Labour and Welfare, Japan (23AA2003 and 24AA2006).</funding-statement></funding-group></article-meta></front><body><sec id="s1"><title>Abbreviations</title><def-list><def-item><term>
aRD
</term><def><p>adjusted risk difference</p></def></def-item><def-item><term>
BMI
</term><def><p>body mass index</p></def></def-item><def-item><term>
CA
</term><def><p>contact aspiration</p></def></def-item><def-item><term>
DPC
</term><def><p>Diagnosis Procedure Combination</p></def></def-item><def-item><term>
ICH
</term><def><p>intracranial hemorrhage</p></def></def-item><def-item><term>
JCS
</term><def><p>Japan Coma Scale</p></def></def-item><def-item><term>
mRS
</term><def><p>modified Rankin Scale</p></def></def-item><def-item><term>
SR
</term><def><p>stent retriever</p></def></def-item></def-list></sec><sec sec-type="intro" id="s2"><title>Introduction</title><p>Acute ischemic stroke due to large vessel occlusion is among the leading causes of disability and mortality, necessitating rapid and effective revascularization to improve clinical outcomes. Mechanical thrombectomy, which is performed using two principal techniques, namely contact aspiration (CA) and stent retriever (SR) thrombectomy, has been established as the standard of care.<sup><xref rid="ref-1" ref-type="bibr">1</xref>,<xref rid="ref-2" ref-type="bibr">2</xref>)</sup> However, in patients with large thrombi, complete retrieval may be challenging because distal fragments can be left behind. Additionally, misalignment between the catheter and thrombus may reduce suction efficiency. In contrast, CA combined with SR (CA + SR) offers theoretical advantages. An SR can anchor the thrombus, prevent fragmentation, and facilitate the alignment of the aspiration catheter, potentially improving recanalization, such as a superior 1st-pass effect.<sup><xref rid="ref-3" ref-type="bibr">3</xref>)</sup></p><p>Several trials have compared CA and SR monotherapies as well as the combination of the two.<sup><xref rid="ref-4" ref-type="bibr">4</xref>&#x02013;<xref rid="ref-6" ref-type="bibr">6</xref>)</sup> However, direct comparison between CA + SR and CA monotherapy remains limited. Although simultaneous or sequential use of CA + SR may effectively enhance clot retrieval, the additional mechanical manipulation may increase the risk of vessel injury, endothelial damage, and distal embolization. Moreover, the greater use of medical devices and prolonged procedural times may impose a greater financial burden on healthcare systems.</p><p>Recent advancements in large-bore aspiration catheters have significantly improved suction power, as evidenced by reports of higher proportions of recanalization with CA alone.<sup><xref rid="ref-7" ref-type="bibr">7</xref>)</sup> By avoiding distal navigation and stent expansion, CA may reduce the risk of hemorrhage.<sup><xref rid="ref-8" ref-type="bibr">8</xref>)</sup> CA can be considered a safer and more cost-effective alternative to CA + SR because it may reduce the need for distal navigation and mitigate procedural risks.<sup><xref rid="ref-9" ref-type="bibr">9</xref>)</sup> This study aimed to evaluate the safety, effectiveness, and cost of CA compared with CA + SR in mechanical thrombectomy for acute ischemic stroke using a national inpatient database in Japan.</p></sec><sec sec-type="materials|methods" id="s3"><title>Materials and Methods</title><p>This study adhered to the Strengthening of the Reporting of Observational Studies in Epidemiology guidelines.<sup><xref rid="ref-10" ref-type="bibr">10</xref>)</sup></p><sec id="s3_1"><title>Study design and data source</title><p>This retrospective cohort study was conducted by extracting data from the Diagnosis Procedure Combination (DPC) database, which contains discharge summaries and administrative claims data from more than 1200 hospitals, accounting for almost 50% of the total acute-care inpatient data in Japan.<sup><xref rid="ref-11" ref-type="bibr">11</xref>)</sup> The DPC database is a repository of patient information, diagnoses, duration from stroke onset to admission, prescriptions, procedure records, and medical costs. The diagnostic data include the primary diagnosis on admission, pre-existing comorbidities, and post-admission complications, which are recorded separately using the International Classification of Diseases 10th revision (ICD-10) codes.</p></sec><sec id="s3_2"><title>Patient selection</title><p>We identified patients hospitalized under a primary diagnosis of acute ischemic stroke (ICD-10 code: I63) who underwent mechanical thrombectomy, followed by discharge, between April 2020 and March 2023. We set the study in this period because aspiration catheters with an inner diameter of 71&#x02013;74 inches for proximal large vessel occlusions and 42&#x02013;46 inches for distal occlusions have been sequentially approved for insurance coverage in Japan since February 2020.<sup><xref rid="ref-12" ref-type="bibr">12</xref>)</sup> Patients who underwent mechanical thrombectomy without CA were excluded. To ensure the inclusion of patients with typical acute ischemic stroke, patients under 40 years of age were excluded because younger patients are less likely to have atherosclerotic causes and predominantly have non-atherothrombotic etiologies such as arterial dissection, hypercoagulable states, and rare genetic vasculopathies.<sup><xref rid="ref-13" ref-type="bibr">13</xref>,<xref rid="ref-14" ref-type="bibr">14</xref>)</sup></p><p>Patients were divided into 2 groups: those treated using the CA and SR devices on the same day (CA + SR group) and those treated with CA alone (CA group).</p></sec><sec id="s3_3"><title>Outcomes</title><p>The primary outcome was the occurrence of intracranial hemorrhage (ICH) (ICD-10 code: I60&#x02013;62). The secondary outcomes were functional independence, defined as a modified Rankin Scale (mRS) score of 0&#x02013;2 at discharge, in-hospital mortality, and total hospitalization costs. All costs were converted to USD at an exchange rate of 150 JPY to 1 USD.</p></sec><sec id="s3_4"><title>Variables</title><p>Covariates that could potentially affect the outcomes of acute ischemic stroke were identified based on previous studies.<sup><xref rid="ref-5" ref-type="bibr">5</xref>,<xref rid="ref-15" ref-type="bibr">15</xref>,<xref rid="ref-16" ref-type="bibr">16</xref>)</sup> Body mass index (BMI) was categorized into 4 groups: &#x0003c;18.5, 18.5&#x02013;24.9, 25.0&#x02013;29.9, and &#x02265;30.0 kg/m<sup>2</sup>. The level of consciousness at admission, which was assessed using the Japan Coma Scale (JCS) (range: 0&#x02013;300, with lower scores indicating normal consciousness), was categorized as fully alert (0), awake without stimuli (1-digit code), arousal by some stimuli (2-digit codes), and coma (3-digit codes). The JCS bears a strong correlation with the Glasgow Coma Scale.<sup><xref rid="ref-17" ref-type="bibr">17</xref>)</sup> Coma was defined as a JCS score &#x02265;100, which roughly corresponds to a Glasgow Coma Scale score &#x02264;8. The database also includes information on the mRS scores before stroke onset and at discharge for patients with stroke or cerebrovascular disease. The mRS scores range from 0 to 6, where 0 denotes no symptoms and 6 signifies death.<sup><xref rid="ref-18" ref-type="bibr">18</xref>)</sup> Pre-existing comorbidities identified from the ICD-10 codes included hypertension (I10&#x02013;13 and I15), dyslipidemia (E78), diabetes mellitus (E10&#x02013;14), and atrial fibrillation (I48). We also identified patients who had received hemodialysis. Data on the hospital volume (number of patients with ischemic stroke admitted to each hospital who underwent mechanical thrombectomy annually), academic hospital, and ambulance use were also included. Hospital volume was divided into tertiles (low, medium, and high) based on patient distribution. We also obtained data pertaining to the use of tissue plasminogen activators and weekend admissions.</p></sec><sec id="s3_5"><title>Statistical analysis</title><p>We conducted propensity score analyses using overlap weighting to adjust for confounding factors. Specifically, a propensity score was calculated for each patient using a logistic regression model for receipt of CA + SR with the following independent variables: sex, age, treatment year, BMI, pre-existing comorbidities, smoking status, JCS score on admission, mRS score before stroke onset, hospital volume, academic hospital, weekend admission, and administration of tissue plasminogen activator. We applied the overlap weighting method, which assigns weights to patients based on their propensity scores, emphasizing those with similar probabilities of receiving either treatment. This approach enhances covariate balance and reduces model dependence.<sup><xref rid="ref-19" ref-type="bibr">19</xref>)</sup> The adjusted risk difference (aRD) for each outcome was calculated. All analyses were performed using Stata/MP version 18.0 (StataCorp LLC, College Station, TX, USA).</p><p>Several sensitivity analyses were also conducted. First, we restricted the analysis to patients with atrial fibrillation because the nature of thrombi responsible for cardioembolic stroke is different from that of thrombi causing non-cardioembolic stroke. Second, we restricted the analysis to patients with coma at admission because the CA + SR group may have been disproportionately represented by patients with severe proximal large vessel occlusions. Third, we performed instrumental variable (IV) analysis to adjust for unmeasured confounding. We defined the IV as the hospital&#x02019;s preference for CA + SR. We also calculated the F-statistic. When the F-statistic is &#x0003e;10, the IV is deemed to be strongly associated with treatment allocation.<sup><xref rid="ref-20" ref-type="bibr">20</xref>)</sup></p></sec><sec id="s3_6"><title>Ethical considerations</title><p>This study was approved by the ethics committee of the University of Tokyo Hospital (Approval No. 3501-(5)). The requirement for informed consent was waived because of the anonymous nature of the data.</p></sec></sec><sec sec-type="results" id="s4"><title>Results</title><sec id="s4_1"><title>Study population</title><p>We identified 28095 patients with acute ischemic stroke who underwent mechanical thrombectomy. Of these, 9348 patients were excluded since they underwent neither CA nor CA + SR, or were younger than 40 years of age (<bold><xref rid="F1" ref-type="fig">Fig. 1</xref></bold>). Consequently, we enrolled 14892 patients who underwent CA + SR and 2697 patients who received CA monotherapy.</p><fig position="float" id="F1"><label>Fig. 1</label><caption><title>Flowchart showing patient selection.</title></caption><graphic xlink:href="jnet-19-01-2025-0105-g001" position="float"/></fig><p><bold><xref rid="table-1" ref-type="table">Table 1</xref></bold> shows the patients&#x02019; demographic characteristics. In the original cohort, patients in the CA + SR group were less likely to take antiplatelet drugs within 1 day after admission. In the unadjusted analysis, the overall incidence of ICH was 6.0% (141/17589). The crude proportion of ICH was 0.8% each in the CA + SR group (120/14892) and the CA group (21/2697).</p><table-wrap position="float" id="table-1"><label>Table 1</label><caption><title>Demographic characteristics of the patients in the original and propensity score overlap-weighted cohorts</title></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" valign="middle" rowspan="1" colspan="1"/><th align="center" valign="middle" style="border-bottom: thin solid;" colspan="3" rowspan="1">Original cohort</th><th align="center" valign="middle" style="border-bottom: thin solid;" colspan="3" rowspan="1">Propensity score overlap-weighted cohort</th></tr><tr><th align="left" valign="middle" rowspan="1" colspan="1"/><th align="center" valign="middle" rowspan="1" colspan="1">CA + SR group,<break/> n = 14892</th><th align="center" valign="middle" rowspan="1" colspan="1">CA group,<break/> n = 2697</th><th align="center" valign="middle" rowspan="1" colspan="1">SMD</th><th align="center" valign="middle" rowspan="1" colspan="1">CA + SR<break/> group</th><th align="center" valign="middle" rowspan="1" colspan="1">CA group</th><th align="center" valign="middle" rowspan="1" colspan="1">SMD</th></tr></thead><tbody><tr><td align="left" valign="top" rowspan="1" colspan="1">Sex (female), n (%)</td><td align="center" valign="top" rowspan="1" colspan="1">7106 (47.7)</td><td align="center" valign="top" rowspan="1" colspan="1">1205 (44.7)</td><td align="center" valign="top" rowspan="1" colspan="1">0.061</td><td align="center" valign="top" rowspan="1" colspan="1">(45.3)</td><td align=
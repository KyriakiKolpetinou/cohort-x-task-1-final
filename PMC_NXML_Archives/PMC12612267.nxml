<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Sci Rep</journal-id><journal-id journal-id-type="iso-abbrev">Sci Rep</journal-id><journal-title-group><journal-title>Scientific Reports</journal-title></journal-title-group><issn pub-type="epub">2045-2322</issn><publisher><publisher-name>Nature Publishing Group UK</publisher-name><publisher-loc>London</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41224790</article-id><article-id pub-id-type="pmc">12612267</article-id>
<article-id pub-id-type="publisher-id">17862</article-id><article-id pub-id-type="doi">10.1038/s41598-025-17862-w</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Ultrasound guided individualized PEEP reduces postoperative atelectasis in elderly patients undergoing laparoscopic radical rectal cancer surgery</article-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><name><surname>Feng</surname><given-names>Duan</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Zhao</surname><given-names>Yu</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Wu</surname><given-names>Zhiqiang</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Li</surname><given-names>Wei</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Li</surname><given-names>Xuechao</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Wan</surname><given-names>Jixiang</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Wang</surname><given-names>Fangjun</given-names></name><address><email>wfjlxy006@nsmc.edu.cn</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><aff id="Aff1"><label>1</label>Department of Anesthesiology, Affiliated Hospital of Sichuan North Medical College, Nanchong, China </aff><aff id="Aff2"><label>2</label>General Surgery Department, Enyang District People&#x02019;s Hospital, Bazhong, China </aff><aff id="Aff3"><label>3</label>ICU, Bazhong District People&#x02019;s Hospital, Bazhong, China </aff></contrib-group><pub-date pub-type="epub"><day>12</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>12</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>15</volume><elocation-id>39585</elocation-id><history><date date-type="received"><day>2</day><month>1</month><year>2025</year></date><date date-type="accepted"><day>27</day><month>8</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><p id="Par1">Older patients undergoing laparoscopic radical rectal cancer surgery under general anesthesia with mechanical ventilation face an increased risk of postoperative pulmonary atelectasis due to the Trendelenburg position and pneumoperitoneum. This study aims to assess whether lung ultrasound-guided individualized positive end-expiratory pressure(PEEP) ventilation can reduce postoperative atelectasis in older patients. Forty patients aged&#x02009;&#x0003e;&#x02009;65 years scheduled for elective laparoscopic radical rectal cancer surgery were randomly assigned to two groups: the ultrasound-guided group (Group P) received individualized PEEP titrated by lung ultrasound, and the control group (Group C) maintained a fixed PEEP of 5 cmH<sub>2</sub>O. PEEP was maintained until extubation in both groups. Post-extubation, lung ultrasound assessed 12 regions in both lungs. Ultrasound-guided individualized PEEP values varied significantly between individuals [median (IQR): 11 (7-11.75) ]. Compared with the PEEP with a fixed 5 cmH<sub>2</sub>O, the incidence of postoperative pulmonary atelectasis (postoperative day 1: 0 vs. 25%; <italic>P</italic>&#x02009;=&#x02009;0.047) and severity [lung ultrasound score (LUS):8.5 (6-9.75) vs. 12.5 (10-13.75); <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001)] were lower in the patients undergoing the lung ultrasound PEEP titration strategy. Meanwhile, the intraoperative drive pressure(&#x00394;P) (6.5&#x02009;&#x000b1;&#x02009;2.8 vs. 10.4&#x02009;&#x000b1;&#x02009;5.8; <italic>P</italic>&#x02009;=&#x02009;0.01) and the incidence of postoperative pulmonary complications(PPCs) (5% vs. 35%; <italic>P</italic>&#x02009;=&#x02009;0.044) were lower in the ultrasound-guided group, and intraoperative oxygenation index(OI) (461.5&#x02009;&#x000b1;&#x02009;39.5 vs. 415.7&#x02009;&#x000b1;&#x02009;69.1; <italic>P</italic>&#x02009;=&#x02009;0.014) and dynamic compliance(Cdyn) (36.4&#x02009;&#x000b1;&#x02009;8.2 vs. 25.8&#x02009;&#x000b1;&#x02009;8.9; <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001) were elevated. The perioperative hemodynamic characteristics were comparable between the two groups. Lung ultrasound-guided individualized PEEP decreased the incidence and severity of postoperative atelectasis in older patients undergoing laparoscopic rectal cancer surgery. This strategy improved intraoperative respiratory mechanics (Cdyn, &#x00394;P, OI) and reduced PPCs without hemodynamic compromise.</p><p><italic>Trial registration</italic> This clinical trial was registered at the Chinese Clinical Trial Registry (Registration No.:ChiCTR2300078385, 07/12/2023, <ext-link ext-link-type="uri" xlink:href="http://www.chictr.org.cn">www.chictr.org.cn</ext-link>).</p></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Lung ultrasound</kwd><kwd>Individualized PEEP</kwd><kwd>Optimal PEEP</kwd><kwd>Pulmonary atelectasis</kwd><kwd>Laparoscopic surgery: older patients</kwd></kwd-group><kwd-group kwd-group-type="npg-subject"><title>Subject terms</title><kwd>Preclinical research</kwd><kwd>Ultrasonography</kwd></kwd-group><funding-group><award-group><funding-source><institution>Sichuan Health Care Commission Fund Project</institution></funding-source><award-id>17PJ215</award-id><award-id>17PJ215</award-id><award-id>17PJ215</award-id><award-id>17PJ215</award-id><award-id>17PJ215</award-id><principal-award-recipient><name><surname>Feng</surname><given-names>Duan</given-names></name><name><surname>Wu</surname><given-names>Zhiqiang</given-names></name><name><surname>Li</surname><given-names>Xuechao</given-names></name><name><surname>Wan</surname><given-names>Jixiang</given-names></name><name><surname>Wang</surname><given-names>Fangjun</given-names></name></principal-award-recipient></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer Nature Limited 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par29">Patients receiving mechanical ventilation under general anesthesia frequently develop perioperative atelectasis<sup><xref ref-type="bibr" rid="CR1">1</xref></sup>. Following anesthesia induction, diaphragmatic relaxation and cephalad displacement lead to maximally elevated pleural pressure in lung-dependent regions<sup><xref ref-type="bibr" rid="CR2">2</xref></sup>. With 100% oxygen ventilation, 90% of anesthetized patients develop absorption atelectasis. Even at an oxygen concentration of 40%,the incidence of postoperative atelectasis reaches 57% in laparoscopic surgeries<sup><xref ref-type="bibr" rid="CR3">3</xref></sup>. Older patients suffer from more severe postoperative atelectasis, which impairs gas exchange and oxygenation<sup><xref ref-type="bibr" rid="CR4">4</xref></sup>.Furthermore, pneumoperitoneum and Trendelenburg positioning during laparoscopic procedures increase intra-abdominal pressure and reduce functional residual capacity, exacerbating compression atelectasis and respiratory dysfunction. These factors collectively prolong hospital stays and increase pulmonary complication rates<sup><xref ref-type="bibr" rid="CR5">5</xref>,<xref ref-type="bibr" rid="CR6">6</xref></sup>.</p><p id="Par30">Protective ventilation strategies, widely used in critical care and general anesthesia, rely on PEEP as a key component to improve perioperative ventilation and oxygenation<sup><xref ref-type="bibr" rid="CR7">7</xref></sup>. However, optimizing PEEP to prevent atelectasis while avoiding hyperinflation remains challenging. While studies suggest individualized PEEP titration using &#x00394;P, lung compliance, or electrical impedance tomography(EIT) may be beneficial<sup><xref ref-type="bibr" rid="CR8">8</xref>,<xref ref-type="bibr" rid="CR9">9</xref></sup> these methods face limitations due to imprecise data or equipment complexity.</p><p id="Par31">In recent years, lung ultrasound has been widely adopted for assessing PPCs and monitoring ventilation changes during mechanical ventilation under general anesthesia. Its advantages in detecting perioperative atelectasis, guiding individualized PEEP titration, and improving intraoperative pulmonary ventilation have become increasingly evident<sup><xref ref-type="bibr" rid="CR10">10</xref>&#x02013;<xref ref-type="bibr" rid="CR12">12</xref></sup>. For diagnosing pulmonary pathologies, lung ultrasound demonstrates superior accuracy compared to chest X-rays and comparable performance to CT scans<sup><xref ref-type="bibr" rid="CR13">13</xref></sup>.</p><p id="Par32">Current evidence remains inconclusive regarding the impact of lung ultrasound-guided individualized PEEP on postoperative atelectasis in older patients undergoing laparoscopic radical resection for rectal cancer. This study aims to optimize intraoperative respiratory mechanics and reduce both the incidence and severity of postoperative atelectasis through lung ultrasound-guided PEEP titration in this older patients.</p></sec><sec id="Sec2"><title>Methods</title><p id="Par33">This randomized controlled trial, approved by the Ethics Committee of the Affiliated Hospital of North Sichuan Medical College (Approval No. 2023ER282-1), was conducted at the Affiliated Hospital of North Sichuan Medical College. The study enrolled its first participant on July 21, 2023, and was retrospectively registered with the Chinese Clinical Trial Registry (Registration No: ChiCTR2300078385, 07/12/2023, ). Written informed consent was obtained from all participants, and all study procedures were performed in strict accordance with the Consolidated Standards of Reporting Trials (CONSORT) guidelines.</p><sec id="Sec3"><title>Grouping and treatment</title><p id="Par34">This randomized controlled single-blind trial employed computer-generated randomization (1:1 allocation ratio) to assign patients to either Ultrasound-guided individualized PEEP (Group P) or Fixed PEEP (Group C).Independent staff prepared sequentially numbered, sealed opaque envelopes containing group assignments. Upon operating room admission, patients were randomly assigned through envelope selection. PEEP titration and anesthesia management were conducted by the attending anesthesiologist, while ultrasound evaluators, follow-up physicians, and data analysts were blinded to group assignment.</p></sec><sec id="Sec4"><title>Patients</title><p id="Par36">A total of 40 older patients aged&#x02009;&#x0003e;&#x02009;65 years with a Body mass index(BMI) between 18 and 24&#x000a0;kg/m<sup>2</sup>, ASA grades II&#x02013;III, and scheduled for laparoscopic radical rectal cancer surgery were included in this study. Exclusion criteria were: chest deformity, pneumothorax, massive pleural effusion, acute lung infection, chronic obstructive pulmonary disease, asthma, severe hepatic and renal dysfunction, cardiovascular and cerebral vascular diseases, anemia, and patients who underwent a second postoperative surgery.</p></sec><sec id="Sec5"><title>Anesthesia</title><p id="Par37">After entering the operating room, the patient&#x02019;s vital signs&#x02014;oxygen saturation (SpO<sub>2</sub>), mean arterial pressure (MAP), heart rate (HR), and three-lead electrocardiography (ECG)&#x02014;were continuously monitored. A radial artery was cannulated under local anesthesia (2% lidocaine, 1&#x000a0;ml) to allow for invasive blood pressure monitoring and blood gas analysis. Following pre-oxygenation, the patient received sequential intravenous injections of midazolam 0.02&#x000a0;mg/kg, sufentanil 0.3&#x02013;0.5 ug/kg, etomidate 0.2&#x02013;0.4&#x000a0;mg/kg, and cisatracurium 0.15&#x000a0;mg/kg for anesthesia induction. Tracheal intubation was then performed under visual laryngoscopy, and mechanical ventilation was initiated with tidal volume (VT) 6&#x02013;8 mL/kg, oxygen concentration (FiO<sub>2</sub>) 50%, respiratory rate (RR) 12 breaths/min, inspiratory-expiratory ratio (I: E) 1:2, and end-inspiratory pause 20%. Intraoperative end-tidal carbon dioxide pressure (PETCO<sub>2</sub>) was maintained at 35&#x02013;45 mmHg. Intraoperative anesthesia was maintained using a combination of intravenous and inhalational agents, with drug dosages adjusted based on hemodynamic changes. After pneumoperitoneum was initiated, the patient was placed in a 45&#x000b0; head-down-foot-up position (Trendelenburg position), which was maintained until the end of surgery. Muscle relaxants were discontinued 40&#x000a0;min before the end of surgery, and sevoflurane was stopped 10&#x000a0;min prior, with an additional 10 ug of sufentanil administered intravenously. At the conclusion of the operation, the endotracheal tube was removed once the patient showed signs of awakening, and an intravenous analgesic pump was connected. The patient was then transferred to the post-anesthesia care unit (PACU), where oxygen was administered via a face mask, and vital signs were continuously monitored.</p></sec><sec id="Sec6"><title>Intervention</title><p id="Par38">In group C, PEEP was set at 5 cmH<sub>2</sub>O after intubation and applied until extubation. Patients in Group P were initiated on a PEEP of 5 cmH<sub>2</sub>O following endotracheal intubation. Five minutes after the establishment of pneumoperitoneum, lung ultrasound scanning was performed, and PEEP was subsequently adjusted. If the LUS in any region was &#x02265;&#x02009;2, PEEP was increased by 2 cmH<sub>2</sub>O. Lung ultrasound examination was repeated 5&#x000a0;min after each PEEP adjustment. This process continued until no significant atelectasis was detected (defined as LUS&#x02009;&#x0003c;&#x02009;2 in either regions), at which point the prevailing PEEP level was recorded as the individualized PEEP. If no significant lung collapse was detected upon initiation of PEEP titration, the individualized PEEP was considered to be 5 cmH<sub>2</sub>O. The maximum permissible PEEP was 15 cmH<sub>2</sub>O. Titration was terminated if any of the following occurred during the procedure: Hypoxemia (SpO<sub>2</sub>&#x02009;&#x02264;&#x02009;92%, or an absolute intraoperative decrease in SpO<sub>2</sub>&#x02009;&#x0003e;&#x02009;5%); Hypotension (MAP decreased&#x02009;&#x0003e;&#x02009;20% compared to the preoperative baseline value, persisting for &#x0003e;&#x02009;3&#x000a0;min, with poor responsiveness to fluid resuscitation or vasoactive agents); Peak airway pressure exceeding 40 cmH<sub>2</sub>O; Development of life-threatening severe ventilation or surgery-related complications (e.g., pneumothorax, severe subcutaneous emphysema).</p></sec><sec id="Sec7"><title>Measurements</title><p id="Par39">Lung ultrasound examinations were performed twice for each patient: 5&#x000a0;min before endotracheal intubation and 15&#x000a0;min after extubation. All ultrasound scans were conducted by the same anesthesiologist, who was blinded to group allocation and trained in adult lung ultrasonography.</p><p id="Par40">The assessor divided each side of the thorax into 6 regions using 3 longitudinal (parasternal, anterior and posterior axillary) and 2 transverse (above the diaphragm, 1&#x000a0;cm below the nipple) lines. The 12 lung regions were scanned sequentially from right to left, head to tail, and front to back. Each region was evaluated with a two-dimensional view of the probe placed parallel to the ribs. Each region was scored between 0 and 3 based on ultrasound scoring of lung solidity and ventilation. (0) fewer than 3 isolated B-lines; (1) multiple well-defined B-lines, &#x02265;&#x02009;3; (2)Multiple coalescent B-lines with thickened or fragmented pleural line, and small subpleural consolidations; (3) &#x0201c;White lung&#x0201d; pattern or large subpleural consolidations<sup><xref ref-type="bibr" rid="CR14">14</xref></sup>. Atelectasis was defined as LUS&#x02009;&#x02265;&#x02009;2 in any region<sup><xref ref-type="bibr" rid="CR14">14</xref>,<xref ref-type="bibr" rid="CR15">15</xref></sup>. The sum of the ultrasound scores from all 12 lung regions was calculated as the final LUS. A higher score indicated more severe impairment in ventilation<sup><xref ref-type="bibr" rid="CR16">16</xref></sup> (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>).</p><p>
<fig id="Fig1"><label>Fig. 1</label><caption><p>LUS is assessed by subpleural solidity, B-lines, and pleural line changes. (A) LUS&#x02009;=&#x02009;0, normal pleural lines with &#x0003c;&#x02009;3 B-lines; (B) LUS&#x02009;=&#x02009;1, &#x02265;&#x02009;3 B-lines; (C) LUS&#x02009;=&#x02009;2, presence of consolidated B-lines, thickening or breakage of pleural lines; (D) LUS&#x02009;=&#x02009;3, subpleural solidity or pulmonary solidity.</p></caption><graphic xlink:href="41598_2025_17862_Fig1_HTML" id="d33e508"/></fig>
</p></sec><sec id="Sec100"><title>Outcomes</title><p id="Par41">The primary outcome was post extubation LUS. Secondary outcomes included respiratory mechanics parameters: peak pressure (P<sub>peak</sub>), platform pressure (P<sub>plat</sub>), Cdyn, and &#x00394;P; hemodynamic parameters: HR, MAP, incidence of intraoperative hypotension, and rate of vasoactive drug use; intraoperative blood gas parameters: OI, PH, PaCO<sub>2</sub>, HCO<sup>3&#x02212;</sup>; and 3-day postoperative PPCs<sup><xref ref-type="bibr" rid="CR17">17</xref></sup>. The secondary outcomes were measured at the following times: T<sub>0</sub>(at admission), T<sub>1</sub>(5&#x000a0;min after intubation), T<sub>2</sub>(30&#x000a0;min after pneumoperitoneum), T<sub>3</sub>(60&#x000a0;min after pneumoperitoneum), T<sub>4</sub>(at the end of pneumoperitoneum and before extubation), and T<sub>5</sub> (15&#x000a0;min after extubation). Patients were followed for 3 days postoperatively to monitor for the occurrence of PPCs. Lung ultrasound examinations were performed on the postoperative 1st and 3rd day. The diagnosis of atelectasis was based on the LUS.</p></sec><sec id="Sec102"><title>Statistical analysis</title><p id="Par42">Based on the pilot study results using LUS after extubation as the primary outcome (mean&#x02009;&#x000b1;&#x02009;SD: 6.4&#x02009;&#x000b1;&#x02009;2.72 for individualized PEEP vs. 8.6&#x02009;&#x000b1;&#x02009;1.14 for fixed PEEP), we conducted a priori sample size calculation. With a power (1-&#x003b2;) of 0.8 to avoid type II errors and a two-sided &#x003b1; level of 0.05, PASS software indicated a minimum requirement of 32 patients (16 per group). Accounting for a 20% dropout rate, we planned to enroll 40 patients (20 per group).</p><p id="Par43">Statistical analysis was performed using SPSS 26.0. Normally distributed measures were expressed as the mean (standard deviation), two independent samples t-test was used for comparison between groups, and repeated measures analysis of variance (ANOVA) was used for comparison of multiple time points. Non-normally distributed measures were expressed as median (M) and interquartile range (IQR), and the Mann-Whitney U rank sum test was used. Count data were expressed as frequency (%), and comparisons were made using the chi-square test. The continuous corrected chi-square test was used when the minimum expected number (T) was &#x0003e;&#x02009;5, and the Fisher exact test was used when T&#x02009;&#x0003c;&#x02009;5. For correlations between two variables, the Pearson correlation test was used. Failure to conform to a bivariate normal distribution was tested using the Spearman test. <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05 was considered statistically significant.</p></sec></sec><sec id="Sec10"><title>Results</title><p id="Par44">Among 45 screened patients, three patient met exclusion criteria and two patients declined participation, and then 40 patients were randomly divided into two groups. All received protocol-compliant ventilation and were included in final analysis(Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>).</p><p>
<fig id="Fig2"><label>Fig. 2</label><caption><p>Flowchart of enrolment and outcomes.</p></caption><graphic xlink:href="41598_2025_17862_Fig2_HTML" id="d33e563"/></fig>
</p><sec id="Sec11"><title>Baseline features</title><p id="Par45">A total of 40 patients were included in this study. There was no difference in gender, age, BMI, ASA classification, percentage of smoking, or prevalence of hypertension between the two groups (<italic>P</italic>&#x02009;&#x0003e;&#x02009;0.05). The intraoperative mechanical ventilation time, pneumoperitoneum time, pneumoperitoneum pressure, Trendelenburg position time, fluid infusion, blood loss, operative time, and urine output in the two groups were comparable (<italic>P</italic>&#x02009;&#x0003e;&#x02009;0.05), (shown in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>).</p><p id="Par46">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Baseline patient characteristics. Entries are the mean (SD) or numbers (%).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Characteristic</th><th align="left">Group P(<italic>n</italic>&#x02009;=&#x02009;20)</th><th align="left">Group C(<italic>n</italic>&#x02009;=&#x02009;20)</th><th align="left"><italic>P</italic>-value</th></tr></thead><tbody><tr><td align="left">Age (yr)</td><td align="left">71.45(4.5)</td><td align="left">71.25(5.4)</td><td align="left">0.899</td></tr><tr><td align="left">Male [n (%)]</td><td align="left">11(55)</td><td align="left">9(45)</td><td align="left">0.752</td></tr><tr><td align="left">BMI( kg/m<sup>2</sup>)</td><td align="left">23.34(2.6)</td><td align="left">22.75(2.9)</td><td align="left">0.498</td></tr><tr><td align="left">ASA II/III(n)</td><td align="left">8/12</td><td align="left">7/13</td><td align="left">0.752</td></tr><tr><td align="left">Smoking status [n (%)]</td><td align="left">3(15)</td><td align="left">4(20)</td><td align="left">1.0</td></tr><tr><td align="left">Hypertension[n (%)]</td><td align="left">6(30)</td><td align="left">9(45)</td><td align="left">0.327</td></tr><tr><td align="left">Operative time (min)</td><td align="left">184.6(42.7)</td><td align="left">195.2(38.9)</td><td align="left">0.417</td></tr><tr><td align="left">Mechanical ventilation time (min)</td><td align="left">243.5(43)</td><td align="left">254.8(42.3)</td><td align="left">0.409</td></tr><tr><td align="left">Pneumoperitoneum time (min)</td><td align="left">158.5(41.7)</td><td align="left">175(38.9)</td><td align="left">0.204</td></tr><tr><td align="left">Trendelenburg position time (min)</td><td align="left">138.5(38)</td><td align="left">159.4(38.1)</td><td align="left">0.09</td></tr><tr><td align="left">Pneumoperitoneum pressure(mmHg)</td><td align="left">12.5(0.76)</td><td align="left">12.7(0.92)</td><td align="left">0.459</td></tr><tr><td align="left">Blood loss(ml)</td><td align="left">114.5(122.7)</td><td align="left">93(108.9)</td><td align="left">0.57</td></tr><tr><td align="left">Urine output(ml)</td><td align="left">400(234)</td><td align="left">520(327)</td><td align="left">0.19</td></tr><tr><td align="left">fluid infusion(ml)</td><td align="left">*</td><td align="left">*</td><td align="left">*</td></tr><tr><td align="left">Crystalline fluids(ml)</td><td align="left">1445(250)</td><td align="left">1465(357.3)</td><td align="left">0.839</td></tr><tr><td align="left">Colloidal fluids(ml)</td><td align="left">470(141.8)</td><td align="left">475(200)</td><td align="left">0.928</td></tr></tbody></table><table-wrap-foot><p>BMI: Body Mass Index; ASA: American Society of Anesthesiologists; Group P: the ultrasound-guided group; Group C: the control group;</p></table-wrap-foot></table-wrap>
</p></sec><sec id="Sec12"><title>LUS</title><p id="Par47">There was no significant difference in the LUS before intubation between group P [2 (1.25-3)] and group C: [2 (2&#x02013;3)] ( <italic>P</italic>&#x02009;=&#x02009;0.471), (Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>). Compared with Group C, Group P demonstrated significantly lower total LUS after extubation (median difference &#x02212;&#x02009;4; 95% CI: &#x02013; 5&#x02013;-2; <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001). Significant reductions were also observed in specific regions: Left posterior upper (median difference &#x02212;&#x02009;1; 95% CI: &#x02013; 2&#x02013;0; <italic>P</italic>&#x02009;=&#x02009;0.003); Right anterior lower (median difference 0; 95% CI: &#x02013; 2&#x02013;0; <italic>P</italic>&#x02009;=&#x02009;0.038); Right lateral upper (median difference &#x02212;&#x02009;1;95% CI: -1&#x02013;0; <italic>P</italic>&#x02009;=&#x02009;0.006); Right lateral lower (median difference &#x02212;&#x02009;1; 95% CI: -1&#x02013;-1; <italic>P</italic>&#x02009;=&#x02009;0.001).No significant intergroup differences were found in other lung regions ( <italic>P</italic>&#x02009;&#x0003e;&#x02009;0.05), (shown in Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>).</p><p>
<fig id="Fig3"><label>Fig. 3</label><caption><p>Histogram comparing the LUS of the two groups [score, M (IOR)].**** represents <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.0001.</p></caption><graphic xlink:href="41598_2025_17862_Fig3_HTML" id="d33e807"/></fig>
</p><p id="Par48">
<table-wrap id="Tab2"><label>Table 2</label><caption><p>Comparison of LUS after extubation. Entries are the M (IOR),</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Regional LUS</th><th align="left">Group P(<italic>n</italic>&#x02009;=&#x02009;20)</th><th align="left">Group C(<italic>n</italic>&#x02009;=&#x02009;20)</th></tr></thead><tbody><tr><td align="left"><p>Total</p><p>Left front upper</p><p>Left front lower</p><p>Left outer upper</p><p>Left Outer lower</p><p>Left rear upper</p><p>Left rear lower</p><p>Right front upper</p><p>Right front lower</p><p>Right outer upper</p><p>Right outer lower</p><p>Right rear upper</p><p>Right rear lower</p></td><td align="left"><p>8.5(6-9.75)<sup>a</sup></p><p>0</p><p>0</p><p>0</p><p>1(0-1.75)</p><p>0.5(0&#x02013;1)<sup>a</sup></p><p>2(2&#x02013;2)</p><p>0</p><p>0 <sup>a</sup></p><p>0 <sup>a</sup></p><p>0(0&#x02013;1)<sup>a</sup></p><p>1(0&#x02013;2)</p><p>2(1&#x02013;2)</p></td><td align="left"><p>12.5(10-13.75)</p><p>0</p><p>0(0&#x02013;1)</p><p>0(0&#x02013;1)</p><p>1(0.25-1)</p><p>2(1&#x02013;2)</p><p>2(2&#x02013;2)</p><p>0</p><p>1(0&#x02013;2)</p><p>1(0&#x02013;1)</p><p>1(1&#x02013;2)</p><p>2(1&#x02013;2)</p><p>2(2&#x02013;2)</p></td></tr></tbody></table><table-wrap-foot><p>LUS: lung ultrasound score; Group P: the ultrasound-guided group; Group C: the control group; <sup>a</sup>
<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05 vs Group C.</p></table-wrap-foot></table-wrap>
</p><p id="Par49">Compared with Group C, Group P exhibited significantly lower post-extubation LUS across all pulmonary regions: Anterior: median difference &#x02212;&#x02009;2 (95% CI: -2&#x02013; 0; <italic>P</italic>&#x02009;=&#x02009;0.005) ;Lateral: median difference &#x02212;&#x02009;2 (95% CI: &#x02013; 2&#x02013; &#x02013; 1; <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001) ;Posterior: median difference &#x02212;&#x02009;2 (95% CI: &#x02013; 3&#x02013; &#x02013; 1; <italic>P</italic>&#x02009;=&#x02009;0.001) ;Superior: median difference &#x02212;&#x02009;2 (95% CI: &#x02013; 3&#x02013; -1; <italic>P&#x02009;&#x0003c;</italic>&#x02009;0.001) ;Inferior: median difference &#x02212;&#x02009;2 (95% CI: &#x02013; 3&#x02013; -1; <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001) ;Left: median difference &#x02212;&#x02009;2 (95% CI: &#x02013; 3&#x02013; &#x02013; 1; <italic>P</italic>&#x02009;=&#x02009;0.001) ;Right: median difference &#x02212;&#x02009;3 (95% CI: -4&#x02013; -2; <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001). Group P had significantly higher LUS in some regions (lateral, posterior, superior, inferior, left, and right) compared to before intubation (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05), while group C had significantly higher LUS in all regions (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05). LUS was substantially higher in posterior lung regions in group P following extubation compared to anterior and lateral (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001). The inferior LUS was substantially higher than the superior LUS (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001), whereas there was no significant difference between the left and right lung LUS (<italic>P</italic>&#x02009;=&#x02009;0.769). In group C, there was no significant difference between the left and right LUS (<italic>P</italic>&#x02009;=&#x02009;0.124). However, posterior LUS was significantly higher than anterior and lateral LUS (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001), and inferior LUS was significantly higher than superior LUS (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001) (shown in Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>). For patients over the age of 65, there was no age-related increase in LUS after extubation (R<sup>2</sup>&#x02009;=&#x02009;0.04, <italic>P</italic>&#x02009;=&#x02009;0.922).</p><p id="Par50">
<table-wrap id="Tab3"><label>Table 3</label><caption><p>Comparison of LUS before intubation and after extubation. Entries are the M (IOR).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Regional LUS</th><th align="left">Group</th><th align="left">Pre-intubation</th><th align="left">Post-extubation</th></tr></thead><tbody><tr><td align="left" rowspan="2">Anterior</td><td align="left">Group P</td><td align="left">0</td><td align="left">0(0-0.75)<sup>a</sup></td></tr><tr><td align="left">Group C</td><td align="left">0</td><td align="left">2(0&#x02013;2)<sup>b</sup></td></tr><tr><td align="left" rowspan="2">Lateral</td><td align="left">Group P</td><td align="left">1(0&#x02013;2)</td><td align="left">2(1&#x02013;2)<sup>ab</sup></td></tr><tr><td align="left">Group C</td><td align="left">1(1&#x02013;2)</td><td align="left">3(2.25-4)<sup>b</sup></td></tr><tr><td align="left" rowspan="2">Posterior</td><td align="left">Group P</td><td align="left">1(1&#x02013;2)</td><td align="left">5(4&#x02013;6)<sup>ab</sup></td></tr><tr><td align="left">Group C</td><td align="left">1(0&#x02013;2)</td><td align="left">7(6&#x02013;8)<sup>b</sup></td></tr><tr><td align="left" rowspan="2">Superior</td><td align="left">Group P</td><td align="left">0(0&#x02013;1)</td><td align="left">2(1&#x02013;3)<sup>ab</sup></td></tr><tr><td align="left">Group C</td><td align="left">0</td><td align="left">4.5(3&#x02013;5)<sup>b</sup></td></tr><tr><td align="left" rowspan="2">Inferior</td><td align="left">Group P</td><td align="left">2(1&#x02013;3)</td><td align="left">5.5(4&#x02013;6)<sup>ab</sup></td></tr><tr><td align="left">Group C</td><td align="left">2(1.25-3)</td><td align="left">7(7&#x02013;8)<sup>b</sup></td></tr><tr><td align="left" rowspan="2">Left</td><td align="left">Group P</td><td align="left">1(1&#x02013;2)</td><td align="left">3(3&#x02013;4)<sup>ab</sup></td></tr><tr><td align="left">Group C</td><td align="left">1(0&#x02013;2)</td><td align="left">6(4&#x02013;7)<sup>b</sup></td></tr><tr><td align="left" rowspan="2">Right</td><td align="left">Group P</td><td align="left">1(0.25-2)</td><td align="left">3.5(2&#x02013;5)<sup>ab</sup></td></tr><tr><td align="left">Group C</td><td align="left">2(1&#x02013;2)</td><td align="left">6(5.25&#x02013;7.75)<sup>b</sup></td></tr></tbody></table><table-wrap-foot><p>LUS: lung ultrasound score; Group P: the ultrasound-guided group; Group C: the control group; <sup>a</sup>
<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05 vs. Group C, <sup>b</sup><italic>P</italic> &#x0003c; 0.05 vs. pre-intubation.</p></table-wrap-foot></table-wrap>
</p></sec><sec id="Sec13"><title>P<sub>peak</sub>, P<sub>plat</sub>, cdyn, and &#x00394;P</title><p id="Par51">Comparative analysis between Group P and Group C revealed significant differences in respiratory mechanics at various time points. Group P demonstrated significantly higher P<sub>peak</sub> values at T<sub>2</sub> (<italic>P</italic>&#x02009;=&#x02009;0.038)and T<sub>4</sub> (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001). Group P showed markedly improved Cdyn during T<sub>2</sub>&#x02013;T<sub>4</sub>, T<sub>2</sub>: mean difference 7.54 (95% CI: 2.5&#x02013;12.57; <italic>P</italic>&#x02009;=&#x02009;0.004); T<sub>3</sub>: mean difference 10.57 (95% CI: 5.1&#x02013;16.04; <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001); T<sub>4</sub>: mean difference 6.8 (95% CI: 0.27&#x02013;13.32; <italic>P</italic>&#x02009;=&#x02009;0.042).Significant reductions in &#x00394;P were observed in Group P at T<sub>2</sub>: mean difference &#x02212;&#x02009;3.6 (95% CI: &#x02013; 6.29&#x02013; -0.9; <italic>P</italic>&#x02009;=&#x02009;0.01), T<sub>3</sub>: mean difference &#x02212;&#x02009;3.95 (95% CI: &#x02013; 6.9&#x02013; &#x02013; 1.01; <italic>P</italic>&#x02009;=&#x02009;0.01). There was no significant difference in P<sub>plat</sub> between group P and group C at T<sub>1</sub>&#x02013;T<sub>5</sub> (<italic>P</italic>&#x02009;&#x0003e;&#x02009;0.05). In comparison to T<sub>1</sub>, Cdyn declined at T<sub>2</sub>&#x02013;T<sub>3</sub> and &#x00394;P increased at T<sub>2</sub>&#x02013;T<sub>3</sub> in group P, while Cdyn decreased at T<sub>2</sub>&#x02013;T<sub>4</sub> and &#x00394;P increased at T<sub>2</sub>&#x02013;T<sub>4</sub> in group C (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05).(shown in Table&#x000a0;<xref rid="Tab4" ref-type="table">4</xref>).</p><p id="Par52">
<table-wrap id="Tab4"><label>Table 4</label><caption><p>Comparison of ventilation indices at different time points. Entries are the mean (SD).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Parameter</th><th align="left">Group</th><th align="left">T<sub>1</sub></th><th align="left">T<sub>2</sub></th><th align="left">T<sub>3</sub></th><th align="left">T<sub>4</sub></th></tr></thead><tbody><tr><td align="left" rowspan="2">P<sub>peak</sub>(cmH<sub>2</sub>O)</td><td align="left">Group P</td><td align="left">14.5(1.4)</td><td align="left">25.5(2.2)<sup>a</sup></td><td align="left">25.1(2.5)</td><td align="left">21.6(2.3)<sup>a</sup></td></tr><tr><td align="left">Group C</td><td align="left">15.4(1.5)</td><td align="left">23.4(3.6)</td><td align="left">24.1(3.6)</td><td align="left">17.2(2.1)</td></tr><tr><td align="left" rowspan="2">P<sub>plat</sub>(cmH<sub>2</sub>O)</td><td align="left">Group P</td><td align="left">8.8(2.1)</td><td align="left">17.1(2.3)</td><td align="left">17.2(2.1)</td><td align="left">11.7(2.3)</td></tr><tr><td align="left">Group C</td><td align="left">9.9(2.3)</td><td align="left">14.5(5.7)</td><td align="left">15.1(5.8)</td><td align="left">10.9(3.0)</td></tr><tr><td align="left" rowspan="2">Cdyn(ml/cmH<sub>2</sub>O)</td><td align="left">Group P</td><td align="left">46.7(11.1)</td><td align="left">33.9(5.8)<sup>ab</sup></td><td align="left">36.4(8.2)<sup>ab</sup></td><td align="left">45.0(10.1)<sup>a</sup></td></tr><tr><td align="left">Group C</td><td align="left">44.7(13.2)</td><td align="left">26.4(9.5)<sup>b</sup></td><td align="left">25.8(8.9)<sup>b</sup></td><td align="left">38.3(10.3)<sup>b</sup></td></tr><tr><td align="left" rowspan="2">&#x00394;P(cmH<sub>2</sub>O)</td><td align="left">Group P</td><td align="left">4.3(1.9)</td><td align="left">6.4(2.6)<sup>ab</sup></td><td align="left">6.5(2.8)<sup>ab</sup></td><td align="left">4.6(2.0)</td></tr><tr><td align="left">Group C</td><td align="left">5.0(2.4)</td><td align="left">10(5.3)<sup>b</sup></td><td align="left">10.4(5.8)<sup>b</sup></td><td align="left">6.1(2.9)<sup>b</sup></td></tr></tbody></table><table-wrap-foot><p>P<sub>peak</sub>: peak pressure; P<sub>plat</sub>: platform pressure; Cdyn: intraoperative dynamic compliance; &#x00394;P: driving pressure; Group P: the ultrasound-guided group; Group C: the control group; <sup>a</sup>
<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05 vs. Group C, <sup>b</sup><italic>P</italic> &#x0003c; 0.05 vs. T<sub>1</sub>.</p></table-wrap-foot></table-wrap>
</p></sec><sec id="Sec14"><title>OI, PH, PaCO<sub>2</sub> and HCO&#x000b3;</title><p id="Par53">Compared with group C, the OI was significantly higher in group P at T<sub>3</sub>&#x02013;T<sub>5</sub> (<italic>P</italic>&#x02009;=&#x02009;0.014, <italic>P</italic>&#x02009;=&#x02009;0.001, <italic>P</italic>&#x02009;=&#x02009;0.001, respectively ), and PH, PaCO<sub>2</sub>, and HCO<sup>3&#x02212;</sup> were not significantly different between the two groups at T<sub>0</sub>&#x02013;T<sub>5</sub> (<italic>P</italic>&#x02009;&#x0003e;&#x02009;0.05), (shown in Table&#x000a0;<xref rid="Tab5" ref-type="table">5</xref>).</p><p id="Par54">
<table-wrap id="Tab5"><label>Table 5</label><caption><p>Comparison of blood gas indices at different time points. Entries are the mean (SD).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Indexes</th><th align="left">Group</th><th align="left">T<sub>0</sub></th><th align="left">T<sub>1</sub></th><th align="left">T<sub>2</sub></th><th align="left">T<sub>3</sub></th><th align="left">T<sub>4</sub></th><th align="left">T<sub>5</sub></th></tr></thead><tbody><tr><td align="left" rowspan="2">OI</td><td align="left">Group P</td><td align="left">313.4(29.3)</td><td align="left">417.3(51)</td><td align="left">457.2(45.2)</td><td align="left">453.3(48.1)<sup>a</sup></td><td align="left">437.5(63.5)<sup>a</sup></td><td align="left">365.7(40.8)<sup>a</sup></td></tr><tr><td align="left">Group C</td><td align="left">324(33.1)</td><td align="left">403.1(77.1)</td><td align="left">438.9(50)</td><td align="left">417.2(70.4)</td><td align="left">401.6(58.1)</td><td align="left">335.2(39)</td></tr><tr><td align="left" rowspan="2">PH</td><td align="left">Group P</td><td align="left">7.37(0.03)</td><td align="left">7.34(0.05)</td><td align="left">7.27(0.06)</td><td align="left">7.27(0.06)</td><td align="left">7.31(0.05)</td><td align="left">7.33(0.04)</td></tr><tr><td align="left">Group C</td><td align="left">7.39(0.03)</td><td align="left">7.36(0.04)</td><td align="left">7.3(0.04)</td><td align="left">7.29(0.04)</td><td align="left">7.31(0.05)</td><td align="left">7.33(0.05)</td></tr><tr><td align="left" rowspan="2">PaCO<sub>2</sub></td><td align="left">Group P</td><td align="left">38.2(3.0)</td><td align="left">37.2(4.1)</td><td align="left">46.1(6.3)</td><td align="left">47.8(6.0)</td><td align="left">42.8(6.4)</td><td align="left">42.4(4.5)</td></tr><tr><td align="left">Group C</td><td align="left">38.4(2.0)</td><td align="left">36.5(4.3)</td><td align="left">44.8(6.1)</td><td align="left">45.8(6.4)</td><td align="left">42.0(6.3)</td><td align="left">42.1(4.5)</td></tr><tr><td align="left" rowspan="2">HCO<sub>3-</sub></td><td align="left">Group P</td><td align="left">22.6(2.2)</td><td align="left">21.8(1.9)</td><td align="left">21.2(2.0)</td><td align="left">21.1(1.2)</td><td align="left">21.7(2.4)</td><td align="left">22(2.0)</td></tr><tr><td align="left">Group C</td><td align="left">23.5(1.6)</td><td align="left">22.3(1.8)</td><td align="left">21.8(1.9)</td><td align="left">21.2(1.5)</td><td align="left">20.8(1.9)</td><td align="left">22.5(2.5)</td></tr></tbody></table><table-wrap-foot><p>OI: perioperative oxygenation index; Group P: the ultrasound-guided group; Group C: the control group; <sup>a</sup>
<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05 vs. Group C.</p></table-wrap-foot></table-wrap>
</p></sec><sec id="Sec15"><title>Perioperative hemodynamics</title><p id="Par55">There was no significant difference in MAP and HR at T<sub>0</sub>&#x02013;T<sub>5</sub> between group P and group C (Figs.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref> and <xref rid="Fig5" ref-type="fig">5</xref>), nor was there a significant difference in the use of intraoperative vasoactive drugs or the occurrence of hypotension between the two groups (<italic>P</italic>&#x02009;&#x0003e;&#x02009;0.05).</p><p>
<fig id="Fig4"><label>Fig. 4</label><caption><p>Line diagram of MAP. Points represent means and whiskers 95% confidence intervals from the data at that given time point.</p></caption><graphic xlink:href="41598_2025_17862_Fig4_HTML" id="d33e1674"/></fig>
</p><p id="Par73">
<fig id="Fig5"><label>Fig. 5</label><caption><p>Line diagram of HR. Points represent means and whiskers 95% confidence intervals from the data at that given time point.</p></caption><graphic xlink:href="41598_2025_17862_Fig5_HTML" id="d33e1684"/></fig>
</p></sec><sec id="Sec16"><title>PPCs and lung atelectasis</title><p id="Par56">The incidence of PPCs on the third day after surgery was significantly lower in group P than in group C (5%; 95% CI: 0.001&#x02013;0.249 vs. 35%; 95%CL: 0.154&#x02013;0.592; <italic>P</italic>&#x02009;=&#x02009;0.044). Only one patient suffered from hypoxemia in Group P. In group C, five patients were found to have pulmonary atelectasis (detected by lung ultrasound), and the other two cases of PPCs exhibited hypoxemia. The symptoms of hypoxia were all improved after oxygenation. On the first day after surgery, the incidence of pulmonary atelectasis was less in group P than in group C(0; 95% CI: 0&#x02013;0.168 vs. 25%; 95%CL: 0.087&#x02013;0.49; <italic>P</italic>&#x02009;=&#x02009;0.047). On the third day after surgery, there was no significant difference in the incidence of pulmonary atelectasis in group P compared with group C (<italic>P</italic>&#x02009;=&#x02009;0.487), (shown in Table&#x000a0;<xref rid="Tab6" ref-type="table">6</xref>). The optimal PEEP value in the individualized PEEP group was 11 (7&#x02013;11.75) cmH<sub>2</sub>O. For patients over 65 years old, increasing age did not correlate with an increasing PEEP value (<italic>P</italic>&#x02009;=&#x02009;0.666).</p><p id="Par57">
<table-wrap id="Tab6"><label>Table 6</label><caption><p>PPCs and postoperative pulmonary atelectasis.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Parameter</th><th align="left">Time</th><th align="left">Group <italic>P</italic></th><th align="left">Group C</th><th align="left"><italic>P</italic>-value</th></tr></thead><tbody><tr><td align="left">PPCs[n (%)]</td><td align="left">3d</td><td align="left">1(5%)<sup>a</sup></td><td align="left">7(35%)</td><td char="." align="char">0.044</td></tr><tr><td align="left"><p>pulmonary atelectasis</p><p>[n (%)]</p></td><td align="left"><p>1d</p><p>3d</p></td><td align="left"><p>0 <sup>a</sup></p><p>0</p></td><td align="left"><p>5(25%)</p><p>2(10%)</p></td><td char="." align="char"><p>0.047</p><p>0.487</p></td></tr></tbody></table><table-wrap-foot><p>PPCs: postoperative pulmonary complications; Group C: the control group; <sup>a</sup>
<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05 vs. Group C.</p></table-wrap-foot></table-wrap>
</p></sec></sec><sec id="Sec17"><title>Discussion</title><p id="Par58">This study demonstrates that lung ultrasound-guided individualized PEEP improves postoperative atelectasis, enhances perioperative Cdyn and OI, reduces intraoperative &#x00394;P and the incidence of PPCs, while maintaining hemodynamic stability.</p><p id="Par59">Most surgical patients receiving mechanical ventilation develop postoperative atelectasis, which reduces lung compliance, impairs oxygenation, and increases pulmonary vascular resistance<sup><xref ref-type="bibr" rid="CR2">2</xref>,<xref ref-type="bibr" rid="CR18">18</xref></sup>. Individualized PEEP has been proposed for mechanically ventilated patients under general anesthesia<sup><xref ref-type="bibr" rid="CR19">19</xref></sup>. The quantitative relationship between LUS and atelectasis volume measured by computed tomography demonstrated high sensitivity (87.7%), specificity (92.1%), and accuracy (90.8%) in diagnosing postoperative atelectasis in anesthetized adults<sup><xref ref-type="bibr" rid="CR20">20</xref></sup>.In this study, the optimal PEEP varied substantially among individuals (7&#x02013;14 cmH&#x02082;O) and showed no correlation with age. Notably, laparoscopic surgery in the Trendelenburg position required higher individualized PEEP levels 11 (7&#x02013;11.75) cmH&#x02082;O compared to other surgical positions or open surgery, as this approach further exacerbates ventilation loss due to cephalad diaphragmatic shift<sup><xref ref-type="bibr" rid="CR21">21</xref>,<xref ref-type="bibr" rid="CR22">22</xref></sup>.</p><p id="Par60">This study demonstrated that ultrasound-guided individualized PEEP effectively reduced regional LUS in patients undergoing laparoscopic radical resection for rectal cancer, indicated its ability to recruit collapsed alveoli independently of body position and lung compliance. Heejoon Jeong et al.<sup><xref ref-type="bibr" rid="CR23">23</xref></sup> reported that under pneumoperitoneum in the Trendelenburg position, pulmonary ventilation was predominantly distributed in the basal and posterior lung regions. The combined effects of pneumoperitoneum and positioning shifted ventilation toward non-dependent lung areas, resulting in increased poorly ventilated zones in gravity-dependent regions. Our data showed a significant increase in LUS in the posterior and basal lung fields after intubation in both groups. This effect was gradually reversed with increasing PEEP in the individualized group, but in the fixed PEEP group, this effect persisted until spontaneous respiration resumed. On the first day after surgery, the incidence of atelectasis was significantly lower in the individualized PEEP group. However, this difference between groups diminished over time. Mohamed Elshazly et al.<sup><xref ref-type="bibr" rid="CR24">24</xref></sup> found no significant difference in atelectasis incidence at 24&#x000a0;h postoperatively between ultrasound-guided PEEP and fixed PEEP groups, which may be due to the limited sensitivity of chest radiography used for atelectasis detection in patients with hypoxemia. Existing evidence suggested that the benefits of individualized PEEP on end-expiratory lung volume (EELV) and alveolar recruitment disappear within 2&#x02013;6&#x000a0;h after extubation, while post-extubation atelectasis may persist for up to 24 hours<sup><xref ref-type="bibr" rid="CR25">25</xref></sup>.</p><p id="Par61">In this study, while the individualized PEEP group demonstrated higher P<sub>peak</sub> , it exhibited significantly lower &#x00394;P, which generally remained below the 12.5 H<sub>2</sub>O threshold, consequently reducing the risk of PPCs<sup><xref ref-type="bibr" rid="CR26">26</xref></sup>. A large-scale meta-analysis confirmed that PPCs were associated with high PEEP levels that induce &#x00394;P elevation<sup><xref ref-type="bibr" rid="CR27">27</xref></sup>.Hyun-Kyu Yoo et al.<sup><xref ref-type="bibr" rid="CR28">28</xref></sup> optimized PEEP settings through Cdyn titration for laparoscopic surgery in Trendelenburg position. Although higher PEEP levels [14 (12&#x02013;18) cmH<sub>2</sub>O] improved postoperative atelectasis, they failed to reduce PPCs incidence, attributable to the elevated intraoperative &#x00394;P (median: 15; IQR: 13.0&#x02013;17.5) observed in their individualized PEEP group. Our findings demonstrated that ultrasound-guided individualized PEEP effectively reduces the intraoperative &#x00394;P and incidence of PPCs, and improving Cdyn. These results were consistent with those of studies utilizing EIT or &#x00394;P-based PEEP titration strategies<sup><xref ref-type="bibr" rid="CR29">29</xref>,<xref ref-type="bibr" rid="CR30">30</xref></sup>.</p><p id="Par62">Under general anesthesia, the dispersion of ventilation/perfusion (V<sub>A</sub>/V<sub>Q</sub>) ratios and perfusion in low V<sub>A</sub>/V<sub>Q</sub> regions increases with age<sup><xref ref-type="bibr" rid="CR31">31</xref></sup>. Concurrently, atelectasis induces intrapulmonary shunting<sup><xref ref-type="bibr" rid="CR32">32</xref></sup>leading to impaired oxygenation. In present study, ultrasound-guided individualized PEEP improved alveolar recruitment across all lung regions, thereby optimizing VA/VQ matching and reducing right-to-left shunting. This explained the consistently higher OI observed in the individualized PEEP group from pneumoperitoneum initiation through extubation&#x02013;findings that parallel results documented in obese patients<sup><xref ref-type="bibr" rid="CR24">24</xref></sup>.Although elevated PEEP levels may adversely affect hemodynamics, our individualized PEEP group exhibited no significant hemodynamic fluctuations. Previous studies employing decremental PEEP titration protocols had demonstrated that high PEEP levels combined with recruitment maneuvers (RM) invariably impact hemodynamics<sup><xref ref-type="bibr" rid="CR33">33</xref>,<xref ref-type="bibr" rid="CR34">34</xref></sup>. In contrast, our incremental PEEP titration approach mitigated both hemodynamic fluctuations and pulmonary overdistension. Furthermore, during laparoscopic procedures, the combined effects of Trendelenburg positioning and pneumoperitoneum increase MAP by 35%, with MAP returning to baseline upon surgical completion<sup><xref ref-type="bibr" rid="CR35">35</xref></sup>.</p><sec id="Sec18"><title>Strengths and limitations</title><p id="Par63">This study represents the first application of lung ultrasound for PEEP optimization in older patients undergoing laparoscopic surgery. Its demonstrated efficacy, practicality, and safety suggest potential as a standardized approach for individualized PEEP titration. Our protocol included postoperative lung ultrasound assessments at 1-day and 3-day intervals, enabling evaluation of whether the beneficial effects on atelectasis persist beyond the anesthesia recovery period. However, several limitations warrant consideration: First, as a single-center randomized controlled trial with a limited sample size, the study may have been underpowered to detect significant between-group differences in 3-day atelectasis incidence. Second, post-extubation lung ultrasound scans could potentially be confounded by uncontrolled recruitment maneuvers (e.g., sighing or coughing) or patient sleep state, possibly obscuring true LUS differences. Third, the absence of intraoperative LUS measurements precludes demonstration of intraoperative alveolar recruitment effects, though studies by Gouri Mini et al. and Qi Xu et al. confirm that individualized PEEP reduces both intraoperative and post-extubation LUS<sup><xref ref-type="bibr" rid="CR30">30</xref>,<xref ref-type="bibr" rid="CR36">36</xref></sup>. Fourth, PEEP titration was performed in the supine position post-pneumoperitoneum without subsequent positional readjustment, potentially attenuating the full therapeutic effect during pneumoperitoneum. Fifth, while individualized PEEP improved LUS in posterior and inferior lung regions, it failed to reduce LUS in posteroinferior areas&#x02014;likely due to the omission of RM. Contemporary evidence confirms that individualized PEEP alone cannot adequately recruit dorsal alveoli near the diaphragm without RM<sup><xref ref-type="bibr" rid="CR37">37</xref>,<xref ref-type="bibr" rid="CR38">38</xref></sup>suggesting combined ultrasound-guided PEEP with RMs as a critical research direction. Sixth, although registered retrospectively on ClinicalTrials.gov, the study protocol received ethics approval prior to first patient enrollment and was strictly adhered to without post hoc modifications.</p></sec></sec><sec id="Sec19"><title>Conclusion</title><p id="Par64">In older patients undergoing laparoscopic rectal cancer surgery, optimal PEEP under general anesthesia showed wide interindividual variability and no correlation with age in patients&#x02009;&#x0003e;&#x02009;65 years. Ultrasound-guided individualized PEEP improved oxygenation, lung compliance, and driving pressure while decreasing the incidence of PPCs. Additionally, it decreased both the incidence and severity of postoperative atelectasis without significant hemodynamic effects.</p></sec></body><back><glossary><title>Abbreviations</title><def-list><def-item><term>PEEP</term><def><p id="Par6">Positive end-expiratory pressure ventilation</p></def></def-item><def-item><term>PPCs</term><def><p id="Par7">Postoperative pulmonary complications</p></def></def-item><def-item><term>&#x00394;P</term><def><p id="Par8">Driving pressure</p></def></def-item><def-item><term>VT</term><def><p id="Par9">Tidal volume</p></def></def-item><def-item><term>SpO<sub>2</sub></term><def><p id="Par10">Oxygen saturation</p></def></def-item><def-item><term>BMI</term><def><p id="Par11">Body mass index</p></def></def-item><def-item><term>MAP</term><def><p id="Par12">Mean arterial pressure</p></def></def-item><def-item><term>HR</term><def><p id="Par13">Heart rate</p></def></def-item><def-item><term>ECG</term><def><p id="Par14">Electrocardiography</p></def></def-item><def-item><term>P<sub>ET</sub>CO<sub>2</sub></term><def><p id="Par15">End-tidal carbon dioxide pressure</p></def></def-item><def-item><term>FiO<sub>2</sub></term><def><p id="Par16">Oxygen concentration</p></def></def-item><def-item><term>PACU</term><def><p id="Par17">Post-anesthesia care unit</p></def></def-item><def-item><term>COPD</term><def><p id="Par18">Chronic obstructive pulmonary disease</p></def></def-item><def-item><term>P<sub>plat</sub></term><def><p id="Par19">Platform pressure</p></def></def-item><def-item><term>OI</term><def><p id="Par20">Oxygenation index</p></def></def-item><def-item><term>LPLV</term><def><p id="Par21">Lung protective lung ventilation</p></def></def-item><def-item><term>Cdyn</term><def><p id="Par22">Dynamic compliance</p></def></def-item><def-item><term>LUS</term><def><p id="Par23">Lung ultrasound score</p></def></def-item><def-item><term>Cstat</term><def><p id="Par24">static compliance</p></def></def-item><def-item><term>EELV</term><def><p id="Par25">end-expiratory lung volume</p></def></def-item><def-item><term>EIT</term><def><p id="Par26">Electrical impedance tomography</p></def></def-item><def-item><term>V<sub>A</sub>/V<sub>Q</sub></term><def><p id="Par27">Alveolar ventilation/ ventilation-perfusion</p></def></def-item><def-item><term>RM</term><def><p id="Par28">Recruitment maneuvers</p></def></def-item></def-list></glossary><fn-group><fn><p><bold>Publisher&#x02019;s note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn><fn><p>Duan Feng and Yu Zhao contributed equally to this work.</p></fn></fn-group><ack><title>Acknowledgements</title><p>The authors would like to thank all the authors and institutions involved in this study for their contributions to this paper.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>F, Xuechao Li, Z, Fangjun Wang . Responsible for and completes study design. F . Responsible for Patient recruitment.Z . Wei Li : Data collection.Wei Li, Jixiang Wan . Data analysis.Xuechao Li, Jixiang Wan . Supervision.Jixiang Wan, Fangjun Wang . Validation.F . Completion of the original draft.Fangjun Wang . final Verification and Revision.All authors reviewed the manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>Sichuan Health Care Commission Fund Project(17PJ215) .</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>The datasets generated and/or analyzed during the current study are not publicly available but are available from the corresponding author upon reasonable request.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par75">The study was carried out as a randomized controlled trial at the Affiliated Hospital of North Sichuan Medical College after receiving approval from the Hospital Ethics Committee (Ethics No. 2023ER282-1).</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests</title><p id="Par77">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Massard</surname><given-names>G</given-names></name><name><surname>Wihlm</surname><given-names>JM</given-names></name></person-group><article-title>Postoperative atelectasis</article-title><source>Chest Surg. Clin. N Am.</source><year>1998</year><volume>8</volume><fpage>503</fpage><lpage>528</lpage><pub-id pub-id-type="doi">10.1016/S1052-3359(25)00373-4</pub-id><pub-id pub-id-type="pmid">9742334</pub-id>

<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Eur J Med Res</journal-id><journal-id journal-id-type="iso-abbrev">Eur J Med Res</journal-id><journal-title-group><journal-title>European Journal of Medical Research</journal-title></journal-title-group><issn pub-type="ppub">0949-2321</issn><issn pub-type="epub">2047-783X</issn><publisher><publisher-name>BioMed Central</publisher-name><publisher-loc>London</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41194203</article-id><article-id pub-id-type="pmc">12587600</article-id><article-id pub-id-type="publisher-id">3318</article-id><article-id pub-id-type="doi">10.1186/s40001-025-03318-4</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>Evaluating the role of glucose-to-lymphocyte ratio as a prognostic indicator in pediatric moderate to severe traumatic brain injury</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Fatahian</surname><given-names>Reza</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Gracia</surname><given-names>Constana</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Bagheri</surname><given-names>Seyed Reza</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Alizadeh</surname><given-names>Maryam</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Asgari</surname><given-names>Hasti</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Amiri</surname><given-names>Akram</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Alimohammadi</surname><given-names>Ehsan</given-names></name><address><email>hafez125@gmail.com</email></address><xref ref-type="aff" rid="Aff3">3</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05vspf741</institution-id><institution-id institution-id-type="GRID">grid.412112.5</institution-id><institution-id institution-id-type="ISNI">0000 0001 2012 5829</institution-id><institution>Department of Neurosurgery, </institution><institution>Kermanshah University of Medical Sciences, </institution></institution-wrap>Kermanshah, Iran </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03151rh82</institution-id><institution-id institution-id-type="GRID">grid.411417.6</institution-id><institution-id institution-id-type="ISNI">0000 0004 0443 6864</institution-id><institution>School of Medicine, </institution><institution>Louisiana State University Health Science Center, </institution></institution-wrap>Shreveport, LA USA </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05vspf741</institution-id><institution-id institution-id-type="GRID">grid.412112.5</institution-id><institution-id institution-id-type="ISNI">0000 0001 2012 5829</institution-id><institution>Department of Neurosurgery, Imam Reza Hospital, </institution><institution>Kermanshah University of Medical Sciences, </institution></institution-wrap>Kermanshah, Iran </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05vspf741</institution-id><institution-id institution-id-type="GRID">grid.412112.5</institution-id><institution-id institution-id-type="ISNI">0000 0001 2012 5829</institution-id><institution>Kermanshah University of Medical Sciences, </institution></institution-wrap>Kermanshah, Iran </aff></contrib-group><pub-date pub-type="epub"><day>5</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>5</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>30</volume><elocation-id>1070</elocation-id><history><date date-type="received"><day>10</day><month>7</month><year>2025</year></date><date date-type="accepted"><day>6</day><month>10</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">Traumatic brain injury (TBI) poses a significant challenge within pediatric healthcare, being one of the leading causes of illness and death among children worldwide. Comprehending the clinical implications of pediatric TBI is essential for healthcare providers aiming to improve treatment methodologies and rehabilitation strategies. This study seeks to investigate the relationship between glucose-to-lymphocyte ratio (GLR) levels and clinical outcomes in pediatric patients who have experienced moderate to severe TBI.</p></sec><sec><title>Methods</title><p id="Par2">In this investigation, we conducted a retrospective analysis of clinical, radiographic, and laboratory data for all pediatric patients diagnosed with moderate to severe traumatic brain injury (TBI) treated at our institution from July 2017 to May 2024. All patients were managed according to the Advanced Trauma Life Support (ATLS) guidelines specifically designed for critically injured individuals with head trauma. Clinical outcomes were assessed at the time of hospital discharge using the Glasgow Outcome Scale (GOS). Based on these results, patients were categorized into two distinct groups: those who achieved favorable outcomes (GOS scores of 4 and 5) and those with unfavorable outcomes (GOS scores of 1, 2, and 3). We compared various factors that could potentially influence clinical outcomes in pediatric TBI patients, including GLR levels, between these two groups.</p></sec><sec><title>Results</title><p id="Par3">Among the 424 pediatric patients with moderate to severe traumatic brain injury (TBI) included in this analysis, 166 patients (39.2%) were classified into the high glucose-lymphocyte ratio (GLR) group, defined as those with a GLR exceeding 93.4. In contrast, 258 patients (60.8%) fell into the low GLR category, with a ratio at or below 93.4. The mean GLR across the cohort was noted to be 98.2&#x02009;&#x000b1;&#x02009;29.73. The results of the binary logistic regression analyses identified several independent risk factors for poor prognosis: GCS (OR: 3.41; 95% CI 1.67 &#x02013; 4.83; p&#x02009;&#x0003c;&#x02009;0.001), Rotterdam score (OR: 2.55; 95% CI 1.60 &#x02013; 4.21; p&#x02009;=&#x02009;0.015), pupillary light reflex (OR: 1.91; 95% CI 1.23 &#x02013; 2.98; p&#x02009;=&#x02009;0.027), and GLR level (OR: 1.63; 95% CI 1.18 &#x02013; 2.78; p&#x02009;=&#x02009;0.033).</p></sec><sec><title>Conclusion</title><p id="Par4">The results of this study indicate that GLR levels could act as a valuable indicator of poor clinical outcomes for pediatric patients with moderate to severe TBI. This easily obtainable and cost-effective biomarker may provide significant predictive value for assessing the clinical prognosis of these patients.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Traumatic brain injury</kwd><kwd>Pediatric patients</kwd><kwd>Clinical outcomes</kwd><kwd>Glucose-to-lymphocyte ratio</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; BioMed Central Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par5">Traumatic brain injury (TBI) presents a significant challenge in pediatric healthcare, being a leading cause of morbidity and mortality among children globally [<xref ref-type="bibr" rid="CR1">1</xref>&#x02013;<xref ref-type="bibr" rid="CR3">3</xref>]. The complexities associated with TBI in this demographic are heightened by the unique anatomical and developmental features of the developing brain [<xref ref-type="bibr" rid="CR2">2</xref>&#x02013;<xref ref-type="bibr" rid="CR4">4</xref>]. Unlike adults, children's brains demonstrate greater plasticity, which can impact both the immediate and long-term outcomes following an injury [<xref ref-type="bibr" rid="CR4">4</xref>, <xref ref-type="bibr" rid="CR5">5</xref>]. Therefore, understanding the clinical implications and outcomes of pediatric TBI is crucial for healthcare providers who aim to enhance treatment and rehabilitation approaches [<xref ref-type="bibr" rid="CR5">5</xref>, <xref ref-type="bibr" rid="CR6">6</xref>].</p><p id="Par6">Primary brain injury refers to direct mechanical injury to brain tissue, including contusions, hemorrhage, and axonal shearing, which subsequently triggers secondary processes such as inflammation, hypoxia, and metabolic disturbances (secondary brain injury) [<xref ref-type="bibr" rid="CR2">2</xref>, <xref ref-type="bibr" rid="CR6">6</xref>&#x02013;<xref ref-type="bibr" rid="CR9">9</xref>]. Clinicians typically depend on imaging studies and clinical evaluations to assess injury severity, and there is growing interest in blood-based biomarkers that could provide additional insights into patient condition and prognosis [<xref ref-type="bibr" rid="CR9">9</xref>&#x02013;<xref ref-type="bibr" rid="CR11">11</xref>].</p><p id="Par7">Glucose plays a vital role as an energy source for brain metabolism [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR13">13</xref>]. After a TBI, cerebral glucose levels can vary significantly due to disrupted metabolic processes, increased energy demands, and potential hypoxia [<xref ref-type="bibr" rid="CR13">13</xref>, <xref ref-type="bibr" rid="CR14">14</xref>]. These fluctuations can adversely affect neuronal health and recovery, contributing to subsequent neuronal injury [<xref ref-type="bibr" rid="CR15">15</xref>, <xref ref-type="bibr" rid="CR16">16</xref>].</p><p id="Par8">Lymphocytes, which include T cells, B cells, and natural killer (NK) cells, play an essential role in the immune response [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR17">17</xref>]. In the context of TBI, the immune response can significantly influence recovery outcomes [<xref ref-type="bibr" rid="CR18">18</xref>]. An excessively strong inflammatory response may exacerbate secondary injuries, while an insufficient response might hinder healing. The count of lymphocytes is pivotal in modulating these inflammatory responses [<xref ref-type="bibr" rid="CR18">18</xref>, <xref ref-type="bibr" rid="CR19">19</xref>].</p><p id="Par9">The glucose-to-lymphocyte ratio (GLR) is an emerging marker that reflects the degree of inflammation [<xref ref-type="bibr" rid="CR17">17</xref>, <xref ref-type="bibr" rid="CR19">19</xref>, <xref ref-type="bibr" rid="CR20">20</xref>]. As a composite indicator, GLR encompasses both metabolic health and immune system activity [<xref ref-type="bibr" rid="CR21">21</xref>]. Research has highlighted a significant correlation between elevated GLR levels and increased mortality risk associated with inflammatory diseases, including cancer and acute respiratory distress syndrome (ARDS), showcasing its distinct prognostic value [<xref ref-type="bibr" rid="CR21">21</xref>&#x02013;<xref ref-type="bibr" rid="CR27">27</xref>]. However, the link between GLR and mortality risk in pediatric TBI patients has yet to be investigated. Although several studies have examined the neutrophil-to-lymphocyte ratio (NLR) as a marker of inflammation in pediatric traumatic brain injury (TBI), NLR primarily reflects the inflammatory component of the systemic response and may overlook other pathophysiologic processes driving secondary brain injury. In contrast, the glucose-to-lymphocyte ratio (GLR) integrates both metabolic and immune dimensions by capturing stress-induced hyperglycemia (a marker of metabolic dysregulation and neuroendocrine activation) alongside lymphopenia (a surrogate of immune suppression). By combining these two critical axes&#x02014;metabolic impairment and immune competence&#x02014;GLR has the potential to provide incremental prognostic information beyond NLR, offering a more comprehensive risk stratification for pediatric TBI. This study is the first pediatric-focused investigation to evaluate GLR in this context and to assess whether GLR can improve prediction of mortality and functional outcomes compared with NLR or glucose or lymphocyte counts alone.</p><p id="Par10">To contextualize our findings, it is important to note the established pediatric reference ranges for these biomarkers. In children, normal blood glucose levels typically range between 70&#x02013;140&#x000a0;mg/dL, while lymphocyte counts generally fall between 1,500&#x02013;6,500 cells/&#x003bc;L, depending on age and developmental stage [<xref ref-type="bibr" rid="CR28">28</xref>, <xref ref-type="bibr" rid="CR29">29</xref>]. However, no standardized pediatric reference values for the glucose-to-lymphocyte ratio (GLR) currently exist in the literature. This absence underscores the novelty of our investigation, as our study is among the first to explore the prognostic significance of GLR in pediatric traumatic brain injury, thereby contributing to the development of reference benchmarks for this population.</p></sec><sec id="Sec2"><title>Methods</title><p id="Par11">In this study, we performed a retrospective analysis of clinical, radiographic, and laboratory data for all pediatric patients diagnosed with moderate to severe traumatic brain injury (TBI) who received treatment at our medical center from July 2017 to May 2024. The criteria for inclusion in this study were as follows:<list list-type="bullet"><list-item><p id="Par12"><italic>Participants</italic>: All pediatric patients under the age of 18&#x000a0;years at the time of admission who presented with moderate to severe TBI, as indicated by a Glasgow Coma Scale (GCS) score of less than 12 upon admission [<xref ref-type="bibr" rid="CR3">3</xref>].</p></list-item><list-item><p id="Par13"><italic>Injury Type</italic>: Only those patients with isolated traumatic brain injuries were included in the study.</p></list-item></list></p><p id="Par14">Patients exhibiting signs of concurrent infections, those who were under steroid treatment, and those with incomplete medical records were excluded from the analysis to ensure the integrity of the data. Of 497 initially screened children, 73 were excluded &#x02013; 51 for incomplete records, 14 with infections, and 8 on corticosteroids.</p><p id="Par15">The study received ethical approval from the Scientific Research Board of our institution. Prior to their participation, all patients or their legal guardians provided written informed consent.</p><sec id="Sec3"><title>Management and outcomes</title><p id="Par16">All patients were treated in accordance with the Advanced Trauma Life Support (ATLS) guidelines specifically tailored for critically injured individuals with head trauma. Surgical interventions were conducted as needed to excise any mass lesions [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR30">30</xref>]. For patients whose GCS was 8 or lower at admission (indicating severe impairment of consciousness), intubation and mechanical ventilation were implemented.</p><p id="Par17">Upon admission, every patient underwent a head computed tomography (CT) scan, which was subsequently assessed using the Rotterdam Classification system. The Rotterdam CT score is a standardized scoring system that evaluates the severity of traumatic brain injuries based on CT scan findings, providing essential insights that help inform clinical management strategies and predict patient outcomes [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR31">31</xref>].</p><p id="Par18">At the time of admission, blood samples were taken to evaluate lymphocyte counts and glucose levels. The glucose-lymphocyte ratio (GLR) was calculated by dividing the glucose concentration (reported in mg/dL) by the lymphocyte count (expressed in K/uL).</p><p id="Par19">To establish the most appropriate cutoff points for GLR, we utilized Youden&#x02019;s index in conjunction with receiver operating characteristic (ROC) curves [<xref ref-type="bibr" rid="CR32">32</xref>]. A GLR score of 93.4 or lower was categorized as low GLR, while scores exceeding this threshold were classified as high GLR.</p><p id="Par20">Clinical outcomes were evaluated at the time of hospital discharge using [<xref ref-type="bibr" rid="CR33">33</xref>], which categorizes patients into five groups: 1&#x02009;=&#x02009;death, 2&#x02009;=&#x02009;persistent vegetative state, 3&#x02009;=&#x02009;severe disability, 4&#x02009;=&#x02009;moderate disability, and 5&#x02009;=&#x02009;good recovery. Based on these outcomes, patients were divided into two distinct groups: those who experienced favorable outcomes (GOS scores of 4 and 5) and those with unfavorable outcomes (GOS scores of 1, 2, and 3) (1,3 and 33).</p><p id="Par21">We compared various potential factors that could influence clinical outcomes in pediatric TBI patients, including the GLR, between these two groups.</p></sec><sec id="Sec4"><title>Statistical analysis</title><p id="Par22">Statistical analysis was conducted using SPSS version 23 software developed by SPSS Inc. in Chicago, Illinois. Descriptive statistics were calculated, presenting continuous variables as means along with standard deviations (SD) and categorical variables as counts and percentages. To evaluate the differences in proportions between groups, we utilized the Chi-square test or Fisher&#x02019;s exact test, whereas Student&#x02019;s t-test was employed for the assessment of continuous variables. For determining the optimal cutoff values for the glucose-lymphocyte ratio (GLR), we calculated Youden&#x02019;s index by analyzing ROC curves. Additionally, we used binary logistic regression analysis to explore independent relationships between various variables and clinical outcomes. A p-value of less than 0.05 was considered statistically significant, indicating meaningful differences in the analysis outcomes.</p></sec></sec><sec id="Sec5"><title>Results</title><p id="Par23">A total of 424 pediatric patients with moderate to severe TBI were included in the study, with a mean age of 7.24&#x02009;&#x000b1;&#x02009;2.31&#x000a0;years. The cohort comprised 231 males (54.5%) and 193 females (45.5%). Road traffic crashes were the leading cause of injury (59.7%), followed by falls (26.2%), being struck by objects (5.9%), violence (3.8%), and other causes (4.4%). At admission, the mean Glasgow Coma Scale (GCS) score was 8.13&#x02009;&#x000b1;&#x02009;1.25. The average hospital stay was 13.72&#x02009;&#x000b1;&#x02009;6.02&#x000a0;days. Regarding pupillary light reflex, 80.2% of patients had both pupils reactive, 15.3% had one fixed pupil, and 4.5% had both pupils fixed.</p><p id="Par24">Laboratory assessments at admission showed a mean serum glucose level of 168.23&#x02009;&#x000b1;&#x02009;58.32&#x000a0;mg/dL, mean lymphocyte count of 1,403&#x02009;&#x000b1;&#x02009;736 cells/&#x003bc;L, and a mean GLR of 98.2&#x02009;&#x000b1;&#x02009;29.73. Other baseline hematologic parameters included a white blood cell count of 8,562&#x02009;&#x000b1;&#x02009;2,822 cells/mm<sup>3</sup>, neutrophil count of 6,108&#x02009;&#x000b1;&#x02009;2,014 cells/mm<sup>3</sup>, platelet count of 195,125&#x02009;&#x000b1;&#x02009;8,219 cells/mm<sup>3</sup>, and red blood cell count of 4.78&#x02009;&#x000b1;&#x02009;0.63 million/&#x003bc;L. The Rotterdam CT scores were distributed as follows: score 1 in 27.6% of patients, score 2 in 41.3%, score 3 in 14.6%, score 4 in 7.3%, score 5 in 7.1%, and score 6 in 2.1%0.166 patients (39.2%) were categorized into the high glucose-lymphocyte ratio (GLR) group, defined as having a GLR greater than 93.4. In contrast, 258 patients (60.8%) fell into the low GLR group with a ratio of 93.4 or lower. The average GLR across the entire cohort was recorded at 98.2&#x02009;&#x000b1;&#x02009;29.73[Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>, <xref rid="Tab2" ref-type="table">2</xref>].
<table-wrap id="Tab1"><label>Table&#x000a0;1</label><caption><p>Frequency and frequency percent of the variables</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" colspan="2">Variable</th><th align="left">Frequency (%)</th></tr></thead><tbody><tr><td align="left" rowspan="2">Gender</td><td align="left">Male</td><td char="(" align="char">231 (54.5%)</td></tr><tr><td align="left">Female</td><td char="(" align="char">193 (45.5%)</td></tr><tr><td align="left" rowspan="5">Cause of trauma</td><td align="left">Road Traffic Crashes</td><td char="(" align="char">253 (59.7%)</td></tr><tr><td align="left">Fall</td><td char="(" align="char">111(26.2%)</td></tr><tr><td align="left">Violence</td><td char="(" align="char">16 (3.8%)</td></tr><tr><td align="left">Struck by objects</td><td char="(" align="char">25 (5.9%)</td></tr><tr><td align="left">Others</td><td char="(" align="char">18 (4.4%)</td></tr><tr><td align="left" rowspan="5">GOS</td><td align="left">Death</td><td char="(" align="char">59(13.9%)</td></tr><tr><td align="left">Vegetative State</td><td char="(" align="char">28(6.6%)</td></tr><tr><td align="left">Sever Disability</td><td char="(" align="char">49(11.6%)</td></tr><tr><td align="left">Moderate Disability</td><td char="(" align="char">103(24.3%)</td></tr><tr><td align="left">Good Recovery</td><td char="(" align="char">185 (43.6%)</td></tr><tr><td align="left" rowspan="3">Light Reflex</td><td align="left">Both Pupils Reactive</td><td char="(" align="char">340 (80.2%)</td></tr><tr><td align="left">One Pupil Fixed</td><td char="(" align="char">65 (15.3%)</td></tr><tr><td align="left">Both Pupils fixed</td><td char="(" align="char">19 (4.5%)</td></tr><tr><td align="left" rowspan="2">Glucose-to-Lymphocyte Ratio</td><td align="left">High GLR group</td><td char="(" align="char">166 (39.2%)</td></tr><tr><td align="left">Low GLR group</td><td char="(" align="char">258 (60.8%)</td></tr><tr><td align="left" rowspan="6">Rotterdam Score</td><td align="left">1</td><td char="(" align="char">117 (27.6%)</td></tr><tr><td align="left">2</td><td char="(" align="char">175 (41.3%)</td></tr><tr><td align="left">3</td><td char="(" align="char">62 (14.6%)</td></tr><tr><td align="left">4</td><td char="(" align="char">31 (7.3%)</td></tr><tr><td align="left">5</td><td char="(" align="char">30 (7.1%)</td></tr><tr><td align="left">6</td><td char="(" align="char">9 (2.1%)</td></tr></tbody></table></table-wrap><table-wrap id="Tab2"><label>Table&#x000a0;2</label><caption><p>Mean and standard deviation of quantitative variables</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">variable</th><th align="left">Mean (SD)</th></tr></thead><tbody><tr><td align="left">Age (Year)</td><td align="left">7. 24 (2.31)</td></tr><tr><td align="left">GCS</td><td align="left">8.13 (1.25)</td></tr><tr><td align="left">Hospital stay (day)</td><td align="left">13.72(6.02)</td></tr><tr><td align="left">Baseline white blood cell count cells/mm3</td><td align="left">8562 (2822)</td></tr><tr><td align="left">Baseline Neutrophil count cells/mm3</td><td align="left">6108(2014)</td></tr><tr><td align="left">Baseline lymphocyte count cells/mm3</td><td align="left">1403 (736)</td></tr><tr><td align="left">Baseline Platelet count cells/mm3</td><td align="left">195,125 (8219)</td></tr><tr><td align="left">Baseline Red cell distribution width, %</td><td align="left">12.66 (0.051)</td></tr><tr><td align="left">Baseline Red blood cell (million cells/microlitre)</td><td align="left">4.78 (0.63)</td></tr><tr><td align="left">Serum glucose level, mg/dL</td><td align="left">168.23&#x02009;&#x000b1;&#x02009;58.32</td></tr><tr><td align="left">Glucose-to-Lymphocyte Ratio level</td><td align="left">98.2&#x02009;&#x000b1;&#x02009;29.73</td></tr><tr><td align="left">Admission Prothrombin Time</td><td align="left">13.32 (1.17)</td></tr><tr><td align="left">Admission Partial Thromboplastin Time</td><td align="left">33.6 (3.24)</td></tr><tr><td align="left">Admission INR</td><td align="left">1.2 (0.28)</td></tr></tbody></table></table-wrap></p><p id="Par25">A striking finding was that 53% of the patients belonging to the high GLR group experienced unfavorable outcomes, categorized by Glasgow Outcome Scale (GOS) scores of 1 to 3. In comparison, only 18.6% of patients in the low GLR group had unfavorable outcomes, indicating a statistically significant difference (p&#x02009;=&#x02009;0.006). This suggests that a higher GLR is associated with a worse prognosis in pediatric TBI patients.</p><p id="Par26">Receiver operating characteristic (ROC) curve analysis was employed to ascertain the optimal threshold for the GLR, which was found to be 93.4 according to Youden&#x02019;s index. Above this threshold, the likelihood of experiencing unfavorable outcomes significantly increased (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>). Logistic regression analysis reinforced the prognostic importance of the GLR, revealing that patients with a high GLR had an adjusted odds ratio (AOR) of 1.63 (95% Confidence Interval [CI] 1.18&#x02013;2.78; p&#x02009;=&#x02009;0.033) for unfavorable outcomes. This relationship remained statistically significant even when accounting for other clinical variables, highlighting the GLR's additive value in predicting patient outcomes. The ROC AUC for GLR was 0.71 (95% CI 0.66&#x02013;0.75), demonstrating moderate discriminative ability.<fig id="Fig1"><label>Fig.&#x000a0;1</label><caption><p>The receiver operating characteristic (ROC) curve with glucose-to-lymphocyte ratio (GLR) values as the test variable in predicting unfavorable outcomes</p></caption><graphic xlink:href="40001_2025_3318_Fig1_HTML" id="MO1"/></fig></p><p id="Par27">In addition, serum glucose levels were considerably higher in patients who faced unfavorable outcomes compared to those with favorable outcomes, with averages of 195.42&#x02009;&#x000b1;&#x02009;37.2&#x000a0;mg/dL versus 142.27&#x02009;&#x000b1;&#x02009;32.5&#x000a0;mg/dL, respectively (p&#x02009;=&#x02009;0.027). However, when assessed in a multivariate regression model, glucose levels alone did not serve as a significant predictor of outcomes (p&#x02009;=&#x02009;0.124), further emphasizing the additional prognostic value conferred by the GLR.</p><p id="Par28">Lymphocyte counts were observed to be lower in the group with unfavorable outcomes, averaging 1012&#x02009;&#x000b1;&#x02009;374 cells/mm<sup>3</sup> compared to 1289&#x02009;&#x000b1;&#x02009;658 cells/mm<sup>3</sup> in the more favorable group, though this difference did not achieve statistical significance (p&#x02009;=&#x02009;0.074).</p><p id="Par29">The distribution of GLR was also associated consistently with various clinical variables. Notably, the Glasgow Coma Scale (GCS) scores were substantially lower in patients experiencing unfavorable outcomes, with scores of 5.99&#x02009;&#x000b1;&#x02009;1.38 compared to 9.41&#x02009;&#x000b1;&#x02009;1.50 for those with better outcomes (p&#x02009;&#x0003c;&#x02009;0.001). The average duration of hospital stays was also significantly longer for patients with unfavorable outcomes, averaging 16.37&#x02009;&#x000b1;&#x02009;5.71&#x000a0;days, as opposed to 9.84&#x02009;&#x000b1;&#x02009;4.12&#x000a0;days for those with favorable outcomes (p&#x02009;=&#x02009;0.041).</p><p id="Par30">Additional assessments, such as pupillary light reflexes and Rotterdam CT scores, also correlated significantly with patient outcomes, demonstrating that the GLR provided valuable supplementary discrimination when analyzed alongside these established clinical markersnb (Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>, <xref rid="Tab4" ref-type="table">4</xref>). The correlation analyses demonstrating a modest but significant negative correlation between GLR and GCS (r&#x02009;=&#x02009;&#x02212;0.32, p&#x02009;&#x0003c;&#x02009;0.001).
<table-wrap id="Tab3"><label>Table&#x000a0;3</label><caption><p>Relationship between clinical outcomes and categorical variables</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2" colspan="2">Variable</th><th align="left" colspan="2">Clinical outcomes</th><th align="left" rowspan="2">Statistical test</th></tr><tr><th align="left">Unfavorable<break/>N(%)136(32.1)</th><th align="left">Favorable<break/>N(%)288(67.9)</th></tr></thead><tbody><tr><td align="left" rowspan="2">Gender</td><td align="left">Male</td><td char="(" align="char">84 (36.4%)</td><td char="(" align="char">147(63.6%)</td><td align="left" rowspan="2">P&#x02009;=&#x02009;0.223</td></tr><tr><td align="left">Female</td><td char="(" align="char">52(26.9%)</td><td char="(" align="char">141 (73.1%)</td></tr><tr><td align="left" rowspan="5">Cause of trauma</td><td align="left">Road Traffic Crashes</td><td char="(" align="char">76(30.0%)</td><td char="(" align="char">177(70.0%)</td><td align="left" rowspan="5">P&#x02009;=&#x02009;0.947</td></tr><tr><td align="left">Fall</td><td char="(" align="char">43(38.7%)</td><td char="(" align="char">68(61.3%)</td></tr><tr><td align="left">Violence</td><td char="(" align="char">7(43.8%)</td><td char="(" align="char">9(56.3%)</td></tr><tr><td align="left">Struck by objects</td><td char="(" align="char">4(16.0%)</td><td char="(" align="char">21(84.0%)</td></tr><tr><td align="left">Others</td><td char="(" align="char">6(31.6%)</td><td char="(" align="char">13(68.4%)</td></tr><tr><td align="left" rowspan="3">Light Reflex</td><td align="left">Both Pupils Reactive</td><td char="(" align="char">68(20.0%)</td><td char="(" align="char">272(80.0%)</td><td align="left" rowspan="3">P&#x02009;=&#x02009;0.001</td></tr><tr><td align="left">One Pupil Fixed</td><td char="(" align="char">51(78.5%)</td><td char="(" align="char">14(10.5%)</td></tr><tr><td align="left">Both Pupils fixed</td><td char="(" align="char">17(89.5%)</td><td char="(" align="char">2(10.5%)</td></tr><tr><td align="left" rowspan="2">Glucose-to-Lymphocyte Ratio</td><td align="left">High GLR group</td><td char="(" align="char">88(53.0%)</td><td char="(" align="char">78(47.0%)</td><td align="left" rowspan="2">P&#x02009;=&#x02009;0.006</td></tr><tr><td align="left">Low GLR group</td><td char="(" align="char">48(18.6%)</td><td char="(" align="char">210(81.4%)</td></tr><tr><td align="left" rowspan="6">Rotterdam Score</td><td align="left">1</td><td char="(" align="char">5(4.3%)</td><td char="(" align="char">112(95.7%)</td><td align="left" rowspan="6">P&#x02009;=&#x02009;0.009</td></tr><tr><td align="left">2</td><td char="(" align="char">24(13.7%)</td><td char="(" align="char">151(86.3%)</td></tr><tr><td align="left">3</td><td char="(" align="char">39(62.9%)</td><td char="(" align="char">23(37.1%)</td></tr><tr><td align="left">4</td><td char="(" align="char">30(96.8%)</td><td char="(" align="char">1(3.2%)</td></tr><tr><td align="left">5</td><td char="(" align="char">29(96.7%)</td><td char="(" align="char">1(3.3%)</td></tr><tr><td align="left">6</td><td char="(" align="char">9(100.00%)</td><td char="(" align="char">0(00.00%)</td></tr></tbody></table></table-wrap><table-wrap id="Tab4"><label>Table&#x000a0;4</label><caption><p>Relationship between clinical outcomes and quantitative variables</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2">Variable</th><th align="left" colspan="2">Clinical outcomes</th><th align="left" rowspan="2">Clinical outcomes</th></tr><tr><th align="left">Unfavorable<break/>N(%)136(32.1)</th><th align="left">Favorable<break/>N(%)288(67.9)</th></tr></thead><tbody><tr><td align="left">Age (Year)</td><td char="(" align="char">7.01(2.21)</td><td char="(" align="char">7.84(2.26)</td><td align="left">P&#x02009;=&#x02009;0.253</td></tr><tr><td align="left">GCS</td><td char="(" align="char">5.99 (1.38)</td><td char="(" align="char">9.41 (1.50)</td><td align="left"><bold>P&#x02009;&#x0003c;&#x02009;0.001</bold></td></tr><tr><td align="left">Hospital stay (day)</td><td char="(" align="char">16.37(5.71)</td><td char="(" align="char">9.84 (4.12)</td><td align="left"><bold>P&#x02009;=&#x02009;0.041</bold></td></tr><tr><td align="left">Baseline white blood cell count cells/mm3</td><td char="(" align="char">8251(3852)</td><td char="(" align="char">8668(3101)</td><td align="left">P&#x02009;=&#x02009;0.202</td></tr><tr><td align="left">Baseline Neutrophil count cells/mm3</td><td char="(" align="char">7032(2015)</td><td char="(" align="char">6742(1928)</td><td align="left">P&#x02009;=&#x02009;0.082</td></tr><tr><td align="left">Baseline lymphocyte count cells/mm3</td><td char="(" align="char">1012 (374)</td><td char="(" align="char">1289(658)</td><td align="left">P&#x02009;=&#x02009;0.074</td></tr><tr><td align="left">Baseline Platelet count cells/mm3</td><td char="(" align="char">188,231(7857)</td><td char="(" align="char">181,325(7325)</td><td align="left">P&#x02009;=&#x02009;0.109</td></tr><tr><td align="left">Baseline Red cell distribution width, %</td><td char="(" align="char">14.43 (0.053)</td><td char="(" align="char">12.98 (0.042)</td><td align="left">P&#x02009;=&#x02009;0.089</td></tr><tr><td align="left">Baseline Red blood cell (million cells/microlitre)</td><td char="(" align="char">4.66 (0.60)</td><td char="(" align="char">4.61 (0.59)</td><td align="left">P&#x02009;=&#x02009;0.452</td></tr><tr><td align="left">Serum glucose level, mg/dL</td><td char="(" align="char">195.42 (37.2)</td><td char="(" align="char">142.27 (32.5)</td><td align="left"><bold>P&#x02009;=&#x02009;0.027</bold></td></tr><tr><td align="left">Glucose-to-Lymphocyte Ratio level</td><td char="(" align="char">100.23 (28.12)</td><td char="(" align="char">80.12 (25.22)</td><td align="left"><bold>P&#x02009;=&#x02009;0.003</bold></td></tr></tbody></table></table-wrap></p><p id="Par31">Further analysis through binary logistic regression identified several independent risk factors associated with poor prognosis in this patient population. The GCS score was found to have an odds ratio (OR) of 3.41 (95% CI 1.67&#x02013;4.83; p&#x02009;&#x0003c;&#x02009;0.001), indicating a substantially increased risk of unfavorable outcomes with lower GCS scores. Similarly, the Rotterdam CT score had an OR of 2.55 (95% CI 1.60&#x02013;4.21; p&#x02009;=&#x02009;0.015), and pupillary light reflex assessment yielded an OR of 1.91 (95% CI 1.23&#x02013;2.98; p&#x02009;=&#x02009;0.027). The GLR itself also emerged as a significant prognostic factor, with an OR of 1.63 (95% CI 1.18&#x02013;2.78; p&#x02009;=&#x02009;0.033), solidifying its role in predicting outcomes following moderate to severe pediatric TBI (Table&#x000a0;<xref rid="Tab5" ref-type="table">5</xref>).
<table-wrap id="Tab5"><label>Table&#x000a0;5</label><caption><p>Binary logistic regression analysis</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Variables</th><th align="left">Odds ratio</th><th align="left">95% CI</th><th align="left">P value</th></tr></thead><tbody><tr><td align="left">GCS</td><td char="." align="char">3.41</td><td char="&#x02013;" align="char">1.67&#x02013;4.83</td><td align="left"><bold>P&#x02009;&#x0003c;&#x02009;0.001</bold></td></tr><tr><td align="left">Rotterdam score</td><td char="." align="char">2.55</td><td char="&#x02013;" align="char">1.60&#x02013;4.21</td><td align="left"><bold>P&#x02009;=&#x02009;0.015</bold></td></tr><tr><td align="left">Light Reflex</td><td char="." align="char">1.91</td><td char="&#x02013;" align="char">1.23&#x02013;2.98</td><td align="left"><bold>P&#x02009;=&#x02009;0.027</bold></td></tr><tr><td align="left">Serum glucose level, mg/dL</td><td char="." align="char">1.31</td><td char="&#x02013;" align="char">0.84&#x02013;1.74</td><td align="left">P&#x02009;=&#x02009;0.124</td></tr><tr><td align="left">Glucose-to-Lymphocyte Ratio level</td><td char="." align="char">1.63</td><td char="&#x02013;" align="char">1.18&#x02013;2.78</td><td align="left"><bold>P&#x02009;=&#x02009;0.033</bold></td></tr></tbody></table></table-wrap></p></sec><sec id="Sec6"><title>Discussion</title><p id="Par32">This study represents the first substantial pediatric-focused investigation into the prognostic importance of the glucose-to-lymphocyte ratio (GLR) in cases of moderate to severe traumatic brain injury (TBI). Our results indicate that an elevated GLR is significantly associated with an increased likelihood of mortality and poor neurological recovery at the time of hospital discharge, positioning GLR as a promising novel biomarker for early prognostication in this population. Out of the 424 children assessed, 39.2% were classified in the high GLR group (&#x0003e;&#x02009;93.4), and alarmingly, more than half of these patients (53%) experienced unfavorable outcomes. In contrast, only 18.6% of patients in the low GLR group faced similar outcomes. This striking association persists even after adjustments for potential confounding factors, yielding an adjusted odds ratio (AOR) of 1.63 (95% CI 1.18&#x02013;2.78; p&#x02009;=&#x02009;0.033).</p><p id="Par33">These findings resonate with previous studies conducted in adult populations, which have also linked elevated GLR to adverse outcomes across diverse clinical conditions, including myocardial infarction, infections related to peritoneal dialysis, and various cancers [<xref ref-type="bibr" rid="CR23">23</xref>&#x02013;<xref ref-type="bibr" rid="CR27">27</xref>]. A notable study focusing on the neutrophil-to-lymphocyte ratio (NLR) in TBI patients concluded that lower lymphocyte counts impair recovery [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR6">6</xref>]. Within the specific context of brain injury, an elevated GLR likely reflects a maladaptive systemic stress response characterized by a combination of hyperglycemia-induced oxidative stress and lymphocyte suppression related to the injury itself [<xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR34">34</xref>, <xref ref-type="bibr" rid="CR35">35</xref>].</p><p id="Par34">Pediatric patients are particularly susceptible to these stress responses due to the immature development of their neuroimmune systems [<xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR36">36</xref>, <xref ref-type="bibr" rid="CR37">37</xref>]. Monitoring glucose levels in pediatric TBI patients is crucial because persistent hyperglycemia can exacerbate neuronal damage and complicate recovery. Thus, regular glucose assessments may help promote better long-term outcomes and enhance the likelihood of full recovery and survival [<xref ref-type="bibr" rid="CR11">11</xref>, <xref ref-type="bibr" rid="CR38">38</xref>].</p><p id="Par35">The essence of the GLR lies in its ability to integrate metabolic dysregulation and immune system dysfunction, both of which are key mediators of secondary brain injury [<xref ref-type="bibr" rid="CR22">22</xref>, <xref ref-type="bibr" rid="CR34">34</xref>]. In our cohort, patients who exhibited poor outcomes presented with significantly higher mean glucose levels (195.4&#x000a0;mg/dL) compared to those who had favorable outcomes (142.3&#x000a0;mg/dL; p&#x02009;=&#x02009;0.027). This finding strongly supports the concept that stress-induced hyperglycemia contributes to neuronal injury. Nonetheless, glucose levels alone did not independently predict outcomes (p&#x02009;=&#x02009;0.124), further highlighting the added prognostic value of the GLR as a composite indicator of systemic health [<xref ref-type="bibr" rid="CR22">22</xref>, <xref ref-type="bibr" rid="CR25">25</xref>].</p><p id="Par36">While lymphocyte counts displayed a lower trend in the unfavorable outcomes group, it did not achieve statistical significance (p&#x02009;=&#x02009;0.074). However, this trend aligns with the phenomenon of post-traumatic lymphopenia and immunosuppression that has been well-documented in both adult and pediatric trauma literature [<xref ref-type="bibr" rid="CR25">25</xref>, <xref ref-type="bibr" rid="CR26">26</xref>]. The impairment in lymphocyte response can hinder the body&#x02019;s ability to manage inflammatory processes effectively, which is critical in the recovery from TBI [<xref ref-type="bibr" rid="CR20">20</xref>, <xref ref-type="bibr" rid="CR38">38</xref>].</p><p id="Par37">Furthermore, other clinical variables, such as pupillary reflex response and Rotterdam CT scores, maintained robust associations with clinical outcomes, consistent with existing literature on TBI [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR4">4</xref>]. For instance, bilateral fixed pupils were connected with poor outcomes in nearly 90% of cases, while Rotterdam CT scores of 4 to 6 were observed to correlate with over 95% of unfavorable outcomes. It is important to emphasize that the prognostic strength of GLR remained significant even when taking these established indicators into account, signaling its complementary role in refining risk stratification in pediatric TBI [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR5">5</xref>, <xref ref-type="bibr" rid="CR12">12</xref>].</p><p id="Par38">Research surrounding related ratios in adult populations, such as the neutrophil-to-lymphocyte ratio (NLR), has confirmed their predictive utility for neurological deterioration and outcomes at 90&#x000a0;days [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR6">6</xref>]. Our study extends these findings by establishing GLR's relevance in the pediatric TBI context, a field where biomarker research is still underdeveloped. Unlike NLR, which reflects primarily the inflammatory response, GLR incorporates the metabolic component of stress-hyperglycemia. This dual integration may explain why GLR retained prognostic significance in multivariate analysis even when glucose alone did not. Furthermore, compared to isolated biomarkers, the GLR may offer a more accessible and timely assessment tool in emergency settings, especially in low-resource environments where advanced neuroimaging technologies might be delayed or unavailable [<xref ref-type="bibr" rid="CR16">16</xref>, <xref ref-type="bibr" rid="CR17">17</xref>].</p><p id="Par39">In summary, this investigation reveals that GLR is a potentially useful adjunctive biomarker in pediatric TBI, integrating both metabolic disturbances and immunological responses. As early identification of patients at high risk for adverse outcomes becomes increasingly important in clinical practice, the GLR could serve as a valuable addition to existing prognostic frameworks, supporting clinicians in making informed decisions about patient management and resource allocation. Future research should aim to validate these findings in larger, multicenter studies while investigating potential therapeutic interventions aimed at modulating GLR and improving outcomes for pediatric TBI patients.</p></sec><sec id="Sec7"><title>Limitations</title><p id="Par40">While this article presents innovative analyses and predictive methodologies, several limitations need to be addressed. Firstly, this research was conducted as a single-center retrospective study, which introduces potential selection bias and limits the external applicability of the findings. Although we excluded patients with infections or those receiving steroids to reduce immune confounding, this approach may limit the generalizability of the results to populations with multiple trauma.</p><p id="Par41">Secondly, the glucose-to-lymphocyte ratio (GLR) was evaluated exclusively at the time of admission, which restricts our understanding of its changes over time. Previous studies have highlighted the significance of monitoring serial trends in inflammatory markers during critical illness.</p><p id="Par42">Thirdly, we based our assessment of clinical outcomes on the Glasgow Outcome Scale (GOS) at discharge, which may not adequately reflect the long-term neurocognitive and developmental consequences in pediatric patients. Children may exhibit temporary improvement that obscures underlying deficits, underscoring the necessity for extended follow-up evaluations.</p><p id="Par43">Fourthly, although age did not show a statistically significant impact on outcomes in our cohort, the developmental immunologic differences across various age groups suggest that GLR thresholds may need to be stratified by age to enhance prognostic precision.</p><p id="Par44">Lastly, while the GLR is straightforward to calculate and relies on routine laboratory tests, there is a possibility that undiagnosed endocrine or inflammatory disorders could influence the results. Future studies may benefit from integrating additional biomarkers, such as C-reactive protein or interleukin-6 (IL-6), and comparing GLR with the neutrophil-to-lymphocyte ratio (NLR) or other ratios to create a more thorough inflammatory profile.</p></sec><sec id="Sec8"><title>Conclusion</title><p id="Par45">Our research establishes the glucose-to-lymphocyte ratio (GLR) as a straightforward, cost-effective, and potentially useful adjunctive biomarker for pediatric patients suffering from moderate to severe traumatic brain injury (TBI). An elevated GLR at admission is closely associated with a heightened risk of mortality, vegetative state, and severe disability. Unlike assessments that focus solely on glucose or lymphocyte levels, the GLR effectively encompasses both metabolic and immunological stress responses, which are crucial during the secondary phase of brain injury. Its simplicity and prompt availability make it a valuable complement to established clinical assessments such as the Glasgow Coma Scale (GCS) and neuroimaging.</p><p id="Par46">Given the intricate nature of pediatric TBI and the resource constraints in many healthcare settings, the GLR has the potential to enhance early triage, guide family consultations, and inform therapeutic strategies. To further validate and optimize the application of GLR in pediatric neurocritical care, future prospective, multicenter studies that include longitudinal outcome assessments and serial biomarker monitoring are imperative.</p></sec></body><back><fn-group><fn><p><bold>Publisher's Note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn></fn-group><ack><title>Acknowledgements</title><p>We appreciate the Clinical Research Development Center of Imam Reza Hospital for their wise advice.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>EA, RF, and SRB had the idea for this study. EA, RF, MA, and SRB participated in outlining the concept and design. MA, HA, and AA did the data acquisition. EA and HA, and CG did the statistical analysis and wrote the first draft of the manuscript. EA, HS, MA, CG, AA, and SRB revised the final manuscript. All authors have read and approved the manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>There was no external source of funding.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>The datasets generated and/or analysed during the current study are not publicly available due them containing information that could compromise research participant privacy/consent but are available from the corresponding author on reasonable request.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par47">The study received ethics approval by the Kermanshah University of Medical Science Ethics Committee [IR.KUMS.MED.REC.1403.361]. Written informed consent to participate was obtained from all patients. All methods were carried out in accordance of declaration of Helsinki with relevant guidelines and regulations. The patient's data included in this manuscript has not been previously reported.</p></notes><notes id="FPar2"><title>Consent for publication</title><p id="Par48">Not applicable.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests</title><p id="Par49">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Foroushani</surname><given-names>AZ</given-names></name><name><surname>Alimohammadi</surname><given-names>E</given-names></name></person-group><article-title>The dynamics of neutrophil-to-lymphocyte ratio as a promising biomarker for predicting clinical o
<bold>PAV %</bold>
</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">Patient level</td><td rowspan="1" colspan="1">6.4 (2.9&#x02013;11.7)</td><td rowspan="1" colspan="1">11.3 (6.2&#x02013;22.3)</td><td rowspan="1" colspan="1">&#x0003c;0.001</td><td rowspan="1" colspan="1">14.4 (7.5&#x02013;23.1)</td><td rowspan="1" colspan="1">1.000</td><td rowspan="1" colspan="1">17.7 (10.4&#x02013;26.2)</td><td rowspan="1" colspan="1">0.078</td><td rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td rowspan="1" colspan="1">LAD</td><td rowspan="1" colspan="1">11.3 (4.8&#x02013;17.7)<sup><xref rid="tblfn5" ref-type="table-fn">a,b</xref></sup></td><td rowspan="1" colspan="1">18.5 (8.2&#x02013;28.9)<sup><xref rid="tblfn5" ref-type="table-fn">a</xref></sup></td><td rowspan="1" colspan="1">0.005</td><td rowspan="1" colspan="1">21.0 (13.2&#x02013;28.6)<sup><xref rid="tblfn5" ref-type="table-fn">a,b</xref></sup></td><td rowspan="1" colspan="1">1.000</td><td rowspan="1" colspan="1">20.8 (15.7&#x02013;32.9)<sup><xref rid="tblfn5" ref-type="table-fn">a,b</xref></sup></td><td rowspan="1" colspan="1">0.716</td><td rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td rowspan="1" colspan="1">LCX</td><td rowspan="1" colspan="1">5.7 (1.9&#x02013;11.7)<sup><xref rid="tblfn5" ref-type="table-fn">a</xref></sup></td><td rowspan="1" colspan="1">8.9 (2.8&#x02013;17.7)<sup><xref rid="tblfn5" ref-type="table-fn">a</xref></sup></td><td rowspan="1" colspan="1">0.350</td><td rowspan="1" colspan="1">17.5 (6.4&#x02013;24.0)<sup><xref rid="tblfn5" ref-type="table-fn">a</xref></sup></td><td rowspan="1" colspan="1">0.111</td><td rowspan="1" colspan="1">14.5 (7.6&#x02013;26.2)<sup><xref rid="tblfn5" ref-type="table-fn">a</xref></sup></td><td rowspan="1" colspan="1">1.000</td><td rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td rowspan="1" colspan="1">RCA</td><td rowspan="1" colspan="1">4.2 (1.2&#x02013;11.4)<sup><xref rid="tblfn5" ref-type="table-fn">b</xref></sup></td><td rowspan="1" colspan="1">11.6 (1.9&#x02013;21.2)</td><td rowspan="1" colspan="1">0.119</td><td rowspan="1" colspan="1">16.2 (5.6&#x02013;25.8)<sup><xref rid="tblfn5" ref-type="table-fn">b</xref></sup></td><td rowspan="1" colspan="1">0.821</td><td rowspan="1" colspan="1">16.3 (8.9&#x02013;29.4)<sup><xref rid="tblfn5" ref-type="table-fn">b</xref></sup></td><td rowspan="1" colspan="1">1.000</td><td rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td rowspan="1" colspan="1">

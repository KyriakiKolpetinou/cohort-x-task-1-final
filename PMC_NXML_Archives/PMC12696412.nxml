span="1" colspan="1">17 (6&#x02013;34)<sup><xref rid="tblfn5" ref-type="table-fn">b</xref></sup></td><td rowspan="1" colspan="1">30 (9&#x02013;46)<sup><xref rid="tblfn5" ref-type="table-fn">b</xref></sup></td><td rowspan="1" colspan="1">0.604</td><td rowspan="1" colspan="1">41 (18&#x02013;59)<sup><xref rid="tblfn5" ref-type="table-fn">b</xref></sup></td><td rowspan="1" colspan="1">0.555</td><td rowspan="1" colspan="1">53 (34&#x02013;75)<sup><xref rid="tblfn5" ref-type="table-fn">c</xref></sup></td><td rowspan="1" colspan="1">0.061</td><td rowspan="1" colspan="1">&#x0003c;0.001</td></tr><tr><td rowspan="1" colspan="1">

<article-id pub-id-type="doi">10.1136/heartjnl-2024-325419</article-id><article-id pub-id-type="publisher-id">heartjnl-2024-325419</article-id><article-categories><subj-group subj-group-type="display-channel"><subject>Original Research</subject></subj-group><subj-group subj-group-type="heading"><subject>Heart Failure and Cardiomyopathies</subject></subj-group></article-categories><title-group><article-title>Diagnostic accuracy of late gadolinium enhancement cardiac MRI for coronary artery disease in patients with reduced left ventricular ejection fraction</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0001-5594-8059</contrib-id><name><surname>Desroche</surname><given-names>Louis-Marie</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref><xref rid="cor1" ref-type="corresp"/></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0002-3434-3584</contrib-id><name><surname>Darmon</surname><given-names>Arthur</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0002-8310-4512</contrib-id><name><surname>Lavie-Badie</surname><given-names>Yoan</given-names></name><xref rid="aff4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0003-2127-7538</contrib-id><name><surname>Mandry</surname><given-names>Damien</given-names></name><xref rid="aff5" ref-type="aff">5</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0003-4069-1128</contrib-id><name><surname>Ducrocq</surname><given-names>Gregory</given-names></name><xref rid="aff6" ref-type="aff">6</xref><xref rid="aff7" ref-type="aff">7</xref><xref rid="aff8" ref-type="aff">8</xref><xref rid="aff9" ref-type="aff">9</xref></contrib><contrib contrib-type="author"><name><surname>Si-Moussi</surname><given-names>Thiziri</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0002-4078-1476</contrib-id><name><surname>Durand-Zaleski</surname><given-names>Isabelle</given-names></name><xref rid="aff10" ref-type="aff">10</xref><xref rid="aff11" ref-type="aff">11</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0009-0003-2205-7489</contrib-id><name><surname>Millischer</surname><given-names>Damien</given-names></name><xref rid="aff12" ref-type="aff">12</xref></contrib><contrib contrib-type="author"><name><surname>Milleron</surname><given-names>Olivier</given-names></name><xref rid="aff6" ref-type="aff">6</xref></contrib><contrib contrib-type="author"><name><surname>Huttin</surname><given-names>Olivier</given-names></name><xref rid="aff13" ref-type="aff">13</xref><xref rid="aff14" ref-type="aff">14</xref><xref rid="aff15" ref-type="aff">15</xref><xref rid="aff16" ref-type="aff">16</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0009-0005-6131-6732</contrib-id><name><surname>Valla</surname><given-names>Mathieu</given-names></name><xref rid="aff17" ref-type="aff">17</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0001-9336-3553</contrib-id><name><surname>Mangin</surname><given-names>Lionel</given-names></name><xref rid="aff18" ref-type="aff">18</xref></contrib><contrib contrib-type="author"><name><surname>Farah</surname><given-names>Bruno</given-names></name><xref rid="aff19" ref-type="aff">19</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0002-6291-7960</contrib-id><name><surname>Diakov</surname><given-names>Christelle</given-names></name><xref rid="aff20" ref-type="aff">20</xref></contrib><contrib contrib-type="author"><name><surname>Logeart</surname><given-names>Damien</given-names></name><xref rid="aff21" ref-type="aff">21</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0009-0004-0736-9887</contrib-id><name><surname>Safar</surname><given-names>Benjamin</given-names></name><xref rid="aff22" ref-type="aff">22</xref></contrib><contrib contrib-type="author"><name><surname>Travers</surname><given-names>Jean-Yves</given-names></name><xref rid="aff23" ref-type="aff">23</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0002-2131-6763</contrib-id><name><surname>Mesnier</surname><given-names>Jules</given-names></name><xref rid="aff6" ref-type="aff">6</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0009-0007-7403-4210</contrib-id><name><surname>Vappereau</surname><given-names>Alexandra</given-names></name><xref rid="aff10" ref-type="aff">10</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0009-0008-0167-5655</contrib-id><name><surname>Alfaiate</surname><given-names>Toni</given-names></name><xref rid="aff24" ref-type="aff">24</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0003-4138-0794</contrib-id><name><surname>Burdet</surname><given-names>Charles</given-names></name><xref rid="aff24" ref-type="aff">24</xref><xref rid="aff25" ref-type="aff">25</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0002-0101-2076</contrib-id><name><surname>Jondeau</surname><given-names>Guillaume</given-names></name><xref rid="aff6" ref-type="aff">6</xref><xref rid="aff7" ref-type="aff">7</xref><xref rid="aff9" ref-type="aff">9</xref></contrib><contrib contrib-type="author"><collab>on behalf of the CAMAREC investigators<contrib-group><contrib contrib-type="collab"><name><surname>Nallet</surname><given-names>Olivier</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Ou</surname><given-names>Phalla</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Venner</surname><given-names>Cl&#x000e9;ment</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Pathak</surname><given-names>Atul</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Benichou</surname><given-names>Maxime</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Aubert</surname><given-names>Rapha&#x000eb;l</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Becker</surname><given-names>Mathieu</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Yassine</surname><given-names>Marwan</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Bayard</surname><given-names>Julien</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Bertrand</surname><given-names>Julien</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Filippetti</surname><given-names>Laura</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Suty-Selton</surname><given-names>Christine</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Belle</surname><given-names>Lo&#x000ef;c</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Zannad</surname><given-names>Noura</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Bouygues</surname><given-names>Matthieu</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Saib</surname><given-names>Anis</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Grigore</surname><given-names>Diana</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Atesler</surname><given-names>Selin</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Darlington</surname><given-names>Meryl</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Corr&#x000e9;</surname><given-names>J&#x000e9;r&#x000f4;me</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Vasram</surname><given-names>Reza Rossanaly</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Boiron</surname><given-names>Philippe</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Perrin</surname><given-names>Romain</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Auclair</surname><given-names>Floriane</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Lallemand</surname><given-names>Clara</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Hourqueig</surname><given-names>Marion</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Savon</surname><given-names>Bertrand Champeau</given-names></name></contrib></contrib-group></collab></contrib><aff id="aff1"><label>1</label><institution content-type="department">Cardiology Department</institution>, <institution>La R&#x000e9;union University Hospital</institution>, <addr-line content-type="city">Saint-Denis</addr-line>, <country>France</country></aff><aff id="aff2"><label>2</label><institution content-type="department">CIC-EC INSERM1410</institution>, <institution>La R&#x000e9;union University Hospital</institution>, <addr-line content-type="city">Saint-Denis</addr-line>, <country>France<
<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Eur J Radiol Open</journal-id><journal-id journal-id-type="iso-abbrev">Eur J Radiol Open</journal-id><journal-title-group><journal-title>European Journal of Radiology Open</journal-title></journal-title-group><issn pub-type="epub">2352-0477</issn><publisher><publisher-name>Elsevier</publisher-name></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41080029</article-id><article-id pub-id-type="pmc">12510051</article-id><article-id pub-id-type="pii">S2352-0477(25)00056-5</article-id><article-id pub-id-type="doi">10.1016/j.ejro.2025.100689</article-id><article-id pub-id-type="publisher-id">100689</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>High performance of low/ultralow-dose photon-counting CT for pulmonary metastasis in young musculoskeletal malignancy patients</article-title></title-group><contrib-group><contrib contrib-type="author" id="au0005"><name><surname>Zhou</surname><given-names>Shanshui</given-names></name><xref rid="aff0005" ref-type="aff">a</xref><xref rid="aff0010" ref-type="aff">b</xref><xref rid="fn1" ref-type="fn">1</xref></contrib><contrib contrib-type="author" id="au0010"><name><surname>Bao</surname><given-names>Qiyuan</given-names></name><xref rid="aff0015" ref-type="aff">c</xref><xref rid="fn1" ref-type="fn">1</xref></contrib><contrib contrib-type="author" id="au0015"><name><surname>Dong</surname><given-names>Haipeng</given-names></name><xref rid="aff0005" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au0020"><name><surname>Li</surname><given-names>Jiqiang</given-names></name><xref rid="aff0005" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au0025"><name><surname>Xu</surname><given-names>Zhihan</given-names></name><xref rid="aff0020" ref-type="aff">d</xref></contrib><contrib contrib-type="author" id="au0030"><name><surname>Du</surname><given-names>Lianjun</given-names></name><xref rid="aff0005" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au0035"><name><surname>Yang</surname><given-names>Wenjie</given-names></name><xref rid="aff0005" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au0040"><name><surname>Lu</surname><given-names>Yong</given-names></name><xref rid="aff0005" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au0045"><name><surname>Zhang</surname><given-names>Weibin</given-names></name><xref rid="aff0015" ref-type="aff">c</xref></contrib><contrib contrib-type="author" id="au0050"><name><surname>Yan</surname><given-names>Fuhua</given-names></name><email>yfh11655@rjh.com.cn</email><xref rid="aff0005" ref-type="aff">a</xref><xref rid="aff0010" ref-type="aff">b</xref><xref rid="cor1" ref-type="corresp">&#x0204e;</xref></contrib><contrib contrib-type="author" id="au0055"><name><surname>Qin</surname><given-names>Le</given-names></name><email>ql11880@rjh.com.cn</email><xref rid="aff0005" ref-type="aff">a</xref><xref rid="cor1" ref-type="corresp">&#x0204e;</xref></contrib><aff id="aff0005"><label>a</label>Department of Radiology, Ruijin Hospital, Shanghai Jiao Tong University School of Medicine, Shanghai, China</aff><aff id="aff0010"><label>b</label>Faculty of Medical Imaging Technology, College of Health Science and Technology, Shanghai Jiao Tong University School of Medicine, Shanghai, China</aff><aff id="aff0015"><label>c</label>Department of Orthopedics, Ruijin Hospital, Shanghai Jiao Tong University School of Medicine, Shanghai, China</aff><aff id="aff0020"><label>d</label>CT Collaboration, Siemens Healthineers, Shanghai, China</aff></contrib-group><author-notes><corresp id="cor1"><label>&#x0204e;</label>Correspondence to: No.197 Ruijin Er Road, Shanghai 200025, China. <email>yfh11655@rjh.com.cn</email><email>ql11880@rjh.com.cn</email></corresp><fn id="fn1"><label>1</label><p id="ntp0025">Shanshui Zhou and Qiyuan Bao made equal contributions to the work.</p></fn></author-notes><pub-date pub-type="pmc-release"><day>27</day><month>9</month><year>2025</year></pub-date><!-- PMC Release delay is 0 months and 0 days and was based on <pub-date
						pub-type="epub">.--><pub-date pub-type="collection"><month>12</month><year>2025</year></pub-date><pub-date pub-type="epub"><day>27</day><month>9</month><year>2025</year></pub-date><volume>15</volume><elocation-id>100689</elocation-id><history><date date-type="received"><day>25</day><month>7</month><year>2025</year></date><date date-type="rev-recd"><day>8</day><month>9</month><year>2025</year></date><date date-type="accepted"><day>23</day><month>9</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; 2025 The Authors. Published by Elsevier Ltd.</copyright-statement><copyright-year>2025</copyright-year><copyright-holder/><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p>This is an open access article under the CC BY-NC-ND license (http://creativecommons.org/licenses/by-nc-nd/4.0/).</license-p></license></permissions><abstract id="ab0010"><sec><title>Purpose</title><p>To investigate the performance of chest photon-counting CT (PCCT) at low-dose (LD) and ultralow-dose (ULD) in young musculoskeletal malignancy patients with pulmonary metastasis and compare with prior standard-dose energy-integrating CT (EICT).</p></sec><sec><title>Materials and methods</title><p>From August to November 2023, this prospective study recruited consecutive participants with prior EICT images and grouped them into LD and ULD groups to receive PCCT examination. Two observers independently and blindly evaluated the image quality using a five-point Likert scale. Intraindividual differences between PCCT and EICT were compared using the Wilcoxon signed-rank test or paired samples <italic>t</italic>-test.</p></sec><sec><title>Results</title><p>The LD and ULD groups included 50 (19 [16; 21] years; 33 males) and 50 participants (19 [14; 21] years; 30 males), respectively. The interval between EICT and PCCT examinations was 116 (88.5; 194) days. Compared with EICT, PCCT obtained median effective dose reduction rates of 87.62&#x0202f;% (3.78 [3.15; 5.18] vs. 0.43 [0.39; 0.58] mSv; <italic>p</italic>&#x0202f;&#x0003c;&#x0202f;0.001) and 92.58&#x0202f;% (3.92 [2.96; 4.95] vs. 0.27 [0.22; 0.34] mSv; <italic>p</italic>&#x0202f;&#x0003c;&#x0202f;0.001) in the LD and ULD groups, respectively. For subjective assessments, PCCT has superior overall image quality (5 [5; 5] vs. 5 [4; 5]) and lung nodule visualization (5 [5; 5] vs. 5 [4; 5]) to EICT (all <italic>p</italic>-values &#x0003c;0.001).</p></sec><sec><title>Conclusion</title><p>PCCT provided higher image quality and lung nodule visualization with significant dose reduction compared to EICT in these young musculoskeletal malignancy patients.</p></sec></abstract><abstract abstract-type="author-highlights" id="ab0015"><title>Highlights</title><p><list list-type="simple" id="li0005"><list-item id="u0005"><label>&#x02022;</label><p id="p0005">Compared with clinical energy-integrating CT (EICT), photon-counting CT (PCCT) obtained a 90.55 % effective dose reduction rate.</p></list-item><list-item id="u0010"><label>&#x02022;</label><p id="p0010">PCCT exhibited higher edge sharpness for lung nodules/masses than EICT.</p></list-item><list-item id="u0015"><label>&#x02022;</label><p id="p0015">PCCT images showed superior overall image quality and visualization of lung nodules compared with EICT.</p></list-item></list></p></abstract><kwd-group id="keys0010"><title>Keywords</title><kwd>Photon-counting CT</kwd><kwd>Low radiation dose CT</kwd><kwd>Musculoskeletal malignancy</kwd><kwd>Metastasis</kwd><kwd>Lung nodules</kwd></kwd-group></article-meta><def-list><title>Abbreviations</title><def-item><term id="key0010">LNOMs</term><def><p>lung nodules or masses</p></def></def-item><def-item><term id="key0020">PCCT</term><def><p>photon-counting CT</p></def></def-item><def-item><term id="key0030">EICT</term><def><p>energy-integrating CT</p></def></def-item><def-item><term id="key0040">LD</term><def><p>low-dose</p></def></def-item><def-item><term id="key0050">ULD</term><def><p>ultralow-dose</p></def></def-item><def-item><term id="key0060">CNR</term><def><p>contrast&#x02013;noise ratio</p></def></def-item><def-item><term id="key0070">SNR</term><def><p>signal&#x02013;noise ratio</p></def></def-item><def-item><term id="key0080">FOM</term><def><p>figure of merit</p></def></def-item><def-item><term id="key0090">CTDI<sub>vol</sub></term><def><p>CT dose index volume</p></def></def-item><def-item><term id="key0100">DLP</term><def><p>dose length product</p></def></def-item><def-item><term id="key0110">ED</term><def><p>effective dose</p></def></def-item></def-list></front><body><sec id="sec0005"><label>1</label><title>Introduction</title><p id="p0025">Malignant musculoskeletal (MSK) tumors account for approximately 10&#x0202f;% of newly diagnosed cancers in children, adolescents, and young adults (AYA) <xref rid="bib1" ref-type="bibr">[1]</xref>. Metastasis disease significantly impacts the management and prognosis in these patients <xref rid="bib2" ref-type="bibr">[2]</xref>. Many present with pulmonary metastasis at diagnosis or treatment and hence demonstrate only 21&#x0202f;% 5-year survival rates <xref rid="bib3" ref-type="bibr">[3]</xref>, <xref rid="bib4" ref-type="bibr">[4]</xref>. Nevertheless, recent treatment options provide improved survival for patients with resectable pulmonary metastasis <xref rid="bib5" ref-type="bibr">[5]</xref>, <xref rid="bib6" ref-type="bibr">[6]</xref>. Thus, regular chest CT follow-up is crucial in the early detection of pulmonary metastasis, thereby guiding clinical management and potentially improving survival <xref rid="bib7" ref-type="bibr">[7]</xref>.</p><p id="p0030">Although chest CT with a standard radiation dose (SRD) can sensitively detect lung nodules or masses (LNOMs), its high radiation exposure may cause many adverse events, such as secondary cancer, genotoxic effects, and growth impairment, particularly in children and AYA <xref rid="bib8" ref-type="bibr">[8]</xref>, <xref rid="bib9" ref-type="bibr">[9]</xref>. Using low-dose (LD) CT to achieve high image quality and clear visualization of metastatic LNOMs in these patient populations is therefore important <xref rid="bib10" ref-type="bibr">[10]</xref>. Early studies that employed LD energy-integrating CT (EICT) showed high sensitivity in LNOM detection <xref rid="bib11" ref-type="bibr">[11]</xref>, <xref rid="bib12" ref-type="bibr">[12]</xref>. However, the image quality was relatively poor because of imaging technology limitations. Furthermore, in recent years, advanced iterative reconstruction and deep-learning algorithms have been developed to improve image quality, which is accompanied by additional artifacts, such as calcification-mimicking and smoothing artifacts, loss of spatial resolution, or reduced image fidelity <xref rid="bib13" ref-type="bibr">[13]</xref>, <xref rid="bib14" ref-type="bibr">[14]</xref>.</p><p id="p0035">Early studies suggested that photon-counting CT (PCCT) enables higher image quality at lower doses than EICT <xref rid="bib15" ref-type="bibr">[15]</xref>. Photon-counting detector (PCD) can detect individual X-ray photons and convert them into electrical signals directly <xref rid="bib16" ref-type="bibr">[16]</xref>. Thus, additional separation layers between individual detector cells used to prevent optical crosstalk are not required, leading to improved geometrical dose efficiency and smaller pixel size with increased spatial resolution <xref rid="bib17" ref-type="bibr">[17]</xref>. Furthermore, PCCT could filter out low energy-level baseline noise by setting a signal threshold, resulting in less image noise and streak artifacts and more stable CT values compared with EICT <xref rid="bib18" ref-type="bibr">[18]</xref>. These advantages render it possible to use lower radiation doses to achieve higher image quality on PCCT. However, its performance in LNOM visualization for children and AYA remains unknown.</p><p id="p0040">Thus, we hypothesized that PCCT may provide clear LNOM visualization and high image quality while significantly reducing radiation doses compared to SRD-EICT. This study aimed to explore the performance of using LD/ultralow-dose (ULD) chest imaging acquired by PCCT to identify LNOMs in children and AYA with malignant MSK tumors and to investigate intraindividual differences between LD/ULD images from PCCT and SRD images from EICT.</p></sec><sec id="sec0010"><label>2</label><title>Materials and methods</title><p id="p0045">The ethics committee of our institution approved this prospective study (<italic>Number: KY2023&#x02013;186</italic>). Written informed consent was obtained from all participants or their guardians.</p><sec id="sec0015"><label>2.1</label><title>Participants</title><p id="p0050">From August to November 2023, this study recruited 112 consecutive participants. The inclusion criteria included participants (1) aged &#x02264;&#x0202f;30 years, (2) with pathologically diagnosed MSK malignant tumors, (3) underwent clinical non-contrast enhancement thoracic EICT examination and found lung nodule, and (4) showed stable disease according to the Response Evaluation Criteria in Solid Tumors (RECIST) 1.1 guideline <xref rid="bib19" ref-type="bibr">[19]</xref>. The exclusion criteria included participants (1) with severe pneumonia that impacted lung nodule observation on CT images (n&#x0202f;=&#x0202f;3), and (2) who underwent partial lobectomy between the included EICT and PCCT examinations (n&#x0202f;=&#x0202f;3).</p><p id="p0055">Participants were randomly allocated to the LD or ULD group using block randomization with a computer-generated random number sequence in a 1:1 ratio to undergo chest PCCT scans. Participants and researchers involved in image analysis were blinded to group allocation, whereas radiographers performing the scans were aware of the assigned protocols. The PCCT examinations were performed as the patients&#x02019; routine chest CT follow-up, and the interval from the most recent EICT examination was consistent with the follow-up interval recommended by the European Society for Medical Oncology (ESMO) guidelines (2021 version; every 3, 6, and 6&#x02013;12 months) <xref rid="bib10" ref-type="bibr">[10]</xref>. The flow chart of participant enrollment is shown in <xref rid="fig0005" ref-type="fig">Fig. 1</xref>.<fig id="fig0005"><label>Fig. 1</label><caption><p>Participant enrollment flowchart. LD =&#x02009;low-dose; ULD =&#x02009;ultralow-dose.</p></caption><alt-text id="at0005">Fig. 1</alt-text><graphic xlink:href="gr1" id="lk0005"/></fig></p></sec><sec id="sec0020"><label>2.2</label><title>CT acquisition and reconstruction</title><p id="p0060">All EICT images prior to PCCT scanning were retrospectively obtained with SRD in accordance with national diagnostic reference levels in our institution <xref rid="bib20" ref-type="bibr">[20]</xref>. The CT scan intervals were determined following the clinical practice guidelines of the ESMO <xref rid="bib10" ref-type="bibr">[10]</xref>. All EICT images were reconstructed with a slice thickness of 1.0 or 1.25&#x02009;mm, utilizing iterative reconstruction algorithms. The detailed acquisition and reconstruction parameters of the employed EICT scanners are listed in <xref rid="sec0080" ref-type="fn">eTable 1</xref>.</p><p id="p0065">Participants underwent unenhanced thoracic CT examinations using a dual-source PCCT system (NAEOTOM Alpha, software version VA50, Siemens Healthineers, Forchheim, Germany). The scanning parameters on PCCT were as follows: voltage, 100&#x02009;kV with tin filter; pitch, 3.2; collimation, 144&#x02009;&#x000d7;&#x02009;0.40&#x02009;mm; rotation time, 0.25&#x02009;s. The CARE Dose4D image quality levels (IQ level) of 16 and 10 were chosen for the LD and ULD groups according to our own clinical experiences, respectively. The CT dose index volume (CTDI<sub>vol</sub>) and dose length product (DLP) were recorded. The effective dose (ED) was estimated by DLP multiplied by 0.0144, 0.0235, and 0.0322, based on the age of participants <xref rid="bib21" ref-type="bibr">[21]</xref>. Using monoenergetic images, all images were reconstructed at 73&#x02009;keV by default. The reconstructed slice thicknesses/increments were 1.0/0.7&#x02009;mm with the kernel of Bl60 for the lung window and bone window images and 5.0/5.0&#x02009;mm with Br40 for the mediastinum window images. A quantum iterative reconstruction (QIR) strength level of four was used. The reconstructed field of view was 300&#x02009;&#x000d7;&#x02009;300&#x02009;mm<sup>2</sup> and the matrix was 768<sup>2</sup> pixels for lung window and 512<sup>2</sup> pixels for mediastinum window images.</p></sec><sec id="sec0025"><label>2.3</label><title>CT image analysis</title><p id="p0070">The CT images were anonymized, and the observers were blinded to participant identity and scanner information. To further minimize recall bias, the images were randomly presented for analysis. The objective evaluation was conducted on lung window images (level/width: &#x02212;600/1500 HU) by a radiologist (<underline>L.Q.</underline> with 11 years of experience). The image noise, contrast&#x02013;noise ratio (CNR), signal&#x02013;noise ratio (SNR), and edge sharpness of the maximum LNOM were measured. Furthermore, to normalize CNR to ED, a figure of merit for CNR (FOM<sub>CNR</sub>) was calculated <xref rid="bib22" ref-type="bibr">[22]</xref>. To determine the dose efficiency of PCCT over EICT, the dose-saving potential (&#x003b7;) was calculated <xref rid="bib23" ref-type="bibr">[23]</xref>. Additionally, the overall image quality; motion artifact reduction; demonstration of the three largest lung nodules, lung markings, mediastinal lymph nodes, aorta, and thoracic skeleton; and differentiation between calcified and solid components within the same LNOM were subjectively assessed using the five-point Likert scale (<xref rid="sec0080" ref-type="fn">eTable 2</xref>) by two observers (<underline>L.Q.</underline> with 11 and <underline>W.Y.</underline> with 22 years of experience). The detailed analysis method is described in <bold>Appendix 1</bold>.</p></sec><sec id="sec0030"><label>2.4</label><title>Statistical analysis</title><p id="p0075">The Kolmogorov&#x02013;Smirnov test was used to evaluate the data normality. Continuous variables with normal distributions were presented as mean (&#x000b1; standard deviation [SD]), whereas nonparametric and categorical variables were presented as median (interquartile range [IQR]) and as absolute numbers with percentages. Intergroup comparisons in the LD and ULD groups were tested using the independent samples <italic>t</italic>-test, Mann&#x02013;Whitney <italic>U</italic> test, and chi-squared test as appropriate. To compare the differences in radiation doses and image assessments between PCCT and EICT for nonparametric data and categorical data, the Wilcoxon signed-rank test was performed, whereas the paired samples <italic>t</italic>-test was used for variables with normal distribution. Interobserver agreement in subjective assessments was evaluated using Cohen&#x02019;s Kappa test. Kappa values and the corresponding agreement are as follows: &#x0003c;&#x02009;0, poor; 0.00&#x02013;0.20, slight; 0.21&#x02013;0.40, fair; 0.41&#x02013;0.60, moderate; 0.61&#x02013;0.80, good; and 0.81&#x02013;1, excellent <xref rid="bib24" ref-type="bibr">[24]</xref>. All statistical analyses were conducted using the R software (version 4.3.0) and statistical significance was set at <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.05. Employed R packages are shown in <xref rid="sec0080" ref-type="fn">eTable 3</xref>.</p></sec></sec><sec id="sec0035"><label>3</label><title>Results</title><sec id="sec0040"><label>3.1</label><title>Participant demographics</title><p id="p0080">A total of 100 children and AYA (63 male and 37 female) with ages ranging from 9 to 30 years were enrolled and divided into the LD group (33 males; 19.0 [16.0; 21.0] years) and ULD group (30 males; 19.0 [14.2; 21.0] years) (<xref rid="tbl0005" ref-type="table">Table 1</xref>). These participants were pathologically diagnosed with osteosarcoma (91 cases), Ewing sarcoma (four cases), synovial sarcoma (three cases), CIC-rearranged sarcoma (one case), and myxofibrosarcoma (one case). After being diagnosed with pulmonary metastasis, 39 participants underwent lobectomy or segmentectomy. The interval between EICT and PCCT scans was 116 (88.5; 194) days.<table-wrap position="float" id="tbl0005"><label>Table 1</label><caption><p>Demographic profile and radiation dose parameters of participants.</p></caption><alt-text id="at0035">Table 1</alt-text><table frame="hsides" rules="groups"><thead><tr><th><hr/></th><th><bold>All participants</bold><hr/></th><th><bold>LD</bold><hr/></th><th><bold>ULD</bold><hr/></th><th><hr/></th></tr><tr><th/><th><italic><bold>N&#x02009;=&#x02009;100</bold></italic></th><th><italic><bold>N&#x02009;=&#x02009;50</bold></italic></th><th><italic><bold>N&#x02009;=&#x02009;50</bold></italic></th><th><italic><bold>p-value</bold></italic></th></tr></thead><tbody><tr><td>No. of gender, n</td><td/><td/><td/><td>0.70</td></tr><tr><td>female</td><td>37 (37&#x02009;%)</td><td>17 (34&#x02009;%)</td><td>20 (40&#x02009;%)</td><td/></tr><tr><td>male</td><td>63 (63&#x02009;%)</td><td>33 (66&#x02009;%)</td><td>30 (60&#x02009;%)</td><td/></tr><tr><td>Age, years</td><td>19.0 (15.0; 21.0)</td><td>19.0 (16.0; 21.0)</td><td>19.0 (14.2; 21.0)</td><td>0.98</td></tr><tr><td>Body mass index</td><td>20.0&#x02009;&#x000b1;&#x02009;3.79</td><td>20.0&#x02009;&#x000b1;&#x02009;3.73</td><td>19.9&#x02009;&#x000b1;&#x02009;3.89</td><td>0.90</td></tr><tr><td>No. of primary tumor, n</td><td/><td/><td/><td>&#x0003e;&#x02009;0.99</td></tr><tr><td>osteosarcoma</td><td>91 (91&#x02009;%)</td><td>45 (90&#x02009;%)</td><td>46 (92&#x02009;%)</td><td/></tr><tr><td>Ewing sarcoma</td><td>4 (4&#x02009;%)</td><td>2 (4&#x02009;%)</td><td>2 (4&#x02009;%)</td><td/></tr><tr><td>synovial sarcoma</td><td>3 (3&#x02009;%)</td><td>2 (4&#x02009;%)</td><td>1 (2&#x02009;%)</td><td/></tr><tr><td>CIC-rearranged sarcoma</td><td>1 (1&#x02009;%)</td><td>0</td><td>1 (2&#x02009;%)</td><td/></tr><tr><td>myxofibrosarcoma</td><td>1 (1&#x02009;%)</td><td>1 (2&#x02009;%)</td><td>0</td><td/></tr><tr><td>No. of subjected to PL, n</td><td/><td/><td/><td>0.41</td></tr><tr><td>yes</td><td>39 (39&#x02009;%)</td><td>17 (34&#x02009;%)</td><td>22 (44&#x02009;%)</td><td/></tr><tr><td>no</td><td>61 (61&#x02009;%)</td><td>33 (66&#x02009;%)</td><td>28 (56&#x02009;%)</td><td/></tr><tr><td>Measured LNOM size, mm</td><td>4.28 (3.47; 5.24)</td><td>4.20 (3.45; 5.25)</td><td>4.37 (3.58; 5.24)</td><td>0.62</td></tr><tr><td>Tube current, mAs</td><td/><td/><td/><td/></tr><tr><td>PCCT</td><td>74.5 (54.8; 96.0)</td><td>94.5 (79.5; 107)</td><td>55.5 (42.0; 67.0)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl1fn1" ref-type="table-fn">*</xref></td></tr><tr><td>EICT</td><td>92 (75.5; 111)</td><td>92 (78; 111)</td><td>92 (73.75; 111.25)</td><td>0.82</td></tr><tr><td>CT Dose Index volume, mGy</td><td/><td/><td/><td/></tr><tr><td>PCCT</td><td>0.62 (0.46; 0.79)</td><td>0.78 (0.66; 0.89)</td><td>0.46 (0.35; 0.56)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl1fn1" ref-type="table-fn">*</xref></td></tr><tr><td>EICT</td><td>6.80 (5.14; 7.63)</td><td>6.80 (5.31; 7.62)</td><td>6.50 (5.02; 7.63)</td><td>0.71</td></tr><tr><td>Dose length product, mGy<xref rid="tbl1fn1" ref-type="table-fn">*</xref>cm</td><td/><td/><td/><td/></tr><tr><td>PCCT</td><td>21.2 (15.6; 28.6)</td><td>28.6 (24.6; 31.7)</td><td>16.1 (11.7; 20.0)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl1fn1" ref-type="table-fn">*</xref></td></tr><tr><td>EICT</td><td>235 (184; 277)</td><td>234 (190; 271)</td><td>235 (176; 283)</td><td>0.92</td></tr><tr><td>Effective dose, mSv</td><td/><td/><td/><td/></tr><tr><td>PCCT</td><td>0.38 (0.27; 0.46)</td><td>0.43 (0.39; 0.58)</td><td>0.27 (0.22; 0.34)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl1fn1" ref-type="table-fn">*</xref></td></tr><tr><td>EICT</td><td>3.86 (3.06; 5.08)</td><td>3.78 (3.15; 5.18)</td><td>3.92 (2.96; 4.95)</td><td>0.72</td></tr><tr><td>Effective dose reduction, %</td><td>90.55 (87.11; 93.00)</td><td>87.62 (85.18; 90.72)</td><td>92.58 (90.40; 94.19)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl1fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Interval&#x02020;, days</td><td>116 (88.5; 194)</td><td>101 (69.2; 184)</td><td>134 (91; 232)</td><td>0.12</td></tr></tbody></table><table-wrap-foot><fn id="tbl1fn1"><label>*</label><p id="ntp0005">with significant difference; &#x02020; Time interval between the EICT and PCCT examination; LD =&#x02009;low-dose; ULD =&#x02009;ultralow-dose; PL =&#x02009;partial lobectomy.</p></fn></table-wrap-foot></table-wrap></p></sec><sec id="sec0045"><label>3.2</label><title>Radiation dose</title><p id="p0085">The PCCT showed lower CTDI<sub>vol</sub> (0.62 [0.46; 0.79] mGy vs. 6.80 [5.14; 7.63] mGy), DLP (21.2 [15.6; 28.6] mGy*cm vs. 235 [184; 277] mGy*cm), and ED (0.38 [0.27; 0.46] mSv vs. 3.86 [3.06; 5.08] mSv) compared to EICT with statistical differences (all <italic>p</italic>-values &#x0003c;0.001). The median (IQR) of the ED reduction rate of PCCT compared to EICT was 90.55&#x02009;% (87.11&#x02009;%; 93.00&#x02009;%). In the LD and ULD groups, the CTDI<sub>vol</sub> of PCCT (0.78 [0.66; 0.89] and 0.46 [0.35; 0.56] mGy) was significantly lower than that of EICT (6.80 [5.31; 7.62] and 6.50 [5.02; 7.63] mGy; all <italic>p</italic>-values &#x0003c; 0.001). Significantly lower values of ED were observed in the PCCT (0.43 [0.39; 0.58] and 0.27 [0.22; 0.34] mSv) compared with those of EICT (3.78 [3.15; 5.18] and 3.92 [2.96; 4.95] mSv) in the LD and ULD groups, respectively (all <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). The ED reduction rates of PCCT compared to EICT in the LD and ULD groups were 87.62&#x02009;% (85.18&#x02009;%; 90.72&#x02009;%) and 92.58&#x02009;% (90.40; 94.19&#x02009;%), respectively (<xref rid="tbl0005" ref-type="table">Table 1</xref>). <xref rid="fig0010" ref-type="fig">Fig. 2</xref> shows the paired differences in CTDI<sub>vol</sub> and ED values between the PCCT and EICT in the two groups.<fig id="fig0010"><label>Fig. 2</label><caption><p>Boxplots show paired CTDI<sub>vol</sub> (a) and effective dose (b) values of PCCT and EICT. LD =&#x02009;low-dose; ULD =&#x02009;ultralow-dose; CTDI<sub>vol</sub> =&#x02009;CT dose index volume.</p></caption><alt-text id="at0010">Fig. 2</alt-text><graphic xlink:href="gr2" id="lk0010"/></fig></p></sec><sec id="sec0050"><label>3.3</label><title>CT image analysis</title><p id="p0090">For the overall objective results, PCCT images showed higher image noise (69.8&#x02009;&#x000b1;&#x02009;11.6 HU vs. 57.9&#x02009;&#x000b1;&#x02009;16.9 HU; <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001) and lower LNOM CNR (17.6 [14.5; 23.6] vs. 20.7 [15.6; 27.9]; <italic>p</italic>&#x02009;=&#x02009;0.002) compared to EICT images. There is no statistical difference in LNOM SNR between PCCT and EICT images (2.58 [1.79; 3.54] vs. 2.29 [1.35; 3.29]; <italic>p</italic>&#x02009;=&#x02009;0.26). The FOM<sub>CNR</sub> (1112 [673; 2143] vs. 146 [78.9; 242]) and edge sharpness for the maximum LNOM (564 [463; 742] vs. 438 [354; 575] &#x025b3;HU/pixel) are higher in PCCT images than EICT (all <italic>p</italic>-values &#x0003c; 0.001) (<xref rid="tbl0010" ref-type="table">Table 2</xref>).<table-wrap position="float" id="tbl0010"><label>Table 2</label><caption><p>Overall objective evaluation results of PCCT and EICT.</p></caption><alt-text id="at0040">Table 2</alt-text><table frame="hsides" rules="groups"><thead><tr><th><hr/></th><th><bold>PCCT</bold><hr/></th><th><bold>EICT</bold><hr/></th><th><hr/></th></tr><tr><th/><th><italic><bold>N&#x02009;=&#x02009;100</bold></italic></th><th><italic><bold>N&#x02009;=&#x02009;100</bold></italic></th><th><italic><bold>p-value</bold></italic></th></tr></thead><tbody><tr><td>Noise, HU</td><td>69.8&#x02009;&#x000b1;&#x02009;11.6</td><td>57.9&#x02009;&#x000b1;&#x02009;16.9</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl2fn1" ref-type="table-fn">*</xref></td></tr><tr><td>CNR</td><td>17.6 (14.5; 23.6)</td><td>20.7 (15.6; 27.9)</td><td>0.002<xref rid="tbl2fn1" ref-type="table-fn">*</xref></td></tr><tr><td>SNR</td><td>2.58 (1.79; 3.54)</td><td>2.29 (1.35; 3.29)</td><td>0.26</td></tr><tr><td>FOM<sub>CNR</sub></td><td>1112 (673; 2143)</td><td>146 (78.9; 242)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl2fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Sharpness, &#x00394;HU/pixel</td><td>564 (463; 742)</td><td>438 (354; 575)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl2fn1" ref-type="table-fn">*</xref></td></tr></tbody></table><table-wrap-foot><fn id="tbl2fn1"><label>*</label><p id="ntp0010">with significant difference; CNR =&#x02009;contrast-noise ratio; SNR =&#x02009;signal-noise ratio; FOM<sub>CNR</sub> =&#x02009;figure of merit for CNR.</p></fn></table-wrap-foot></table-wrap></p><p id="p0095">For the subgroup objective evaluation results, the image noise of PCCT was higher than EICT in the LD (65.5&#x02009;&#x000b1;&#x02009;10.3 HU vs. 57.0&#x02009;&#x000b1;&#x02009;16.2 HU; <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001) and ULD (75.3 [64.8; 83.0] HU vs. 61.0 [47.8; 69.2] HU; <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001) groups. Regarding the visualization of LNOMs, PCCT and EICT images showed similar CNR (18.9 [16.3; 24.1] vs. 19.7 [14.9; 26.9]; <italic>p</italic>&#x02009;=&#x02009;0.40) and SNR (2.36 [1.71; 3.54] vs. 2.01 [1.25; 3.06]; <italic>p</italic>&#x02009;=&#x02009;0.17) in the LD group. In the ULD group, PCCT exhibited an inferior LNOM CNR (16.9 [14.3; 22.1] vs. 22.4 [15.7; 28.2]; <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001) and a similar SNR (2.72 [1.87; 3.43] vs. 2.70 [1.80; 3.48]; <italic>p</italic>&#x02009;=&#x02009;0.83) compared to EICT. The FOM<sub>CNR</sub> of LD-PCCT is superior to EICT (965 [628; 1601] vs. 129 [67.1; 279]; <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). This trend is also found in the ULD group. PCCT and EICT respectively have a FOM<sub>CNR</sub> of 1478 (890; 2441) and 153 (92.2; 222) with a statistical disparity (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). In the LD and ULD groups, the edge sharpness for the maximum LNOM of PCCT (546 [448; 742] and 601 [474; 748] &#x025b3;HU/pixel) was significantly higher than that of EICT (428 [343; 548] and 453 [366; 617] &#x025b3;HU/pixel), all <italic>p</italic>-values &#x0003c;&#x02009;0.001 (<xref rid="tbl0015" ref-type="table">Table 3</xref>). The &#x003b7; of PCCT over EICT in the LD and ULD groups were 86.39&#x02009;% (82.71&#x02009;%; 89.16&#x02009;%) and 90.75&#x02009;% (88.32&#x02009;%; 92.18&#x02009;%), respectively.<table-wrap position="float" id="tbl0015"><label>Table 3</label><caption><p>Subgroup objective evaluation results of PCCT and EICT.</p></caption><alt-text id="at0045">Table 3</alt-text><table frame="hsides" rules="groups"><thead><tr><th><hr/></th><th><bold>LD group</bold><hr/></th><th><hr/></th><th><hr/></th><th><bold>ULD group</bold><hr/></th><th><hr/></th><th><hr/></th></tr><tr><th/><th><bold>PCCT</bold></th><th><bold>EICT</bold></th><th><italic><bold>p-value</bold></italic></th><th><bold>PCCT</bold></th><th><bold>EICT</bold></th><th><italic><bold>p-value</bold></italic></th></tr></thead><tbody><tr><td>Noise, HU</td><td>65.5&#x02009;&#x000b1;&#x02009;10.3</td><td>57.0&#x02009;&#x000b1;&#x02009;16.2</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl3fn1" ref-type="table-fn">*</xref></td><td>75.3 (64.8; 83.0)</td><td>61.0 (47.8; 69.2)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl3fn1" ref-type="table-fn">*</xref></td></tr><tr><td>CNR</td><td>18.9 (16.3; 24.1)</td><td>19.7 (14.9; 26.9)</td><td>0.40</td><td>16.9 (14.3; 22.1)</td><td>22.4 (15.7; 28.2)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl3fn1" ref-type="table-fn">*</xref></td></tr><tr><td>SNR</td><td>2.36 (1.71; 3.54)</td><td>2.01 (1.25; 3.06)</td><td>0.17</td><td>2.72 (1.87; 3.43)</td><td>2.70 (1.80; 3.48)</td><td>0.83</td></tr><tr><td>FOM<sub>CNR</sub></td><td>965 (628; 1601)</td><td>129 (67.1; 279)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl3fn1" ref-type="table-fn">*</xref></td><td>1478 (890; 2441)</td><td>153 (92.2; 222)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl3fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Sharpness, &#x025b3;HU/pixel</td><td>546 (448; 742)</td><td>428 (343; 548)</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl3fn1" ref-type="table-fn">*</xref></td><td>601 (474; 748)</td><td>453 (366; 617)</td><td>0.001<xref rid="tbl3fn1" ref-type="table-fn">*</xref></td></tr></tbody></table><table-wrap-foot><fn id="tbl3fn1"><label>*</label><p id="ntp0015">with significant difference; LD =&#x02009;low-dose; ULD =&#x02009;ultralow-dose; CNR =&#x02009;contrast-noise ratio; SNR =&#x02009;signal-noise ratio; FOM<sub>CNR</sub> =&#x02009;figure of merit for CNR.</p></fn></table-wrap-foot></table-wrap></p><p id="p0100">The overall and subgroup percentages of the stacked column charts of the subjective assessment scores are provided in <xref rid="fig0015" ref-type="fig">Fig. 3</xref> and <xref rid="sec0080" ref-type="fn">eFigure 1</xref>. In detail, the median (IQR) of subjective evaluation scores for overall image quality, motion artifact reduction, and visualization of the thoracic skeleton and the three lung nodules on PCCT images were all rated 5 (5; 5). These values were 5 (4; 5), 4 (3; 4), 5 (5; 5), 5 (5; 5), 5 (4; 5), 5 (4; 5) on the EICT images, respectively (<xref rid="sec0085" ref-type="sec">eTable 4</xref>). In these assessments, PCCT is superior to EICT, and statistically significant differences were observed (all <italic>p</italic>-values &#x0003c; 0.05). Additionally, the aorta display (5 [4; 5] vs. 4 [4; 5]) and the differentiation of calcified and solid parts within the same LNOMs (5 [4; 5] vs. 4 [4; 5]) were superior in PCCT than EICT (all <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.05). However, the PCCT images provided an inferior exhibition of lung markings (3 [3; 4] vs. 5 [4; 5]) and mediastinal lymph nodes (4 [4; 5] vs. 5 [4; 5]) compared with EICT (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.05). The kappa values for each subjective evaluation exceeded 0.60 at PCCT and EICT, illustrating substantial interobserver agreement between the two observers (<xref rid="tbl0020" ref-type="table">Table 4</xref>). <xref rid="fig0020" ref-type="fig">Fig. 4</xref><bold>,</bold>
<xref rid="fig0025" ref-type="fig">Fig. 5</xref><bold>,</bold> and <xref rid="sec0080" ref-type="fn">eFigure 2</xref> display matched lung nodules on PCCT and EICT images. <xref rid="fig0030" ref-type="fig">Fig. 6</xref> presents the thoracic skeleton and mediastinal lymph nodes of matched participants on PCCT and EICT images.<fig id="fig0015"><label>Fig. 3</label><caption><p>The percent stacked column chart for all subjective evaluations. ^ The combined results for the three lung nodules; * the differentiation of calcified and solid parts within one same lung nodules or masses; ob =&#x02009;observer; NA =&#x02009;not applicable.</p></caption><alt-text id="at0015">Fig. 3</alt-text><graphic xlink:href="gr3" id="lk0015"/></fig><table-wrap position="float" id="tbl0020"><label>Table 4</label><caption><p>Overall subjective evaluation results of each observer.</p></caption><alt-text id="at0050">Table 4</alt-text><table frame="hsides" rules="groups"><thead><tr><th><hr/></th><th><bold>PCCT</bold><sup>ob1</sup><hr/></th><th><bold>PCCT</bold><sup>ob2</sup><hr/></th><th><hr/></th><th><bold>EICT</bold><sup>ob1</sup><hr/></th><th><bold>EICT</bold><sup>ob2</sup><hr/></th><th><hr/></th><th><hr/></th><th><hr/></th></tr><tr><th/><th><italic><bold>N&#x02009;=&#x02009;100</bold></italic></th><th><italic><bold>N&#x02009;=&#x02009;100</bold></italic></th><th><italic><bold>Kappa</bold></italic></th><th><italic><bold>N&#x02009;=&#x02009;100</bold></italic></th><th><italic><bold>N&#x02009;=&#x02009;100</bold></italic></th><th><italic><bold>Kappa</bold></italic></th><th><italic><bold>p-value</bold></italic><sup><italic>a</italic></sup></th><th><italic><bold>p-value</bold></italic><sup><italic>b</italic></sup></th></tr></thead><tbody><tr><td>Overall image quality</td><td>5 (5; 5)</td><td>5 (5; 5)</td><td align="char">0.884</td><td>5 (4; 5)</td><td>5 (4; 5)</td><td align="char">0.819</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Lung markings</td><td>3 (3; 4)</td><td>3 (3; 4)</td><td align="char">0.756</td><td>5 (4; 5)</td><td>5 (4; 5)</td><td align="char">0.652</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Motion artifacts</td><td>5 (5; 5)</td><td>5 (5; 5)</td><td align="char">0.855</td><td>4 (3; 4)</td><td>3 (3; 4)</td><td align="char">0.738</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Mediastinal lymph nodes</td><td>4 (4; 5)</td><td>4 (4; 5)</td><td align="char">0.826</td><td>5 (4; 5)</td><td>5 (4; 5)</td><td align="char">0.744</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Aorta</td><td>5 (4; 5)</td><td>5 (4; 5)</td><td align="char">0.803</td><td>5 (4; 5)</td><td>4 (4; 5)</td><td align="char">0.737</td><td>0.14</td><td>0.06</td></tr><tr><td>Thoracic skeleton</td><td>5 (5; 5)</td><td>5 (5; 5)</td><td align="char">0.662</td><td>5 (5; 5)</td><td>5 (5; 5)</td><td align="char">0.760</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Lung nodule1</td><td>5 (5; 5)</td><td>5 (5; 5)</td><td align="char">0.821</td><td>5 (5; 5)</td><td>5 (5; 5)</td><td align="char">0.753</td><td>0.002<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Lung nodule2</td><td>5 (5; 5)</td><td>5 (5; 5)</td><td align="char">0.852</td><td>5 (4; 5)</td><td>5 (4; 5)</td><td align="char">0.858</td><td>0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Lung nodule3</td><td>5 (5; 5)</td><td>5 (5; 5)</td><td align="char">0.864</td><td>5 (4; 5)</td><td>5 (4; 5)</td><td align="char">0.942</td><td>&#x0003c;&#x02009;0.001<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td><td>0.008<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td></tr><tr><td>Calcified/solid differentiation&#x02020;</td><td>5 (4; 5)</td><td>5 (4; 5)</td><td align="char">0.894</td><td>4 (4; 5)</td><td>4 (3; 5)</td><td align="char">0.950</td><td>0.005<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td><td>0.008<xref rid="tbl4fn1" ref-type="table-fn">*</xref></td></tr></tbody></table><table-wrap-foot><fn id="tbl4fn1"><label>*</label><p id="ntp0020">with significant difference; &#x02020; Differentiation of calcified and solid parts within the same lung nodules or masses; <sup>ob1</sup> =&#x02009;observer 1; <sup>ob2</sup> =&#x02009;observer 2; <sup>a</sup>, PCCT <sup>ob1</sup> compared with EICT <sup>ob1</sup>; <sup>b</sup>, PCCT <sup>ob2</sup> compared with EICT <sup>ob2</sup>.</p></fn></table-wrap-foot></table-wrap><fig id="fig0020"><label>Fig. 4</label><caption><p>Matched axial CT images of calcified (a, b), solid (c, d), and ground-glass (e, f) lung nodules with diameters of 3&#x02013;6&#x02009;mm. In the ULD (a, c, e) and LD (b, d, f) groups, PCCT images (right) exhibited sharper and clearer lung nodules (arrowhead) than EICT images (left). All images were viewed with lung window (level/width: &#x02212;600/1500 HU). Participant information: a, 19-year-old man; b, 22-year-old man; c, 23-year-old man; d, 24-year-old man; e, 22-year-old woman; f, 12-year-old man.</p></caption><alt-text id="at0020">Fig. 4</alt-text><graphic xlink:href="gr4" id="lk0020"/></fig><fig id="fig0025"><label>Fig. 5</label><caption><p>Matched axial CT images of calcified (a, b) and solid (c, d) lung nodules with diameters &#x02265;&#x02009;10&#x02009;mm. PCCT images (right) had sharper and clearer lung nodule exhibition compared with EICT images (left) in both ULD (a, c) and LD (b, d) groups. All images were viewed with lung window (level/width: &#x02212;600/1500 HU). Participant information: a, 19-year-old man; b, 10-year-old man; c, 23-year-old man; d, 10-year-old man.</p></caption><alt-text id="at0025">Fig. 5</alt-text><graphic xlink:href="gr5" id="lk0025"/></fig><fig id="fig0030"><label>Fig. 6</label><caption><p>Matched axial images for the thoracic skeleton (a, b), mediastinal lymph node (c), and aorta (d). <bold>a</bold> and <bold>b</bold>, PCCT (right) provides clearer and sharper bone edges with enhanced contrast between cortical and cancellous bone structures than EICT (left) in the ULD (a) and LD (b) groups; <bold>c,</bold> PCCT with relatively obscurer boundaries of mediastinal lymph nodes (arrow) compared to EICT; <bold>d,</bold> PCCT showed clearer boundary of the aorta than EICT. Images were viewed with bone window (<bold>a</bold> and <italic><bold>b</bold></italic>; level/width: 500/2000 HU) and mediastinum window (<italic><bold>c</bold></italic> and <italic><bold>d</bold></italic>; level/width: 40/350 HU). <italic>Participant information: a, 19-year-old man; b, 24-year-old man; c, 17-year-old man; d, 11-year-old woman.</italic></p></caption><alt-text id="at0030">Fig. 6</alt-text><graphic xlink:href="gr6" id="lk0030"/></fig></p></sec></sec><sec id="sec0055"><label>4</label><title>Discussion</title><p id="p0105">In this study, we divided all participants into two groups to investigate the performance of using LD and ULD-PCCT to detect pulmonary metastasis in children and AYA with malignant MSK tumors. Furthermore, intraindividual differences in image quality between LD/ULD-PCCT and SRD-EICT were explored.</p><p id="p0110">Our results revealed that LD- and ULD-PCCT attained superior overall image quality and the visualization of lung nodules or masses with significant radiation dose reduction (87.62&#x02009;% and 92.58&#x02009;% in the LD and ULD groups) compared to SRD-EICT. Moreover, PCCT allowed better differentiation between calcified and solid components within LNOMs than EICT. These findings further demonstrated the superior geometric dose efficiency and spatial resolution of PCCT in chest imaging.</p><p id="p0115">Previous studies showed that PCCT at ultralow radiation doses of 0.19&#x02009;&#x000b1;&#x02009;0.07&#x02009;mSv <xref rid="bib25" ref-type="bibr">[25]</xref> and 0.12&#x02009;&#x000b1;&#x02009;0.04&#x02009;mSv <xref rid="bib26" ref-type="bibr">[26]</xref> is feasible in patients younger than 18 years and affords diagnostic image quality for different lung diseases. Compared with their studies, our study enrolled more participants with a broader age range (9&#x02013;30 years) and explored intraindividual differences between PCCT and EICT. This not only demonstrates the excellent performance of PCCT at low radiation doses, but also presents that LD/ULD-PCCT has the potential to replace SRD-EICT for chest CT follow-up. Horst et al. <xref rid="bib26" ref-type="bibr">[26]</xref> reported that five children could not cooperate with the CT examination instructions. Conversely, we employed a very high scanning spiral pitch (3.2) that allows acquisition speed acceleration to reduce respiratory motion artifacts <xref rid="bib27" ref-type="bibr">[27]</xref>. This scanning setting making PCCT images have higher motion artifacts reduction scoring than EICT, which helps prevent the assessment of the lower lung lobes be affected. Another comparison study indicated that PCCT (0.72&#x02009;&#x000b1;&#x02009;0.23&#x02009;mGy) with a 66&#x02009;% reduction in radiation dose compared with previous EICT exhibited comparable diagnostic performance for patients with systemic sclerosis <xref rid="bib28" ref-type="bibr">[28]</xref>. Compared with this study, we used a tube voltage of Sn100 kVp and a QIR level of four rather than 100 kVp and QIR-3, which may result in lower image noise and better assessment of small lung nodules <xref rid="bib29" ref-type="bibr">[29]</xref>, <xref rid="bib30" ref-type="bibr">[30]</xref>, <xref rid="bib31" ref-type="bibr">[31]</xref>. In addition, our study emphasized the detection and visualization of lung nodules/masses rather than interstitial structures, which allows the radiation dose to be further reduced.</p><p id="p0120">This study has important clinical implications. Firstly, regular chest X-ray/CT scan is necessary to monitor disease progression or therapy response for most osteosarcoma patients, regardless of the absence of metastasis <xref rid="bib10" ref-type="bibr">[10]</xref>. However, each CT examination (mean active bone marrow dose: 8&#x02009;mGy) was associated with an approximately 16&#x02009;% increased risk of lymphoid and myeloid malignancies and acute leukemia <xref rid="bib32" ref-type="bibr">[32]</xref>. The patients &#x0003c;&#x02009;18 years had a higher incidence of cancer risk associated with CT-related radiation exposure compared with the general population <xref rid="bib33" ref-type="bibr">[33]</xref>. In our study, the maximum CTDI<sub>vol</sub> values of PCCT for all participants fall below the median values observed in the 0&#x02013;1 year group in the United States <xref rid="bib34" ref-type="bibr">[34]</xref>, while maintaining comparable image quality to EICT. The ED of ULD-PCCT scans was only two times compared to standard chest radiography (0.1&#x02009;mSv) <xref rid="bib35" ref-type="bibr">[35]</xref>. However, the additional three-dimensional information provided by CT scans enables more sensitive lung nodule detection and accurate localization <xref rid="bib36" ref-type="bibr">[36]</xref>, <xref rid="bib37" ref-type="bibr">[37]</xref>, <xref rid="bib38" ref-type="bibr">[38]</xref>, achieving a high benefit-to-radiation risk ratio. Secondly, compared with EICT images, the improved LNOM visualization and calcified component differentiation assists its diagnosis and progression evaluation <xref rid="bib39" ref-type="bibr">[39]</xref>. Finally, this study examined intraindividual differences between PCCT and eight different EICT scanners, which simulated the true clinical settings as much as possible and ensured the reliability and scientific validity of our findings.</p><p id="p0125">This study has some limitations. First, we did not simultaneously subject participants to PCCT and EICT scans to avoid ethical concerns and additional radiation exposure. The quantity, size, and density of LNOMs may have changed during the follow-up intervals. Nevertheless, all participants showed stable disease according to the RECIST 1.1 guideline <xref rid="bib19" ref-type="bibr">[19]</xref>, suggesting that these alterations are unlikely to affect clinical management and study conclusion. Second, the LD scanning strategy was not performed on EICT scanners in this study. This was due to the fact that EICT could not obtain images that met the diagnostic needs at the same LD level as PCCT, which can achieve high image quality at LD or ULD <xref rid="bib15" ref-type="bibr">[15]</xref>, <xref rid="bib40" ref-type="bibr">[40]</xref>. Third, in our study, only 17 participants had a body mass index (BMI) &#x02265;&#x02009;24; thus, the image quality of the chest LDCT in obese participants was not investigated. Finally, PCCT allows ultra-high-resolution imaging (0.2/0.2&#x02009;mm for slice thickness/increment with extremely sharp kernel) at low doses. However, we did not investigate its performance and utility in this study.</p><p id="p0130">In conclusion, in this prospective study of children and AYA with pulmonary metastasis from malignant MSK tumors, we demonstrated that PCCT can achieve superior overall image quality and lung nodule visualization at low/ultralow radiation doses.</p></sec><sec id="sec0060"><title>Declarations</title><p id="p0135">None</p></sec><sec id="sec0065"><title>Funding</title><p id="p0140">This work was supported by the <funding-source id="spnsr1"><institution-wrap><institution-id institution-id-type="doi">10.13039/501100001809</institution-id><institution>National Natural Science Foundation of China</institution></institution-wrap></funding-source> [grant number <award-id award-type="grant" rid="spnsr1">82101988</award-id>]; and the <funding-source id="spnsr2">Shanghai Municipal Commission of Science and Technology</funding-source> [grant number <award-id award-type="grant" rid="spnsr2">21YF1426200</award-id>].</p></sec><sec id="sec0070"><title>Ethical statement</title><p id="p0145">The ethics committee of our institution approved this prospective study (<italic>Number: KY2023&#x02013;186</italic>). Written informed consent was obtained from all participants or their parents/guardians.</p></sec><sec id="sec0075"><title>CRediT authorship contribution statement</title><p id="p0150"><bold>Le Qin:</bold> Writing &#x02013; review &#x00026; editing, Supervision, Project administration, Funding acquisition, Formal analysis, Conceptualization. <bold>Shanshui Zhou:</bold> Writing &#x02013; original draft, Methodology. <bold>Qiyuan Bao:</bold> Writing &#x02013; original draft, Methodology. <bold>Haipeng Dong:</bold> Data curation. <bold>Jiqiang Li:</bold> Data curation. <bold>Zhihan Xu:</bold> Visualization, Investigation. <bold>Lianjun Du:</bold> Investigation. <bold>Wenjie Yang:</bold> Visualization, Validation. <bold>Yong Lu:</bold> Formal analysis. <bold>Weibin Zhang:</bold> Writing &#x02013; review &#x00026; editing. <bold>Fuhua Yan:</bold> Writing &#x02013; review &#x00026; editing, Supervision, Software, Resources, Project administration.</p></sec><sec sec-type="COI-statement" id="coi0005"><title>Declaration of Competing Interest</title><p id="p0155">The authors declare the following financial interests/personal relationships which may be considered as potential competing interests: Zhihan Xu reports a relationship with Siemens Healthineers that includes: employment. The other authors declare that they have no known competing financial interests or personal relationships that could have appeared to influence the work reported in this paper.</p></sec></body><back><ref-list id="bibliog0005"><title>References</title><ref id="bib1"><label>1</label><element-citation publication-type="journal" id="sbref1"><person-group person-group-type="author"><name><surname>Arndt</surname><given-names>C.A.</given-names></name><name><surname>Crist</surname><given-names>W.M.</given-names></name></person-group><article-title>Common musculoskeletal tumors of childhood and adolescence</article-title><source>N. Engl. J. Med</source><volume>341</volume><issue>5</issue><year>1999</year><fpage>342</fpage><lpage>352</lpage><pub-id pub-id-type="pmid">10423470</pub-id>

</element-citation></ref><ref id="R5"><label>5</label><element-citation publication-type="journal" publication-format="print"><person-group person-group-type="author">
<name><surname>Mucci</surname><given-names>LA</given-names></name>
<name><surname>Hjelmborg</surname><given-names>JB</given-names></name>
<name><surname>Harris</surname><given-names>JR</given-names></name>
<name><surname>Czene</surname><given-names>K</given-names></name>
<name><surname>Havelick</surname><given-names>DJ</given-names></name>

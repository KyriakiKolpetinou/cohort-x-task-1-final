</mixed-citation></citation-alternatives></ref><ref id="CR9"><label>9.</label><citation-alternatives><element-citation id="ec-CR9" publication-type="journal"><person-group person-group-type="author"><name><surname>Kerr</surname><given-names>M</given-names></name><name><surname>Rayman</surname><given-names>G</given-names></name><name><surname>Jeffcoate</surname><given-names>WJ</given-names></name></person-group><article-title>Cost of diabetic foot disease to the National health service in England</article-title><source>Diabet. Med.</source><year>2014</year><volume>31</volume><issue>12</issue><fpage>1498</fpage><lpage>1504</lpage><pub-id pub-id-type="doi">10.1111/dme.12545</pub-id><pub-id pub-id-type="pmid">24984759</pub-id>

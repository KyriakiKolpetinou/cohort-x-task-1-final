<article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Pulm Circ</journal-id><journal-id journal-id-type="iso-abbrev">Pulm Circ</journal-id><journal-id journal-id-type="publisher-id">PUL</journal-id><journal-id journal-id-type="hwp">sppul</journal-id><journal-title-group><journal-title>Pulmonary Circulation</journal-title></journal-title-group><issn pub-type="ppub">2045-8932</issn><issn pub-type="epub">2045-8940</issn><publisher><publisher-name>SAGE Publications</publisher-name><publisher-loc>Sage UK: London, England</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">29064349</article-id><article-id pub-id-type="pmc">5798685</article-id><article-id pub-id-type="doi">10.1177/2045893217741480</article-id><article-id pub-id-type="publisher-id">10.1177_2045893217741480</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group></article-categories><title-group><article-title>Bosentan-based, treat-to-target therapy in patients with pulmonary arterial hypertension: results from the COMPASS-3 study</article-title></title-group><contrib-group><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0001-9627-6236</contrib-id><name><surname>Benza</surname><given-names>Raymond L.</given-names></name><xref ref-type="aff" rid="aff1-2045893217741480">1</xref><xref ref-type="corresp" rid="corresp1-2045893217741480"/></contrib><contrib contrib-type="author"><name><surname>Raina</surname><given-names>Amresh</given-names></name><xref ref-type="aff" rid="aff1-2045893217741480">1</xref></contrib><contrib contrib-type="author"><name><surname>Gupta</surname><given-names>Himanshu</given-names></name><xref ref-type="aff" rid="aff2-2045893217741480">2</xref></contrib><contrib contrib-type="author"><name><surname>Murali</surname><given-names>Srinivas</given-names></name><xref ref-type="aff" rid="aff1-2045893217741480">1</xref></contrib><contrib contrib-type="author"><name><surname>Burden</surname><given-names>Annie</given-names></name><xref ref-type="aff" rid="aff3-2045893217741480">3</xref></contrib><contrib contrib-type="author"><name><surname>Zastrow</surname><given-names>Michael S.</given-names></name><xref ref-type="aff" rid="aff4-2045893217741480">4</xref></contrib><contrib contrib-type="author"><name><surname>Park</surname><given-names>Myung H.</given-names></name><xref ref-type="aff" rid="aff5-2045893217741480">5</xref></contrib><contrib contrib-type="author"><name><surname>Simon</surname><given-names>Marc A.</given-names></name><xref ref-type="aff" rid="aff6-2045893217741480">6</xref></contrib></contrib-group><aff id="aff1-2045893217741480">

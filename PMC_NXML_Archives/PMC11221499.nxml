<article-meta><article-id pub-id-type="pmid">38962639</article-id><article-id pub-id-type="pmc">11221499</article-id><article-id pub-id-type="doi">10.7759/cureus.61591</article-id><article-categories><subj-group subj-group-type="heading"><subject>Neurosurgery</subject></subj-group><subj-group><subject>Radiation Oncology</subject></subj-group><subj-group><subject>Radiology</subject></subj-group></article-categories><title-group><article-title>Diagnostic Algorithm for Intracranial Lesions in the Emergency Department: Effectiveness of the Relative Brain Volume and Hounsfield Unit Value Measured by Perfusion Tomography</article-title></title-group><contrib-group><contrib contrib-type="editor"><name><surname>Muacevic</surname><given-names>Alexander</given-names></name></contrib><contrib contrib-type="editor"><name><surname>Adler</surname><given-names>John R</given-names></name></contrib></contrib-group><contrib-group><contrib contrib-type="author"><name><surname>Alvaro-Heredia</surname><given-names>Juan Antonio</given-names></name><xref rid="aff-1" ref-type="aff">1</xref><xref rid="aff-2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>Rodr&#x000ed;guez-Hern&#x000e1;ndez</surname><given-names>Luis A</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Rodr&#x000ed;guez-Rubio</surname><given-names>H&#x000e9;ctor A</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Alvaro-Heredia</surname><given-names>Isidro</given-names></name><xref rid="aff-3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Mondragon-Soto</surname><given-names>Michel G</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Rodr&#x000ed;guez-Hern&#x000e1;ndez</surname><given-names>Ivan A</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Mateo-Nouel</surname><given-names>Edgardo de Jesus</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Villanueva-Castro</surname><given-names>Eliezer</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Uribe-Pacheco</surname><given-names>Rodrigo</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Castro-Martinez</surname><given-names>Elvira</given-names></name><xref rid="aff-3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Gutierrez-Aceves</surname><given-names>Guillermo A</given-names></name><xref rid="aff-4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><name><surname>Moreno-Jim&#x000e9;nez</surname><given-names>Sergio</given-names></name><xref rid="aff-5" ref-type="aff">5</xref><xref rid="aff-4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><name><surname>Reyes-Moreno</surname><given-names>Ignacio</given-names></name><xref rid="aff-6" ref-type="aff">6</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Gonzalez-Aguilar</surname><given-names>Alberto</given-names></name><xref rid="aff-6" ref-type="aff">6</xref></contrib></contrib-group><aff id="aff-1">

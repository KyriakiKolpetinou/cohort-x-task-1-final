><contrib contrib-type="author"><name><surname>Curtis</surname><given-names>Craig</given-names></name><degrees>MD</degrees><xref ref-type="aff" rid="noi200102aff5"><sup>5</sup></xref></contrib><contrib contrib-type="author"><name><surname>Truocchio</surname><given-names>Stephen P.</given-names></name><degrees>MS</degrees><xref ref-type="aff" rid="noi200102aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Flitter</surname><given-names>Matthew</given-names></name><degrees>BS</degrees><xref ref-type="aff" rid="noi200102aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Locascio</surname><given-names>Tricia</given-names></name><degrees>BS</degrees><xref ref-type="aff" rid="noi200102aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Devine</surname><given-names>Marybeth</given-names></name><degrees>BS</degrees><xref ref-type="aff" rid="noi200102aff1"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Zimmer</surname><given-names>Jennifer A.</given-names></name><degrees>MD</degrees><xref ref-type="aff" rid="noi200102aff6"><sup>6</sup></xref></contrib><contrib contrib-type="author"><name><surname>Fleisher</surname><given-names>Adam S.</given-names></name><degrees>MD</degrees><degrees>MAS</degrees><xref ref-type="aff" rid="noi200102aff6"><sup>6</sup></xref></contrib><contrib contrib-type="author"><name><surname>Mintun</surname><given-names>Mark A.</given-names></name><degrees>MD</degrees><xref ref-type="aff" rid="noi200102aff1"><sup>1</sup></xref><xref ref-type="aff" rid="noi200102aff6"><sup>6</sup></xref></contrib><on-behalf-of>for the AVID Collaborators</on-behalf-of></contrib-group><aff id="noi200102aff1"><label>1</label>Avid Radiopharmaceuticals, A Wholly Owned Subsidiary

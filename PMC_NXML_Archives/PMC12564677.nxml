</person-group><article-title>MRI in breast cancer therapy monitoring</article-title><source>NMR Biomed.</source><year>2011</year><volume>24</volume><fpage>712</fpage><lpage>720</lpage><pub-id pub-id-type="doi">10.1002/nbm.1739</pub-id><pub-id pub-id-type="pmid">21692116</pub-id>
</element-citation></ref><ref id="B3-cimb-47-00807"><label>3.</label><element-citation publication-type="journal"><person-group person-group-type="author">

</td><td rowspan="1" colspan="1">High 25% (2/8)</td></tr><tr><td rowspan="1" colspan="1">McGirt et al. 2009 [<xref rid="REF18" ref-type="bibr">18</xref>]</td><td rowspan="1" colspan="1">11/16 | N/A</td><td rowspan="1" colspan="1">N/A</td><td rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1">N/A</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">1<sup>+</sup>
</td><td rowspan="1" colspan="1">1<sup>+</sup>
</td><td rowspan="1" colspan="1">High 30% (3/10)</td></tr><tr style="background-color:#ccc"><td rowspan="1" colspan="1">Kaner et al. 2010 [<xref rid="REF36" ref-type="bibr">36</xref>]</td><td rowspan="1" colspan="1">11/16 | N/A</td><td rowspan="1" colspan="1">N/A</td><td rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1">N/A</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">N/A</td><td rowspan="1" colspan="1">N/A</td><td rowspan="1" colspan="1">High 17% (1/6)</td></tr><tr><td rowspan="1" colspan="1">Fakouri et al. 2011 [<xref rid="REF37" ref-type="bibr">37</xref>]</td><td rowspan="1" colspan="1">12/16 | 7/8</td><td rowspan="1" colspan="1">0<sup>&#x02021;</sup>

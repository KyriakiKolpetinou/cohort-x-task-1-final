</td><td rowspan="1" colspan="1">Medium 60% (6/10)</td></tr><tr><td rowspan="1" colspan="1">Carragee et al. 2006&#x000a0;[<xref rid="REF23" ref-type="bibr">23</xref>]</td><td rowspan="1" colspan="1">12/16 | 6/8</td><td rowspan="1" colspan="1">0</td><td rowspan="1" colspan="1">2</td><td rowspan="1" colspan="1">N/A</td><td rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1">1</td><td rowspan="1" colspan="1">1<sup>+</sup>

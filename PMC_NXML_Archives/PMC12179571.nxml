<article-meta><article-id pub-id-type="pmid">40473232</article-id><article-id pub-id-type="pmc">12179571</article-id><article-id pub-id-type="publisher-id">v14i1e67254</article-id><article-id pub-id-type="doi">10.2196/67254</article-id><article-categories><subj-group subj-group-type="heading"><subject>Protocol</subject></subj-group><subj-group subj-group-type="article-type"><subject>Protocol</subject></subj-group></article-categories><title-group><article-title>Smart Technology Facilitated Patient-Centered Venous Thromboembolism Management (the SmaVTE Study): Protocol for a Randomized Controlled Trial</article-title></title-group><contrib-group><contrib contrib-type="editor"><name><surname>Basha</surname><given-names>Sreenivasulu</given-names></name></contrib></contrib-group><contrib-group><contrib contrib-type="reviewer"><name><surname>Gebel</surname><given-names>Martin</given-names></name></contrib><contrib contrib-type="reviewer"><name><surname>Coninx</surname><given-names>Karin</given-names></name></contrib></contrib-group><contrib-group><contrib id="contrib1" contrib-type="author"><name><surname>Jin</surname><given-names>Zhi-Geng</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">1</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-2971-6697</contrib-id></contrib><contrib id="contrib2" contrib-type="author"><name><surname>Zhang</surname><given-names>Zhe-Qi</given-names></name><degrees>MM</degrees><xref rid="aff2" ref-type="aff">2</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0009-0299-2561</contrib-id></contrib><contrib id="contrib3" contrib-type="author"><name><surname>Liu</surname><given-names>Bin-Bin</given-names></name><degrees>MM</degrees><xref rid="aff2" ref-type="aff">2</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0002-1907-2875</contrib-id></contrib><contrib id="contrib4" contrib-type="author"><name><surname>Wang</surname><given-names>Hao</given-names></name><degrees>MD</degrees><xref rid="aff3" ref-type="aff">3</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-4082-9350</contrib-id></contrib><contrib id="contrib5" contrib-type="author"><name><surname>Yang</surname><given-names>Ying</given-names></name><degrees>MD</degrees><xref rid="aff4" ref-type="aff">4</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-1197-6941</contrib-id></contrib><contrib id="contrib6" contrib-type="author"><name><surname>Ren</surname><given-names>Li-Na</given-names></name><degrees>MM</degrees><xref rid="aff1" ref-type="aff">1</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0002-4289-8448</contrib-id></contrib><contrib id="contrib7" contrib-type="author"><name><surname>Zhang</surname><given-names>Hui</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">1</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-1942-2513</contrib-id></contrib><contrib id="contrib8" contrib-type="author"><name><surname>Ji</surname><given-names>Wei</given-names></name><degrees>MM</degrees><xref rid="aff1" ref-type="aff">1</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0002-3805-3696</contrib-id></contrib><contrib id="contrib9" contrib-type="author"><name><surname>Zhai</surname><given-names>Zhen-Guo</given-names></name><degrees>MD, PhD</degrees><xref rid="aff5" ref-type="aff">5</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-7096-8792</contrib-id></contrib><contrib id="contrib10" contrib-type="author" corresp="yes"><name><surname>Guo</surname><given-names>Yu-Tao</given-names></name><degrees>MD, PhD</degrees><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-7626-7751</contrib-id><xref rid="aff1" ref-type="aff">1</xref><address><institution/><institution>Department of Pulmonary Vascular and Thrombotic Disease</institution><institution>Sixth Medical Center of Chinese PLA General Hospital</institution><addr-line>No.6 Fucheng Road</addr-line><add
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\text{CNR}}_{max}$$\end{document}</tex-math><mml:math id="d33e1127"><mml:msub><mml:mtext>CNR</mml:mtext><mml:mrow><mml:mi mathvariant="italic">max</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xlink:href="40658_2025_784_Article_IEq30.gif"/></alternatives></inline-formula> and <inline-formula id="IEq39"><alternatives><tex-math id="d33e1135">\documentclass[12pt]{minimal}
				\usepackage{amsmath}

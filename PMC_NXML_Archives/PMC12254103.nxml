				\begin{document}$${RC}_{mean}$$\end{document}</tex-math><mml:math id="d33e1112"><mml:msub><mml:mrow><mml:mi mathvariant="italic">RC</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">mean</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xlink:href="40658_2025_784_Article_IEq9.gif"/></alternatives></inline-formula>,<inline-formula id="IEq38"><alternatives><tex-math id="d33e1122">\documentclass[12pt]{minimal}

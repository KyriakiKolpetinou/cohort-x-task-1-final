</aff><pub-date pub-type="epub"><day>14</day><month>8</month><year>2025</year></pub-date><pub-date pub-type="ppub"><month>9</month><year>2025</year></pub-date><volume>18</volume><issue seq="80">3</issue><issue-id pub-id-type="doi">10.1111/jebm.v18.3</issue-id><elocation-id>e70054</elocation-id><history>

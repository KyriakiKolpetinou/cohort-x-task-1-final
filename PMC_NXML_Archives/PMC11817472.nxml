</person-group><article-title>Re-setting the biologic rationale for thermal therapy</article-title><source>Int. J. Hyperth.</source><year>2005</year><volume>21</volume><fpage>779</fpage><lpage>790</lpage><pub-id pub-id-type="doi">10.1080/02656730500271668</pub-id></element-citation></ref><ref id="B3-cancers-17-00515"><label>3.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Crezee</surname><given-names>J.</given-names></name>
<name><surname>van Leeuwen</surname><given-names>C.M.</given-names></name>
<name><surname>Oei</surname><given-names>A.L.</given-names></name>

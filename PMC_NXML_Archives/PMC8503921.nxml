rib id="author-86645332" contrib-type="author" equal-contrib="yes"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0002-6021-5738</contrib-id><name><surname>Kite</surname><given-names>Thomas A</given-names></name><xref rid="aff4" ref-type="aff">4</xref></contrib><contrib id="author-53759426" contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0001-9874-6211</contrib-id><name><surname>Joshi</surname><given-names>Shruti S</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-53781164" contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0001-9623-0158</contrib-id><name><surname>Spath</surname><given-names>Nick B</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-86384943" contrib-type="author"><name><surname>Kershaw</surname><given-names>Lucy</given-names></name><xref rid="aff3" ref-type="aff">3</xref><xref rid="aff5" ref-type="aff">5</xref></contrib><contrib id="author-47640491" contrib-type="author"><name><surname>Baker</surname><given-names>Andrew</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib id="author-89862632" contrib-type="author"><name><surname>Jordan</surname><given-names>Helen</given-names></name><xref rid="aff6" ref-type="aff">6</xref></contrib><contrib id="author-46100759" contrib-type="author"><name><surname>Gulsin</surname><given-names>Gaurav Singh</given-names></name><xref rid="aff4" ref-type="aff">4</xref></contrib><contrib id="author-22348959" contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0003-3556-2428</contrib-id><name><surname>Williams</surname><given-names>Michelle Claire</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-41226522" contrib-type="author"><name><surname>van Beek</surname><given-names>Edwin J R</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-60477563" contrib-type="author"><name><surname>Arnold</surname><given-names>Jayanth Ranjit</given-names></name><xref rid="aff4" ref-type="aff">4</xref></contrib><contrib id="author-25383785" contrib-type="author"><name><surname>Semple</surname><given-names>Scott I K</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-34327147" contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0003-4123-2070</contrib-id><name><surname>Moss</surname><given-names>Alastair James</given-names></name><xref rid="aff4" ref-type="aff">4</xref></contrib><contrib id="author-21843556" contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0001-7971-4628</contrib-id><name><surname>Newby</surname><given-names>David E</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-83349741" contrib-type="author"><name><surname>Dweck</surname><given-names>Marc</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-55379811" contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0002-5542-8448</contrib-id><name><surname>McCann</surname><given-names>Gerry P</given-names></name><xref rid="aff4" ref-type="aff">4</xref></contrib></contrib-group><aff id="aff1">

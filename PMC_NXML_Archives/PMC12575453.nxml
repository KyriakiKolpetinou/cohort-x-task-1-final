</element-citation><mixed-citation id="mc-CR2" publication-type="journal">Pennell DJ. Cardiovascular magnetic resonance. Circulation. 2010;121:692&#x02013;705. 10.1161/CIRCULATIONAHA.108.811547.<pub-id pub-id-type="pmid">20142462</pub-id>
</mixed-citation></citation-alternatives></ref><ref id="CR3"><label>3.</label><citation-alternatives><element-citation id="ec-CR3" publication-type="journal"><person-group person-group-type="author"><name><surname>Kato</surname><given-names>Y</given-names></name><name><surname>Ambale-Venkatesh</surname><given-names>B</given-names></name><name><surname>Kassai</surname><given-names>Y</given-names></name><name><surname>Kasuboski</surname><given-names>L</given-names></name><name><surname>Schuijf</surname><given-names>J</given-names></name><name><surname>Kapoor</surname><given-names>K</given-names></name><etal/></person-group><article-title>Non-contrast coronary magnetic resonance angiography: current frontiers and future horizons</article-title><source>MAGMA</source><year>2020</year><volume>33</volume><fpage>591</fpage><lpage>612</lpage><pub-id pub-id-type="doi">10.1007/s10334-020-00834-8</pub-id><pub-id pub-id-type="pmid">32242282</pub-id>
</element-citation><mixed-citation id="mc-CR3" publication-type="journal">Kato Y, Ambale-Venkatesh B, Kassai Y, Kasuboski L, Schuijf J, Kapoor K, et al. Non-contrast coronary magnetic resonance angiography: current frontiers and future horizons. MAGMA. 2020;33:591&#x02013;612. 10.1007/s10334-020-00834-8.<pub-id pub-id-type="pmid">32242282</pub-id>

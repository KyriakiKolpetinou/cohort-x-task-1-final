<article-id pub-id-type="publisher-id">1383</article-id><article-id pub-id-type="doi">10.1007/s13555-025-01383-5</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Research</subject></subj-group></article-categories><title-group><article-title>CT-P17 Adalimumab Biosimilar in Patients with Moderate-to-Severe Chronic Plaque Psoriasis: An Open-Label Extension of a Phase 3 Interchangeability Study</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Pariser</surname><given-names>David M.</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Lebwohl</surname><given-names>Mark G.</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Jaworski</surname><given-names>Janusz</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0009-0003-3912-3518</contrib-id><name><surname>Trefler</surname><given-names>Jakub</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Daniluk</surname><given-names>Stefan</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Dudek</surname><given-names>Anna</given-names></name><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Baran</surname><given-names>Wojciech</given-names></name><xref ref-type="aff" rid="Aff7">7</xref></contrib><contrib contrib-type="author"><name><surname>Owczarek</surname><given-names>Witold</given-names></name><xref ref-type="aff" rid="Aff8">8</xref><xref ref-type="aff" rid="Aff14">14</xref></contrib><contrib contrib-type="author"><name><surname>Brzewski</surname><given-names>Pawel</given-names></name><xref ref-type="aff" rid="Aff9">9</xref><xref ref-type="aff" rid="Aff15">15</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-6162-9916</contrib-id><name><surname>Sikora</surname><given-names>Mariusz</given-names></name><xref ref-type="aff" rid="Aff10">10</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-5698-9706</contrib-id><name><surname>Krogulec</surname><given-names>Marek</given-names></name><xref ref-type="aff" rid="Aff11">11</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0003-3898-0393</contrib-id><name><surname>Kim</surname><given-names>SungHyun</given-names></name><xref ref-type="aff" rid="Aff12">12</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0009-0005-9273-0784</contrib-id><name><surname>Suh</surname><given-names>JeeHye</given-names></name><xref ref-type="aff" rid="Aff12">12</xref></contrib><contrib contrib-type="author"><name><surname>Choi</surname><given-names>EunJin</given-names></name><xref ref-type="aff" rid="Aff12">12</xref></contrib><contrib contrib-type="author"><name><surname>Cha</surname><given-names>JungBin</given-names></name><xref ref-type="aff" rid="Aff12">12</xref></contrib><contrib contrib-type="author"><name><surname>Lee</surname><given-names>HyunJin</given-names></name><xref ref-type="aff" rid="Aff12">12</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0003-3974-7999</contrib-id><name><surname>Lee</surname><given-names>SungJeong</given-names></name><xref ref-type="aff" rid="Aff12">12</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Koo</surname><given-names>John Y.</given-names></name><address><email>john.Koo2@ucsf.edu</email></address><xref ref-type="aff" rid="Aff13">13</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01r4jg965</institution-id><institution-id institution-id-type="GRID">grid.478129.1</institution-id><institution>Eastern Virginia Medical School and Virginia Clinical Research, Inc., </institution></institution-wrap>Norfolk, VA USA </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/04a9tmd77</institution-id><institution-id institution-id-type="GRID">grid.59734.3c</institution-id><institution-id institution-id-type="ISNI">0000 0001 0670 2351</institution-id><institution>Icahn School of Medicine at Mount Sinai, </institution></institution-wrap>New York, NY USA </aff><aff id="Aff3"><label>3</label>Centrum Medyczne Reuma Park, Warsaw, Poland </aff><aff id="Aff4"><label>4</label>Reuma Centrum, Warsaw, Poland </aff><aff id="Aff5"><label>5</label>ClinicMed Daniluk, Nowak Sp.k., Bia&#x00142;ystok, Poland </aff><aff id="Aff6"><label>6</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/028hxy872</institution-id><institution-id institution-id-type="GRID">grid.460351.5</institution-id><institution>Centrum Medyczne AMED, </institution></institution-wrap>Warsaw, Poland </aff><aff id="Aff7"><label>7</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01qpw1b93</institution-id><institution-id institution-id-type="GRID">grid.4495.c</institution-id><institution-id institution-id-type="ISNI">0000 0001 1090 049X</institution-id><institution>Department of Dermatology, Venereology and Allergology, </institution><institution>Wroc&#x00142;aw Medical University, </institution></institution-wrap>Wroc&#x00142;aw, Poland </aff><aff id="Aff8"><label>8</label>Royalderm, Warsaw, Poland </aff><aff id="Aff9"><label>9</label>Specjalistyczny Gabinet Dermatologiczny Aplikacyjno-Badawczy, Krak&#x000f3;w, Poland </aff><aff id="Aff10"><label>10</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03gz68w66</institution-id><institution-id institution-id-type="GRID">grid.460480.e</institution-id><institution>National Institute of Geriatrics, Rheumatology and Rehabilitation, </institution></institution-wrap>Warsaw, Poland </aff><aff id="Aff11"><label>11</label>Rheumatology Clinic, NZOZ Lecznica MAK-MED, Nadarzyn, Poland </aff><aff id="Aff12"><label>12</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05k84m754</institution-id><institution-id institution-id-type="GRID">grid.459420.e</institution-id><institution-id institution-id-type="ISNI">0000 0004 4690 0995</institution-id><institution>Celltrion, Inc., </institution></institution-wrap>Incheon, Republic of Korea </aff><aff id="Aff13"><label>13</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/043mz5j54</institution-id><institution-id institution-id-type="GRID">grid.266102.1</institution-id><institution-id institution-id-type="ISNI">0000 0001 2297 6811</institution-id><institution>UCSF Psoriasis and Skin Treatment Center, </institution></institution-wrap>515 Spruce Street, San Francisco, CA 94118 USA </aff><aff id="Aff14"><label>14</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/04zvqhj72</institution-id><institution-id institution-id-type="GRID">grid.415641.3</institution-id><institution-id institution-id-type="ISNI">0000 0004 0620 0839</institution-id><institution>Department of Dermatology, </institution><institution>Military Institute of Medicine - National Research Institute, </institution></institution-wrap>Warsaw, Poland </aff><aff id="Aff15"><label>15</label>Department of Dermatology, UAFM Krak&#x000f3;w, Krak&#x000f3;w, Poland </aff></contrib-group><pub-date pub-type="epub"><day>27</day><month>3</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>27</day><month>3</month><year>2025</year></pub-date><pub-date pub-type="collection"><month>5</month><year>2025</year></pub-date><volume>15</volume><issue>5</issue><fpage>1079</fpage><lpage>1092</lpage><history><date date-type="received"><day>27</day><month>1</month><year>2025</year></date><date date-type="accepted"><day>5</day><month>3</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbynclicense">https://creativecommons.org/licenses/by-nc/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial 4.0 International License, which permits any non-commercial use, sharing, adaptation, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if changes were made. The images or other third party material in this article are included in the article's Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article's Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc/4.0/">http://creativecommons.org/licenses/by-nc/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Introduction</title><p id="Par1">A 27-week analysis of this phase 3 study demonstrated the interchangeability of the adalimumab biosimilar CT-P17 and reference adalimumab. The current 52-week analysis reports secondary data from the open-label extension period (OLE) of the study.</p></sec><sec><title>Methods</title><p id="Par2">In this randomized, double-blind, active-controlled phase 3 study, adults with moderate-to-severe chronic plaque psoriasis received (via prefilled syringe) 80 mg subcutaneous reference adalimumab on day 1, then 40 mg 1 week later, and every other week (EOW) until week 11. At week 13, patients were randomized (1:1) to continue reference adalimumab (&#x0201c;continuous&#x0201d; group) or undergo repeated switching between CT-P17 and reference adalimumab (&#x0201c;switching&#x0201d; group) until week 25. Thereafter, patients entered an OLE and received 40 mg CT-P17 EOW from week 27 to 49, with an end-of-study visit at week 52. Here we present findings from the OLE. Pharmacokinetics (PK), efficacy (including mean percent improvement from baseline in Psoriasis Area Severity Index [PASI] score), safety, and immunogenicity were evaluated. Post hoc subgroup analyses were also conducted.</p></sec><sec><title>Results</title><p id="Par3">Of 327 patients who initiated the OLE, 152 and 160 patients from the switching group and continuous group, respectively, completed the study. Mean serum concentrations were similar between groups throughout the OLE. Efficacy improvements observed up to week 27 were maintained during the OLE and were comparable between groups. At week 52, overall mean (standard deviation [SD]) improvement from baseline in PASI score was 90.34% (16.59). Safety profiles were similar between groups, and immunogenicity did not increase during the OLE. The mean (SD) percent improvement from baseline in PASI score was slightly lower in patients who were antidrug antibody (ADA)-positive versus those who were ADA-negative (89.57 [17.27] versus 97.29 [4.08]) at week 52.</p></sec><sec><title>Conclusions</title><p id="Par4">PK, efficacy, safety, and immunogenicity findings remained consistent throughout the OLE, regardless of prior treatment, and were generally comparable across timepoints.</p></sec><sec><title>Trial registration</title><p id="Par5">ClinicalTrials.gov: NCT05495568.</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1007/s13555-025-01383-5.</p></sec></abstract><abstract id="Abs2" abstract-type="plain-language-summary"><title>Plain Language Summary</title><p id="Par6">A biosimilar is a medicine made using living cells that is highly similar to an original (&#x0201c;reference&#x0201d;) medicine. As biosimilars are typically cheaper than reference medicines, their use may make it easier for patients to get treatment. CT-P17, approved to treat inflammatory conditions, is a biosimilar of a reference medicine called adalimumab. CT-P17 is highly concentrated (40&#x000a0;mg/0.4&#x000a0;mL) and does not contain citrate, which may reduce pain at the injection site. This study is important because it aimed to demonstrate that patients with psoriasis could switch between CT-P17 and reference adalimumab safely and without losing effectiveness and secure status known as &#x0201c;interchangeability&#x0201d;. This would allow pharmacists to dispense CT-P17 directly when reference adalimumab is initially prescribed, providing flexibility, timely treatment access, and potentially reducing patient costs. In this study, patients with psoriasis were switched between CT-P17 and adalimumab multiple times (switching period). Results showed that CT-P17 can be used interchangeably with reference adalimumab by demonstrating similar pharmacokinetics (how the body absorbs, processes, and excretes a drug), effectiveness, safety, and immunogenicity (risk of unwanted immune reactions) between patients who switched medicines and those receiving reference adalimumab throughout. These results have been previously published. This article reports results from the last part of the study, which followed the switching period. In this part, all patients received CT-P17 every other week. Pharmacokinetics, effectiveness, safety, and immunogenicity findings remained similar to those observed during the switching period. These results provide further support for the interchangeability of CT-P17 and reference adalimumab.</p><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1007/s13555-025-01383-5.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Adalimumab</kwd><kwd>Biosimilar</kwd><kwd>CT-P17</kwd><kwd>Interchangeability</kwd><kwd>Psoriasis</kwd><kwd>Switching</kwd><kwd>TNF</kwd><kwd>Tumor necrosis factor inhibitor</kwd><kwd>Yuflyma<sup>&#x000ae;</sup></kwd></kwd-group><funding-group><award-group><funding-source><institution-wrap><institution-id institution-id-type="FundRef">http://dx.doi.org/10.13039/100018592</institution-id><institution>Celltrion</institution></institution-wrap></funding-source></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer Healthcare Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="d33e389"><title>Key Summary Points</title><p id="Par500">
<table-wrap id="Taba"><table frame="hsides" rules="groups"><tbody><tr><td align="left">
<bold><italic>Why carry out this study?</italic></bold>
</td></tr><tr><td align="left">CT-P17, a citrate-free, high-concentration biosimilar of adalimumab, is approved for use in a number of immune-mediated inflammatory conditions, including psoriasis. Phase 1 and phase 3 trials have demonstrated its equivalence to reference adalimumab.</td></tr><tr><td align="left">Clinical trials comprising multiple treatment switches are important to demonstrate interchangeability between a biosimilar and its reference biologic.</td></tr><tr><td align="left">A 27-week analysis of this phase 3 trial in patients with moderate-to-severe chronic plaque psoriasis demonstrated the pharmacokinetic equivalence and interchangeability of CT-P17 and reference adalimumab after multiple switches.</td></tr><tr><td align="left">
<bold><italic>What was learned from this study?</italic></bold>
</td></tr><tr><td align="left">In this 52-week analysis, data from an open-label extension period of CT-P17 administration are reported. Pharmacokinetic, efficacy, safety, and immunogenicity findings were similar regardless of prior treatment (i.e., prior switching between CT-P17 and reference adalimumab versus continuous reference adalimumab).</td></tr><tr><td align="left">These data further support the interchangeability of CT-P17 and reference adalimumab.</td></tr></tbody></table></table-wrap>
</p></sec><sec id="Sec1"><title>Introduction</title><p id="Par7">CT-P17 is a citrate-free biosimilar of reference adalimumab, available at high concentration (100 mg/mL), and approved for the treatment of several immune-mediated inflammatory conditions, including psoriasis [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>]. CT-P17 was shown to be pharmacokinetically equivalent to reference adalimumab in multiple phase 1 studies [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR4">4</xref>]. Moreover, the efficacy equivalence of CT-P17 and reference adalimumab was demonstrated in a phase 3 clinical trial of patients with rheumatoid arthritis [<xref ref-type="bibr" rid="CR5">5</xref>]. Comparability with respect to pharmacokinetics (PK), safety, and immunogenicity was also established in the same 1-year trial, including after switching [<xref ref-type="bibr" rid="CR6">6</xref>].</p><p id="Par8">The current phase 3 study evaluated the similarity and interchangeability of CT-P17 and reference adalimumab in patients with moderate-to-severe chronic plaque psoriasis. Primary results and findings from the switching period of the study during which patients either continued reference adalimumab or switched between CT-P17 and reference adalimumab multiple times, have been reported previously [<xref ref-type="bibr" rid="CR7">7</xref>]. During this period, PK equivalence was demonstrated, along with similarity in efficacy, safety, and immunogenicity [<xref ref-type="bibr" rid="CR7">7</xref>].</p><p id="Par9">Here, we report data from the subsequent open-label extension period (OLE) of the study during which all patients received CT-P17. Secondary endpoints evaluated during this period included PK, efficacy, safety, and immunogenicity.</p><p id="Par10">The aim of this study was to demonstrate the interchangeability of CT-P17 and reference adalimumab in a repeated-switch scenario over 52 weeks.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Study Design</title><p id="Par11">This was a randomized, double-blind, active-controlled phase 3 study (NCT05495568) conducted across 24 centers in Poland and Estonia. The full study design has been detailed previously [<xref ref-type="bibr" rid="CR7">7</xref>]. In brief, after a screening period, patients were treated (via subcutaneous injection using a prefilled syringe) with an initial 80-mg dose of reference adalimumab on day 1, followed by a 40-mg dose on week 1 and then every other week (EOW) until week 11 (lead-in period; week 0 to week 13 [predose]).</p><p id="Par12">Patients were randomized (1:1) prior to the week 13 dose to either continue treatment with 40&#x000a0;mg reference adalimumab EOW (&#x0201c;continuous&#x0201d; group) or to undertake multiple treatment switches between 40&#x000a0;mg reference adalimumab and 40&#x000a0;mg CT-P17 (&#x0201c;switching&#x0201d; group). The switching period continued from week 13 to week 27 (predose). At week 27, patients from both groups could proceed in an OLE during which they received 40&#x000a0;mg CT-P17 EOW until week 49, with a final end-of-study (EOS) visit at week 52. During the OLE, treatment could be administered either by the patient/their caregiver or by study center staff.</p></sec><sec id="Sec4"><title>Ethics</title><p id="Par13">As outlined previously [<xref ref-type="bibr" rid="CR7">7</xref>], the study was conducted in accordance with the principles of the Declaration of Helsinki 1964 and Good Clinical Practice. All aspects of the study complied with national, state, and local laws. Institutional review boards and ethics committees are reported in Supplementary Material (Table <xref rid="MOESM1" ref-type="media">S1</xref>). Patients provided informed consent to participate. WRO MEDICA, Poland, acted as the master ethics committee.</p></sec><sec id="Sec5"><title>Participants</title><p id="Par14">Detailed eligibility criteria have been published previously [<xref ref-type="bibr" rid="CR7">7</xref>]. In summary, eligible patients were adults aged between 18 and 75&#x000a0;years (inclusive), with a diagnosis of chronic plaque psoriasis for&#x02009;&#x02265;&#x02009;24&#x000a0;weeks prior to initial treatment, and which was classed as stable and moderate to severe. Key exclusion criteria were psoriasis diagnoses other than chronic plaque psoriasis or medication-induced psoriasis; previous treatment with a tumor necrosis factor inhibitor or with&#x02009;&#x02265;&#x02009;2 biologics predicted to interfere with the study; history of, or ongoing, tuberculosis infection; and other specified conditions. Use of certain medications was prohibited, including topical psoriasis treatments (within 2&#x000a0;weeks before first study drug administration), ultraviolet A/B phototherapy, or systemic immunomodulators (within 4&#x000a0;weeks before first study drug administration).</p></sec><sec id="Sec6"><title>Assessments and Endpoints During the OLE</title><p id="Par15">Assessments and endpoints, including methods for PK analysis, have been detailed previously [<xref ref-type="bibr" rid="CR7">7</xref>]. In the OLE, secondary PK, efficacy, and immunogenicity endpoints were measured at weeks 35, 43, and 52. Safety was assessed throughout the study. Secondary PK endpoints included trough serum concentration (C<sub>trough</sub>) until week 52. After week 25 (i.e., during the OLE), blood samples were only collected prior to drug administration; therefore, C<sub>trough</sub> was replaced by serum concentration during the OLE.</p><p id="Par16">Secondary efficacy endpoints were measured until week 52, including mean percent improvement from baseline in Psoriasis Area Severity Index (PASI) score, the proportion of patients displaying a 50/75/90/100% improvement in PASI (PASI 50/75/90/100), and the proportion of patients with a static Physician&#x02019;s Global Assessment (sPGA) score of 0 (clear) or 1 (almost clear). Safety endpoints included treatment-emergent adverse events (TEAEs) and treatment-emergent serious adverse events (TESAEs). TEAEs of special interest (TEAESI) were injection-site reactions (ISRs), hypersensitivity including anaphylaxis, infections, malignancies, demyelinating diseases, heart failure, and lupus-like syndrome. TEAEs were coded according to the Medical Dictionary for Regulatory Activities version 26.0, and their severity was graded according to the Common Terminology Criteria for Adverse Events version 5.0.</p><p id="Par17">During the OLE, clinical laboratory analyses (via blood and urine tests), physical examination, and vital sign measurement were performed at weeks 35, 43, and 52. Electrocardiograms were performed at week 52. In the OLE, tuberculosis was assessed using chest X-ray and interferon gamma release assay (IGRA) at week 52. Clinical signs and symptoms of tuberculosis were monitored throughout the study.</p><p id="Par18">Immunogenicity was assessed via measurement of antidrug antibody (ADA) and neutralizing antibody (NAb) levels, as described previously [<xref ref-type="bibr" rid="CR7">7</xref>]. In the OLE, immunogenicity was assessed at weeks 35, 43, and 52.</p><p id="Par19">The following post hoc analyses were also conducted on data from time points before and during the OLE: efficacy endpoints assessed in patients with and without prior use of biologic therapy for psoriasis, primary PK endpoints by ADA subgroup, mean improvement from baseline in PASI score by ADA subgroup, and analysis of TEAEs by ADA subgroup. Patients who had&#x02009;&#x02265;&#x02009;1 ADA-positive result after the first study drug administration (day 1) up to week 27 were included in the ADA-positive subgroup for the analysis of primary PK endpoints by ADA status. Patients who had&#x02009;&#x02265;&#x02009;1 ADA-positive result after the first study drug administration (day 1) up to week 27 and up to week 52 were included in the ADA-positive subgroup for the analysis of efficacy/safety endpoints by ADA status.</p></sec><sec id="Sec7"><title>Statistical Analyses</title><p id="Par20">Sample size calculations and analysis populations have been explained in detail previously [<xref ref-type="bibr" rid="CR7">7</xref>]. In brief, the intent-to-treat population comprised all enrolled patients. Statistical analyses of secondary PK endpoints were performed in the PK population, which included all patients who had been randomized, received&#x02009;&#x02265;&#x02009;1 full dose of study drug, and had&#x02009;&#x02265;&#x02009;1 post-treatment PK result during the switching period. Statistical analyses of secondary efficacy and safety endpoints were performed in the safety population, which comprised patients who had been randomized and received&#x02009;&#x02265;&#x02009;1 full or partial dose of study drug during the switching period. Continuous data were summarized using descriptive statistics, whereas categorical data were summarized by frequency. Serum drug concentrations below the lower limit of quantification (BLQ) of the PK assay (100&#x000a0;ng/mL) prior to the first study drug administration (day 1) were set to 0; all other BLQ values were set to the lower limit of the assay. PK parameters were analyzed via noncompartmental methods.</p><p id="Par21">Statistical analyses were conducted in SAS version 9.4 (SAS Institute, Inc., Cary, NC, USA).</p></sec></sec><sec id="Sec8"><title>Results</title><sec id="Sec9"><title>Patient Disposition, Demographics, and Baseline Characteristics</title><p id="Par22">Patient disposition throughout the study is summarized in Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>. Of the 367 patients enrolled in the study, 346 were randomized (172 to the switching group and 174 to the continuous group). Following the switching period, most patients (327) continued into the OLE (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>). Of the 346 patients randomized, 312 (90.2%) completed the entire study: 152 (88.4%) from the group that previously underwent switching and 160 (92.0%) from the prior &#x0201c;continuous&#x0201d; group.<fig id="Fig1"><label>Fig.&#x000a0;1</label><caption><p>Summary of patient disposition (ITT population). Adapted from [<xref ref-type="bibr" rid="CR7">7</xref>] with permission from Springer Nature; <italic>ITT</italic> intent-to-treat, <italic>OLE</italic> open-label extension; <sup>a</sup>One patient erroneously received CT-P17 at week 23 and thus was included in the switching group for the safety analysis</p></caption><graphic xlink:href="13555_2025_1383_Fig1_HTML" id="MO1"/></fig></p><p id="Par23">Few patients discontinued the study during the OLE: nine (5.2%) and six (3.4%) patients from the switching and continuous groups, respectively. The most common reasons for discontinuation were withdrawal by the patient in the switching group (seven [4.1%] patients) and adverse event (AE) in the continuous group (three [1.7%] patients). Patient demographics and characteristics at baseline were similar between the two groups [<xref ref-type="bibr" rid="CR7">7</xref>].</p></sec><sec id="Sec10"><title>Pharmacokinetics</title><p id="Par24">Mean serum concentrations were comparable between groups up to week 27 [<xref ref-type="bibr" rid="CR7">7</xref>] and during the OLE, regardless of treatment prior to entering the OLE (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>). Mean (standard deviation [SD]) serum concentration at weeks 35, 43, and 52 was 6892.2 (5023.8), 6848.2 (4902.0), and 5824.1 (4601.8) ng/mL, respectively, in the group that previously underwent switching and 6079.1 (4604.1), 6010.3 (4722.7), and 5096.1 (4239.3) ng/mL, respectively, in patients from the prior continuous group. A trend to reduced serum concentration at week 52 (EOS) was observed in both groups.<fig id="Fig2"><label>Fig.&#x000a0;2</label><caption><p>Mean (SD) serum concentration of adalimumab over the study period (PK population); <italic>EOS</italic> end of study, <italic>OLE</italic> open-label extension, <italic>PK</italic> pharmacokinetic, <italic>SD</italic> standard deviation. Plotted on a linear scale</p></caption><graphic xlink:href="13555_2025_1383_Fig2_HTML" id="MO2"/></fig></p><p id="Par25">The primary PK parameters of area under the concentration&#x02013;time curve from week 25 to week 27 (AUC<sub>tau</sub>,<sub>W25&#x02013;27</sub>) and maximum observed plasma concentration between week 25 and week 27 (C<sub>max</sub>,<sub>W25&#x02013;27</sub>) demonstrated bioequivalence between CT-P17 and reference adalimumab [<xref ref-type="bibr" rid="CR7">7</xref>]. In a post hoc analysis, AUC<sub>tau</sub>,<sub>W25&#x02013;27</sub> and C<sub>max</sub>,<sub>W25&#x02013;27</sub> were both lower overall in patients in the ADA-positive subgroup than in those in the ADA-negative subgroup; however, AUC<sub>tau</sub>,<sub>W25&#x02013;27</sub> and C<sub>max</sub>,<sub>W25&#x02013;27</sub> were comparable between groups within each ADA subgroup (Supplementary Material, Table S2).</p></sec><sec id="Sec11"><title>Efficacy</title><p id="Par26">Efficacy results up to week 27 were similar between groups and have been reported previously [<xref ref-type="bibr" rid="CR7">7</xref>]. Secondary efficacy endpoints during the OLE are summarized in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>. For each endpoint, efficacy was similar between groups, regardless of treatment prior to entering the OLE. Overall, mean (SD) percent improvement from baseline in PASI score was 91.98 (16.47), 91.63 (15.98), and 90.34 (16.59) at weeks 35, 43, and 52, respectively. Overall, at week 52 (EOS), PASI 50, 75, 90, and 100 responses were achieved by 298 (86.4%), 273 (79.1%), 226 (65.5%), and 140 (40.6%) patients, respectively. Clear or almost clear sPGA scores were achieved by 263 (76.2%) patients overall at week 52.<table-wrap id="Tab1"><label>Table&#x000a0;1</label><caption><p>Efficacy endpoints during the OLE (safety population)</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">Switching<break/>(<italic>n</italic>&#x02009;=&#x02009;172)</th><th align="left">Continuous<break/>(<italic>n</italic>&#x02009;=&#x02009;173)</th></tr></thead><tbody><tr><td align="left" colspan="3"><bold>Week 35</bold></td></tr><tr><td align="left" colspan="3">Percent improvement from baseline in PASI score</td></tr><tr><td align="left">&#x000a0;<italic>n</italic></td><td align="left">157</td><td align="left">161</td></tr><tr><td align="left">&#x000a0;Mean (SD)</td><td align="left">92.12 (17.96)</td><td align="left">91.84 (14.92)</td></tr><tr><td align="left" colspan="3">Patients achieving response</td></tr><tr><td align="left">&#x000a0;PASI 50</td><td align="left">152 (88.4)</td><td align="left">158 (91.3)</td></tr><tr><td align="left">&#x000a0;PASI 75</td><td align="left">143 (83.1)</td><td align="left">149 (86.1)</td></tr><tr><td align="left">&#x000a0;PASI 90</td><td align="left">125 (72.7)</td><td align="left">117 (67.6)</td></tr><tr><td align="left">&#x000a0;PASI 100</td><td align="left">80 (46.5)</td><td align="left">72 (41.6)</td></tr><tr><td align="left">Patients with sPGA score of 0 or 1</td><td align="left">139 (80.8)</td><td align="left">137 (79.2)</td></tr><tr><td align="left" colspan="3"><bold>Week 43</bold></td></tr><tr><td align="left" colspan="3">Percent improvement from baseline in PASI score</td></tr><tr><td align="left">&#x000a0;<italic>n</italic></td><td align="left">154</td><td align="left">160</td></tr><tr><td align="left">&#x000a0;Mean (SD)</td><td align="left">91.73 (16.42)</td><td align="left">91.53 (15.59)</td></tr><tr><td align="left" colspan="3">Patients achieving response</td></tr><tr><td align="left">&#x000a0;PASI 50</td><td align="left">148 (86.0)</td><td align="left">155 (89.6)</td></tr><tr><td align="left">&#x000a0;PASI 75</td><td align="left">140 (81.4)</td><td align="left">144 (83.2)</td></tr><tr><td align="left">&#x000a0;PASI 90</td><td align="left">119 (69.2)</td><td align="left">119 (68.8)</td></tr><tr><td align="left">&#x000a0;PASI 100</td><td align="left">72 (41.9)</td><td align="left">77 (44.5)</td></tr><tr><td align="left">Patients with sPGA score of 0 or 1</td><td align="left">132 (76.7)</td><td align="left">135 (78.0)</td></tr><tr><td align="left" colspan="3"><bold>Week 52 (EOS)</bold></td></tr><tr><td align="left" colspan="3"><p>Percent improvement from baseline in</p><p>PASI score</p></td></tr><tr><td align="left">&#x000a0;<italic>n</italic></td><td align="left">153</td><td align="left">159</td></tr><tr><td align="left">&#x000a0;Mean (SD)</td><td align="left">90.59 (16.92)</td><td align="left">90.10 (16.33)</td></tr><tr><td align="left" colspan="3">Patients achieving response</td></tr><tr><td align="left">&#x000a0;PASI 50</td><td align="left">145 (84.3)</td><td align="left">153 (88.4)</td></tr><tr><td align="left">&#x000a0;PASI 75</td><td align="left">136 (79.1)</td><td align="left">137 (79.2)</td></tr><tr><td align="left">&#x000a0;PASI 90</td><td align="left">114 (66.3)</td><td align="left">112 (64.7)</td></tr><tr><td align="left">&#x000a0;PASI 100</td><td align="left">69 (40.1)</td><td align="left">71 (41.0)</td></tr><tr><td align="left">Patients with sPGA score of 0 or 1</td><td align="left">133 (77.3)</td><td align="left">130 (75.1)</td></tr></tbody></table><table-wrap-foot><p><italic>EOS</italic> end of study, <italic>OLE</italic> open-label extension, <italic>PASI</italic> Psoriasis Area and Severity Index, <italic>PASI 50/75/90/100</italic> 50%/75%/90%/100% improvement from baseline in PASI score, <italic>SD</italic> standard deviation, <italic>sPGA</italic> static Physician&#x02019;s Global Assessment</p><p>Data are presented as <italic>n</italic> (%) of patients unless otherwise indicated</p></table-wrap-foot></table-wrap></p><p id="Par27">For each of these secondary efficacy endpoints, results were also similar between and within groups in post hoc subgroup analyses according to prior use of biologic therapies (Supplementary Material, Table S3).</p><p id="Par28">In a further post hoc subgroup analysis, mean (SD) improvements in PASI score from baseline at week 27 and week 52 were slightly lower in patients in the ADA-positive subgroup versus those in the ADA-negative subgroup. However, improvements were similar between groups within each ADA subgroup (Supplementary Material, Table S4).</p></sec><sec id="Sec12"><title>Safety</title><p id="Par29">In the post-randomization period (weeks 13&#x02013;52; encompassing the switching and OLE portions of the study), 191 (55.4%) patients reported TEAEs (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). The most common TEAE was upper respiratory tract infection, occurring in 31 (9.0%) patients. The majority of TEAEs were grade 1 or 2 in intensity. Grade 3 TEAEs were reported as the most severe grade in 25 (7.2%) patients, at a similar rate in the two groups (14 [8.1%] and 11 [6.4%] patients in the switching and continuous groups, respectively). One (0.6%) grade 4 TEAE (hypertriglyceridemia) was recorded in the continuous group. The most common grade 3/4 TEAE was hypertriglyceridemia (including the preferred terms hypertriglyceridemia and increased blood triglycerides), present in nine (2.6%) patients (five [2.9%] and four [2.3%] patients in the switching and continuous groups, respectively).<table-wrap id="Tab2"><label>Table&#x000a0;2</label><caption><p>Summary of TEAEs recorded during the post-randomization period (week 13&#x02013;52; safety population)</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">Switching (<italic>n</italic>&#x02009;=&#x02009;172)</th><th align="left">Continuous (<italic>n</italic>&#x02009;=&#x02009;173)</th></tr></thead><tbody><tr><td align="left"><bold>Total number of TEAEs</bold></td><td align="left">174</td><td align="left">232</td></tr><tr><td align="left">Patients with&#x02009;&#x02265;&#x02009;1 TEAE</td><td align="left">95 (55.2)</td><td align="left">96 (55.5)</td></tr><tr><td align="left">&#x000a0;Study drug-related</td><td align="left">26 (15.1)</td><td align="left">32 (18.5)</td></tr><tr><td align="left"><bold>Total number of TESAEs</bold></td><td align="left">6</td><td align="left">4</td></tr><tr><td align="left">Patients with&#x02009;&#x02265;&#x02009;1 TESAE</td><td align="left">6 (3.5)</td><td align="left">4 (2.3)</td></tr><tr><td align="left">&#x000a0;Study drug-related</td><td align="left">0</td><td align="left">2 (1.2)</td></tr><tr><td align="left"><bold>Total number of TEAEs leading to discontinuation of study drug</bold></td><td align="left">2</td><td align="left">2</td></tr><tr><td align="left">Patients with&#x02009;&#x02265;&#x02009;1 TEAE leading to discontinuation of study drug</td><td align="left">2 (1.2)</td><td align="left">2 (1.2)</td></tr><tr><td align="left">&#x000a0;Study drug-related</td><td align="left">1 (0.6)</td><td align="left">2 (1.2)</td></tr><tr><td align="left"><bold>Total number of TEAEs classified as injection-site reactions</bold></td><td align="left">8</td><td align="left">12</td></tr><tr><td align="left">Patients with&#x02009;&#x02265;&#x02009;1 TEAE classified as injection-site reactions</td><td align="left">3 (1.7)</td><td align="left">6 (3.5)</td></tr><tr><td align="left">&#x000a0;Study drug-related</td><td align="left">3 (1.7)</td><td align="left">6 (3.5)</td></tr><tr><td align="left"><bold>Total number of TEAEs classified as infection</bold></td><td align="left">63</td><td align="left">72</td></tr><tr><td align="left">Patients with&#x02009;&#x02265;&#x02009;1 TEAE classified as infection</td><td align="left">49 (28.5)</td><td align="left">50 (28.9)</td></tr><tr><td align="left">&#x000a0;Study drug-related</td><td align="left">11 (6.4)</td><td align="left">10 (5.8)</td></tr><tr><td align="left"><bold>Total number of TEAEs classified as hypersensitivity including anaphylaxis</bold></td><td align="left">0</td><td align="left">1</td></tr><tr><td align="left">Patients with&#x02009;&#x02265;&#x02009;1 TEAE classified as hypersensitivity including anaphylaxis</td><td align="left">0</td><td align="left">1 (0.6)</td></tr><tr><td align="left">&#x000a0;Study drug-related</td><td align="left">0</td><td align="left">1 (0.6)</td></tr><tr><td align="left"><bold>Total number of TEAEs leading to death</bold></td><td align="left">0</td><td align="left">0</td></tr></tbody></table><table-wrap-foot><p><italic>TEAE</italic> treatment-emergent adverse event, <italic>TESAE</italic> treatment-emergent serious adverse event</p><p>There were no TEAEs classified as malignancies, demyelinating diseases, heart failure, or lupus-like syndrome</p><p>Data are presented as <italic>n</italic> (%) of patients unless otherwise indicated</p></table-wrap-foot></table-wrap></p><p id="Par30">Study drug-related TEAEs were observed in 58 (16.8%) patients and by a similar proportion of patients in each group. ISR (nine [2.6%] patients), upper respiratory tract infection (eight [2.3%] patients), and increased alanine aminotransferase (six [1.7%] patients) were the most common. With respect to TEAESI, infection was the most common (99 [28.7%] patients), followed by ISR (nine [2.6%] patients). There was one (0.3%) case of hypersensitivity including anaphylaxis in the continuous group, and no cases of other TEAESI. No TEAEs leading to death were reported.</p><p id="Par31">Discontinuation because of a TEAE was reported in four (1.2%) patients (two [1.2%] in each group). Serious TEAEs were observed in ten (2.9%) patients; six (3.5%) and four (2.3%) in the switching and the continuous group, respectively. Two (1.2%) serious TEAEs (ischemic stroke and diverticulitis) were identified as study drug-related, both in the continuous group.</p><p id="Par32">Reported TEAEs in&#x02009;&#x02265;&#x02009;3% of patients in either group for the overall study period, including the lead-in and post-randomization period, are presented in Supplementary Material (Table S5).</p><p id="Par33">During the OLE, there were no notable differences between groups with respect to changes from baseline in laboratory analyses, physical examination, vital signs, or electrocardiogram. Two (0.6%) patients, one in each group, had positive IGRA results at week 52. No patients developed signs or symptoms of tuberculosis during the overall study period, and no active cases of tuberculosis were reported.</p><p id="Par34">Post hoc analysis showed that the proportion of patients who reported TEAEs was similar across ADA subgroups (Supplementary Material, Table S6). Within the ADA-positive subgroup, the proportion of patients who reported TEAEs was similar between groups. Within the ADA-negative subgroup, the proportion was lower overall in the switching group than in the continuous group.</p><p id="Par35">The proportion of patients with TESAEs was also similar between ADA subgroups. The proportion within the ADA-positive subgroup was small and similar between groups. Within the ADA-negative subgroup, one patient in the switching group had a TESAE, and no TESAEs were reported in the continuous group (Supplementary Material, Table S6).</p><p id="Par36">With respect to TEAESI, the proportion of patients with infections was similar between ADA subgroups. However, within the ADA-negative subgroup, the proportion was lower in the switching group than in the continuous group. ISRs were reported by a similar proportion of patients in both ADA subgroups up to week 27, whilst ISRs were only reported in the ADA-positive subgroup up to week 52. One (0.6%) patient in the continuous group and ADA-positive subgroup reported hypersensitivity including anaphylaxis up to week 52 (Supplementary Material, Table S6).</p></sec><sec id="Sec13"><title>Immunogenicity</title><p id="Par37">During the OLE, rates of patients who were ADA- and NAb-positive were slightly lower in the group that previously underwent switching than in the continuous group (Supplementary Material, Table S7).</p></sec></sec><sec id="Sec14"><title>Discussion</title><p id="Par38">In the present 52-week analysis, PK, efficacy, safety, and immunogenicity findings with CT-P17 and reference adalimumab remained similar throughout the OLE (week 27&#x02013;52) of this phase 3 study in patients with moderate-to-severe chronic plaque psoriasis, regardless of prior treatment, and were also generally comparable across time points. These longer-term, open-label data support the study&#x02019;s primary findings at week 27 and the previously reported interchangeability of CT-P17 and reference adalimumab [<xref ref-type="bibr" rid="CR7">7</xref>].</p><p id="Par39">The mean serum concentrations of adalimumab were comparable between the switching and continuous groups at weeks 35 and 43, and were similar to trough concentrations observed in earlier study periods (the lead-in and switching period) [<xref ref-type="bibr" rid="CR7">7</xref>]. There was a trend of reduced serum concentration at week 52 observed in both groups, which may have been influenced by the timing of this sampling taken 3 weeks after the last dose. Primary PK endpoints of AUC<sub>tau</sub>,<sub>W25&#x02013;27</sub> and C<sub>max</sub>,<sub>W25&#x02013;27</sub> were similar between groups in post hoc analyses of ADA-positive and ADA-negative subgroups, although, as expected [<xref ref-type="bibr" rid="CR4">4</xref>, <xref ref-type="bibr" rid="CR8">8</xref>], both endpoints were higher in the latter subgroup. Nevertheless, these post hoc findings should be interpreted with caution owing to the small number of patients in the ADA-negative subgroup.</p><p id="Par40">In this study, sustained and comparable efficacy between groups was maintained in the OLE, with respect to mean percent improvement from baseline in PASI score, proportions of PASI 50/75/90/100 responders, and proportion of clear or almost clear sPGA scores. These findings generally align with previous reports of open-label treatment with reference adalimumab [<xref ref-type="bibr" rid="CR9">9</xref>].</p><p id="Par41">Efficacy results were also similar within and between groups in post hoc subgroup analysis by use of prior biologic therapy. These findings align with those from a previous real-world evidence study that observed no differences in efficacy between biologic-na&#x000ef;ve and biologic-experienced patients over prolonged treatment with adalimumab [<xref ref-type="bibr" rid="CR10">10</xref>]. Post hoc analysis demonstrated, albeit with a small number of patients in the ADA-negative subgroup, an association between better efficacy and ADA-negative status, a known and previously reported occurrence with biologics [<xref ref-type="bibr" rid="CR11">11</xref>, <xref ref-type="bibr" rid="CR12">12</xref>]. This finding was consistent between groups, reinforcing the similarity between CT-P17 and reference adalimumab.</p><p id="Par42">CT-P17 was well tolerated across the 52-week study period. During the post-randomization period, rates of TEAEs and TESAEs (including study drug-related events) were similar between both groups. The majority of events were grade 1 or 2 in intensity, discontinuation rates were low (1.2%), and no deaths occurred. The most common study drug-related TEAE was ISR (2.6%), and no TEAEs of malignancy, demyelinating diseases, heart failure, or lupus-like syndrome were reported. Overall, safety findings were consistent with reported safety profiles of CT-P17 and reference adalimumab [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>, <xref ref-type="bibr" rid="CR13">13</xref>, <xref ref-type="bibr" rid="CR14">14</xref>] and with a previous switching study of CT-P17 and reference adalimumab [<xref ref-type="bibr" rid="CR6">6</xref>].</p><p id="Par43">Safety results were also generally similar in a post hoc analysis across ADA subgroups up to week 27 and up to week 52. However, within the ADA-negative subgroup, TEAEs and infections were less common in the switching group than in the continuous group. These results should be interpreted with caution owing to the small number of patients in the ADA-negative subgroup (up to week 27: <italic>n</italic>&#x02009;=&#x02009;38; up to week 52: <italic>n</italic>&#x02009;=&#x02009;31) and the imbalance of patients between the switching (up to week 27: <italic>n</italic>&#x02009;=&#x02009;24; up to week 52: <italic>n</italic>&#x02009;=&#x02009;21) and continuous (up to week 27: <italic>n</italic>&#x02009;=&#x02009;14; up to week 52: <italic>n</italic>&#x02009;=&#x02009;10) groups. The almost exclusive occurrence of ISRs in the ADA-positive subgroup may suggest an association between ADA formation and ISR [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR15">15</xref>, <xref ref-type="bibr" rid="CR16">16</xref>]. The proportion of patients reporting ISRs was similarly small in both groups, suggesting that switching between reference adalimumab and CT-P17 did not increase the risk of immune-related TEAEs.</p><p id="Par44">During the OLE, a slightly lower proportion of patients in the switching group had ADA-positive and NAb-positive results compared with those from the continuous group. For example, at week 52, 62.8% and 75.1% of patients were ADA-positive in the switching and continuous groups, respectively, while 54.1% and 64.2% were NAb-positive. These results were in line with findings at week 27, whereby immunogenicity was slightly lower in the switching group than in the continuous group [<xref ref-type="bibr" rid="CR7">7</xref>].</p><p id="Par45">The strengths of this study and the current 52-week analysis include the relevance of the study population to the real-world use of CT-P17. The robustness of the study design, which was in accordance with the US Food and Drug Administration (FDA) requirements for demonstrating interchangeability with a reference biologic [<xref ref-type="bibr" rid="CR17">17</xref>, <xref ref-type="bibr" rid="CR18">18</xref>], is a key strength.</p><p id="Par46">The study has limitations, including the inherent fact that dosing was open label after week 27. There was potential for variability in dosing accuracy because the study drug could be administered by patients/caregivers during the OLE. To mitigate this, training was provided to ensure proper administration. Long-term results from studies that include more switches are needed to further assess the interchangeability of CT-P17 and reference adalimumab.</p></sec><sec id="Sec15"><title>Conclusions</title><p id="Par47">In this 52-week analysis of a phase 3 study in patients with moderate-to-severe plaque psoriasis, PK, efficacy, safety, and immunogenicity findings were similar during open-label treatment with CT-P17 in patients who had previously undergone repeated switches between CT-P17 and reference adalimumab and those who had previously received continuous reference adalimumab. This further supports the interchangeability of CT-P17 and reference adalimumab for the treatment of moderate-to-severe plaque psoriasis.</p></sec><sec id="Sec16" sec-type="supplementary-material"><title>Supplementary Information</title><p>Below is the link to the electronic Supplementary Material.<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="13555_2025_1383_MOESM1_ESM.pdf"><caption><p>Supplementary File 1 (PDF 218 KB)</p></caption></media></supplementary-material></p></sec></body><back><fn-group><fn><p><bold>Prior presentation</bold>: data were presented at the 2025 American Academy of Dermatology (AAD) Annual Meeting (March 7&#x02013;11, 2025; Florida, USA).</p></fn></fn-group><ack><title>Acknowledgements</title><p>We thank all patients and investigators involved in the study.</p><sec id="d33e1202"><title>Medical Writing, Editorial, and Other Assistance</title><p>Medical writing support, including development of a draft outline and subsequent drafts in consultation with the authors, collating author comments, copy editing, fact checking, and referencing, was provided by Samantha Booth, PhD, at Aspire Scientific Ltd (Bollington, UK). Funding for medical writing support for this article was provided by Celltrion, Inc. (Incheon, Republic of Korea).</p></sec></ack><notes notes-type="author-contribution"><title>Author Contributions</title><p>David M. Pariser, Mark G. Lebwohl, SungHyun Kim, JeeHye Suh, EunJin Choi, JungBin Cha, HyunJin Lee, SungJeong Lee, and John Y. Koo contributed to study design. Janusz Jaworski, Jakub Trefler, Stefan Daniluk, Anna Dudek, Wojciech Baran, Witold Owczarek, Pawel Brzewski, Mariusz Sikora, Marek Krogulec, SungHyun Kim, JeeHye Suh, EunJin Choi, JungBin Cha, HyunJin Lee, and SungJeong Lee contributed to data collection. All authors contributed to data analysis or interpretation, reviewed and critically revised the manuscript, approved the final draft, and are accountable for the accuracy and integrity of the manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>This study and the publication rapid service fee were funded by Celltrion, Inc. (Incheon, Republic of Korea).</p></notes><notes notes-type="data-availability"><title>Data Availability</title><p>All data generated and/or analyzed during this study are included in the published article/as supplementary material.</p></notes><notes><title>Declarations</title><notes id="FPar1" notes-type="COI-statement"><title>Conflicts of interest</title><p id="Par48">Janusz Jaworski, Jakub Trefler, Stefan Daniluk, Anna Dudek, Wojciech Baran, Mariusz Sikora, and Marek Krogulec were study investigators in the presented CT-P17 3.3. study and have no other conflicts of interest to declare. David M. Pariser was a study investigator in the presented CT-P17 3.3. study, has personally received honorarium for participating in a data safety monitoring board for Bristol Myers Squibb, and has received institutional research funding from Novartis, Pfizer, and Regeneron. Mark G. Lebwohl is an employee of Mount Sinai, was a study investigator in the presented CT-P17 3.3. study, receives research funding from AbbVie, Arcutis Biotherapeutics, Avotres Inc., Boehringer Ingelheim, Cara Therapeutics, Clexio, Dermavant Sciences, Eli Lilly, Incyte Corporation, Inozyme Pharma, Janssen Pharmaceuticals, Pfizer, Sanofi/Regeneron, and UCB, and is a consultant for Almirall, AltruBio, Apogee Therapeutics, Arcutis Biotherapeutics, AstraZeneca, Atomwise, Avotres Inc., Boehringer Ingelheim, Bristol Myers Squibb, Castle Biosciences, Celltrion, Corevitas, Dermavant Sciences, dermsquared, Evommune, Facilitation of International Dermatology Education, Forte Biosciences, Galderma, Genentech, Incyte Corporation, LEO Pharma, Meiji Seika Pharma, Mindera Health, Mirum Pharmaceuticals, Pfizer, Sanofi/Regeneron, Seanergy Pharma, Strata, Takeda, Trevi Therapeutics, and Verrica Pharmaceuticals. Mark G. Lebwohl is an Editorial Board member of Dermatology and Therapy. Mark G. Lebwohl was not involved in the selection of peer reviewers for the manuscript nor any of the subsequent editorial decisions. Witold Owczarek was a study investigator in the presented CT-P17 3.3. study and has received honorarium for lectures and clinical research from AbbVie, Aflofarm Farmacja, Alfasigma, Almirall, Amgen, Apotex Polska, Astellas, AstraZeneca, Bausch Health Poland, Berlin Chemie Menarini, Boehringer Ingelheim, Bristol Myers Squibb, Celltrion, Egis Pharmaceuticals, Eli Lilly, Galderma, Janssen-Cilag, LEO Pharma, Medac GmbH, Merck, Mylan Healthcare, Novartis, Pfizer, Pierre Fabre Medicament, TZF Polfa S.A., Roche Diagnostics, Sandoz, Sanofi, SUN-FARM, Teva Pharmaceuticals, and UCB Pharma. Pawel Brzewski was a study investigator in the presented CT-P17 3.3 study and has received honorarium and/or consultation fees from AbbVie, Amgen, Concert Pharmaceuticals, Eli Lilly, Innovaderm Research, Janssen Pharmaceuticals, LEO Pharma, Novartis, Pfizer, Samsung, and Sanofi Genzyme. SungHyun Kim, JeeHye Suh, EunJin Choi, JungBin Cha, HyunJin Lee, and SungJeong Lee are employees of Celltrion, Inc. John Y. Koo was a study investigator in the presented CT-P17 3.3. study, has received speaker honorarium from AbbVie, Amgen, Boehringer Ingelheim, Bristol Myers Squibb, Dermavant Sciences, Janssen Pharmaceuticals, Eli Lilly, LEO Pharma, Pfizer, Sanofi/Regeneron, SUN Pharma, and UCB, and has advised Arcutis, LEO Pharma, and Pfizer.</p></notes><notes id="FPar2"><title>Ethical Approval</title><p id="Par49">The study was conducted in accordance with the principles of the Declaration of Helsinki 1964 and Good Clinical Practice. All aspects of the study complied with national, state, and local laws. Institutional review boards and ethics committees are reported in Supplementary Material (Table S1). Patients provided informed consent to participate. WRO MEDICA, Poland, acted as the master ethics committee.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><mixed-citation publication-type="other">Celltrion Inc. YUFLYMA (adalimumab-aaty) injection, for subcutaneous use [US prescribing information]. <ext-link ext-link-type="uri" xlink:href="https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/761219s011lbl.pdf">https://www.accessdata.fda.gov/drugsatfda_docs/label/2024/761219s011lbl.pdf</ext-link>. Published 2023. Updated Aug 2024. Accessed 29 Nov 2024.</mixed-citation></ref><ref id="CR2"><label>2.</label><mixed-citation publication-type="other">Celltrion Healthcare Hungary Kft. Yuflyma 40 mg solution for injection in pre-filled syringe [summary of product characteristics]. <ext-link ext-link-type="uri" xlink:href="https://www.ema.europa.eu/en/documents/product-information/yuflyma-epar-product-information_en.pdf">https://www.ema.europa.eu/en/documents/product-information/yuflyma-epar-product-information_en.pdf</ext-link>. Published 2021. Updated Nov 2024. Accessed 29 Nov 2024.</mixed-citation></ref><ref id="CR3"><label>3.</label><citation-alternatives><element-citation id="ec-CR3" publication-ty
<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Dermatol Ther (Heidelb)</journal-id><journal-id journal-id-type="iso-abbrev">Dermatol Ther (Heidelb)</journal-id><journal-title-group><journal-title>Dermatology and Therapy</journal-title></journal-title-group><issn pub-type="ppub">2193-8210</issn><issn pub-type="epub">2190-9172</issn><publisher><publisher-name>Springer Healthcare</publisher-name><publisher-loc>Cheshire</publisher-loc></publisher></journal-meta>

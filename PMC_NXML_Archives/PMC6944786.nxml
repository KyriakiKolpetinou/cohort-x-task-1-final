w of literature</article-title><source>Pain Physician</source><year>2008</year><volume>11</volume><fpage>215</fpage><lpage>24</lpage><pub-id pub-id-type="pmid">18354713</pub-id></element-citation></ref><ref id="b15-inj-1938112-056"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schelhorn</surname><given-names>J</given-names></name><name><surname>Habenicht</surname><given-names>U</given-names></name><name><surname>Malessa</surname><given-names>R</given-names></name><name><surname>Dannenberg</surname><given-names>C</given-names></name></person-group><article-title>Magnetic resonance imaging-guided perineural therapy as a treatment option in young adults with pudendal nerve entrapment syndrome</article-title><source>Clin Neuroradiol</source><year>2013</year><volume>23</volume><fpage>161</fpage><lpage>3</lpage><pub-id pub-id-type="pmid">22481500</pub-id></element-citation></ref><ref id="b16-inj-1938112-056"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Rofaeel</surname><given-names>A</given-names></name><name><surname>Peng</surname><given-names>P</given-names></name><name><surname>Louis</surname><given-names>I</given-names></name><name><surname>Chan</surname><given-names>V</given-names></name></person-group><article-title>Feasibility of real-time ultrasound for pudendal nerve block in patients with chronic perineal pain</article-title><source>Reg Anesth Pain Med</source><year>2008</year><volume>33</volume><fpage>139</fpage><lpage>45</lpage><pub-id pub-id-type="pmid">18299095</pub-id></element-citation></ref><ref id="b17-inj-1938112-056"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Gruber</surname><given-names>H</given-names></name><name><surname>Kovacs</surname><given-names>P</given-names></name><name><surname>Piegger</surname><given-names>J</given-names></n
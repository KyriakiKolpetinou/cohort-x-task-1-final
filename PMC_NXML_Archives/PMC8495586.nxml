<article dtd-version="1.3" xml:lang="en" article-type="research-article"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">J Med Internet Res</journal-id><journal-id journal-id-type="iso-abbrev">J Med Internet Res</journal-id><journal-id journal-id-type="publisher-id">JMIR</journal-id><journal-title-group><journal-title>Journal of Medical Internet Research</journal-title></journal-title-group><issn pub-type="ppub">1439-4456</issn><issn pub-type="epub">1438-8871</issn><publisher><publisher-name>JMIR Publications</publisher-name><publisher-loc>Toronto, Canada</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">34550072</article-id><article-id pub-id-type="pmc">8495586</article-id><article-id pub-id-type="publisher-id">v23i9e22942</article-id><article-id pub-id-type="doi">10.2196/22942</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Paper</subject></subj-group><subj-group subj-group-type="article-type"><subject>Original Paper</subject></subj-group></article-categories><title-group><article-title>Comparing a Virtual Reality&#x02013;Based Simulation App (VR-MRI) With a Standard Preparatory Manual and Child Life Program for Improving Success and Reducing Anxiety During Pediatric Medical Imaging: Randomized Clinical Trial</article-title></title-group><contrib-group><contrib contrib-type="editor"><name><surname>Kukafka</surname><given-names>Rita</given-names></name></contrib></contrib-group><contrib-group><contrib contrib-type="reviewer"><name><surname>Berghmans</surname><given-names>Johan</given-names></name></contrib><contrib contrib-type="reviewer"><name><surname>McCarthy</surname><given-names>Kevin</given-names></name></contrib></contrib-group><contrib-group><contrib id="contrib1" contrib-type="author" equal-contrib="yes"><name><surname>Stunden</surname><given-names>Chelsea</given-names></name><degrees>MPH</degrees><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-0488-7238</contrib-id></contrib><contrib id="contrib2" contrib-type="author"><name><surname>Stratton</surname><given-names>Kirsten</given-names></name><degrees>CCLS</degrees><xref rid="aff3" ref-type="aff">3</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-7792-7715</contrib-id></contrib><contrib id="contrib3" contrib-type="author"><name><surname>Zakani</surname><given-names>Sima</given-names></name><degrees>PhD</degrees><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0001-7827-3680</contrib-id></contrib><contrib id="contrib4" contrib-type="author" corresp="yes" equal-contrib="yes"><name><surname>Jacob</surname><given-names>John</given-names></name><degrees>MSc, MBA</degrees><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-2212-3250</contrib-id><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref><xref rid="aff4" ref-type="aff">4</xref><address><institution>Department of Pediatrics</institution><institution>Faculty of Medicine</institution><institution>University of British Columbia</institution><addr-line>Rm 2D19</addr-line><addr-line>4480 Oak Street</addr-line><addr-line>Vancouver, BC, V6H 3V4</addr-line><country>Canada</country><phone>1 604 875 2345 ext 2393</phone><email>john.jacob@cw.bc.ca</email></address></contrib></contrib-group><aff id="aff1">

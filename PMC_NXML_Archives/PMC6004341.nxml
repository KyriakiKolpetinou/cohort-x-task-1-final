="left">FiO<sub>2</sub> (%)<sup>b</sup></td><td char="(" align="char">30 (28, 35)</td><td char="(" align="char">30 (28, 35)</td><td char="(" align="char">30 (28, 35)</td><td char="." align="char">0.83</td></tr><tr><td align="left">SpO<sub>2</sub> (%)<sup>b</sup></td><td char="(" align="char">98 (97, 100)</td><td char="(" align="char">99 (97, 100)</td><td char="(" align="char">97 (96, 99)</td><td char="." align="char">0.027</td></tr><tr><td align="left">PaCO<sub>2</sub> (mm Hg)<sup>b</sup></td><td char="(" align="char">40 (36, 46)</td><td char="(" align="char">41 (36, 45.6)</td><td char="(" align="char">39.6 (37, 45)</td><td char="." align="char">0.63</td></tr><tr><td align="left">PaO<sub>2</sub>, (mm Hg)<sup>b</sup></td><td char="(" align="char">93 (79, 115)</td><td char="(" align="char">96.5 (83, 117)</td><td char="(" align="char">92 (74, 115)</td><td char="." align="char">0.61</td></tr><tr><td align="left">pH<sup>b</sup></td><td char="(" align="char">7.42 (7.32, 7.47)</td><td char="(" align="char">7.4 (7.3, 7.5)</td><td char="(" align="char">7.4 (7.4, 7.4)</td><td char="." align="char">0.93</td></tr><tr><td align="left">Lactate (mmol/L)<sup>b</sup></td><td char="(" align="char">1.2 (1, 1.7)</td><td char="(" align="char">1.2 (1, 1.5)</td><td char="(" align="char">1.3 (1.1, 2)</td><td char="." align="char">0.2</td></tr><tr><td align="left">ICU mortality<sup>a</sup></td><td char="(" align="char">

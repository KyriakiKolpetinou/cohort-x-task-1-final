<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Chest</journal-id><journal-id journal-id-type="iso-abbrev">Chest</journal-id><journal-title-group><journal-title>Chest</journal-title></journal-title-group><issn pub-type="ppub">0012-3692</issn><issn pub-type="epub">1931-3543</issn><publisher><publisher-name>American College of Chest Physicians</publisher-name></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">40419109</article-id><article-id pub-id-type="pmc">12597412</article-id><article-id pub-id-type="pii">S0012-3692(25)00669-5</article-id><article-id pub-id-type="doi">10.1016/j.chest.2025.05.020</article-id><article-categories><subj-group subj-group-type="heading"><subject>Thoracic Oncology: Original Research</subject></subj-group></article-categories><title-group><article-title>Ultrathin Bronchoscopy With Radial Endobronchial Ultrasound and Rapid On-Site Evaluation for the Diagnosis of Peripheral Pulmonary Lesions</article-title><subtitle>A Multicenter Randomized Controlled Factorial Trial</subtitle></title-group><contrib-group><contrib contrib-type="author" id="au1"><name><surname>Vakil</surname><given-names>Erik</given-names></name><degrees>MBBCh, MPH</degrees><email>erik.vakil@ucalgary.ca</email><xref rid="aff1" ref-type="aff">a</xref><xref rid="cor1" ref-type="corresp">&#x02217;</xref></contrib><contrib contrib-type="author" id="au2"><name><surname>Fortin</surname><given-names>Marc</given-names></name><degrees>MD, FRCPC</degrees><xref rid="aff3" ref-type="aff">c</xref></contrib><contrib contrib-type="author" id="au3"><name><surname>Gonzalez</surname><given-names>Anne V.</given-names></name><degrees>MD, FRCPC</degrees><xref rid="aff1" ref-type="aff">a</xref><xref rid="aff4" ref-type="aff">d</xref></contrib><contrib contrib-type="author" id="au4"><name><surname>Samy</surname><given-names>La&#x000ef;la</given-names></name><degrees>MD</degrees><xref rid="aff5" ref-type="aff">e</xref></contrib><contrib contrib-type="author" id="au5"><name><surname>Chee</surname><given-names>Alex C.</given-names></name><degrees>MD, FRCPC</degrees><xref rid="aff1" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au6"><name><surname>Dumoulin</surname><given-names>Elaine</given-names></name><degrees>MD, FRCPC</degrees><xref rid="aff1" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au7"><name><surname>Dvorakova</surname><given-names>Marie</given-names></name><degrees>MD</degrees><xref rid="aff2" ref-type="aff">b</xref></contrib><contrib contrib-type="author" id="au8"><name><surname>Hergott</surname><given-names>Christopher A.</given-names></name><degrees>MD, FRCPC</degrees><xref rid="aff1" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au9"><name><surname>Khalil</surname><given-names>Moosa</given-names></name><degrees>MBBCh</degrees><xref rid="aff2" ref-type="aff">b</xref></contrib><contrib contrib-type="author" id="au10"><name><surname>Lampron</surname><given-names>No&#x000eb;l</given-names></name><degrees>MD</degrees><xref rid="aff3" ref-type="aff">c</xref></contrib><contrib contrib-type="author" id="au11"><name><surname>MacEachern</surname><given-names>Paul</given-names></name><degrees>MD, FRCPC</degrees><xref rid="aff1" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au12"><name><surname>Martel</surname><given-names>Simon</given-names></name><degrees>MD</degrees><xref rid="aff3" ref-type="aff">c</xref></contrib><contrib contrib-type="author" id="au13"><name><surname>Shieh</surname><given-names>Benjamin</given-names></name><degrees>MD</degrees><xref rid="aff4" ref-type="aff">d</xref></contrib><contrib contrib-type="author" id="au14"><name><surname>Simon</surname><given-names>Mathieu</given-names></name><degrees>MD</degrees><xref rid="aff3" ref-type="aff">c</xref></contrib><contrib contrib-type="author" id="au15"><name><surname>Soumagne</surname><given-names>Thibaud</given-names></name><degrees>MD, PhD</degrees><xref rid="aff6" ref-type="aff">f</xref></contrib><contrib contrib-type="author" id="au16"><name><surname>Terzic</surname><given-names>Tatjana</given-names></name><degrees>MD</degrees><xref rid="aff2" ref-type="aff">b</xref></contrib><contrib contrib-type="author" id="au17"><name><surname>Tremblay</surname><given-names>Alain</given-names></name><degrees>MD, FRCPC</degrees><xref rid="aff1" ref-type="aff">a</xref></contrib><aff id="aff1"><label>a</label>Division of Respirology, University of Calgary, Calgary, AB</aff><aff id="aff2"><label>b</label>Department of Pathology and Laboratory Medicine, University of Calgary, Calgary, AB</aff><aff id="aff3"><label>c</label>Department of Medicine, Universit&#x000e9; Laval, Quebec City, QC, Canada</aff><aff id="aff4"><label>d</label>Division of Respiratory Medicine, McGill University Health Centre, Montreal, QC, Canada</aff><aff id="aff5"><label>e</label>Department of Medicine, Universit&#x000e9; de Montr&#x000e9;al, Montreal, QC, Canada</aff><aff id="aff6"><label>f</label>Department of Respiratory Medicine, Intensive Care and Bronchoscopy, European Hospital Georges Pompidou, APHP, Paris, France</aff></contrib-group><author-notes><corresp id="cor1"><label>&#x02217;</label><bold>CORRESPONDENCE TO:</bold> Erik Vakil, MBBCh, MPH <email>erik.vakil@ucalgary.ca</email></corresp></author-notes><pub-date pub-type="pmc-release"><day>24</day><month>5</month><year>2025</year></pub-date><!-- PMC Release delay is 0 months and 0 days and was based on <pub-date
						pub-type="epub">.--><pub-date pub-type="ppub"><month>10</month><year>2025</year></pub-date><pub-date pub-type="epub"><day>24</day><month>5</month><year>2025</year></pub-date><volume>168</volume><issue>4</issue><fpage>1034</fpage><lpage>1048</lpage><permissions><copyright-statement>&#x000a9; 2025 The Author(s)</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p>This is an open access article under the CC BY-NC-ND license (http://creativecommons.org/licenses/by-nc-nd/4.0/).</license-p></license></permissions><abstract id="abs0010"><sec><title>Background</title><p>The routine use of CT imaging and lung cancer screening has increased the identification of peripheral pulmonary lesions (PPLs). Sampling may be needed for some nodules. Many new technologies are available to improve the diagnostic performance of bronchoscopy for the sampling of PPLs, but few comparative trials exist. The objective of this study was to compare the diagnostic performance of bronchoscopy with radial endobronchial ultrasound (rEBUS) using an ultrathin bronchoscope (BF-MP190F; Olympus) with a non-ultrathin bronchoscope and to compare the diagnostic performance of bronchoscopy with and without rapid on-site evaluation (ROSE).</p></sec><sec><title>Research Question</title><p>Does diagnostic performance differ between ultrathin and non-ultrathin bronchoscopes with rEBUS, and what impact does ROSE have on diagnostic performance of rEBUS?</p></sec><sec><title>Study Design and Methods</title><p>This pragmatic, multicenter, 2 &#x000d7; 2 factorial, randomized controlled trial involved adult patients with PPLs (mean diameter &#x0003c; 5 cm) and radiographic stage N0 disease referred for bronchoscopy. The study was powered to detect a 20% improvement in the primary outcome of difference in diagnostic yield (DY) between ultrathin and non-ultrathin bronchoscopes and between procedures with and without ROSE. Secondary outcomes included sensitivity for malignancy, complications, and procedure duration.</p></sec><sec><title>Results</title><p>Of 215 patients assessed, 186 patients were randomized and 181 patients were analyzed. Malignancy prevalence was 84%. No significant differences in DY or sensitivity for malignancy were found between non-ultrathin and ultrathin bronchoscopes: 65.6% vs 58.2% (difference, &#x02013;7.3%; <italic>P</italic> = .36) and 84.3% vs 74.3% (difference, &#x02013;10.0%; <italic>P</italic> = .21), respectively. Similarly, no significant differences were observed with or without ROSE: 60.4% vs 63.5% (difference, &#x02013;3.1%; <italic>P</italic> = .76) and 80.3% vs 78.3% (difference, 2.0%; <italic>P</italic> = .83), respectively.</p></sec><sec><title>Interpretation</title><p>We could not identify a difference in DY or sensitivity for malignancy for the diagnosis of PPLs between an ultrathin bronchoscope and a non-ultrathin bronchoscope and between ROSE and no ROSE. The study was underpowered to detect smaller but potentially clinically meaningful differences.</p></sec><sec><title>Clinical Trial Registration</title><p><ext-link ext-link-type="uri" xlink:href="http://ClinicalTrials.gov" id="intref0010">ClinicalTrials.gov</ext-link>; No.: NCT03809169; URL: <ext-link ext-link-type="uri" xlink:href="http://www.clinicaltrials.gov" id="intref0015">www.clinicaltrials.gov</ext-link></p></sec></abstract><kwd-group id="kwrds0010"><title>Key Words</title><kwd>bronchoscopy methods</kwd><kwd>endobronchial ultrasound</kwd><kwd>lung neoplasm diagnosis</kwd><kwd>needle biopsy methods</kwd><kwd>pulmonary nodule diagnosis</kwd></kwd-group></article-meta><def-list><title>Abbreviations</title><def-item><term id="kwrd0040">BAL</term><def><p>bronchoalveolar lavage</p></def></def-item><def-item><term id="kwrd0050">DY</term><def><p>diagnostic yield</p></def></def-item><def-item><term id="kwrd0060">EBUS</term><def><p>endobronchial ultrasound</p></def></def-item><def-item><term id="kwrd0070">OD</term><def><p>outer diameter</p></def></def-item><def-item><term id="kwrd0080">PPL</term><def><p>peripheral pulmonary lesion</p></def></def-item><def-item><term id="kwrd0090">RCT</term><def><p>randomized controlled trial</p></def></def-item><def-item><term id="kwrd0100">rEBUS</term><def><p>radial endobronchial ultrasound</p></def></def-item><def-item><term id="kwrd0110">ROSE</term><def><p>rapid on-site evaluation</p></def></def-item><def-item><term id="kwrd0120">TBNA</term><def><p>transbronchial needle aspiration</p></def></def-item><def-item><term id="kwrd0130">UB</term><def><p>ultrathin bronchoscopy</p></def></def-item><def-item><term id="kwrd0140">VBN</term><def><p>virtual bronchoscopic navigation</p></def></def-item><def-item><term id="kwrd0150">WC</term><def><p>working channel</p></def></def-item></def-list></front><body><p id="p0010">
<boxed-text id="dtbox1"><caption><title>Take-Home Points</title></caption><p id="p0015"><bold>Study Question:</bold> Does ultrathin bronchoscopy (outer diameter, &#x0003c; 4.2 mm) with radial endobronchial ultrasound or rapid on-site evaluation (ROSE) improve the diagnostic yield for peripheral pulmonary lesions compared with non-ultrathin bronchoscopy or no ROSE?</p><p id="p0020"><bold>Results:</bold> In this pragmatic 2 &#x000d7; 2 factorial trial of 181 patients, diagnostic yield was similar between non-ultrathin and ultrathin bronchoscopes (difference, &#x02013;7.3%, <italic>P</italic> = .36) and ROSE and no ROSE (difference, 2.0%, <italic>P</italic> = .83).</p><p id="p0025"><bold>Interpretation:</bold> Our results showed that ultrathin bronchoscopy with radial endobronchial ultrasound or ROSE did not significantly improve diagnostic yield over non-ultrathin bronchoscopy or no ROSE for the diagnosis of a peripheral pulmonary lesion.</p></boxed-text>
</p><p id="p00120">The identification of peripheral pulmonary lesions (PPLs) has increased with the routine use of CT imaging and lung cancer screening programs. Sampling may be recommended for a proportion of nodules, and bronchoscopy often is selected as the first diagnostic step.<xref rid="bib1" ref-type="bibr"><sup>1</sup></xref> Bronchoscopy is particularly advantageous when evaluation of mediastinal lymph nodes also is necessary.<xref rid="bib2" ref-type="bibr"><sup>2</sup></xref> However, when disease in the lymph nodes is not suspected, the diagnostic yield (DY) of bronchoscopy for a PPL is inferior to CT-guided biopsy, but CT-guided biopsy is associated with more complications.<xref rid="bib3" ref-type="bibr">3</xref>, <xref rid="bib4" ref-type="bibr">4</xref>, <xref rid="bib5" ref-type="bibr">5</xref> Improving the diagnostic performance of peripheral bronchoscopy has been the source of considerable interest and investment, but few comparative studies between new technologies are available.</p><p id="p00215">A new commercially available ultrathin bronchoscope, the BF-MP190F (Olympus), combines an ultrathin distal outer diameter (OD; 3.0 mm) with a working channel (WC; 1.7 mm) large enough to accommodate the Olympus UM-S20-17S radial endobronchial ultrasound (rEBUS) probe without a guide sheath. Ultrathin bronchoscopy (UB) has the potential advantage of navigating further into the bronchial tree to locate the target lesion.</p><p id="p02020">Two previous randomized controlled trials (RCTs) using iterative prototypes of the BF-MP190F, both by Oki et al,<xref rid="bib6" ref-type="bibr"><sup>6</sup></xref><sup>,</sup><xref rid="bib7" ref-type="bibr"><sup>7</sup></xref> demonstrated improved diagnostic performance of UB (OD, 3.0 mm; WC, 1.7 mm) compared with a thin bronchoscope (OD, 4.0 mm). A meta-analysis also reported higher DY of UB with a 1.7-mm WC compared with UB with a 1.2-mm WC that cannot accommodate the rEBUS probe.<xref rid="bib8" ref-type="bibr"><sup>8</sup></xref> Contrastingly, an RCT by Tanner et al<xref rid="bib9" ref-type="bibr"><sup>9</sup></xref> found no difference in DY between a thin bronchoscope (OD, 4.2 mm) and a standard bronchoscope (OD, 4.9 mm).</p><p id="p00225">The presence of diagnostic tissue on rapid on-site evaluation (ROSE) from mediastinal lymph nodes may preclude the need for peripheral sampling, and nondiagnostic ROSE may allow bronchoscopists to make adjustments until diagnostic tissue is obtained. Despite widespread use, data on the efficacy of ROSE for the diagnosis of PPLs remains limited. Two RCTs showed improved diagnostic performance of bronchoscopy with rEBUS when ROSE is used for PPLs.<xref rid="bib10" ref-type="bibr"><sup>10</sup></xref><sup>,</sup><xref rid="bib11" ref-type="bibr"><sup>11</sup></xref> Bronchoscopy in both studies was performed with a standard bronchoscope (OD, 4.9 mm).</p><p id="p0030">For efficiency purposes, a factorial study design was used to test 2 independent hypotheses.<xref rid="bib12" ref-type="bibr"><sup>12</sup></xref><sup>,</sup><xref rid="bib13" ref-type="bibr"><sup>13</sup></xref> The first was that the diagnostic performance of UB with the BF-MP190F bronchoscope and rEBUS was superior to non-ultrathin bronchoscopy with rEBUS for the diagnosis of a PPL. The second was that the diagnostic performance of bronchoscopy with rEBUS and transbronchial needle aspiration (TBNA) with ROSE was superior to TBNA without ROSE for the diagnosis of a PPL.</p><sec id="sec1"><title>Study Design and Methods</title><sec id="sec1.1"><title>Study Design and Randomization</title><p id="p0035">We conducted a pragmatic, multicenter, open-label controlled trial using a 2 &#x000d7; 2 full factorial, block-randomized design in patients with PPLs suspicious for lung cancer who were referred for diagnostic bronchoscopy. All standard clinical and laboratory procedures were followed, with the randomized interventions being the only study-specific modifications.</p><p id="p0040">Participants were randomized to UB vs non-UB bronchoscopy and ROSE vs no ROSE by applying a 1:1:1:1 randomization allocation at the time of bronchoscopy booking using the randomization module in the Research Electronic Data Capture platform version 13.1 (Vanderbilt University). Although no interaction between the 2 study arms were anticipated, this approach ensured that the UB and ROSE use was balanced in the complimentary randomization groups. Block randomization in groups of 20 was performed stratified for the presence of an airway leading to the PPL on CT imaging (bronchus sign). Crossover was not permitted.</p></sec><sec id="sec1.2"><title>Participants</title><p id="p0045">Participants were screened for inclusion after referral to an interventional pulmonary medicine group at 1 of 3 participating centers for bronchoscopic sampling of the PPL using rEBUS. No differences in eligibility across intervention arms were found. Inclusion criteria included adults 18 years of age or older; presence of a PPL &#x02264; 5 cm (mean short-long on axial CT scan); PPL that appeared radiologically accessible via rEBUS as assessed by an experienced interventional pulmonologist but not anticipated to be directly visible with standard bronchoscopy; radiographic stage N0 disease; and the clinical decision made by the patient and treating clinician to proceed with bronchoscopy. Exclusion criteria were other interventions recommended as the primary diagnostic procedure, PPL not believed to be accessible bronchoscopically, contraindication to bronchoscopy, pregnancy, planned use of electromagnetic or other navigation system (virtual bronchoscopic navigation [VBN] was permitted), and absence of informed consent.</p></sec><sec id="sec1.3"><title>Procedure Details</title><sec id="sec1.3.1"><title>Non-Ultrathin Bronchoscopy</title><p id="p0050">Under moderate sedation, a bronchoscope with a minimum OD of 4.2 mm and minimum WC of 2.0 mm was used to access the segment or lobe of interest. If the lesion was visualized directly, samples were obtained under direct visualization. Otherwise, rEBUS was used to locate the lesion. Depending on the size of the bronchoscope, a guide sheath kit, the Olympus K203 (2.55-mm guide-sheath), 1.9-mm forceps, and 1.8-mm brush) or Olympus K201 (1.95-mm guide-sheath, 1.5-mm forceps, and 1.4-mm brush), was used with a 1.7-mm or 1.4-mm rEBUS probe (UM-S20-20R or UM-S20-17S), respectively. If the PPL was located, samples were obtained using a 21-gauge PeriView FLEX needle (Olympus) or PeriFlex needle (Spiration, Inc.). A minimum of 3 sampling attempts were made with samples placed in CytoLyt (Hologic, Inc.) preservative. A cytology brush (cytobrush) and biopsy forceps could be used through the guide sheath. Bronchoalveolar lavage (BAL) could be performed through the guide sheath or the bronchoscope alone. Fluoroscopy was used at the discretion of the bronchoscopist.</p></sec><sec id="sec1.3.2"><title>Ultrathin Bronchoscopy</title><p id="p0055">The BF-MP190F bronchoscope (Olympus) has an OD of 3.0 mm and WC of 1.7 mm and was used to access the segment or lobe of interest. If the lesion was visualized directly, samples were obtained under direct visualization. Otherwise, a 1.4-mm rEBUS probe (UM-S20-17S) was used through the working channel without a guide sheath. If the PPL was localized, samples were obtained in the same fashion as the non-ultrathin bronchoscope procedure.</p></sec><sec id="sec1.3.3"><title>ROSE Procedure</title><p id="p0060">After the initial sampling with the needle device, a drop of the aspirated material was pushed out of the needle with the stylet onto a glass slide, and using another slide, a cytologic direct smear was prepared. The smear was either air dried and stained using a Diff-Quik (Merck) procedure or was fixed in absolute alcohol and stained with hematoxylin and eosin by a cytotechnologist. The stained slides were examined microscopically by an on-site or virtual cytopathologist. A verbal report regarding the adequacy of the specimen and the preliminary diagnosis was communicated to the operator.</p><p id="p0065">While waiting for the ROSE results, the operator was permitted to obtain additional samples as clinically indicated. If ROSE results were equivocal or nondiagnostic, the operator could adjust the area sampled and repeat the sample collection process. This could be repeated as many times as believed to be appropriate by the operator considering patient tolerance, procedure length, and remaining options for technical modifications to the procedure aimed to obtain a better position. ROSE also could be performed on additional bronchoscopic samples obtained at the discretion of the operator and cytopathologist, including touch preps of cytobrush samples and transbronchial biopsies.</p></sec><sec id="sec1.3.4"><title>Linear Endobronchial Ultrasound</title><p id="p0070">Linear endobronchial ultrasound (EBUS) was permitted for diagnosis, invasive nodal staging, or both if clinically appropriate and could be performed before or after peripheral sampling at the discretion of the operator. ROSE was permitted only if the participant was randomized to the ROSE arm. In cases where ROSE established a diagnosis before peripheral sampling, peripheral sampling was not performed.</p></sec><sec id="sec1.3.5"><title>Assessment of Complications</title><p id="p0075">At the end of the procedure and if a peripheral bronchoscopic sample was obtained using any technique other than BAL alone, participants underwent bedside chest ultrasonography or chest radiography to assess for the presence of pneumothorax. This was repeated if the participant demonstrated symptoms concerning for pneumothorax during recovery. If chest ultrasonography was equivocal or demonstrated a pneumothorax, a chest radiograph was obtained to assess for a pneumothorax or to determine pneumothorax size. Management of a pneumothorax was at the discretion of the provider.</p></sec><sec id="sec1.3.6"><title>Sample Processing and Adjunctive Testing</title><p id="p0080">TBNA samples and cytobrush samples were placed in CytoLyt (Hologic Inc.). Tissue from transbronchial biopsies were placed in formalin for histopathologic analysis and saline for culture, when indicated. For cytologic samples, monolayer cytologic slides (ThinPrep; Hologic, Inc.) were prepared according to the manufacturer&#x02019;s manual. The ThinPrep slides were stained by the Papanicolaou procedure. Residual preservative liquid was centrifuged, and the cell sediment was used to prepare a paraffin-embedded cell block. Sections of the cell block were used for immunohistochemical studies and for molecular testing, when indicated. No specific blinding procedure was observed for the cytopathologists who likely would not be aware that a patient was enrolled in the trial and typically would not be aware of (or find relevant) the bronchoscopy size information. Conversely, they would be aware if a ROSE specimen had been processed during the procedure.</p></sec></sec><sec id="sec1.4"><title>Follow-Up</title><p id="p0085">All participants were seen in follow-up by the referring physician after bronchoscopy and not necessarily by the research physicians. Further testing for participants with nondiagnostic bronchoscopy findings was at the discretion of the treating physician. This could include surveillance imaging, repeat bronchoscopy, CT-guided biopsy, or surgical lung biopsy. Participants undergoing surveillance were followed up for a minimum of 1 year.</p></sec><sec id="sec1.5"><title>Outcomes</title><p id="p0090">The primary outcome for both study hypotheses was the DY of bronchoscopy for the PPL. Secondary outcomes were the sensitivity for malignancy, complications, and total procedure time.</p><p id="p0095">DY was defined in accordance with the recent American Thoracic Society and American College of Chest Physician consensus definition.<xref rid="bib14" ref-type="bibr"><sup>14</sup></xref> Bronchoscopy also was considered diagnostic if the diagnosis was established from nonpathologic testing such as culture or microbiologic analysis and flow cytometry. A diagnosis resulting from other (non-PPL) specimens but for which ROSE assessment led to avoidance of PPL sampling also was considered a positive finding. Bronchoscopy was considered nondiagnostic if a second biopsy procedure was performed, even if the results of the second procedure confirmed the suspected findings on initial bronchoscopy.</p><p id="p0100">Sensitivity for malignancy was calculated as the number of participants with malignancy (including pulmonary carcinoid) diagnosed from sampling of the PPL with any technique divided by the total number of participants with a final diagnosis of malignancy at the conclusion of the study. A bronchoscopic diagnosis of malignancy resulting from other (non-PPL) specimens, but for which ROSE assessment led to avoidance of PPL sampling, also was considered positive findings. Patients referred for radiotherapy without a tissue confirmation of malignancy were considered to have a final diagnosis of malignancy, whereas PPLs that resolved, regressed, or were stable on surveillance imaging at 1 year were considered to have a final benign diagnosis.</p><p id="p0105">Pneumothorax could be diagnosed using bedside ultrasonography, chest radiography, or both. The need for a chest tube was at the discretion of the provider. Bleeding was defined as mild if no intervention beyond suctioning was required; as moderate if only cold saline, topical epinephrine, or scope tamponade was required; and as severe if the procedure had to be terminated, respiratory compromise occurred, or intubation, endobronchial blocker, embolization, transfusion, tranexamic acid, or escalation of care was required.</p></sec><sec id="sec1.6"><title>Statistical Analysis</title><sec id="sec1.6.1"><title>Sample Size</title><p id="p0110">The sample size was calculated assuming 2 independent parallel trials comparing non-ultrathin bronchoscopy vs UB with the BF-MP190F bronchoscope and no ROSE vs ROSE. A sample size of 208 patients achieves 80% power at a 0.025 significance level (with a Bonferroni correction) to detect a change in DY from a baseline value of 57% to 77%. The baseline expected DY was based on American College of Chest Physicians Quality Improvement Registry, Evaluation, and Education (AQuIRE) registry data and the potential improvement in yield in the range reported from other UB and ROSE studies.<xref rid="bib6" ref-type="bibr"><sup>6</sup></xref><sup>,</sup><xref rid="bib7" ref-type="bibr"><sup>7</sup></xref><sup>,</sup><xref rid="bib10" ref-type="bibr"><sup>10</sup></xref><sup>,</sup><xref rid="bib15" ref-type="bibr"><sup>15</sup></xref> The study was neither designed nor powered to detect an interaction between groups because this was not suspected on clinical grounds by the investigators, nor was it proposed as a possibility in a review of the literature.</p></sec><sec id="sec1.6.2"><title>Analysis</title><p id="p0115">The difference in DY and sensitivity for malignancy between study arms was compared using the Fisher exact test. A secondary analysis for DY and sensitivity for malignancy also was performed adjusted for relevant baseline covariates using multivariable logistic regression (complete case analysis). Differences in baseline and procedural characteristics were compared using the analysis of variance for continuous normally distributed variables, the Kruskal-Wallis test for continuous nonnormally distributed variables, and the Pearson &#x003c7;<sup>2</sup> test of proportion for categorical variables. The association between DY and the number of biopsy instruments and the association between DY and trial start date was tested using univariable logistic regression. Post hoc testing of potential interaction was conducted using multiple scales (additive, multiplicative, and OR) and inspection for nonadditivity using margin plots for predicted DY and sensitivity by treatment combinations.<xref rid="bib16" ref-type="bibr"><sup>16</sup></xref> A Poisson distribution and robust SEs were used to estimate risk ratios.</p></sec></sec><sec id="sec1.7"><title>Ethics and Funding</title><p id="p0120">The study was approved by the health review and ethics board of Alberta (Identifier: HREBA.CC-18-0665) and was registered at <ext-link ext-link-type="uri" xlink:href="http://ClinicalTrials.gov" id="intref0020">ClinicalTrials.gov</ext-link> (Identifier: NCT03809169).</p></sec></sec><sec id="sec2"><title>Results</title><p id="p0125">Two hundred fifteen patients were assessed for eligibility and 186 were randomized (<xref rid="fig1" ref-type="fig">Fig 1</xref>). Ninety-three patients were randomized to a non-ultrathin bronchoscope and 93 patients were randomized to an ultrathin bronchoscope. For the outcome comparing the use of ROSE, 90 patients were randomized to bronchoscopy without ROSE and 96 patients were randomized to bronchoscopy with ROSE. For the distribution across all 4 possible allocation groups, see <xref rid="appsec1" ref-type="sec">e-Figure 1</xref>.<fig id="fig1"><label>Figure 1</label><caption><p>Consolidated Standards of Reporting Trials diagram. PPL = peripheral pulmonary lesion; ROSE = rapid on-site evaluation; XRT = radiotherapy.</p></caption><graphic xlink:href="gr1"/></fig></p><p id="p0130">The trial was suspended early at 87% of the sample size target because of global supply issues with peripheral needles not expected to be resolved in a reasonable time frame. This device was deemed critical for the performance of bronchoscopy in both the UB and ROSE trial arms. Therefore, the investigators concluded that proceeding with a major protocol change would compromise the trial.</p><p id="p0135">Patient baseline characteristics were similar between bronchoscope arms and ROSE arms (<xref rid="tbl1" ref-type="table">Table 1</xref>). Fewer male individuals were noted in the UB arm. The median age was 70 years, and 55% of patients were female. Most patients (72%) actively smoked or had a history of smoking. Nodules were high risk for malignancy, with a median pretest probability of 89%, using the prediction model by Herder et al.<xref rid="bib17" ref-type="bibr"><sup>17</sup></xref> Eighty-eight percent of patients showed a radiographic bronchus sign on thin-slice CT imaging (&#x02264; 1 mm). The prevalence of malignancy was 84%. Lung cancer was the most common diagnosis (70%), with an additional 7% of patients undergoing empiric radiation for presumed lung cancer (<xref rid="fig1" ref-type="fig">Fig 1</xref>, <xref rid="appsec1" ref-type="sec">e-Table 1</xref>).<table-wrap position="float" id="tbl1"><label>Table 1</label><caption><p>Baseline Characteristics</p></caption><table frame="hsides" rules="groups"><thead><tr><th rowspan="2">Variable</th><th rowspan="2">Total (N = 181)</th><th colspan="3">Scope Size<hr/></th><th colspan="3">ROSE<hr/></th></tr><tr><th>Non-Ultrathin (n = 90)</th><th>Ultrathin (n = 91)</th><th><italic>P</italic> Value</th><th>No (n = 85)</th><th>Yes (n = 96)</th><th><italic>P</italic> Value</th></tr></thead><tbody><tr><td>Age, y</td><td align="char">70 (64-76)</td><td align="char">69 (64-76)</td><td align="char">71 (64-76)</td><td align="char">.96</td><td align="char">68 (64-75)</td><td align="char">72 (63.5-77)</td><td align="char">.42</td></tr><tr><td>Sex</td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;Male</td><td align="char">81 (45%)</td><td align="char">48 (53%)</td><td align="char">33 (36%)</td><td align="char">.02</td><td align="char">39 (46%)</td><td align="char">42 (44%)</td><td align="char">.77</td></tr><tr><td>&#x000a0;Female</td><td align="char">100 (55%)</td><td align="char">42 (47%)</td><td align="char">58 (64%)</td><td>NA</td><td align="char">46 (54%)</td><td align="char">54 (56%)</td><td>NA</td></tr><tr><td>Smoking status</td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;Active</td><td align="char">39 (22%)</td><td align="char">15 (17%)</td><td align="char">24 (26%)</td><td align="char">.28</td><td align="char">18 (21%)</td><td align="char">21 (22%)</td><td align="char">.85</td></tr><tr><td>&#x000a0;Prior</td><td align="char">92 (51%)</td><td align="char">48 (53%)</td><td align="char">44 (48%)</td><td>NA</td><td align="char">45 (53%)</td><td align="char">47 (49%)</td><td>NA</td></tr><tr><td>&#x000a0;Never</td><td align="char">50 (28%)</td><td align="char">27 (30%)</td><td align="char">23 (25%)</td><td>NA</td><td align="char">22 (26%)</td><td align="char">28 (29%)</td><td>NA</td></tr><tr><td>Smoking duration, pack-y</td><td align="char">35 (17)</td><td align="char">34 (16)</td><td align="char">36 (18)</td><td align="char">.48</td><td align="char">35 (16)</td><td align="char">35 (18)</td><td align="char">.76</td></tr><tr><td>History of extrathoracic malignancy<xref rid="tblLEfna" ref-type="table-fn">a</xref></td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">150 (83%)</td><td align="char">76 (84%)</td><td align="char">74 (81%)</td><td align="char">.58</td><td align="char">70 (82%)</td><td align="char">80 (83%)</td><td align="char">.86</td></tr><tr><td>&#x000a0;Yes</td><td align="char">31 (17)</td><td align="char">14 (16)</td><td align="char">17 (19)</td><td>NA</td><td align="char">15 (18)</td><td align="char">16 (17)</td><td>NA</td></tr><tr><td>Size, mm</td><td align="char">26.3 (10.7)</td><td align="char">27.5 (10.8)</td><td align="char">25.2 (10.6)</td><td align="char">.15</td><td align="char">25.1 (10.8)</td><td align="char">27.4 (10.5)</td><td align="char">.15</td></tr><tr><td>Spiculated</td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">46 (25%)</td><td align="char">23 (26%)</td><td align="char">23 (25%)</td><td align="char">.97</td><td align="char">20 (24%)</td><td align="char">26 (27%)</td><td align="char">.58</td></tr><tr><td>&#x000a0;Yes</td><td align="char">135 (75%)</td><td align="char">67 (74%)</td><td align="char">68 (75%)</td><td>NA</td><td align="char">65 (76%)</td><td align="char">70 (73%)</td><td>NA</td></tr><tr><td>Type of lesion</td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;Solid</td><td align="char">157 (87%)</td><td align="char">74 (82%)</td><td align="char">83 (91%)</td><td align="char">.08</td><td align="char">78 (92%)</td><td align="char">79 (82%)</td><td align="char">.14</td></tr><tr><td>&#x000a0;Part solid</td><td align="char">23 (13%)</td><td align="char">16 (18%)</td><td align="char">7 (8%)</td><td>NA</td><td align="char">7 (8%)</td><td align="char">16 (17%)</td><td>NA</td></tr><tr><td>&#x000a0;Pure GGO</td><td align="char">1 (1%)</td><td>0</td><td align="char">1 (1%)</td><td>NA</td><td>0</td><td align="char">1 (1%)</td><td>NA</td></tr><tr><td>Nodule location</td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;RUL</td><td align="char">59 (33%)</td><td align="char">31 (34%)</td><td align="char">28 (31%)</td><td align="char">.26</td><td align="char">30 (35%)</td><td align="char">29 (30%)</td><td align="char">.64</td></tr><tr><td>&#x000a0;RML</td><td align="char">13 (7%)</td><td align="char">9 (10%)</td><td align="char">4 (4%)</td><td>NA</td><td align="char">6 (7%)</td><td align="char">7 (7%)</td><td>NA</td></tr><tr><td>&#x000a0;RLL</td><td align="char">32 (18%)</td><td align="char">14 (16%)</td><td align="char">18 (20%)</td><td>NA</td><td align="char">12 (14%)</td><td align="char">20 (21%)</td><td>NA</td></tr><tr><td>&#x000a0;LUL</td><td align="char">42 (23%)</td><td align="char">23 (26%)</td><td align="char">19 (21%)</td><td>NA</td><td align="char">18 (21%)</td><td align="char">24 (25%)</td><td>NA</td></tr><tr><td>&#x000a0;LLL</td><td align="char">35 (19%)</td><td align="char">13 (14%)</td><td align="char">22 (24%)</td><td>NA</td><td align="char">19 (22%)</td><td align="char">16 (17%)</td><td>NA</td></tr><tr><td>Distance of nodule from costal pleura, mm</td><td align="char">17.5 (2-30)</td><td align="char">16.5 (0-30)</td><td align="char">19.5 (8-31)</td><td align="char">.37</td><td align="char">21 (10-30)</td><td align="char">12 (0-30)</td><td align="char">.02</td></tr><tr><td>Radiographic bronchus sign</td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">21 (12%)</td><td align="char">10 (11%)</td><td align="char">11 (12%)</td><td align="char">.84</td><td align="char">10 (12%)</td><td align="char">11 (11%)</td><td align="char">.95</td></tr><tr><td>&#x000a0;Yes</td><td align="char">160 (88%)</td><td align="char">80 (89%)</td><td align="char">80 (88%)</td><td>NA</td><td align="char">75 (88%)</td><td align="char">85 (89%)</td><td>NA</td></tr><tr><td>PET/CT scan</td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">69 (38%)</td><td align="char">36 (40%)</td><td align="char">33 (36%)</td><td align="char">.60</td><td align="char">36 (42%)</td><td align="char">33 (34%)</td><td align="char">.27</td></tr><tr><td>&#x000a0;Yes</td><td align="char">112 (62%)</td><td align="char">54 (60%)</td><td align="char">58 (64%)</td><td>NA</td><td align="char">49 (58%)</td><td align="char">63 (66%)</td><td>NA</td></tr><tr><td>SUV<sub>max</sub></td><td align="char">7 (3.4-11.5)</td><td align="char">6.7 (3.3-12)</td><td align="char">7.05 (3.5-11.4)</td><td align="char">.60</td><td align="char">7.1 (3.5-12)</td><td align="char">5.6 (3.4-10.4)</td><td align="char">.44</td></tr><tr><td>Qualitative FDG uptake of nodule</td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;None</td><td align="char">2 (2%)</td><td align="char">1 (2%)</td><td align="char">1 (2%)</td><td align="char">.12</td><td align="char">1 (2%)</td><td align="char">1 (2%)</td><td align="char">.65</td></tr><tr><td>&#x000a0;Mild</td><td align="char">25 (23%)</td><td align="char">7 (13%)</td><td align="char">18 (32%)</td><td>NA</td><td align="char">10 (21%)</td><td align="char">15 (24%)</td><td>NA</td></tr><tr><td>&#x000a0;Moderate</td><td align="char">38 (34%)</td><td align="char">22 (41%)</td><td align="char">16 (28%)</td><td>NA</td><td align="char">14 (29%)</td><td align="char">24 (38%)</td><td>NA</td></tr><tr><td>&#x000a0;High</td><td align="char">46 (41%)</td><td align="char">24 (44%)</td><td align="char">22 (39%)</td><td>NA</td><td align="char">23 (48%)</td><td align="char">23 (37%)</td><td>NA</td></tr><tr><td>Pretest probability of lung cancer (Herder)</td><td align="char">0.89 (0.57-0.97)</td><td align="char">0.92 (0.64-0.97)</td><td align="char">0.81 (0.5-0.97)</td><td align="char">.06</td><td align="char">0.89 (0.49-0.97)</td><td align="char">0.89 (0.35-0.96)</td><td align="char">.50</td></tr><tr><td>Ultrathin scope</td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">90 (50%)</td><td>NA</td><td>NA</td><td>NA</td><td align="char">42 (49%)</td><td align="char">48 (50%)</td><td align="char">.94</td></tr><tr><td>&#x000a0;Yes</td><td align="char">91 (50%)</td><td>NA</td><td>NA</td><td>NA</td><td align="char">43 (51%)</td><td align="char">48 (50%)</td><td>NA</td></tr><tr><td>ROSE</td><td/><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">85 (47%)</td><td align="char">42 (47%)</td><td align="char">43 (47%)</td><td align="char">.94</td><td>NA</td><td>NA</td><td>NA</td></tr><tr><td>&#x000a0;Yes</td><td align="char">96 (53%)</td><td align="char">48 (53%)</td><td align="char">48 (53%)</td><td>NA</td><td>NA</td><td>NA</td><td>NA</td></tr></tbody></table><table-wrap-foot><fn><p>Data are presented as No. (%), mean (SD), or median (interquartile range) unless otherwise indicated. FDG = fluorodeoxyglucose; GGO = ground-glass opacity; LUL = left upper lobe; LLL = left lower lobe; NA = not applicable; RLL = right lower lobe; ROSE = rapid on-site evaluation; RML = right middle lobe; RUL = right upper lobe; SUV<sub>max</sub> = standard uptake value maximum.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tblLEfna"><label>a</label><p id="ntpara0010">Excluding nonmelanoma skin cancer.</p></fn></table-wrap-foot></table-wrap></p><p id="p0140">The overall DY of bronchoscopy was 61.9% and the sensitivity for malignancy was 72.9%. The final bronchoscopic diagnoses are shown in <xref rid="appsec1" ref-type="sec">e-Table 2</xref>. No overall difference in DY or sensitivity for malignancy was found across the 3 participating sites (<italic>P</italic> = .74 and <italic>P</italic> = .48, respectively).</p><sec id="sec2.1"><title>Hypothesis 1: Ultrathin Bronchoscopy vs Non-Ultrathin Bronchoscopy</title><p id="p0145">No difference was found in DY or sensitivity for malignancy for a PPL using a non-ultrathin bronchoscope vs an ultrathin bronchoscope: 65.6% vs 58.2% (difference, &#x02013;7.3%; 95% CI, &#x02013;24.1% to 6.8%; <italic>P</italic> = .36) and 84.3% vs 74.3% (difference, &#x02013;10.0%; 95% CI, &#x02013;23.3% to 3.3%; <italic>P</italic> = .21), respectively (<xref rid="tbl2" ref-type="table">Table 2</xref>). Also no difference was found in the number of lesions directly visualized or localized on rEBUS between bronchoscope arms (<xref rid="tbl3" ref-type="table">Table 3</xref>). Linear EBUS was used in 30 patients (17%), and 17 of those patients were randomized to bronchoscopy without ROSE (<xref rid="tbl3" ref-type="table">Table 3</xref>). No significant difference was found in procedural characteristics between bronchoscope arms, including procedure time (<xref rid="tbl3" ref-type="table">Table 3</xref>). For patients randomized to a non-ultrathin bronchoscope, an Olympus BF-P190 (OD, 4.2 mm; WC, 2.0 mm) was used in 67%. Almost all patients (98%) underwent bronchoscopy with rEBUS. Fluoroscopy and VBN were used rarely, 6% and 3%, respectively.<table-wrap position="float" id="tbl2"><label>Table 2</label><caption><p>Difference in Diagnostic Yield and Sensitivity for Malignancy by Scope Type and Use of ROSE</p></caption><table frame="hsides" rules="groups"><thead><tr><th>Arm</th><th>Diagnostic Yield (%)</th><th>Difference (95% CI)</th><th><italic>P</italic> Value</th><th>Sensitivity (%)</th><th>Difference (95% CI)</th><th><italic>P</italic> Value</th></tr></thead><tbody><tr><td>Bronchoscope type</td><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;Non-ultrathin</td><td align="char">59/90 (65.6)</td><td align="char">&#x02013;7.3% (&#x02013;21.4% to 6.8%)</td><td align="char">.36</td><td align="char">59/70 (84.3)</td><td align="char">&#x02013;10.0% (&#x02013;23.3% to 3.3%)</td><td align="char">.21</td></tr><tr><td>&#x000a0;Ultrathin</td><td align="char">53/91 (58.2)</td><td>NA</td><td>NA</td><td align="char">52/70 (74.3)</td><td>NA</td><td>NA</td></tr><tr><td>ROSE status</td><td/><td/><td/><td/><td/><td/></tr><tr><td>&#x000a0;ROSE</td><td align="char">58/96 (60.4)</td><td align="char">&#x02013;3.1% (&#x02013;17.3% to 11.0%)</td><td align="char">.76</td><td align="char">57/71 (80.3)</td><td align="char">2.0% (&#x02013;11.4% to 15.5%)</td><td align="char">.84</td></tr><tr><td>&#x000a0;No ROSE</td><td align="char">54/85 (63.5)</td><td>NA</td><td>NA</td><td align="char">54/69 (78.3)</td><td>NA</td><td>NA</td></tr></tbody></table><table-wrap-foot><fn><p>NA = not applicable; ROSE = rapid on-site evaluation.</p></fn></table-wrap-foot></table-wrap><table-wrap position="float" id="tbl3"><label>Table 3</label><caption><p>Procedural Characteristics by Scope Type</p></caption><table frame="hsides" rules="groups"><thead><tr><th>Variable</th><th>Total (N = 181)</th><th>Non-Ultrathin (n = 90)</th><th>Ultrathin (n = 91)</th><th><italic>P</italic> Value</th></tr></thead><tbody><tr><td>Bronchoscopy</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;1TH190</td><td align="char">4 (2)</td><td align="char">4 (4)</td><td>0</td><td align="char">&#x0003c; .001</td></tr><tr><td>&#x000a0;1T180</td><td align="char">3 (2)</td><td align="char">3 (3)</td><td>0</td><td>NA</td></tr><tr><td>&#x000a0;P180</td><td align="char">12 (7)</td><td align="char">12 (13)</td><td>0</td><td>NA</td></tr><tr><td>&#x000a0;P190</td><td align="char">61 (34)</td><td align="char">60 (67)</td><td align="char">1 (1)</td><td>NA</td></tr><tr><td>&#x000a0;MP190F</td><td align="char">71 (39)</td><td>0</td><td align="char">71 (78)</td><td>NA</td></tr><tr><td>&#x000a0;Linear EBUS</td><td align="char">30 (17)</td><td align="char">11 (12)</td><td align="char">19 (21)</td><td>NA</td></tr><tr><td>Radial ultrasound probe</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;26R-3 (2.5 mm)</td><td align="char">2 (1)</td><td align="char">2 (2)</td><td>0</td><td align="char">.23</td></tr><tr><td>&#x000a0;20R-3 (1.7 mm)</td><td align="char">8 (4)</td><td align="char">6 (7)</td><td align="char">2 (2)</td><td>NA</td></tr><tr><td>&#x000a0;17S (1.4 mm)</td><td align="char">167 (92)</td><td align="char">80 (89)</td><td align="char">87 (96)</td><td>NA</td></tr><tr><td>&#x000a0;Radial EBUS not used or required</td><td align="char">4 (2)</td><td align="char">2 (2)</td><td align="char">2 (2)</td><td>NA</td></tr><tr><td>Fluoroscopy</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">170 (94)</td><td align="char">84 (93)</td><td align="char">86 (95)</td><td align="char">.74</td></tr><tr><td>&#x000a0;Yes</td><td align="char">11 (6)</td><td align="char">6 (7)</td><td align="char">5 (5)</td><td>NA</td></tr><tr><td>Virtual bronchoscopic planning</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">176 (97)</td><td align="char">87 (97)</td><td align="char">89 (98)</td><td align="char">.64</td></tr><tr><td>&#x000a0;Yes</td><td align="char">5 (3)</td><td align="char">3 (3)</td><td align="char">2 (2)</td><td>NA</td></tr><tr><td>Best radial EBUS image position</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;Within lesion</td><td align="char">99 (56)</td><td align="char">47 (53)</td><td align="char">52 (58)</td><td align="char">.19</td></tr><tr><td>&#x000a0;Adjacent to lesion</td><td align="char">64 (36)</td><td align="char">37 (42)</td><td align="char">27 (30)</td><td>NA</td></tr><tr><td>&#x000a0;Lesion not imaged</td><td align="char">13 (7)</td><td align="char">4 (5)</td><td align="char">9 (10)</td><td>NA</td></tr><tr><td>&#x000a0;Radial EBUS not used or required</td><td align="char">1 (1)</td><td>0</td><td align="char">1 (1)</td><td>NA</td></tr><tr><td>Direct visualization of lesion</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">152 (84)</td><td align="char">78 (87)</td><td align="char">74 (81)</td><td align="char">.33</td></tr><tr><td>&#x000a0;Yes</td><td align="char">29 (16)</td><td align="char">12 (13)</td><td align="char">17 (19)</td><td>NA</td></tr><tr><td>Procedure time, min</td><td align="char">34 (25-44)</td><td align="char">32 (25-40)</td><td align="char">35 (28-45)</td><td align="char">.09</td></tr></tbody></table><table-wrap-foot><fn><p>Data are presented as No. (%) or median (interquartile range) unless otherwise indicated. EBUS = endobronchial ultrasound; NA = not applicable.</p></fn></table-wrap-foot></table-wrap></p><p id="p0150">No significant difference was found in complications between bronchoscope arms (<xref rid="tbl4" ref-type="table">Table 4</xref>). Eight cases (5%) of pneumothorax occurred, 6 of which required a chest tube. All cases of pneumothorax occurred in patients in whom fluoroscopy was not used, although the association between fluoroscopy and pneumothorax was not significant (<italic>P</italic> = .46). Mild bleeding was common (44%), but severe bleeding was rare (2%), occurring once in the non-ultrathin bronchoscope arm and twice in the ultrathin arm. No association was found between the start date and DY or sensitivity for malignancy on unadjusted analysis for those randomized to an ultrathin scope (OR, 1.0 [<italic>P</italic> = .96] and 1.0 [<italic>P</italic> = .99], respectively).<table-wrap position="float" id="tbl4"><label>Table 4</label><caption><p>Complications by Scope Allocation</p></caption><table frame="hsides" rules="groups"><thead><tr><th>Variable</th><th>Total (N = 181)</th><th>Non-Ultrathin (n = 90)</th><th>Ultrathin (n = 91)</th><th><italic>P</italic> Value</th></tr></thead><tbody><tr><td>Complication any</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">92 (51)</td><td align="char">45 (50)</td><td align="char">47 (52)</td><td align="char">.82</td></tr><tr><td>&#x000a0;Yes</td><td align="char">89 (49)</td><td align="char">45 (50)</td><td align="char">44 (48)</td><td>NA</td></tr><tr><td>Pneumothorax</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td align="char">161 (95)</td><td align="char">85 (98)</td><td align="char">76 (93)</td><td align="char">.15</td></tr><tr><td>&#x000a0;Yes (any)</td><td align="char">8 (4)</td><td align="char">2 (2)</td><td align="char">6 (7)</td><td>NA</td></tr><tr><td>&#x000a0;None</td><td align="char">161 (95)</td><td align="char">85 (98)</td><td align="char">76 (93)</td><td align="char">.22</td></tr><tr><td>&#x000a0;Chest tube</td><td align="char">2 (1)</td><td align="char">1 (1)</td><td align="char">1 (1)</td><td>NA</td></tr><tr><td>&#x000a0;No chest tube</td><td align="char">6 (4)</td><td align="char">1 (1)</td><td align="char">5 (6)</td><td>NA</td></tr><tr><td>Bleeding from PPL sampling</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;None</td><td align="char">94 (52)</td><td align="char">47 (52)</td><td align="char">47 (52)</td><td align="char">.52</td></tr><tr><td>&#x000a0;Mild<xref rid="tbl4fna" ref-type="table-fn">a</xref></td><td align="char">79 (44)</td><td align="char">38 (42)</td><td align="char">41 (45)</td><td>NA</td></tr><tr><td>&#x000a0;Moderate<xref rid="tbl4fnb" ref-type="table-fn">b</xref></td><td align="char">5 (3)</td><td align="char">4 (4)</td><td align="char">1 (1)</td><td>NA</td></tr><tr><td>&#x000a0;Severe<xref rid="tbl4fnc" ref-type="table-fn">c</xref></td><td align="char">3 (2)</td><td align="char">1 (1)</td><td align="char">2 (2)</td><td>NA</td></tr></tbody></table><table-wrap-foot><fn><p>NA = not applicable; PPL = peripheral pulmonary lesion.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl4fna"><label>a</label><p id="ntpara0015">No interventions beyond suction.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl4fnb"><label>b</label><p id="ntpara0020">Application of cold saline, epinephrine, or scope tamponade.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl4fnc"><label>c</label><p id="ntpara0025">End of procedure, respiratory compromise, intubation, endobronchial blocker, embolization, transfusion, tranexamic acid, and escalation of care.</p></fn></table-wrap-foot></table-wrap></p></sec><sec id="sec2.2"><title>Hypothesis 2: ROSE vs No ROSE</title><p id="p0155">No difference was found in DY or sensitivity for malignancy for a PPL with or without ROSE: 60.4% vs 63.5% (difference, &#x02013;3.1%; 95% CI, &#x02013;17.3% to 11.0%; <italic>P</italic> = .76) and 80.3% vs 78.3% (difference, 2.0%; 95% CI, &#x02013;11.4% to 15.5%; <italic>P</italic> = .83), respectively (<xref rid="tbl2" ref-type="table">Table 2</xref>). The median procedure time was 5 minutes longer with ROSE compared with no ROSE: median, 35 minutes (interquartile range, 28-25 minutes) vs 30 minutes (interquartile range, 24-40 minutes), respectively (<italic>P</italic> = .03).</p><p id="p0160">Of the 96 patients randomized to ROSE, a diagnosis was established with ROSE in 34 patients (36%). Intraprocedural action was taken by the provider when ROSE was nondiagnostic in 62 patients (65%) (<xref rid="appsec1" ref-type="sec">e-Table 3</xref>). Intraprocedural action after an initial nondiagnostic ROSE sample was followed by a positive ROSE diagnosis in 23 patients, 20 patients with TBNA and 3 patients with cytobrush. Of the 58 patients randomized to ROSE for whom a bronchoscopic diagnosis was established, ROSE was diagnostic in 34 patients (59%). ROSE results from linear EBUS allowed termination of the procedure without a peripheral biopsy in only 1 patient.</p></sec><sec id="sec2.3"><title>Adjusted Analysis and Multiarm Comparison</title><p id="p0165">On multivariable analysis, no association was found between the use of an ultrathin bronchoscope and the use of ROSE with DY or sensitivity for malignancy (<xref rid="tbl5" ref-type="table">Table 5</xref>). On exploratory analysis, larger mean lesion size per square millimeter was associated with improved DY (OR, 1.05; 95% CI, 1.00-1.11; <italic>P</italic> = .04), but not sensitivity (OR, 1.05; 95% CI, 0.98-1.12; <italic>P</italic> = .15). Use of fluoroscopy was associated with reduced sensitivity, but few participants received fluoroscopy. No statistical differences in DY or sensitivity for malignancy in a multiarm comparison were observed on univariable and multivariable analysis (<xref rid="appsec1" ref-type="sec">e-Table 4</xref>).<table-wrap position="float" id="tbl5"><label>Table 5</label><caption><p>Adjusted Analysis for Diagnostic Yield and Sensitivity for Malignancy</p></caption><table frame="hsides" rules="groups"><thead><tr><th rowspan="2">Variable</th><th colspan="2">Diagnostic Yield<hr/></th><th colspan="2">Sensitivity<hr/></th></tr><tr><th>OR (95% CI)</th><th><italic>P</italic> Value</th><th>OR (95% CI)</th><th><italic>P</italic> Value</th></tr></thead><tbody><tr><td>Scope</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;Non-ultrathin</td><td>Ref</td><td>NA</td><td>Ref</td><td>NA</td></tr><tr><td>&#x000a0;Ultrathin</td><td align="char">0.99 (0.51-1.94)</td><td align="char">.98</td><td align="char">0.63 (0.24-1.65)</td><td align="char">.24</td></tr><tr><td>ROSE</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td>Ref</td><td>NA</td><td>Ref</td><td>NA</td></tr><tr><td>&#x000a0;Yes</td><td align="char">0.67 (0.34-1.33)</td><td align="char">.25</td><td align="char">1.11 (0.40-3.05)</td><td align="char">.85</td></tr><tr><td>Bronchus sign</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td>Ref</td><td>NA</td><td>Ref</td><td>NA</td></tr><tr><td>&#x000a0;Yes</td><td align="char">0.67 (0.21-2.07)</td><td align="char">.48</td><td align="char">0.47 (0.11-2.05)</td><td align="char">.32</td></tr><tr><td>Sex</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;Male</td><td>Ref</td><td>NA</td><td>Ref</td><td>NA</td></tr><tr><td>&#x000a0;Female</td><td align="char">0.91 (0.44-1.90)</td><td align="char">.81</td><td align="char">0.62 (0.22-1.74)</td><td align="char">.37</td></tr><tr><td>Age, y</td><td align="char">1.02 (0.98-1.06)</td><td align="char">.36</td><td align="char">1.06 (1.00-1.12)</td><td align="char">.07</td></tr><tr><td>Smoking status</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;Never</td><td>Ref</td><td>NA</td><td>Ref</td><td>NA</td></tr><tr><td>&#x000a0;Ever</td><td align="char">0.82 (0.36-1.90)</td><td align="char">.65</td><td align="char">0.30 (0.09-1.02)</td><td align="char">.05</td></tr><tr><td>Mean lesion size, mm<sup>2</sup></td><td align="char">1.05 (1.00-1.11)</td><td align="char">.04</td><td align="char">1.05 (0.98-1.12)</td><td align="char">.15</td></tr><tr><td>Lesion type</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;Solid</td><td>Ref</td><td>NA</td><td>Ref</td><td>NA</td></tr><tr><td>&#x000a0;Nonsolid</td><td align="char">1.12 (0.36-3.42)</td><td align="char">.85</td><td align="char">0.66 (0.14-3.16)</td><td align="char">.60</td></tr><tr><td>Lesion location</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;RUL</td><td>Ref</td><td>NA</td><td>Ref</td><td>NA</td></tr><tr><td>&#x000a0;RML</td><td align="char">1.39 (0.33-5.93)</td><td align="char">.66</td><td align="char">0.88 (0.06-12.6)</td><td align="char">.92</td></tr><tr><td>&#x000a0;RLL</td><td align="char">0.78 (0.28-2.18)</td><td align="char">.63</td><td align="char">0.39 (0.9-1.61)</td><td align="char">.19</td></tr><tr><td>&#x000a0;LUL</td><td align="char">1.01 (0.41-2.83)</td><td align="char">.88</td><td align="char">0.84 (0.20-3.45)</td><td align="char">.80</td></tr><tr><td>&#x000a0;LLL</td><td align="char">0.30 (0.11-0.79)</td><td align="char">.14</td><td align="char">0.32 (0.07-1.52)</td><td align="char">.15</td></tr><tr><td>Pretest probability of malignancy (Herder model)</td><td align="char">2.19 (0.35-13.73)</td><td align="char">.40</td><td align="char">0.56 (0.03-9.63)</td><td align="char">.67</td></tr><tr><td>Distance from pleura, mm</td><td align="char">1.02 (1.00-1.05)</td><td align="char">.08</td><td align="char">1.04 (1.00-1.09)</td><td align="char">.05</td></tr><tr><td>Virtual bronchoscopy</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td>Ref</td><td>NA</td><td>Ref</td><td>NA</td></tr><tr><td>&#x000a0;Yes</td><td align="char">1.31 (0.9-18.52)</td><td align="char">.84</td><td align="char">1.97 (0.23-17.03)</td><td align="char">.54</td></tr><tr><td>Fluoroscopy</td><td/><td/><td/><td/></tr><tr><td>&#x000a0;No</td><td>Ref</td><td>NA</td><td>Ref</td><td>NA</td></tr><tr><td>&#x000a0;Yes</td><td align="char">0.40 (0.11-1.52)</td><td align="char">.18</td><td align="char">0.12 (0.02-0.69)</td><td align="char">.02</td></tr></tbody></table><table-wrap-foot><fn><p>LUL = left upper lobe; LLL = left lower lobe; NA = not applicable; Ref = reference; RLL = right lower lobe; RML = right middle lobe; ROSE = rapid on-site evaluation; RUL = right upper lobe.</p></fn></table-wrap-foot></table-wrap></p></sec><sec id="sec2.4"><title>Interactions</title><p id="p0170">No statistical interaction between scope size and the use of ROSE was observed on the additive, multiplicative, or OR scales, although CIs were wide (<xref rid="appsec1" ref-type="sec">e-Table 5</xref>). Margin plots for the predicted DY and sensitivity (<xref rid="appsec1" ref-type="sec">e-Figs 2, 3</xref>) demonstrate nonadditivity across treatment combinations, but this likely reflects the absence of main effects, not necessarily interaction.</p></sec><sec id="sec2.5"><title>DY According to Biopsy Instrument and Localization on rEBUS</title><p id="p0175">TBNA was used in 156 patients (86%) (<xref rid="appsec1" ref-type="sec">e-Table 4</xref>). Cytobrush was used in the greatest number of patients overall (n = 159 [88%]). TBNA was performed in only 2 patients (1%) and BAL was performed in 9 patients (5%) when the lesion was not localized on rEBUS. TBNA was not diagnostic in these patients, and BAL was diagnostic in 2 patients (1%), but BAL was not the sole diagnostic method in either patient.</p><p id="p0180">Of the 131 patients in whom TBNA, TBB, and cytobrush were used, TBNA was the only diagnostic method in 10 patients (8%), TBB was the only diagnostic method in 11 patients (8%), and cytobrush was the only diagnostic method in 3 patients (2%). Of the 10 patients in whom TBNA was the only diagnostic method, 5 were patients in whom the rEBUS probe was in the lesion and 5 were patients in whom the probe was adjacent to the lesion. Of the 11 patients in whom TBB was the only diagnostic method, 7 were patients in whom the rEBUS probe was in the lesion and 4 were patients in whom the probe was adjacent to the lesion. The odds of establishing a diagnosis increased for every additional biopsy instrument used (OR, 2.2; 95% CI, 1.3-3.6; <italic>P</italic> = .002) in unadjusted analysis.</p><p id="p0185">An rEBUS image with the probe either in the lesion or adjacent to the lesion was obtained in 163 patients (90%) (<xref rid="tbl3" ref-type="table">Table 3</xref>). In patients with a bronchus sign, the lesion was localized on rEBUS in 94%. In patients without a bronchus sign, the lesion was localized in 75%. No difference was found in DY or sensitivity for malignancy between the rEBUS probe being in the lesion or adjacent to the lesion. For all 13 patients in whom rEBUS was used, and the lesion was not localized, the method was nondiagnostic.</p></sec></sec><sec id="sec3"><title>Discussion</title><p id="p0190">We found no significant difference in DY or sensitivity for malignancy of a non-ultrathin bronchoscope with rEBUS vs an ultrathin bronchoscope with rEBUS for the diagnosis of a PPL. We also found no improvement in the diagnostic performance of bronchoscopy with ROSE. ROSE was associated with a slightly longer median procedure time. No difference was found in relevant procedural characteristics or complications regardless of randomization arm or grouping.</p><p id="p0195">The overall DY of bronchoscopy (62%) and sensitivity (73%) for malignancy in our study is comparable with that in the published literature. The DY of rEBUS alone in the AQuIRE registry was 57%, and the sensitivity of rEBUS in a meta-analysis was 72% (95% CI, 70%-75%; <italic>I</italic><sup><italic>2</italic></sup> = 76%).<xref rid="bib3" ref-type="bibr"><sup>3</sup></xref><sup>,</sup><xref rid="bib15" ref-type="bibr"><sup>15</sup></xref> The modest diagnostic performance in our study is despite a high overall prevalence of malignancy (84%) as well as bronchus sign (90%) and 90% of lesions being localized on rEBUS. This diagnostic gap between localization with rEBUS and establishing a diagnosis is well described and is the underlying rationale for recent trials testing the potential benefits of cryobiopsy for PPLs (larger sample size to reduce sampling error) and using advanced imaging to confirm the biopsy tool is in the lesion before sampling.<xref rid="bib18" ref-type="bibr">18</xref>, <xref rid="bib19" ref-type="bibr">19</xref>, <xref rid="bib20" ref-type="bibr">20</xref>, <xref rid="bib21" ref-type="bibr">21</xref>, <xref rid="bib22" ref-type="bibr">22</xref>, <xref rid="bib23" ref-type="bibr">23</xref>, <xref rid="bib24" ref-type="bibr">24</xref>, <xref rid="bib25" ref-type="bibr">25</xref></p><sec id="sec3.1"><title>Ultrathin Bronchoscopy vs Non-Ultrathin Bronchoscopy</title><p id="p0200">Prior RCTs by Oki et al<xref rid="bib6" ref-type="bibr"><sup>6</sup></xref><sup>,</sup><xref rid="bib7" ref-type="bibr"><sup>7</sup></xref> demonstrated superior DY using an ultrathin bronchoscope (OD, 3.0 mm; WC, 1.7 mm) and rEBUS compared with a thin bronchoscope (OD, 4.0 mm) and rEBUS. Tanner et al<xref rid="bib9" ref-type="bibr"><sup>9</sup></xref> demonstrated no difference in DY between a thin bronchoscope (OD, 4.2 mm) with rEBUS and a standard bronchoscope (OD, 4.9 mm) with rEBUS. Our study did not redemonstrate the benefit of UB reported by Oki et al,<xref rid="bib6" ref-type="bibr"><sup>6</sup></xref><sup>,</sup><xref rid="bib7" ref-type="bibr"><sup>7</sup></xref> but our comparison arm included bronchoscopy with both thin and standard bronchoscopes (OD &#x02265; 4.2 mm), making the trials not directly comparable. That said, a benefit may still be expected given the comparable performance of standard and thin bronchoscopes reported by Tanner et al.<xref rid="bib9" ref-type="bibr"><sup>9</sup></xref></p><p id="p0205">We note the significantly lower DY of UB in our study (58%) compared with those reported by Oki et al<xref rid="bib6" ref-type="bibr"><sup>6</sup></xref><sup>,</sup><xref rid="bib7" ref-type="bibr"><sup>7</sup></xref> in 2015 (74%) and 2019 (70%) and by Zheng et al<xref rid="bib26" ref-type="bibr"><sup>26</sup></xref> of UB (OD, 3.0 mm; WC, 1.7 mm) with and without fluoroscopy (81.7% and 73.3%, respectively). Zheng et al<xref rid="bib26" ref-type="bibr"><sup>26</sup></xref> defined DY as a matching of the pathologic or microbiological results with the final diagnosis confirmed by pathologic examination, microbiological assessments, or clinical follow-up. This definition is expected to overestimate DY and may explain the difference in DY between our studies.</p><p id="p0210">However, the reasons for our relative underperformance compared with Oki et al<xref rid="bib6" ref-type="bibr"><sup>6</sup></xref><sup>,</sup><xref rid="bib7" ref-type="bibr"><sup>7</sup></xref> is uncertain because the definitions of DY are the same. Most providers in our study had limited experience with an ultrathin scope before the trial, but no association was found between the study start date and diagnostic performance of an ultrathin scope. This suggests that a learning curve was not present. Oki et al<xref rid="bib6" ref-type="bibr"><sup>6</sup></xref><sup>,</sup><xref rid="bib7" ref-type="bibr"><sup>7</sup></xref> used both VBN and fluoroscopy for all patients, whereas VBN and fluoroscopy were used rarely in our study. However, a meta-analysis of VBN suggests that VBN is not associated independently with improved DY and data are mixed on whether fluoroscopy is additive.<xref rid="bib3" ref-type="bibr"><sup>3</sup></xref><sup>,</sup><xref rid="bib26" ref-type="bibr"><sup>26</sup></xref><sup>,</sup><xref rid="bib27" ref-type="bibr"><sup>27</sup></xref> Otherwise, our study was similar across a range a clinically important variables, including prevalence of malignancy, mean lesion size, presence of a radiographic bronchus sign, use of moderate sedation, and others.</p><p id="p0215">The DY of thin bronchoscopy (OD, 4.0 mm) reported by Oki et al<xref rid="bib6" ref-type="bibr"><sup>6</sup></xref><sup>,</sup><xref rid="bib7" ref-type="bibr"><sup>7</sup></xref> (ie, the comparison arm) also was higher than that reported by Tanner et al<xref rid="bib9" ref-type="bibr"><sup>9</sup></xref> (59% vs 49%, respectively), although Tanner et al<xref rid="bib9" ref-type="bibr"><sup>9</sup></xref> did not use TBNA, which partially may account for the lower DY. Nevertheless, this significant difference in performance suggests that unmeasured differences in the patients, providers, techniques, or a combination thereof between trials remain.</p><p id="p0220">No published trials directly compare the diagnostic performance of UB with other technologies such as electromagnetic navigation bronchoscopy or robotic bronchoscopy. In an updated meta-analysis of guided bronchoscopy for the evaluation of PPLs, Nadig et al<xref rid="bib28" ref-type="bibr"><sup>28</sup></xref> reported pooled mean DYs of 62.6% to 77.6% across a range of combinations of techniques. Interestingly, UB or thin bronchoscopy (OD, 4.2 mm) alone or with rEBUS was associated with the lowest DY (50.2% [95% CI, 37.3%-63.2%] and 62.6% [95% CI, 55.3%-70.0%], respectively) of the 11 techniques studied. However, the DYs across all studies varied widely, regardless of technique, and the DYs were lower in studies less prone to bias. This suggests that more comparative studies are still needed.</p><p id="p0225">Although not statistically significant, numerically more pneumothoraces occurred with the ultrathin scope in our study compared with a non-ultrathin scope (7% vs 2%, respectively; <italic>P</italic> = .15). A similar trend is not seen in the studies by Oki et al. A pneumothorax rate of 7% in the ultrathin arm is higher than the pooled rates reported in meta-analyses of UB (1.1%; range, 0.3%-2.5%), non-ultrathin bronchoscopy with rEBUS (0.7%; 95% CI, 0.3%-1.1%), electomagnetic navigational bronchoscopy (2.0%; 95% CI, 1.0%-3.0%), and robotic bronchoscopy (2.3%; 95% CI, 1.7%-3.1%).<xref rid="bib3" ref-type="bibr"><sup>3</sup></xref><sup>,</sup><xref rid="bib8" ref-type="bibr"><sup>8</sup></xref><sup>,</sup><xref rid="bib29" ref-type="bibr"><sup>29</sup></xref> In the AQuIRE registry, pneumothorax occurred in 2% of patients. Given the relatively small number of patients in the ultrathin arm of our trial (n = 93), it is possible that the risk of pneumothorax is overestimated. However, navigating deeper into the airway may lead to a greater risk of pneumothorax. No cases of pneumothorax occurred in our study when fluoroscopy was used, although fluoroscopy was used in only 6% of patients and the association was not statistically significant.</p></sec><sec id="sec3.2"><title>ROSE vs No ROSE</title><p id="p0230">A recent survey of bronchoscopists, mostly from the United States working in academic centers, showed that 65% used ROSE for nonrobotic peripheral bronchoscopy and 88% used ROSE with linear EBUS.<xref rid="bib30" ref-type="bibr"><sup>30</sup></xref> Xu et al<xref rid="bib10" ref-type="bibr"><sup>10</sup></xref> randomized 152 patients with a PPL of &#x02264; 3 cm suspicious for lung cancer to bronchoscopy using a standard bronchoscope (OD, 5.9 mm) with and without ROSE. The DY was 85.9% with ROSE and 70.3% without ROSE (<italic>P</italic> = .016). In a similar RCT of 198 patients by Qi et al,<xref rid="bib11" ref-type="bibr"><sup>11</sup></xref> the DYs of brushing and TBNA were 68% and 84% with ROSE, respectively, and 44% and 74% without ROSE, respectively. In a meta-analysis of peripheral bronchoscopy with TBNA by Mondoni et al,<xref rid="bib31" ref-type="bibr"><sup>31</sup></xref> the pooled DY in the subgroup of patients with ROSE was 62% (95% CI, 40%-80%) compared with 51% (95% CI, 40%-60%) in patients without ROSE. A similar improvement in DY was not observed in our study. It is notable that the diagnostic performance of bronchoscopy in the studies by Xu et al<xref rid="bib10" ref-type="bibr"><sup>10</sup></xref> and Qi et al<xref rid="bib11" ref-type="bibr"><sup>11</sup></xref> are higher than those generally reported and that no formal test of association between ROSE and no ROSE subgroups was performed in the meta-analysis.</p><p id="p0235">Our study also permitted linear EBUS at the discretion of the bronchoscopist, where ROSE may provide a diagnostic advantage if nodal metastases are present. However, ROSE precluded the need for peripheral biopsy in only 1 patient when linear EBUS was used. This is explained mostly by the low probability of nodal metastasis in our study cohort and was a function of the inclusion criteria. ROSE may have more impact in cohorts with higher prevalences of hilar or mediastinal involvement.</p></sec><sec id="sec3.3"><title>Study Limitations</title><p id="p0240">The trial was suspended early at 87% of accrual because of global supply issues with peripheral needles. A sensitivity analysis for the best case scenario in which all remaining patients randomized to an ultrathin bronchoscope underwent a diagnostic procedure and all those randomized to a non-ultrathin bronchoscope did not, the difference in DY remained nonsignificant. This suggests that no difference would have been observed had the trial been completed as initially powered.</p><p id="p0245">Not detecting significant differences between our trial groups does not exclude the possibility that a clinically meaningful difference exists for either hypothesis tested because we powered the study to detect relatively large differences in line with what some prior studies had demonstrated. Designing and enrolling in much larger trials powered to detect 5% to 10% differences in outcomes will require improved funding opportunities and collaboration and coordination between research groups. Even with such collaborations, current trials in this space are powered to detect 15% to 20% differences between various interventions.<xref rid="bib32" ref-type="bibr"><sup>32</sup></xref></p><p id="p0250">Another potential limitation is the lack of standardization of the bronchoscopic procedure other than the use of an ultrathin scope and TBNA. Although this may better reflect real-world practice, it is more difficult to identify an association between an ultrathin bronchoscope and improved performance, despite the RCT design. That said, it was impractical to standardize all aspects of the procedure given practice and resource differences across sites and providers. Further, the most relevant patient and procedure characteristics were well matched in our trial.</p><p id="p0255">Although we found no evidence of interaction across multiple statistical scales, the wide CIs highlight that the trial was not powered to detect interaction. The absence of observed differences in DY and sensitivity in the main analysis also makes it difficult to interpret the apparent nonadditivity in the margins plots. Lack of interaction in this context may reflect null effects, rather than independence. We therefore acknowledge that although we tested for interaction, the assumption of no interaction in our trial design remains unprovable.</p></sec></sec><sec id="sec4"><title>Interpretation</title><p id="p0260">We found no significant difference in the DY or sensitivity for malignancy of a non-ultrathin bronchoscope with rEBUS vs an ultrathin BF-MP190F bronchoscope with rEBUS for the diagnosis of a PPL. We also found no improvement in the diagnostic performance of bronchoscopy with ROSE. The study was not powered to detect smaller but potentially meaningful differences between groups.</p></sec><sec id="sec5"><title>Funding/Support</title><p id="p0265">The authors have reported to <italic>CHEST</italic> that no funding was received for this study.</p></sec><sec sec-type="COI-statement" id="coi0010"><title>Financial/Nonfinancial Disclosures</title><p id="p0270">The authors have reported to <italic>CHEST</italic> the following: M. F. has received honorariums from Olympus, but none directly related to this research. A. C. C. is chief medical officer of LEADOptik, a medical device company with a focus on lung nodule assessment. A. T. has contract research with Biodesix, Inc., and Nucleix, Inc., through the University of Calgary. None declared (E. V., A. V. G., L. S., E. D., M. D., C. A. H., M. K., N. L., P. E., S. M., B. S., M. S., T. S., T. T.).</p></sec></body><back><ref-list id="cebib0010"><title>References</title><ref id="bib1"><label>1</label><element-citation publication-type="journal" id="sref1"><person-group person-group-type="author"><name><surname>Silvestri</surname><given-names>G.A.</given-names></name><name><surname>Gonzalez</surname><given-names>A.V.</given-names></name><name><surname>Jantz</surname><given-names>M.A.</given-names></name><etal/></person-group><article-title>Methods for staging non-small cell lung cancer: Diagnosis and Management of Lung Cancer, 3rd ed: American College of Chest Physicians evidence-based clinical practice guidelines</article-title><source>Chest</source><volume>143</volume><issue>5 suppl</issue><year>2013</year><fpage>e211S</fpage><lpage>e250S</lpage><pub-id pub-id-type="pmid">23649440</pub-id>

</element-citation><mixed-citation id="mc-CR11" publication-type="journal">Zhao L, Bao J, Qiao X, Jin P, et al. Predicting clinically significant prostate cancer with a deep learning approach: a multicentre retrospective study. Eur J Nucl Med Mol Imaging. 2023;50(3):727&#x02013;41.<pub-id pub-id-type="pmid">36409317</pub-id>

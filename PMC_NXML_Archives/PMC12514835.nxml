<article-id pub-id-type="publisher-id">3734</article-id><article-id pub-id-type="doi">10.1186/s12951-025-03734-y</article-id><article-categories><subj-group subj-group-type="heading"><subject>Review</subject></subj-group></article-categories><title-group><article-title>Multifunctional nanoparticles in abdominal aortic aneurysm management: from basic research to clinical transformation</article-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><name><surname>Yuan</surname><given-names>Gang</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Wang</surname><given-names>Weiming</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Jia</surname><given-names>Xiaohui</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Liu</surname><given-names>Zhiying</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Cui</surname><given-names>Ran</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Xu</surname><given-names>Yanneng</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Liu</surname><given-names>Yong</given-names></name><address><email>lyong74@163.com</email></address><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Si</surname><given-names>Guangyan</given-names></name><address><email>Siguangyan@swmu.edu.cn</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/00g2rqs52</institution-id><institution-id institution-id-type="GRID">grid.410578.f</institution-id><institution-id institution-id-type="ISNI">0000 0001 1114 4286</institution-id><institution>Department of Intervention &#x00026; Vascular, </institution><institution>The Affiliated Traditional Chinese Medicine Hospital, Southwest Medical University, </institution></institution-wrap>Luzhou, 646000 China </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0014a0n68</institution-id><institution-id institution-id-type="GRID">grid.488387.8</institution-id><institution>Department of General Surgery (Vascular Surgery), </institution><institution>The Affiliated Hospital, Southwest Medical University, </institution></institution-wrap>Luzhou, 646000 China </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03jqs2n27</institution-id><institution-id institution-id-type="GRID">grid.259384.1</institution-id><institution-id institution-id-type="ISNI">0000 0000 8945 4455</institution-id><institution>School of Pharmacy, Faculty of Medicine, </institution><institution>Macau University of Science and Technology, </institution></institution-wrap>Macao, 999078 China </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/00g2rqs52</institution-id><institution-id institution-id-type="GRID">grid.410578.f</institution-id><institution-id institution-id-type="ISNI">0000 0001 1114 4286</institution-id><institution>Department of Neurology, </institution><institution>The Affiliated Hospital, Southwest Medical University, </institution></institution-wrap>Luzhou, 646000 China </aff><aff id="Aff5"><label>5</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03nr56d94</institution-id><institution-id institution-id-type="ISNI">0000 0004 1792 6635</institution-id><institution>Department of Oncology, </institution><institution>The First People&#x02019;s Hospital of Neijiang, </institution></institution-wrap>Neijiang, 641000 Sichuan China </aff></contrib-group><pub-date pub-type="epub"><day>10</day><month>10</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>10</day><month>10</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>23</volume><elocation-id>636</elocation-id><history><date date-type="received"><day>1</day><month>7</month><year>2025</year></date><date date-type="accepted"><day>19</day><month>9</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1" abstract-type="structured"><p id="Par1">Abdominal aortic aneurysm (AAA) is a life-threatening vascular condition marked by localized aortic dilation and structural weakening of the vessel wall, often leading to catastrophic complications such as rupture. As one of the leading causes of acute aortic-related mortality in the elderly, AAA rupture underscores the critical need for effective therapeutic strategies to prevent this fatal outcome. Current clinical management relies heavily on surgical or endovascular repair for larger aneurysms to reduce rupture risk; however, early diagnostic tools and pharmacological interventions remain limited. Advances in nanoscience present promising opportunities for targeted imaging and drug delivery in AAA treatment. Multifunctional nanoparticles (NPs) can be precisely engineered with ligands or biomembrane coatings to enable site-specific drug accumulation, minimizing systemic side effects. Beyond targeted delivery, NPs enhance drug solubility, prolong circulation half-life, improve bioavailability, and maximize therapeutic efficiency. Furthermore, carefully designed nanobiomaterials can maintain long-term stability within the vascular system without cellular internalization. This review highlights the applications of NPs in AAA imaging and therapy, summarizes recent progress in NPs-based diagnostics and treatments, and discusses their potential to transform clinical outcomes in AAA management.</p><sec><title>Graphical abstract</title><p id="Par2">
<graphic position="anchor" xlink:href="12951_2025_3734_Figa_HTML" id="MO1"/>
</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Abdominal aortic aneurysm</kwd><kwd>Nanoparticles</kwd><kwd>Diagnosis and treatment</kwd><kwd>Application</kwd><kwd>Clinical transformation</kwd></kwd-group><funding-group><award-group><funding-source><institution>Sichuan Medical Association Youth Innovation Project</institution></funding-source><award-id>Q2024039</award-id><award-id>Q2024039</award-id><principal-award-recipient><name><surname>Yuan</surname><given-names>Gang</given-names></name><name><surname>Si</surname><given-names>Guangyan</given-names></name></principal-award-recipient></award-group></funding-group><funding-group><award-group><funding-source><institution>Sichuan Provincial Science and Central Guidance Local Exploration Fund Project</institution></funding-source><award-id>2024ZYD0103</award-id><award-id>2024ZYD0103</award-id><award-id>2024ZYD0103</award-id><principal-award-recipient><name><surname>Yuan</surname><given-names>Gang</given-names></name><name><surname>Cui</surname><given-names>Ran</given-names></name><name><surname>Si</surname><given-names>Guangyan</given-names></name></principal-award-recipient></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; BioMed Central Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par3">Abdominal aortic aneurysm (AAA), a life-threatening vascular condition characterized by progressive dilation exceeding 50% of the normal aortic diameter, carries a high risk of rupture and thrombosis [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>]. Its incidence varies significantly by demographic factors: men exhibit a 4&#x02013;6-fold higher prevalence than women, while age and ethnicity further modulate risk, with Caucasian males over 50 and females over 60 being particularly susceptible [<xref ref-type="bibr" rid="CR3">3</xref>&#x02013;<xref ref-type="bibr" rid="CR6">6</xref>]. Given the catastrophic mortality (&#x0003e;80%) associated with rupture, early diagnosis and proactive management are critical to mitigating disease progression [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>].</p><p id="Par4">Despite clinical advancements, AAA remains a formidable therapeutic challenge due to its asymptomatic progression, limited treatment options, and high surgical risks. Current diagnostics rely on ultrasound and computed tomography angiography (CTA), yet these modalities fail to detect early molecular hallmarks of rupture risk, such as inflammatory cell infiltration or extracellular matrix (ECM) degradation [<xref ref-type="bibr" rid="CR7">7</xref>]. Pharmacotherapies (e.g., beta-blockers, statins) show minimal efficacy, as they inadequately address the multifactorial pathophysiology involving oxidative stress, matrix metalloproteinase (MMP) hyperactivity, and chronic inflammation [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR8">8</xref>]. Consequently, surgical repair, open surgery or endovascular aneurysm repair (EVAR) remains the sole definitive intervention, albeit reserved for large aneurysms (females &#x0003e;5.0 cm; males &#x0003e;5.5 cm) or rapidly expanding cases. These procedures may entail significant perioperative complications, including endoleaks, graft infections, and organ dysfunction [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR10">10</xref>]. For small AAAs (&#x0003c; 5 cm), the prevailing &#x0201c;watchful waiting&#x0201d; strategy imposes psychological burdens and clinical uncertainty, as unpredictable rupture risks persist [<xref ref-type="bibr" rid="CR11">11</xref>]. This unmet need underscores the urgency for innovative approaches that enable early detection, targeted therapy, and personalized risk stratification.</p><p id="Par5">The etiology of AAA is complex and incompletely elucidated. While early studies implicated atherosclerosis (AS) [<xref ref-type="bibr" rid="CR12">12</xref>], contemporary research frames AAA as an immune-mediated degenerative process involving the apoptosis of vascular smooth muscle cells (VSMCs), immune cell infiltration, and ECM remodeling [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR13">13</xref>&#x02013;<xref ref-type="bibr" rid="CR15">15</xref>]. Key pathogenic drivers include MMP overexpression, proteolytic ECM degradation, oxidative stress, and chronic inflammation [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR16">16</xref>&#x02013;<xref ref-type="bibr" rid="CR18">18</xref>]. This intricate pathophysiology complicates early diagnosis and treatment. Conventional imaging (ultrasound, CTA) lacks molecular sensitivity, while systemic drugs face biological barriers such as poor vascular penetration and off-target effects [<xref ref-type="bibr" rid="CR7">7</xref>, <xref ref-type="bibr" rid="CR19">19</xref>]. Although magnetic resonance imaging (MRI) offers high resolution, its cost and procedural complexity limit routine use [<xref ref-type="bibr" rid="CR7">7</xref>, <xref ref-type="bibr" rid="CR20">20</xref>]. The absence of reliable biomarkers further impedes early detection [<xref ref-type="bibr" rid="CR21">21</xref>]. Therapeutically, while EVAR has almost supplanted open surgery as a less invasive option [<xref ref-type="bibr" rid="CR22">22</xref>, <xref ref-type="bibr" rid="CR23">23</xref>], its efficacy is hampered by anatomical variability, post-procedural complications [<xref ref-type="bibr" rid="CR24">24</xref>&#x02013;<xref ref-type="bibr" rid="CR26">26</xref>], and the lack of bioengineered grafts that combine optimal mechanical support with physiological compatibility [<xref ref-type="bibr" rid="CR27">27</xref>&#x02013;<xref ref-type="bibr" rid="CR29">29</xref>]. These limitations highlight the demand for integrated platforms unifying early diagnosis, precision therapy, and dynamic monitoring.</p><p id="Par6">Nanotechnology has emerged as a transformative solution, offering unique advantages to overcome these challenges. Engineered nanocarriers (10&#x02013;200 nm) leverage: (1) enhanced permeability and retention (EPR) for passive targeting, (2) surface functionalization for active molecular recognition, (3) multimodal imaging integration, and (4) stimuli-responsive drug release [<xref ref-type="bibr" rid="CR5">5</xref>, <xref ref-type="bibr" rid="CR30">30</xref>, <xref ref-type="bibr" rid="CR31">31</xref>]. Such capabilities position nanotechnology as a versatile theranostic platform for AAA (Fig. <xref rid="Fig1" ref-type="fig">1</xref>).</p><p id="Par7">
<fig id="Fig1"><label>Fig. 1</label><caption><p>The advantages of engineering nanocarriers in the diagnosis and treatment of AAA. The figure has been created using Biorender</p></caption><graphic xlink:href="12951_2025_3734_Fig1_HTML" id="MO2"/></fig>
</p><p id="Par8">Recent advances exemplify this potential: <bold><italic>Targeted drug delivery</italic></bold>: Liposomal nanoparticles (NPs) co-loaded with cycloastragenol and doxycycline (DOX), delivered via extravascular hydrogel patches, demonstrated localized drug penetration and reduced aortic expansion in murine AAA models [<xref ref-type="bibr" rid="CR32">32</xref>]. <bold><italic>Microenvironment modulation</italic></bold>: Dual-targeting nanodrugs have shown efficacy in ameliorating AAA by remodeling the pathological microenvironment in AAA model mice [<xref ref-type="bibr" rid="CR33">33</xref>]. <bold><italic>Theranostic integration</italic></bold>: Although no multifunctional AAA nanomaterial has reached clinical use, combining MMP-responsive drug release with MRI contrast agents (e.g., superparamagnetic iron oxide nanoparticles, SPIONs) could enable simultaneous real-time imaging and site-specific therapy. Pioneering work using single-cell RNA sequencing identified CXCR4 as a key inflammatory biomarker, facilitating the development of SPION-based multimodal nanoprobes for AAA imaging [<xref ref-type="bibr" rid="CR34">34</xref>].</p><p id="Par9">The past decade has witnessed significant advancements in NPs development for AAA, transitioning from basic drug delivery systems [<xref ref-type="bibr" rid="CR35">35</xref>] to sophisticated multifunctional platforms capable of executing sequential therapeutic actions [<xref ref-type="bibr" rid="CR36">36</xref> &#x02212; <xref ref-type="bibr" rid="CR38">38</xref>]. These next-generation systems integrate molecular imaging for early detection [<xref ref-type="bibr" rid="CR34">34</xref>], biomarker-responsive drug release (e.g., triggered by elastin fragments) [<xref ref-type="bibr" rid="CR39">39</xref>], and post-interventional treatment monitoring [<xref ref-type="bibr" rid="CR40">40</xref>]. Notably, neutrophil membrane-coated NPs represent a breakthrough, achieving precise aortic lesion targeting through inflammatory cell homing mechanisms while stabilizing vulnerable vascular walls and reducing AAA-related mortality [<xref ref-type="bibr" rid="CR41">41</xref>]. These cumulative technological innovations have established a robust framework for translating multifunctional NPs from preclinical research to clinical applications in AAA management.</p><p id="Par10">This review critically examines the role of NPs in bridging AAA research and clinical translation. We first outline AAA pathophysiology and current therapeutic gaps, then explore how nanotechnology addresses these through precision targeting, multifunctional integration, and biomarker-responsive designs. By synthesizing preclinical advances and clinical trials, we highlight the promise of nanotheranostics in revolutionizing AAA care, from subclinical detection to personalized therapy, while addressing translational hurdles like biocompatibility, scalability, and regulatory compliance.</p></sec><sec id="Sec2"><title>The pathogenesis of AAA</title><p id="Par11">The pathogenesis of AAA involves a complex interplay of vascular wall degradation, chronic inflammation, oxidative stress, and genetic susceptibility. While AS was historically considered central to AAA development [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR42">42</xref>], contemporary research utilizing single-cell sequencing and biomechanical analyses has redefined AAA as an acquired, immune-mediated destructive process of the aortic wall [<xref ref-type="bibr" rid="CR34">34</xref>, <xref ref-type="bibr" rid="CR43">43</xref>, <xref ref-type="bibr" rid="CR44">44</xref>]. This process manifests through four interconnected pathological mechanisms: (1) ECM fragmentation and fibrosis imbalance, (2) VSMC apoptosis and medial degeneration, (3) immune cell infiltration and inflammatory responses, and (4) intraluminal thrombus (ILT) formation with intramural hematoma (IMH) [<xref ref-type="bibr" rid="CR14">14</xref>, <xref ref-type="bibr" rid="CR45">45</xref>&#x02013;<xref ref-type="bibr" rid="CR48">48</xref>] (Fig. <xref rid="Fig2" ref-type="fig">2</xref>).</p><p id="Par12">
<fig id="Fig2"><label>Fig. 2</label><caption><p>Schematic diagram of the pathogenesis of AAA. The figure has been created using Biorender</p></caption><graphic xlink:href="12951_2025_3734_Fig2_HTML" id="MO3"/></fig>
</p><sec id="Sec3"><title>ECM fragmentation and fibrosis imbalance</title><p id="Par13">Aortic wall stability depends on the equilibrium between elastic fibers and collagen, both of which undergo profound dysregulation in AAA. The disease is characterized by irreversible ECM degradation mediated primarily by MMPs, particularly MMP-2 and MMP-9 [<xref ref-type="bibr" rid="CR8">8</xref>, <xref ref-type="bibr" rid="CR49">49</xref>]. These enzymes excessively degrade elastic fibers and collagen types I/III, while compensatory collagen synthesis produces mechanically inferior, disorganized fibers that fail to restore vascular stability. This imbalance progressively weakens the aortic wall&#x02019;s ability to withstand hemodynamic stresses.</p></sec><sec id="Sec4"><title>VSMC apoptosis and tunica media degeneration</title><p id="Par14">VSMC depletion through apoptosis represents a pivotal event in AAA progression. Oxidative stress and proinflammatory cytokines (e.g., TNF-&#x003b1;, IL-6) induce VSMC apoptosis, which reduces their density, impairs ECM maintenance capabilities, and ultimately leads to medial layer thinning and diminished tensile strength [<xref ref-type="bibr" rid="CR8">8</xref>, <xref ref-type="bibr" rid="CR48">48</xref>]. Equally important is VSMC phenotypic switching: in AAA, contractile markers (&#x003b1;-SMA, SM22&#x003b1;) are downregulated while synthetic markers (e.g., osteopontin) are upregulated [<xref ref-type="bibr" rid="CR50">50</xref>, <xref ref-type="bibr" rid="CR51">51</xref>]. This shift promotes protease secretion, exacerbating ECM degradation and creating a self-perpetuating cycle of VSMC detachment, migration, and apoptosis.</p></sec><sec id="Sec5"><title>Immune cell infiltration and inflammatory responses</title><p id="Par15">AAA lesions exhibit robust infiltration of macrophages (predominantly M1 phenotype), Th1 lymphocytes, and neutrophils, which establish a chronic inflammatory microenvironment through cytokine release (IL-1&#x003b2;, IFN-&#x003b3;) [<xref ref-type="bibr" rid="CR45">45</xref>, <xref ref-type="bibr" rid="CR52">52</xref>]. M1 macrophages dominate the inflammatory milieu, secreting TNF-&#x003b1; and IL-1&#x003b2;, while reparative M2 macrophages are conspicuously diminished [<xref ref-type="bibr" rid="CR53">53</xref>&#x02013;<xref ref-type="bibr" rid="CR55">55</xref>]. This immune activation promotes reactive oxygen species (ROS) production and further degradation of structural components (elastin, collagen I/III, ECM), creating a feed-forward loop of vascular injury [<xref ref-type="bibr" rid="CR56">56</xref>&#x02013;<xref ref-type="bibr" rid="CR58">58</xref>]. Notably, both the aneurysmal wall and ILT harbor diverse immune cells and mediators, underscoring the immune-driven nature of AAA pathogenesis.</p></sec><sec id="Sec6"><title>ILT and IMH formation</title><p id="Par16">Turbulent flow patterns in the dilated aortic lumen foster mural thrombus formation, which paradoxically both results from and exacerbates AAA progression. Approximately 75% of AAAs develop multilayered ILTs that generate a proteolytic, oxidative microenvironment through the release of thrombus-derived plasminogen activator inhibitor-1(PAI-1), platelet-derived growth factor (PDGF), and inflammatory mediators [<xref ref-type="bibr" rid="CR56">56</xref>, <xref ref-type="bibr" rid="CR59">59</xref>]. While ILT may initially buffer hemodynamic stress, its expansion correlates with rupture risk [<xref ref-type="bibr" rid="CR60">60</xref>&#x02013;<xref ref-type="bibr" rid="CR62">62</xref>] and impedes drug delivery to the vascular wall [<xref ref-type="bibr" rid="CR63">63</xref>]. The thrombus undergoes continuous remodeling through inflammatory cell infiltration and IMH formation, further impairing elastic lamina regeneration and accelerating cellular apoptosis.</p><p id="Par17">The pathophysiology of AAA ultimately reflects a dynamic imbalance between vascular repair mechanisms and destructive processes driven by chronic inflammation, proteolytic hyperactivity, VSMC dysfunction, and genetic predisposition.</p></sec></sec><sec id="Sec7"><title>Application of nanomaterials in AAA molecular imaging enhancement</title><p id="Par18">The insidious onset and variable progression rate of AAA make early detection challenging. Current diagnostic methods often fail to identify high-risk cases before rupture, which presents as sudden, severe abdominal/back pain with hypotension and carries &#x0003e;80% mortality without immediate intervention [<xref ref-type="bibr" rid="CR56">56</xref>]. While existing imaging modalities provide anatomical assessment, they lack sensitivity for early molecular changes, underscoring the need for advanced imaging technologies with improved specificity.</p><p id="Par19">Multifunctional NPs have emerged as promising tools for revolutionizing AAA imaging and diagnosis. These engineered NPs exhibit unique capabilities to specifically target pathological features of the vascular wall, including degraded elastic layers and inflammatory cell infiltrates, while maintaining stable localization over a long period without being taken up by other cells [<xref ref-type="bibr" rid="CR31">31</xref>]. Their superior properties compared to conventional contrast agents, including extended circulation half-life, precise biodistribution control, and molecular-level targeting, make them ideal candidates for early AAA detection [<xref ref-type="bibr" rid="CR64">64</xref>, <xref ref-type="bibr" rid="CR65">65</xref>]. Surface-modified NPs demonstrate particularly strong accumulation at aneurysm sites, generating enhanced imaging signals that improve diagnostic sensitivity [<xref ref-type="bibr" rid="CR11">11</xref>, <xref ref-type="bibr" rid="CR65">65</xref>, <xref ref-type="bibr" rid="CR66">66</xref>]. These advantages have spurred successful applications across multiple imaging modalities (CT, MRI, PET-CT), with several NPs showing significant clinical potential, as detailed in Table <xref rid="Tab1" ref-type="table">1</xref>.<table-wrap id="Tab1"><label>Table 1</label><caption><p>List of applications of nanomaterials in AAA imaging</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Imaging</th><th align="left">Nanomaterials</th><th align="left">Contrast agent</th><th align="left">Targets</th><th align="left">AAA models</th><th align="left">Refs.</th></tr></thead><tbody><tr><td align="left">USMI</td><td align="left"><p>Biotinylated lipid MBs</p><p>Drug-containing MBs</p></td><td align="left"><p>MBs</p><p>MBs</p></td><td align="left"><p>VEGFR-2</p><p>Ligand-receptor</p></td><td align="left"><p>Murine model of AAA</p><p>3D patient-specific model of AAA</p></td><td align="left"><p>[<xref ref-type="bibr" rid="CR67">67</xref>]</p><p>[<xref ref-type="bibr" rid="CR68">68</xref>]</p></td></tr><tr><td align="left"><p>X-ray imaging</p><p>(CT)</p></td><td align="left"><p>EL-GNP</p><p>GNPs</p><p>EL-AuNPs</p><p>Exitron nano 12,000</p></td><td align="left"><p>GNPs</p><p>GNPs</p><p>AuNPs</p><p>Exitron</p></td><td align="left"><p>Elastin</p><p>Macrophages</p><p>Fragmented elastin</p><p>Mononuclear phagocytes</p></td><td align="left"><p>Ang II-infused Apoe -/- mice</p><p>Ang II-infused Apoe -/- mice</p><p>Elastase model of AAA</p><p>Ang II-infused Apoe -/- mice</p></td><td align="left"><p>[<xref ref-type="bibr" rid="CR69">69</xref>]</p><p>[<xref ref-type="bibr" rid="CR70">70</xref>]</p><p>[<xref ref-type="bibr" rid="CR71">71</xref>]</p><p>[<xref ref-type="bibr" rid="CR19">19</xref>]</p></td></tr><tr><td align="left">PET/CT</td><td align="left"><p>18 F-CLIO</p><p>(18)F-FDG</p></td><td align="left"><p>CLIO</p><p>F-FDG</p></td><td align="left"><p>Macrophages</p><p>Glycolytic macrophages</p></td><td align="left"><p>Ang II-infused Apoe -/- mice</p><p>Asymptomatic AAA patients</p></td><td align="left"><p>[<xref ref-type="bibr" rid="CR72">72</xref>]</p><p>[<xref ref-type="bibr" rid="CR73">73</xref>]</p></td></tr><tr><td align="left">MRI</td><td align="left"><p>Dextran-coated IONPs</p><p>Activatable nanoprobe</p><p>RGD-HFn-Fe<sub>3</sub>O<sub>4</sub></p><p>USPIO-FUCO</p><p>USPIO</p><p>SPIO</p><p>CNA-35 micelles</p></td><td align="left"><p>UPSIO</p><p>Fe/IONPs</p><p>Fe<sub>3</sub>O<sub>4</sub> NPs</p><p>USPIO</p><p>Ferumoxtran-10</p><p>SPIO</p><p>Fluorescent/ paramagnetic NPs</p></td><td align="left"><p>Macrophages</p><p>MMPs</p><p>&#x003b1;<sub>v</sub>&#x003b2;<sub>3</sub> integrin</p><p>P-selectin</p><p>Macrophages</p><p>Macrophages</p><p>Collagens</p></td><td align="left"><p>Asymptomatic AAA patients</p><p>Ang II-infused Apoe -/- mice</p><p>Ang II-infused Apoe -/- mice</p><p>Elastase-induced rat model</p><p>Ang II-infused Apoe -/- mice</p><p>Ang II-infused Apoe -/- mice</p><p>Ang II-infused and TG&#x003b2;-neutralized C57BL/6 mice</p></td><td align="left"><p>[<xref ref-type="bibr" rid="CR74">74</xref>]</p><p>[<xref ref-type="bibr" rid="CR75">75</xref>]</p><p>[<xref ref-type="bibr" rid="CR66">66</xref>]</p><p>[<xref ref-type="bibr" rid="CR76">76</xref>]</p><p>[<xref ref-type="bibr" rid="CR77">77</xref>]</p><p>[<xref ref-type="bibr" rid="CR78">78</xref>]</p><p>[<xref ref-type="bibr" rid="CR79">79</xref>]</p></td></tr><tr><td align="left">MPI</td><td align="left">MNPs</td><td align="left">Ferucarbotran</td><td align="left">Macrophages</td><td align="left">Ang II-infused Apoe -/- mice</td><td align="left">[<xref ref-type="bibr" rid="CR80">80</xref>]</td></tr></tbody></table><table-wrap-foot><p><italic>MBs</italic> microbubbles, <italic>EL-GNP</italic> anti-elastin antibody conjugated gold nanoparticles, <italic>EL-AuNPs</italic> elastin-targeting gold nanoparticles, <italic>18 F-CLIO</italic> dextran-coated cross linked-iron oxide nanoparticles labeled with fluorine-18, <italic>(18)F-FDG</italic> (18)F-fludeoxyglucose, <italic>IONPs</italic> iron oxide nanoparticles, <italic>USPIO</italic> ultrasmall superparamagnetic iron oxide nanoparticles, <italic>Fe/IONPs</italic> Fe/iron oxide nanoparticles, <italic>RGD-HFn-Fe</italic><sub><italic>3</italic></sub><italic>O</italic><sub><italic>4</italic></sub> Arg-Gly-Asp (RGD)-conjugated human ferritin (HFn) iron oxide nanoparticles, <italic>USPIO-FUCO</italic> USPIOs coated with fucoidan, <italic>SPION</italic> superparamagnetic iron oxide, <italic>CNA-35</italic> collagen-binding protein, <italic>MPI</italic> magnetic particle imaging, <italic>MNPs</italic> magnetic nanoparticles</p></table-wrap-foot></table-wrap></p><sec id="Sec8"><title>USMI </title><p id="Par20">Color doppler ultrasound has emerged as an indispensable imaging modality for post-EVAR surveillance, offering distinct advantages including real-time hemodynamic assessment, absence of ionizing radiation, and excellent cost-effectiveness [<xref ref-type="bibr" rid="CR81">81</xref>&#x02013;<xref ref-type="bibr" rid="CR83">83</xref>]. Its unique capability for dynamic flow visualization provides critical insights into endoleak detection and AAA hemodynamics [<xref ref-type="bibr" rid="CR84">84</xref>, <xref ref-type="bibr" rid="CR85">85</xref>]. The advent of ultrasound molecular imaging (USMI) represents a significant technological advancement, enabling cellular and molecular-level characterization through targeted contrast agents [<xref ref-type="bibr" rid="CR86">86</xref>, <xref ref-type="bibr" rid="CR87">87</xref>].</p><p id="Par21">Microbubble-based contrast agents serve as the cornerstone of USMI technology. These gas-filled spheres (1&#x02013;10 &#x003bc;m diameter) are surface-functionalized with ligands targeting specific molecular markers of AAA pathogenesis, such as vascular endothelial growth factor receptor-2 (VEGFR-2) for angiogenesis assessment [<xref ref-type="bibr" rid="CR67">67</xref>, <xref ref-type="bibr" rid="CR88">88</xref>&#x02013;<xref ref-type="bibr" rid="CR90">90</xref>]. Huang et al. demonstrated the clinical potential of this approach, showing a strong correlation between VEGFR-2-targeted microbubble signals and AAA progression in murine models [<xref ref-type="bibr" rid="CR67">67</xref>]. Beyond diagnostic applications, USMI facilitates targeted therapeutic delivery. A patient-specific in silico study based on ligand-receptor binding indicated that drug-loaded microbubbles can be precisely localized to AAA lesions through ultrasound-mediated cavitation, enhancing drug deposition while minimizing systemic exposure [<xref ref-type="bibr" rid="CR68">68</xref>]. This dual diagnostic-therapeutic capability positions USMI as a promising theranostic platform for comprehensive AAA management.</p></sec><sec id="Sec9"><title>X-ray/CT </title><p id="Par22">X-ray-based CTA utilizing iodine contrast agents remains the clinical gold standard for AAA diagnosis due to its non-invasive nature and excellent spatial resolution. While conventional iodine-based contrast agents have limitations in sensitivity compared to other imaging methods such as MRI and PET [<xref ref-type="bibr" rid="CR91">91</xref>], gold nanoparticles (AuNPs) have emerged as superior alternatives owing to their higher X-ray attenuation coefficient and prolonged vascular enhancement lasting up to 24 h post-administration [<xref ref-type="bibr" rid="CR91">91</xref>, <xref ref-type="bibr" rid="CR92">92</xref>]. Their biocompatibility, synthetic versatility, and capacity for surface modification further enhance their diagnostic utility [<xref ref-type="bibr" rid="CR92">92</xref>].</p><p id="Par23">Preclinical studies using elastin-targeted AuNPs (EL-AuNPs) in murine AAA models have demonstrated remarkable specificity for damaged vascular elastin, with micro-CT signal intensity showing strong correlation with both biomechanical rupture risk and the degree of elastin degradation [<xref ref-type="bibr" rid="CR69">69</xref>, <xref ref-type="bibr" rid="CR71">71</xref>]. These findings highlight the potential of AuNP-enhanced CT not only for improved AAA detection but also for rupture risk stratification. Although currently limited to animal studies, these results suggest significant translational potential for clinical AAA imaging applications.</p></sec><sec id="Sec10"><title>PET-CT</title><p id="Par24">PET-CT integrates the functional metabolic imaging of positron emission tomography (PET) with CT&#x02019;s anatomical precision, serving as a valuable tool for assessing inflammatory activity, metabolic status, and rupture risk in AAA [<xref ref-type="bibr" rid="CR73">73</xref>, <xref ref-type="bibr" rid="CR93">93</xref>, <xref ref-type="bibr" rid="CR94">94</xref>]. Currently, several molecular tracers have been employed in preclinical studies of AAA and have subsequently been translated into clinical research. For example, the copper-64-based radiotracer [&#x02076;&#x02074;Cu] Cu-DOTA-ECL1i, which targets C&#x02013;C chemokine receptor type 2 (CCR2), has been validated using PET/CT imaging in both rat models and human trials as a therapeutic biomarker for AAA. This tracer facilitates the assessment of vascular wall stability and shows potential for predicting aneurysm rupture [<xref ref-type="bibr" rid="CR95">95</xref>, <xref ref-type="bibr" rid="CR96">96</xref>]. Furthermore, the gadolinium-68-labelled fibroblast activation protein inhibitor (FAPI) &#x02076;&#x02078;Ga-FAPI-04 enables visualization of FAP expression via PET, thereby allowing non-invasive monitoring of ECM remodeling throughout AAA progression [<xref ref-type="bibr" rid="CR97">97</xref>]. In addition, the widely used 18 F-fluorodeoxyglucose (18 F-FDG) tracer accumulates in inflammatory cells (e.g., macrophages), enabling visualization of arterial wall inflammation. While increased 18 F-FDG uptake correlates with AAA expansion and rupture risk in some studies [<xref ref-type="bibr" rid="CR98">98</xref>&#x02013;<xref ref-type="bibr" rid="CR102">102</xref>], its clinical utility remains debated due to inconsistent correlations with aortic size and limited sensitivity for early-stage disease [<xref ref-type="bibr" rid="CR103">103</xref>&#x02013;<xref ref-type="bibr" rid="CR105">105</xref>]. These limitations highlight the need for improved PET tracers with enhanced specificity.</p><p id="Par25">Nanotechnology offers promising solutions to overcome these challenges. NP-based PET tracers demonstrate superior targeting capabilities, as evidenced by 18 F-FDG-labeled NPs that specifically accumulate in AAA-associated macrophages within murine models, providing a quantitative assessment of inflammatory activity [<xref ref-type="bibr" rid="CR72">72</xref>, <xref ref-type="bibr" rid="CR106">106</xref>&#x02013;<xref ref-type="bibr" rid="CR108">108</xref>]. Additionally, studies have compared the clinical applications of combined 18 F-FDG PET-CT and ultrasmall superparamagnetic particles of iron oxide (USPIO)-enhanced MRI for evaluating vascular wall inflammation in AAA. The results demonstrated that both 18 F-FDG PET-CT and USPIO-MRI uptake can identify vascular inflammation associated with AAA. However, due to differences in the patterns and distribution of macrophage uptake of 18 F-FDG and USPIO, the two modalities only showed a moderate correlation, which is attributed to variations in macrophage glycolytic and phagocytic activities [<xref ref-type="bibr" rid="CR73">73</xref>]. Despite these advances, most studies remain preclinical, underscoring the need for further development of targeted NPs to improve early AAA detection and risk stratification.</p></sec><sec id="Sec11"><title>MRI</title><p id="Par26">MRI offers distinct advantages for AAA evaluation, including excellent soft tissue contrast, absence of ionizing radiation, and avoidance of nephrotoxic contrast agents. While not yet widely adopted for routine AAA diagnosis, MRI has gained research interest through the development of iron oxide nanoparticle (IONP)-based contrast agents, particularly superparamagnetic (SPIO, 50&#x02013;180 nm) and USPIO (10&#x02013;50 nm) particles [<xref ref-type="bibr" rid="CR77">77</xref>, <xref ref-type="bibr" rid="CR79">79</xref>]. These agents enable targeted imaging of key AAA pathological components, including VSMCs [<xref ref-type="bibr" rid="CR109">109</xref>], macrophages [<xref ref-type="bibr" rid="CR77">77</xref>], collagens [<xref ref-type="bibr" rid="CR79">79</xref>], and MMPs [<xref ref-type="bibr" rid="CR75">75</xref>] (Fig. <xref rid="Fig3" ref-type="fig">3</xref>).</p><p id="Par27">
<fig id="Fig3"><label>Fig. 3</label><caption><p>Schematic diagram of the application of IONPs in AAA MRI. The figure has been created using Biorender</p></caption><graphic xlink:href="12951_2025_3734_Fig3_HTML" id="MO33"/></fig>
</p><p id="Par28">The molecular imaging of AAA pathophysiology provides clinically valuable insights, particularly regarding inflammatory processes. Macrophage infiltration plays a pivotal role in AAA progression, making it an important target for IONP-based imaging. These NPs induce T2/T2* shortening effects, producing characteristic hypointense signals on T2-weighted MRI that correspond to areas of macrophage accumulation. Animal experimental evidence from Turner et al. demonstrates this principle effectively [<xref ref-type="bibr" rid="CR77">77</xref>]. Clinical translation of this approach has shown similar promise, with USPIO-enhanced MRI successfully identifying AAA patients exhibiting more rapid aneurysmal growth based on inflammatory cell accumulation patterns [<xref ref-type="bibr" rid="CR74">74</xref>, <xref ref-type="bibr" rid="CR110">110</xref>, <xref ref-type="bibr" rid="CR111">111</xref>]. These collective findings underscore the diagnostic potential of USPIO for risk stratification through noninvasive visualization of vascular inflammation.</p><p id="Par29">Beyond inflammation imaging, targeted IONPs enable visualization of other critical AAA features. NP-enhanced imaging enables multifaceted AAA evaluation: collagen-binding protein (CNA-35)-functionalized paramagnetic micelles localize type I collagen deposition [<xref ref-type="bibr" rid="CR79">79</xref>], MMP-cleavable nanoprobes visualize protease activity [<xref ref-type="bibr" rid="CR75">75</xref>], and fucoidan-conjugated USPIOs detect mural thrombi [<xref ref-type="bibr" rid="CR76">76</xref>]. While IONP-enhanced MRI shows promise in preclinical and limited clinical studies [<xref ref-type="bibr" rid="CR76">76</xref>, <xref ref-type="bibr" rid="CR79">79</xref>, <xref ref-type="bibr" rid="CR112">112</xref>], including potentially superior endoleak detection compared to CT post-EVAR [<xref ref-type="bibr" rid="CR112">112</xref>], broader clinical adoption awaits larger validation trials to establish its role in AAA diagnosis and rupture risk assessment.</p></sec><sec id="Sec12"><title>MPI</title><p id="Par30"> Magnetic particle imaging (MPI), first described by Gleich and Weizenecker in 2005 [<xref ref-type="bibr" rid="CR113">113</xref>], represents a novel tomographic modality that directly detects magnetic nanoparticles (MNPs) with exceptional sensitivity. Unlike MRI, where MNPs create signal voids, MPI generates positive contrast specifically from MNP tracers, unaffected by surrounding tissues. With millimeter-scale spatial resolution comparable to PET/CT and superior temporal resolution using non-radioactive tracers, MPI shows particular promise for vascular imaging applications.</p><p id="Par31">MPI effectively assesses AAA inflammation. In murine AAA specimens&#x02019; studies, ferucarbotran (an MPI tracer) showed iron deposits matching CD68 + macrophage markers [<xref ref-type="bibr" rid="CR80">80</xref>]. Wang et al. improved specificity using Ly6G-targeted nanoparticles (PEG-Fe<sub>3</sub>O<sub>4</sub>-Ly6G-Cy7 NPs), which combined MPI and fluorescence to track neutrophils and NETs. Signal reductions after NETs inhibition correlated with better aortic outcomes (Fig. <xref rid="Fig4" ref-type="fig">4</xref>) [<xref ref-type="bibr" rid="CR114">114</xref>], proving MPI&#x02019;s utility for monitoring inflammatory cells in AAA.<fig id="Fig4"><label>Fig. 4</label><caption><p>Targeted nanoprobes PEG&#x02013;Fe<sub>3</sub>O<sub>4</sub>&#x02013;Ly6G&#x02013;Cy7 (Ly6G NPs) were synthesized by coupling Ly6G antibody with Fe<sub>3</sub>O<sub>4</sub>@PEG&#x02013;COOH and Cy7&#x02013;NHS. Ly6G NPs were injected into AAA mice via the tail vein and specifically bound to neutrophils infiltrated in diseased vessels. AAA was functionally imaged in vivo by MPI/FLI/CT imaging. Reproduced with permission from Wang et al. [<xref ref-type="bibr" rid="CR114">114</xref>]. Copyright 2024, Springer Nature</p></caption><graphic xlink:href="12951_2025_3734_Fig4_HTML" id="MO5"/></fig></p></sec><sec id="Sec13"><title>Multimodal imaging</title><p id="Par32"> Multimodal imaging approaches that integrate anatomical (CT/MRI) and functional/molecular (PET) data offer enhanced characterization of AAA pathophysiology [<xref ref-type="bibr" rid="CR115">115</xref>]. NPs-enhanced multimodal strategies demonstrate particular promise, as evidenced by: (1) combined 18 F-FDG PET/SPION MRI enabling inflammation mapping in asymptomatic AAA patients [<xref ref-type="bibr" rid="CR73">73</xref>]; (2) SPION-MRI/CTA fusion revealing patient-specific inflammatory patterns predictive of rupture risk [<xref ref-type="bibr" rid="CR111">111</xref>]; and (3) integrated SPION-MRI/bioluminescence (BLI) imaging quantifying macrophage infiltration in aneurysmal versus normal aortic segments [<xref ref-type="bibr" rid="CR116">116</xref>].</p><p id="Par33">These advances underscore the critical role of nanotechnology in driving imaging innovation for AAA. As nanobiotechnology evolve, they will continue to enable more precise molecular characterization of AAA through both multimodal and targeted single-modality approaches, ultimately improving diagnostic accuracy and risk stratification.</p></sec></sec><sec id="Sec14"><title>Strategies for NPs in AAA treatment</title><p id="Par34">The clinical management of AAA depends on factors like size, location, morphology, and growth rate. While EVAR and open surgery are primary treatments [<xref ref-type="bibr" rid="CR117">117</xref>], gaps exist for patients with small AAAs needing surveillance, post-EVAR monitoring, or those unfit for surgery. Advances in understanding AAA pathophysiology have led to new molecular targets and drug therapies to slow progression. NP-based delivery systems are particularly promising, providing precise targeting, better drug delivery, and combined diagnostic-therapeutic functions [<xref ref-type="bibr" rid="CR5">5</xref>, <xref ref-type="bibr" rid="CR118">118</xref>], making them a transformative approach for AAA drug therapy.</p><sec id="Sec15"><title>Targeted drug delivery system</title><p id="Par35">The pathogenesis of AAA involves multiple pathological processes, including inflammatory cell infiltration, neovascularization, and excessive production/activation of proteases and cytokines. As shown in Fig. <xref rid="Fig5" ref-type="fig">5</xref>, based on these mechanisms, recent advances in nano-drug delivery systems with targeted therapeutic capabilities have demonstrated significant potential for AAA treatment.<fig id="Fig5"><label>Fig. 5</label><caption><p>Schematic diagram of nano-drug delivery system applications in AAA therapy. The figure has been created using Biorender</p></caption><graphic xlink:href="12951_2025_3734_Fig5_HTML" id="MO6"/></fig></p><p id="Par36">The evolution of nanotechnology has enabled precise drug targeting and controlled release strategies to address key aspects of AAA pathophysiology. Current investigations focus particularly on modulating inflammatory responses and immune microenvironment regulation through engineered nanomaterials, aiming to restore vascular homeostasis. As comprehensively documented in Table <xref rid="Tab2" ref-type="table">2</xref>, these targeted nanotherapeutic approaches demonstrate substantial potential for clinical translation. The accumulating body of research in this domain is establishing innovative treatment paradigms that may revolutionize AAA management, providing new avenues for both preventive measures and disease progression control in clinical settings.<table-wrap id="Tab2"><label>Table 2</label><caption><p>The applications of targeted drug delivery NPs in AAA treatment</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"><bold>NPs</bold></th><th align="left"><bold>Drugs</bold></th><th align="left"><bold>Targets</bold></th><th align="left"><bold>Molecular mechanism</bold></th><th align="left"><bold>Refs.</bold></th></tr></thead><tbody><tr><td align="left">OxbCD</td><td align="left">RAP</td><td align="left">Macrophage</td><td align="left">Response to the inflammatory microenvironment of AAA</td><td align="left">[<xref ref-type="bibr" rid="CR119">119</xref>]</td></tr><tr><td align="left">EVMS@R-HNC</td><td align="left">EVMS</td><td align="left">Macrophage and SMCs</td><td align="left">Inhibit inflammatory responses and improve the microenvironment of AAA</td><td align="left">[<xref ref-type="bibr" rid="CR33">33</xref>]</td></tr><tr><td align="left">RAP@PFB</td><td align="left">RAP</td><td align="left">Macrophage and SMCs</td><td align="left">Inhibits inflammation and stabilizes ECM</td><td align="left">[<xref ref-type="bibr" rid="CR120">120</xref>]</td></tr><tr><td align="left">Tgt-NP-Met</td><td align="left">Met</td><td align="left">Macrophage and SMC</td><td align="left">Inhibiting the phenotypic switch of SMCs</td><td align="left">[<xref ref-type="bibr" rid="CR121">121</xref>]</td></tr><tr><td align="left">miRNA-PEG-HSA</td><td align="left">microRNA (miR)&#x02212;223</td><td align="left">Macrophage</td><td align="left">Modulating macrophages polarization</td><td align="left">[<xref ref-type="bibr" rid="CR122">122</xref>]</td></tr><tr><td align="left">MMSN</td><td align="left">IL-1Ra</td><td align="left">Macrophage</td><td align="left">Modulating macrophages polarization</td><td align="left">[<xref ref-type="bibr" rid="CR123">123</xref>]</td></tr><tr><td align="left">EL-NP-BB94</td><td align="left">Batimastat (BB-94)</td><td align="left">Macrophage and SMCs</td><td align="left">Inhibited MMP activity, elastin degradation, and calcification</td><td align="left">[<xref ref-type="bibr" rid="CR124">124</xref>]</td></tr><tr><td align="left">NLC@CAG</td><td align="left">CAG and DOX</td><td align="left">Macrophage</td><td align="left">Alleviate aortic injury</td><td align="left">[<xref ref-type="bibr" rid="CR32">32</xref>]</td></tr><tr><td align="left">PLGA-NPs</td><td align="left">Pitavastatin</td><td align="left">macrophage</td><td align="left">Reduced macrophage accumulation and MCP-1 expression</td><td align="left">[<xref ref-type="bibr" rid="CR125">125</xref>]</td></tr><tr><td align="left">PEG-PLys</td><td align="left">Pitavastatin</td><td align="left">macrophage</td><td align="left">Eliminate macrophages and inhibit MMP-9</td><td align="left">[<xref ref-type="bibr" rid="CR126">126</xref>]</td></tr><tr><td align="left">PLGA</td><td align="left">PGG</td><td align="left">Macrophage and SMCs</td><td align="left">Reduce ROS and MMP generation, enhance the stability of ECM</td><td align="left">[<xref ref-type="bibr" rid="CR127">127</xref>]</td></tr><tr><td align="left">PGG-NPs</td><td align="left">PGG</td><td align="left"><p>Macrophage</p><p>And T cells</p></td><td align="left">Ameliorating inflammation and restoring arterial homeostasis</td><td align="left">[<xref ref-type="bibr" rid="CR128">128</xref>]</td></tr></tbody></table><table-wrap-foot><p><italic>OxbCD</italic> Oxidation-responsive &#x003b2;-cyclodextrin, <italic>RAP</italic> Rapamycin, <italic>EVMS</italic> Everolimus, <italic>CAG</italic> Cycloastragenol, <italic>NLC</italic> Nanostructured lipid carrier, <italic>Tgt-NP-Met</italic> Metformin-loaded netrin-1, <italic>miRNA-PEG-HSA</italic> microRNA-Polyethylene Glycol-human serum albumin, <italic>IL-1Ra</italic> Interleukin-1 receptor antagonist, <italic>MMSN</italic> Manganese-doped mesoporous silica nanoparticles, <italic>EL-NP-BB94</italic> Elastin antibody-conjugated BB-94, <italic>PLGA-NPs</italic> Poly(lactic-co-glycolic acid) polymers nanoparticles, <italic>MCP-1</italic> Monocyte Chemoattractant Protein-1, <italic>PEG-Plys</italic> Poly(ethylene glycol)-<italic>b</italic>-poly(l-lysine),<italic> PGG-NPs</italic> Pentagalloyl glucose nanoparticles</p></table-wrap-foot></table-wrap></p><sec id="Sec16"><title>Controlled release of anti-inflammatory drugs</title><p id="Par37">Inflammatory mechanisms are central to AAA disease development and clinical presentation [<xref ref-type="bibr" rid="CR44">44</xref>]. Therefore, anti-inflammatory strategies have become a primary focus for controlling AAA progression. mTOR, a PI3K-associated serine/threonine kinase, plays a pivotal role in regulating cellular proliferation and metabolic responses to nutrient status. This signaling pathway is critically involved in maintaining cellular equilibrium and has been linked to various disease processes, including inflammation, metabolic dysregulation, and oncogenesis [<xref ref-type="bibr" rid="CR129">129</xref>, <xref ref-type="bibr" rid="CR130">130</xref>]. While rapamycin (RAP) shows promise as an mTOR inhibitor for AAA treatment, its clinical application is constrained by significant side effects such as immune suppression and lipid metabolism disturbances. These limitations highlight the urgent requirement for innovative delivery systems that can improve RAPs&#x02019; therapeutic index by enhancing its targeted delivery while reducing systemic toxicity: a crucial unmet need in AAA drug development.</p><p id="Par38">NPs-encapsulated RAP has demonstrated superior efficacy over free drug administration in experimental AAA models, effectively inhibiting elastase-induced aneurysm formation while suppressing MMP activity and proinflammatory cytokine release [<xref ref-type="bibr" rid="CR131">131</xref>]. Nanocarrier advancements have led to ROS-responsive NPs that selectively release RAP in AAA&#x02019;s oxidative microenvironment, reducing aortic dilation safely [<xref ref-type="bibr" rid="CR119">119</xref>]. Mo et al. identified integrin &#x003b1;v&#x003b2;3 as a shared marker on M1 macrophages and dysfunctional VSMCs [<xref ref-type="bibr" rid="CR33">33</xref>], enabling the development of EVMS@R-HNC. This targeted therapy combines: (1) an everolimus core, (2) HBV capsid encapsulation, and (3) RGD peptides for integrin &#x003b1;v&#x003b2;3 targeting, achieving dual cell-specific delivery to reduce inflammation and restore VSMC function (Fig. <xref rid="Fig6" ref-type="fig">6</xref>), advancing AAA nanomedicine. In addition, Zu et al. developed RAP@PFB, a pioneering nanodrug delivery system combining RAP and antioxidant Penta-galloyl glucose (PGG) for AAA treatment [<xref ref-type="bibr" rid="CR120">120</xref>]. It scavenges ROS, inhibits mTOR, and modulates macrophages and VSMCs, promoting M1-to-M2 polarization, reducing apoptosis and calcification, and preserving ECM. Targeted AAA delivery inhibited progression in preclinical models [<xref ref-type="bibr" rid="CR120">120</xref>].<fig id="Fig6"><label>Fig. 6</label><caption><p>Design strategy and the fabrication process of EVMS@R-HNC and its therapeutic effects on abdominal aortic aneurysm. The utilization of single-cell data in guiding the selection of a therapeutic drug (Everolimus, EVMS) and the design of a targeting peptide (RGD). By incorporating a hepatitis B virus core protein monomer with an RGD peptide modification and integrating the therapeutic drug EVMS through self-assembly, the EVMS@R-HNC construct is formulated. EVMS@R-HNC specifically targets and facilitates the conversion of pro-inflammatory M1-like macrophages into anti-inflammatory M2-like macrophages, thereby suppressing the secretion of pro-inflammatory cytokines and ameliorating the inflammatory microenvironment. In addition, EVMS@R-HNC promotes the transition of synthetic smooth muscle cells into contractile ones. RBC, red blood cell. SMC, smooth muscle cell. Reproduced with permission from Wang et al. [<xref ref-type="bibr" rid="CR33">33</xref>]. Copyright 2024, John Wiley and Sons</p></caption><graphic xlink:href="12951_2025_3734_Fig6_HTML" id="MO7"/></fig></p><p id="Par39">Metformin, a widely used antidiabetic drug, has gained attention for its diverse therapeutic effects beyond glycemic control, with preclinical studies supporting its potential in cardiovascular and oncological applications [<xref ref-type="bibr" rid="CR132">132</xref>]. Recognizing these pleiotropic properties, researchers have explored its utility in AAA treatment. Zhang et al. developed netrin-1-targeted NPs (Tgt-NP-Met) for precise metformin delivery to AAA lesions. The system enhanced local accumulation, reducing macrophage inflammation and pathological VSMC transformation, attenuating AAA progression [<xref ref-type="bibr" rid="CR121">121</xref>]. Emerging nanotherapeutics are revolutionizing AAA treatment through precise modulation of inflammatory pathways. NP-delivered microRNA-223 (miR-223) effectively controls macrophage polarization and suppresses NLRP3 inflammasome activation, significantly inhibiting aneurysm formation [<xref ref-type="bibr" rid="CR122">122</xref>]. Similarly, manganese-doped mesoporous silica nanoparticles (MMSNs) carrying interleukin-1 receptor antagonist (IL-1Ra@MMSNs) specifically target macrophage-driven aortic inflammation [<xref ref-type="bibr" rid="CR123">123</xref>]. These advanced systems simultaneously preserve aortic wall structure and convert pro-inflammatory microenvironments to anti-inflammatory states, effectively preventing both AAA initiation and progression (Fig. <xref rid="Fig7" ref-type="fig">7</xref>). Such developments highlight how inflammation-targeting NPs are setting new benchmarks for AAA therapy.<fig id="Fig7"><label>Fig. 7</label><caption><p>Schematic illustration of the mechanism of the IL-1Ra@MMSN NPs for AAA treatment. Reproduced with permission from Wu et al. [<xref ref-type="bibr" rid="CR123">123</xref>]. Copyright 2025, Elsevier</p></caption><graphic xlink:href="12951_2025_3734_Fig7_HTML" id="MO8"/></fig></p></sec><sec id="Sec17"><title>Restoring arterial homeostasis</title><p id="Par40">AAA progression also hinges on compromised aortic wall integrity and disrupted elastic homeostasis, driven by MMP-mediated ECM degradation [<xref ref-type="bibr" rid="CR133">133</xref>]. While systemic MMP inhibitors show promise in animal models, their clinical use is limited by toxicity and poor biodistribution. Nanotechnology offers a solution through targeted delivery systems, such as elastin antibody-conjugated NPs loaded with the MMP inhibitor batimastat. These NPs achieve precise aneurysmal localization and controlled drug release, effectively suppressing local MMP activity and aortic expansion at reduced doses and administration frequency compared to systemic therapy [<xref ref-type="bibr" rid="CR124">124</xref>]. Importantly, this approach minimizes systemic exposure and adverse effects, establishing NP-mediated MMP inhibitor delivery as a promising clinical strategy that combines enhanced efficacy with improved safety for AAA treatment.</p><p id="Par41">Despite demonstrating anti-MMP efficacy in preclinical AAA models [134], DOX has failed to show clinical benefits in human trials, with no measurable impact on aneurysm progression or surgical requirements [<xref ref-type="bibr" rid="CR135">135</xref> &#x02212; <xref ref-type="bibr" rid="CR137">137</xref>]. This discrepancy has prompted investigations into alternative delivery methods. Chen et al. developed an innovative extravascular hydrogel patch incorporating DOX with cycloastragenol-loaded nanocarriers, which enhanced localized drug delivery and protected against elastase-induced AAA damage in animal studies [<xref ref-type="bibr" rid="CR32">32</xref>]. These contrasting results highlight the need for a deeper understanding of DOX&#x02019;s vascular actions and refined delivery approaches to potentially unlock its therapeutic value for AAA management.</p><p id="Par42">Statins, a mainstay in cardiovascular therapy, are recognized for reducing cardiovascular events and slowing AS progression. While their cardioprotective mechanisms are well-established, their potential benefits in AAA remain less understood. Evidence suggests statins may mitigate AAA progression through pleiotropic effects, including inflammation suppression, oxidative stress reduction, and ECM protection [<xref ref-type="bibr" rid="CR133">133</xref>, <xref ref-type="bibr" rid="CR138">138</xref>]. Clinical data present mixed results: a nationwide cohort study found preoperative statin use showed no perioperative survival benefit, while postoperative therapy significantly improved long-term outcomes [<xref ref-type="bibr" rid="CR139">139</xref>]. These findings, based on oral administration, prompted an investigation of targeted delivery approaches. Preclinical studies demonstrate that NP-encapsulated pitavastatin effectively inhibits AAA formation in mice by reducing macrophage infiltration and matrix degradation [<xref ref-type="bibr" rid="CR125">125</xref>]. Additional research confirms that polymeric micelle-incorporated pitavastatin limits aneurysm expansion through combined macrophage depletion and MMP-9 inhibition [<xref ref-type="bibr" rid="CR126">126</xref>].</p><p id="Par43">PGG, a natural polyphenol with established vascular protective properties, has emerged as a promising candidate for AAA treatment. Arnold et al. developed PGG-loaded poly/lactic-co-glycolic acid (PLGA) NPs, showing both free and encapsulated PGG reduced oxidative stress, inhibited MMP-2, and restored vascular elasticity [<xref ref-type="bibr" rid="CR127">127</xref>]. Subsequent studies in elastase-, angiotensin II-, and calcium chloride-induced AAA models confirmed that PGG NPs promoted elastic lamina regeneration, maintained fiber integrity, and slowed the aneurysm progression [<xref ref-type="bibr" rid="CR128">128</xref>, <xref ref-type="bibr" rid="CR140">140</xref>, <xref ref-type="bibr" rid="CR141">141</xref>]. These findings collectively demonstrate that NP-mediated PGG delivery offers targeted therapy while preserving vascular elastic function in AAA.</p></sec></sec><sec id="Sec18"><title>Targeted stent-grafts</title><p id="Par44">EVAR has become a cornerstone intervention for AAA treatment in modern clinical practice. While effective in diverting blood flow from the aneurysmal sac, this approach faces persistent challenges, including residual aneurysmal tissue and postoperative complications [<xref ref-type="bibr" rid="CR24">24</xref>, <xref ref-type="bibr" rid="CR26">26</xref>]. Recent technological advancements have drawn inspiration from other vascular specialties, particularly the success of drug-eluting stents and balloons in cardiovascular and peripheral artery disease, which prevent restenosis through localized anti-proliferative drug delivery. This therapeutic concept has spurred the development of innovative nanomaterial-enhanced endovascular scaffolds that integrate structural integrity with controlled pharmacological release (Fig. <xref rid="Fig8" ref-type="fig">8</xref>), potentially addressing current EVAR limitations through sophisticated drug delivery mechanisms.</p><p id="Par45">
<fig id="Fig8"><label>Fig. 8</label><caption><p>Schematic diagram of drug-loaded nanoscaffolds in EVAR treatment of AAA. (<bold>A</bold>) Nano-stents loaded with vancomycin fight against infectious AAA. (<bold>B</bold>) The drug-eluting nanoscaffolds (loaded with statin) improve the long-term efficacy of EVAR by improving the local microenvironment of AAA lesions. The figure has been created using Biorender</p></caption><graphic xlink:href="12951_2025_3734_Fig8_HTML" id="MO9"/></fig></p><p id="Par46">Yoshimura K et al. developed an innovative rechargeable drug delivery system (RDDS) that combines biotin-labelled nanocarriers with neutravidin-conjugated stent grafts for targeted aortic aneurysm therapy [<xref ref-type="bibr" rid="CR142">142</xref>]. This hybrid platform enables stable device fixation and on-demand drug release, serving as a potential adjunct to EVAR for improved long-term outcomes. Moreover, for infectious AAAs where EVAR carries infection risks, Liu et al. created a nanofiber-coated drug-eluting stent that provides sustained, high-concentration antibiotic release directly to the infected site [<xref ref-type="bibr" rid="CR143">143</xref>]. The system demonstrates targeted antimicrobial delivery to the aneurysmal sac and vascular interfaces, effectively containing infection spread while maintaining good biocompatibility. These advances represent promising EVAR adjuncts, though further clinical optimization is needed.</p></sec><sec id="Sec19"><title>Gene therapy vector SiRNA nanocomposite silencing MMP/PARP pathway</title><p id="Par47">Small interfering RNA (siRNA) has emerged as a powerful tool for precise gene silencing with growing clinical potential [<xref ref-type="bibr" rid="CR144">144</xref>], yet its application is constrained by rapid degradation and inefficient cellular internalization. To address these limitations, Wu et al. created a novel delivery system by oxidatively polymerizing epigallocatechin gallate (EGCG) and complexing it with MMP-specific siRNAs [<xref ref-type="bibr" rid="CR36">36</xref>]. In murine AAA models, this platform exhibited: (1) prolonged retention in aneurysmal tissue, (2) specific targeting of macrophages and VSMCs, and (3) marked inhibition of AAA development with an excellent safety profile (Fig. <xref rid="Fig9" ref-type="fig">9</xref>). These findings demonstrate this nanotechnology&#x02019;s potential to overcome existing barriers in vascular siRNA delivery.</p><p id="Par48">
<fig id="Fig9"><label>Fig. 9</label><caption><p>Schematic diagram of tea polyphenol NPs targeted siRNA delivery and multi-biological activity for the treatment of AAA. Reproduced with permission from Wu et al. [<xref ref-type="bibr" rid="CR36">36</xref>]. Copyright 2024, BMC</p></caption><graphic xlink:href="12951_2025_3734_Fig9_HTML" id="MO10"/></fig></p><p id="Par49">The NF-&#x003ba;B pathway, a master regulator of inflammation, offers a promising target for slowing AAA progression and preventing rupture. Yan et al. engineered an amphiphilic peptide (p5RHH)-based nanocomplex carrying p50-targeting siRNA to precisely modulate NF-&#x003ba;B signaling in AAA [<xref ref-type="bibr" rid="CR145">145</xref>]. The treatment effectively suppressed aneurysm growth by reducing leukocyte infiltration, inflammatory cytokines, iNOS expression, and apoptosis. This targeted siRNA approach demonstrates potential for precise AAA intervention, particularly in small aneurysms, by simultaneously addressing multiple pathological mechanisms.</p></sec></sec><sec id="Sec20"><title>Clinical transformation and challenges</title><p id="Par50">While nanomedicine shows promise for AAA diagnosis and treatment in preclinical studies [<xref ref-type="bibr" rid="CR146">146</xref>], several challenges must be overcome for clinical translation. Key hurdles include establishing reliable methods to assess long-term biocompatibility and immune responses using human-relevant AAA models, developing scalable manufacturing processes that consistently produce uniform NPs meeting Good Manufacturing Practice (GMP) standards, and addressing regulatory complexities unique to multifunctional nanocarriers. Successful translation will require coordinated efforts among materials scientists, vascular biologists, and regulatory experts to bridge the gap between laboratory research and clinical application.</p><sec id="Sec21"><title>Biocompatibility and long-term toxicity</title><p id="Par51">Nanomedicines offer promising solutions for AAA theranostics through targeted drug delivery and improved imaging, but their clinical translation requires rigorous safety evaluation. Recent platforms like Mn-UiO-66-NH@HA [<xref ref-type="bibr" rid="CR39">39</xref>], RAP@PFB [<xref ref-type="bibr" rid="CR120">120</xref>], and LaCD NPs [<xref ref-type="bibr" rid="CR37">37</xref>] show excellent site-specific delivery and antioxidant properties [<xref ref-type="bibr" rid="CR147">147</xref>], yet need thorough biological assessment. Key safety concerns include vascular accumulation [<xref ref-type="bibr" rid="CR148">148</xref>], inflammatory responses [<xref ref-type="bibr" rid="CR122">122</xref>], and mitochondrial dysfunction from oxidative stress [<xref ref-type="bibr" rid="CR149">149</xref>]. While surface modifications (e.g., hyaluronic acid coating) enhance blood compatibility [<xref ref-type="bibr" rid="CR39">39</xref>], and IONPs show good thermal safety [<xref ref-type="bibr" rid="CR150">150</xref>], significant gaps remain in understanding long-term biodistribution, clearance mechanisms, and immune effects. The porcine pancreatic elastase (PPE)-induced AAA models reveal Panx1 channels as toxicity markers [<xref ref-type="bibr" rid="CR151">151</xref>], and galactose-coated miR-223 NPs demonstrate safe macrophage modulation [<xref ref-type="bibr" rid="CR122">122</xref>]. The potential chronic inflammation from non-degradable metal NPs highlights the need for better monitoring. Comprehensive safety protocols should integrate ISO standards, multi-organ histology, cytokine analysis, and computational modeling for complete evaluation.</p></sec><sec id="Sec22"><title>Scalable production and quality control</title><p id="Par52">Successful clinical translation of nanomedicine for AAA requires robust manufacturing and strict quality control. Polymeric micelles, liposomes, and inorganic NPs offer advantages in targeted therapy, imaging, and vascular stabilization, but scaling up production demands standardized protocols to ensure batch consistency. Techniques like microfluidic mixing, spray drying, and high-pressure homogenization show promise for controlling NPs size, surface properties, and drug loading during large-scale production [<xref ref-type="bibr" rid="CR152">152</xref>]. Critical quality attributes, including stability, release kinetics, and safety, must be rigorously assessed using advanced methods like dynamic light scattering (DLS), transmission electron microscopy (TEM), and high-performance liquid chromatography (HPLC) [<xref ref-type="bibr" rid="CR153">153</xref>]. GMP compliance is essential for ensuring product safety and reproducibility, with real-time process monitoring helping prevent aggregation [<xref ref-type="bibr" rid="CR154">154</xref>]. Ultimately, aligning scalable manufacturing with stringent quality standards will be key to developing effective nanomedicines for AAA treatment.</p></sec><sec id="Sec23"><title>Disparities between animal models and human pathobiology</title><p id="Par53">Translating nanomedicine for AAA treatment is complicated by discrepancies between animal models and human disease. While current models (Table <xref rid="Tab3" ref-type="table">3</xref>) provide insights into ECM remodeling and inflammation, they often fail to replicate key aspects of human AAA, including chronic progression, cellular diversity, and complex hemodynamics [<xref ref-type="bibr" rid="CR155">155</xref>, <xref ref-type="bibr" rid="CR156">156</xref>]. Human aneurysms exhibit more diverse macrophage profiles, calcification patterns, and thrombus characteristics than animal models [<xref ref-type="bibr" rid="CR155">155</xref>, <xref ref-type="bibr" rid="CR156">156</xref>], significantly affecting NPs biodistribution, targeting, and efficacy. Differences in vascular biology between species, such as endothelial permeability and macrophage activity, can markedly influence drug release profiles [<xref ref-type="bibr" rid="CR157">157</xref>]. Overcoming these limitations will require patient-derived cell models, advanced biomimetic systems, and multi-omics approaches to refine nanocarrier design [<xref ref-type="bibr" rid="CR158">158</xref> &#x02212; <xref ref-type="bibr" rid="CR160">160</xref>].<table-wrap id="Tab3"><label>Table 3</label><caption><p>Preclinical studies of different animal models for the diagnosis and treatment of AAA</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Species</th><th align="left">Models</th><th align="left">Research fields</th><th align="left">Advantages</th><th align="left">Limitations</th><th align="left">Ref.</th></tr></thead><tbody><tr><td align="left">Mouse</td><td align="left"><p>Ang II infused Apoe -/- mice</p><p>The periarterial incubation with papain, PPE or CaCl&#x02082; immersion</p></td><td align="left"><p>Molecular mechanism, and metabolomics analysis</p><p>Drug testing, and hemodynamic studies</p></td><td align="left"><p>Economical, efficient, and simulates hemodynamic mechanisms</p><p>Economical, efficient, and easy to operate</p></td><td align="left"><p>ANG II model is more relevant for dissection than aneurysmal disease</p><p>The model is not stable and is acutely induced by severe chemical or enzymatic insult</p></td><td align="left"><p>[<xref ref-type="bibr" rid="CR161">161</xref>&#x02013;<xref ref-type="bibr" rid="CR164">164</xref>]</p><p>[<xref ref-type="bibr" rid="CR165">165</xref>&#x02013;<xref ref-type="bibr" rid="CR168">168</xref>]</p></td></tr><tr><td align="left">Rat</td><td align="left"><p>Mechanical injury combined with PEE or CaCl&#x02082;</p><p>Hypoperfusion induction model</p></td><td align="left"><p>The formation mechanism of AAA and the therapeutic effects of drugs</p><p>Explore the rupture mechanism of</p><p>AAA</p></td><td align="left"><p>High</p><p>reproducibility and high similarity to human AAA</p><p>It can simulate AAA caused by hemodynamic abnormalities</p></td><td align="left"><p>Self-healing AAA may occur, and multiple drug interventions are required</p><p>The operation is complicated and requires surgical intervention</p></td><td align="left"><p>[<xref ref-type="bibr" rid="CR169">169</xref>&#x02013;<xref ref-type="bibr" rid="CR172">172</xref>]</p><p>[<xref ref-type="bibr" rid="CR173">173</xref>]</p></td></tr><tr><td align="left">Pig</td><td align="left"><p>Pancreatic elastase induction</p><p>The Aachen model of intravascular aneurysms</p></td><td align="left"><p>Suitable for endovascular research</p><p>Testing of endovascular therapeutic devices</p></td><td align="left"><p>The model is closer to human anatomy</p><p>The anatomical structure is suitable for chronic experiments</p></td><td align="left"><p>High cost and time consuming</p><p>The operation is highly complex and requires long-term follow-up</p></td><td align="left"><p>[<xref ref-type="bibr" rid="CR151">151</xref>, <xref ref-type="bibr" rid="CR174">174</xref>, <xref ref-type="bibr" rid="CR175">175</xref>]</p><p>[<xref ref-type="bibr" rid="CR176">176</xref>]</p></td></tr><tr><td align="left">Sheep</td><td align="left">Naturally occurring or chemically induction</td><td align="left">Study on the biocompatibility of vascular repair materials</td><td align="left">Large vessel size, suitable for implant research</td><td align="left">Time-consuming, and atypical pathological features</td><td align="left">[<xref ref-type="bibr" rid="CR177">177</xref>]</td></tr><tr><td align="left">Human</td><td align="left">AAA patients</td><td align="left">Various basic and clinical research</td><td align="left"><p>Clinical trials, high level of</p><p>evidence</p></td><td align="left">The study period is long and requires strict and close follow-up</td><td align="left">[<xref ref-type="bibr" rid="CR26">26</xref>, <xref ref-type="bibr" rid="CR73">73</xref>, <xref ref-type="bibr" rid="CR178">178</xref>]</td></tr></tbody></table></table-wrap></p></sec><sec id="Sec24"><title>Regulatory framework and industrialization pathways</title><p id="Par54">The clinical translation of nanomedicine for AAA demands robust regulatory frameworks and standardized manufacturing processes to ensure safety, efficacy, and scalability. Regulatory agencies like the Food and Drug Administration (FDA), and European Medicines Agency (EMA) have established stringent evaluation criteria for nanopharmaceuticals, emphasizing their unique pharmacokinetics and long-term biological effects. For AAA applications, specific assessments of NPs biodistribution, targeting precision, and vascular safety are essential [<xref ref-type="bibr" rid="CR34">34</xref>, <xref ref-type="bibr" rid="CR39">39</xref>]. Industrial production requires reproducible synthesis methods, GMP-compliant facilities, and rigorous quality control to ensure consistency. Effective translation will depend on close collaboration between academia, industry, and regulators. While advanced polymeric nanocarriers and theranostic systems show clinical potential [<xref ref-type="bibr" rid="CR179">179</xref>], their successful commercialization requires multidisciplinary coordination. Comprehensive cost-effectiveness analyses and post-market surveillance will facilitate adoption, along with international standardization and public-private partnerships to accelerate clinical implementation.</p></sec><sec id="Sec25"><title>Nanobiotech vs. gold standards in AAA management</title><p id="Par55">Currently, the clinical gold standard for AAA treatment includes open surgery and EVAR. However, these interventions are only applicable to larger aneurysms or cases at risk of rupture. While they can reduce perioperative mortality and morbidity, they also carry risks of reintervention and late aneurysm rupture [<xref ref-type="bibr" rid="CR180">180</xref>, <xref ref-type="bibr" rid="CR181">181</xref>]. In contrast, nanobiotechnology offers potential solutions for small-sized AAAs that are unsuitable for surgery or EVAR, enabling early pharmacological intervention. For instance, NPs-based drug delivery systems (e.g., RAP@PFB) provide non-invasive alternatives designed to target AAA progression [<xref ref-type="bibr" rid="CR120">120</xref>]. Additionally, NPs can accumulate at the aneurysm site and modulate inflammatory responses, thereby mitigating pathological worsening [<xref ref-type="bibr" rid="CR37">37</xref>]. Although other emerging technologies, such as microbubble-based strategies using ultrasound-targeted microbubble destruction (UTMD) to enhance targeted drug delivery (e.g., microRNA-125b) to diseased areas, can also improve treatment efficacy, they rely on specialized equipment [<xref ref-type="bibr" rid="CR182">182</xref>].</p><p id="Par56">The application of nanomaterials in AAA therapy shows innovative potential through mechanisms such as inflammation reduction and antioxidant effects, as demonstrated in animal models [<xref ref-type="bibr" rid="CR37">37</xref>, <xref ref-type="bibr" rid="CR147">147</xref>]. However, these approaches remain largely experimental and lack conclusive human evidence demonstrating superiority over current gold-standard interventions, such as surgery or endovascular repair, which rely on aneurysm diameter and rupture risk stratification [<xref ref-type="bibr" rid="CR180">180</xref>, <xref ref-type="bibr" rid="CR181">181</xref>, <xref ref-type="bibr" rid="CR183">183</xref>, <xref ref-type="bibr" rid="CR184">184</xref>]. Moreover, their translatability to diverse patient populations remains uncertain due to variability in genetic background, comorbidities, and immune responses [<xref ref-type="bibr" rid="CR5">5</xref>, <xref ref-type="bibr" rid="CR185">185</xref>, <xref ref-type="bibr" rid="CR186">186</xref>], highlighting the need for long-term clinical validation before nanomaterials can be considered reliable alternatives [<xref ref-type="bibr" rid="CR187">187</xref>]. Furthermore, integrating nanotechnology with existing clinical materials, such as approved drugs, is feasible yet complex. For instance, nano-drug delivery systems (e.g., RAP@PFB) often require new nanocarriers [<xref ref-type="bibr" rid="CR120">120</xref>] and cannot be directly combined with established therapies. Incorporating nanomaterial-based approaches, such as nanoparticle imaging, alongside conventional techniques, also introduces regulatory and safety challenges, underscoring the need for specifically developed nanomaterials rather than repurposing existing agents [<xref ref-type="bibr" rid="CR19">19</xref>, <xref ref-type="bibr" rid="CR188">188</xref>].</p><p id="Par57">Overall, while nanotechnology shows considerable promise, it requires further rigorous clinical investigation to address the existing gaps. In comparison with current clinical gold standards for AAA management, nanotechnological innovations provide more targeted and minimally invasive therapeutic alternatives. Furthermore, they open new avenues for research into the development of safer and more effective contrast agents for use in AAA imaging diagnostics.</p></sec></sec><sec id="Sec26"><title>Future advances and applications</title><p id="Par58">Looking ahead, continued advancements in nanotechnology are poised to revolutionize AAA management. A growing number of NPs-based innovations will collectively lay the foundation for developing smarter, more personalized, and more precise diagnostic and therapeutic systems for AAA.</p><sec id="Sec27"><title>Application of cutting-edge innovative nanotechnology in AAA management</title><p id="Par59">In the future, advancements in biomedicine and nanotechnology will likely synergistically drive progress in AAA management through intelligent responsive nanorobots, 3D/4D bioprinting technologies, and AI-powered nanomedicine. Intelligent nanorobots offer a new AAA treatment approach. They deliver drugs accurately, respond to tissue conditions, and enable real-time imaging (Fig. <xref rid="Fig10" ref-type="fig">10</xref>). Using pH- or enzyme-sensitive materials, they release drugs only at the aneurysm site, enhancing effectiveness and minimising side effects [<xref ref-type="bibr" rid="CR189">189</xref>]. Magnetically guided nanorobots, navigate complex blood vessels, deliver treatment, reduce oxidative stress, and support tissue repair via PI3K/Akt signalling [<xref ref-type="bibr" rid="CR190">190</xref>, <xref ref-type="bibr" rid="CR191">191</xref>]. Some are compatible with MRI for non-invasive monitoring, and recent magnetic microgels demonstrate potential for minimally invasive embolisation [<xref ref-type="bibr" rid="CR191">191</xref>, <xref ref-type="bibr" rid="CR192">192</xref>].</p><p id="Par60">
<fig id="Fig10"><label>Fig. 10</label><caption><p>Schematic of the intelligent responsive nanorobots in the management of AAA. The figure has been created using Biorender</p></caption><graphic xlink:href="12951_2025_3734_Fig10_HTML" id="MO11"/></fig></p><p id="Par61">In terms of improving traditional stent grafts, as summarized in Table <xref rid="Tab4" ref-type="table">4</xref>, 3D bioprinting of nanocomposites now enables patient-specific grafts with precise cellular placement, reducing thrombosis and infection [<xref ref-type="bibr" rid="CR193">193</xref>, <xref ref-type="bibr" rid="CR194">194</xref>]. These show better integration in models than synthetic grafts [<xref ref-type="bibr" rid="CR195">195</xref>, <xref ref-type="bibr" rid="CR196">196</xref>] and allow for hemodynamic testing in printed aneurysms [<xref ref-type="bibr" rid="CR197">197</xref>]. The technology supports sustained drug delivery and improved endothelialization, aiding complex cases. Research now focuses on enhancing durability and compatibility using antiplatelet bioinks [<xref ref-type="bibr" rid="CR151">151</xref>, <xref ref-type="bibr" rid="CR198">198</xref>], while AI-assisted 4D bioprinting enables adaptive designs for aortic remodelling [<xref ref-type="bibr" rid="CR199">199</xref>].<table-wrap id="Tab4"><label>Table 4</label><caption><p>Preclinical application of bioprinted vascular stent grafts in endovascular therapy</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Vascular grafts</th><th align="left">Biomaterials</th><th align="left">Animal model</th><th align="left">Applications and purpose</th><th align="left">Ref.</th></tr></thead><tbody><tr><td align="left">3D printing hybrid vascular graft</td><td align="left">ADSCs and GORE-Tex grafts</td><td align="left">Rhesus monkeys, and miniature pigs</td><td align="left">Solve the problem of endothelialization of the lumen surface after stent implantation</td><td align="left">[<xref ref-type="bibr" rid="CR200">200</xref>]</td></tr><tr><td align="left">3D-bioprinted vessels</td><td align="left">Rat fibroblasts and smooth muscle cells</td><td align="left">Male Sprague-Dawley rats</td><td align="left">Repair the large vessels (such as AAA) in an animal model</td><td align="left">[<xref ref-type="bibr" rid="CR195">195</xref>]</td></tr><tr><td align="left">Drug-targeted stent-graft</td><td align="left">Liposome-based biotinylated drug-loaded NPs, and stent-graft coated with pHEMA</td><td align="left">Mouse model of CaCl<sub>2</sub>-induced aortic inflammation</td><td align="left">Enables targeted repeated drug delivery to lesion sites, and provides a new strategy for continued treatment after EVAR</td><td align="left">[<xref ref-type="bibr" rid="CR142">142</xref>]</td></tr><tr><td align="left">Nanofiber-loaded stent graft</td><td align="left">Poly (D, L)-lactide-co-glycolide and vancomycin</td><td align="left">New Zealand white rabbits</td><td align="left">Achieving localized and sustainable antibiotic delivery to the aneurysm sac and aortic wall of MAA</td><td align="left">[<xref ref-type="bibr" rid="CR143">143</xref>]</td></tr><tr><td align="left">Bi-layered vascular graft</td><td align="left">Poly(&#x0025b;-caprolactone), microfibers, and nanofibers</td><td align="left">Rat abdominal aorta replacement model</td><td align="left">To characterize the long-term results of the bi-layered grafts in rats</td><td align="left">[<xref ref-type="bibr" rid="CR201">201</xref>]</td></tr></tbody></table><table-wrap-foot><p><italic>ADSCs</italic> adipose-derived mesenchymal stromal cells, <italic>pHEMA</italic> biotinylated poly (2-hydroxyethyl methacrylate), <italic>MAA</italic> mycotic aortic aneurysm</p></table-wrap-foot></table-wrap></p><p id="Par62">The convergence of AI and nanotechnology presents groundbreaking opportunities to revolutionize AAA diagnosis and precision therapy. As illustrated in Fig. <xref rid="Fig11" ref-type="fig">11</xref>, contemporary advances in these fields are enabling innovative approaches for aneurysm detection and targeted intervention. AI optimizes nanomedicine by analyzing multi-omics data to predict nanoparticle delivery efficiency, model drug-microenvironment interactions, and enhance CT imaging for AAA early detection and rupture risk prediction [<xref ref-type="bibr" rid="CR184">184</xref>, <xref ref-type="bibr" rid="CR202">202</xref>, <xref ref-type="bibr" rid="CR203">203</xref>]. These advances address key challenges like poor drug bioavailability and nonspecific distribution, paving the way for personalized nanomedicine.</p><p id="Par63">
<fig id="Fig11"><label>Fig. 11</label><caption><p>Schematic diagram of AI-assisted nanomedicine design. The figure has been created using Biorender</p></caption><graphic xlink:href="12951_2025_3734_Fig11_HTML" id="MO12"/></fig>
</p></sec><sec id="Sec29"><title>Potential future developments in NPs-based therapeutics</title><p id="Par64">The future development of NPs-based theragnostic strategies for AAA shows significant promise, as evidenced by current research. NPs offer unique advantages by specifically targeting key pathological features of AAA, such as excessive inflammation and ECM degradation [<xref ref-type="bibr" rid="CR5">5</xref>]. Emerging nanodrug delivery systems like RAP@PFB demonstrate pioneering potential to mitigate AAA progression through targeted therapeutic delivery [<xref ref-type="bibr" rid="CR120">120</xref>]. Nanocatalytic antioxidant strategies further overcome the limitations of conventional antioxidants by establishing sustainable ROS scavenging systems [<xref ref-type="bibr" rid="CR147">147</xref>]. Besides, the &#x0201c;one stone for multiple birds&#x0201d; approach, exemplified by bioactive conjugate nanomicelles, highlights multifunctional strategies capable of simultaneously addressing multiple disease mechanisms [<xref ref-type="bibr" rid="CR187">187</xref>]. More significantly, IONPs are especially promising, as they enable combined chemical, physical, and biological therapies while offering integrated diagnostic functionality, which has great application prospects in MRI imaging of AAA [<xref ref-type="bibr" rid="CR204">204</xref>]. Collectively, these advances indicate a shift toward personalised nano-theranostic approaches that combine precise detection with targeted intervention for improved management of AAA.</p></sec></sec><sec id="Sec30"><title>Limitations</title><p id="Par65">NPs have shown considerable promise in AAA imaging, therapeutic delivery, and stent graft development, yet their translation from preclinical research to clinical use faces multiple challenges stemming from both material limitations and methodological constraints.</p><p id="Par66">Firstly, the production of nanomaterials remains costly and technically demanding, with batch-to-batch consistency and quality control presenting significant hurdles. Many nanomaterials exhibit inherent immunogenicity, potentially triggering adverse immune reactions [<xref ref-type="bibr" rid="CR205">205</xref>], while ultra-small nanoparticles face rapid immune clearance, compromising their therapeutic efficacy. Target-specific modifications using antibodies, though effective in principle, encounter practical limitations including antibody denaturation during nanoparticle conjugation and enzymatic degradation in vivo [<xref ref-type="bibr" rid="CR206">206</xref>]. Secondly, in diagnostic applications, nanoparticle-based contrast agents demonstrate vascular wall accumulation in AAA, with imaging-guided targeting technologies showing particular promise for enhancing lesion specificity [<xref ref-type="bibr" rid="CR34">34</xref>, <xref ref-type="bibr" rid="CR40">40</xref>, <xref ref-type="bibr" rid="CR207">207</xref>]. While SPION-labeled cell therapies exhibit theranostic potential, the development of truly dual-purpose nanomedicines combining treatment and imaging capabilities remains limited in AAA research, requiring further efficacy validation.</p><p id="Par67">In addition, current AAA rodent models, despite providing valuable insights into nanoparticle behavior [<xref ref-type="bibr" rid="CR163">163</xref>, <xref ref-type="bibr" rid="CR176">176</xref>, <xref ref-type="bibr" rid="CR177">177</xref>], fail to fully recapitulate human disease complexity, particularly regarding hemodynamic conditions. Similarly, while nanotech-enhanced vascular grafts show efficacy in rodents [<xref ref-type="bibr" rid="CR142">142</xref>, <xref ref-type="bibr" rid="CR143">143</xref>, <xref ref-type="bibr" rid="CR195">195</xref>], immunological barriers and practical constraints hinder clinical adoption. Furthermore, an emerging consideration is the significant sex-based differences in AAA pathology; women exhibit lower incidence but higher rupture risk [<xref ref-type="bibr" rid="CR208">208</xref>], which current animal models largely ignore. Future preclinical studies should incorporate both sexes when evaluating nanomaterial-based therapies, imaging agents, and bioengineered grafts to better reflect clinical realities.</p></sec><sec id="Sec31"><title>Conclusions and perspectives</title><p id="Par68">Current AAA management remains confined to operative interventions (including open repair and EVAR), primarily for large, rupture-prone aneurysms, leaving patients with small AAAs or those unfit for surgery without viable pharmacological alternatives. Nanotechnology has emerged as a promising solution to this therapeutic impasse. Substantial research demonstrates that drug-loaded NPs offer significant advantages for AAA treatment, including enhanced localized drug delivery with reduced systemic toxicity, along with utility as contrast agents for early diagnosis. Particularly promising are multifunctional NPs that combine targeted therapy with imaging capabilities, potentially enabling integrated AAA theranostics aligned with disease pathophysiology.</p><p id="Par69">In summary, although certain limitations remain to be overcome and further clinical translation faces multiple challenges, we can still anticipate that with continuous innovation in nanotechnology, the maturation of gene-editing technologies, and the integration of precision medicine and AI, engineered nanomedicines will offer increasingly diverse strategies to improve drug targeting, circulation time, and controlled release. This will pave the way for next-generation nanomaterials in AAA therapy. In the future, nanotechnology will expand into new frontiers of AAA management, enabling early warning systems and personalized treatment. Therefore, interdisciplinary collaboration among clinicians, chemists, materials scientists, and regulatory agencies is essential to bridge the gap between laboratory discoveries and patient care, illuminating a path of hope.</p></sec></body><back><fn-group><fn><p><bold>Publisher&#x02019;s note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn><fn><p>Gang Yuan, Weiming Wang and Xiaohui Jia equal contributors and co-first authors.</p></fn></fn-group><ack><title>Acknowledgements</title><p>We thank Dr. Li Liu (School of Foreign Languages, Southwest Medical University) for her English language editing and the grammar assistance.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>G. Y., W.-M. W., X.-H. J., and Y. L. proposed the concept and constructed the framework of the article. Z.-Y. L. and Y.-N. X. searched and collected literatures. R. C. and G.-Y. S. wrote and revised the manuscript. G. Y., W.-M. W., and X.-H. J. drew the figures. All authors reviewed and approved the final manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>This work was supported by Sichuan Provincial Science and Central Guidance Local Exploration Fund Project (2024ZYD0103), and Sichuan Medical Association Youth Innovation Project (Q2024039).</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>No datasets were generated or analysed during the current study.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par70">Not applicable.</p></notes><notes id="FPar2"><title>Consent for publication</title><p id="Par71">Not applicable.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests</title><p id="Par72">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Golledge</surname><given-names>J</given-names></name><name><surname>Thanigaimani<
</xref></contrib><aff id="aff1"><label>1</label><institution content-type="dept">Department of Medical Oncology</institution>, <institution>Puerta de Hierro Majadahonda University Hospital</institution>, <addr-line>Madrid</addr-line>, <country country="es">Spain</country>;</aff><aff id="aff2"><label>2</label><institution content-type="dept">Department of Medical Oncology, Hospital Cl&#x000ed;nico San Carlos</institution>, <institution>Complutense University</institution>, <addr-line>Madrid</addr-line>, <country country="es">Spain</country>;</aff><aff id="aff3"><label>3</label><institution content-type="dept">Department of Medical Oncology, Catalan Institute of Oncology (ICO)</institution>, <institution>Bellvitge Biomedical Research Institute (IDIBELL)</institution>, <addr-line>Bellvitge Healthcare Campus</addr-line>, L&#x02019;Hospitalet de Llobregat (Barcelona), <country country="es">Spain</country>;</aff><aff id="aff4"><label>4</label><institution content-type="dept">Department of Thoracic Surgery</institution>, <institution>San Carlos Clinic Hospital</institution>, <addr-line>Madrid</addr-line>, <country country="es">Spain</country>;</aff><aff id="aff5"><label>5</label><institution content-type="dept">Department of Medical Oncology, Institut Catal&#x000e0; d&#x02019;Oncologia</institution>, <institution>Hospital Universitari Dr. Josep Trueta</institution>, <addr-line>Girona</addr-line>, <country country="es">Spain</country>;</aff><aff id="aff6"><label>6</label><institution content-type="dept">Precision Oncology Group (OncoGIR-Pro)</institution>, <institution>Institut d&#x02019;Investigacions Biom&#x000e8;diques de Girona (IDIBGI-CERCA)</institution>, <addr-line>Girona</addr-line>, <country country="es">Spain</country>;</aff><aff id="aff7"><label>7</label><institution content-type="dept">Department of Thoracic Surgery</institution>, <institution>Dr. Balmis de Alicante University Hospital</institution>, <addr-line>Alicante</addr-line>, <country country="es">Spain</
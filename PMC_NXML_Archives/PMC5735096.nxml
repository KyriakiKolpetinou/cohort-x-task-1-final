-id><pub-id pub-id-type="pmid">17851812</pub-id></element-citation></ref><ref id="CR19"><label>19.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kekre</surname><given-names>AN</given-names></name><name><surname>Vijayanand</surname><given-names>S</given-names></name><name><surname>Dasgupta</surname><given-names>R</given-names></name><name><surname>Kekre</surname><given-names>N</given-names></name></person-group><article-title>Postpartum urinary retention after vaginal delivery</article-title><source>Int. J. Gynaecol. Obstet. Off. Organ Int. Fed. Gynaecol. Obstet.</source><year>2011</year><volume>112</volume><fpage>112</fpage><lpage>115</lpage><pub-id pub-id-type="doi">10.1016/j.ijgo.2010.08.014</pub-id></element-citation></ref><ref id="CR20"><label>20.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Buchanan</surname><given-names>J</given-names></name><name><surname>Beckmann</surname><given-names>M</given-names></name></person-group><article-title>Postpartum voiding dysfunction: identifying the risk factors</article-title><source>Aust. N. Z. J. Obstet. Gynaecol.</source><year>2014</year><volume>54</volume><fpage>41</fpage><lpage>45</lpage><pub-id pub-id-type="doi">10.1111/ajo.12130</pub-id><pub-id pub-id-type="pmid">24111705</pub-id></element-citation></ref><ref id="CR21"><label>21.</label><mixed-citation publication-type="other">Safer, W. H. O. D. of M. P. WHO technical consultation on postpartum and postnatal care. (2010).</mixed-citation></ref><ref id="CR22"><label>22.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Evron</surname><given-names>S</given-names></name><etal/></person-group><article-title>The effect of intermittent versus continuous bladder catheterization on labor duration and postpartum urinary retention and infection: a randomized trial</article-title><source>J. Clin. A
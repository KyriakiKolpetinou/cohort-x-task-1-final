</person-group><article-title>Role of (18)F-FDG PET-CT in head and neck squamous cell carcinoma</article-title><source>Acta Otorhinolaryngol. Ital.</source><year>2013</year><volume>33</volume><fpage>1</fpage><lpage>8</lpage><pub-id pub-id-type="pmid">23620633</pub-id>
</element-citation></ref><ref id="B5-cancers-16-02900"><label>5.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Porceddu</surname><given-names>S.V.</given-names></name>

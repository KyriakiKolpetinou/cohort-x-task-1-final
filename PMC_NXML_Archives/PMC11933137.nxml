</mixed-citation></citation-alternatives></ref><ref id="CR9"><label>9.</label><citation-alternatives><element-citation id="ec-CR9" publication-type="journal"><person-group person-group-type="author"><name><surname>Sajid</surname><given-names>MS</given-names></name><name><surname>Ladwa</surname><given-names>N</given-names></name><name><surname>Kalra</surname><given-names>L</given-names></name><name><surname>Hutson</surname><given-names>K</given-names></name><name><surname>Sains</surname><given-names>P</given-names></name><name><surname>Baig</surname><given-names>MK</given-names></name></person-group><article-title>A meta-analysis examining the use of tacker fixation versus no-fixation of mesh in laparoscopic inguinal hernia repair</article-title><source>Int J Surg</source><year>2012</year><volume>10</volume><fpage>224</fpage><lpage>231</lpage><pub-id pub-id-type="pmid">22449832</pub-id>

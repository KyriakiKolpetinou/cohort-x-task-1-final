</element-citation></ref><ref id="bib17"><label>17</label><element-citation publication-type="journal" id="sbref10"><person-group person-group-type="author"><name><surname>De Robertis</surname><given-names>R.</given-names></name><etal/></person-group><article-title>Liver metastases in pancreatic ductal adenocarcinoma: a predictive model based on CT texture analysis</article-title><source>Radiol. Med.</source><volume>127</volume><issue>10</issue><year>2022</year><fpage>1079</fpage><lpage>1084</lpage><pub-id pub-id-type="doi">10.1007/s11547-022-01548-8</pub-id><pub-id pub-id-type="pmid">36057929</pub-id>

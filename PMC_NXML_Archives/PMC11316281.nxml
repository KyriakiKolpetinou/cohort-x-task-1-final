</td></tr><tr><td align="left" rowspan="3">Side of the Operation</td><td align="left">ACBs</td><td align="left">80</td><td align="left">44 (%55,0)</td><td align="left">36 (%55,0)</td><td align="left" rowspan="3">1,3</td><td align="left" rowspan="3">0,522</td></tr><tr><td align="left">ACBa</td><td align="left">80</td><td align="left">39(%48,8)</td><td align="left">41 (%51,3)</td></tr><tr><td align="left">Control</td><td align="left">80</td><td align="left">37 (%46,3)</td><td align="left">43 (%53,8)</td></tr><tr><td align="left" colspan="3"/><td align="left">
<bold>Women (n %)</bold>

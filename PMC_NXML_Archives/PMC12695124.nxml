="1">0.192</td></tr><tr style="background-color:#E8ECF1"><td align="left" valign="middle" rowspan="1" colspan="1">Diastolic blood pressure (mmHg)</td><td align="center" valign="middle" rowspan="1" colspan="1">90 (90&#x02013;110)</td><td align="center" valign="middle" rowspan="1" colspan="1">90 (90&#x02013;110)</td><td align="center" valign="middle" rowspan="1" colspan="1">0.795</td></tr><tr style="background-color:#E8ECF1"><td align="left" valign="middle" rowspan="1" colspan="1">Birth weight (gram)</td><td align="center" valign="middle" rowspan="1" colspan="1">1,547&#x000b1;543.7</td><td align="center" valign="middle" rowspan="1" colspan="1">2,360&#x000b1;821.5</td><td align="center" valign="middle" rowspan="1" colspan="1">

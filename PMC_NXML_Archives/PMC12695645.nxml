<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Nat Methods</journal-id><journal-id journal-id-type="iso-abbrev">Nat Methods</journal-id><journal-title-group><journal-title>Nature Methods</journal-title></journal-title-group><issn pub-type="ppub">1548-7091</issn><issn pub-type="epub">1548-7105</issn><publisher><publisher-name>Nature Publishing Group US</publisher-name><publisher-loc>New York</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">40859021</article-id><article-id pub-id-type="pmc">12695645</article-id>
<article-id pub-id-type="publisher-id">2784</article-id><article-id pub-id-type="doi">10.1038/s41592-025-02784-2</article-id><article-categories><subj-group subj-group-type="heading"><subject>Resource</subject></subj-group></article-categories><title-group><article-title>Reconstruction of a connectome of single neurons in mouse brains by cross-validating multi-scale multi-modality data</article-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-6927-8903</contrib-id><name><surname>Xiong</surname><given-names>Feng</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-9548-6183</contrib-id><name><surname>Liu</surname><given-names>Lijuan</given-names></name><address><email>lijuan-liu@seu.edu.cn</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" corresp="yes" equal-contrib="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-3478-3942</contrib-id><name><surname>Peng</surname><given-names>Hanchuan</given-names></name><address><email>h@braintell.org</email></address><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/04ct4d772</institution-id><institution-id institution-id-type="GRID">grid.263826.b</institution-id><institution-id institution-id-type="ISNI">0000 0004 1761 0489</institution-id><institution>New Cornerstone Science Laboratory, SEU-ALLEN Joint Center, Institute for Brain and Intelligence, </institution><institution>Southeast University, </institution></institution-wrap>Nanjing, China </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/013q1eq08</institution-id><institution-id institution-id-type="GRID">grid.8547.e</institution-id><institution-id institution-id-type="ISNI">0000 0001 0125 2443</institution-id><institution>New Cornerstone Science Laboratory, Institute for Brain and Intelligence, </institution><institution>Fudan University, </institution></institution-wrap>Shanghai, China </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/013q1eq08</institution-id><institution-id institution-id-type="GRID">grid.8547.e</institution-id><institution-id institution-id-type="ISNI">0000 0001 0125 2443</institution-id><institution>Shanghai Academy of Natural Sciences (SANS), </institution><institution>Fudan University, </institution></institution-wrap>Shanghai, China </aff></contrib-group><pub-date pub-type="epub"><day>26</day><month>8</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>26</day><month>8</month><year>2025</year></pub-date><pub-date pub-type="ppub"><year>2025</year></pub-date><volume>22</volume><issue>12</issue><fpage>2670</fpage><lpage>2683</lpage><history><date date-type="received"><day>3</day><month>6</month><year>2024</year></date><date date-type="accepted"><day>14</day><month>7</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><p id="Par1">Brain networks, or connectomes, have inspired research at macro-, meso- and micro-scales. However, the rise of single-cell technologies necessitates inferring connectomes consisting of individual neurons projecting throughout the brain. Her, we present a scalable approach to map single-neuron connectivity at the whole-brain scale using two complementary methods. We first generated an arbor-net by probabilistically pairing dendritic and axonal arbors of 20,247 neurons registered to the Allen Brain Atlas. We also produced a bouton-net based on 2.57&#x02009;million putative axonal boutons from 1,877 fully reconstructed neurons and probabilistic pairing of these full-morphology datasets. Cross-validation of both networks showed statistical consistency in spatially and anatomically modular distributions of neuronal connections, corresponding to functional modules in the mouse brain. We found that single-neuron connections correlated more strongly with gene coexpression than the full-brain mesoscale connectome. Our network analysis, comparing the connectomes with alternative brain architectures, identified nonrandom subnetwork patterns. Overall, our data indicate rich granularity and strong modular diversity in mouse brain networks.</p></abstract><abstract id="Abs2" abstract-type="web-summary"><p id="Par2">This Resource presents a scalable method to build a connectome from light-microscopy-based reconstructions of mouse neurons and inferred synaptic connections that were derived from the overlap of axonal and dendritic arbors or boutons and dendritic arbors. The inferred connectome has been validated with additional multi-modal datasets.</p></abstract><kwd-group kwd-group-type="npg-subject"><title>Subject terms</title><kwd>Neuroscience</kwd><kwd>Computational biology and bioinformatics</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer Nature America, Inc. 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Main</title><p id="Par3">A connectome<sup><xref ref-type="bibr" rid="CR1">1</xref>&#x02013;<xref ref-type="bibr" rid="CR8">8</xref></sup> is a representation of neuronal connections among involved neurons, neuronal populations and brain regions. Connectomes have been intensively studied at various scales, including the macro-scale<sup><xref ref-type="bibr" rid="CR4">4</xref>,<xref ref-type="bibr" rid="CR5">5</xref></sup>, mesoscale<sup><xref ref-type="bibr" rid="CR8">8</xref>,<xref ref-type="bibr" rid="CR9">9</xref></sup> and microscale<sup><xref ref-type="bibr" rid="CR10">10</xref>&#x02013;<xref ref-type="bibr" rid="CR12">12</xref></sup>. These connections can be derived from structural data such as neuronal morphology<sup><xref ref-type="bibr" rid="CR13">13</xref></sup>, functional data such as physiological recordings<sup><xref ref-type="bibr" rid="CR14">14</xref></sup> or genetic approaches such as DNA barcoding<sup><xref ref-type="bibr" rid="CR15">15</xref></sup>.</p><p id="Par4">Partial representation of these connections compromises the accuracy and significance of connectomes. In practice, different resolutions and approaches for constructing connectomes involve various compromises. For example, while electron microscopy can precisely identify individual synaptic contacts, reconstruction is often limited to small volumes of brain tissue. As a consequence, electron microscopy faces challenges in fully capturing the three-dimensional (3D) morphology and target information of projection neurons, which is needed to uniquely define neuronal identities. Without this information, a microscale connectome constructed using electron microscopy would be insufficient for understanding the wiring patterns and neuron distribution at a brain-wide scale<sup><xref ref-type="bibr" rid="CR16">16</xref></sup>.</p><p id="Par5">With the increasing availability of single-cell neuron morphometry data<sup><xref ref-type="bibr" rid="CR13">13</xref>,<xref ref-type="bibr" rid="CR17">17</xref>&#x02013;<xref ref-type="bibr" rid="CR21">21</xref></sup>, it is desirable to study how to infer brain networks including both local and long-range projections based on the morphology of individual neurons<sup><xref ref-type="bibr" rid="CR22">22</xref></sup>. Progress may be made using data from either a single brain or multiple brains, the latter requiring multiplexing with 3D brain registration techniques but also capable of incorporating multi-modal information<sup><xref ref-type="bibr" rid="CR23">23</xref></sup>. Compared with the mesoscale projectome, which relies on neurite bundles<sup><xref ref-type="bibr" rid="CR8">8</xref></sup>, the increased spatial resolution provided by single neuronal projections is a remarkable advantage, particularly because it enables visualizing the long-range organization of brain networks. These long-range neuronal projection patterns also enhance cell typing<sup><xref ref-type="bibr" rid="CR13">13</xref>,<xref ref-type="bibr" rid="CR24">24</xref></sup>. Previous studies have also shown the feasibility of a data-driven algorithmic strategy to build the complete synaptic connectivity from morphologically reconstructed neurons<sup><xref ref-type="bibr" rid="CR25">25</xref></sup>, and demonstrated the reliability of this statistical connectivity<sup><xref ref-type="bibr" rid="CR26">26</xref></sup>. An example is the digital reconstruction and simulation of neocortical microcircuits by the Blue Brain Project<sup><xref ref-type="bibr" rid="CR27">27</xref></sup>.</p><p id="Par6">Here, we created an arbor-net and a bouton-net by spatially and probabilistically pairing independently generated axonal and dendritic features, all registered to the Allen Brain Atlas (ABA), and cross-validated the resulting connectomes. We then discovered that single neuronal connections correlated more strongly with gene coexpression at both the brain-region and single-cell levels than the full-brain mesoscale connectome of a mouse brain does. Overall, our data reveal rich granularity and strong modular diversity in mouse brain networks that have not been quantitatively characterized before.</p></sec><sec id="Sec2" sec-type="results"><title>Results</title><sec id="Sec3"><title>A framework to build connectomes of single neurons</title><p id="Par7">In the following, to avoid confusion, we use the term &#x02018;connectome&#x02019; to refer to a connection network for a specific set of neurons. In particular, we built connectomes based on the 3D full morphologies of 1,877 neurons (called &#x02018;F1877&#x02019; for simplicity) and the dendritic morphologies of 18,370 neurons (called &#x02018;D18370&#x02019;), which were reconstructed using a recently developed platform<sup><xref ref-type="bibr" rid="CR20">20</xref></sup>. For the fully reconstructed neurons in F1877, we also generated 2.57&#x02009;million predicted boutons (PBs) along their axonal arbors. We registered spatially all these neuron morphologies and PBs to the Allen Common Coordinate Framework (CCF) version 3 atlas<sup><xref ref-type="bibr" rid="CR28">28</xref></sup> using the mBrainAligner tool<sup><xref ref-type="bibr" rid="CR23">23</xref></sup>. Within the standard atlas space, we identified and analyzed the spatial adjacency of each axon&#x02013;dendrite pair among these neurons to estimate strength scores of potential synaptic connections (Fig. <xref rid="Fig1" ref-type="fig">1a</xref>).<fig id="Fig1"><label>Fig. 1</label><caption><title>Overall scheme to build the single-neuron-level connectomes cross-validated using multi-modality datasets.</title><p><bold>a</bold>, Overview of multi-level connection networks of single neurons. Left: a set of full neuron reconstructions in whole mouse brain. Middle: axonal arbors spatially overlap with dendritic arbors. Right: predicted axonal synaptic sites spatially approach dendritic arbors. <bold>b</bold>, Arbor-net of 12,926 connections within 1,877 neurons. Values in matrix, connections (1, black) and nonconnections (0, white) derived from PACs. Colors along the axes correspond to A1&#x02013;A12 modules. Red boxes indicate detected modules; percentages are sparsity. <bold>c</bold>, Spatial distribution of predicted axonal bouton sites in whole mouse brain. Bar charts, average counts of PBs per cell in main brain regions (left); number of cells in main brain regions (right). See Supplementary Table <xref rid="MOESM3" ref-type="media">1</xref> for abbreviations and definitions of all brain region names. <bold>d</bold>, Bouton-net of 4,909 connections within 1,877 neurons. Values in matrix, connections (1, black) and nonconnections (0, white) derived from PBs. Colors along the axes correspond to B1&#x02013;B12 modules. <bold>e</bold>, Whole-brain region connectivity cross-validated by gene coexpression patterns. Left: a group of single-neuron-level connections from MRN to VPM. Right: coexpressed genes between two brain regions.</p></caption><graphic xlink:href="41592_2025_2784_Fig1_HTML" id="d33e347"/></fig></p><p id="Par8">We developed two methods to define such connection scores. First, we calculated the shortest Euclidean distance between neurons&#x02019; axon arbors and the nearest dendritic morphologies. When the distance was smaller than 5&#x02009;&#x003bc;m, which is the sum of typical length of dendritic spines and the size of axon boutons<sup><xref ref-type="bibr" rid="CR29">29</xref>,<xref ref-type="bibr" rid="CR30">30</xref></sup>, we called the respective axon&#x02013;dendrite location a potential arbor contact (PAC). We found 48,269 PACs among the fully reconstructed neurons in F1877. As there are typically multiple PACs between a pair of neurons, we then defined the strength score as a scaled function aggregating the number of PACs as well as the spatial adjacency associated with them. This method allowed us to generate an arbor-level connectome, called &#x02018;arbor-net&#x02019;, for neurons in F1877 based on their spatial proximity and the receptive profiles of their axonal and dendritic arbors, in terms of 12,926 pairs of potentially connected neurons (Fig. <xref rid="Fig1" ref-type="fig">1b</xref> and Supplementary Figs. <xref rid="MOESM1" ref-type="media">1</xref> and <xref rid="MOESM1" ref-type="media">2</xref>). Overall, the arbor-net is highly sparse (99.63%). We clustered these neurons into 12 groups, A1&#x02013;A12 (Supplementary Fig. <xref rid="MOESM1" ref-type="media">3</xref>), using a graph partition algorithm. Within each cluster, neurons have more PACs among themselves and thus appear less sparse than the entire dataset (Fig. <xref rid="Fig1" ref-type="fig">1b</xref>). In other words, when we sorted the arbor-net based on these 12 clusters, we found that the module density within each cluster was higher than that between clusters (Fig. <xref rid="Fig1" ref-type="fig">1b</xref>). The brain-region-specific relationships of these clusters will be discussed below.</p><p id="Par9">Second, using spatially registered PBs (Fig. <xref rid="Fig1" ref-type="fig">1c</xref>), we generated a bouton connectome, called bouton-net, as an alternative to the arbor-net. The key difference was that instead of using PACs, we posited that potential synaptic contacts could occur only at the locations of the predicted axonal boutons. In this bouton-net, we identified 4,909 pairs of potentially connected neurons in F1877 (Fig. <xref rid="Fig1" ref-type="fig">1d</xref> and Supplementary Fig. <xref rid="MOESM1" ref-type="media">4</xref>), with an overall sparsity of 99.86%. Using the same graph partition algorithm, we clustered the neurons into 12 modules, B1&#x02013;B12 (Supplementary Fig. <xref rid="MOESM1" ref-type="media">5</xref>), based on which we sorted this bouton-net and found that the module density within each cluster was also higher than that between clusters (Fig. <xref rid="Fig1" ref-type="fig">1d</xref>), similar to the case of coherent modules found in the arbor-net.</p><p id="Par10">Of note, as these two connectomes were produced with different approaches, we further cross-validated them to understand their modules (Figs. <xref rid="Fig2" ref-type="fig">2</xref> and <xref rid="Fig3" ref-type="fig">3</xref>). In addition, to ascertain whether these two connectomes might have over-estimated or under-estimated probable neuronal connections, we sought independent evidence. At present, there is a lack of whole-brain synaptic data derived from electron microscopy, as well as a comprehensive record of the simultaneous firing patterns of upstream&#x02013;downstream neuron pairs at single-cell resolution. Given these challenges in using synaptic and physiological data, except those we show later in our comparison, this study uses gene coexpression data across whole-brain regions to cross-validate potential connectivity patterns in the two connectomes (Fig. <xref rid="Fig1" ref-type="fig">1e</xref>). For instance, we correlated the in situ hybridization gene expression data of both ventral posteromedial nucleus of the thalamus (VPM; see Supplementary Table <xref rid="MOESM3" ref-type="media">1</xref> for all abbreviations of brain regions&#x02019; names) and midbrain reticular nucleus (MRN) neurons to identify genes that are either shared or uniquely expressed in these populations (Fig. <xref rid="Fig1" ref-type="fig">1e</xref>). A global connection model, encompassing all possible pairs of neurons and their shared genes, provides hints as to whether some connections might be more probable than others.<fig id="Fig2"><label>Fig. 2</label><caption><title>Modules in the arbor-net and their matching modules in the bouton-net.</title><p><bold>a</bold>,<bold>b</bold>, Tri-view visualization of neuron reconstructions in arbor-net (<bold>a</bold>) and bouton-net (<bold>b</bold>) modules (sampled neuron reconstructions displayed). Colors indicate the corresponding modules. Bar chart (bottom right), number of neurons in each module, and their soma locations are indicated in different colors. <bold>c</bold>&#x02013;<bold>e</bold>, Wiring diagrams for neurons (in three representative regions VISp (<bold>c</bold>), CP (<bold>d</bold>) and VPM (<bold>e</bold>)) involving upstream and downstream connections from bouton net. Connections were curated by expert to prevent false positives, and modules of less than 5% total cells for each brain region were not shown so the predominant patterns are better visualized. Top bars, percentages of upstream connections from various source brain regions; middle bars, percentages of cells between various bouton-net modules; bottom bars, percentages of downstream connections targeting to various brain regions. Lengths of bars represent percentages. Beside the bars, 3D visualization of neuron reconstructions, respectively. <bold>f</bold>, Axonal projection of single neurons in arbor-net modules. Vertical axis, source cells, grouped by arbor-net modules. Horizontal axis, axonal projection-target brain regions. Color bar, axonal lengths of cells in target regions. <bold>g</bold>, Comparison of arbor-net modules and bouton-net modules. Top: bar chart, number of neurons in each bouton-net module, and their soma locations are indicated in different colors. Bottom left: parallel set visualization of neurons. Cells are first aligned according to A1&#x02013;A12 and B1&#x02013;B11, and then linked between arbor-net modules and bouton-net modules. Bottom right: heatmap of shared neurons by arbor-net modules (vertical axis) and bouton-net modules (horizontal axis). Color bar, number of cells.</p></caption><graphic xlink:href="41592_2025_2784_Fig2_HTML" id="d33e452"/></fig><fig id="Fig3"><label>Fig. 3</label><caption><title>Spatial distributions and co-occurrence of PACs, PBs and the related function modules.</title><p><bold>a</bold>, Spatial distribution of PACs in the whole mouse brain. Colors of PACs indicate their soma locations of source neurons. <bold>b</bold>, Correlation between anatomical distribution between all 2.57 million PBs and PACs across whole mouse brain (the Pearson test; two-sided; without adjustments). Top left: scatter plot shows the counts of PACs and PBs that are from same source regions and located in the same target regions. Top right: box plots show the number of PACs from various brain regions (vertical axis, source brain regions). Bottom left: box plots show the number of PBs from various brain regions (horizontal axis, source brain regions). Box plots show the median (center lines), the 25th and 75th percentiles (bounds of the boxes) and the whiskers extend to 1.5 times the interquartile range. <bold>c</bold>, Euclidean distance between PBs and PACs. PBs were designated from 4,909 bouton-net connections; 24.58% of PBs are within a 1-&#x003bc;m neighborhood of PACs; 79.57% of PBs are within a 5-&#x003bc;m neighborhood of PACs; 94.61% of PBs are within a 10-&#x003bc;m neighborhood of PACs. <bold>d</bold>, Heatmap of anatomical PACs distribution in whole mouse brain. Horizontal axis, target brain regions of PACs. Vertical axis, source brain regions of PACs. Color bar, the number of PACs (log<sub>10</sub> transformed). <bold>e</bold>, Heatmap of anatomical PBs distribution in whole mouse brain (using all 2.57&#x02009;million PBs). Horizontal axis, target brain regions of PBs. Vertical axis, source brain regions of PBs. Color bar, the number of PBs (log<sub>10</sub> transformed). <bold>f</bold>, PB sites along axonal reconstruction (using all 2.57&#x02009;million PBs). Vertical axis (left), source brain regions of PBs. Vertical axis (right), target brain regions of most boutons from corresponding source brain regions, and small boxes on the heatmap also indicate these regions. Horizontal axis, geodesic distance from bouton site to soma location (bin width 0.15&#x02009;mm). Color bar, percentages of PBs in each bin. <bold>g</bold>, Relationship between bouton-net modules and brain function modules. Dot sizes, normalized functional scores for modules on this brain function.</p></caption><graphic xlink:href="41592_2025_2784_Fig3_HTML" id="d33e486"/></fig></p></sec><sec id="Sec4"><title>Bouton-net matches arbor-net in brain-wide modularity</title><p id="Par11">The arbor-net exhibits well-organized modularity in its 12 clusters, A1 to A12. First, the dense module connectivity within these clusters indicates an elevated degree of inter-connectivity among specific neuron groups (Fig. <xref rid="Fig1" ref-type="fig">1b</xref>). Second, these clusters show distinct preferences for cell body locations (Fig. <xref rid="Fig2" ref-type="fig">2a</xref> and Supplementary Fig. <xref rid="MOESM1" ref-type="media">6a</xref>). Indeed, most cells in clusters A7 and A12 originate from the thalamus (VPM), while most A8 and A11 are from the striatum (caudoputamen (CP)). Third, the axonal arborization patterns across all clusters are homogeneous as seen in the brain maps (Fig. <xref rid="Fig2" ref-type="fig">2a</xref>).</p><p id="Par12">The bouton-net was constructed by using the segmented PBs from individual neurons. There were differences between bouton-net and arbor-net, but overall, both networks have clear modularity (Fig. <xref rid="Fig2" ref-type="fig">2b</xref> and Supplementary Fig. <xref rid="MOESM1" ref-type="media">6b</xref>).</p><p id="Par13">The modular organization of bouton-net can is illustrated by both the incoming upstream sources and outgoing downstream targets of specific brain regions. We delineated the sorted connections of cortical, striatal and thalamic regions in modules B1 to B12 (Fig. <xref rid="Fig2" ref-type="fig">2c&#x02013;e</xref>). In the example of the primary visual area (VISp) (Fig. <xref rid="Fig2" ref-type="fig">2c</xref>), modules B6 and B8 connect most upstream and downstream cells, highlighting a broad range of modules with whole-brain connectivity. Cortical neurons in VISp (Fig. <xref rid="Fig2" ref-type="fig">2c</xref>) were observed to receive an estimated 43.33% of their incoming connections from VISp, a similar amount from other dorsal part of the lateral geniculate complex (LGd) neurons and fewer from other cortical areas. We observed that VISp neurons project more than 60% of their outgoing connections to neurons in the same area, and other visual areas including the anterolateral, rostrolateral and lateral visual areas. These proportions were derived from our dataset and reflected the observed connectivity in our dataset, which should not be interpreted as definitive quantitative estimates of actual biological connectivity. Our data confirm previous reports of LGd&#x02013;VISp circuits and other findings based on viral tracing for cortical projection mappings, for example, VISp neurons receiving projections from LGd to mediate visual perception<sup><xref ref-type="bibr" rid="CR8">8</xref>,<xref ref-type="bibr" rid="CR31">31</xref>&#x02013;<xref ref-type="bibr" rid="CR39">39</xref></sup>.</p><p id="Par14">Neurons in noncortical regions, such as the striatum and thalamus, also exhibit well-established modularity in bouton-net. For instance, excluding the connections among CP neurons themselves, CP neurons receive most of their incoming connections from cortical neurons such as primary motor area (MOp) but output a small portion of their outgoing connections down there (Fig. <xref rid="Fig2" ref-type="fig">2d</xref>). Our data also show that CP neurons project to the substantia nigra, reticular part, or globus pallidus, external segment (Supplementary Fig. <xref rid="MOESM1" ref-type="media">6c</xref>), consistent with previous findings of two subclasses of medium spiny neurons<sup><xref ref-type="bibr" rid="CR40">40</xref></sup>: dopamine receptor D1 neurons projecting to substantia nigra, reticular part (direct pathway) and dopamine receptor D2 neurons projecting to globus pallidus, external segment (indirect pathway).</p><p id="Par15">In contrast, neurons in the thalamic region VPM both receive and output a broader range of connections to cortical regions than CP neurons (Fig. <xref rid="Fig2" ref-type="fig">2e</xref>). Anterograde and retrograde labeling have demonstrated the reciprocal connections between VPM and widespread cortical regions<sup><xref ref-type="bibr" rid="CR8">8</xref>,<xref ref-type="bibr" rid="CR41">41</xref>&#x02013;<xref ref-type="bibr" rid="CR46">46</xref></sup>. Reconstructions and axonal analysis of VPM cells<sup><xref ref-type="bibr" rid="CR17">17</xref>,<xref ref-type="bibr" rid="CR18">18</xref>,<xref ref-type="bibr" rid="CR47">47</xref></sup> also characterized the diversity of its projections. However, different from our approach, few previous studies quantified the neuronal connections within these brain regions.</p><p id="Par16">The ubiquitous modularity of cortical, striatal and thalamic neurons represents distinct connectivity patterns in the bouton-net clusters. Similarly, we also observed clear modularity in the arbor-net clusters, reflected in their neuronal projection patterns (Fig. <xref rid="Fig2" ref-type="fig">2f</xref>). For instance, modules A2, A5 and A11 mainly project to the MOp and secondary motor area (MOs), but A5 and A11 hardly project to the primary somatosensory area, mouth (SSp-m), which are different from A11.</p><p id="Par17">We also found strong matches between the modules of the bouton-net and arbor-net (Fig. <xref rid="Fig1" ref-type="fig">1g</xref> and Supplementary Fig. <xref rid="MOESM1" ref-type="media">6d</xref>). For example, A7 corresponds primarily to B9 but also matches B1, B2 and B6; A2 matches to B7, B5 and B10, jointly. In contrast, all bouton-net modules exhibit strong correspondences with arbor-net modules. Our results showed that the bouton-net provided a restrictive set of modules of neuron-level connections for the cortical, striatal and thalamic regions, and these neuron-level connections among brain regions are not random.</p><p id="Par18">Furthermore, we analyzed the morphological features of neurons classified into different modules within both the arbor-net and bouton-net (Supplementary Figs. <xref rid="MOESM1" ref-type="media">7</xref> and <xref rid="MOESM1" ref-type="media">8</xref>), and found distinct patterns within each connectome.</p></sec><sec id="Sec5"><title>PBs match PACs</title><p id="Par19">Like the brain-wide distribution of PBs (Fig. <xref rid="Fig1" ref-type="fig">1c</xref>), our data indicate that cells originating from the same brain regions tend to have their PACs concentrated in several specific target brain regions, based on extracting 48,269 PACs from F1877 (Fig. <xref rid="Fig3" ref-type="fig">3a</xref>). For example, cortical neurons have abundant PACs in the striatum and thalamus (Fig. <xref rid="Fig3" ref-type="fig">3d</xref>). However, neurons from regions such as MOp and MOs also possess PACs in cortical areas. Cells from VPM and ventral posterolateral nucleus of the thalamus exhibit a wide distribution of PACs across various brain regions. This brain-wide distribution of PACs further supports the modular organization of the arbor-net observed in the above analysis.</p><p id="Par20">We discovered that the anatomical distribution of PBs correlates with that of PACs, even though they were generated following different principles. A positive correlation (Pearson&#x02019;s <italic>r</italic>&#x02009;=&#x02009;0.65, <italic>P</italic>&#x02009;=&#x02009;2.24&#x02009;&#x000d7;&#x02009;10<sup>&#x02212;111</sup>) was observed between them across cortical, thalamic and striatal regions (Fig. <xref rid="Fig3" ref-type="fig">3b</xref> and Supplementary Fig. <xref rid="MOESM1" ref-type="media">9a</xref>). In addition, for cells from the same soma-regions, we aggregated and compared their respective counts in the corresponding target brain regions. These two series of counts follow the same trend (Fig. <xref rid="Fig3" ref-type="fig">3b</xref>). This strong correlation found for anatomically corresponding regions suggests that the whole-brain scale estimation of PACs and PBs likely provides valuable information about neuronal connections, more than just random guesses about the locations of potential synaptic sites.</p><p id="Par21">We further investigated whether the spatial locations of PACs and PBs (designated by bouton-net 4,909 connections) showed co-occurrence along axonal reconstruction. For each PB compartment, we searched its nearest PAC compartment along the respective axonal reconstruction. Random axonal locations were also sampled evenly along the axonal trajectory with the same linear density as PACs for fair comparison. It turns out that 24.58% of PBs are within a maximum 3D distance of 1&#x02009;&#x003bc;m from PACs, contrasting with an even distribution expected from random guesses of potential neuron contacts&#x02019; locations (Fig. <xref rid="Fig3" ref-type="fig">3c</xref>). However, a substantial number of PBs remain outside the neighboring areas of the PACs, indicating that the locations of PACs are independent of the choice of PBs. (Fig. <xref rid="Fig3" ref-type="fig">3c</xref>). To further demonstrate the independence between PACs and PBs, we compared the spatial distributions between PBs and all axonal compartments in axonal reconstructions within the 5-&#x003bc;m neighborhood to dendritic arbors. We found that the locations of PACs are determined by PBs, and 99.45% of PBs are within the 1-&#x003bc;m neighborhood of these axonal compartments (Supplementary Fig. <xref rid="MOESM1" ref-type="media">9b</xref>). As a sanity check, only about 2.74% of PBs are within the 1-&#x003bc;m neighborhood of branching points of neurons, which represent another type of morphologically key locations (Fig. <xref rid="Fig3" ref-type="fig">3c</xref>).</p><p id="Par22">We hypothesized that the spatial colocalization and statistical correlation of PBs and PACs would result in cooccurring projection patterns in individual neurons. To explore this, we generated brain-region-sorted whole-brain projection matrices for both PACs (Fig. <xref rid="Fig3" ref-type="fig">3d</xref> and Supplementary Fig. <xref rid="MOESM1" ref-type="media">9c</xref>) and PBs (Fig. <xref rid="Fig3" ref-type="fig">3e</xref> and Supplementary Fig. <xref rid="MOESM1" ref-type="media">9d</xref>). We observed that neurons in MOp2/3, MOp5 and MOs2/3 form a closely connected network, in terms of both PACs and PBs. Supplemental somatosensory area neurons (SSp and SSs) exhibit more concentrated self-connections, as indicated by the correlated patterns of PACs and PBs. Notably, SSs6a neurons stand out as outliers, differing from other SSs neurons; they have PAC and PB projections to the MOp and MOs areas such as those of claustrum neurons. CP neurons display unique projection patterns, primarily connecting to themselves. In contrast, ventral posterolateral nucleus of the thalamus and VPM neurons have broad projection patterns extending to many different brain regions. Overall, we found that PACs and PBs share a high degree of projection concentration throughout the entire mouse brain. The remaining difference between PBs and PACs was likely due to the limited number of dendrites used in obtaining PACs, resulting in an order of magnitude fewer PACs compared with PBs (compare Fig. <xref rid="Fig3" ref-type="fig">3a</xref> with Fig. <xref rid="Fig1" ref-type="fig">1c</xref>). To address this, we used dendrites from the D18370 dataset (Supplementary Fig. <xref rid="MOESM1" ref-type="media">12</xref>) in conjunction with axons from the F1877 dataset, generating 355,837 PACs (Extended Data Fig. <xref rid="Fig7" ref-type="fig">1a,b</xref>). With this expanded dataset, we found that the anatomical correlation between PBs and PACs improved from 0.65 (Fig. <xref rid="Fig3" ref-type="fig">3b</xref>) to 0.76 (Extended Data Fig. <xref rid="Fig7" ref-type="fig">1c</xref>). In addition, we supplemented the topological distributions of the PACs and PBs in individual neurons (Supplementary Figs. <xref rid="MOESM1" ref-type="media">10</xref> and <xref rid="MOESM1" ref-type="media">11</xref>).</p><p id="Par23">Overall, we found statistical, spatial and anatomical correlations between PBs and PACs. Such cooccurring patterns are far from random. They offer a high-resolution overview of the neuronal connection network in mouse brains, which had not been achieved through millimeter-scale whole-brain network analysis or nanometer-scale imaging of synapses at the whole-brain scale.</p></sec><sec id="Sec6"><title>Predicted neuron connection sites concentrate on functional modules</title><p id="Par24">To complement the brain-wide distribution of PBs (Fig. <xref rid="Fig1" ref-type="fig">1c</xref>) and the map of projection regions (Fig. <xref rid="Fig3" ref-type="fig">3e</xref>), we also produced a geodesic distance map of concentrated PBs (Fig. <xref rid="Fig3" ref-type="fig">3f</xref>). Our data show that most cortical neurons have a high density of PBs within 2&#x02009;mm of their somas. An exception is the cortical claustrum neurons, which peak in layer 1 of the ventral part of the retrosplenial cortex, involved in various cognitive processes such as navigation, memory and spatial orientation<sup><xref ref-type="bibr" rid="CR48">48</xref></sup>. Our data are consistent with previous observations regarding the input-output organization of the mouse claustrum<sup><xref ref-type="bibr" rid="CR49">49</xref></sup>. Unlike cortical neurons, CP neurons exhibit a large density of PBs within the CP region, but thalamic neurons have most of their PBs in association with various cortical neurons (Fig. <xref rid="Fig3" ref-type="fig">3f</xref>). For instance, LGd neurons have a peak of 26.62% of PBs found in layers 2 and 3 of the primary visual cortex (VISp2/3). This finding aligns with the role of LGd in visual information processing, where the LGd receives input from the retina and sends projections to the primary visual cortex<sup><xref ref-type="bibr" rid="CR31">31</xref></sup>. VISp2/3 contains pyramidal neurons essential for intracortical and cortico-cortical communication, involved in tasks such as pattern recognition, depth perception and motion detection<sup><xref ref-type="bibr" rid="CR50">50</xref></sup>.</p><p id="Par25">To further explore the regional projection and enrichment of PBs in terms of various functions, we produced a PB-function map to better understand the relationship between brain-region functions and the bouton-net modules (Fig. <xref rid="Fig3" ref-type="fig">3g</xref>). We discovered that the relatively dense connections within each module correspond to anatomical areas responsible for specific brain functions. We evaluated the involvement of all modules in specific brain functions based on their soma distribution as well as their PB target regions (Fig. <xref rid="Fig3" ref-type="fig">3g</xref>). Our data show that each bouton-net module contributes to at least one type of brain function (Fig. <xref rid="Fig3" ref-type="fig">3g</xref> and Supplementary Fig. <xref rid="MOESM1" ref-type="media">13a</xref>). For example, modules B6, B8 and B11 are associated with vision and predominantly consist of cells originating from VISp and LGd.</p><p id="Par26">This PB-function map also highlights additional observations (Fig. <xref rid="Fig3" ref-type="fig">3g</xref>). Our data show that functions related to motion and feeling are ubiquitous across brain-wide neuronal connections. In contrast, sensory functions such as smell, taste, vision and hearing correspond to specific neuronal connections that are enriched in different brain regions and connection modules. Indeed, the bouton-net modules related to sensory functions partially complement each other, forming a conjugate code. In addition, our data indicate that the connections related to memory and learning are highly correlated, yet they exhibit a substantially lower correlation with the bouton-net modules associated with emotion, attention and cognition.</p><p id="Par27">We also shuffled the brain-wide distribution of PBs to investigate the effect of the accurate connectome construction on the PB-function map. We found that the functional modules derived from completely shuffled PBs differed from those derived from soma locations (Supplementary Fig. <xref rid="MOESM1" ref-type="media">13b</xref>), contrasting with the paired occurrence in Fig. <xref rid="Fig3" ref-type="fig">3g</xref>. In addition, when we shuffled the brain-wide distribution of only 50% PBs, improvements were observed (Supplementary Fig. <xref rid="MOESM1" ref-type="media">13c</xref>). The functional map of the arbor-net modules also mirrored these results (Supplementary Fig. <xref rid="MOESM1" ref-type="media">13d&#x02013;f</xref>).</p></sec><sec id="Sec7"><title>Predicted connections correlate with mesoscale connectomes and synaptome</title><p id="Par28">The mesoscale connectome, referred to as &#x02018;Allen-net&#x02019;, was reported based on visualizing 3D registered and multiplexed viral tracing at the whole-brain scale<sup><xref ref-type="bibr" rid="CR8">8</xref></sup>. The injection sites were much larger than single cells, resulting in neuron populations, often containing hundreds or thousands of neurons, being mapped in this connectome. Allen-net has been a valuable reference for interconnected brain regions due to the common use of anterograde (for example, adeno-associated virus and herpes simplex virus) and retrograde (for example, modified rabies virus and pseudorabies virus) tracing viruses injected into different brain regions for neural circuits. In addition, a mesoscale connectome, referred to as &#x02018;BRICseq-net&#x02019;, of brain regions was derived from a single-cell barcoding and sequencing technique<sup><xref ref-type="bibr" rid="CR51">51</xref></sup>. Thus, a direct comparison of our single-neuron connectomes against Allen-net and BRICseq-net is useful to understand whether the single-cell connections will add useful knowledge to connectome studies.</p><p id="Par29">As in their original studies, both the Allen-net and BRICseq-net were represented at the level of brain regions, for the purpose of a head-to-head, region-wise comparison, we reduced the resolution of our connectomes to either 76 (for Allen-net) or 33 (for BRICseq-net) common brain regions throughout a mouse brain (Fig. <xref rid="Fig4" ref-type="fig">4</xref>). To do so, we multiplied the corresponding connection scores in both the arbor-net and the bouton-net, generating a cell-to-cell merged connectome that incorporates both PAC and PB scores. We then averaged the connection strengths of all neuronal connections between each source and target region to obtain the regional-scale connection strength, resulting in a mesoscale connectome called &#x02018;SEU-net&#x02019; (Fig. <xref rid="Fig4" ref-type="fig">4a</xref> and Extended Data Fig. <xref rid="Fig8" ref-type="fig">2</xref>). Both the total numbers of PACs and PBs used in constructing SEU-net have a strong positive correlation with the connection strength of the Allen-net and BRICseq-net (Fig. <xref rid="Fig4" ref-type="fig">4b</xref>), for the shared brain regions with available data. However, as the connection strength of SEU-net is defined based on the average number of PACs and PBs, there is a weak correlation (<italic>P</italic>&#x02009;=&#x02009;0.014) between the connection strength of SEU-net and Allen-net, whereas the correlation between the connection strength of SEU-net and BRICseq-net is still strong (<italic>r</italic>&#x02009;=&#x02009;0.26, <italic>P</italic>&#x02009;=&#x02009;1.78&#x02009;&#x000d7;&#x02009;10<sup>&#x02212;6</sup>) (Fig. <xref rid="Fig4" ref-type="fig">4c</xref>). In addition, we also found that the connection strength of SEU-net was weakly and negatively correlated with the distance between connected brain regions (Supplementary Fig. <xref rid="MOESM1" ref-type="media">14</xref>). Overall, the connections of SEU-net and previous work as shown in Allen-net and BRICseq-net are mostly consistent.<fig id="Fig4"><label>Fig. 4</label><caption><title>Cross-validation of three mesoscale connectomes.</title><p><bold>a</bold>, Regional SEU-net, regional connectivity map (top 38 brain regions with layers shown; number of brain regions with layers, 148; number of brain regions without layers, 90)). Vertical axis, 38 source brain regions of the highest outgoing connection strength. Horizontal axis, 38 target brain regions same as vertical axis. Color bar, connection strength (log<sub>10</sub>-transformed) between source and target region. <bold>b</bold>, Correlation between mesoscale connection strength (Allen-net and BRICseq-net) and anatomical distributions of PACs and PBs (using all 2.56&#x02009;million boutons) (the Pearson test; two-sided; without adjustments). <bold>c</bold>, Scatter plots of corresponding connection strength between mesoscale connectomes (SEU-net, Allen-net and BRICseq-net) (the Pearson test; two-sided; without adjustments). <bold>d</bold>, Intersection of SEU-net and Allen-net. Top: counts of connections and nonconnections of SEU-net and Allen-net within 76 shared brain regions (left), and their intersections (right). Bars represent the counts of connections and nonconnections. Dots and lines indicate the types of intersection. Bottom: dynamic thresholding of the Allen-net to determine connections and nonconnections. Vertical axis, counts of shared connections in both connectomes. Horizontal axis, parameter to determine the threshold. <bold>e</bold>, The common subset (number of shared regions without layers, 32) of three mesoscale connectomes: SEU-net (total number of connections, 302), Allen-net (<italic>t</italic> = 0) and BRICseq-net (228 common connections). The red color bar represents the connections common to all three networks, while the blue color bar represents the connections unique to SEU-net (not shared with Allen-net or BRICseq-net); Color bars are log<sub>10</sub>-transformed and Min&#x02013;Max normalized. Green arrows annotate three regional connection examples. <bold>f</bold>, Examples of neuron connections in SEU-net. Three groups of single-neuron-level connections are displayed in CCF v.3.</p></caption><graphic xlink:href="41592_2025_2784_Fig4_HTML" id="d33e822"/></fig></p><p id="Par30">Another way to cross-validate different connectomes is by intersecting their connections and nonconnections. In the case of Allen-net, because of the preprocessing and normalization in its original work<sup><xref ref-type="bibr" rid="CR8">8</xref></sup>, there is a putative connection strength score between each pair of brain regions. Therefore, we compared the common connections of SEU-net and Allen-net, applying a dynamic threshold to Allen-net (Fig. <xref rid="Fig4" ref-type="fig">4d</xref>). In total, 75.6% of SEU-net connections (541 out of 716) were found in Allen-net when considering all connections in the latter. For the notably strong connections in Allen-net, whose connection strength is greater than 1 standard deviation above the respective mean strength value, 55.0% of the predicted connections in SEU-net (132 out of 240) were confirmed by Allen-net. At the same time, 97.9% of nonconnections observed in SEU-net (4,952 out of 5,060) were also confirmed by Allen-net (Fig. <xref rid="Fig4" ref-type="fig">4d</xref>). We shuffled the SEU-net connections and compared these random connections with the Allen-net. The curve of shuffled connections shows fewer shared connections and a more quickly dropping tendency under all thresholding levels for Allen-net, compared with the SEU-net (Fig. <xref rid="Fig4" ref-type="fig">4d</xref>). This ballpark consistency between the two connectomes is reasonable, given that Allen-net is known to contain false-positive connections but is unlikely to have many false negatives. The remaining differences between Allen-net and SEU-net could be due to different neurite labeling techniques, imaging protocols (for example, sensitivity) and data processing (for example, registration methods). Furthermore, we investigated the Allen-net injection experiments<sup><xref ref-type="bibr" rid="CR8">8</xref></sup> to cross-validate the SEU-net connections, and found that all connections can be observed in these injection experiments (Supplementary Table <xref rid="MOESM4" ref-type="media">2</xref>).</p><p id="Par31">We further cross-validated all three connectomes, that is SEU-net, Allen-net and BRICseq-net, by finding their greatest intersection (Fig. <xref rid="Fig4" ref-type="fig">4e</xref>). To do this, we considered the 32 common brain regions of these three datasets. We found that most SEU-net connections were present in their common subnet of three regional connectomes (Fig. <xref rid="Fig4" ref-type="fig">4e</xref>). For instance, SEU-net&#x02019;s aggregated predicted connections from MOp neurons to primary somatosensory area, upper limb neurons, from MOs neurons to agranular insular area, dorsal part neurons, and from SSs neurons to visceral area neurons (Fig. <xref rid="Fig4" ref-type="fig">4f</xref>) were all confirmed at the brain-region level, as shown in the common subnet of the three connectomes (Fig. <xref rid="Fig4" ref-type="fig">4e</xref>). This result indicates that our approach to assembling a single-neuron connectome is more likely to be useful than a random guess, and single-neuron connections correlate with mesoscale neuronal connectomes.</p><p id="Par32">In further cross-validation, we compared the potential connections predicted by our approach with a brain-wide synaptome<sup><xref ref-type="bibr" rid="CR52">52</xref></sup>. We analyzed the average synapse distribution from 11 mouse brains aged between 60&#x02009;days and 99&#x02009;days, naming the dataset Grant2020 (ref. <sup><xref ref-type="bibr" rid="CR52">52</xref></sup>). We identified 102 common brain regions between our predicted brain regions and the regions studied in Grant2020. Across these 102 regions, we observed a strong correlation (<italic>r</italic>&#x02009;=&#x02009;0.49, <italic>P</italic>&#x02009;=&#x02009;2.33&#x02009;&#x000d7;&#x02009;10<sup>&#x02212;7</sup>) between PBs and the relative synapse distribution (Extended Data Fig. <xref rid="Fig9" ref-type="fig">3a</xref>). There was also a positive correlation between predicted axonal connections (PACs) and Grant2020 (Extended Data Fig. <xref rid="Fig9" ref-type="fig">3b</xref>). Coupled with the consistent patterns found across three connectomes regarding the incoming and outgoing connections (Fig. <xref rid="Fig4" ref-type="fig">4e</xref>), it appears that the spatial distributions of PACs and PBs (Fig. <xref rid="Fig3" ref-type="fig">3</xref>) capture key aspects of the spatial granularity and organization of potential synaptic connections.</p><p id="Par33">We also performed a survey of existing literatures concerning 156 sampled connections from the common subnet of three regional connectomes (Fig. <xref rid="Fig4" ref-type="fig">4e</xref>). It turns out that 87.18% of the sampled connections (136 out of 156) were previously studied, demonstrating regional connections in terms of anatomical structures or functional activities, complementing the validation of our neuronal connections. The studies and evidence are documented in Supplementary Table <xref rid="MOESM5" ref-type="media">3</xref>.</p></sec><sec id="Sec8"><title>Single-cell connections correlate with coexpressed genes</title><p id="Par34">It remains an open question whether neuronal connections are supported by gene coexpression, as the coexpression of genes in different brain regions only indicates a possibility that these regions might be connected by a neuronal pathway<sup><xref ref-type="bibr" rid="CR53">53</xref></sup>. While one might hypothesize that a greater number of genes shared in coexpression patterns would indicate a higher likelihood of some kind of association of brain regions, either through direct or indirect neuronal connections, validating such a hypothesis has been limited by the lack of specifically designed experiments in this field. This challenge is further complicated by the fact that many genes, ubiquitously expressed in the brain, present complex background coexpression patterns, even when there is no direct neuronal connection between brain regions.</p><p id="Par35">In a brain-wide analysis, we combined SEU-net with the genome-wide, in situ hybridization-based ABA gene expression database<sup><xref ref-type="bibr" rid="CR54">54</xref></sup> to generate a region-wise gene coexpression map for 19,907 mouse genes (Fig. <xref rid="Fig5" ref-type="fig">5a</xref> and Extended Data Fig. <xref rid="Fig10" ref-type="fig">4</xref>). On visual inspection, we observed a correlation between these coexpression maps (Fig. <xref rid="Fig5" ref-type="fig">5a</xref>) and the regional connection map, arranged in the same order (Fig. <xref rid="Fig4" ref-type="fig">4e</xref>). To quantify this relationship with examples, it is worth noting that the relatively strong connection from MOp to SSp-m corresponds to 32.12% of coexpressed genes from the entire mouse genome, with an average gene correlation score of 0.60 (Fig. <xref rid="Fig5" ref-type="fig">5b</xref>).<fig id="Fig5"><label>Fig. 5</label><caption><title>Validation of neuronal connections using genome-wide gene coexpression and single-cell MERFISH.</title><p><bold>a</bold>, Whole-brain region-wise gene coexpression map using the ABA dataset. Vertical axis, 32 source brain regions. Horizontal axis, 32 target brain regions. Dot colors, regional connectivity of SEU-net. Color bar, regional connection strength from SEU-net. Dot sizes, gene coexpression scores. <bold>b</bold>, Regional connectivity and gene coexpression (coex.) examples. CEG, coexpressed genes. <bold>c</bold>, Scatter plot of corresponding regional connection strength and coexpression scores within all shared 76 brain regions (between SEU-net and ABA dataset) (the Pearson test; two-sided; without adjustments). <bold>d</bold>, Distributions of gene coexpression scores for connections and nonconnections from both SEU-net and Allen-net (<italic>t</italic>&#x02009;=&#x02009;0). Horizontal axes, gene coexpression scores. Vertical axes, percentages of connections and nonconnections in each bin. Top: using all 19,907 mouse genes in ABA dataset. Bottom, using 227 &#x02018;nonbackground&#x02019; genes. Left: using connectivity from SEU-net. Right column: connectivity from Allen-net. Red arrows indicate the average gene coexpression scores for connections, and blue arrows indicate the average gene coexpression scores for nonconnections. <bold>e</bold>, Scatter plots and distributions of corresponding regional connectivity and gene coexpression using MERFISH dataset (the Pearson test; two-sided; without adjustments). Each column uses regional connectivity from SEU-net and Allen-net, respectively. Arrows indicate the average gene coexpression scores in the same way in <bold>d</bold>.</p></caption><graphic xlink:href="41592_2025_2784_Fig5_HTML" id="d33e958"/></fig></p><p id="Par36">Quantitatively, for the neuronal connections analyzed using SEU-net, we found a correlation (<italic>r</italic>&#x02009;=&#x02009;0.29, <italic>P</italic>&#x02009;=&#x02009;4.07&#x02009;&#x000d7;&#x02009;10<sup>&#x02212;12</sup>) between the strength of neuronal connections and the level of gene coexpression (Fig. <xref rid="Fig5" ref-type="fig">5c</xref>). Similarly, using connections from Allen-net, we can also identify the correlation (Supplementary Fig. <xref rid="MOESM1" ref-type="media">15a</xref>). In addition, we profiled the histogram of gene coexpression scores associated with specific regional connections (Fig. <xref rid="Fig5" ref-type="fig">5d</xref>). We discovered that the genome-wide gene coexpression of connected brain regions exhibited a longer tail compared with that of nonconnected regions, as indicated by both SEU-net and Allen-net connectomes. However, the gene coexpression for nonconnected regions displayed similar histograms. This observation is consistent with the hypothesis that ubiquitously expressed genes contribute to a background coexpression pattern. Therefore, we also analyzed the most highly expressed &#x02018;nonbackground&#x02019; genes, after excluding all ubiquitously coexpressed &#x02018;background genes&#x02019; (Fig. <xref rid="Fig5" ref-type="fig">5d</xref>). In both analyses, connections identified by SEU-net consistently showed higher average gene coexpression scores than those identified by Allen-net. For instance, when considering the top 10% most highly expressed genes, after removing the ubiquitous background, the mean gene coexpression score for SEU-net connections is 0.35, which is 52% higher than that for Allen-net connections (0.23) (Fig. <xref rid="Fig5" ref-type="fig">5d</xref>). In addition, we found that the mean coexpression scores were improved by increasing the connection threshold of SEU-net and Allen-net, respectively (Supplementary Fig. <xref rid="MOESM1" ref-type="media">15b,c</xref>). Our findings suggest that the single-neuron reconstructions used to construct SEU-net are more strongly correlated with gene coexpression than the neuron-population-based Allen-net.</p><p id="Par37">Furthermore, we computed the differentially coexpressed genes in cortico-cortical connections and thalamo-cortical connections. We found that these differentially coexpressed genes were highly enriched in functional profiles including sensory perception of taste, and sensory perception of chemical stimulus for cortico-cortical connections (Supplementary Fig. <xref rid="MOESM1" ref-type="media">16a</xref>); presynaptic cytoskeleton and monoatomic ion channel activity for thalamo-cortical connections (Supplementary Fig. <xref rid="MOESM1" ref-type="media">16b</xref>). These identified coexpressed genes are documented in Supplementary Table <xref rid="MOESM6" ref-type="media">4</xref>.</p><p id="Par38">We also cross-validated SEU-net with an alternative single-cell gene expression dataset, which profiled 1,122 expressed genes using a multiplexed error-robust fluorescence in situ hybridization (MERFISH) technique<sup><xref ref-type="bibr" rid="CR55">55</xref></sup>. We generated a region-wise gene coexpression map based on the MERFISH data (Extended Data Fig. <xref rid="Fig11" ref-type="fig">5</xref>), displaying an apparent correlation with our genome-wide coexpression map (Extended Data Fig. <xref rid="Fig10" ref-type="fig">4</xref>). Although the background ubiquitously coexpressed gene histograms drawn from the combined analysis of SEU-net, Allen-net and the MERFISH data (Fig. <xref rid="Fig5" ref-type="fig">5e</xref>) still exhibit a monotonously decreasing profile, similar to those observed in the respective ABA analysis (Fig. <xref rid="Fig5" ref-type="fig">5d</xref>), the histograms for strongly coexpressed genes in SEU-net show a bell-like profile (mean 0.42), differing from that of the Allen-net (mean 0.27) (Fig. <xref rid="Fig5" ref-type="fig">5e</xref>). With the top 112 most expressed genes, SEU-net connections correspond to a mean coexpression score of 0.56, which is 40% higher than that of the Allen-net (mean coexpression score 0.40) (Fig. <xref rid="Fig5" ref-type="fig">5e</xref>). In addition, we note a consistent, positive correlation between gene coexpression scores and brain-region connections, whether in SEU-net or Allen-net. In other words, we demonstrate the quantification of the approximately linear correlation between neuronal connections and gene coexpression, whether the gene expression data is genome-wide or single-cell-oriented. Furthermore, the single-neuron connections as depicted in SEU-net correlate more distinctly with gene coexpression, using different methods, than the neuron-population-based connections revealed in the Allen-net.</p></sec><sec id="Sec9"><title>Single-neuron connectomes show consistent network properties</title><p id="Par39">After analyzing the single-neuron connections and modules derived from both the arbor-net and bouton-net, which are likely real, we further examined whether the combination of subsets of these connections would also make sense. To do this, we studied a series of network properties of the single-neuron connectomes and their derivatives, specifically focusing on the local network structures and characteristics of the arbor-net, bouton-net and SEU-net.</p><p id="Par40">The detection of subnetwork patterns, that is, motifs, in complex networks allows studying the intricate relationships among network nodes and their connections (edges). There are various types of network motif, such as dyads, triads and tetrads, involving two, three and four network nodes, respectively<sup><xref ref-type="bibr" rid="CR56">56</xref>&#x02013;<xref ref-type="bibr" rid="CR58">58</xref></sup>. In this study, we focused on triads that cannot be directly deciphered using bivariate analyses of pairs of neurons. We counted the occurrences of 13 triad motifs (M1&#x02013;M13) (Fig. <xref rid="Fig6" ref-type="fig">6a</xref>). Since each triad involves a different number of directed edges between nodes (for example, M1 involves two directed edges and M8 involves four directed edges (Fig. <xref rid="Fig6" ref-type="fig">6a</xref>)), it is natural that triads with more directed edges would have fewer occurrences. Therefore, we normalized the observed occurrences using the respective expected values in random networks<sup><xref ref-type="bibr" rid="CR59">59</xref></sup> (Fig. <xref rid="Fig6" ref-type="fig">6a</xref>) and discovered outstanding triads representing fundamental local subnetwork patterns in arbor-net, bouton-net and SEU-net connectomes (Fig. <xref rid="Fig6" ref-type="fig">6a</xref>). The arbor-net and bouton-net were also compared with a region-based stochastic block model (SBM), respectively. The comparison highlighted the same overexpressed triads (Supplementary Fig. <xref rid="MOESM1" ref-type="media">17</xref>), showing the presence of intricate subnetwork patterns within these connectomes. To further investigate the robustness of the network structure, we tested the arbor-net with several conditions. We reconstructed the arbor-net using two sets of more stringent PACs, requiring the shortest Euclidean distances to dendrites to be within 3&#x02009;&#x003bc;m and 1&#x02009;&#x003bc;m, respectively. The arbor-net under these conditions displayed similar triad occurrence distributions (Supplementary Fig. <xref rid="MOESM1" ref-type="media">18a,b</xref>). We also reduced the sampling intervals of neuron reconstructions to 20&#x02009;&#x003bc;m to rebuild the arbor-net. The occurrence distributions of 13 triads remained unchanged (Supplementary Fig. <xref rid="MOESM1" ref-type="media">18c</xref>). This supports our hypothesis that an analysis of these connectomes should extend beyond global bivariate analyses to include comparisons within the motif space, thereby providing more understanding of their structural complexities. In particular, we found a few motifs, for example, M9 triads, were overabundant in both arbor-net and bouton-net. Thus, we profiled them more closely as follows.<fig id="Fig6"><label>Fig. 6</label><caption><title>Network analysis of the single-neuron connectomes indicates consistent subnetwork patterns and other network properties.</title><p><bold>a</bold>, Network motif distributions of connectomes and comparison with the random Erdos&#x02013;Renyi (ER) networks. Top: occurrences of motifs from arbor-net, bouton-net and SEU-net. Colors indicate the respective connectomes. Middle: structures of network motifs and their counts of edges. Bottom: corrected motif occurrences relative to ER network with same nodes and same edges. Box and stars highlight the overexpressed motif patterns of connectomes. <bold>b</bold>, Statistics of neuronal sources in motifs across brain regions. Pie-charts represent nodes (arbor-net and bouton-net, neurons) of motifs, and arrows represent their edges (predicted connections). Labels around the pie chart indicate the percentages from corresponding source brain regions. <bold>c</bold>, Exemplar neurons and their connections in triads M9, M12 and M13. Top: motif structures formed by nodes and edges, and node colors corresponding to their soma locations. Bottom: neuron reconstructions in CCFv3. <bold>d</bold>, Comparison of degree distribution between connectomes and random networks. Values in matrix, Spearman correlation coefficients and <italic>P</italic> values between degree distributions, also annotated by labels in the heatmap. <bold>e</bold>, Distributions of in degree and out degree in major brain regions from arbor-net and bouton-net. Top: box plots of in-degree distributions. Middle: box plots of out-degree distributions. Bottom: box plots of in degree versus out degree. Horizontal axis, 26 brain regions, each with &#x0003e;10 cells. <italic>P</italic> values between arbor-net and bouton-net (the Pearson test; two-sided; without adjustments). Box plots show the median (center lines), the 25th and 75th percentiles (bounds of the boxes) and the whiskers extend to 1.5 times the interquartile range.</p></caption><graphic xlink:href="41592_2025_2784_Fig6_HTML" id="d33e1092"/></fig></p><p id="Par41">Our analysis revealed that the two M9 motifs from arbor-net and bouton-net, despite being derived independently, exhibited similar profiles regarding the source and target brain regions of the underlying neurons (Fig. <xref rid="Fig6" ref-type="fig">6b</xref> and Supplementary Fig. <xref rid="MOESM1" ref-type="media">19</xref>). More precisely, the nodes at the apex of the arbor-net M9 and the bouton-net M9 were predominantly composed of cells from the VPM, SSp-m, SSs, ventral posterolateral nucleus of the thalamus and MOp regions. The nodes at the base of the two M9 triads predominantly comprised cells from the SSp-m, primary somatosensory area, upper limb, MOp, CP, primary somatosensory area, barrel field and SSs regions. The proportional distribution of these cells within the two sets of triads&#x02019; profiles also resembled each other. This correlation between subnetwork patterns that were derived independently underscores that our single neuronal connectomes are characterized by nonrandom network connections and structures, which can be consistently identified using varied methodologies. We also observed similar situation for other motifs, such as M8 and M10&#x02013;M13 motifs (Supplementary Fig. <xref rid="MOESM1" ref-type="media">20</xref>). We further explored the factors influencing the composition of neuronal sources within the 13 triads, including the number of neurons per brain region (Supplementary Fig. <xref rid="MOESM1" ref-type="media">21</xref>), and the in and out degrees of these brain regions (Supplementary Figs. <xref rid="MOESM1" ref-type="media">22</xref> and <xref rid="MOESM1" ref-type="media">23</xref>). We redefined the source regions of these cells based on the three factors respectively and inspected the new triad compositions. We found that the new triad compositions were closely aligned with the newly defined source regions, contrasting with the proportional distributions in arbor-net and bouton-net (Fig. <xref rid="Fig6" ref-type="fig">6b</xref> and Supplementary Fig. <xref rid="MOESM1" ref-type="media">19</xref>).</p><p id="Par42">In addition to the motif analysis, we also examined other network properties<sup><xref ref-type="bibr" rid="CR60">60</xref>,<xref ref-type="bibr" rid="CR61">61</xref></sup>. A previous study on Allen-net<sup><xref ref-type="bibr" rid="CR8">8</xref></sup> showed that the degree distribution of the mouse brain network best approximates that of a scale-free network. Our tests on both single neuronal connectomes, that is, arbor-net and bouton-net, as well as the regional connectome, that is, SEU-net, yielded similar conclusions (Fig. <xref rid="Fig6" ref-type="fig">6d</xref>). We also found that arbor-net and bouton-net shared substantially correlated in-degree and out-degree profiles, as well as their ratios (Fig. <xref rid="Fig6" ref-type="fig">6e</xref>). All these pieces of evidence support the notion that our single neuronal connectomes carry brain-wide global properties of single neuronal connections that are nonrandom and can be cross-validated using state-of-the-art, multi-modality datasets from independent sources.</p></sec></sec><sec id="Sec10" sec-type="discussion"><title>Discussion</title><p id="Par43">Understanding single-cell level connectivity across the entire brain is crucial for comprehending its structural wiring and functional activities. Many studies on the long projection morphology reconstruction of single neurons have been published in recent years<sup><xref ref-type="bibr" rid="CR13">13</xref>,<xref ref-type="bibr" rid="CR17">17</xref>&#x02013;<xref ref-type="bibr" rid="CR21">21</xref></sup>, enabling investigations into regional connectivity at the single-cell level through axonal projections. However, these works have scarcely delved into the specifics of how two neurons are probabilistically connected, due to a variety of challenges, for example some of the published datasets do not include complete dendrites and axons at the same time. Our study makes an initial attempt to provide a practical and reliable framework for mapping neuronal connections between individual neurons, using one of the largest available neuron reconstruction datasets<sup><xref ref-type="bibr" rid="CR20">20</xref></sup>.</p><p id="Par44">Our independently developed brain network models demonstrate strong statistical consistency, which is highly unlikely to arise from mere conjectures of potential neuronal connections. We have found that most connections consolidated based on our detailed connectome models can match established knowledge in literature, and at the same time we also discover many previously unknown connections that deserve future examination. Therefore, our paradigm can potentially be enhanced by additional nanometer-scale imaging of synapses, which is not yet feasible for whole brains. We believe the generated connectomes capture the indispensable properties of brain networks, and our approach provides an instrumental framework as more individual neurons&#x02019; morphologies become accessible.</p><p id="Par45">Traditionally, the term &#x02018;Peters&#x02019; rule&#x02019;<sup><xref ref-type="bibr" rid="CR62">62</xref></sup> was used to describe the method that estimates the strength of potential synaptic connections based on the spatial adjacency or overlap of axonal and dendritic arbors<sup><xref ref-type="bibr" rid="CR16">16</xref></sup>. However, it is also true that spatial adjacency does not guarantee a connection, as it could be due to passing neurites without actual synaptic connections, among other complications. Nevertheless, it is fair to say that spatial adjacency does increase the likelihood of connectivity. Such probabilistic, predicted connectivity is useful for understanding the overall brain networks. In addition, systematic profiling of individual neurons&#x02019; probabilistic connectivity has been shown to be crucial and powerful for classifying neurons into connectivity subtypes that could not be discovered using morphology alone<sup><xref ref-type="bibr" rid="CR13">13</xref></sup>. Despite these successes, a key unanswered question remains: how can one ascertain whether spatially adjacent or overlapping neurons are likely to form real connections? Our approach in this paper offers an answer to this key question. We argue that individual neurons&#x02019; axonal varicosities can complement the spatial adjacency of pairs of neurons with overlapping axonal&#x02013;dendritic regions, producing a more realistic estimation of connection probability. This leads to an extensible way to predict neuronal connectivity that can be cross-validated using independently produced evidence from different data modalities.</p><p id="Par46">Although we have cross-validated our connectomes using an independently produced synaptome<sup><xref ref-type="bibr" rid="CR52">52</xref></sup>, we acknowledge that nanometer-resolution imaging<sup><xref ref-type="bibr" rid="CR10">10</xref>&#x02013;<xref ref-type="bibr" rid="CR12">12</xref></sup> (for example, electron microscopy) of synaptic connections in specific brain regions would provide additional verification of the predicted neuronal networks and potential synapses in our current connectomes. It should be noted that while reconstructing a nanometer-scale connectome of mammalian brains using electron microscopy from scratch presents multiple challenges in the sample preparation and time cost, developing a verification process as described here would be a practical approach to achieving a similar objective.</p></sec><sec id="Sec11"><title>Methods</title><sec id="Sec12"><title>Sources of experimental data</title><p id="Par47">We built connectomes based on 1,877 fully reconstructed single-neuron morphologies, referred to as &#x02018;F1877&#x02019;, derived from our recent work<sup><xref ref-type="bibr" rid="CR20">20</xref></sup> (data version 24 July 2023). The dendritic morphologies of 18,370 neurons (referred to as &#x02018;D18370&#x02019;) and 2.57&#x02009;million PBs were also accessed from the same work. In specific, to generate PBs for each neuron, axonal skeletons were first segmented into 20&#x02009;&#x000b5;m length fragments, where intensity and radius profiles were calculated. Overlapped peaks in both intensity and radius profiles were identified as initial candidate boutons, and false-positive results were filtered out with heuristic criteria for bouton size and image intensity<sup><xref ref-type="bibr" rid="CR20">20</xref></sup>. All neuron morphologies and PBs were spatially registered to the Allen Mouse Brain CCF v.3 (ref. <sup><xref ref-type="bibr" rid="CR28">28</xref></sup>) using the mBrainAligner tool<sup><xref ref-type="bibr" rid="CR23">23</xref></sup>. Subsequently, we resampled these registered neuron morphologies at 1-&#x000b5;m intervals, using the &#x02018;resample_swc&#x02019; function in Vaa3D (version 3.601). Summaries of these 20,247 neurons are provided in Supplementary Table <xref rid="MOESM7" ref-type="media">5</xref>.</p></sec><sec id="Sec13"><title>Quantification of neuronal connection score</title><p id="Par48">To quantify the connection scores between neurons, we computed the closest Euclidean distance from axon arbors to dendritic arbors. Considering the typical length of dendritic spines and the size of axonal boutons<sup><xref ref-type="bibr" rid="CR29">29</xref></sup>, we designated the axonal locations within 5&#x02009;&#x003bc;m to the dendrite as PACs. For an axon&#x02013;dendrite pair with <italic>N</italic> PACs, we defined the connection score using the following equation:<disp-formula id="Equa"><alternatives><tex-math id="d33e1222">\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\mathrm{connection}}{\rm{\_}}{\mathrm{score}}=\mathop{\sum }\limits_{i}^{N}\exp \left(-{\left(\frac{{\mathrm{Dist}}\left(i\right)}{5}\right)}^{2}\right)$$\end{document}</tex-math><mml:math id="d33e1225"><mml:mrow><mml:mi mathvariant="normal">connection</mml:mi><mml:mo>_</mml:mo><mml:mi mathvariant="normal">score</mml:mi><mml:mo>=</mml:mo><mml:munderover accent="false" accentunder="false"><mml:mrow><mml:mo>&#x02211;</mml:mo></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow><mml:mrow><mml:mi>N</mml:mi></mml:mrow></mml:munderover><mml:mi>exp</mml:mi><mml:mfenced close=")" open="("><mml:mrow><mml:mo>&#x02212;</mml:mo><mml:msup><mml:mrow><mml:mfenced close=")" open="("><mml:mrow><mml:mfrac><mml:mrow><mml:mi mathvariant="normal">Dist</mml:mi><mml:mfenced close=")" open="("><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:mfenced></mml:mrow><mml:mrow><mml:mn>5</mml:mn></mml:mrow></mml:mfrac></mml:mrow></mml:mfenced></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msup></mml:mrow></mml:mfenced></mml:mrow></mml:math></alternatives></disp-formula>where Dist(<italic>i</italic>) represents the shortest Euclidean distance from the <italic>i</italic>th PAC to the dendritic arbors. We estimated the connection scores for the F1877 cells, and constructed the arbor-level connectome (arbor-net). For bouton-net, we calculated the shortest distance between axonal boutons of each source neuron to target neurons, and designated bouton locations within 5&#x02009;&#x003bc;m approaching the target as PBs. Following the same definition of connection scores, we also generated the bouton-level connectome (bouton-net) using the spatial closeness between PBs and target dendritic morphologies, which constrained the potential synaptic contacts within our previously predicted axonal boutons.</p></sec><sec id="Sec14"><title>Graph partition algorithm</title><p id="Par49">To further investigate these neuronal connections, we applied Spectral Clustering (with the parameters, affinity&#x02009;=&#x02009;&#x02018;precomputed&#x02019;, assign_labels&#x02009;=&#x02009;&#x02018;discretize&#x02019;, random_state&#x02009;=&#x02009;200) from the scikit-learn Python package (version 1.2.2) to cluster neurons based on their log<sub>10</sub>-transformed connection scores for each connectome, respectively. The optimal number of clusters was determined by the modularity score (using the NetworkX Python package, version 3.0.0) automatically. Modularity is a network metric to measure the degree to which a network can be divided into modules or communities. A modularity score close to 1 indicates the presence of a strong community structure in the network. We found the best modularity score of arbor-net was 0.63, and the best modularity score of bouton-net was 0.74. To ensure the quality of clustering results, we also filtered out clusters containing fewer than 30 cells.</p></sec><sec id="Sec15"><title>Correlation analysis between bouton modules and brain function</title><p id="Par50">First, we engaged experts to annotate the functionality of brain regions involved in this study (see Supplementary Table <xref rid="MOESM8" ref-type="media">6</xref> for the list of functionality of brain regions). Subsequently, we weighted these brain functions associated with bouton-net modules based on the proportion of neuronal somas from each module present in these regions, assigning functional scores to each module. Assuming somas from module <italic>C</italic> are distributed across <italic>N</italic> brain regions, the functional score of module <italic>C</italic> related to a specific function <italic>F</italic>, is computed using following equation:<disp-formula id="Equb"><alternatives><tex-math id="d33e1293">\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\mathrm{function}}{\rm{\_}}{\mathrm{score}}=\mathop{\sum }\limits_{i}^{N}p\left(i\right)\times {{\rm{II}}}_{\left({\mathrm{if}\; {\mathrm{region}}\,i\,{\mathrm{associated}}\; {\mathrm{with}}\,F}\right)}$$\end{document}</tex-math><mml:math id="d33e1296"><mml:mrow><mml:mi mathvariant="normal">function</mml:mi><mml:mo>_</mml:mo><mml:mi mathvariant="normal">score</mml:mi><mml:mo>=</mml:mo><mml:munderover accent="false" accentunder="false"><mml:mrow><mml:mo>&#x02211;</mml:mo></mml:mrow><mml:mrow><mml:mi>i</mml:mi></mml:mrow><mml:mrow><mml:mi>N</mml:mi></mml:mrow></mml:munderover><mml:mi>p</mml:mi><mml:mfenced close=")" open="("><mml:mrow><mml:mi>i</mml:mi></mml:mrow></mml:mfenced><mml:mo>&#x000d7;</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="normal">II</mml:mi></mml:mrow><mml:mrow><mml:mfenced close=")" open="("><mml:mrow><mml:mi mathvariant="normal">if</mml:mi><mml:mspace width="0.16em"/><mml:mi mathvariant="normal">region</mml:mi><mml:mspace width="0.25em"/><mml:mi>i</mml:mi><mml:mspace width="0.25em"/><mml:mi mathvariant="normal">associated</mml:mi><mml:mspace width="0.16em"/><mml:mi mathvariant="normal">with</mml:mi><mml:mspace width="0.25em"/><mml:mi>F</mml:mi></mml:mrow></mml:mfenced></mml:mrow></mml:msub></mml:mrow></mml:math></alternatives></disp-formula>where <italic>p</italic>(<italic>i</italic>) is the proportion of neuronal somas from module <italic>C</italic> in the <italic>i</italic>th brain region, and the II is indicator function, yielding 1 when the input within the parentheses is true and 0 otherwise. To reveal the clear pattern between these functions and bouton-net modules, functional scores less than 0.1 were set to 0.</p></sec><sec id="Sec16"><title>Inter-regional connectivity and comparison</title><p id="Par51">We produced a whole-brain inter-region connectivity map, called SEU-net and compared this with two previous connectomes, Allen-net<sup><xref ref-type="bibr" rid="CR8">8</xref></sup> and BRICseq-net<sup><xref ref-type="bibr" rid="CR51">51</xref></sup>. To estimate the regional connection strength of SEU-net, we first multiplied the corresponding connection strength of each neuronal connection from the arbor-net and bouton-net, generating their merged connectome (cell-to-cell merged SEU-net). The merged connectome indeed used both PACs and PBs to produce the neuronal connection score, which may potentially enhance the reliability and stability for the construction of SEU-net. Subsequently, we averaged the connection strength values of all neuronal connections between source region and target region to represent connection strength of the two regions.</p><p id="Par52">The Allen-net provided quantitative connection strength values involving 213 anatomical regions on both ipsilateral and contralateral hemispheres<sup><xref ref-type="bibr" rid="CR8">8</xref></sup>. The connection scores were prepossessed and normalized in its original study using a computational model<sup><xref ref-type="bibr" rid="CR8">8</xref></sup>. We multiplied the connection strength of two hemispheres and selected 76 common brain regions in both connectomes for comparison. To determine connections and nonconnections, we used a dynamic threshold <italic>t</italic> in the Allen-net. The threshold was computed as the mean strength value (<italic>s</italic>) plus the standard deviation (<italic>m</italic>) multiplied by a hyperparameter <italic>&#x003b1;</italic>.</p><p id="Par53">The BRICseq-net provided brain region-to-brain region connection strength in mouse neocortex from six BRICseq brains<sup><xref ref-type="bibr" rid="CR51">51</xref></sup>. The inferred connection strength of each brain was provided in both ipsilateral and contralateral hemispheres. We averaged the connection strength of six BRICseq brains, and then multiplied the connection strengths of two hemispheres. For comparison, we selected 33 common brain regions shared by both our SEU-net and BRICseq-net.</p><p id="Par54">The comparison among the PACs, PBs and related connectomes was assessed using the Pearson correlation coefficient (scipy; version 1.21.0).</p></sec><sec id="Sec17"><title>Whole-brain connectivity and gene correlation</title><p id="Par55">We investigated the relationship between whole-brain connectivity and gene coexpression. The regional connection strength scores of SEU-net (with 76 layer-merged brain regions) were normalized to a range from 0 to 1 by minimum&#x02013;maximum scaling (scikit-learn Python package; version 1.2.2). Gene coexpression indicates shared genes expressed across brain regions. The coexpression score was defined as the absolute Pearson correlation coefficient (scipy; version 1.21.0) of gene expression strength between two brain regions. The ratio of coexpressed genes was defined as the proportion of coexpressed genes between two brain regions relative to the total expressed genes in both brain regions.</p><p id="Par56">We first acquired two spatial gene expression datasets: the Allen Mouse Brain Atlas<sup><xref ref-type="bibr" rid="CR54">54</xref></sup> (ABA atlas), and a recently released spatial transcriptomic cell atlas of the whole mouse brain<sup><xref ref-type="bibr" rid="CR55">55</xref></sup> (MERFISH atlas). The strength of gene expression in brain regions can be derived from the two datasets, and used for the estimation of gene correlations between brain regions. All genes used in the study are documented in Supplementary Table <xref rid="MOESM9" ref-type="media">7</xref>.</p><p id="Par57">The ABA atlas offers a genome-scale collection of cellular-resolution gene expression profiles using in situ hybridization technique. It encompasses the expression patterns of 19,903 genes across the entire brain, derived from 21,553 experiments of sagittal perspective. Each experiment provided &#x02018;expression energy&#x02019; of each brain region to represent the regional gene expression strength. To determine the specific gene expression strength of brain regions, we normalized the &#x02018;expression energy&#x02019; values of all regions as percentages for each experiment, and then averaged these percentages across experiments for the same genes and brain regions. To exclude the background genes, we first removed all coexpressed genes in nonconnected regions, and then selected the top 10% most expressed genes according to their total gene expression strength across all brain regions.</p><p id="Par58">The MERFISH atlas provides a spatial transcriptomic dataset of more than 1,100 genes and approximately 10&#x02009;million cells across entire mouse brains. The processed MERFISH dataset was organized and stored into four subsets based on their source animals. To avoid potential confounding factors from additional data integration procedures, we selected one subset (log<sub>2</sub>-transformed count matrix; <ext-link ext-link-type="uri" xlink:href="https://alleninstitute.github.io/abc_atlas_access/descriptions/Zhuang-ABCA-3.html">https://alleninstitute.github.io/abc_atlas_access/descriptions/Zhuang-ABCA-3.html</ext-link>) of 1,122 genes and 606,170 cells (excluding cells not from the 76 common brain regions). Subsequently, the gene expression levels of brain regions were quantified by averaging the single-cell gene counts within the same region, and the top 10% genes of the MERFISH atlas were determined by ordering the total counts of each region.</p><p id="Par59">We also computed the differentially coexpressed genes for cortico-cortical connection and thalamo-cortical connection. First, we used signal thresholds (mean plus standard deviation) to determine the expressed genes of each brain region in the ABA dataset. Second, we counted the occurrences for each gene coexpressed in all regional connections (background). Then we counted the occurrences for each gene coexpressed in the cortico-cortical connection and thalamo-cortical connection, respectively (foreground). Next, we calculated a ratio of foreground counts versus background counts for each gene. Finally, we used ratio threshold (mean plus standard deviation) to select the differential genes of higher ratios. For the gene ontology enrichment analysis, we used the enrichGO function (R package clusterProfiler, v.4.4.1; parameters: OrgDb&#x02009;=&#x02009;org.Mm.eg.db, keyType&#x02009;=&#x02009;&#x02018;SYMBOL&#x02019;, ont&#x02009;=&#x02009;&#x02018;ALL&#x02019;, pAdjustMethod&#x02009;=&#x02009;&#x02018;BH&#x02019;, pvalueCutoff&#x02009;=&#x02009;0.5, qvalueCutoff&#x02009;=&#x02009;0.5).</p></sec><sec id="Sec18"><title>Network analysis</title><p id="Par60">In network analysis, neurons are considered as nodes, and their connections represent edges. It enabled us to examine network characteristics such as motifs, and degree distributions of arbor-net, bouton-net and SEU-net. Here the SEU-net referred to the cell-to-cell merged connectome of arbor-net and bouton-net, which was derived from previously multiplied corresponding connections of two connectomes.</p><p id="Par61">Motifs were fundamental subnetwork patterns in network analysis, and we explored the motifs of 13 triads (M1&#x02013;M13) within our connectomes. The occurrences of these triads were calculated using the &#x02018;get_subisomorphisms_lad&#x02019; function in the iGraph Python package (version 0.11.3).</p><p id="Par62">To identify the overexpressed motifs in the connectomes, we compared the occurrences of 13 motifs in respective connectomes with their occurrences in random networks accordingly. We independently generated 100 random Erdos&#x02013;Renyi networks<sup><xref ref-type="bibr" rid="CR59">59</xref></sup>, and calculated the average occurrence of each motif across these 100 random networks. The normalized motif importance was defined as the result of dividing motif occurrence in each connectome by its average occurrence in random networks and subtracting its number of edges for normalization. The generated Erdos&#x02013;Renyi networks were also implemented by the iGraph package (version 0.11.3; API: ig.Graph.Erdos_Renyi; parameters: &#x02018;<italic>n</italic>&#x02009;=&#x02009;1,877, <italic>m</italic>&#x02009;=&#x02009;12,926&#x02019; for arbor-net comparison and &#x02018;<italic>n</italic>&#x02009;=&#x02009;1,877, <italic>m</italic>&#x02009;=&#x02009;4,909&#x02019; for bouton-net comparison). We also constructed SBMs and compared them with arbor-net and bouton-net, respectively. For example, when compared with arbor-net, to construct the SBM network, the F1877 cells were first grouped according to source regions, and connections were only allowed within connected brain regions according to predefined regional connections of arbor-net. Then, we assigned random connections to cells within two connected brain regions, and the numbers of connections were controlled to match the same numbers of connections with arbor-net. The construction of a random SBM was implemented by the NetworkX package (API: networkx. Stochastic_block_model; parameters: &#x02018;sizes=list of cell counts in various brain regions, p=density of connections between source regions and target regions&#x02019;).</p><p id="Par63">We defined the in degree of a neuron as the number of connections received by the neuron as a target cell, and the out degree as the number of connections originating from the neuron as a source cell. While we constructed our connectomes into &#x02018;Graph&#x02019; objects using the NetworkX Python package (version 3.0.0), the in degree and out degree of each node were directly computed as inner attributes of the objects.</p><p id="Par64">We conducted a comparative analysis of degree distributions between our connectomes and three kinds of random graph: Erdos&#x02013;Renyi network<sup><xref ref-type="bibr" rid="CR59">59</xref></sup>, scale-free network<sup><xref ref-type="bibr" rid="CR60">60</xref></sup> and small-world network<sup><xref ref-type="bibr" rid="CR61">61</xref></sup>. We used NetworkX functions, &#x02018;gnm_random_graph&#x02019;, &#x02018;watts_strogatz_graph&#x02019; and &#x02018;barabasi_albert_graph&#x02019; for the generation of these random networks, and each kind of random network was generated 100 times independently for a thorough comparison. For a fair comparison between two networks, they must have a matching number of nodes and edges. Therefore, the parameters used in the generation were selected to ensure that random networks have matching sizes of connections and nodes with the compared connectomes (gnm_random_graph &#x02018;<italic>n</italic>&#x02009;=&#x02009;1,877, <italic>m</italic>&#x02009;=&#x02009;12,926&#x02019; for arbor-net comparison, &#x02018;<italic>n</italic>&#x02009;=&#x02009;1,877, <italic>m</italic>&#x02009;=&#x02009;4,909&#x02019; for bouton-net comparison, and &#x02018;<italic>n</italic>&#x02009;=&#x02009;90, <italic>m</italic>&#x02009;=&#x02009;922&#x02019; for SEU-net comparison; watts_strogatz_graph: &#x02018;<italic>n</italic>&#x02009;=&#x02009;1,877, <italic>k</italic>&#x02009;=&#x02009;14, <italic>p</italic>&#x02009;=&#x02009;0.5&#x02019; for arbor-net comparison, &#x02018;<italic>n</italic>&#x02009;=&#x02009;1877, <italic>k</italic>&#x02009;=&#x02009;6, <italic>p</italic>&#x02009;=&#x02009;0.5&#x02019; for bouton-net comparison and &#x02018;<italic>n</italic>&#x02009;=&#x02009;90, <italic>k</italic>&#x02009;=&#x02009;21, <italic>p</italic>&#x02009;=&#x02009;0.5&#x02019; for SEU-net comparison; barabasi_albert_graph &#x02018;<italic>n</italic>&#x02009;=&#x02009;1,877, <italic>m</italic>&#x02009;=&#x02009;7&#x02019; for arbor-net comparison, &#x02018;<italic>n</italic>&#x02009;=&#x02009;1,877, <italic>m</italic>&#x02009;=&#x02009;3&#x02019; for bouton-net comparison, and &#x02018;<italic>n</italic>&#x02009;=&#x02009;90, <italic>m</italic>&#x02009;=&#x02009;12&#x02019; for SEU-net comparison). The Spearman rank-order correlation coefficient and the <italic>P</italic> value (scipy; version 1.21.0) were calculated to estimate the similarity between degree distributions.</p><p id="Par65">For arbor-net and bouton-net, we grouped the cells based on their soma locations, and generated the in-degree and out-degree distributions for each brain region. To compare the degree correlation between arbor-net and bouton-net, the degree distributions of brain regions were represented by their median values, and then we calculated the Pearson correlation coefficient (scipy; version 1.21.0) with the medians between arbor-net and bouton-net.</p><p id="Par66">We further explored the factors influencing the composition of neuronal sources within the 13 triads, focusing on three key aspects: the number of neurons per brain region, and the in degrees and out degrees of these regions. By maintaining the network structure constant, we redefined the regional labels of each neuron based on these factors. First, we redefined the source region labels of F1877 cells and examined the source composition of the triads after redefining these labels. Second, for the in degree of brain regions, we calculated the average in-degree values for all brain regions. Based on these values, we assigned source region labels to cells, with a higher proportion of cells being assigned to regions with higher in degrees. The same procedures were applied for out-degree inspection. Finally, we summarized the cell occurrences in source regions for triad examples.</p></sec><sec id="Sec19"><title>Reporting summary</title><p id="Par67">Further information on research design is available in the <xref rid="MOESM2" ref-type="media">Nature Portfolio Reporting Summary</xref> linked to this article.</p></sec></sec><sec id="Sec20" sec-type="materials|methods"><title>Online content</title><p id="Par68">Any methods, additional references, Nature Portfolio reporting summaries, source data, extended data, supplementary information, acknowledgements, peer review information; details of author contributions and competing interests; and statements of data and code availability are available at 10.1038/s41592-025-02784-2.</p></sec><sec id="Sec22" sec-type="supplementary-material"><title>Supplementary information</title><p>

ation-type="journal">Hass U, Lund SP, Hougaard KS, Simonsen L. Developmental neurotoxicity after toluene inhalation exposure in rats. Neurotoxicol Teratol. ao&#x000fb;t 1999;21(4):349&#x02013;57.</mixed-citation></citation-alternatives></ref><ref id="CR14"><label>14.</label><citation-alternatives><element-citation id="ec-CR14" publication-type="journal"><person-group person-group-type="author"><name><surname>Hass</surname><given-names>U</given-names></name><name><surname>Ladefoged</surname><given-names>O</given-names></name><name><surname>Lam</surname><given-names>HR</given-names></name><name><surname>Ostergaard</surname><given-names>G</given-names></name><name><surname>Lund</surname><given-names>SP</given-names></name><name><surname>Sinonsen</surname><given-names>L</given-names></name></person-group><article-title>Behavioural effects in rats after prenatal exposure to dearomatized white spirit</article-title><source>Pharmacol Toxicol oct</source><year>2001</year><volume>89</volume><issue>4</issue><fpage>201</fpage><lpage>7</lpage><pub-id pub-id-type="doi">10.1111/j.0901-9928.2001.890410.x</pub-id></element-citation><mixed-citation id="mc-CR14" publication-type="journal">Hass U, Ladefoged O, Lam HR, Ostergaard G, Lund SP, Sinonsen L. Behavioural effects in rats after prenatal exposure to dearomatized white spirit. Pharmacol Toxicol. oct 2001;89(4):201&#x02013;7.</mixed-citation></citation-alternatives></ref><ref id="CR15"><label>15.</label><citation-alternatives><element-citation id="ec-CR15" publication-type="journal"><person-group person-group-type="author"><name><surname>Blossom</surname><given-names>SJ</given-names></name><name><surname>Melnyk</surname><given-names>SB</given-names></name><name><surname>Li</surname><given-names>M</given-names></name><name><surname>Wessinger</surname><given-names>WD</given-names></name><name><surname>Cooney</surname><given-names>CA</given-names></name></person-group><article-title>Inflammatory and oxidative stress-related effects associated with neurotoxicity are maintained after exclusively prenatal trichloroethylene exposure</article-title><source>Neurotoxicology mars</source><year>2017</year><volume>59</volume><fpage>164</fpage><lpage>74</lpage><pub-id pub-id-type="doi">10.1016/j.neuro.2016.01.002</pub-id></element-citation><mixed-citation id="mc-CR15" publication-type="journal">Blossom SJ, Melnyk SB, Li M, Wessinger WD, Cooney CA. Inflammatory and oxidative stress-related effects associated with neurotoxicity are maintained after exclusively prenatal trichloroethylene exposure. Neurotoxicology. mars 2017;59:164&#x02013;74.</mixed-citation></citation-alternatives></ref><ref id="CR16"><label>16.</label><citation-alternatives><element-citation id="ec-CR16" publication-type="journal"><person-group person-group-type="author"><name><surname>Julvez</surname><given-names>J</given-names></name><name><surname>Grandjean</surname><given-names>P</given-names></name></person-group><article-title>Neurodevelopmental toxicity risks due to Occupational exposure to Industrial Chemicals during pregnancy</article-title><source>Ind Health</source><year>2009</year><volume>47</volume><issue>5</issue><fpage>459</fpage><lpage>68</lpage><pub-id pub-id-type="doi">10.2486/indhealth.47.459</pub-id><pub-id pub-id-type="pmid">19834254</pub-id>

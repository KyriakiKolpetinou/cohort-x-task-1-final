</element-citation></ref><ref id="CR10"><label>10.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Geere</surname><given-names>JH</given-names></name><name><surname>Swamy</surname><given-names>GN</given-names></name><name><surname>Hunter</surname><given-names>PR</given-names></name><name><surname>Geere</surname><given-names>JL</given-names></name><name><surname>Lutchman</surname><given-names>LN</given-names></name><name><surname>Cook</surname><given-names>AJ</given-names></name><etal/></person-group><article-title>Incidence and risk factors for five-year recurrent disc herniation after primary single-level lumbar discectomy</article-title><source>Bone Joint J.</source><year>2023</year><volume>105-B</volume><issue>3</issue><fpage>315</fpage><lpage>322</lpage><pub-id pub-id-type="doi">10.1302/0301-620X.105B3.BJJ-2022-1005.R2</pub-id><pub-id pub-id-type="pmid">36854329</pub-id>
</element-citation></ref><ref id="CR11"><label>11.</label><mixed-citation publication-type="other">Lijiang L, Lingyu M, Jinghu L, et al. Effects of lever positioning manipulation combined with pulsed electric field on analgesia and IL-1&#x003b2;, TNF-&#x003b1; in patients with lumbar disc herniation. Chin. J. Orthop. Traumatol. Zhongguo Gu Shang.&#x000a0;2021;34:780&#x02013;84.</mixed-citation></ref><ref id="CR12"><label>12.</label><mixed-citation publication-type="other">Lijiang L, Yedao, J, Ruyun Z, et al. Lever positioning manipulation for the treatment of lumbar disc herniation. Chin. J. Orthop. Traumatol. Zhongguo Gu Shang. 2008;21(8):638.</mixed-citation></ref><ref id="CR13"><label>13.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kohoutov&#x000e1;</surname><given-names>L</given-names></name><name><surname>Atlas</surname><given-names>LY</given-names></name><name><surname>B&#x000fc;chel</surname><given-names>C</given-names></name><name><surname>Buhle</surname><given-names>JT</given-names></name><name><surname>Geuter</surname><given-names>S</given-names></name><name><surname>Jepma</surname><given-names>M</given-names></name><etal/></person-group><article-title>Individual variability in brain representations of pain</article-title><source>Nat Neurosci</source><year>2022</year><volume>25</volume><issue>6</issue><fpage>749</fpage><lpage>759</lpage><pub-id pub-id-type="doi">10.1038/s41593-022-01081-x</pub-id><pub-id pub-id-type="pmid">35637368</pub-id>
</element-citation></ref><ref id="CR14"><label>14.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ploner</surname><given-names>M</given-names></name><name><surname>Sorg</surname><given-names>C</given-names></name><name><surname>Gross</surname><given-names>J</given-names></name></person-group><article-title>Brain Rhythms of Pain</article-title><source>Trends Cogn Sci</source><year>2017</year><volume>21</volume><issue>2</issue><fpage>100</fpage><lpage>110</lpage><pub-id pub-id-type="doi">10.1016/j.tics.2016.12.001</pub-id><pub-id pub-id-type="pmid">28025007</pub-id>

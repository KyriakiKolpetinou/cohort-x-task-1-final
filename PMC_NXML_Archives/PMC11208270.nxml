</element-citation></ref><ref id="CR23"><label>23.</label><mixed-citation publication-type="other">Pritt B, Ashikaga T, Oppenheimer RG, Weaver DL (2004) Influence of breast cancer histology on the relationship between ultrasound and pathology tumor size measurements. Mod Pathol 17(8):905&#x02013;910. 10.1038/modpathol.3800138.</mixed-citation></ref><ref id="CR24"><label>24.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cuesta Cuesta</surname><given-names>AB</given-names></name><etal/></person-group><article-title>Accuracy of tumor size measurements performed by magnetic resonance, ultrasound and mammography, and their correlation with pathological size in primary breast cancer</article-title><source>Cirug&#x000ed;a Espa&#x000f1;ola (English Edition)</source><year>2019</year><volume>97</volume><issue>7</issue><fpage>391</fpage><lpage>396</lpage><pub-id pub-id-type="doi">10.1016/j.cireng.2019.08.001</pub-id></element-citation></ref><ref id="CR25"><label>25.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Thai</surname><given-names>JN</given-names></name><name><surname>Sevrukov</surname><given-names>AB</given-names></name><name><surname>Ward</surname><given-names>RC</given-names></name><name><surname>Monticciolo</surname><given-names>DL</given-names></name></person-group><article-title>Cryoablation therapy for early-stage breast cancer: evidence and rationale</article-title><source>J Breast Imaging</source><year>2023</year><volume>5</volume><issue>6</issue><fpage>646</fpage><lpage>657</lpage><pub-id pub-id-type="doi">10.1093/jbi/wbad064</pub-id><pub-id pub-id-type="pmid">38141236</pub-id>

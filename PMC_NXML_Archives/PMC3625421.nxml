tension</td></tr><tr><td align="left">&#x000a0;Total (%)</td><td align="left">109 (28.9)</td><td align="left">96 (27.4)</td><td align="left">68 (25.8)</td><td align="left">40 (20.0)</td><td align="left">161 (42.7)</td></tr><tr><td align="left">&#x000a0;&#x000a0;Survivors (%)</td><td align="left">77 (29.6)</td><td align="left">71 (29.1)</td><td align="left">55 (28.4)</td><td align="left">32 (21.8)</td><td align="left">111(42.7)</td></tr><tr><td align="left">&#x000a0;&#x000a0;Nonsurvivors (%)</td><td align="left">32 (27.4)</td><td align="left">25 (23.6)</td><td align="left">13 (18.6)</td><td align="left">8 (15.1)</td><td align="left">50 (42.7)</td></tr><tr><td align="left">&#x000a0;&#x000a0;<italic>P</italic> value*</td><td align="left">0.713</td><td align="left">0.421</td><td align="left">0.105</td><td align="left">0.305</td><td align="left">1.000</td></tr></tbody></table><table-wrap-foot><p>* <italic>P</italic> values refer to comparisons between survivors and nonsurvivors</p><p>

hor"><name><surname>Guerini</surname><given-names>Henri</given-names></name><xref ref-type="aff" rid="aff3">3</xref></contrib><contrib id="author-60629141" contrib-type="author"><name><surname>Ieong</surname><given-names>Estelle</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib id="author-60629147" contrib-type="author"><name><surname>Chagny</surname><given-names>Franck</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib id="author-60629155" contrib-type="author"><name><surname>Bedin</surname><given-names>Catherine</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib id="author-60629171" contrib-type="author"><name><surname>Roren</surname><given-names>Alexandra</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff4">4</xref><xref ref-type="aff" rid="aff5">5</xref></contrib><contrib id="author-61853791" contrib-type="author"><name><surname>Lef&#x000e8;vre-Colau</surname><given-names>Marie-Martine</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff4">4</xref><xref ref-type="aff" rid="aff5">5</xref><xref ref-type="aff" rid="aff6">6</xref></contrib><contrib id="author-55431513" contrib-type="author"><name><surname>Poiraudeau</surname><given-names>Serge</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff4">4</xref><xref ref-type="aff" rid="aff5">5</xref><xref ref-type="aff" rid="aff6">6</xref></contrib><contrib id="author-60629181" contrib-type="author"><name><surname>Feydy</surname><given-names>Antoine</given-names></name><xref ref-type="aff" rid="aff3">3</xref><xref ref-type="aff" rid="aff4">4</xref><xref ref-type="aff" rid="aff6">6</xref></contrib><contrib id="author-53495426" contrib-type="author"><name><surname>Rannou</surname><given-names>Fran&#x000e7;ois</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff6">6</xref><xref ref-type="aff" 
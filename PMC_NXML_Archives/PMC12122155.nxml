</person-group><article-title>Evaluation of the iPACK Block Injectate Spread: a Cadaveric Study</article-title><source>
<italic>Regional Anesthesia and Pain Medicine</italic>
</source><year>2019</year><volume>44</volume><issue>7</issue><fpage>689</fpage><lpage>694</lpage><pub-id pub-id-type="doi">10.1136/rapm-2018-100355</pub-id><pub-id pub-id-type="other">2-s2.0-85067933921</pub-id></element-citation></ref><ref id="B3" content-type="article"><label>3</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Cleveland</surname><given-names>R. J.</given-names></name>

<bold>&#x0003c;0.001</bold>
</td></tr><tr><td rowspan="1" colspan="1">NT Pro-BNP (pg/ml)</td><td rowspan="1" colspan="1">86.5 [52&#x02013;247]</td><td rowspan="1" colspan="1">241 [126&#x02013;422]</td><td rowspan="1" colspan="1">52 [28&#x02013;78]</td><td rowspan="1" colspan="1">
<bold>&#x0003c;0.001</bold>
</td></tr><tr><td rowspan="1" colspan="1">LVEF (%)</td><td rowspan="1" colspan="1">64&#x000a0;&#x000b1;&#x000a0;6</td><td rowspan="1" colspan="1">63&#x000a0;&#x000b1;&#x000a0;7</td><td rowspan="1" colspan="1">65&#x000a0;&#x000b1;&#x000a0;6</td><td rowspan="1" colspan="1">0.172</td></tr><tr><td rowspan="1" colspan="1">LVED (mm)</td><td rowspan="1" colspan="1">49&#x000a0;&#x000b1;&#x000a0;5</td><td rowspan="1" colspan="1">50&#x000a0;&#x000b1;&#x000a0;5</td><td rowspan="1" colspan="1">49&#x000a0;&#x000b1;&#x000a0;6</td><td rowspan="1" colspan="1">0.134</td></tr><tr><td rowspan="1" colspan="1">LVEDV (ml/kg/m<sup>2</sup> )</td><td rowspan="1" colspan="1">42 [36&#x02013;51]</td><td rowspan="1" colspan="1">40 [35&#x02013;46]</td><td rowspan="1" colspan="1">43 [35&#x02013;47]</td><td rowspan="1" colspan="1">0.761</td></tr><tr><td rowspan="1" colspan="1">LVMI (g/m<sup>2</sup> )</td><td rowspan="1" colspan="1">88&#x000a0;&#x000b1;&#x000a0;22</td><td rowspan="1" colspan="1">98&#x000a0;&#x000b1;&#x000a0;24</td><td rowspan="1" colspan="1">83&#x000a0;&#x000b1;&#x000a0;19</td><td rowspan="1" colspan="1">0.172</td></tr><tr><td rowspan="1" colspan="1">LAVI (ml/m<sup>2</sup> )</td><td rowspan="1" colspan="1">37&#x000a0;&#x000b1;&#x000a0;11</td><td rowspan="1" colspan="1">44&#x000a0;&#x000b1;&#x000a0;12</td><td rowspan="1" colspan="1">31&#x000a0;&#x000b1;&#x000a0;7.3</td><td rowspan="1" colspan="1">
<bold>&#x0003c;0.001</bold>
</td></tr><tr><td rowspan="1" colspan="1">Rest E/A ratio</td><td rowspan="1" colspan="1">1.06&#x000a0;&#x000b1;&#x000a0;0.42</td><td rowspan="1" colspan="1">1.2&#x000a0;&#x000b1;&#x000a0;0.54</td><td rowspan="1" colspan="1">0.95&#x000a0;&#x000b1;&#x000a0;0.28</td><td rowspan="1" colspan="1">
<bold>0.001</bold>
</td></tr><tr><td rowspan="1" colspan="1">Rest average e&#x02019; (cm/s)</td><td rowspan="1" colspan="1">8.6&#x000a0;&#x000b1;&#x000a0;2.4</td><td rowspan="1" colspan="1">7.2&#x000a0;&#x000b1;&#x000a0;1.7</td><td rowspan="1" colspan="1">10&#x000a0;&#x000b1;&#x000a0;2.1</td><td rowspan="1" colspan="1">

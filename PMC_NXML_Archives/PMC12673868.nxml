</td></tr><tr><td rowspan="1" colspan="1">Overweight/obesity (n %)</td><td rowspan="1" colspan="1">95 (86.4)</td><td rowspan="1" colspan="1">38 (82.6)</td><td rowspan="1" colspan="1">57 (89)</td><td rowspan="1" colspan="1">0.331</td></tr><tr><td rowspan="1" colspan="1">Coronary artery disease (n %)</td><td rowspan="1" colspan="1">20 (18.2)</td><td rowspan="1" colspan="1">11 (24)</td><td rowspan="1" colspan="1">9 (14)</td><td rowspan="1" colspan="1">0.220</td></tr><tr><td rowspan="1" colspan="1">SBP (mmHg)</td><td rowspan="1" colspan="1">140 [130&#x02013;145]</td><td rowspan="1" colspan="1">145 [135&#x02013;150]</td><td rowspan="1" colspan="1">135 [120&#x02013;140]</td><td rowspan="1" colspan="1">
<bold>0.001</bold>
</td></tr><tr><td rowspan="1" colspan="1">DBP (mmHg)</td><td rowspan="1" colspan="1">80 [75&#x02013;90]</td><td rowspan="1" colspan="1">83 [80&#x02013;90]</td><td rowspan="1" colspan="1">80 [75&#x02013;84]</td><td rowspan="1" colspan="1">0.348</td></tr><tr><td rowspan="1" colspan="1">Heart ate (b/m)</td><td rowspan="1" colspan="1">79 [70&#x02013;84]</td><td rowspan="1" colspan="1">80 [70&#x02013;86]</td><td rowspan="1" colspan="1">77 [71&#x02013;84]</td><td rowspan="1" colspan="1">0.574</td></tr><tr><td rowspan="1" colspan="1">Creatinine level (<italic toggle="yes">&#x003bc;</italic>mol/l)</td><td rowspan="1" colspan="1">70 [57&#x02013;89]</td><td rowspan="1" colspan="1">85 [63&#x02013;100]</td><td rowspan="1" colspan="1">63 [53&#x02013;73]</td><td rowspan="1" colspan="1">
<bold>&#x0003c;0.001</bold>
</td></tr><tr><td rowspan="1" colspan="1">Creatinine clearance (ml/min/1.73m<sup>2</sup> )</td><td rowspan="1" colspan="1">92&#x000a0;&#x000b1;&#x000a0;32</td><td rowspan="1" colspan="1">74&#x000a0;&#x000b1;&#x000a0;29</td><td rowspan="1" colspan="1">104&#x000a0;&#x000b1;&#x000a0;29</td><td rowspan="1" colspan="1">
<bold>&#x0003c;0.001</bold>

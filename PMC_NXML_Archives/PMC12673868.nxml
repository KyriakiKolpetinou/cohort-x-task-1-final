</td><td rowspan="1" colspan="1">11</td><td rowspan="1" colspan="1">0.51&#x02013;253</td><td rowspan="1" colspan="1">0.125</td></tr><tr><td rowspan="1" colspan="1">
<bold>Age</bold>

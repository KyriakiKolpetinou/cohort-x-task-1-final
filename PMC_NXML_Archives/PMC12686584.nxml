</aff><pub-date pub-type="epub"><day>08</day><month>12</month><year>2025</year></pub-date><pub-date pub-type="collection"><month>12</month><year>2025</year></pub-date><volume>6</volume><issue seq="480">12</issue><issue-id pub-id-type="doi">10.1002/mco2.v6.12</issue-id><elocation-id>e70523</elocation-id><history>

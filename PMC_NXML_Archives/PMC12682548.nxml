<article-meta><article-id pub-id-type="pmid">41367728</article-id><article-id pub-id-type="pmc">12682548</article-id><article-id pub-id-type="publisher-id">qims-15-12-11870</article-id><article-id pub-id-type="doi">10.21037/qims-2025-897</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Article</subject></subj-group></article-categories><title-group><article-title>Feasibility of alternative trigger deletion to improve 64-slice coronary computed tomography angiography quality in patients with increased heart rate</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Shao</surname><given-names>Lin</given-names></name><xref rid="aff1" ref-type="aff">

</aff><pub-date pub-type="epub"><day>26</day><month>10</month><year>2025</year></pub-date><pub-date pub-type="collection"><month>11</month><year>2025</year></pub-date><volume>6</volume><issue seq="140">11</issue><issue-id pub-id-type="doi">10.1002/mco2.v6.11</issue-id><elocation-id>e70436</elocation-id><history>
<date date-type="rev-recd"><day>22</day><month>9</month><year>2025</year></date>

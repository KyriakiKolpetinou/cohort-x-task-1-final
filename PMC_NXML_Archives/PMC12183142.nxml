<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">EJNMMI Res</journal-id><journal-id journal-id-type="iso-abbrev">EJNMMI Res</journal-id><journal-title-group><journal-title>EJNMMI Research</journal-title></journal-title-group><issn pub-type="epub">2191-219X</issn><publisher><publisher-name>Springer Berlin Heidelberg</publisher-name><publisher-loc>Berlin/Heidelberg</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">40544409</article-id><article-id pub-id-type="pmc">12183142</article-id><article-id pub-id-type="publisher-id">1276</article-id><article-id pub-id-type="doi">10.1186/s13550-025-01276-w</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Research</subject></subj-group></article-categories><title-group><article-title>Head to head comparison of two PET/CT imaging agents, [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) and [<sup>18</sup>F]AV45, in patients with alzheimer&#x02019;s disease</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes" equal-contrib="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-0612-1239</contrib-id><name><surname>Alexoff</surname><given-names>David</given-names></name><address><email>david.alexoff@fiveelevenpharma.com</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" corresp="yes" equal-contrib="yes"><name><surname>Wong</surname><given-names>Dean F.</given-names></name><address><email>dfwong@wustl.edu</email></address><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Kuwabara</surname><given-names>Hiroto</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Dannals</surname><given-names>Robert F.</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Ploessl</surname><given-names>Karl</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Kung</surname><given-names>Hank F.</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><aff id="Aff1"><label>1</label>Five Eleven Pharma Inc, Suite 305 3700 Market St, Philadelphia, PA USA </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/00za53h95</institution-id><institution-id institution-id-type="GRID">grid.21107.35</institution-id><institution-id institution-id-type="ISNI">0000 0001 2171 9311</institution-id><institution>Department of Radiology, </institution><institution>Johns Hopkins University School of Medicine, </institution></institution-wrap>Baltimore, MD USA </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/00b30xv10</institution-id><institution-id institution-id-type="GRID">grid.25879.31</institution-id><institution-id institution-id-type="ISNI">0000 0004 1936 8972</institution-id><institution>Department of Radiology, </institution><institution>University of Pennsylvania, </institution></institution-wrap>Philadelphia, PA USA </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01yc7t268</institution-id><institution-id institution-id-type="GRID">grid.4367.6</institution-id><institution-id institution-id-type="ISNI">0000 0004 1936 9350</institution-id><institution>Mallinckrodt Institute of Radiology, </institution><institution>Washington University in St Louis, </institution></institution-wrap>510 South Kingshighway Boulevard Campus Box 8225, 63110 St Louis, MO USA </aff></contrib-group><pub-date pub-type="epub"><day>22</day><month>6</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>22</day><month>6</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>15</volume><elocation-id>77</elocation-id><history><date date-type="received"><day>4</day><month>3</month><year>2025</year></date><date date-type="accepted"><day>15</day><month>6</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">A new &#x003b2;-amyloid (A&#x003b2;) targeting radiotracer, [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129), for diagnosis of Alzheimer&#x02019;s disease (AD) is reported. This radiotracer is a deuterated N-methyl derivative of Amyvid (AV-45, florbetapir f18) which was FDA-approved in 2013. Deuteration may alter a tracer&#x02019;s PK such that imaging performance is improved. A head-to-head comparison between these two imaging agents was conducted in AD patients. A separate biodistribution study was conducted on six healthy subjects, and radiation dosimetry estimation was obtained.</p></sec><sec><title>Results</title><p id="Par2">Eight patients, clinically diagnosed with Alzheimer&#x02019;s disease, had an average age of 61.1&#x02009;&#x000b1;&#x02009;10.0 years, and an average MMSE score of 21&#x02009;&#x000b1;&#x02009;4. Each patient underwent paired 90-minute dynamic PET/CT scans separately within a few weeks (323&#x02009;&#x000b1;&#x02009;31 MBq of [<sup>18</sup>F]D3FSP or [<sup>18</sup>F]AV45; florbetapir f18). SUVR (50&#x02013;70&#x000a0;min) and Distribution Volume Ratio (DVR) of 43 brain regions were evaluated. The average SUVR across cortical gray matter was 1.65&#x02009;&#x000b1;&#x02009;0.21 for [<sup>18</sup>F]AV45 and 1.65&#x02009;&#x000b1;&#x02009;0.23 for [<sup>18</sup>F]D3FSP, while global DVRs were 1.36&#x02009;&#x000b1;&#x02009;0.14 and 1.37&#x02009;&#x000b1;&#x02009;0.13 for [<sup>18</sup>F]AV45 and [<sup>18</sup>F]D3FSP respectively. Strong correlations (R<sup>2</sup>&#x02009;=&#x02009;0.8&#x02013;0.9) were observed between tracers for both SUVR and DVR, with slopes of ~&#x02009;0.9 (SUVR) and ~&#x02009;1 (DVR). No image artifacts or confounds influenced the visual interpretation of [<sup>18</sup>F]D3FSP compared to [<sup>18</sup>F]AV45.</p></sec><sec><title>Conclusions</title><p id="Par3">Results showed no difference between [<sup>18</sup>F]D3FSP and [<sup>18</sup>F]AV45 and no benefit of deuteration at the N-methyl site. Even so, [<sup>18</sup>F]D3FSP may be a useful alternative for PET/CT imaging of A&#x003b2; deposits in the brain as its binding characteristics were very similar to its non-deuterated analog, the FDA-approved drug [<sup>18</sup>F]AV45.</p></sec><sec><title>Trial registration</title><p id="Par4">Clinicaltrials.org, NCT03902548. Registered 01/07/2018.</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1186/s13550-025-01276-w.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Brain</kwd><kwd>Alzheimer&#x02019;s disease</kwd><kwd>Diagnostic imaging and &#x003b2;-amyloid plaques</kwd></kwd-group><funding-group><award-group><funding-source><institution>Five Eleven Pharma Inc</institution></funding-source><award-id>Five Eleven Pharma Inc</award-id></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer-Verlag GmbH Germany, part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par5">Positron Emission Tomography (PET) imaging is the primary tool available to clinicians for assessing the presence and distribution of A&#x003b2; aggregates, a hallmark of Alzheimer&#x02019;s Disease (AD) [<xref ref-type="bibr" rid="CR1">1</xref>&#x02013;<xref ref-type="bibr" rid="CR3">3</xref>], in the living human brain. Three <sup>18</sup>F-imaging agents targeting A&#x003b2; plaques in the brain have been approved for clinical use by the US Food and Drug Administration (FDA) and the European Medicines Agency (EMA): [<sup>18</sup>F]AV-45 ([<sup>18</sup>F]florbetapir; Amyvid&#x02122;) [<xref ref-type="bibr" rid="CR4">4</xref>], [<sup>18</sup>F]AV-1 ([<sup>18</sup>F]florbetaben; Neuraceq&#x02122;) [<xref ref-type="bibr" rid="CR5">5</xref>], and [<sup>18</sup>F]3&#x02032;-F-PIB ([<sup>18</sup>F]flutemetamol; Vizamyl&#x02122;) [<xref ref-type="bibr" rid="CR6">6</xref>]. Using these tracers, amyloid PET has demonstrated clinical utility in managing of patients with a diagnosis of either unexplained mild cognitive impairment (MCI) or dementia of uncertain origin [<xref ref-type="bibr" rid="CR7">7</xref>].</p><p id="Par6">There has been a renewed interest in amyloid PET due to the recent FDA approvals of lecanemab (Leqembi) [<xref ref-type="bibr" rid="CR8">8</xref>] and Donanemab (Kisunla) [<xref ref-type="bibr" rid="CR9">9</xref>], both monoclonal antibodies designed for removing soluble and insoluble A&#x003b2; in the brain. Both Kisunla and Leqembi are now commercially available for treatment of AD.</p><p id="Par7">A prerequisite for any anti-plaque treatment is the detection of A&#x003b2; aggregates in the brain using PET imaging, particularly in cognitively normal aging individuals and patients with MCI or early dementia [<xref ref-type="bibr" rid="CR9">9</xref>]. However, determining amyloid positivity in this population can be challenging due to the lower amyloid loads commonly observed and the high off-target binding to white matter, a characteristic of current amyloid PET tracers [<xref ref-type="bibr" rid="CR10">10</xref>]. As part of our ongoing efforts to develop improved A&#x003b2; PET tracers, we have designed an N-deuterated version of AV-45. Recent preclinical studies suggest that this new N-deuterated radiotracer exhibits comparable affinity and selectivity for A&#x003b2; plaques to [<sup>18</sup>F]AV-45 in the brain [<xref ref-type="bibr" rid="CR11">11</xref>]. Additionally, deuterium substitution is a well-established strategy in PET drug design to enhance pharmacokinetics, primarily by reducing the formation of radioactive metabolites that could degrade imaging performance [<xref ref-type="bibr" rid="CR12">12</xref>]. Collectively, these properties of [18F]D3FSP may enhance the detectability of A&#x003b2; species compared to conventional AV-45. Reported herein are the results of a head-to-head comparison study using [<sup>18</sup>F]D3FSP and [<sup>18</sup>F]AV-45 in eight (8) AD patients to evaluate the effects of N-methyl deuteriation on imaging metrics of amyloid plaque specific binding. In addition, a separate biodistribution study was conducted using [<sup>18</sup>F]D3FSP in six healthy subjects for radiation dosimetry estimation.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Study design</title><p id="Par8">[<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) was studied in eight AD patients (NCT03902548) under IND 137,713. This study was approved by the institutional review boards at Johns Hopkins Medicine (IRB# 00147896) and complied with the Health Insurance Portability and Accountability Act (HIPAA). Written informed consent was obtained for each enrolled subject. To compare tracer pharmacokinetics, AD patients were administered both [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) and [<sup>18</sup>F]AV-45 on different days. The chemical structures of [<sup>18</sup>F]D3FSP and [<sup>18</sup>F]AV-45 appear in Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>.</p><p id="Par9">
<fig id="Fig1"><label>Fig. 1</label><caption><p>Chemical structures of [<sup>18</sup>F]AV45 and [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129). The structures are identical except for a N-deuterated methyl group marked in red.</p></caption><graphic xlink:href="13550_2025_1276_Fig1_HTML" id="d33e382"/></fig>
</p></sec><sec id="Sec4"><title>Subjects</title><p id="Par10">Patients with AD had to be at least 50 years and had to have a diagnosis of probable AD, according to the National Institute of Neurological and Communicative Disorders and Stroke/Alzheimer&#x02019;s Disease and Related Disorders Association criteria, with a Mini-Mental State Examination (MMSE) score of at least 15 and not greater than 26. Patients were excluded if they showed evidence of any other significant neurodegenerative or psychiatric disease on clinical examination or MRI or exhibited clinically significant medical comorbidities that might pose a safety risk to the subject or interfere with the interpretation of the scan.</p></sec><sec id="Sec5"><title>PET imaging visits</title><p id="Par11">[<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) was prepared at the Johns Hopkins PET Radiotracer Center using an Elixys automated radio synthesizer (Sofie Biosciences, Dulles VA), including HPLC purification (see supplemental information for complete method). The final [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) dose was formulated with 1 mL of ethanol followed by 10 mL of 0.9% sodium chloride (from a 50 mL vial containing 338&#x000a0;mg ascorbic acid) via a sterilizing 0.22&#x000a0;&#x003bc;m filter into a sterile vial containing 4 mL 0.9% sodium chloride. [<sup>18</sup>F]AV45 (florbetapir f18) was obtained commercially (PETNET Solutions, Knoxville TN).</p><p id="Par12">AD patients were scanned dynamically (brain only) for 90&#x000a0;min starting immediately after injection of either [<sup>18</sup>F]AV-45 (~&#x02009;300 MBq) or [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) (~&#x02009;300 MBq) using a GE Advance (PET only) machine. Transmission scans were obtained before tracer administration to correct for attenuation. [<sup>18</sup>F]AV-45 and [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) scans were generally obtained within ~&#x02009;4 weeks of each other.</p><p id="Par13">Whole blood for plasma metabolite analysis was obtained from a second venous catheter at 5, 20, 45 and 90&#x000a0;min for each radiotracer injection. Plasma was analyzed by HPLC for the presence of parent radiotracer [<xref ref-type="bibr" rid="CR13">13</xref>].</p></sec><sec id="Sec6"><title>MR image acquisition</title><p id="Par14">MRI scans of the brain were acquired within approximately one week prior to the PET scans. A Phillips 3.0T Achieva MRI instrument was used with an 8-channel head coil (Philips Medical Systems, Best, Netherlands). The magnetization-prepared rapid acquisition with gradient-echo (MPRAGE) pulse sequence (TE&#x02009;=&#x02009;4, TR&#x02009;=&#x02009;8.9, flip angle&#x02009;=&#x02009;8 degrees, NSA&#x02009;=&#x02009;1, 0.7&#x000a0;mm isotropic voxel size) was used to obtain MR images for subsequent PET image processing.</p></sec><sec id="Sec7"><title>MRI processing and analysis</title><p id="Par15">MPRAGE images were processed using FreeSurfer (FS; v7.2) [<xref ref-type="bibr" rid="CR14">14</xref>] for automated segmentation of left and right cortical and subcortical volumes of interest (VOIs) and whole cerebellum gray matter [<xref ref-type="bibr" rid="CR15">15</xref>]. The whole cerebellum gray matter VOI (Cb) was manually corrected for mis-inclusion of the venous sinuses. The superior 2&#x000a0;mm of the Cb were removed to reduce contamination of activity from the supra-tentorial structures. VOIs were transferred from MRI to PET space using parameters that were obtained using the co-registration module of the Statistical Parametric Mapping, version 12 (SPM12; Institute of Neurology, London) running on MATLAB 7.10 (MathWorks, Natick, Massachusetts).</p></sec><sec id="Sec8"><title>Brain PET image analysis</title><p id="Par16">Data was collected in 3D directly into 30 timeframes (4&#x02009;&#x000d7;&#x02009;15s; 4&#x02009;&#x000d7;&#x02009;30s; 3&#x02009;&#x000d7;&#x02009;60s; 2&#x02009;&#x000d7;&#x02009;120s; 5&#x02009;&#x000d7;&#x02009;240s; 12&#x02009;&#x000d7;&#x02009;300s) totaling 90&#x000a0;min. Image data was reconstructed after preprocessing (3D Kinahan&#x02013;Rogers) and single slice rebinning (SSRB) using filtered back projection (GE Advance software 6.00). PET quantification of the AD patient brain images included regional standardized uptake value ratios (SUVR) and distribution volume ratios (DVR), including 43 brain regions, left and right merged. Brain regions included gray and white matter ranging in volume from &#x0003c;&#x02009;1&#x000a0;cc (ventral striatum) to &#x0003e;&#x02009;30&#x000a0;cc (cerebellar white matter). See supplemental information Figures <xref rid="MOESM1" ref-type="media">S1</xref> and <xref rid="MOESM1" ref-type="media">S2</xref> for a complete listing of regions. Regional DVRs were obtained using the reference tissue graphical analysis [<xref ref-type="bibr" rid="CR16">16</xref>] with t* set at 25&#x000a0;min and k2R at 0.149&#x000a0;min<sup><bold>&#x02212;&#x02009;1</bold></sup> after evaluating 0.038, 0.045, and 0.09&#x000a0;min<sup>&#x02212;&#x02009;1</sup> to produce similar regional DVR values. SUVR was computed on images summed from 50 to 70&#x000a0;min post-injection. Cerebellar gray matter was used as a reference region. Regression lines with correlation coefficients, confidence intervals and standard deviations for graphical and/or tabulated data were determined using Excel (version 16.77, Microsoft, Redmond, Washington).</p><p id="Par17">The agreement between DVR and SUVR data from the two tracers was evaluated using test-retest repeatability (TRT repeatability), calculated as the difference over the mean, and test-retest variability (TRT variability), calculated as the absolute difference over the mean. A relatively stringent reproducibility criterion was applied, requiring: (1) no systematic bias, with the upper and lower confidence intervals (CIs) of TRT repeatability remaining within &#x000b1;&#x02009;10% in the Bland-Altman plot, and (2) TRT variability across all regions remaining below 5% [<xref ref-type="bibr" rid="CR17">17</xref>]. The white matter regions and subcortical gray matter regions were excluded from the test-retest evaluation [<xref ref-type="bibr" rid="CR18">18</xref>].</p></sec><sec id="Sec9"><title>Whole body radiation dosimetry of [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129)</title><p id="Par18">Six volunteers underwent whole-body scanning for dosimetry calculation using a GE Discovery RX PET/CT with multiple bed positions starting soon after injection of [<sup>18</sup>F]D3FSP. Radioactivity concentrations were measured in various organs at 10 timepoints starting from time of injection up to 4&#x000a0;h after injection. The tissue data (Bq/ml) were converted to %/organ using standard human organ masses. Values of the percent of injected activity per organ were fit using the SAAM II software [<xref ref-type="bibr" rid="CR19">19</xref>]. Time integrals of activity [<xref ref-type="bibr" rid="CR20">20</xref>] were entered into the OLINDA/EXM software [<xref ref-type="bibr" rid="CR21">21</xref>] using the adult male and female models, and gender-averaged doses were reported. The disintegrations in the &#x02018;remainder of body&#x02019; were assumed to equal 100% of the activity administered, determined by integrating the total decay of <sup>18</sup>F, minus the disintegrations in other body organs.</p></sec></sec><sec id="Sec10"><title>Results</title><sec id="Sec11"><title>Subject demographics</title><p id="Par19">Eight subjects with clinically diagnosed AD were enrolled (mean age: 61.1&#x02009;&#x000b1;&#x02009;10.0 years [SD], range: 50&#x02013;77; 5 males, 3 females). The average Mini-Mental State Examination (MMSE) score was 21&#x02009;&#x000b1;&#x02009;4 [SD], with a range of 15&#x02013;26.</p></sec><sec id="Sec12"><title>Plasma metabolites</title><p id="Par20">The results of the plasma metabolite assay are summarized in Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref> below. The was no difference in parent (left panel) or the des-methyl metabolite (right panel) fractions for [<sup>18</sup>F]D3FSP and [<sup>18</sup>F]AV-45 over the time course of imaging. See Supplemental Figure <xref rid="MOESM1" ref-type="media">S3</xref> for a representative HPLC radio-chromatogram.</p><p id="Par21">
<fig id="Fig2"><label>Fig. 2</label><caption><p>In vivo metabolism in the plasma of AD patients - parent (left panel) and des-methyl (right panel) fractions in the plasma from 8 AD patients. The measured values are displayed as the mean (circles) and standard deviation (upward error bar).</p></caption><graphic xlink:href="13550_2025_1276_Fig2_HTML" id="d33e513"/></fig>
</p></sec><sec id="Sec13"><title>Comparison of [<sup>18</sup>F]AV-45 and [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) in AD patients</title><p id="Par22">Each AD patient received paired 90-minute dynamic scans of 336&#x02009;&#x000b1;&#x02009;36 MBq [<sup>18</sup>F]AV45 and 310&#x02009;&#x000b1;&#x02009;18 MBq [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) within a mean of 17&#x02009;&#x000b1;&#x02009;17 (SD) days of each other (range 3&#x02013;55 days). Synthesis of [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) was accomplished at high specific activity (2125&#x02009;&#x000b1;&#x02009;505 (SD) GBq/mmole).</p><p id="Par23">Visual inspection of the [18&#x000a0;F]D3FSP ([18&#x000a0;F]P16-129) and [18&#x000a0;F]AV45 images reveals similar tracer distributions with some subtle differences, as exemplified in Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>. We found no evidence that image artifacts or confounds affected the quantification of [18&#x000a0;F]D3FSP ([18&#x000a0;F]P16-129) compared to [18&#x000a0;F]AV45. An experienced Nuclear Medicine physician (D.F.W.) certified to read the FDA interpretation of [18&#x000a0;F]AV45 and comparison across tracers identified one amyloid-negative subject (S001) and 7 amyloid-positive subjects for both tracers using the AVID-established clinical review criteria [<xref ref-type="bibr" rid="CR4">4</xref>].</p><p id="Par24">
<fig id="Fig3"><label>Fig. 3</label><caption><p>Summed (50&#x02013;70&#x000a0;min) trans-axial images (Bq/cc) of [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) and [<sup>18</sup>F]AV45 in the same patient from two subjects with low and high amyloid loads measured as DVR</p></caption><graphic xlink:href="13550_2025_1276_Fig3_HTML" id="d33e559"/></fig>
</p><p id="Par25">When pooling data from all subjects, regional DVR values from the two tracers were distributed along the identity line and exhibited a strong correlation (Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>, left panel). In scatter plots of individual subjects (see Figure S5) which demonstrated high correlations (R&#x000b2; range: 0.893&#x02013;0.977), subtle variations in slope (range: 0.77&#x02013;1.08) may have contributed to the scatter observed in the pooled data. The Bland-Altman plot of TRT repeatability for DVR data (right panel) showed no systematic bias, with the upper and lower CIs close to &#x000b1;&#x02009;10%. The average TRT variability across all regions was 4.4% (SD: 3.1%). These results indicate that the DVR data from the two tracers demonstrated agreement comparable to the test-retest scans of a tracer with good reproducibility. The average DVR across subjects for each of the 43 brain gray and white matter regions is depicted in the supplemental material Figure <xref rid="MOESM1" ref-type="media">S1</xref> for [<sup>18</sup>F]AV45 and Figure <xref rid="MOESM1" ref-type="media">S2</xref> for [<sup>18</sup>F]D3FSP.</p><p id="Par26">
<fig id="Fig4"><label>Fig. 4</label><caption><p>Scatter plot (left panel) of regional DVR data, [<sup>18</sup>F]AV45 (=&#x02009;y-axis) vs. [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) (=&#x02009;x-axis), pooling data from all subjects. The red dotted lines represent the 95% confidence intervals (CI). Bland-Altman plot (right panel) of test-retest repeatability</p></caption><graphic xlink:href="13550_2025_1276_Fig4_HTML" id="d33e591"/></fig>
</p><p id="Par27">The two tracers exhibited a strong and nearly identical SUVR-to-DVR relationship (Fig.&#x000a0;<xref rid="Fig5" ref-type="fig">5</xref>) for pooled data from all patients. Regional SUVR values were approximately 40% higher than regional DVR values for both tracers. The regression lines intersected at or near the theoretical origin (=&#x02009;1,1). Thus, SUVR is an excellent surrogate for DVR for [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) as well.</p><p id="Par28">
<fig id="Fig5"><label>Fig. 5</label><caption><p>Scatter plots (SUVR&#x02009;=&#x02009;y) versus DVR for [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) (right panel) and ([<sup>18</sup>F]AV45 (left panel)</p></caption><graphic xlink:href="13550_2025_1276_Fig5_HTML" id="d33e617"/></fig>
</p><p id="Par29">Regional SUVR data from the two tracers exhibited a strong correlation and were scattered along the identity line (Fig.&#x000a0;<xref rid="Fig6" ref-type="fig">6</xref>, left panel). The Bland-Altman plot of TRT repeatability for SUVR data (right panel) showed no systematic bias; however, the upper and lower CIs exceeded&#x02009;&#x000b1;&#x02009;15%. The average TRT variability across all regions was 6.6% (SD: 5.0%). These results indicate that the agreement of regional SUVR data between the tracers was slightly compromised compared to regional DVR data and the established good reproducibility criteria. Interestingly, subjects with deviated slopes in the scatter plots of regional DVR data (slope range: 0.89&#x02013;1.22, Figure S4) exhibited slightly greater deviations in the scatter plots of regional SUVR data (slope range: 0.82&#x02013;1.32, Supplemental Figure <xref rid="MOESM1" ref-type="media">S6</xref>). This suggests that the slightly higher scatter in individual SUVR data may have contributed to the slightly compromised agreement of SUVR data between the two tracers. However, the underlying causes of this compromised agreement remain unclear.</p><p id="Par30">
<fig id="Fig6"><label>Fig. 6</label><caption><p>Scatter plot (left panel) of pooled regional SUVR data from all eight (8) AD patients. Bland-Altman (right panel) plot of test-retest repeatability</p></caption><graphic xlink:href="13550_2025_1276_Fig6_HTML" id="d33e635"/></fig>
</p><p id="Par31">Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref> summarizes the mean cortical DVR and SUVR values for individual subjects. The mean cortical DVR values of the two tracers showed a strong correlation: [&#x000b9;&#x02078;F]D3FSP&#x02009;=&#x02009;0.997&#x000b7;[&#x000b9;&#x02078;F]AV45&#x02013;0.002 (R&#x000b2; = 0.86). No systematic bias was observed, with CIs of TRT repeatability within &#x000b1;&#x02009;8.5% and an average TRT variability of 3.4% (SD: 2.3%). These results indicate that the mean cortical DVR values of the two tracers demonstrated agreement comparable to that of test-retest scans for a tracer with good reproducibility. The mean cortical SUVR values of the two tracers showed a slightly weaker correlation: [&#x000b9;&#x02078;F]D3FSP&#x02009;=&#x02009;0.908&#x000b7;[&#x000b9;&#x02078;F]AV45&#x02013;0.153 (R&#x000b2; = 0.690). Despite a negligible bias, the CIs exceeded&#x02009;&#x000b1;&#x02009;15% in the Bland Altman plot of TRT repeatability. The TRT variability averaged at 6.2% (SD: 4.8%). Applying a published amyloid positivity SUVR cutoff value [<xref ref-type="bibr" rid="CR22">22</xref>] for AV45, all subjects were classified as amyloid positive for both tracers.</p><p id="Par32">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Subject demographics and study results summary</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2">Subject</th><th align="left" rowspan="2">Sex</th><th align="left" rowspan="2">Age</th><th align="left" rowspan="2">MMSE</th><th align="left" rowspan="2">[<sup>18</sup>F]D3FSP<break/>(GBq/mmol)</th><th align="left" colspan="2">DVR (mc gray matter)</th><th align="left" colspan="2">SUVR (mc gray matter)</th></tr><tr><th align="left">[<sup>18</sup>F]D3FSP</th><th align="left">[<sup>18</sup>F]AV45</th><th align="left">[<sup>18</sup>F]D3FSP</th><th align="left">[<sup>18</sup>F]AV45</th></tr></thead><tbody><tr><td align="left">S0001</td><td align="left">F</td><td char="." align="char">71</td><td char="." align="char">25</td><td char="." align="char">3065</td><td char="." align="char">1.17</td><td char="." align="char">1.25</td><td char="." align="char">1.37</td><td char="." align="char">1.58</td></tr><tr><td align="left">S0002</td><td align="left">M</td><td char="." align="char">51</td><td char="." align="char">26</td><td char="." align="char">1871</td><td char="." align="char">1.14</td><td char="." align="char">1.15</td><td char="." align="char">1.25</td><td char="." align="char">1.29</td></tr><tr><td align="left">S0004</td><td align="left">M</td><td char="." align="char">62</td><td char="." align="char">21</td><td char="." align="char">1521</td><td char="." align="char">1.52</td><td char="." align="char">1.48</td><td char="." align="char">1.95</td><td char="." align="char">1.85</td></tr><tr><td align="left">S0005</td><td align="left">M</td><td char="." align="char">65</td><td char="." align="char">22</td><td char="." align="char">2462</td><td char="." align="char">1.32</td><td char="." align="char">1.24</td><td char="." align="char">1.66</td><td char="." align="char">1.45</td></tr><tr><td align="left">S0008</td><td align="left">M</td><td char="." align="char">56</td><td char="." align="char">17</td><td char="." align="char">2264</td><td char="." align="char">1.40</td><td char="." align="char">1.40</td><td char="." align="char">1.78</td><td char="." align="char">1.80</td></tr><tr><td align="left">S0009</td><td align="left">F</td><td char="." align="char">50</td><td char="." align="char">15</td><td char="." align="char">1804</td><td char="." align="char">1.44</td><td char="." align="char">1.38</td><td char="." align="char">1.65</td><td char="." align="char">1.56</td></tr><tr><td align="left">S0010</td><td align="left">M</td><td char="." align="char">73</td><td char="." align="char">26</td><td char="." align="char">2347</td><td char="." align="char">1.49</td><td char="." align="char">1.51</td><td char="." align="char">1.82</td><td char="." align="char">1.81</td></tr><tr><td align="left">S0011</td><td align="left">F</td><td char="." align="char">55</td><td char="." align="char">19</td><td char="." align="char">1664</td><td char="." align="char">1.44</td><td char="." align="char">1.51</td><td char="." align="char">1.76</td><td char="." align="char">1.88</td></tr><tr><td align="left">Mean</td><td align="left"/><td char="." align="char">61</td><td char="." align="char">21</td><td char="." align="char">2125</td><td char="." align="char">1.36</td><td char="." align="char">1.37</td><td char="." align="char">1.65</td><td char="." align="char">1.65</td></tr><tr><td align="left">SD</td><td align="left"/><td char="." align="char">10</td><td char="." align="char">4</td><td char="." align="char">508</td><td char="." align="char">0.14</td><td char="." align="char">0.13</td><td char="." align="char">0.21</td><td char="." align="char">0.23</td></tr></tbody></table><table-wrap-foot><p>MMSE - Mini-Mental State Examination; mc - mean cortical; SD - standard deviation</p></table-wrap-foot></table-wrap>
</p></sec><sec id="Sec14"><title>Whole-body dosimetry of [<sup>18</sup>F]D3FSP</title><p id="Par33">Six healthy volunteers (3 male and 3 female; age, mean 26.6y&#x02009;&#x000b1;&#x02009;5.6 (SD) range 23&#x02013;36) underwent whole-body scanning after administration of 324&#x02009;&#x000b1;&#x02009;32 MBq of [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129). The effective dose of [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) was calculated to be 0.015 mSv/MBq, similar to published values (0.013&#x02013;0.019 mSv/MBq) for [<sup>18</sup>F]AV45 [<xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR24">24</xref>]. The target organ was the gallbladder (0.084 mGy/MBq), with the subsequent highest doses found in the liver (0.038 mGy/MBq) and urinary bladder wall (0.033 mGy/MBq). The complete organ dose table can be found in the supplemental material (Table <xref rid="MOESM1" ref-type="media">S1</xref>). The data showed that radiation dose from [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) is within acceptable limits for human use.</p></sec></sec><sec id="Sec15"><title>Discussion</title><p id="Par34">In this head-to-head comparison study of eight (8) AD patients, [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) showed comparable binding properties to the FDA-approved drug [<sup>18</sup>F]AV45, demonstrating a similar contrast in AD patients with various degrees of amyloid-&#x003b2; load. The overall imaging performance of [18F]D3FSP was similar to that of [18F]AV45, and no obvious effect of deuteration was detected.. Quantitative measures, including DVR and SUVR, were nearly identical on average, with subtle individual differences that may be inevitable due to the repeated-measure design involving separate-day scans. Individual differences between the two tracers generally fell within the test-retest error margin observed with tracers of established reproducibility as discussed below. Importantly, clinical readings showed no difference between [<sup>18</sup>F]D3FSP and [<sup>18</sup>F]AV45 in this small sample group. Though no benefit of deuteration was found, this study, including regions with low amyloid-&#x003b2; loads strongly suggested that [<sup>18</sup>F]D3FSP could be as suitable as [<sup>18</sup>F]AV45 for detecting minimal accumulation of amyloid-&#x003b2; in older subjects with normal cognition and mild cognitive impairment (MCI).</p><p id="Par35">Regarding comparison of quantitative measures, regional and mean cortical SUVR data showed slightly compromised agreement relative to our predefined criteria for good reproducibility. However, this insufficiency is unlikely to be significant. First, the calculated TRT variability of regional SUVR data (6.6%) was comparable to the published TRT variability estimate for [&#x000b9;&#x02078;F]AV45 (7.4%; [<xref ref-type="bibr" rid="CR18">18</xref>]). Second, [&#x000b9;&#x02078;F]D3FSP and [&#x000b9;&#x02078;F]AV45 demonstrated a strong correlation in mean cortical SUVR, similar to head-to-head comparisons of other established amyloid-targeting radiotracers against [&#x000b9;&#x02078;F]AV45 [<xref ref-type="bibr" rid="CR25">25</xref>, <xref ref-type="bibr" rid="CR26">26</xref>] using cerebellar gray matter (Cb-GM) as the reference region. One possible explanation for the slightly lower between-tracer agreement, compared to early test-retest evaluations of [&#x000b9;&#x02078;F]AV45 [<xref ref-type="bibr" rid="CR27">27</xref>], for example, is that the binding affinities toward amyloid-beta species and plaques may inherently differ between tracers. Although using alternative reference regions has been reported to improve between-tracer SUVR correlations (32), the significance of these improvements is unclear, given that Cb-GM typically exhibits the lowest specific binding among established amyloid-targeting radiotracers (e.g [<xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR27">27</xref>, <xref ref-type="bibr" rid="CR28">28</xref>]). Similarly, the use of alternative reference regions resulted in degraded [&#x000b9;&#x02078;F]D3FSP&#x02013;[&#x000b9;&#x02078;F]AV45 correlations for both DVR and SUVR data.</p><p id="Par36">A primary goal of this work was to evaluate any benefit of deuterium substitution on the imaging performance of [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) compared to [<sup>18</sup>F]AV45 in the same AD patient. [<sup>18</sup>F]AV45 is known to metabolize in humans rapidly [<xref ref-type="bibr" rid="CR23">23</xref>], with two brain-penetrating, mildly lipophilic metabolites showing low plaque binding affinity identified in pre-clinical studies [<xref ref-type="bibr" rid="CR29">29</xref>] (see also Figure S4). It was hypothesized that these lipophilic metabolites could contribute to off-target binding in the brain during A&#x003b2; plaque imaging, reducing image contrast and decreasing measures of specific binding like DVR or SUVR. If true, reducing the generation of these radioactive metabolites by slowing peripheral metabolism using deuterium substitution might improve image contrast and quantitative measures of plaque binding. No effect of deuteration was observed from analysis of the plasma metabolite data. Both parent and des-methyl metabolite (radiolabeled) fractions in plasma were not significantly different for [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) and [<sup>18</sup>F]AV45. Furthermore, imaging results of this head-to-head comparison study showed no significant difference between [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) and [<sup>18</sup>F]AV45, either visually or quantitatively, by DVR or SUVR, in both white and gray matter regions. Thus, this small sample could not demonstrate any benefit of deuterium substitution at the N-methyl position.</p><p id="Par37">Another consideration of this research is the potential role of a new &#x003b2;-amyloid plaque imaging tracer in providing better access for patients in countries not served by today&#x02019;s commercially available radiotracers. Although three FDA-approved &#x003b2;-amyloid plaque imaging agents are already available in the US, Japan, and European countries, they are not widely distributed in large, populated regions, such as in China, South America, Africa and India, where millions of AD patients or potential AD patients are located. For example, there is only one amyloid PET imaging tracer approved by the national regulatory body in China (NMPA) [<xref ref-type="bibr" rid="CR30">30</xref>], and it was approved 9 years after the initial approval in the US. Meanwhile, Kinsula was also recently just approved in China [<xref ref-type="bibr" rid="CR31">31</xref>]. The demand for &#x003b2;-amyloid plaque imaging in China will likely increase in response to this approval and continue to strengthen as more anti-plaque treatments for AD become available.</p><p id="Par38">Furthermore, China is one of the fastest aging countries in the world, and faces unique challenges in preparing for an increase in AD patients compared with countries in Europe, US and elsewhere [<xref ref-type="bibr" rid="CR32">32</xref>]. A recent study modeling China&#x02019;s preparedness for caring for future AD patients concluded that a major bottleneck was the lack in number of PET scanners and access to confirmatory biomarkers [<xref ref-type="bibr" rid="CR32">32</xref>]. Low aggregate PET scanner densities exist in all but high-income nations across the world [<xref ref-type="bibr" rid="CR33">33</xref>]. Access to PET scanning with appropriate tracers constitutes an unmet global clinical need, and it would be reasonable to develop additional &#x003b2;-amyloid plaque imaging agents for these large populations as PET scanner capacity increases. For example. China has made significant progress over the last decade increasing PET scanner availability, with further resources planned to address current shortages in radiopharmaceuticals [<xref ref-type="bibr" rid="CR34">34</xref>]. A new radiotracer, such as [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129), after approval by respective governmental agencies, could help alleviate patient access shortfalls in China and elsewhere.</p><p id="Par39">A limitation of this study is the small patient number. Final validation of the equivalency of [<sup>18</sup>F]D3FSP and [&#x000b9;&#x02078;F]AV45 imaging requires further study using a larger cohort. Secondly, clinical decision-making, such as in patient selection for antibody treatment, was not explicitly compared in this study, hence a conclusion of general clinical interchangeability should not yet be assumed. The clinical utility of [<sup>18</sup>F]D3FSP imaging in the diagnosis and staging of AD, however, was shown in an recent, independent study involving a large number of participants (203 patients) that spanned disease stage from cognitively normal to AD subjects [<xref ref-type="bibr" rid="CR35">35</xref>]. Taken together, these studies help to advance the validation of [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) as an amyloid-specific tracer appropriate for AD patient care.</p><p id="Par40">More data points would have been preferable for this study, but recruiting AD patients and the accompanying caretakers for back-to-back PET/CT imaging studies is an exceptionally difficult undertaking filled with unexpected setbacks. Despite the challenges of these logistic arrangements, eight AD patients eventually completed the required two PET/CT imaging sessions including multiple blood samples.</p></sec><sec id="Sec16"><title>Conclusions</title><p id="Par41">In conclusion, [<sup>18</sup>F]D3FSP ([<sup>18</sup>F]P16-129) is a highly specific A&#x003b2;-plaque binding tracer with almost identical performance to [<sup>18</sup>F]AV45, demonstrated in the same AD patients. Although improvement in specific binding metrics including SUVR and DVR could not be demonstrated by this study using selective deuteration, [<sup>18</sup>F]D3FSP has shown clinical utility in a large Chinese cohort of normal, MCI and AD subjects, and could help to expand access to amyloid PET in underserved regions in the world following regulatory approval and commercialization.</p></sec><sec id="Sec17" sec-type="supplementary-material"><title>Electronic supplementary material</title><p>Below is the link to the electronic supplementary material.</p><p>
<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="13550_2025_1276_MOESM1_ESM.docx"><caption><p>Supplementary Material 1</p></caption></media></supplementary-material>
</p></sec></body><back><fn-group><fn><p><bold>Publisher&#x02019;s note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn><fn><p>David Alexoff and Dean F. Wong contributed equally to this work.</p></fn></fn-group><ack><title>Acknowledgements</title><p>The authors thank the following individuals for their many contributions in patient care, clinical trial administration, scheduling, patient recruitment, MRI and PET scanning, data processing, radiosynthesis and plasma radio-assays: Kelly Kitzmiller, Ayon Nandi, Zabecca Brinson, Noble George, James Brasic, Hong Fan, Daniel Holt, Lorena Gapasin, Josh Roberts, Wojciech Lesniak, Weiguo Ye and Yun Zhou. The authors are also very grateful to all the volunteer subjects who participated in this study, their families and caregivers.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>DA, DW, HK, RD, KP and HFK contributed to the study conception and design. Material preparation (precursor and reference compound quality control) was performed by KP. Data analysis was carried out by HK. DA and DW were responsible for writing the first draft and all authors commented on subsequent drafts of the manuscript. All authors read and approved the final manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>This work was funded by Five Eleven Pharma, Inc.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>All image analysis data generated during this study are included in this published article and its supplementary information files. The datasets generated during and/or analyzed during the current study are available from the corresponding author on reasonable request.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par42">This study was performed in line with the principles of the Declaration of Helsinki. Approval was granted by the institutional review boards at Johns Hopkins Medicine (IRB# 00147896) and complied with the Health Insurance Portability and Accountability Act (HIPAA). Written informed consent was obtained for each enrolled subject.</p></notes><notes id="FPar2"><title>Consent for publication</title><p id="Par43">Not applicable.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing Interests</title><p id="Par44">Five Eleven Pharma Inc. is the sponsor of this study. Authors D.A. and K.P. are employees of Five Eleven Pharma and H.F.K. is the founder of Five Eleven Pharma, which holds the patent rights for D3FSP (P16-129) and related technology. D.F.W. is a paid consultant for Engrail Pharmaceuticals, LB Pharma Technologies (via WUSTL), and has contracts (WUSTL) with Eisai, Roche, and Intracellular Technologies. Other authors have no conflicts of interest or relevant financial activities to disclose.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Hardy</surname><given-names>J</given-names></name><name><surname>Allsop</surname><given-names>D</given-names></name></person-group><article-title>Amyloid deposition as the central event in the aetiology of alzheimer&#x02019;s disease</article-title><source>Trends Pharmacol Sci</source><year>1991</year><volume>12</volume><fpage>383</fpage><lpage>8</lpage><pub-id pub-id-type="doi">10.1016/0165-6147(91)90609-v</pub-id><pub-id pub-id-type="pmid">1763432</pub-id>

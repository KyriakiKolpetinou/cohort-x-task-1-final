">10.1161/hc0402.102975</pub-id><pub-id pub-id-type="pmid">11815441</pub-id></element-citation></ref><ref id="CR6"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>W</given-names></name><name><surname>Jeudy</surname><given-names>J</given-names></name></person-group><article-title>Assessment of myocarditis: cardiac MR, PET/CT, or PET/MR?</article-title><source>Curr Cardiol Rep</source><year>2019</year><volume>21</volume><fpage>76</fpage><pub-id pub-id-type="doi">10.1007/s11886-019-1158-0</pub-id><pub-id pub-id-type="pmid">31243587</pub-id></element-citation></ref><ref id="CR7"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Coulden</surname><given-names>RA</given-names></name><name><surname>Sonnex</surname><given-names>EP</given-names></name><name><surname>Abele</surname><given-names>JT</given-names></name><name><surname>Crean</surname><given-names>AM</given-names></name></person-group><article-title>Utility of FDG PET and Cardiac MRI in Diagnosis and Monitoring of Immunosuppressive Treatment in Cardiac Sarcoidosis</article-title><source>Radiology Cardiothoracic Imaging.</source><year>2020</year><volume>2</volume><fpage>e190140</fpage><pub-id pub-id-type="doi">10.1148/ryct.2020190140</pub-id><pub-id pub-id-type="pmid">33778595</pub-id></element-citation></ref><ref id="CR8"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cummings</surname><given-names>KW</given-names></name><name><surname>Bhalla</surname><given-names>S</given-names></name><name><surname>Javidan-Nejad</surname><given-names>C</given-names></name><name><surname>Bierhals</surname><given-names>AJ</given-names></name><name><surname>Gutierrez</surname><given-names>FR</given-names></name><name><surname>Woodard</surname><given-names>PK</given-names></name></person-group><article-title>A pattern-based approach to assessment of delayed enhancement in nonischemic cardiomyopathy at MR imaging</article-title><source>Radiographics</source><year>2009</year><volume>29</volume><fpage>89</fpage><lpage>103</lpage><pub-id pub-id-type="doi">10.1148/rg.291085052</pub-id><pub-id pub-id-type="pmid">19168838</pub-id></element-citation></ref><ref id="CR9"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dweck</surname><given-names>MR</given-names></name><name><surname>Abgral</surname><given-names>R</given-names></name><name><surname>Trivieri</surname><given-names>MG</given-names></name><name><surname>Robson</surname><given-names>PM</given-names></name><name><surname>Karakatsanis</surname><given-names>N</given-names></name><name><surname>Mani</surname><given-names>V</given-names></name><etal/></person-group><article-title>Hybrid magnetic resonance imaging and positron emission tomography with fluorodeoxyglucose to diagnose active cardiac sarcoidosis</article-title><source>JACC Cardiovasc Imaging.</source><year>2017</year><volume>11</volume><fpage>94</fpage><pub-id pub-id-type="doi">10.1016/j.jcmg.2017.02.021</pub-id><pub-id pub-id-type="pmid">28624396</pub-id></element-citation></ref><ref id="CR10"><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Ferreira</surname><given-names>VM</given-names></name><name><surname>Schulz-Menger</surname><given-names>J</given-names></name><name><surname>Holmvang</surname><given-names>G</given-names></name><name><surname>Kramer</surname><given-names>CM</given-names></name><name><surname>Carbone</surname><given-names>I</given-names></name><name><surname>Sechtem</surname><given-names>U</given-names></name><etal/></person-group><article-title>Cardiovascular magnetic resonance in nonischemic myocardial inflammation: expert recommendations</article-title><source>J Am Coll Cardiol</source><year>2018</year><volume>72</volume><fpage>3158</fpage><lpage>3176</lpage><pub-id pub-id-type
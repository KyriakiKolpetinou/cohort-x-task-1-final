<article-id pub-id-type="doi">10.1055/s-0045-1812307</article-id><article-id pub-id-type="publisher-id">WJNM-25-4-0008</article-id><article-categories><subj-group><subject>Review Article</subject></subj-group><series-title>Theranostics Implementation: Opportunities and Challenges</series-title><series-text>Guest Editors: Kunthi Pathmaraj, Andrew M. Scott</series-text></article-categories><title-group><article-title>Radiotheranostics in Low- and Middle-Income Countries: Challenges, Practice, and Prospects</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Lawal</surname><given-names>Ismaheel O.</given-names></name><xref rid="AF2540008-1" ref-type="aff">1</xref><xref rid="AF2540008-2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-3853-8995</contrib-id><name><surname>Ndlovu</surname><given-names>Honest</given-names></name><xref rid="AF2540008-2" ref-type="aff">2</xref><xref rid="AF2540008-3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Kabunda</surname><given-names>Joseph</given-names></name><xref rid="AF2540008-2" ref-type="aff">2</xref><xref rid="AF2540008-3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Mokoala</surname><given-names>Kgomotso M.</given-names></name><xref rid="AF2540008-2" ref-type="aff">2</xref><xref rid="AF2540008-3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-2806-0625</contrib-id><name><surname>Sathekge</surname><given-names>Mike M.</given-names></name><xref rid="AF2540008-2" ref-type="aff">2</xref><xref rid="AF2540008-3" ref-type="aff">3</xref><xref rid="CO2540008-1" ref-type="author-notes"/></contrib></contrib-group><aff id="AF2540008-1"><label>1</label><institution>Department of Radiology and Imaging Sciences, Emory University, Atlanta, Georgia, United States</institution></aff><aff id="AF2540008-2"><label>2</label><institution>Department of Nuclear Medicine, University of Pretoria, Pretoria, South Africa</institution></aff><aff id="AF2540008-3"><label>3</label><institution>Nuclear Medicine Research Infrastructure, Steve Biko Academic Hospital, Pretoria, South Africa</institution></aff><author-notes><corresp id="CO2540008-1"><bold>Address for correspondence </bold>Mike M. Sathekge, MD, PhD <institution>Department of Nuclear Medicine, University of Pretoria</institution><addr-line>Pretoria 0001</addr-line><country>South Africa</country><email>mike.sathekge@up.ac.za</email></corresp></author-notes><pub-date pub-type="epub"><day>14</day><month>10</month><year>2025</year></pub-date><pub-date pub-type="collection"><month>9</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>1</day><month>10</month><year>2025</year></pub-date><volume>24</volume><issue>3</issue><fpage>221</fpage><lpage>230</lpage><history/><permissions><copyright-statement>

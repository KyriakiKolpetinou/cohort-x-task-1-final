<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">BMC Pediatr</journal-id><journal-id journal-id-type="iso-abbrev">BMC Pediatr</journal-id><journal-title-group><journal-title>BMC Pediatrics</journal-title></journal-title-group><issn pub-type="epub">1471-2431</issn><publisher><publisher-name>BioMed Central</publisher-name><publisher-loc>London</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41136951</article-id><article-id pub-id-type="pmc">12553159</article-id>
<article-id pub-id-type="publisher-id">6177</article-id><article-id pub-id-type="doi">10.1186/s12887-025-06177-4</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>Correlation between positive fluid balances with venous excess ultrasound scores and lung ultrasound in critically ill children with fluid overload</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Utami</surname><given-names>Meita Dwi</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Prawira</surname><given-names>Yogi</given-names></name><address><email>dr.yogiprawira@gmail.com</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Djer</surname><given-names>Mulyadi M.</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Wulandari</surname><given-names>H.F.</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Yuniar</surname><given-names>Irene</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Kaswandani</surname><given-names>Nastiti</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Mandei</surname><given-names>Jose M.</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0116zj450</institution-id><institution-id institution-id-type="GRID">grid.9581.5</institution-id><institution-id institution-id-type="ISNI">0000 0001 2019 1471</institution-id><institution>Department of Child Health, Faculty of Medicine, </institution><institution>Universitas Indonesia, Cipto Mangunkusumo Hospital, </institution></institution-wrap>Jakarta, Indonesia </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01cn6ph21</institution-id><institution-id institution-id-type="GRID">grid.412381.d</institution-id><institution-id institution-id-type="ISNI">0000 0001 0702 3254</institution-id><institution>Department of Child Health, Faculty of Medicine, </institution><institution>Sam Ratulangi University, Prof. Dr. R.D. Kandou Hospital, </institution></institution-wrap>Manado, Indonesia </aff></contrib-group><pub-date pub-type="epub"><day>24</day><month>10</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>24</day><month>10</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>25</volume><elocation-id>858</elocation-id><history><date date-type="received"><day>5</day><month>2</month><year>2025</year></date><date date-type="accepted"><day>10</day><month>9</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">Critically ill children are vulnerable to fluid overload due to complex fluid management. Early positive fluid balance may lead to systemic venous and pulmonary congestion, which can be challenging to detect clinically. Venous excess ultrasound (VExUS) and lung ultrasound (LUS) are emerging point-of-care tools to assess these complications. In adults, VExUS is classified into five grades (A&#x02013;E) based on Doppler flow patterns. However, evidence on the use of VExUS, particularly in combination with LUS, in critically ill children with fluid overload is scarce, and their clinical utility in this setting is yet to be established.</p></sec><sec><title>Objectives</title><p id="Par2">To evaluate the correlation between positive fluid balance and VExUS and LUS scores in critically ill children.</p></sec><sec><title>Methods</title><p id="Par3">A cross-sectional study was conducted in the pediatric intensive care unit (PICU) of Dr. Cipto Mangunkusumo Hospital, from November to December 2024. The study included critically ill children aged 1 month to 18 years with a positive fluid balance within the first 24&#x000a0;h of admission. Correlations between VExUS and LUS scores, fluid balance, and clinical signs were analyzed.</p></sec><sec><title>Results</title><p id="Par4">In 40 critically ill children, there was no correlation between VExUS or LUS scores with positive fluid balance&#x02009;&#x0003e;&#x02009;5%. Additional results revealed a correlation between VExUS A and rhonchi (<italic>r</italic>&#x02009;=&#x02009;0.367, <italic>p</italic>&#x02009;=&#x02009;0.020), VExUS B and rhonchi (<italic>r</italic>&#x02009;=&#x02009;0.367, <italic>p</italic>&#x02009;=&#x02009;0.020), and VExUS D and edema (<italic>r</italic>&#x02009;=&#x02009;0.328, <italic>p</italic>&#x02009;=&#x02009;0.039).</p></sec><sec><title>Conclusion</title><p id="Par5">VExUS and LUS scores were not significantly correlated with positive fluid balance. VExUS A, B, and D correlated with rhonchi and edema in critically ill children with fluid overload.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Critically ill children</kwd><kwd>Fluid overload</kwd><kwd>LUS</kwd><kwd>VExUS</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; BioMed Central Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Background</title><p id="Par12">Fluid overload is a frequent and clinically significant complication in pediatric intensive care, affecting up to 83% of critically ill children depending on the definition and population studied [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>]. Fluid overload typically results from a mismatch between aggressive fluid administration for resuscitation, maintenance, or medication delivery, and impaired elimination due to renal, cardiac, or hepatic dysfunction [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR4">4</xref>]. Even a modest degree of fluid accumulation, defined by a cumulative positive fluid balance exceeding 5% of body weight, has been independently associated with increased risk of mortality, prolonged mechanical ventilation, and adverse organ outcomes [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR5">5</xref>&#x02013;<xref ref-type="bibr" rid="CR7">7</xref>]. The negative physiological consequences of fluid accumulation is called fluid overload and depends on individual factors of illness severity [<xref ref-type="bibr" rid="CR1">1</xref>]. </p><p id="Par13">Despite its clinical relevance, early detection of fluid overload remains challenging. Clinical signs such as peripheral edema, hepatomegaly, and pulmonary crackles often emerge at more advanced stages and demonstrate limited sensitivity and specificity [<xref ref-type="bibr" rid="CR2">2</xref>, <xref ref-type="bibr" rid="CR8">8</xref>]. These findings may also be confounded by underlying disease processes, resulting in underestimation of early systemic or pulmonary congestion [<xref ref-type="bibr" rid="CR9">9</xref>]. Objective parameters such as central venous pressure (CVP) and cumulative fluid balance are frequently used but lack sufficient accuracy for individualized volume assessment, particularly in dynamic critical illness settings [<xref ref-type="bibr" rid="CR10">10</xref>&#x02013;<xref ref-type="bibr" rid="CR12">12</xref>]. </p><p id="Par14">Point-of-care ultrasound (POCUS) offers a real-time, bedside alternative to conventional assessment tools. Lung ultrasound (LUS) is particularly valuable for detecting pulmonary congestion by identifying B-lines, pleural effusions, and subpleural consolidations [<xref ref-type="bibr" rid="CR13">13</xref>, <xref ref-type="bibr" rid="CR14">14</xref>]. Multiple studies have demonstrated that LUS is more sensitive than auscultation or chest radiography in identifying extravascular lung water, even in asymptomatic patients [<xref ref-type="bibr" rid="CR15">15</xref>, <xref ref-type="bibr" rid="CR16">16</xref>]. Its advantages, such as portability, lack of radiation exposure, and applicability in various clinical positions, make LUS highly suitable for pediatric critical care [<xref ref-type="bibr" rid="CR17">17</xref>&#x02013;<xref ref-type="bibr" rid="CR19">19</xref>]. Moreover, semi-quantitative scoring systems using multi-zone protocols provide structured assessment of pulmonary involvement [<xref ref-type="bibr" rid="CR20">20</xref>]. </p><p id="Par15">Venous excess ultrasound (VExUS) is a structured ultrasonographic approach to assess systemic venous congestion, integrating inferior vein cava (IVC) diameter with Doppler examination of hepatic, portal, and intrarenal veins [<xref ref-type="bibr" rid="CR21">21</xref>&#x02013;<xref ref-type="bibr" rid="CR23">23</xref>]. The current prototypes of VExUS grading system consist of VExUS A, B, C, D, and E. The system combines multiple ultrasound markers to categorize congestion into four grades, with higher grade indicating a severe congestion [<xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR24">24</xref>]. In adult studies, VExUS has shown stronger correlations with fluid overload, organ dysfunction, and outcomes compared to CVP [<xref ref-type="bibr" rid="CR25">25</xref>]. In pediatric settings, feasibility studies have demonstrated potential utility, though diagnostic reliability is influenced by age-related differences in venous compliance, respiratory dynamics, and ultrasound window accessibility [<xref ref-type="bibr" rid="CR26">26</xref>&#x02013;<xref ref-type="bibr" rid="CR28">28</xref>]. </p><p id="Par16">The integration of VExUS and LUS provides a comprehensive and non-invasive framework for evaluating both systemic and pulmonary congestion. LUS identifies interstitial and alveolar fluid accumulation, while VExUS characterizes venous pressure dynamics and organ-level congestion. This combined approach aligns with a physiological model encompassing vascular capacity, fluid redistribution, and early tissue congestion. The complementary strengths of both modalities may enhance the precision of bedside fluid assessment and support more timely and individualized management in pediatric critical care [<xref ref-type="bibr" rid="CR16">16</xref>, <xref ref-type="bibr" rid="CR25">25</xref>, <xref ref-type="bibr" rid="CR28">28</xref>]. </p><p id="Par17">This study aimed to examine the correlation between VExUS and LUS scores with early positive fluid balance in critically ill children. Additionally, the study sought to explore their association with clinical signs of congestion.</p></sec><sec id="Sec2"><title>Method</title><sec id="Sec3"><title>Study design and participants</title><p id="Par18">This prospective cross-sectional study was conducted in the Pediatric Intensive Care Unit (PICU) of Dr. Cipto Mangunkusumo Hospital, a tertiary referral center in Jakarta, Indonesia, from November to December 2024. The PICU is a 25-bed unit that admits both medical and non-cardiac surgical pediatric cases, without provision for extracorporeal membrane oxygenation (ECMO).</p><p id="Par19">Critically ill children aged 1 month to 18 years with a cumulative fluid balance exceeding 5% within the first 24&#x000a0;h of PICU admission were included. The &#x0003e;&#x02009;5% threshold was selected based on evidence suggesting that even mild fluid accumulation may be associated with adverse outcomes [<xref ref-type="bibr" rid="CR2">2</xref>, <xref ref-type="bibr" rid="CR8">8</xref>]. This cutoff aimed to facilitate early detection of systemic or pulmonary congestion. Patients discharged before 24&#x000a0;h were excluded to allow sufficient time for fluid accumulation and standardized ultrasound assessment. Written informed consent was obtained from all participants&#x02019; legal guardians. Patients were enrolled through consecutive sampling, yielding a final sample of 40. Exclusion criteria included congenital abnormalities of the liver or kidneys, liver cirrhosis, severe tricuspid regurgitation, and a history of liver or kidney transplantation.</p><p id="Par20">Cumulative fluid balance was calculated as: (Total fluid input &#x02013; total output in 24&#x000a0;h)/body weight (kg) &#x000d7; 100%, excluding insensible water loss [<xref ref-type="bibr" rid="CR2">2</xref>]. Fluid inputs included intravenous fluids, medications, nutrition, and blood products; outputs included urine, stool, and drainage losses.</p></sec><sec id="Sec4"><title>Clinical and ultrasound assessment</title><p id="Par21">Clinical parameters included heart rate, respiratory rate, blood pressure, and laboratory results (urea, creatinine, lactate, blood gas analysis). Clinical signs of fluid overload assessed were peripheral edema (palpebral, dorsal hand, pretibial), pulmonary rhonchi (on auscultation), and hepatomegaly (palpable liver edge&#x02009;&#x0003e;&#x02009;2&#x000a0;cm below costal margin).</p><p id="Par22">Ultrasound examinations were performed at 24 and 48&#x000a0;h of admission using a portable Philips Sparq machine. All scans were conducted by a single pediatric intensivist trained in point-of-care ultrasound (POCUS). Interrater reliability was confirmed with a pediatric radiologist in a prior validation study involving 50 patients, showing substantial agreement (Cohen&#x02019;s kappa : Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>).</p><p id="Par23">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Reliability test of the vexus score between the researcher and expert reference</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" colspan="2">Parameters</th><th align="left">Cohen&#x02019;s kappa coefficient</th><th align="left">Standard error</th></tr></thead><tbody><tr><td align="left" colspan="2">IVC</td><td align="left">0.790</td><td align="left">0.203</td></tr><tr><td align="left" colspan="2">Hepatic&#x000a0;</td><td align="left">0.878</td><td align="left">0.120</td></tr><tr><td align="left" colspan="2">Porta</td><td align="left">0.790</td><td align="left">0.203</td></tr><tr><td align="left" colspan="2">Renalis</td><td align="left">0.886</td><td align="left">0.094</td></tr></tbody></table></table-wrap>
</p><p id="Par24">VExUS examination included measurements of the IVC diameter and Doppler waveforms of the hepatic, portal, and intrarenal veins, using a standardized protocol. Subsequent examination findings were classified based on the five prototypes VExUS grading system, namely VExUS &#x0201c;A&#x0201d; through &#x0201c;E&#x0201d; [<xref ref-type="bibr" rid="CR21">21</xref>].</p><p id="Par25">LUS was performed using a 7&#x02013;12&#x000a0;MHz linear probe across 12 chest zones, with pleural effusion assessment conducted using a 3&#x02013;5&#x000a0;MHz convex transducer. LUS findings were scored based on the presence of B-lines, consolidations, and pleural effusions, and converted into a semi-quantitative LUS score.</p></sec><sec id="Sec5"><title>Data analysis</title><p id="Par26">Descriptive data were expressed as medians (min&#x02013;max) or frequencies (%), as appropriate. Correlations between continuous variables were analyzed using Pearson&#x02019;s correlation, while ordinal and categorical variables were assessed using Spearman&#x02019;s correlation. Group comparisons were performed using the Wilcoxon or Kruskal&#x02013;Wallis tests, followed by post-Hoc if needed. A p-value&#x02009;&#x0003c;&#x02009;0.05 was considered statistically significant. Statistical analyses were performed using IBM SPSS Statistics version 26. As multiple correlations were explored, p-values were unadjusted for multiple comparisons, and the results should be interpreted as exploratory.</p></sec></sec><sec id="Sec6"><title>Results</title><p id="Par27">A total of 40 critically ill children were included in this study. The patients&#x02019; baseline characteristics are summarized in Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>. The participants were mostly male (52.5%), under 2 years of age (60%), well nourished (65%), with respiratory disease as the underlying disease (52.5%), and on mechanical ventilation (50%). The secondary outcomes of this study revealed that 2 patients with positive balances progressed to acute kidney injury (AKI). No subjects required kidney replacement therapy or mortality.</p><p id="Par28">
<table-wrap id="Tab2"><label>Table 2</label><caption><p>Basic characteristics of the research subjects at PICU admission </p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">
<bold>Variable</bold>
</th><th align="left">
<bold>Total (N=40)</bold>
</th></tr></thead><tbody><tr><td align="left" colspan="2">Sex, n (%)</td></tr><tr><td align="left">&#x02003;Male</td><td align="left">21 (52.5)</td></tr><tr><td align="left">&#x02003;Female</td><td align="left">19 (47.5)</td></tr><tr><td align="left">Age, median (min&#x02013;max), months</td><td align="left">18.5 (2-201)</td></tr><tr><td align="left" colspan="2">Age by class, n (%)</td></tr><tr><td align="left">&#x02003;1 months -2 years</td><td align="left">24 (60)</td></tr><tr><td align="left">&#x02003;2-7 years</td><td align="left">10 (25)</td></tr><tr><td align="left">&#x02003;7-13 years</td><td align="left">4 (10)</td></tr><tr><td align="left">&#x02003;13-22 years</td><td align="left">2 (5)</td></tr><tr><td align="left">Body weight, median (min&#x02013;max), kg</td><td align="left">9.59 (3.4-37)</td></tr><tr><td align="left" colspan="2">Nutritional status, n (%)</td></tr><tr><td align="left"> Well nourished</td><td align="left">26 (65)</td></tr><tr><td align="left"> Obesity</td><td align="left"> 6 (15)</td></tr><tr><td align="left"> Undernutrition</td><td align="left"> 1 (2.5)</td></tr><tr><td align="left"> Wasted</td><td align="left"> 2 (5)</td></tr><tr><td align="left"> Severely wasted</td><td align="left"> 5 (12.5)</td></tr><tr><td align="left" colspan="2">Underlying disease, n (%)</td></tr><tr><td align="left">&#x02003;Neurology</td><td align="left">13 (32.5)</td></tr><tr><td align="left">&#x02003;Respiratory</td><td align="left">21 (52.5)</td></tr><tr><td align="left">&#x02003;Gastro-hepatology</td><td align="left"> 3 (7.5)</td></tr><tr><td align="left">&#x02003;Sepsis</td><td align="left"> 3 (7.5)</td></tr><tr><td align="left" colspan="2">Heart rate, n (%)</td></tr><tr><td align="left">&#x02003;Normal</td><td align="left">20 (50)</td></tr><tr><td align="left">&#x02003;Bradycardia</td><td align="left"> 1 (2.5)</td></tr><tr><td align="left">&#x02003;Tachycardia</td><td align="left">19 (47.5)</td></tr><tr><td align="left" colspan="2">Respiratory rate, n (%)</td></tr><tr><td align="left">&#x02003;Normal</td><td align="left">32 (80)</td></tr><tr><td align="left">&#x02003;Tachypneu</td><td align="left"> 8 (20)</td></tr><tr><td align="left" colspan="2">Respiratory support, n (%)</td></tr><tr><td align="left">&#x02003;Invasive</td><td align="left">20 (50)</td></tr><tr><td align="left">&#x02003;Noninvasive</td><td align="left">13 (32.5)</td></tr><tr><td align="left">&#x02003;Spontaneous breathing</td><td align="left">7 (17.5)</td></tr><tr><td align="left" colspan="2">AKI first 24 hrs, n (%)</td></tr><tr><td align="left">&#x02003;No</td><td align="left">38 (95)</td></tr><tr><td align="left">&#x02003;Yes</td><td align="left"> 2 (5)</td></tr><tr><td align="left">CKRT within first 48 hrs, n (%)</td><td align="left"> 0 (0)</td></tr><tr><td align="left">Mortality within 48 hrs, n (%)</td><td align="left"> 0 (0)</td></tr></tbody></table><table-wrap-foot><p><italic>AKI</italic> Acute kidney injury, <italic>CKRT</italic> Continuous kidney replacement therapy, <italic>hrs</italic> Hours</p></table-wrap-foot></table-wrap>
</p><p id="Par29">The distribution of the cumulative fluid balance at 24 and 48&#x000a0;h is shown in Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>. The median cumulative fluid balance (minimun-maximum) at 24&#x000a0;h and 48&#x000a0;h of observation was 6.72% (5% &#x02212;&#x02009;16.25%) and 5.53% (1.4% &#x02212;&#x02009;19.55%), respectively. The cumulative fluid balance at 24&#x000a0;h was mostly less than 10%. The baseline laboratory profiles at 24 hours after PICU admission is shown in Table <xref rid="Tab3" ref-type="table">3</xref>.<table-wrap id="Tab3"><label>Table 3</label><caption><p>Laboratory profiles at 24 hours after PICU admission</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"><bold>Laboratory profile </bold></th><th align="left"><bold>Total (N=40)</bold></th></tr></thead><tbody><tr><td align="left"> pH; median(min-max)</td><td align="left"> 7.528 (7.058-7.686)</td></tr><tr><td align="left"> Urea, median(min-max), (mg/dL)</td><td align="left"> 23.5 (4.3-134.8)</td></tr><tr><td align="left"> Creatinine median(min-max), (mg/dL)</td><td align="left"> 0.3 (0.10-1.70)</td></tr><tr><td align="left"> Lactate median(min-max), (mMol/l)</td><td align="left"> 1.2 (0.0-19.30)</td></tr></tbody></table></table-wrap></p><p id="Par30">
<fig id="Fig1"><label>Fig. 1</label><caption><p>The cumulative fluid balance of critically ill pediatric patients was evaluated at two predefined timepoints: 24 and 48&#x000a0;h following PICU admission. At 24&#x000a0;h, the median fluid balance was 6.72%, with an interquartile range (IQR) of 5.47% to 9.07%. At 48&#x000a0;h, the median value slightly decreased to 6.49%, accompanied by a broader IQR of 3.11% to 9.85%, indicating greater variability in fluid accumulation over time. Outliers were retained in the analysis as they reflected clinically plausible variations in fluid accumulation. No data entry errors were identified, and all values were included to preserve the integrity of the dataset</p></caption><graphic xlink:href="12887_2025_6177_Fig1_HTML" id="d33e720"/></fig>
</p><p id="Par31">Among the 40 subjects, 40% experienced edema in the palpebral, dorsum manus, and/or pretibial regions. Clinical edema in any area of the body is categorized as edema. The severity of edema was not assessed in this study. Rhonchi was present in 27.5% of the subjects, whereas hepatomegaly was present in 22.5%. The severity of rhonchi and hepatomegaly was not assessed. Sixteen subjects had only one clinical sign while only two subjects presented with three clinical signs and had positive fluid balance between 8% and 10%. No subjects presented with simultaneous clinical signs of rhonchi and hepatomegaly (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>). With respect to the blood gas analysis groups, most of the subjects were alkalotic (80%), and only 2 (5%) subjects had a normal pH.</p><p id="Par32">
<fig id="Fig2"><label>Fig. 2</label><caption><p>Clinical signs observed at 24&#x000a0;h-time point. The bar height represents the value of fluid balance. No subjects with rhonchi and hepatomegaly</p></caption><graphic xlink:href="12887_2025_6177_Fig2_HTML" id="d33e735"/></fig>
</p><p id="Par33">The VExUS component includes an assessment of the IVC diameter and hepatic, portal and intrarenal venous Doppler. At 24&#x000a0;h of observation, most of the IVC was not distended (82.5%), and 85% of the hepatic Doppler waves and 60% of the portal Doppler waves were normal. All intrarenal vein Doppler waves were normal. The same pattern was observed at 48&#x000a0;h. The VExUS score was then interpreted as a grading of congestion, according to the VExUS classifications of A, B, C, D and E. A comparison of the VExUS scores between each VExUS grade at 24 and 48&#x000a0;h of monitoring is shown in Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>. The current study utilised POCUS LUS to assess B-lines, consolidations, and pleural effusions, translating these findings into a semi-quantitative LUS score (Table&#x000a0;<xref rid="Tab4" ref-type="table">4</xref>).</p><p id="Par34">
<fig id="Fig3"><label>Fig. 3</label><caption><p>Distribution of VExUS scores grouped by classes A to E. The scores among classes within 24-hour (A) and 48-hour (B) observations were different. Post hoc analysis revealed differences among the groups as well</p></caption><graphic xlink:href="12887_2025_6177_Fig3_HTML" id="d33e753"/></fig>
</p><p id="Par35">
<table-wrap id="Tab4"><label>Table 4</label><caption><p>LUS score in critically ill children with fluid overload</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2">LUS</th><th align="left" colspan="2">Observation time</th><th align="left" rowspan="2"><italic>P</italic> value</th></tr><tr><th align="left">24&#x000a0;h</th><th align="left">48&#x000a0;h</th></tr></thead><tbody><tr><td align="left">LUS score, median (min&#x02013;max)</td><td align="left">1.0 (0&#x02013;11)</td><td align="left">0.5 (0&#x02013;13)</td><td align="left">0.431</td></tr><tr><td align="left" colspan="4">Pleural efusion, n(%)</td></tr><tr><td align="left">No</td><td align="left">39 (97.5)</td><td align="left">39 (97.5)</td><td align="left">1.000</td></tr><tr><td align="left">Yes</td><td align="left">1 (2.5)</td><td align="left">1 (2.5)</td><td align="left"/></tr></tbody></table><table-wrap-foot><p><italic>LUS</italic> Lung ultrasound</p></table-wrap-foot></table-wrap>
</p><p id="Par36">The results of the correlation analysis of VExUS scores by class with clinical parameters such as fluid balance are presented in Table&#x000a0;<xref rid="Tab5" ref-type="table">5</xref>. The results of the correlation analysis of the VExUS score with several clinical parameters by class are presented in Table&#x000a0;<xref rid="Tab6" ref-type="table">6</xref>. The results revealed a correlation between the clinical signs of Rhonchi syndrome and VExUS A (<italic>r</italic>&#x02009;=&#x02009;0.367; <italic>p</italic>&#x02009;=&#x02009;0.020) and VExUS B (<italic>r</italic>&#x02009;=&#x02009;0.367; <italic>p</italic>&#x02009;=&#x02009;0.020), as well as between the clinical signs of edema and VExUS D (<italic>r</italic>&#x02009;=&#x02009;0.326; <italic>p</italic>&#x02009;=&#x02009;0.039). The direction and strength of the correlation between VExUS A and B to Rhonchi and VExUS D to edema were weakly positive.</p><p id="Par37">
<table-wrap id="Tab5"><label>Table 5</label><caption><p>Correlations between vexus and LUS scores with positive fluid balances</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Score</th><th align="left">Correlation coefficient</th><th align="left"><italic>P</italic> value</th></tr></thead><tbody><tr><td align="left">VExUS A and positive fluid balance<sup>a</sup></td><td align="left">0.064</td><td align="left">0.696</td></tr><tr><td align="left">VExUS B and positive fluid balance<sup>a</sup></td><td align="left">0.064</td><td align="left">0.696</td></tr><tr><td align="left">VExUS C and positive fluid balance<sup>a</sup></td><td align="left">0.031</td><td align="left">0.848</td></tr><tr><td align="left">VExUS D and positive fluid balance<sup>a</sup></td><td align="left">0.119</td><td align="left">0.463</td></tr><tr><td align="left">VExUS E and positive fluid balance<sup>a</sup></td><td align="left">1.000</td><td align="left">1.000</td></tr><tr><td align="left">LUS and positive fluid balance<sup>a</sup></td><td align="left">0.048</td><td align="left">0.767</td></tr></tbody></table><table-wrap-foot><p><italic>VExUS</italic> Venous excess ultrasound, <italic>LUS L</italic>ung ultrasound</p><p><sup>a</sup>Pearson correlation</p></table-wrap-foot></table-wrap>
</p><p id="Par38">
<table-wrap id="Tab6"><label>Table 6</label><caption><p>Correlations of the vexus and LUS scores with clinical characteristics</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">Variables</th><th align="left">Correlation Coefficient</th><th align="left"><italic>P</italic>value</th></tr></thead><tbody><tr><td align="left" rowspan="7">VExUS A</td><td align="left">Heart rate<sup>a</sup></td><td align="left">0.230</td><td align="left">0.154</td></tr><tr><td align="left">Respiratory rate<sup>a</sup></td><td align="left">0.301</td><td align="left">0.059</td></tr><tr><td align="left">Blood pressure systole<sup>a</sup></td><td align="left">&#x02212;0.096</td><td align="left">0.556</td></tr><tr><td align="left">Diastolic blood pressure<sup>a</sup></td><td align="left">&#x02212;0.096</td><td align="left">0.556</td></tr><tr><td align="left">Edema<sup>b</sup></td><td align="left">0.249</td><td align="left">0.121</td></tr><tr><td align="left">Rhonchi<sup>b</sup></td><td align="left">0.367</td><td align="left">0.020*</td></tr><tr><td align="left">Hepatomegaly<sup>b</sup></td><td align="left">&#x02212;0.226</td><td align="left">0.162</td></tr><tr><td align="left" rowspan="7">VExUS B</td><td align="left">Heart rate<sup>a</sup></td><td align="left">0.230</td><td align="left">0.154</td></tr><tr><td align="left">Respiratory rate<sup>a</sup></td><td align="left">0.301</td><td align="left">0.059</td></tr><tr><td align="left">Blood pressure systole<sup>a</sup></td><td align="left">&#x02212;0.096</td><td align="left">0.556</td></tr><tr><td align="left">Diastolic blood pressure<sup>a</sup></td><td align="left">&#x02212;0.096</td><td align="left">0.556</td></tr><tr><td align="left">Edema<sup>b</sup></td><td align="left">0.249</td><td align="left">0.121</td></tr><tr><td align="left">Rhonchi<sup>b</sup></td><td align="left">0.367</td><td align="left">0.020*</td></tr><tr><td align="left">Hepatomegaly<sup>b</sup></td><td align="left">&#x02212;0.226</td><td align="left">0.162</td></tr><tr><td align="left" rowspan="7">VExUS C</td><td align="left">Heart rate<sup>a</sup></td><td align="left">0.146</td><td align="left">0.368</td></tr><tr><td align="left">Respiratory rate<sup>a</sup></td><td align="left">0.263</td><td align="left">0.101</td></tr><tr><td align="left">Blood pressure systole<sup>a</sup></td><td align="left">&#x02212;0.106</td><td align="left">0.517</td></tr><tr><td align="left">Diastolic blood pressure<sup>a</sup></td><td align="left">&#x02212;0.106</td><td align="left">0.517</td></tr><tr><td align="left">Edema<sup>b</sup></td><td align="left">0,161</td><td align="left">0.320</td></tr><tr><td align="left">Rhonchi<sup>b</sup></td><td align="left">0.306</td><td align="left">0.055</td></tr><tr><td align="left">Hepatomegaly<sup>b</sup></td><td align="left">&#x02212;0.248</td><td align="left">0.123</td></tr><tr><td align="left" rowspan="7">VExUS D</td><td align="left">Heart rate<sup>a</sup></td><td align="left">0.164</td><td align="left">0.312</td></tr><tr><td align="left">Respiratory rate<sup>a</sup></td><td align="left">0.019</td><td align="left">0.909</td></tr><tr><td align="left">Blood pressure systole<sup>a</sup></td><td align="left">0.016</td><td align="left">0.921</td></tr><tr><td align="left">Diastolic blood pressure<sup>a</sup></td><td align="left">0.016</td><td align="left">0.921</td></tr><tr><td align="left">Edema<sup>b</sup></td><td align="left">0.328</td><td align="left">0.039*</td></tr><tr><td align="left">Rhonchi<sup>b</sup></td><td align="left">0.116</td><td align="left">0.474</td></tr><tr><td align="left">Hepatomegaly<sup>b</sup></td><td align="left">0.071</td><td align="left">0.663</td></tr><tr><td align="left" rowspan="7">VExUS E</td><td align="left">Heart rate<sup>a</sup></td><td align="left">1.000</td><td align="left">1.000</td></tr><tr><td align="left">Respiratory rate<sup>a</sup></td><td align="left">1.000</td><td align="left">1.000</td></tr><tr><td align="left">Blood pressure systole<sup>a</sup></td><td align="left">1.000</td><td align="left">1.000</td></tr><tr><td align="left">Diastolic blood pressure<sup>a</sup></td><td align="left">1.000</td><td align="left">1.000</td></tr><tr><td align="left">Edema<sup>b</sup></td><td align="left">1.000</td><td align="left">1.000</td></tr><tr><td align="left">Rhonchi<sup>b</sup></td><td align="left">1.000</td><td align="left">1.000</td></tr><tr><td align="left">Hepatomegaly<sup>b</sup></td><td align="left">1.000</td><td align="left">1.000</td></tr><tr><td align="left" rowspan="7">LUS</td><td align="left">Heart rate<sup>a</sup></td><td align="left">0.158</td><td align="left">0.329</td></tr><tr><td align="left">Respiratory rate<sup>a</sup></td><td align="left">0.270</td><td align="left">0.093</td></tr><tr><td align="left">Blood pressure systole<sup>a</sup></td><td align="left">&#x02212;0.072</td><td align="left">0.658</td></tr><tr><td align="left">Diastolic blood pressure<sup>a</sup></td><td align="left">&#x02212;0.072</td><td align="left">0.658</td></tr><tr><td align="left">Edema<sup>b</sup></td><td align="left">0.169</td><td align="left">0.298</td></tr><tr><td align="left">Rhonchi<sup>b</sup></td><td align="left">0.013</td><td align="left">0.937</td></tr><tr><td align="left">Hepatomegaly<sup>b</sup></td><td align="left">&#x02212;0.025</td><td align="left">0.880</td></tr></tbody></table><table-wrap-foot><p><italic>VExUS</italic> Venous excess ultrasound, <italic>LUS</italic> Lung ultrasound</p><p><sup>a</sup>Pearson correlation</p><p><sup>b</sup>Spearman correlation</p><p>*p-value&#x02009;&#x0003c;&#x02009;0.05</p></table-wrap-foot></table-wrap>
</p></sec><sec id="Sec7"><title>Discussion</title><p id="Par39">Critically ill pediatric patients with a cumulative positive fluid balance exceeding 5% within the first 24&#x000a0;h of PICU admission were included in the analysis. The highest fluid balance observed was 16.25%, occurring in a patient with hemorrhagic shock who required aggressive fluid resuscitation and transfusion. Such rapid fluid administration, when not closely monitored, can predispose to fluid overload [<xref ref-type="bibr" rid="CR4">4</xref>, <xref ref-type="bibr" rid="CR5">5</xref>]. The selected 5% threshold likely captured early or mild stages of congestion, which may not have been sufficient to elicit detectable hemodynamic changes on ultrasound. No significant correlations were found between VExUS or LUS scores and early positive fluid balance. Nonetheless, weak associations emerged between VExUS A and B with pulmonary rhonchi, and VExUS D with edema.</p><p id="Par40">The timing of ultrasound assessments at 24 and 48&#x000a0;h may have been insufficient for some patients to develop detectable signs of fluid overload. Future studies should incorporate serial measurements beyond 48&#x000a0;h and include patients with varying durations of illness. While a reduction in cumulative fluid balance was noted at the second time point, the change did not reach statistical significance, possibly due to sample size constraints or heterogeneity in fluid management. However, the observed trend may reflect adequate clinical surveillance and timely intervention.</p><p id="Par41">Clinical signs such as pulmonary rhonchi, edema, and hepatomegaly were found to be associated with fluid overload, supporting their relevance in bedside evaluation. These signs may often be overlooked or attributed to underlying disease processes [<xref ref-type="bibr" rid="CR2">2</xref>, <xref ref-type="bibr" rid="CR29">29</xref>, <xref ref-type="bibr" rid="CR30">30</xref>]. The use of rhonchi as an indicator of pulmonary congestion warrants careful interpretation, as it may also arise from lower respiratory tract infections [<xref ref-type="bibr" rid="CR19">19</xref>, <xref ref-type="bibr" rid="CR31">31</xref>]. In this study, rhonchi was regarded as a potential surrogate marker for pulmonary interstitial fluid accumulation; however, the finding lacks specificity and may be influenced by other respiratory pathologies. In fluid overload, edema can occur due to abnormal fluid redistribution. Fluid overload also leads to an increase in blood volume, resulting in hepatic congestion, which eventually manifests as hepatomegaly [<xref ref-type="bibr" rid="CR8">8</xref>, <xref ref-type="bibr" rid="CR30">30</xref>, <xref ref-type="bibr" rid="CR32">32</xref>]. </p><p id="Par42">Absence of a significant correlation between VExUS scores and fluid balance underscores a discrepancy with previous assumptions regarding their association. Findings from this study indicate that cumulative fluid balance may not reliably reflect intravascular volume status or venous congestion [<xref ref-type="bibr" rid="CR9">9</xref>, <xref ref-type="bibr" rid="CR10">10</xref>, <xref ref-type="bibr" rid="CR12">12</xref>]. This divergence may stem from interindividual variability in vascular compliance, fluid redistribution into interstitial compartments, or the relatively mild degree of fluid overload in this study. Localized fluid accumulation without systemic hemodynamic consequences detectable by VExUS may also contribute to this observation.</p><p id="Par43">Dilation of the inferior vena cava during fluid overload is attributed to elevated central venous pressure, intravascular volume redistribution, neurohormonal activation, and vascular changes that reduce venous compliance and increase arterial resistance [<xref ref-type="bibr" rid="CR28">28</xref>]. Given the high elasticity of venous vessels, the IVC typically enlarges in response to hypervolemia[<xref ref-type="bibr" rid="CR26">26</xref>, <xref ref-type="bibr" rid="CR27">27</xref>]. Nonetheless, in this study, most patients exhibited normal IVC diameters, which contrasts with previous studies reporting IVC distension in fluid-overloaded patients. The physiological effects of positive fluid balance are modulated by cardiac function and capillary leak, making illness severity a key determinant. In less severely ill children, effective cardiac output may prevent rises in CVP and IVC diameter.</p><p id="Par44">Most of the hepatic vein Doppler waves in this study were normal, and 15% of the subjects presented mild&#x02013;moderate S-wave abnormalities. Mild&#x02013;moderate hepatic vein abnormalities are associated with a reduction in the amplitude of the S wave; thus, the S wave is smaller than the D wave [<xref ref-type="bibr" rid="CR33">33</xref>&#x02013;<xref ref-type="bibr" rid="CR35">35</xref>]. The hepatic vein Doppler waveform may remain normal in fluid overload due to several compensatory mechanisms as well as the dynamics of venous return.</p><p id="Par45">The portal vein in this study had the same pattern as the hepatic vein. Most of the Doppler results were normal, followed by mild&#x02013;moderate abnormalities. Under normal circumstances, the portal vein has a continuous flow pattern influenced by atrial contraction and is characterized by gentle pulsatility. An increase in right atrial pressure due to fluid overload or other cardiovascular problems is transmitted to the portal circulation, potentially resulting in more pulsatile flow [<xref ref-type="bibr" rid="CR36">36</xref>&#x02013;<xref ref-type="bibr" rid="CR38">38</xref>]. </p><p id="Par46">The VExUS grade prototype is a scoring system designed to assess systemic venous congestion. The components of VExUS A to C are hepatic, portal, and intrarenal vein Doppler in addition to the IVC diameter. VExUS classes D and E were developed to exclude IVC diameter and improve specificity for severe congestion in adult patient [<xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR22">22</xref>, <xref ref-type="bibr" rid="CR25">25</xref>]. In this study, most patients were classified as having mild congestion under VExUS E, supporting the notion that modified VExUS protocols excluding IVC may be more applicable in pediatric populations.</p><p id="Par47">Correlation analysis showed no association between VExUS scores and positive fluid balance. Weak correlations were observed between VExUS A and B with rhonchi, and VExUS D with edema. These findings raise the potential utility of VExUS in detecting early systemic congestion, however the physiological basis remains unclear and may be influenced by uncontrolled confounding factors.</p><p id="Par48">LUS was utilized to evaluate pulmonary congestion, with a maximum score of 11 out of 36, indicating predominantly mild involvement. B-lines were primarily observed in the posterior and lateral zones, accompanied by minimal pleural effusion and limited consolidation. These findings suggest early extravascular lung water accumulation rather than overt alveolar flooding. Previous studies have demonstrated that higher LUS scores are typically associated with more severe congestion, particularly in patients undergoing dialysis or with advanced fluid accumulation [<xref ref-type="bibr" rid="CR15">15</xref>, <xref ref-type="bibr" rid="CR20">20</xref>, <xref ref-type="bibr" rid="CR39">39</xref>]. </p><p id="Par49">VExUS and LUS show potential as non-invasive tools for assessing congestion in critically ill children, although neither modality demonstrated a consistent correlation with early positive fluid balance. The absence of echocardiographic assessment of cardiac function and the relatively low severity of fluid overload may have contributed to these findings.</p><p id="Par50">Clinical implications suggest that while clinical signs remain valuable, integration of VExUS and LUS may enhance bedside evaluation, especially when performed serially and interpreted alongside physiological and laboratory data. Future studies should explore larger cohorts, incorporate echocardiographic parameters, and define pediatric-specific VExUS thresholds and scoring criteria. The impact of congestion indices on long-term outcomes remains to be determined.</p></sec><sec id="Sec8"><title>Conclusion</title><p id="Par51">VExUS and LUS scores were not significantly correlated with early positive fluid balance&#x02009;&#x0003e;&#x02009;5%, yet their weak correlation with clinical signs suggest potential value in bedside congestion assessment among critically ill children.</p></sec></body><back><glossary><title>Abbreviations</title><def-list><def-item><term>CVP</term><def><p id="Par6">Central venous pressure</p></def></def-item><def-item><term>IVC</term><def><p id="Par7">Inferior vein cava</p></def></def-item><def-item><term>IWL</term><def><p id="Par8">Insensible water loss</p></def></def-item><def-item><term>LUS</term><def><p id="Par9">Lung ultrasound</p></def></def-item><def-item><term>POCUS</term><def><p id="Par10">Point-of-care ultrasound</p></def></def-item><def-item><term>VExUS</term><def><p id="Par11">Venous excess ultrasound</p></def></def-item></def-list></glossary><fn-group><fn><p><bold>Publisher&#x02019;s Note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn></fn-group><ack><title>Acknowledgements</title><p>The author gratefully acknowledges the late Prof. Dr. dr. Partini P. Trihono, Sp.A(K) for the invaluable guidance and support during the preparation of this study. Though she passed away before its completion, her dedication and wisdom remain a lasting inspiration.</p></ack><notes notes-type="author-contribution"><title>Authors&#x02019; contributions</title><p>MDU, YP, HFW conceived and designed the study. MDU, YP, HFW, and MMD developed the methodology. MDU, YP, HFW collected the clinical and ultrasound data. MDU, YP and MMD performed the statistical analysis. MDU, YP, HFW drafted the initial manuscript. YP, HFW, MMD, IY, NK, JMM critically revised the manuscript for important intellectual content. YP, HFW, MMD supervised the study.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>The authors declare that they have not received any funding for this research.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>The datasets generated and/or analysed during the current study available from the corresponding author on reasonable request.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par52">Ethical approval was granted by Health Research Ethics Commission of Cipto Mangunkusumo Hospital, Faculty of Medicine Universitas Indonesia, and is in full compliance with the principles outlined in the Declaration of Helsinki (KET. 1635/UN2.1F1/ETIK/PPM.00.02/2024). All procedures involving human participants were conducted in accordance with ethical standards to ensure the protection of their rights, safety, and well-being. Written informed consent was obtained from all participants&#x02019; legal guardians prior to the involvement in the study, and confidentiality was strictly maintained. The research protocol underwent thorough review and approval to ensure adherence to ethical guidelines, including risk minimization and respect for autonomy.</p></notes><notes id="FPar2"><title>Consent for publication</title><p id="Par53">Not applicable.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests</title><p id="Par54">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Alobaidi</surname><given-names>R</given-names></name><name><surname>Morgan</surname><given-names>C</given-names></name><name><surname>Basu</surname><given-names>RK</given-names></name><name><surname>Stenson</surname><given-names>E</given-names></name><name><surname>Featherstone</surname><given-names>R</given-names></name></person-group><article-title>Association between fluid balance and outcomes in critically ill children: a systematic review and meta-analysis</article-title><source>JAMA Pediatr</source><year>2018</year><volume>172</volume><fpage>257</fpage><lpage>68</lpage><pub-id pub-id-type="doi">10.1001/jamapediatrics.2017.4540</pub-id><pub-id pub-id-type="pmid">29356810</pub-id>

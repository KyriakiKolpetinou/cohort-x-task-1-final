pact of an ultra-low dose unenhanced planning scan on CT coronary angiography scan length and effective radiation dose</article-title><alt-title alt-title-type="right-running-head">Ultra-low dose CT coronary angiography planning scan</alt-title><alt-title alt-title-type="left-running-head">Duerden <italic>et al</italic>
</alt-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Duerden</surname><given-names>Laura</given-names></name><degrees>BSc, MBBCh, MRCP, FRCR</degrees><xref rid="aff1" ref-type="aff">1</xref><email xlink:href="mailto:lduerden@hotmail.com">lduerden@hotmail.com</email></contrib><contrib contrib-type="author"><name><surname>O&#x02019;Brien</surname><given-names>Helen</given-names></name><degrees>BSc, Rad Therapy, MBChB, FRCR</degrees><xref rid="aff1" ref-type="aff">1</xref><email xlink:href="mailto:h.o'brien1@nhs.net">h.o'brien1@nhs.net</email></contrib><contrib contrib-type="author"><name><surname>Doshi</surname><given-names>Susan</given-names></name><degrees>PhD, MIPEM, CSci</degrees><xref rid="aff2" ref-type="aff">2</xref><email xlink:href="mailto:susan.doshi@wales.nhs.uk">susan.doshi@wales.nhs.uk</email></contrib><contrib contrib-type="author"><name><surname>Charters</surname><given-names>Pia</given-names></name><degrees>MBChB, DFSRH, FRCR</degrees><xref rid="aff1" ref-type="aff">1</xref><email xlink:href="mailto:pia.charters@nhs.net">pia.charters@nhs.net</email></contrib><contrib contrib-type="author"><name><surname>King</surname><given-names>Laurence</given-names></name><degrees>MSc</degrees><xref rid="aff1" ref-type="aff">1</xref><email xlink:href="mailto:laurence.king@nhs.net">laurence.king@nhs.net</email></contrib><contrib contrib-type="author"><name><surname>Hudson</surname><given-names>Benjamin. J</given-names></name><degrees>MBBS, FRCR</degrees><xref rid="aff1" ref-type="aff">1</xref><email xlink:href="mailto:benjamin.hudson1@nhs.net">benjamin.hudson1@nhs.net</email></contrib><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-2744-3509</contrib-id><name><surname>Rodrigues</surname><given-names>Jonathan Carl Luis</given-names></name><degrees>BSc(Hons), MBChB(Hons), MRCP, FRCR, FSCMR, PhD</degrees><xref rid="aff1 aff3" ref-type="aff">1,3</xref><email xlink:href="mailto:jonrodrigues@doctors.org.uk">jonrodrigues@doctors.org.uk</email></contrib><aff id="aff1">

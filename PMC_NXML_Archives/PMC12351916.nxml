</element-citation><mixed-citation id="mc-CR7" publication-type="journal">Gupta H, Vance C, Bansal V, Siva A. A narrative review of pulsed radiofrequency for the treatment of carpal tunnel syndrome. Pain Pract. 2024;24(2):374&#x02013;82.<pub-id pub-id-type="pmid">37784211</pub-id>

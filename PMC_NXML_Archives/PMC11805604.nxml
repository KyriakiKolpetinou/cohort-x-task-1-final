<article-meta><article-id pub-id-type="pmid">39925496</article-id><article-id pub-id-type="pmc">11805604</article-id><article-id pub-id-type="doi">10.7759/cureus.77155</article-id><article-categories><subj-group subj-group-type="heading"><subject>Emergency Medicine</subject></subj-group><subj-group><subject>Medical Education</subject></subj-group><subj-group><subject>Quality Improvement</subject></subj-group></article-categories><title-group><article-title>Boosting Confidence and Skills: A Multidisciplinary Evaluation of an Emergency Department-Based Procedure Team Rotation</article-title></title-group><contrib-group><contrib contrib-type="editor"><name><surname>Muacevic</surname><given-names>Alexander</given-names></name></contrib><contrib contrib-type="editor"><name><surname>Adler</surname><given-names>John R</given-names></name></contrib></contrib-group><contrib-group><contrib contrib-type="author" corresp="yes"><name><surname>Langan</surname><given-names>Danielle</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Hassan</surname><given-names>Shorok E</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Shawl</surname><given-names>Arsalan</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Ng</surname><given-names>Norman</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Greenstein</surname><given-names>Josh</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Khamis</surname><given-names>Nehal</given-names></name><xref rid="aff-2" ref-type="aff">2</xref><xref rid="aff-3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Hahn</surname><given-names>Barry</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib></contrib-group><aff id="aff-1">

ref></contrib><contrib contrib-type="author"><name><surname>Mitina</surname><given-names>Yulia</given-names></name><xref ref-type="author-notes" rid="fn5-amjcaserep-19-724"><sup>E</sup></xref><xref ref-type="aff" rid="af6-amjcaserep-19-724"><sup>6</sup></xref></contrib><contrib contrib-type="author"><name><surname>El-Manaa</surname><given-names>Housem</given-names></name><xref ref-type="author-notes" rid="fn2-amjcaserep-19-724"><sup>B</sup></xref><xref ref-type="aff" rid="af1-amjcaserep-19-724"><sup>1</sup></xref></contrib><contrib contrib-type="author"><name><surname>Kopylov</surname><given-names>Philippe</given-names></name><xref ref-type="author-notes" rid="fn1-amjcaserep-19-724"><sup>A</sup></xref><xref ref-type="author-notes" rid="fn7-amjcaserep-19-724"><sup>G</sup></xref><xref ref-type="aff" rid="af1-amjcaserep-19-724"><sup>1</sup></xref></contrib></contrib-group><aff id="af1-amjcaserep-19-724">

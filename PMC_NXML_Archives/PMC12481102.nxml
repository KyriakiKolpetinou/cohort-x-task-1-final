<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">eClinicalMedicine</journal-id><journal-id journal-id-type="iso-abbrev">EClinicalMedicine</journal-id><journal-title-group><journal-title>eClinicalMedicine</journal-title></journal-title-group><issn pub-type="epub">2589-5370</issn><publisher><publisher-name>Elsevier</publisher-name></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41035797</article-id><article-id pub-id-type="pmc">12481102</article-id><article-id pub-id-type="pii">S2589-5370(25)00451-1</article-id><article-id pub-id-type="doi">10.1016/j.eclinm.2025.103518</article-id><article-id pub-id-type="publisher-id">103518</article-id><article-categories><subj-group subj-group-type="heading"><subject>Articles</subject></subj-group></article-categories><title-group><article-title>The effect of focused lung ultrasound on antibiotic prescribing in patients with acute lower respiratory tract infections in Danish general practice (PLUS-FLUS): a pragmatic, randomised controlled, post-market trial</article-title></title-group><contrib-group><contrib contrib-type="author" id="au1"><name><surname>Str&#x000f8;m</surname><given-names>Julie Jepsen</given-names></name><email>jrjepsen@dcm.aau.dk</email><xref rid="aff1" ref-type="aff">a</xref><xref rid="cor1" ref-type="corresp">&#x02217;</xref></contrib><contrib contrib-type="author" id="au2"><name><surname>Andersen</surname><given-names>Camilla Aakj&#x000e6;r</given-names></name><xref rid="aff1" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au3"><name><surname>Bach Jensen</surname><given-names>Martin</given-names></name><xref rid="aff1" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au4"><name><surname>Laust Thomsen</surname><given-names>Janus</given-names></name><xref rid="aff1" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au5"><name><surname>Laursen</surname><given-names>Christian B.</given-names></name><xref rid="aff2" ref-type="aff">b</xref><xref rid="aff3" ref-type="aff">c</xref></contrib><contrib contrib-type="author" id="au6"><name><surname>Skaarup</surname><given-names>S&#x000f8;ren Helbo</given-names></name><xref rid="aff4" ref-type="aff">d</xref></contrib><contrib contrib-type="author" id="au7"><name><surname>Lawaetz Schultz</surname><given-names>Hans Henrik</given-names></name><xref rid="aff5" ref-type="aff">e</xref></contrib><contrib contrib-type="author" id="au8"><name><surname>Hansen</surname><given-names>Malene Plejdrup</given-names></name><xref rid="aff1" ref-type="aff">a</xref><xref rid="aff6" ref-type="aff">f</xref></contrib><aff id="aff1"><label>a</label>Center for General Practice, Aalborg University, Aalborg, Denmark</aff><aff id="aff2"><label>b</label>Department of Respiratory Medicine, Odense University Hospital, Odense, Denmark</aff><aff id="aff3"><label>c</label>Department of Clinical Research, University of Southern Denmark, Odense, Denmark</aff><aff id="aff4"><label>d</label>Department of Respiratory Medicine and Allergy, Aarhus University Hospital, Aarhus, Denmark</aff><aff id="aff5"><label>e</label>Department of Cardiology, Section for Lung Transplantation, Rigshospitalet, Copenhagen, Denmark</aff><aff id="aff6"><label>f</label>Research Unit of General Practice, University of Southern Denmark, Odense, Denmark</aff></contrib-group><author-notes><corresp id="cor1"><label>&#x02217;</label>Corresponding author. Center for General Practice, Aalborg University, Selma Lagerl&#x000f8;fs Vej 249, Gistrup 9260, Denmark. <email>jrjepsen@dcm.aau.dk</email></corresp></author-notes><pub-date pub-type="pmc-release"><day>18</day><month>9</month><year>2025</year></pub-date><!-- PMC Release delay is 0 months and 0 days and was based on <pub-date
						pub-type="epub">.--><pub-date pub-type="collection"><month>10</month><year>2025</year></pub-date><pub-date pub-type="epub"><day>18</day><month>9</month><year>2025</year></pub-date><volume>88</volume><elocation-id>103518</elocation-id><history><date date-type="received"><day>9</day><month>5</month><year>2025</year></date><date date-type="rev-recd"><day>2</day><month>9</month><year>2025</year></date><date date-type="accepted"><day>2</day><month>9</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; 2025 The Author(s)</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p>This is an open access article under the CC BY-NC-ND license (http://creativecommons.org/licenses/by-nc-nd/4.0/).</license-p></license></permissions><abstract id="abs0010"><title>Summary</title><sec><title>Background</title><p>Antimicrobial resistance is a growing global concern. Antibiotic use is the main driver and rational use is essential. General practitioners (GPs) prescribe most antibiotics for patients with acute lower respiratory tract infections (LRTI). This trial assessed whether focused lung ultrasound (FLUS) added to usual care in general practice could reduce antibiotic prescribing at the index consultation.</p></sec><sec><title>Methods</title><p>In this pragmatic, randomised, post-market, superiority trial, adults presenting with acute cough and at least one other symptom of acute LRTI, in whom the GP suspected pneumonia, were invited to participate. 34 GPs across 28 Danish office-based general practice clinics recruited participants. Patients were randomly assigned 1:1, stratified by GP, to receive either usual care (controls), reflecting current standard examination and care, or usual care supplemented with FLUS. The primary outcome was the proportion and relative risk (RR) of patients having antibiotics prescribed at the index consultation. Outcome assessors were blinded to group allocation. All patients were included in the intention-to-treat analyses. The trial was registered at <ext-link ext-link-type="uri" xlink:href="http://ClinicalTrials.gov" id="intref0010">ClinicalTrials.gov</ext-link> (<ext-link ext-link-type="ClinicalTrials.gov" xlink:href="NCT06210282" id="intref0081">NCT06210282</ext-link>).</p></sec><sec><title>Findings</title><p>Between November 1, 2023, and July 10, 2024, 390 patients were enrolled and analysed; 192 were assigned to the FLUS group. In the usual care group (n = 198), 81 patients (41%) were prescribed antibiotics at the index consultation compared with 69 (36%) in the FLUS group (n = 192; RR 0&#x000b7;88, 95% CI: 0&#x000b7;68&#x02013;1&#x000b7;14). No evidence of harm was identified with the addition of FLUS to usual care.</p></sec><sec><title>Interpretation</title><p>Addition of FLUS did not lead to a 15% or larger reduction in antibiotic prescribing at the index consultation. Routine implementation of FLUS in this patient population is not supported by the findings. However, no evidence of harm was observed with the addition of FLUS.</p></sec><sec><title>Funding</title><p><funding-source id="gs1">The Health Foundation</funding-source>, <funding-source id="gs2">The Foundation for General Practice</funding-source>, <funding-source id="gs3">The Lung Association's Research Fund</funding-source>, and <funding-source id="gs4">regional committees for Quality and Education</funding-source>.</p></sec></abstract><kwd-group id="kwrds0010"><title>Keywords</title><kwd>Respiratory tract infection</kwd><kwd>Ultrasonography</kwd><kwd>General practice</kwd><kwd>Anti-bacterial Agents</kwd><kwd>Pragmatic clinical trial</kwd></kwd-group></article-meta></front><body><p id="p0010">
<boxed-text id="dtbox1"><caption><title>Research in context</title></caption><sec id="dtbox1sec1"><title>Evidence before this study</title><p id="p0015">We searched PubMed for articles published, in any language, between database inception and August 27, 2025, using the terms ((lung ultrasound) AND (general practice OR primary care)) AND ((community acquired pneumonia) OR (antibiotic)), yielding a total of 143 articles. Compared with chest x-ray, pathological focused lung ultrasound (FLUS) findings of a consolidation measuring &#x0003e;1 cm or a focal/asymmetrical B-lines pattern have shown a sensitivity of 87&#x000b7;8% and a specificity of 58&#x000b7;5% in one study in a general practice population. A practical algorithm incorporating chest x-ray to improve specificity has been proposed but may be unfeasible in many primary care settings. The effect of FLUS on antibiotic prescribing has only been evaluated once but in combination with procalcitonin point-of-care (POC) testing, in which it did not provide additional reduction in prescribing rates.</p></sec><sec id="dtbox1sec2"><title>Added value of this study</title><p id="p0020">The clinical impact of adding FLUS as a standalone POC examination on antibiotic prescribing in general practice was unexplored prior to this study. We show that our approach of adding FLUS, guided by clinical integration principles rather than a fixed diagnostic algorithm, to usual care management containing C-reactive protein POC testing, does not lead to a 15% or larger reduction in antibiotic prescribing. As this trial was not powered to detect a smaller reduction, more or larger studies are needed to detect a potential more modest effect of FLUS on antibiotics prescribing. However, FLUS was associated with fewer reconsultations for the same lower respiratory tract infection (LRTI) episode in general practice or out-of-hours primary care, possibly reflecting a reassurance effect for both GPs and patients regarding the initial diagnosis. This trial was conducted with a pragmatic design across a broad sample of general practices in Denmark, enhancing the generalisability of the findings. The near-complete follow-up and high diary completion rate further strengthen the validity of the results. Although the primary outcome did not reach statistical significance, the observed reduction in reconsultations suggests that FLUS may contribute to improved confidence in clinical decision-making.</p></sec><sec id="dtbox1sec3"><title>Implications of all the available evidence</title><p id="p0025">Current evidence does not support routine use of FLUS in all adults presenting in general practice with symptoms of acute lower respiratory tract infection where pneumonia is suspected. However, there is no evidence to suggest that FLUS poses a safety concern in this patient population. More evidence is needed to inform clinical integration strategies or diagnostic algorithms, that combine clinical assessment and FLUS findings to enhance specificity without increasing the risk of undertreatment.</p></sec></boxed-text>
</p><sec id="sec1"><title>Introduction</title><p id="p0030">The threat of antimicrobial resistance is among the most pressing concerns for global public health. Antibiotic use is recognised as the main driver,<xref rid="bib1" ref-type="bibr"><sup>1</sup></xref> and prescribing in primary healthcare, particularly in general practice, is a major contributor.<xref rid="bib2" ref-type="bibr"><sup>2</sup></xref> Acute lower respiratory tract infections (LRTIs) are among the most common indications for antibiotic use in general practice,<xref rid="bib3" ref-type="bibr"><sup>3</sup></xref> despite most being of viral origin and unlikely to benefit from antibiotic treatment.<xref rid="bib4" ref-type="bibr"><sup>4</sup></xref> The diagnosis of pneumonia in general practice relies heavily on clinical assessment,<xref rid="bib5" ref-type="bibr"><sup>5</sup></xref> and differentiating self-limiting viral infections from bacterial pneumonia is often challenging.<xref rid="bib6" ref-type="bibr"><sup>6</sup></xref><sup>,</sup><xref rid="bib7" ref-type="bibr"><sup>7</sup></xref> It is well known that this diagnostic uncertainty results in overuse of antibiotics.<xref rid="bib7" ref-type="bibr"><sup>7</sup></xref></p><p id="p0035">Point-of-care (POC) test strategies have been introduced to support general practitioners (GPs) in differentiating bacterial from viral infections. The C-reactive protein (CRP) POC test is the most widely used and reduces the likelihood of unnecessary antibiotic prescribing.<xref rid="bib8" ref-type="bibr"><sup>8</sup></xref> Danish national guidelines recommend the CRP &#x02018;speedometer&#x02019; model, in which the recommendation to prescribe antibiotics increases from CRP 20 mg/L towards values above 100 mg/L.<xref rid="bib5" ref-type="bibr"><sup>5</sup></xref><sup>,</sup><xref rid="bib9" ref-type="bibr"><sup>9</sup></xref> Within this CRP interval, the decision to prescribe antibiotics should primarily depend on clinical assessment. However, multiple CRP algorithms exist, and studies report variation in adherence.<xref rid="bib10" ref-type="bibr"><sup>10</sup></xref> Chest x-ray is used in fewer than 10% of patients as a diagnostic aid for pneumonia in Danish general practice.<xref rid="bib11" ref-type="bibr"><sup>11</sup></xref> Thus, imaging is not routinely used in the diagnostic work-up of patients presenting with acute LRTI in Danish general practice. Consequently, strategies to reduce diagnostic uncertainty are needed to support GPs in adopting more restrictive antibiotic prescribing, without increasing the risk of delayed antibiotic prescribing. Focused lung ultrasound (FLUS) has gained increasing attention as a POC diagnostic tool in recent years. Numerous reviews and meta-analyses support FLUS as a valuable tool for diagnosing pneumonia with high diagnostic accuracy.<xref rid="bib12" ref-type="bibr">12</xref>, <xref rid="bib13" ref-type="bibr">13</xref>, <xref rid="bib14" ref-type="bibr">14</xref> However, most evidence stems from secondary care settings and hospitalised populations. Ultrasound is now increasingly available and used in general practices for various purposes.<xref rid="bib15" ref-type="bibr"><sup>15</sup></xref> To date, general practice research on FLUS has focused on training GPs,<xref rid="bib16" ref-type="bibr">16</xref>, <xref rid="bib17" ref-type="bibr">17</xref>, <xref rid="bib18" ref-type="bibr">18</xref>, <xref rid="bib19" ref-type="bibr">19</xref> the diagnostic accuracy and feasibility of FLUS<xref rid="bib20" ref-type="bibr"><sup>20</sup></xref><sup>,</sup><xref rid="bib21" ref-type="bibr"><sup>21</sup></xref> and its effect on antibiotic prescribing when combined with procalcitonin POC testing.<xref rid="bib22" ref-type="bibr"><sup>22</sup></xref> The clinical impact of adding FLUS as a standalone POC modality on antibiotic prescribing in general practice remains unexplored.<xref rid="bib23" ref-type="bibr"><sup>23</sup></xref></p><p id="p0040">The aim of this randomised controlled trial was to evaluate the effect of adding FLUS to usual care on antibiotic prescribing in patients with acute LRTI in whom the GP suspected pneumonia. A potential reduction in antibiotic prescribing was not intended to result in undertreatment of bacterial infections; consequently, patients&#x02019; clinical course was closely monitored as a secondary objective.</p></sec><sec id="sec2"><title>Methods</title><sec id="sec2.1"><title>Study design and participants</title><p id="p0045">The PLUS-FLUS study was conducted as a pragmatic, randomised post-market (phase 5) superiority trial with a parallel two-group design, involving 34 GPs from 28 office-based general practice clinics across Denmark. GPs were involved as an advisory panel during the study design phase to ensure clinical relevance and feasibility. This trial is registered and statistical analysis plan available at <ext-link ext-link-type="uri" xlink:href="https://clinicaltrials.gov/" id="intref0015">ClinicalTrials.gov</ext-link>, <ext-link ext-link-type="uri" xlink:href="https://clinicaltrials.gov/study/NCT06210282?term=NCT06210282&#x00026;rank=1" id="intref0020">NCT06210282</ext-link>.</p><p id="p0050">Eligible patients were consecutively identified by the GP or assisting staff upon presentation to participating clinics. Adults (&#x02265;18 years) with acute cough (&#x0003c;21 days) and at least one additional symptom of acute LRTI (e.g. fever, sputum, dyspnoea, wheezing, chest discomfort), in whom the GP suspected bacterial pneumonia, were invited by the GP to participate. Patients were excluded if they: (1) had received antibiotic treatment for the current episode of acute LRTI, (2) were not listed with the GP (making medical record follow-up impossible), (3) were unable to understand or provide informed consent, or (4) declined to participate.</p><p id="p0055">Specialists in family medicine, working as GPs and using ultrasound weekly in practice or out-of-hours primary care, were eligible to enrol patients. Completion of a FLUS training programme with a validated assessment was required; those already trained attended a 1-h brush-up session. Accordingly, a FLUS training programme was offered before patient enrolment. Details of GP recruitment strategy, timeline of enrolment, and description of the FLUS training programme offered, are found in the <xref rid="appsec1" ref-type="sec">supplementary material</xref>.</p><p id="p0060">All participants gave written informed consent, patients including consent for data extraction from medical and Shared Medication Records. Patients&#x02019; sex was recorded using the unique personal identification number assigned to all Danish citizens while GPs self-reported this as free-text.</p></sec><sec id="sec2.2"><title>Ethics</title><p id="p0065">The study protocol<xref rid="bib24" ref-type="bibr"><sup>24</sup></xref> was approved by The Research Unit for General Practice in Aalborg (194-2) and the Scientific Ethics Committee of North Denmark Region (reference number: N-20230038). The study was conducted in accordance with the protocol without any adaptations. Written informed consent was obtained from all GPs and patients ahead of enrolment.</p></sec><sec id="sec2.3"><title>Randomisation and masking</title><p id="p0070">Patients were randomly assigned in a 1:1 ratio to either usual care (control) or FLUS (intervention), where GPs performed and interpreted FLUS as an additional procedure during the index consultation (day 0). Randomisation was performed using a web-based system with permuted block sizes (2, 4, 6), stratified by GP for balanced enrolment. Allocation sequences and sealed envelopes were prepared by two affiliated researchers not otherwise involved in the trial. At randomisation, the GP opened the top envelope and group allocation was revealed to both the GP and the patient. Outcome assessors and data analysts were blinded to group allocation. until database lock and primary analysis completion.</p></sec><sec id="sec2.4"><title>Procedures</title><p id="p0075">All patients received usual care, reflecting current standard diagnostic assessments and clinical management in Danish general practices. Usual care was recommended to follow national guidelines, which define pneumonia as a clinical diagnosis based on symptoms (acute cough and at least one other LRTI symptom) and clinical signs such as poor general condition and/or fever.<xref rid="bib9" ref-type="bibr"><sup>9</sup></xref><sup>,</sup><xref rid="bib25" ref-type="bibr"><sup>25</sup></xref> POC CRP testing was recommended. No clear recommendations were provided regarding referral for chest x-ray. FLUS was not considered part of usual care. Randomisation took place after usual care completion and before any treatment was commenced.</p><p id="p0080">Patients randomised to the FLUS group received a FLUS examination in addition to usual care. GPs were instructed to follow a 14-zone FLUS scanning protocol previously applied across various settings,<xref rid="bib26" ref-type="bibr"><sup>26</sup></xref><sup>,</sup><xref rid="bib27" ref-type="bibr"><sup>27</sup></xref> including general practice in a similar patient population.<xref rid="bib19" ref-type="bibr"><sup>19</sup></xref> The positioning of the patient during the examination was decided by the GP, either an upright or supine position or both. GPs used the ultrasound device available to them in their clinic. Types, brands, models and transducers are provided in the <xref rid="appsec1" ref-type="sec">supplementary material</xref>.</p><p id="p0085">GPs were trained to identify and classify FLUS pathological findings according to the European Federation of Societies for Ultrasound in Medicine and Biology (EFSUMB) coursebook,<xref rid="bib28" ref-type="bibr"><sup>28</sup></xref> the feasibility of which had previously been tested in general practice.<xref rid="bib19" ref-type="bibr"><sup>19</sup></xref> See the <xref rid="appsec1" ref-type="sec">supplementary material</xref> for the classification of pathological findings.</p><p id="p0090">GPs were guided to interpret FLUS findings according to the following principles: Small subpleural consolidations (2&#x02013;20 mm), multiple and bilateral, with pleural irregularities and bilateral B-lines typically suggest a viral infection. In contrast, larger unilateral consolidations with air bronchogram, and in some cases pleural effusion, often indicate bacterial infection. Depending on infection severity, focal multiple B-lines might be the only detectable sign of bacterial infection, potentially indicating early or mild disease; however, their diagnostic specificity remains limited.<xref rid="bib29" ref-type="bibr"><sup>29</sup></xref><sup>,</sup><xref rid="bib30" ref-type="bibr"><sup>30</sup></xref> Nevertheless, FLUS cannot detect infections confined to the deeper lung parenchyma that do not extend to the tissue directly beneath the visceral pleura. Based on this knowledge, the clinical integration of FLUS and its implications for patient management were left to the discretion of the GPs. The FLUS training programme and 1-h brush-up session included guidance on the interpretation of pathological findings and the principles for clinical integration as described above.</p><p id="p0095">For each enrolled patient, the GP completed an electronic case report form in REDCap&#x000a9;<xref rid="bib31" ref-type="bibr"><sup>31</sup></xref> (developed by Vanderbilt University and hosted by Aalborg University, Denmark) during or immediately after the index consultation. Information included patient baseline characteristics, symptoms, clinical findings, and any POC tests performed (e.g. CRP). The GP also registered in the case report form whether antibiotics were prescribed at the index consultation (yes/no) (primary outcome data), specifying if the prescription was immediate or wait-and-see. For patients allocated to the FLUS group, the GP documented FLUS findings.</p><p id="p0100">During follow-up, GPs were permitted to reassess patients at any time if deemed necessary, and no concomitant care or diagnostic procedures were restricted. All follow-up data were likewise collected using REDCap&#x000a9;.</p><p id="p0105">Patients received a validated LRTI Symptom Diary via short message service (SMS), covering the period from day 0 to day 21.<xref rid="bib32" ref-type="bibr"><sup>32</sup></xref> The diary included items covering six dimensions: cough, dyspnoea, sputum production, general well-being, sleep disturbance and activity limitations. Patients were asked to score each of the six dimensions daily using a seven-point Likert scale (0 = no problem to 6 = as bad as it could be). The diary also contained daily questions regarding cancellation of work-related and leisure activities. On the day of the index consultation, patients were also asked to rate their satisfaction with the consultation, assessed on a five-point Likert scale (1 = very dissatisfied to 5 = very satisfied). A paper version of the diary was offered to patients who preferred not to receive the electronic format.</p><p id="p0110">Data on changes in medication or new prescriptions across all healthcare sectors are automatically uploaded to a Danish national digital system, the Shared Medication Record. The principal investigator (PI) collected data on all antibiotics prescribed for systemic use (Anatomical Therapeutic Chemical Classification System [ATC] code J01) from day 0&#x02013;28, regardless of indication, using the patients&#x02019; Shared Medication Records.</p><p id="p0115">The PI collected patients' medical records on-site at general practice clinics, covering all documentation from general practice and correspondence from both primary and secondary care from day 0&#x02013;60. An affiliated researcher, not otherwise involved in the trial, pseudonymised the records and concealed group allocation. The PI and a second affiliated researcher independently extracted relevant data using a pilot-tested data extraction tool. The datasets were compared, and discrepancies resolved through reassessment of the respective patient's medical record.</p></sec><sec id="sec2.5"><title>Outcomes</title><p id="p0120">The primary outcome was the proportion of patients prescribed antibiotics at the index consultation (day 0), reported by the GP. The relative risk (RR) of antibiotic prescribing at the index consultation was also calculated to compare groups.</p><p id="p0125">Secondary outcomes and prespecified exploratory outcomes (&#x02217;) from the LRTI symptom diary were: (1) The daily total LRTI symptom score, calculated as the sum of scores for six symptoms, with values ranging from 0 to 36. The scores were presented as mean or median from day 0 to day 21. (2) The number of days with symptoms rated as a 'moderate problem' or worse (at least one symptom received a score of 3 or higher), presented as mean or median days in the period from day 0 to day 21. (3) The number of days patients signed in sick or cancelled work-related activities, presented as mean or median days in the period from day 0 to day 21. (4) The number of days patients cancelled leisure activities, presented as mean or median days in the period from day 0 to day 21. (5) &#x02217;Satisfaction with the index consultation on day 0 was measured by the proportion of patients who reported being satisfied or very satisfied (scores of 4 or 5) with the index consultation.</p><p id="p0130">Secondary outcomes and prespecified exploratory outcomes (&#x02217;) from patients&#x02019; Shared Medication Records and regarding type of antibiotic prescription were: (1) The proportion of patients prescribed antibiotics within 7 days following the index consultation. (2) The proportion of patients prescribed antibiotics within 28 days following the index consultation. (3) &#x02217;The proportion of prescriptions prescribed as delayed antibiotic prescription at the index consultation.</p><p id="p0135">Secondary outcomes and prespecified exploratory outcomes (&#x02217;) from patients&#x02019; Electronic Medical Records were: (1) &#x02217;The proportion of patients who had any primary care contact (defined as any contact with general practice or out-of-hours services) within 28 days after the index consultation. (2) &#x02217;The proportion of patients who had any primary care contact (defined as any contact with general practice or out-of-hours services) for the LRTI episode within 28 days after the index consultation. (3) The proportion of patients admitted to the hospital within 28 days following the index consultation. (4) The proportion of patients with complications during hospitalisation (pleural infection (complicated parapneumonic effusion or empyema), lung abscess, or sepsis)) within 28 days after the index consultation. (5) &#x02217;The proportion of patients who underwent any imaging other than FLUS in secondary health care services within 28 days after the index consultation. (6) &#x02217;The types of other imaging modalities performed within 28 days after the index consultation. (7) &#x02217;The proportion of patients referred for suspected cancer within 60 days after the index consultation. (8) &#x02217;The proportion of patients diagnosed with cancer within 60 days after the index consultation. (9) The number of spontaneously reported unintended events by GPs up to 60 days after the index consultation. (10) The proportion of patients who died from any cause by day 28 and day 60.</p></sec><sec id="sec2.6"><title>Statistical analysis</title><p id="p0140">A sample size of 340 patients, with 170 allocated to each arm, was calculated to provide 80% power at a 5% significance level to detect an absolute reduction in antibiotic prescribing from 50% in the usual care group to 35% in the &#x02009;FLUS group. These assumptions were informed by previous studies on patients with LRTI in general practice.<xref rid="bib7" ref-type="bibr"><sup>7</sup></xref><sup>,</sup><xref rid="bib11" ref-type="bibr"><sup>11</sup></xref><sup>,</sup><xref rid="bib33" ref-type="bibr"><sup>33</sup></xref> We assumed a maximum dropout or discontinuation rate of 10% and increased the sample size by an additional 5% to adjust for covariates in the analyses. Consequently, we aimed to include a total of 390 patients (195 in each arm).</p><p id="p0145">Baseline characteristics were tested for normality. Normally distributed data were presented as means with standard deviation. Non-normally distributed data were presented as medians with interquartile ranges. All patients were analysed according to the intention-to-treat principle. Mixed-effects Poisson regressions with robust variance estimation were used to estimate RRs with 95% confidence intervals (CIs). Chi-square test was used for comparison of proportions. A mixed-effects repeated-measures model was used for comparing daily symptom diary scores. Generalised linear models were used to estimate outcome means. Formal interaction tests were performed on predefined subgroups. All analyses accounted for clustering by the 34 recruiting GPs to adjust for variations in usual care. To address non-normality in outcome data, bootstrap resampling with 1000 iterations was applied. No data monitoring committee was established and no interim analyses performed. All analyses were conducted using STATA 17&#x000b7;0 (StataCorp. 2021. Stata: Release 17. Statistical Software. College Station, TX: StataCorp LLC.)</p></sec><sec id="sec2.7"><title>Role of funding source</title><p id="p0150">The funders of the study had no role in study design, data collection, data analyses, interpretation, or writing of the report.</p></sec></sec><sec id="sec3"><title>Results</title><p id="p0155">Between November 1, 2023, and July 10, 2024, 523 patients were assessed for eligibility and 392 were enrolled, meeting the planned sample size. Of these, 199 patients were randomly assigned to the usual care group and 193 patients to FLUS group. One patient in each group was excluded after enrolment but before analysis due to being under 18 years of age. One patient in the usual care group received FLUS at the index consultation but was included in the intention-to-treat analysis, resulting in 390 patients analysed for the primary outcome (<xref rid="fig1" ref-type="fig">Fig. 1</xref>).<fig id="fig1"><label>Fig. 1</label><caption><p>Trial profile. LRTI, Lower respiratory tract infection; GP, General practitioner; FLUS, Focused lung ultrasound.</p></caption><graphic xlink:href="gr1"/></fig></p><p id="p0160">Baseline characteristics were generally similar between groups (<xref rid="tbl1" ref-type="table">Table 1</xref>), apart from a higher prevalence of asthma in the FLUS group and more non-pulmonary comorbidities in the usual care group that could influence the indication for antibiotics. The median age of patients was 58 years (IQR:44&#x02013;70), and 211 of 390 (54%) were female. The most common symptoms at the index consultation were sputum production in 78% (303/390), fever (temperature &#x02265;38&#x000b7;0 &#x000b0;C) in 54% (209/390) and dyspnoea in 52% of patients (202/390). The most frequent clinical finding reported by GPs was abnormal lung auscultation in 41% of patients (158/390), and almost all patients (99% (388/390)) underwent CRP POC testing. The median CRP value was 16 mg/L (IQR:5&#x000b7;8&#x02013;51&#x000b7;0).<table-wrap position="float" id="tbl1"><label>Table 1</label><caption><p>Baseline characteristics of patients.</p></caption><table frame="hsides" rules="groups"><thead><tr><th/><th colspan="2">FLUS (N = 192)</th><th colspan="2">Usual care (N = 198)</th></tr></thead><tbody><tr><td><italic>Female, sex</italic><xref rid="tbl1fng" ref-type="table-fn">g</xref></td><td>116</td><td align="char">(60%)</td><td>95</td><td align="char">(48%)</td></tr><tr><td><italic>Age at randomisation (</italic>years)<xref rid="tbl1fng" ref-type="table-fn">g</xref></td><td>57</td><td align="char">(42&#x02013;69)</td><td>59</td><td align="char">(46&#x02013;71)</td></tr><tr><td><italic>Comorbidities</italic></td><td/><td/><td/><td/></tr><tr><td>&#x000a0;None</td><td>109</td><td align="char">(57%)</td><td>109</td><td align="char">(55%)</td></tr><tr><td>&#x000a0;Heart failure</td><td>3</td><td align="char">(2%)</td><td>6</td><td align="char">(3%)</td></tr><tr><td>&#x000a0;COPD</td><td>15</td><td align="char">(8%)</td><td>23</td><td align="char">(12%)</td></tr><tr><td>&#x000a0;Asthma</td><td>31</td><td align="char">(16%)</td><td>20</td><td align="char">(10%)</td></tr><tr><td>&#x000a0;Other lung disease comorbidities<xref rid="tbl1fna" ref-type="table-fn">a</xref></td><td>3</td><td align="char">(2%)</td><td>8</td><td align="char">(4%)</td></tr><tr><td>&#x000a0;Other relevant to FLUS findings<xref rid="tbl1fnb" ref-type="table-fn">b</xref></td><td>2</td><td align="char">(1%)</td><td>7</td><td align="char">(4%)</td></tr><tr><td>&#x000a0;Other relevant to antibiotics<xref rid="tbl1fnc" ref-type="table-fn">c</xref></td><td>7</td><td align="char">(4%)</td><td>19</td><td align="char">(10%)</td></tr><tr><td><italic>Smoking status</italic></td><td/><td/><td/><td/></tr><tr><td>&#x000a0;Current smoker</td><td>33</td><td align="char">(17%)</td><td>34</td><td align="char">(17%)</td></tr><tr><td>&#x000a0;Former smoker</td><td>65</td><td align="char">(34%)</td><td>80</td><td align="char">(41%)</td></tr><tr><td><italic>Patient-reported symptoms</italic></td><td/><td/><td/><td/></tr><tr><td>&#x000a0;Sputum production</td><td>146</td><td align="char">(76%)</td><td>157</td><td align="char">(79%)</td></tr><tr><td>&#x000a0;Dyspnoea</td><td>107</td><td align="char">(56%)</td><td>95</td><td align="char">(48%)</td></tr><tr><td>&#x000a0;Fever (&#x02265;38.0 &#x000b0;C)</td><td>103</td><td align="char">(54%)</td><td>106</td><td align="char">(54%)</td></tr><tr><td>&#x000a0;Temperature (&#x000b0;C)<xref rid="tbl1fnd" ref-type="table-fn">d</xref></td><td>38&#x000b7;4</td><td align="char">(38&#x02013;39)</td><td>38&#x000b7;4</td><td align="char">(38-38&#x000b7;9)</td></tr><tr><td>&#x000a0;Chest discomfort</td><td>91</td><td align="char">(47%)</td><td>82</td><td align="char">(41%)</td></tr><tr><td>&#x000a0;Poor general well-being</td><td>49</td><td align="char">(26%)</td><td>39</td><td align="char">(20%)</td></tr><tr><td>&#x000a0;Other</td><td>11</td><td align="char">(6%)</td><td>9</td><td align="char">(5%)</td></tr><tr><td><italic>Clinical findings</italic></td><td/><td/><td/><td/></tr><tr><td>&#x000a0;Abnormal lung auscultation</td><td>73</td><td align="char">(38%)</td><td>85</td><td align="char">(43%)</td></tr><tr><td>&#x000a0;Sputum</td><td>55</td><td align="char">(29%)</td><td>61</td><td align="char">(31%)</td></tr><tr><td>&#x000a0;Poor general appearance</td><td>34</td><td align="char">(18%)</td><td>25</td><td align="char">(13%)</td></tr><tr><td>&#x000a0;None</td><td>7</td><td align="char">(4%)</td><td>8</td><td align="char">(4%)</td></tr><tr><td><italic>Vital signs</italic></td><td/><td/><td/><td/></tr><tr><td>&#x000a0;Increased respiratory rate measured<xref rid="tbl1fne" ref-type="table-fn">e</xref></td><td>25</td><td align="char">(13%)</td><td>16</td><td align="char">(8%)</td></tr><tr><td>&#x000a0;Respiratory rate (breaths/min.)<xref rid="tbl1fnd" ref-type="table-fn">d</xref></td><td>23</td><td align="char">(22&#x02013;26)</td><td>22</td><td align="char">(20&#x02013;25)</td></tr><tr><td>&#x000a0;O<sub>2</sub> saturation performed</td><td>70</td><td align="char">(37%)</td><td>61</td><td align="char">(31%)</td></tr><tr><td>&#x000a0;O<sub>2</sub> saturation (%)<xref rid="tbl1fnd" ref-type="table-fn">d</xref><xref rid="tbl1fnf" ref-type="table-fn">f</xref></td><td>97</td><td align="char">(95&#x02013;98)</td><td>97</td><td align="char">(95&#x02013;98)</td></tr><tr><td><italic>Point-of-care testing</italic></td><td/><td/><td colspan="2"/></tr><tr><td>&#x000a0;CRP poct performed</td><td>190</td><td align="char">(99%)</td><td>198</td><td align="char">(100%)</td></tr><tr><td>&#x000a0;CRP level (mg/L)<xref rid="tbl1fnd" ref-type="table-fn">d</xref></td><td>15</td><td align="char">(5&#x02013;48)</td><td>16</td><td align="char">(7&#x02013;53)</td></tr><tr><td>&#x000a0;Leucocytes poct performed</td><td>20</td><td align="char">(10%)</td><td>19</td><td align="char">(10%)</td></tr><tr><td>&#x000a0;Leucocytes (10<sup>9</sup>/L)<xref rid="tbl1fnd" ref-type="table-fn">d</xref></td><td>8&#x000b7;4</td><td align="char">(7&#x000b7;4&#x02013;9&#x000b7;6)</td><td>8&#x000b7;9</td><td align="char">(7&#x000b7;5&#x02013;11&#x000b7;0)</td></tr></tbody></table><table-wrap-foot><fn id="tspara0015"><p>Values presented as n (%) or median (IQR).</p></fn><fn id="tspara0020"><p>FLUS, Focused lung ultrasound; COPD, Chronic obstructive pulmonary disease; poct, point-of-care test; CRP, C-reactive protein; IQR, Interquartile range.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl1fna"><label>a</label><p id="ntpara0010">Interstitial lung disease, lung cancer, lung tuberculosis and bronchiectasis.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl1fnb"><label>b</label><p id="ntpara0015">Comorbidities potentially affecting FLUS findings, as judged by the GP.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl1fnc"><label>c</label><p id="ntpara0020">Comorbidities potentially affecting antibiotic prescribing decisions, as judged by the GP.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl1fnd"><label>d</label><p id="ntpara0025">Values are based on patients in whom the test was performed and result reported: Temperature (FLUS: 72 patients/usual care: 75 patients), Respiratory rate (19/14), O<sub>2</sub> saturation (70/61), CRP level (189/198), Leucocytes (19/18).</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl1fne"><label>e</label><p id="ntpara0030">Increased respiratory rate defined as &#x02265; 20 breaths/min.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl1fnf"><label>f</label><p id="ntpara0035">Without O<sub>2</sub> supplementation.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl1fng"><label>g</label><p id="ntpara0040">Median age of the 131 excluded patients was 60 years and 56&#x000b7;5% were female.</p></fn></table-wrap-foot></table-wrap></p><p id="p0165">For the primary outcome, 69 of 192 patients (36%) in the FLUS group were prescribed antibiotics at index consultation. In the usual care group, 81 of 198 patients (41%) were prescribed antibiotics, corresponding to a non-significant reduction in risk in the FLUS group, with a RR of 0&#x000b7;88 (95% CI: 0&#x000b7;68&#x02013;1&#x000b7;14) (<xref rid="tbl2" ref-type="table">Table 2</xref>). Detailed subgroup analyses of the primary outcome for patients with CRP &#x02265;50 mg/L, age &#x02265;80 years, COPD or general lung disease comorbidities are presented in the <xref rid="appsec1" ref-type="sec">supplementary material</xref>.<table-wrap position="float" id="tbl2"><label>Table 2</label><caption><p>Primary and secondary outcomes: antibiotics prescribing, reconsultations, complications and imaging.</p></caption><table frame="hsides" rules="groups"><thead><tr><th/><th colspan="2">FLUS (N = 192)</th><th colspan="2">Usual care (N = 198)</th><th>RR (95% CI)</th></tr></thead><tbody><tr><td>Antibiotics at index consultation</td><td>69/192</td><td align="char">(36%)</td><td>81/198</td><td align="char">(41%)</td><td align="char">0&#x000b7;88 (0&#x000b7;68&#x02013;1&#x000b7;14)</td></tr><tr><td>Wait-and-see prescriptions</td><td>4/69</td><td align="char">(6%)</td><td>7/81</td><td align="char">(9%)</td><td align="char">0&#x000b7;65 (0&#x000b7;32&#x02013;1&#x000b7;33)</td></tr><tr><td>Antibiotics within 7 days</td><td>81/192</td><td align="char">(42%)</td><td>99/195</td><td align="char">(50%)</td><td align="char">0&#x000b7;83 (0&#x000b7;66&#x02013;1&#x000b7;05)</td></tr><tr><td>Antibiotics within 28 days</td><td>88/192</td><td align="char">(46%)</td><td>105/195</td><td align="char">(54%)</td><td align="char">0&#x000b7;85 (0&#x000b7;67&#x02013;1&#x000b7;08)</td></tr><tr><td>Reconsultations<xref rid="tbl2fna" ref-type="table-fn">a</xref><xref rid="tbl2fnc" ref-type="table-fn">c</xref></td><td>118/192</td><td align="char">(62%)</td><td>133/195</td><td align="char">(68%)</td><td align="char">0&#x000b7;90 (0&#x000b7;73&#x02013;1&#x000b7;11)</td></tr><tr><td>Reconsultations for LRTI<xref rid="tbl2fna" ref-type="table-fn">a</xref><xref rid="tbl2fnc" ref-type="table-fn">c</xref></td><td>79/192</td><td align="char">(41%)</td><td>106/195</td><td align="char">(54%)</td><td align="char">0&#x000b7;76 (0&#x000b7;58&#x02013;0&#x000b7;98)<xref rid="tbl2fnf" ref-type="table-fn">f</xref></td></tr><tr><td>Admission to hospital<xref rid="tbl2fna" ref-type="table-fn">a</xref></td><td>11/192</td><td align="char">(6%)</td><td>11/195</td><td align="char">(6%)</td><td align="char">1&#x000b7;02 (0&#x000b7;44&#x02013;2&#x000b7;35)</td></tr><tr><td>Complications<xref rid="tbl2fna" ref-type="table-fn">a</xref><xref rid="tbl2fnd" ref-type="table-fn">d</xref></td><td>1/192</td><td align="char">(0&#x000b7;5%)</td><td>1/195</td><td align="char">(0&#x000b7;5%)</td><td align="char">1&#x000b7;02 (0&#x000b7;06&#x02013;16&#x000b7;8)</td></tr><tr><td>Other imaging<xref rid="tbl2fna" ref-type="table-fn">a</xref><xref rid="tbl2fne" ref-type="table-fn">e</xref></td><td>26/192</td><td align="char">(14%)</td><td>38/195</td><td align="char">(20%)</td><td align="char">0&#x000b7;69 (0&#x000b7;46&#x02013;1&#x000b7;04)</td></tr><tr><td>Referred with suspicion of cancer<xref rid="tbl2fnb" ref-type="table-fn">b</xref></td><td>5/191</td><td align="char">(3%)</td><td>13/195</td><td align="char">(6%)</td><td align="char">0&#x000b7;39 (0&#x000b7;11&#x02013;1&#x000b7;42)</td></tr><tr><td>Diagnosed with cancer<xref rid="tbl2fnb" ref-type="table-fn">b</xref></td><td>0/191</td><td align="char">(0%)</td><td>0/195</td><td align="char">(0%)</td><td align="char">1&#x000b7;00 (NA)</td></tr><tr><td>All-cause mortality<xref rid="tbl2fnb" ref-type="table-fn">b</xref></td><td>0/191</td><td align="char">(0%)</td><td>0/195</td><td align="char">(0%)</td><td align="char">1&#x000b7;00 (NA)</td></tr></tbody></table><table-wrap-foot><fn id="tspara0030"><p>Values presented as n/N (%).</p></fn><fn id="tspara0035"><p>FLUS, Focused lung ultrasound; RR, Relative risk; CI, Confidence interval.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl2fna"><label>a</label><p id="ntpara0045">Within 28 days after the index consultation.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl2fnb"><label>b</label><p id="ntpara0050">Within 60 days after the index consultation.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl2fnc"><label>c</label><p id="ntpara0055">Reconsultations defined as any primary care contact (general practice or out-of-hour services).</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl2fnd"><label>d</label><p id="ntpara0060">Complications defined as pleural infection (complicated parapneumonic effusion or empyema), lung abscess or sepsis during hospital admission.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl2fne"><label>e</label><p id="ntpara0065">Any other imaging than FLUS performed in the secondary healthcare sector.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl2fnf"><label>f</label><p id="ntpara0070">p = 0&#x000b7;038.</p></fn></table-wrap-foot></table-wrap></p><p id="p0170">For secondary outcomes, follow-up data from Shared Medication Records and medical records were available for 387 patients. Secondary outcome results are presented in <xref rid="tbl2" ref-type="table">Table 2</xref>. In both groups, antibiotic prescriptions accumulated through day seven, with a higher proportion in the usual care group (99 of 195 patients, 50%) than in the FLUS group (81 of 192 patients, 42%). Still, the RR of having antibiotics prescribed up until day seven was not significantly lower in the FLUS group than in the usual care group (<xref rid="tbl2" ref-type="table">Table 2</xref>). A total of 18 patients were referred for suspected cancer within 60 days. Of these, five patients in the usual care group and one in the FLUS group were specifically referred for suspected lung cancer. The RR of patient reconsultation for the current LRTI episode in general practice or out-of-hour primary care within 28 days was significantly lower in the FLUS group (RR 0&#x000b7;76, CI: 0&#x000b7;58&#x02013;0&#x000b7;98, p = 0&#x000b7;038), but no significant difference was found for reconsulting for any reason (<xref rid="tbl2" ref-type="table">Table 2</xref>). Chest x-ray was the most frequently used secondary imaging modality, performed in 19 of 192 patients (10%) in the FLUS group and 22 of 195 patients (11%) in the usual care group. Chest CT was performed in four of 192 patients (2%) in the FLUS group and six of 195 patients (3%) in the usual care group. Imaging unrelated to the lungs (e.g., other ultrasonography modalities, magnetic resonance imaging (MRI), CT or x-ray (not of the chest)) was performed in five patients in the FLUS group and 13 patients in the usual care group.</p><p id="p0175">Of the 390 patients enrolled, 353 (91%) completed at least one day of the LRTI symptom diary: 183 in the FLUS group and 170 in the usual care group. The overall response rate was 81% with a mean of 18 (SD 5&#x000b7;7) days completed in the FLUS group and 17 (SD 6&#x000b7;5) days in the usual care group. No significant differences were observed between the two groups in LRTI symptom diary outcomes (<xref rid="fig2" ref-type="fig">Figs. 2</xref> and <xref rid="fig3" ref-type="fig">3</xref>). Patient satisfaction with the index consultation was high as 91% of responding patients in both groups reported being satisfied or very satisfied (137/149 (usual care) and 145/159 (FLUS)). No unintended events within 60 days were reported.<fig id="fig2"><label>Fig. 2</label><caption><p>Lower respiratory tract infection symptom diary outcomes. Red shows the FLUS group. Blue shows the Usual care group. CI, Confidence Interval; FLUS, Focused lung ultrasound.</p></caption><graphic xlink:href="gr2"/></fig><fig id="fig3"><label>Fig. 3</label><caption><p>Daily total lower respiratory tract infection symptom score (0&#x02013;36). Red shows the FLUS group. Blue shows the Usual care group. CI, Confidence Interval; FLUS, Focused lung ultrasound.</p></caption><graphic xlink:href="gr3"/></fig></p><p id="p0180">Significant pathological findings on FLUS were reported by GPs in 85 of the 192 (44%) patients randomised to the FLUS group. Among patients with pathological FLUS findings, 55 of 85 (65%) were prescribed antibiotics at the index consultation, compared with only 14 of 107 (13%) among those without pathological findings (unadjusted for confounders). The most common pathological findings in the 85 patients included focal &#x02265;3 B-lines in 61 patients (72%), subpleural consolidation(s) (2&#x02013;20 mm) in 17 (20%), pleural effusion in 11 (13%), larger consolidations in 9 (11%), interstitial syndrome in 5 (6%) and isolated visceral pleural pathology in 4 (5%).</p><p id="p0185">Characteristics of the 34 GPs who enrolled study participants are shown in <xref rid="tbl3" ref-type="table">Table 3</xref>. Fourteen GPs had no or less than one year of experience using FLUS when recruited. Twenty-nine of the GPs completed the FLUS training programme offered before patient enrolment. Results from the FLUS training programme and comparisons between participating GPs and the national population of Danish GPs are presented in the <xref rid="appsec1" ref-type="sec">supplementary material</xref>.<table-wrap position="float" id="tbl3"><label>Table 3</label><caption><p>Characteristics of general practitioners enrolling patients in the trial.</p></caption><table frame="hsides" rules="groups"><thead><tr><th/><th colspan="2">General practitioners (N = 34)</th></tr></thead><tbody><tr><td><italic>Age,</italic> years</td><td>48&#x000b7;4</td><td align="char">(5&#x000b7;9)</td></tr><tr><td><italic>Sex</italic></td><td/><td/></tr><tr><td>&#x000a0;Male</td><td>26</td><td align="char">(76%)</td></tr><tr><td>&#x000a0;Female</td><td>8</td><td align="char">(24%)</td></tr><tr><td><italic>Experience as a GP</italic></td><td/><td/></tr><tr><td>&#x000a0;&#x0003c; 5 years</td><td>5</td><td align="char">(15%)</td></tr><tr><td>&#x000a0;5&#x02013;15 years</td><td>19</td><td align="char">(56%)</td></tr><tr><td>&#x000a0;&#x0003e;15 years</td><td>10</td><td align="char">(29%)</td></tr><tr><td><italic>Experience using POCUS</italic></td><td/><td/></tr><tr><td>&#x000a0;&#x0003c; 2 years</td><td>6</td><td align="char">(18%)</td></tr><tr><td>&#x000a0;2&#x02013;5 years</td><td>19</td><td align="char">(56%)</td></tr><tr><td>&#x000a0;&#x0003e;5 years</td><td>9</td><td align="char">(26%)</td></tr><tr><td><italic>Experience using FLUS</italic></td><td/><td/></tr><tr><td>&#x000a0;0 years</td><td>14</td><td align="char">(41%)</td></tr><tr><td>&#x000a0;1&#x02013;3 years</td><td>8</td><td align="char">(24%)</td></tr><tr><td>&#x000a0;&#x0003e;3 years</td><td>12</td><td align="char">(35%)</td></tr><tr><td><italic>Location in Denmark</italic><xref rid="tbl3fna" ref-type="table-fn">a</xref></td><td/><td/></tr><tr><td>&#x000a0;North Denmark Region</td><td>4</td><td align="char">(12%)</td></tr><tr><td>&#x000a0;Central Denmark Region</td><td>4</td><td align="char">(12%)</td></tr><tr><td>&#x000a0;Southern Denmark Region</td><td>22</td><td align="char">(64%)</td></tr><tr><td>&#x000a0;Region Zealand</td><td>1</td><td align="char">(3%)</td></tr><tr><td>&#x000a0;Capital Region</td><td>3</td><td align="char">(9%)</td></tr><tr><td><italic>Type of general practice clinic</italic></td><td/><td/></tr><tr><td>&#x000a0;Partnership Practice</td><td>27</td><td align="char">(79%)</td></tr><tr><td>&#x000a0;Solo Practice</td><td>7</td><td align="char">(21%)</td></tr><tr><td><italic>Baseline mean AB prescriptions</italic><xref rid="tbl3fnb" ref-type="table-fn">b</xref></td><td>249</td><td align="char">(83)</td></tr></tbody></table><table-wrap-foot><fn id="tspara0045"><p>Values presented as n (%) or mean (SD).</p></fn><fn id="tspara0050"><p>GP, General Practitioner; POCUS:,Point of care ultrasound; FLUS, Focused lung ultrasound; AB, Antibiotics; SD, Standard deviation.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl3fna"><label>a</label><p id="ntpara0075">The Capital Region is an urban area. The other regions are mixed rural and urban areas.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tbl3fnb"><label>b</label><p id="ntpara0080">Mean (SD) number of antibiotic prescriptions per 1000 patients listed in participating general practice clinics per year (one year before trial commencement, Nov 1, 2022&#x02013;Oct 30, 2023.).</p></fn></table-wrap-foot></table-wrap></p></sec><sec id="sec4"><title>Discussion</title><p id="p0190">Adding FLUS to usual care did not lead to the expected 15% reduction in antibiotic prescriptions at the index consultation. However, reconsultations related to the current LRTI episode in general practice or out-of-hours primary care were significantly reduced in the FLUS group. FLUS was not associated with any adverse effects on patient safety, symptom duration or severity or patients&#x02019; satisfaction with the consultation. However, the wide CIs observed for some secondary outcomes introduce uncertainty about the true RRs.</p><p id="p0195">The reduction in antibiotic prescribing found in our study with the addition of FLUS to usual care was smaller than hypothesised and modest compared with other POC testing interventions evaluated for similar purposes in general practice settings.<xref rid="bib8" ref-type="bibr"><sup>8</sup></xref><sup>,</sup><xref rid="bib22" ref-type="bibr"><sup>22</sup></xref><sup>,</sup><xref rid="bib33" ref-type="bibr"><sup>33</sup></xref> Our study was powered to detect a 15% absolute reduction; therefore, it was underpowered to identify the 5% absolute reduction at the index consultation. Considering antibiotics prescribed during follow-up, the accumulated absolute reduction within the first week was 8% in the FLUS group, but this difference was also not statistically significant. At the index consultation, the antibiotic prescribing rate in the usual care group was 41%, which was lower than anticipated. This expectation had been based, among other sources, on a 2007 Danish study that reported a 56% prescribing rate in a comparable patient population.<xref rid="bib7" ref-type="bibr"><sup>7</sup></xref> However, our findings did not indicate a stronger effect of FLUS on antibiotic prescribing within subgroups where prescribing rates were naturally higher (see the <xref rid="appsec1" ref-type="sec">supplementary material</xref>).</p><p id="p0200">The effect of adding FLUS into routine diagnostic procedures on antibiotic prescribing has previously been evaluated in a prospective observational study with 148 patients in French emergency departments.<xref rid="bib34" ref-type="bibr"><sup>34</sup></xref> Use of a 12-zone FLUS protocol led to changes in antibiotic management in 47 of 148 patients (32%), with 21 treatments initiated and 26 discontinued.<xref rid="bib3" ref-type="bibr"><sup>3</sup></xref> Consistent with our study, this study showed no significant overall reduction in antibiotic prescribing. However, it did suggest a shift in the subset of patients to whom antibiotics were prescribed. Whether a similar pattern occurred in our study remains unclear. Nevertheless, any potential redistribution of antibiotic prescribing associated with FLUS did not translate into a clinically meaningful difference in patient outcomes, as the clinical course was comparable between groups.</p><p id="p0205">As previously stated, this is the first randomised trial evaluating the effect of adding FLUS alone to usual care. To date, only one previous randomised trial has assessed the combined effect of the addition of sequential procalcitonin POC testing and FLUS to usual care on antibiotic prescribing in Swiss general practices.<xref rid="bib22" ref-type="bibr"><sup>22</sup></xref> In that three-armed trial did the addition of FLUS at a predefined procalcitonin cut-off in a small patient sample not significantly reduce antibiotic prescribing compared with procalcitonin POC testing alone added to usual care. Usual care in the Swiss study did not include CRP testing, whereas nearly all patients (99%) in our study received a CRP POC test as part of usual care. Consequently, our study did not assess the impact of FLUS in isolation, but rather its effect when added to a standard care protocol that included CRP testing. While incorporating a study arm evaluating FLUS in the absence of CRP testing might have been informative and broadened the generalizability of our findings, such an approach would not have pragmatically reflected standard care in Danish general practice.</p><p id="p0210">A key strength of this study is its pragmatic design, which closely mirrors routine clinical practice and the patient population typically encountered by GPs. This strengthens the study's external validity. The study was designed to minimize recall bias in the registrations by both GPs and patients. Furthermore, there was no indication of information bias in the GPs' registrations of antibiotic prescribing at the index consultation, as these data were cross-validated with entries in the Shared Medication Records by the PI for quality assurance. Comprehensive follow-up of the clinical course was achieved, with minimal loss to follow-up and a high response rate for the symptom diary. These features contributed to robust evidence regarding the impact of adding FLUS to usual care for the patient population studied.</p><p id="p0215">However, several limitations should be acknowledged. First, participating GPs were self-selected and represented a subgroup (12%) of Danish GPs using POC ultrasound,<xref rid="bib35" ref-type="bibr"><sup>35</sup></xref> potentially limiting generalisability. Therefore, our results may not fully reflect average prescribing practices among Danish GPs. Baseline prescribing rates reported in <xref rid="tbl3" ref-type="table">Table 3</xref> reflect practice-level data rather than individual prescribing habits, which were not available. The low baseline antibiotic prescribing and also the high uptake of CRP POC testing may potentially limit international applicability. Furthermore, participation in this trial may itself alter clinical and prescribing behaviour (Hawthorne effect), especially when GPs are unblinded to both study outcomes and allocation.<xref rid="bib36" ref-type="bibr"><sup>36</sup></xref> Another limitation is the absence of data on symptom duration before the index consultation. Symptom duration could have affected both clinical assessment and FLUS findings, as well as the GP's subsequent management decision.</p><p id="p0220">This study reflects the impact of adding FLUS to usual care when GPs are guided by principles of clinical integration rather than a fixed diagnostic algorithm. Such an algorithm has, however, been proposed by Rodriguez-Contreras and colleagues.<xref rid="bib20" ref-type="bibr"><sup>20</sup></xref> However, their algorithm would require a chest x-ray in all cases of focal or asymmetrical B-lines pattern without consolidations. Based on previous research, we anticipated that such patterns would predominate in most patients with pathological findings.<xref rid="bib19" ref-type="bibr"><sup>19</sup></xref><sup>,</sup><xref rid="bib20" ref-type="bibr"><sup>20</sup></xref> Introducing this algorithm could lead to an increased use of chest x-ray, with associated increases in costs and patient radiation exposure in a Danish clinical context.<xref rid="bib11" ref-type="bibr"><sup>11</sup></xref> Consequently, we chose a pragmatic design in which the FLUS training programme and the brush-up session incorporated the best available knowledge on pathological findings and clinical interpretation.<xref rid="bib19" ref-type="bibr"><sup>19</sup></xref> The results of our study probably reflect persistent uncertainties regarding the relationship between pathological FLUS findings, pathogen likelihood and disease severity progression in general practice. Whether a more conservative definition of pneumonia on FLUS (requiring consolidation) can be used in general practice, without compromising patient safety and clinical course, is unknown. As these relationships become clearer, the clinical utility of FLUS may improve. Notably, only 14 of the 107 patients in the FLUS group with no pathological FLUS findings were prescribed antibiotics. The underlying mechanism remains unclear. Possible explanations include that pathological FLUS findings aligned with pronounced symptoms supporting antibiotic use, or that a normal FLUS had a strong deterrent effect on prescribing decisions. These hypotheses fall outside the scope of this study but warrant further exploration.</p><p id="p0225">Patients in the FLUS group had a lower likelihood of reconsulting general practice or out-of-hours primary care for the same LRTI episode within 28 days than patients receiving usual care. Any contact initiated by either the GP or the patient that related in any way to the current LRTI episode was classified as a reconsultation. Despite the uncertainties described above, this finding suggests a possible reassurance mechanism affecting both the GP and the patient regarding the initial diagnosis. Previous research supports this interpretation<xref rid="bib19" ref-type="bibr"><sup>19</sup></xref><sup>,</sup><xref rid="bib37" ref-type="bibr"><sup>37</sup></xref> as GPs reported increased diagnostic confidence in 69 of 91 cases (76%) after performing FLUS in a similar patient population.<xref rid="bib19" ref-type="bibr"><sup>19</sup></xref></p><p id="p0230">Future research should investigate if a more modest effect on antibiotic prescribing can be detected or if there is a larger potential of adding FLUS to usual care in settings with higher antibiotic prescribing rates. Human antibiotic consumption in Denmark is relatively low compared with that in other European countries,<xref rid="bib38" ref-type="bibr"><sup>38</sup></xref> and antibiotic prescribing rates in the usual care group were lower than anticipated. Moreover, longer-term studies are warranted to assess the safety of FLUS over time and to inform clinical referral guidelines for suspected pulmonary cancer based on FLUS findings in general practice. In our study, none of the patients referred with suspected cancer were diagnosed with cancer within the 60-day follow-up period; however, in a few cases, diagnostic clarification was still pending.</p><p id="p0235">FLUS is not recommended as a routine tool for all adults with suspected pneumonia based on this trial's findings. However, the study found no evidence of patient harm associated with the addition of FLUS to usual care. Future studies should carefully evaluate whether FLUS may contribute to missed diagnoses of pulmonary cancer; however, our study indicates no safety concerns related to its use in this patient population.</p></sec><sec id="sec6"><title>Contributors</title><p id="p0245">The study was conceptualised by JJS, MPH, CAA, MBJ, and JLT, with substantial scientific contributions from CBL, SHS and HHS. All authors agreed on the study design and practical considerations. Data collection, statistical analyses, and drafting of the initial manuscript were carried out by JJS. All authors contributed to and approved the final manuscript. Furthermore, all authors had full access to all study data and shared final responsibility for the decision to submit the manuscript for publication.</p></sec><sec id="sec7"><title>Data sharing statement</title><p id="p0250">Deidentified individual participant data underlying the results reported in this article, including study registrations and informed consent forms, are available upon reasonable request. Upon approval of a data sharing request by the regional legal body, information necessary to address the proposed research question will be shared under the terms of a signed data sharing agreement. Requests should be directed to <email>jrjepsen@dcm.aau.dk</email>. The study protocol<xref rid="bib24" ref-type="bibr"><sup>24</sup></xref> is publicly available and the statistical analysis plan is accessible at <ext-link ext-link-type="uri" xlink:href="http://clinicaltrials.gov" id="intref0030">clinicaltrials.gov</ext-link> (<ext-link ext-link-type="uri" xlink:href="https://clinicaltrials.gov/study/NCT06210282?term=NCT06210282&#x00026;rank=1" id="intref0035">NCT06210282</ext-link>).</p></sec><sec sec-type="COI-statement" id="coi0010"><title>Declaration of interests</title><p id="p0255">CBL coauthored the e-learning material used for the FLUS training programme, <italic>Basal Klinisk Ultralydsdiagnostik</italic> [Basic Clinical Ultrasound Diagnostics], published by Munksgaard (see the <xref rid="appsec1" ref-type="sec">supplementary material</xref>) and receives royalties for the use of this material. CBL, HHLS and SHS received honoraria for lectures and education activities by Boehringer Ingelheim. CBL also received honoraria for education activities from AstraZeneca, GSK, Chiesi Pharma AB, and HHLS from Takeda. Congress travel was sponsored by Boehringer Ingelheim for HHLS. SHS is Head of the European Respiratory Society Group 14.3, Ultrasound. All other authors declare no competing interests.</p></sec></body><back><ref-list id="cebib0010"><title>References</title><ref id="bib1"><label>1</label><element-citation publication-type="journal" id="sref1"><person-group person-group-type="author"><name><surname>Bell</surname><given-names>B.G.</given-names></name><name><surname>Schellevis</surname><given-names>F.</given-names></name><name><surname>Stobberingh</surname><given-names>E.</given-names></name><etal/></person-group><article-title>A systematic review and meta-analysis of the effects of antibiotic consumption on antibiotic resistance</article-title><source>BMC Infect Dis</source><volume>14</volume><year>2014</year><fpage>13</fpage><pub-id pub-id-type="doi">10.1186/1471-2334-14-13</pub-id><pub-id pub-id-type="pmid">24405683</pub-id>

</element-citation></ref><ref id="bib8"><label>8</label><element-citation publication-type="journal" id="sref8"><person-group person-group-type="author"><name><surname>Smedemark</surname><given-names>S.A.</given-names></name><name><surname>Aabenhus</surname><given-names>R.</given-names></name><name><surname>Llor</surname><given-names>C.</given-names></name><etal/></person-group><article-title>Biomarkers as point-of-care tests to guide prescription of antibiotics in people with acute respiratory infections in primary care</article-title><source>Cochrane Database Syst Rev</source><volume>10</volume><issue>10</issue><year>2022</year><object-id pub-id-type="publisher-id">CD010130</object-id><pub-id pub-id-type="doi">10.1002/14651858.CD010130.pub3</pub-id></element-citation></ref><ref id="bib9"><label>9</label><element-citation publication-type="other" id="sref9"><person-group person-group-type="author"><collab>The Danish College of General Practitioners (DSAM)</collab></person-group><article-title>Luftvejsinfektioner - Diagnose og behandling. Klinisk Vejledning for Almen Praksis. [Respiratory Tracts Infections - Diagnosis and Treatment. Guideline for General Practice]</article-title><ext-link ext-link-type="uri" xlink:href="https://content.dsam.dk/guides/vejlednings-pdf/luftvejsinfektioner-samlet-udgave-3-opdateret.pdf" id="intref0050">https://content.dsam.dk/guides/vejlednings-pdf/luftvejsinfektioner-samlet-udgave-3-opdateret.pdf</ext-link><year>2014</year></element-citation></ref><ref id="bib10"><label>10</label><element-citation publication-type="journal" id="sref10"><person-group person-group-type="author"><name><surname>Lykkegaard</surname><given-names>J.</given-names></name><name><surname>Olsen</surname><given-names>J.K.</given-names></name><name><surname>Sydenham</surname><given-names>R.V.</given-names></name><etal/></person-group><article-title>C-reactive protein cut-offs used for acute respiratory infections in Danish general practice</article-title><source>BJG
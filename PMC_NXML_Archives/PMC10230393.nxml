pound-subject></subj-group></article-categories><title-group><article-title>Radiofrequency ablation of lung metastases of colorectal cancer: could early radiomics analysis of the ablation zone help detect local tumor progression?</article-title><alt-title alt-title-type="right-running-head">Radiomics to detect early post-lung RFA relapse in CRC patients?</alt-title><alt-title alt-title-type="left-running-head">Cromb&#x000e9; <italic>et al</italic>
</alt-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-0098-6482</contrib-id><name><surname>Cromb&#x000e9;</surname><given-names>Amandine</given-names></name><degrees>MD</degrees><degrees>PhD</degrees><xref rid="aff1 aff2 aff3" ref-type="aff">1,2,3</xref><email xlink:href="mailto:crombeamandine2@gmail.com">crombeamandine2@gmail.com</email></contrib><contrib contrib-type="author"><name><surname>Palussi&#x000e8;re</surname><given-names>Jean</given-names></name><degrees>MD</degrees><xref rid="aff1 aff2" ref-type="aff">1,2</xref><email xlink:href="mailto:j.palussiere@bordeaux.unicancer.fr">j.palussiere@bordeaux.unicancer.fr</email></contrib><contrib contrib-type="author"><name><surname>Catena</surname><given-names>Vittorio</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">1</xref><email xlink:href="mailto:v.catena@bordeaux.unicancer.fr">v.catena@bordeaux.unicancer.fr</email></contrib><contrib contrib-type="author"><name><surname>Cazayus</surname><given-names>Maxime</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">1</xref><email xlink:href="mailto:m.cazayus@bordeaux.unicancer.fr">m.cazayus@bordeaux.unicancer.fr</email></contrib><contrib contrib-type="author"><name><surname>Fonck</surname><given-names>Marianne</given-names></name><degrees>MD</degrees><xref rid="aff4" ref-type="aff">4</xref><email xlink:href="mailto:m.fonck@bordeaux.unicancer.fr">m.fonck@bordeaux.unicancer.fr</email></contrib><contrib contrib-type="author"><name><surname>B&#x000e9;chade</surname><given-names>Dominique</given-names></name><degrees>MD</degrees><xref rid="aff4" ref-type="aff">4</xref><email xlink:href="mailto:d.bechade@bordeaux.unicancer.fr">d.bechade@bordeaux.unicancer.fr</email></contrib><contrib contrib-type="author"><name><surname>Buy</surname><given-names>Xavier</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">1</xref><email xlink:href="mailto:x.buy@bordeaux.unicancer.fr">x.buy@bordeaux.unicancer.fr</email></contrib><contrib contrib-type="author"><name><surname>Markich</surname><given-names>Romane</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">1</xref><email xlink:href="mailto:romane.markich@gmail.com">romane.markich@gmail.com</email></contrib><aff id="aff1">

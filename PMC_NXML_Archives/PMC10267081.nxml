				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\pm \hspace{0.17em}$$\end{document}</tex-math><mml:math id="M20"><mml:mrow><mml:mo>&#x000b1;</mml:mo><mml:mspace width="1.69998pt"/></mml:mrow></mml:math><inline-graphic xlink:href="41181_2023_198_Article_IEq42.gif"/></alternatives></inline-formula>0.3</td></tr><tr><td align="left">LDL (mmol/L)</td><td char="." align="char">2.6&#x02009;<inline-formula id="IEq43"><alternatives><tex-math id="M21">\documentclass[12pt]{minimal}
				\usepackage{amsmath}

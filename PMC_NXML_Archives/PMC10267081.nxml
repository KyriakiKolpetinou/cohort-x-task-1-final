				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\pm \hspace{0.17em}$$\end{document}</tex-math><mml:math id="M16"><mml:mrow><mml:mo>&#x000b1;</mml:mo><mml:mspace width="1.69998pt"/></mml:mrow></mml:math><inline-graphic xlink:href="41181_2023_198_Article_IEq40.gif"/></alternatives></inline-formula>6.7</td></tr><tr><td align="left">Cholesterol (mmol/L)</td><td char="." align="char">4.8&#x02009;<inline-formula id="IEq41"><alternatives><tex-math id="M17">\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\pm \hspace{0.17em}$$\end{document}</tex-math><mml:math id="M18"><mml:mrow><mml:mo>&#x000b1;</mml:mo><mml:mspace width="1.69998pt"/></mml:mrow></mml:math><inline-graphic xlink:href="41181_2023_198_Article_IEq41.gif"/></alternatives></inline-formula>0.3</td></tr><tr><td align="left">HDL (mmol/L)</td><td char="." align="char">1.5&#x02009;<inline-formula id="IEq42"><alternatives><tex-math id="M19">\documentclass[12pt]{minimal}
				\usepackage{amsmath}

<article-meta><article-id pub-id-type="pmid">41209209</article-id><article-id pub-id-type="pmc">12591743</article-id><article-id pub-id-type="publisher-id">qims-15-11-10433</article-id><article-id pub-id-type="doi">10.21037/qims-2025-649</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Article</subject></subj-group></article-categories><title-group><article-title>Reducing acquisition time in O-(2-<sup>18</sup>F-fluoroethyl)-L-tyrosine positron emission tomography (<sup>18</sup>F-FET PET) for malignant brain tumors: temporal stability of ordered subset expectation maximization (OSEM) and HYPER iterative algorithms and selection of reproducible radiomic features</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Su</surname><given-names>Ya</given-names></name><xref rid="aff1" ref-type="aff">

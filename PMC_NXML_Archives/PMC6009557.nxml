<article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="protocol"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">BMJ Open</journal-id><journal-id journal-id-type="iso-abbrev">BMJ Open</journal-id><journal-id journal-id-type="hwp">bmjopen</journal-id><journal-id journal-id-type="publisher-id">bmjopen</journal-id><journal-title-group><journal-title>BMJ Open</journal-title></journal-title-group><issn pub-type="epub">2044-6055</issn><publisher><publisher-name>BMJ Publishing Group</publisher-name><publisher-loc>BMA House, Tavistock Square, London, WC1H 9JR</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">29886446</article-id><article-id pub-id-type="pmc">6009557</article-id><article-id pub-id-type="publisher-id">bmjopen-2017-021373</article-id><article-id pub-id-type="doi">10.1136/bmjopen-2017-021373</article-id><article-categories><subj-group subj-group-type="heading"><subject>Radiology and Imaging</subject><subj-group><subject>Protocol</subject></subj-group></subj-group><subj-group subj-group-type="hwp-journal-coll"><subject>1506</subject><subject>1726</subject></subj-group></article-categories><title-group><article-title>Ultrasound-guided tendon fenestration versus open-release surgery for the treatment of chronic lateral epicondylosis of the elbow: protocol for a prospective, randomised, single blinded study</article-title></title-group><contrib-group><contrib id="author-59806520" contrib-type="author"><name><surname>Lungu</surname><given-names>Eugen</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib id="author-59806556" contrib-type="author"><name><surname>Grondin</surname><given-names>Philippe</given-names></name><xref ref-type="aff" rid="aff3">3</xref><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib id="author-59806576" contrib-type="author"><name><surname>T&#x000e9;treault</surname><given-names>Patrice</given-names></name><xref ref-type="aff" rid="aff3">3</xref><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib id="author-44063065" contrib-type="author"><name><surname>Desmeules</surname><given-names>Fran&#x000e7;ois</given-names></name><xref ref-type="aff" rid="aff5">5</xref><xref ref-type="aff" rid="aff6">6</xref></contrib><contrib id="author-35963954" contrib-type="author"><name><surname>Cloutier</surname><given-names>Guy</given-names></name><xref ref-type="aff" rid="aff2">2</xref><xref ref-type="aff" rid="aff7">7</xref></contrib><contrib id="author-43412919" contrib-type="author"><name><surname>Choini&#x000e8;re</surname><given-names>Manon</given-names></name><xref ref-type="aff" rid="aff7">7</xref><xref ref-type="aff" rid="aff8">8</xref></contrib><contrib id="author-43413371" contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0003-3710-9280</contrib-id><name><surname>Bureau</surname><given-names>Nathalie J</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref><xref ref-type="aff" rid="aff7">7</xref></contrib></contrib-group><aff id="aff1">

label>7.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Wang</surname><given-names>W</given-names></name><name><surname>Xu</surname><given-names>Y</given-names></name><name><surname>Gao</surname><given-names>R</given-names></name><name><surname>Lu</surname><given-names>R</given-names></name><name><surname>Han</surname><given-names>K</given-names></name><name><surname>Wu</surname><given-names>G</given-names></name><etal/></person-group><article-title>Detection of SARS-CoV-2 in different types of clinical specimens</article-title><source>JAMA</source><year>2020</year><volume>323</volume><fpage>1843</fpage><lpage>1844l</lpage><pub-id pub-id-type="pmid">32159775</pub-id></element-citation></ref><ref id="CR8"><label>8.</label><mixed-citation publication-type="other">The 2007 Recommendations of the International Commission on Radiological Protection. ICRP publication 103. Ann ICRP 2007, 37:1&#x02013;332l.</mixed-citation></ref><ref id="CR9"><label>9.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Simpson</surname><given-names>S</given-names></name><name><surname>Kay</surname><given-names>FU</given-names></name><name><surname>Abbara</surname><given-names>S</given-names></name><name><surname>Bhalla</surname><given-names>S</given-names></name><name><surname>Chung</surname><given-names>JH</given-names></name><name><surname>Chung</surname><given-names>M</given-names></name><etal/></person-group><article-title>Radiological Society of North America Expert Consensus Statement on Reporting Chest CT Findings Related to COVID-19. Endorsed by the Society of Thoracic Radiology, the American College of Radiology, and RSNA&#x02014;Secondary Publication</article-title><source>J Thorac Imaging</source><year>2020</year><volume>35</volume><fpage>219</fpage><lpage>227l</lpage><pub-id pub-id-type="doi">10.1097/RTI.0000000000000524</pub-id><pub-id pub-id-type="pmid">32324653</pub-id></element-citation></ref><ref id="CR10"><label>10.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Buderer</surname><given-names>NM</given-names></name></person-group><article-title>Statistical methodology: I. Incorporating the prevalence of disease into the sample size calculation for sensitivity and specificity</article-title><source>Acad Emerg Med.</source><year>1996</year><volume>3</volume><fpage>895</fpage><lpage>900l</lpage><pub-id pub-id-type="doi">10.1111/j.1553-2712.1996.tb03538.x</pub-id><pub-id pub-id-type="pmid">8870764</pub-id></element-citation></ref><ref id="CR11"><label>11.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Fagan</surname><given-names>TJ</given-names></name></person-group><article-title>Letter: Nomogram for Bayes theorem</article-title><source>N Engl J Med</source><year>1975</year><volume>293</volume><fpage>257l</fpage><pub-id pub-id-type="pmid">1143310</pub-id></element-citation></ref><ref id="CR12"><label>12.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>H</given-names></name><name><surname>Hong</surname><given-names>H</given-names></name><name><surname>Yoon</surname><given-names>SH</given-names></name></person-group><article-title>Diagnostic performance of CT and reverse transcriptase polymerase chain reaction for coronavirus disease 2019: a meta-analysis</article-title><source>Radiology</source><year>2020</year><volume>296</volume><fpage>E145</fpage><lpage>E155l</lpage><pub-id pub-id-type="doi">10.1148/radiol.2020201343</pub-id><pub-id pub-id-type="pmid">32301646</pub-id></element-citation></ref><ref id="CR13"><label>13.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shi</surname><given-names>H</given-names></name><name><surname>Han</surname><given-names>X</g
</td><td align="center" valign="top" rowspan="1" colspan="1">47</td><td align="center" valign="top" rowspan="1" colspan="1">47</td><td align="center" valign="top" rowspan="1" colspan="1">47</td><td align="center" valign="top" rowspan="1" colspan="1">47</td><td align="center" valign="top" rowspan="1" colspan="1">27</td><td align="center" valign="top" rowspan="1" colspan="1">27</td><td align="center" valign="top" rowspan="1" colspan="1">27</td><td align="center" valign="top" rowspan="1" colspan="1">27</td></tr><tr><td align="left" colspan="9" valign="top" rowspan="1">Total alteration number in ctDNA</td></tr><tr><td align="left" style="padding-left:10%" valign="top" rowspan="1" colspan="1">Correlation coefficient</td><td align="center" valign="top" rowspan="1" colspan="1">0.249</td><td align="center" valign="top" rowspan="1" colspan="1">0.038</td><td align="center" valign="top" rowspan="1" colspan="1">0.563<xref rid="cam471049-note-0004" ref-type="table-fn">**</xref>

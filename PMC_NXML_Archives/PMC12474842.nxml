<article-id pub-id-type="publisher-id">1318</article-id><article-id pub-id-type="doi">10.1186/s13550-025-01318-3</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Research</subject></subj-group></article-categories><title-group><article-title>[<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5, a new proteoglycan tracer for functional imaging of joint cartilage: phase I (CARSPECT)</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-2841-6994</contrib-id><name><surname>Chanchou</surname><given-names>Marion</given-names></name><address><email>marion.chanchou@clermont.unicancer.fr</email></address><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Thivat</surname><given-names>Emilie</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff3">3</xref><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Mathieu</surname><given-names>Sylvain</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Levesque</surname><given-names>Sophie</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Sas</surname><given-names>Nicolas</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff7">7</xref></contrib><contrib contrib-type="author"><name><surname>Auzeloux</surname><given-names>Philippe</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Billoux</surname><given-names>Tommy</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff7">7</xref></contrib><contrib contrib-type="author"><name><surname>Molnar</surname><given-names>Ioana</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff3">3</xref><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Jouberton</surname><given-names>Elodie</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Rouanet</surname><given-names>Jacques</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff8">8</xref></contrib><contrib contrib-type="author"><name><surname>Fois</surname><given-names>Giovanna</given-names></name><xref ref-type="aff" rid="Aff9">9</xref></contrib><contrib contrib-type="author"><name><surname>Maigne</surname><given-names>Lydia</given-names></name><xref ref-type="aff" rid="Aff9">9</xref></contrib><contrib contrib-type="author"><name><surname>Penault-llorca</surname><given-names>Fr&#x000e9;d&#x000e9;rique</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff10">10</xref></contrib><contrib contrib-type="author"><name><surname>Miot-noirault</surname><given-names>Elisabeth</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Durando</surname><given-names>Xavier</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff3">3</xref><xref ref-type="aff" rid="Aff4">4</xref><xref ref-type="aff" rid="Aff11">11</xref></contrib><contrib contrib-type="author"><name><surname>Cachin</surname><given-names>Florent</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01a8ajp46</institution-id><institution-id institution-id-type="GRID">grid.494717.8</institution-id><institution-id institution-id-type="ISNI">0000 0001 2173 2882</institution-id><institution>INSERM U1240 IMoST, Universit&#x000e9; Clermont Auvergne, </institution></institution-wrap>Clermont-Ferrand, F-63000 France </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/02pwnhd33</institution-id><institution-id institution-id-type="GRID">grid.418113.e</institution-id><institution-id institution-id-type="ISNI">0000 0004 1795 1689</institution-id><institution>Service de M&#x000e9;decine Nucl&#x000e9;aire, </institution><institution>Centre Jean PERRIN, </institution></institution-wrap>58 rue Montalembert, Clermont-Ferrand, F-63000 France </aff><aff id="Aff3"><label>3</label>Centre d&#x02019;Investigation Clinique UMR501, Clermont-Ferrand, F-63000 France </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/02pwnhd33</institution-id><institution-id institution-id-type="GRID">grid.418113.e</institution-id><institution-id institution-id-type="ISNI">0000 0004 1795 1689</institution-id><institution>D&#x000e9;partement de Recherche Clinique, </institution><institution>Centre Jean PERRIN, </institution></institution-wrap>Clermont-Ferrand, F-63000 France </aff><aff id="Aff5"><label>5</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01a8ajp46</institution-id><institution-id institution-id-type="GRID">grid.494717.8</institution-id><institution-id institution-id-type="ISNI">0000 0001 2173 2882</institution-id><institution>Service de Rhumatologie, </institution><institution>Universit&#x000e9; Clermont-Auvergne, CHU Gabriel Montpied, </institution></institution-wrap>Clermont-Ferrand, 63000 France </aff><aff id="Aff6"><label>6</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/02pwnhd33</institution-id><institution-id institution-id-type="GRID">grid.418113.e</institution-id><institution-id institution-id-type="ISNI">0000 0004 1795 1689</institution-id><institution>Unit&#x000e9; de radiopharmacie, </institution><institution>Centre Jean PERRIN, </institution></institution-wrap>Clermont-Ferrand, F-63000 France </aff><aff id="Aff7"><label>7</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/02pwnhd33</institution-id><institution-id institution-id-type="GRID">grid.418113.e</institution-id><institution-id institution-id-type="ISNI">0000 0004 1795 1689</institution-id><institution>Service de Physique M&#x000e9;dicale, </institution><institution>Centre Jean PERRIN, </institution></institution-wrap>Clermont-Ferrand, F-63000 France </aff><aff id="Aff8"><label>8</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/02tcf7a68</institution-id><institution-id institution-id-type="GRID">grid.411163.0</institution-id><institution-id institution-id-type="ISNI">0000 0004 0639 4151</institution-id><institution>Service de Dermatologie et d&#x02019;Oncologie Cutan&#x000e9;e, </institution><institution>CHU Clermont-Ferrand, </institution></institution-wrap>Clermont-Ferrand, F-63000 France </aff><aff id="Aff9"><label>9</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01a8ajp46</institution-id><institution-id institution-id-type="GRID">grid.494717.8</institution-id><institution-id institution-id-type="ISNI">0000 0001 2173 2882</institution-id><institution>Laboratoire de Physique de Clermont, </institution><institution>UMR6533, CNRS/IN2P3, Universit&#x000e9; Clermont Auvergne, </institution></institution-wrap>Clermont-Ferrand, France </aff><aff id="Aff10"><label>10</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/02pwnhd33</institution-id><institution-id institution-id-type="GRID">grid.418113.e</institution-id><institution-id institution-id-type="ISNI">0000 0004 1795 1689</institution-id><institution>D&#x000e9;partement de biopathologie, </institution><institution>Centre Jean PERRIN, </institution></institution-wrap>Clermont-Ferrand, F-63000 France </aff><aff id="Aff11"><label>11</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/02pwnhd33</institution-id><institution-id institution-id-type="GRID">grid.418113.e</institution-id><institution-id institution-id-type="ISNI">0000 0004 1795 1689</institution-id><institution>D&#x000e9;partement d&#x02019;oncologie m&#x000e9;dicale, </institution><institution>Centre Jean PERRIN, </institution></institution-wrap>Clermont-Ferrand, F-63000 France </aff></contrib-group><pub-date pub-type="epub"><day>26</day><month>9</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>26</day><month>9</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>15</volume><elocation-id>123</elocation-id><history><date date-type="received"><day>24</day><month>2</month><year>2025</year></date><date date-type="accepted"><day>29</day><month>8</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">[<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 showed affinity for joint cartilage proteoglycans on preclinical studies but has not been tested in humans. This phase I trial (CARPECT: NCT04481230) aims to define the optimal of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 injected activity to obtain the best visual contrast of cartilage, without toxicity. Quantitative analyses of cartilage, periarticular uptakes, biodistribution, pharmacokinetic and dosimetry of this new tracer were also studied.</p></sec><sec><title>Results</title><p id="Par2">Between November 2020 and June 2022, five patients with unilateral knee osteoarthritis or breast cancer treated with hormonal therapy inducing cartilage disease were injected with [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5, at increasing activity levels: 5, 10 and 15 MBq/kg. No major toxicity was reported, according to NCICTC 4.0 scale. With an activity of 15 MBq/Kg, the median rate of joint uptakes higher than diaphysis&#x02019; one on whole body planar scintigraphy was 80.6% (80.60&#x02013;85.45) at 2&#x000a0;h p.i. and increased with time. S/N ratio with muscular background measured on SPECT-CT was superior to 3 from 2h30 p.i for cartilage. Uptake evolution depending on time from 1h00 to 6h30 p.i. permitted to discriminate cartilage and pooled proteoglycan structures from background and cartilage from ligaments&#x02009;+&#x02009;tendons for all examination times (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001), and cartilage from bursa at 1&#x000a0;h p.i. (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.05). Pharmacokinetic, biodistribution and dosimetry were in line with preclinical studies.</p></sec><sec><title>Conclusions</title><p id="Par3">This study confirms the usability and accuracy of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 for cartilage human functional imaging 2&#x000a0;h after injection, at 15 MBq/kg.</p></sec><sec><title>Trial registration</title><p id="Par4">Clinicaltrials.gov: NCT04481230. <ext-link ext-link-type="uri" xlink:href="https://clinicaltrials.gov/ct2/show/NCT04481230">https://clinicaltrials.gov/ct2/show/NCT04481230</ext-link>. Registration date: November, 12th, 2020.</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1186/s13550-025-01318-3.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>[<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5</kwd><kwd>Cartilage</kwd><kwd>SPECT</kwd><kwd>Joint</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer-Verlag GmbH Germany, part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Background</title><p id="Par5">Articular cartilage is a complex environment, mainly composed of extracellular matrix, produced by chondrocytes. Joints biomechanical abilities and their adaptability to loading variations depend on cartilaginous extracellular matrix integrity, and particularly on their proteoglycans concentration, provider of hydrostatic pressure and bio-mechanical functions [<xref ref-type="bibr" rid="CR1">1</xref>].</p><p id="Par6">Diagnosis of cartilaginous extracellular matrix biochemical alterations could permit in vivo studies of articular functionality [<xref ref-type="bibr" rid="CR2">2</xref>], not evaluable by conventional imaging modalities such as CT(computed tomography)-scan and Magnetic Resonance Imaging (MRI) [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR4">4</xref>]. Moreover, these technics suffer from poor diagnostic performances in early stage osteoarthritis, a major issue in public health [<xref ref-type="bibr" rid="CR5">5</xref>&#x02013;<xref ref-type="bibr" rid="CR8">8</xref>]. Indeed, the Kellgren-Lawrence radiological classification, although reproducible and widely used in the diagnosis of osteoarthritis, fail to show any prognostic value and is not taken into account in the therapeutic management of osteoarthritis [<xref ref-type="bibr" rid="CR9">9</xref>]. Furthermore, oncologists and rheumatologists are facing another diagnostic challenge, in case of arthralgia occurring under aromatase inhibitors, used in therapeutic management of hormone receptors-positive (HR+) breast cancer. This condition, whose physiopathology remains poorly understood, concerns 20 to 50% of patients benefiting from aromatase inhibitor [<xref ref-type="bibr" rid="CR10">10</xref>, <xref ref-type="bibr" rid="CR11">11</xref>] and can lead to treatment discontinuation. Thus, innovative functional imaging approaches are needed to diagnose cartilage pathologies earlier as possible, in order to slow down their evolution towards osteoarthritis.</p><p id="Par7">For many years, INSERM unit UMR 1240 IMoST/UCA develops radiotracers targeting cartilage, as [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5, whose positively charged quaternary ammonium function has a strong affinity for negatively charged proteoglycans [<xref ref-type="bibr" rid="CR12">12</xref>]. Numerous preclinical studies showed the relevance of this radiotracer in molecular imaging of cartilaginous pathologies as osteoarthritis [<xref ref-type="bibr" rid="CR13">13</xref>, <xref ref-type="bibr" rid="CR14">14</xref>], inflammatory diseases [<xref ref-type="bibr" rid="CR15">15</xref>] and chondrosarcomaa [<xref ref-type="bibr" rid="CR16">16</xref>], and an ex vivo study demonstrated the [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 affinity for human knee cartilage [<xref ref-type="bibr" rid="CR17">17</xref>]. These findings led to the current phase I clinical trial: Assessment of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 Uptake on Cartilage, a New Proteoglycan Tracer (CARSPECT - EudraCT: 2020-000495-37) [<xref ref-type="bibr" rid="CR18">18</xref>].</p><p id="Par8">The main objective of this &#x0201c;first-in-human&#x0201d; trial was to determine the recommended dose (activity in MBq/kg) of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 to obtain the best joint fixation contrast on scintigraphy acquisitions, without toxicity. Secondary objectives assessed the pharmacology, biodistribution, toxicity and dosimetry of this radiotracer.</p><p id="Par9">Impact of activity and acquisition time on [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 uptake were visually studied and quantitatively measured on articular and periarticular zones.</p></sec><sec id="Sec2"><title>Materials and methods</title><p id="Par10">Full version of the Materials and Methods section is presented in the Additional File 1.</p><sec id="Sec3"><title>Study design</title><p id="Par11">This phase I study is a multicentric dose-escalation trial of a radiotracer, with three activity steps: 5, 10 and 15 MBq/kg. An escalation of one-step was conditioned by the absence of dose-limiting toxicity (DLT) and a lack of tracer accumulation on healthy joints on scintigraphies performed at a time&#x02009;&#x02264;&#x02009;2&#x000a0;h post-injection (p.i.) [<xref ref-type="bibr" rid="CR18">18</xref>]. Study took place in University Hospital and Jean Perrin Cancer Centre, Clermont-Ferrand, France. The study protocol was approved by the ethic committee and national competent authority, and register with <ext-link ext-link-type="uri" xlink:href="http://www.clinical.gov">www.clinical.gov</ext-link> (NCT04481230). All patients provided written informed consent prior enrolment.</p></sec><sec id="Sec4"><title>Patients and baseline assessment</title><p id="Par12">In order to explore physiological cartilage uptake, we included patients without advanced joint damage but whose pathologies or treatment could lead to it. They were classified into two categories. First group presented painful unilateral knee osteoarthritis, with a Kellgren-Lawrence score of 0/1, average WOMAC&#x02009;&#x02265;&#x02009;4 and MOCART 2.0 score&#x02009;&#x0003e;&#x02009;70. Second group was composed of patients under 60, with non-metastatic breast cancer, HR+, HER2 negative, eligible for adjuvant therapy with aromatase inhibitor.</p><p id="Par13">All patients were clinically assessed with at least 31 healthy joints by a rheumatologist. Within 15 days before administration of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5, patients had a clinical evaluation including vital signs, ECG, blood and urine tests.</p></sec><sec id="Sec5"><title>Radiotracer production and administration</title><p id="Par14">[<sup>99m</sup>Tc]Tc-NTP 15-5was synthesized by radioactive labelling of the chemical precursor NTP 15&#x02009;&#x02212;&#x02009;5, N-[(3-triethylammonio)propyl]&#x02212;1,4,7,10,13-pentaazacyclopentadecane, in presence of fresh eluted technetium-99m (sodium pertechnetate, Na<sup>99m</sup>TcO<sub>4</sub>, TEKCIS<sup>&#x000ae;</sup>) [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR19">19</xref>]. The synthesis of the pharmaceutical grade NTP 15&#x02009;&#x02212;&#x02009;5 precursor was manufactured in accordance to GMP (Eras Laboratoire). The kit was manufactured at the experimental radiopharmacy of the Jean Perrin Centre corresponding to a single-dose sterile kit.</p><p id="Par15">The experimental radiotracer was an injectable solution of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 with a molar activity greater than 9 GBq/&#x000b5;mol and a required radiochemical purity superior to 90%.</p><p id="Par16">A single injection of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 was administered intravenously at D0, according to the dose escalation scheme.</p></sec><sec id="Sec6"><title>Imaging acquisition and assessment</title><p id="Par17">Whole-body planar scintigraphy were performed 30&#x000a0;min, 2&#x000a0;h, 4&#x000a0;h and 6&#x000a0;h p.i., each one followed by a SPECT acquisition from knee to lumbar spine 30&#x000a0;min later. A single whole-body Computed Tomography per patient was carried out, for attenuation correction and articular localization of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 uptakes.</p><p id="Par18">Tracer accumulation on healthy joints was assessed on whole body imaging, with a semi-quantitative visual scale: 1&#x02009;=&#x02009;lower fixation than diaphyseal uptake; 2&#x02009;=&#x02009;fixation equal to diaphyseal uptake; 3&#x02009;=&#x02009;upper fixation than diaphyseal uptake. Visual analysis was performed by two nuclear physicians with reconciliation of the results.</p><p id="Par19">SPECT volumetric Regions of Interest (ROI) were performed by two nuclear physicians, using a 40% max threshold semi-automatic tool. ROI were centered on four cartilaginous zones, eight periarticular structures (bursa, ligaments and tendons), three muscles and three bones. Cartilage and periarticular [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 uptakes were normalized to bone or muscle, analyzed separately then pooled under the name &#x0201c;proteoglycans&#x0201d;.</p></sec><sec id="Sec7"><title>Safety</title><p id="Par20">Vital signs were followed up before injection of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 and 5&#x000a0;min, 10&#x000a0;min, 15&#x000a0;min, 30&#x000a0;min, 1&#x000a0;h, 2&#x000a0;h, 4&#x000a0;h and 6&#x000a0;h after end of infusion. Tolerance assessments included clinical examination, electrocardiogram (ECG), blood and urine collection tests, performed at D0 and D8 p.i [<xref ref-type="bibr" rid="CR18">18</xref>]. Tolerance of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 was evaluated according to the NCI-CTCAE (version 4.03).</p></sec><sec id="Sec8"><title>Biodistribution</title><p id="Par21">Blood samples for pharmacokinetic study were collected at 5&#x000a0;min, 10&#x000a0;min, 15&#x000a0;min, 30&#x000a0;min, 1&#x000a0;h, 2&#x000a0;h, 4&#x000a0;h and 6&#x02013;8&#x000a0;h p.i. A 8-hour urine collection was realized for excretion evaluation. Evolution of tracer activity was measured on whole blood and plasma during the first 8&#x000a0;h.</p></sec><sec id="Sec9"><title>Dosimetry</title><p id="Par22">The dosimetric study was performed according to the scheme defined by the Committee on MIRD formalism in terms of mean absorbed dose by organ.</p><p id="Par23">First, activity versus time curves were obtained using planar scintigraphies. The time-activity curves (TAC) for all target organs were fitted by a sum of exponentials and then integrated to give time-integrated activity (TIA).</p><p id="Par24">Secondly, we used two sets of S-values, one obtained from the OpenDose3D website to calculate the absorbed dose to the classic organs at risk (liver, kidneys, etc.) and the other obtained from Monte Carlo simulations performed with GATE for the specific cartilage zones as described and applied in a previous study [<xref ref-type="bibr" rid="CR20">20</xref>]. Absorbed dose for each organ of interest was obtained by multiplying the TIA and the S-values.</p><p id="Par25">The whole body effective dose (E) due to [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 injection for an activity of 1050 MBq (15 MBq/kg for 70&#x000a0;kg) was calculated using the formula <inline-formula id="IEq1"><alternatives><tex-math id="d33e549">\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\:E=\sum\:_{T}{W}_{T}\sum\:_{R}{W}_{R}{D}_{T,R}$$\end{document}</tex-math><inline-graphic xlink:href="13550_2025_1318_Article_IEq1.gif"/></alternatives></inline-formula>, were D<sub>T, R</sub> is the tissue absorbed dose in Gy, W<sub>R</sub> is the radiation weighting factor for radiation R and W<sub>T</sub> is the tissue weighting factor for tissue T and R <inline-formula id="IEq2"><alternatives><tex-math id="d33e562">\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\:\sum\:_{T}{W}_{T}=1.$$\end{document}</tex-math><inline-graphic xlink:href="13550_2025_1318_Article_IEq2.gif"/></alternatives></inline-formula>.</p></sec><sec id="Sec10"><title>Statistical considerations</title><p id="Par26">A maximum of six patients could be included in the study, with a maximum of four patients per dose level. The stopping rule was that at least two patients have received the recommended dose level and with one patient from each group in the selected dose level. The number of subjects to be included makes it possible to validate the hypothesis that healthy cartilage presented a significantly higher fixation than diaphysis fixation. For each patient, a number of 31 observations (healthy joints) at four different times was available for the evaluation of the main objective.</p><p id="Par27">Optimal activity was chosen by the dose escalation algorithm [<xref ref-type="bibr" rid="CR18">18</xref>]. The recommended dose was defined as the dose from which 100% of patients presented a score 3 in at least 80% of healthy joints visualized on scintigraphies performed at 2&#x000a0;h p.i. or less and without dose-limiting toxicity (DLT). This threshold was chosen because it corresponds to a sensitivity of 80%, sufficient for diagnostic imaging. DLT was defined as any grade 3&#x02013;4 toxicity occurring in the week following the injection. If more than one time (30&#x000a0;min&#x02013;2&#x000a0;h) fulfilled these conditions, a McNemar test for which the number (minimum 2 patients, hence <italic>n</italic>&#x02009;&#x02265;&#x02009;62 healthy joints) allowed us to have a power of 0.8 to choose the optimal time, with an average effect size of 0.3 and an alpha risk equal to 0.05.</p><p id="Par28">The statistical significance threshold was set at 5%. Statistical analyses were performed using R software. The influence of acquisition time on fixation was analyzed by mixed models, to take into account the data non-independence (repeated data on the same patient, at several locations, at four acquisition times, by two readers), with uptake location and acquisition times as fixed effects, and subjects and reader as random effects. The rest of the analysis is essentially descriptive. Missing data were not replaced.</p></sec></sec><sec id="Sec11"><title>Results</title><sec id="Sec12"><title>Population characteristics</title><p id="Par29">Patient recruitment began in November 2020 and inclusions was closed in June 2022. Six patients were included: one in the lowest dose step, one in the middle dose step and four in the highest dose step. Half of patient was in osteoarthritis group and the other half in breast cancer group. The injected activity corresponded to the theoretical dose step for five patients, with a <sup>99m</sup>Tc-NTP15-5 radiochemical purity of 98.50&#x02009;&#x000b1;&#x02009;1.11% (Hydrolyzed reduced <sup>99m</sup>Tc: 1.31&#x02009;&#x000b1;&#x02009;1.20%; <sup>99m</sup>TcO<sub>4</sub><sup>&#x02212;</sup>: 0.19&#x02009;&#x000b1;&#x02009;0.21%). The quality control of the radiotracer was insufficient during the preparation of the last patient of highest step, who therefore was not injected with [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5.</p><p id="Par30">The five injected patients composed the studied population. The mean and standard deviation of the administered mass of <sup>99m</sup>Tc-NTP15-5 was 56,9&#x02009;&#x000b1;&#x02009;20,7&#x000a0;&#x000b5;g (range, 21,6&#x02013;75,6&#x000a0;&#x000b5;g). The mean administered activity was 878&#x02009;&#x000b1;&#x02009;353 MBq (range, 305&#x02013;1259 MBq). Sex ratio F: M was 4:1 and population age, weight, height and BMI were respectively 57.8&#x02009;&#x000b1;&#x02009;8.9 years, 70.2&#x02009;&#x000b1;&#x02009;17.4&#x000a0;kg, 1.65&#x02009;&#x000b1;&#x02009;0.06&#x000a0;m and 26.3&#x02009;&#x000b1;&#x02009;6.3&#x000a0;kg/m&#x000b2;. Characteristics of each patients are detailed in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>.<table-wrap id="Tab1"><label>Table 1</label><caption><p>Patients characteristics and activity steps</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"><bold>Patient n&#x000b0;</bold></th><th align="left"><bold>Dose step (MBq/kg)</bold></th><th align="left"><bold>Group</bold></th><th align="left"><bold>Sex</bold></th><th align="left"><bold>Age (years)</bold></th><th align="left"><bold>Weight (kg)</bold></th><th align="left"><bold>Height (m)</bold></th><th align="left"><bold>BMI (kg/m&#x000b2;)</bold></th><th align="left"><bold>Injected activity (MBq/kg)</bold></th></tr></thead><tbody><tr><td align="left">01</td><td align="left">5</td><td align="left">Breast cancer</td><td align="left">F</td><td align="left">56</td><td align="left">61</td><td align="left">1.59</td><td align="left">24.1</td><td align="left">4.92</td></tr><tr><td align="left">02</td><td align="left">10</td><td align="left">Osteoarthritis</td><td align="left">M</td><td align="left">68</td><td align="left">96</td><td align="left">1.73</td><td align="left">32.1</td><td align="left">9.85</td></tr><tr><td align="left">03</td><td align="left">15</td><td align="left">Breast cancer</td><td align="left">F</td><td align="left">51</td><td align="left">60</td><td align="left">1.60</td><td align="left">23.4</td><td align="left">16.45</td></tr><tr><td align="left">04</td><td align="left">15</td><td align="left">Breast cancer</td><td align="left">F</td><td align="left">52</td><td align="left">80</td><td align="left">1.62</td><td align="left">30.5</td><td align="left">15.31</td></tr><tr><td align="left">05</td><td align="left">15</td><td align="left">Osteoarthritis</td><td align="left">F</td><td align="left">62</td><td align="left">54</td><td align="left">1.72</td><td align="left">18.3</td><td align="left">15.87</td></tr><tr><td align="left">06</td><td align="left">15</td><td align="left">Osteoarthritis</td><td align="left">M</td><td align="left">73</td><td align="left">77</td><td align="left">1.63</td><td align="left">29.0</td><td align="left">0.00</td></tr></tbody></table></table-wrap></p></sec><sec id="Sec13"><title>Toxicity</title><p id="Par31">None major adverse event (NCI-CTCAE grade&#x02009;&#x02265;&#x02009;3) occurred from D0 of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 administration to the end of follow-up, for all injected patients. Only 12 minor adverse event occurred (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>), each one only one time (frequency&#x02009;=&#x02009;1/5), most of them NCI-CTCAE grade 1, and none was considered as related to the [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 administration. Then, no significant changes in vital signs or the results of laboratory studies or electrocardiograms were observed. No DLT occurred during this study.<table-wrap id="Tab2"><label>Table 2</label><caption><p>Adverse events of CARSPECT trial</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"><bold>Dose step (MBq/kg)</bold></th><th align="left"><bold>Group</bold></th><th align="left"><bold>Adverse event</bold></th><th align="left"><bold>Grade</bold></th></tr></thead><tbody><tr><td align="left">5</td><td align="left">Breast cancer</td><td align="left">Osteopenia</td><td align="left">2</td></tr><tr><td align="left">15</td><td align="left">Breast cancer</td><td align="left">Asthma</td><td align="left">2</td></tr><tr><td align="left">15</td><td align="left">Breast cancer</td><td align="left">Blood bicarbonate decreased</td><td align="left">1</td></tr><tr><td align="left">15</td><td align="left">Breast cancer</td><td align="left">Alanine aminotransferase increased</td><td align="left">1</td></tr><tr><td align="left">15</td><td align="left">Osteoarthritis</td><td align="left">Urea urine decreased</td><td align="left">1</td></tr><tr><td align="left">15</td><td align="left">Breast cancer</td><td align="left">Urine calcium decreased</td><td align="left">1</td></tr><tr><td align="left">15</td><td align="left">Breast cancer</td><td align="left">Creatinine urine decreased</td><td align="left">1</td></tr><tr><td align="left">15</td><td align="left">Osteoarthritis</td><td align="left">Leukopenia</td><td align="left">1</td></tr><tr><td align="left">15</td><td align="left">Osteoarthritis</td><td align="left">Protein total decreased</td><td align="left">1</td></tr><tr><td align="left">15</td><td align="left">Osteoarthritis</td><td align="left">Hepatic fibrosis marker abnormal</td><td align="left">1</td></tr><tr><td align="left">15</td><td align="left">Osteoarthritis</td><td align="left">Blood pressure increased</td><td align="left">2</td></tr><tr><td align="left">15</td><td align="left">Osteoarthritis</td><td align="left">Glucose urine absent</td><td align="left">1</td></tr></tbody></table></table-wrap></p></sec><sec id="Sec14"><title>Visual scintigraphy analysis</title><p id="Par32">Articular uptake was present in all examination times and particularly individualized at limbs joints on two first acquisition times. Spinal joints were more difficult to identify during two first acquisition times. The semi-quantitative visual analysis (Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>) invalidated the two first dose steps. At the third dose step (15 MBq/kg), median rates (IQI) of joints with a higher uptake than adjacent diaphysis were respectively 29.0% (27.40&#x02013;46.75) at 30&#x000a0;min p.i., 80.6% (80.60&#x02013;85.45) at 2&#x000a0;h p.i., 93.5% (90.30&#x02013;96.75) at 4&#x000a0;h p.i. and 93.5% (85.45&#x02013;95.15) at 6&#x000a0;h p.i. Thus the third dose step was validated.<table-wrap id="Tab3"><label>Table 3</label><caption><p>Visual analysis results</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="3"><bold>Patient n&#x000b0;</bold></th><th align="left" rowspan="3"><bold>Dose step (MBq/kg)</bold></th><th align="left" colspan="8"><bold>Joints with level 3 visual scale</bold></th></tr><tr><th align="left" colspan="2"><bold>30 min p.i</bold></th><th align="left" colspan="2"><bold>2 h p.i</bold></th><th align="left" colspan="2"><bold>4 h p.i</bold></th><th align="left" colspan="2"><bold>6 h p.i</bold></th></tr><tr><th align="left">N (/31)</th><th align="left">%</th><th align="left">N (/31)</th><th align="left">%</th><th align="left">N (/31)</th><th align="left">%</th><th align="left">N (/31)</th><th align="left">%</th></tr></thead><tbody><tr><td align="left">01</td><td align="left">5</td><td align="left">0</td><td align="left">0</td><td align="left">10</td><td align="left">32.3</td><td align="left">15</td><td align="left">48.4</td><td align="left">14</td><td align="left">45.2</td></tr><tr><td align="left">02</td><td align="left">10</td><td align="left">3</td><td align="left">9.7</td><td align="left">11</td><td align="left">35.5</td><td align="left">23</td><td align="left">74.2</td><td align="left">19</td><td align="left">61.3</td></tr><tr><td align="left">03</td><td align="left">15</td><td align="left">20</td><td align="left">64.5</td><td align="left">28</td><td align="left">90.3</td><td align="left">31</td><td align="left">100</td><td align="left">24</td><td align="left">77.4</td></tr><tr><td align="left">04</td><td align="left">15</td><td align="left">9</td><td align="left">29.0</td><td align="left">25</td><td align="left">80.6</td><td align="left">27</td><td align="left">87.1</td><td align="left">30</td><td align="left">96.8</td></tr><tr><td align="left">05</td><td align="left">15</td><td align="left">8</td><td align="left">25.8</td><td align="left">25</td><td align="left">80.6</td><td align="left">29</td><td align="left">93.5</td><td align="left">29</td><td align="left">93.5</td></tr></tbody></table></table-wrap></p><p id="Par33">Whole body planar scintigraphies showed urinary and enterohepatic elimination of the radiotracer (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>a.). In addition, the periarticular structures such as the ischial and trochanteric bursa showed a physiological uptake from the first acquisition times to 6&#x000a0;h p.i. (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>a.). SPECT-CT visual analysis confirmed that joint uptakes were localized on articular interfaces and periarticular structures as bursa, tendons and ligaments (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>b.). These uptakes seemed to increase with time, while muscular and bones uptakes decreased.<fig id="Fig1"><label>Fig. 1</label><caption><p><sup>99m</sup>Tc NTP 15-5 scintigraphies at 15 MBq/kg dose step: female patient with right knee osteoarthritis.&#x000a0;<bold>a</bold>.&#x000a0;Whole-body planar acquisition. The images saturations were performed in order to obtain comparable muscular backgrounds. Blue arrows: trochanteric bursa. Red arrows: Ischiatic bursa <bold>b</bold>.&#x000a0;SPECT-CT of right knee. The same saturation scale was used for all images. Yellow arrows: cartilaginous articular interfaces. Green arrows: patellar tendon. Orange arrows: patellar ligament</p></caption><graphic xlink:href="13550_2025_1318_Fig1_HTML" id="MO1"/></fig></p></sec><sec id="Sec15"><title>Quantitative scintigraphy analysis</title><p id="Par34">Cartilage S/N ratio was &#x0003e;&#x02009;3 from 2h30 p.i. for all conditions, except for mean intensity ratio with bone background. It was the same for pooled proteoglycan structures analysis with muscular background. Bursa showed S/N ratios close or higher than 3 from 1&#x000a0;h p.i. in most cases, while ligaments&#x02009;+&#x02009;tendons S/N ratios were &#x0003c;&#x02009;3 in all conditions. For the analysis of knees structures, there was no statistically significant difference between osteoarthritis and healthy joints (<italic>p</italic>&#x02009;=&#x02009;0.25).</p><p id="Par35">Significant interaction between time and studied structures was found for all S/N ratio with muscular background, for cartilage compared with muscle (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001 for all ratio), pooled proteoglycan structures compared with muscle (<italic>p</italic>&#x02009;=&#x02009;0.004 for maximum, <italic>p</italic>&#x02009;=&#x02009;0.002 for peak and <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001 for mean S/N) and for the comparison of each proteoglycan structures (<italic>p</italic>&#x02009;=&#x02009;0.002 for maximum, <italic>p</italic>&#x02009;=&#x02009;0.001 for peak and <italic>p</italic>&#x02009;=&#x02009;0.03 for mean S/N). It was the same when bone background was used for cartilage study compared with bone (<italic>p</italic>&#x02009;=&#x02009;0.03 for maximum, <italic>p</italic>&#x02009;=&#x02009;0.01 for peak and <italic>p</italic>&#x02009;=&#x02009;0.03 for mean S/N) and for the comparison of each proteoglycan structures (<italic>p</italic>&#x02009;=&#x02009;0.003 for maximum, <italic>p</italic>&#x02009;=&#x02009;0.001 for peak and <italic>p</italic>&#x02009;=&#x02009;0.003 for mean S/N). Thus, the [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 uptake evolution depending on time was different for each of these localizations, and permit to discriminate cartilage and pooled proteoglycan structures from background for all examination times (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). It was the same for comparisons between cartilage and ligaments&#x02009;+&#x02009;tendons (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001), between bursa and ligaments&#x02009;+&#x02009;tendons for the three first acquisition times (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001) and between bursa and cartilage at 1&#x000a0;h p.i. (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.05), while other conditions results were more heterogeneous. No significant interaction was found between time and pooled proteoglycan structures S/N ratio with bone background, compared with bone (<italic>p</italic>&#x02009;=&#x02009;0.3 for maximum, <italic>p</italic>&#x02009;=&#x02009;0.2 for peak and <italic>p</italic>&#x02009;=&#x02009;0.4 for mean S/N). Then, no analyze was performed for each time in these cases, but the time pooled analysis showed a significant difference between pooled Proteoglycan structures and bone for each ratio (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001 in all cases).</p><p id="Par36">Details of quantitative analysis results are available in Additional File 2.</p></sec><sec id="Sec16"><title>Pharmacokinetic study</title><p id="Par37">[<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 activity- in the blood compartment decreased throughout the sequential blood tests, from 24.7&#x02009;&#x000b1;&#x02009;3.5% of injected activity at 5&#x000a0;min p.i. to 3.7&#x02009;&#x000b1;&#x02009;0.6% at 6&#x000a0;h p.i. (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>). Most of this blood activity was located in the serum and decreased from 77&#x02009;&#x000b1;&#x02009;2% of blood activity at 5&#x000a0;min p.i. to 51&#x02009;&#x000b1;&#x02009;4% at 6&#x000a0;h p.i., while injected activity fixed by blood proteins increased from 16&#x02009;&#x000b1;&#x02009;4% to 44&#x02009;&#x000b1;&#x02009;2% at the same measurement times.</p><p id="Par38">The pharmacokinetic curve followed a two-compartment model, with a half-life distribution of 10.5&#x02009;&#x000b1;&#x02009;1.8&#x000a0;min and a half-life elimination of 1.4&#x02009;&#x000b1;&#x02009;0.3&#x000a0;h. Counted urine, collected during 6 to 8&#x000a0;h p.i., showed an elimination of 59&#x02009;&#x000b1;&#x02009;15% of injected [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5.</p><p id="Par39">
<fig id="Fig2"><label>Fig. 2</label><caption><p><sup>99m</sup>Tc NTP 15&#x02009;&#x02212;&#x02009;5 blood compartment clearance, decay corrected</p></caption><graphic xlink:href="13550_2025_1318_Fig2_HTML" id="MO2"/></fig>
</p></sec><sec id="Sec17"><title>Dosimetry analysis</title><p id="Par40">Dosimetry analysis was performed on all included patients. The whole body effective dose (E) due to [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 injection was 0.43 mSv. Due to [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 urine elimination, kidneys were the target organs presenting the highest absorbed dose, with a maximum value of 10.57 &#x000b5;Gy/MBq. Table&#x000a0;<xref rid="Tab4" ref-type="table">4</xref> details all target organs, cartilages and bone marrow absorbed doses.</p><p id="Par41">The whole body effective dose due to the CT acquisition was 6.84 mSv. Thus, the total whole body effective dose, sum of radiotracer injection and CT, was 7.27 mSv.<table-wrap id="Tab4"><label>Table 4</label><caption><p>[<sup>99m</sup>Tc]Tc-NTP 15-5 radiation dosimetry results</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="3" colspan="2"><bold>Target structures</bold></th><th align="left" colspan="4"><bold>Absorbed dose in &#x000b5;Gy/MBq</bold></th></tr><tr><th align="left" colspan="2">[<sup>99m</sup>Tc]Tc-NTP 15-5</th><th align="left" rowspan="2">[<sup>99m</sup>Tc]Tc-HDP</th><th align="left" rowspan="2">[<sup>18</sup>F]-FDG</th></tr><tr><th align="left"><bold>Man</bold></th><th align="left"><bold>Woman</bold></th></tr></thead><tbody><tr><td align="left" rowspan="8">Organs</td><td align="left">Liver</td><td align="left">1.68</td><td align="left">2.92</td><td align="left">1.20</td><td align="left">11.00</td></tr><tr><td align="left">Kidneys</td><td align="left">9.05</td><td align="left">10.77</td><td align="left">7.30</td><td align="left">21.00</td></tr><tr><td align="left">Lungs</td><td align="left">0.58</td><td align="left">0.76</td><td align="left">1.30</td><td align="left">10.00</td></tr><tr><td align="left">Thyroid</td><td align="left">0.03</td><td align="left">0.17</td><td align="left">1.30</td><td align="left">10.00</td></tr><tr><td align="left">Uterus</td><td align="left">-</td><td align="left">4.20</td><td align="left">6.30</td><td align="left">21.00</td></tr><tr><td align="left">Ovaries</td><td align="left">-</td><td align="left">2.40</td><td align="left">3.60</td><td align="left">15.00</td></tr><tr><td align="left">Breasts</td><td align="left">-</td><td align="left">0.24</td><td align="left">7.10</td><td align="left">8.60</td></tr><tr><td align="left">Testes</td><td align="left">0.24</td><td align="left">-</td><td align="left">2.40</td><td align="left">12.00</td></tr><tr><td align="left" rowspan="5">Cartilage</td><td align="left">Lumbar discs</td><td align="left">0.20</td><td align="left">0.33</td><td align="left">-</td><td align="left">-</td></tr><tr><td align="left">Thoracic discs</td><td align="left">0.19</td><td align="left">0.26</td><td align="left">-</td><td align="left">-</td></tr><tr><td align="left">Knees cartilage</td><td align="left">3.05</td><td align="left">2.05</td><td align="left">-</td><td align="left">-</td></tr><tr><td align="left">Humerus cartilage</td><td align="left">0.95</td><td align="left">0.57</td><td align="left">-</td><td align="left">-</td></tr><tr><td align="left">Hips cartilage</td><td align="left">0.02</td><td align="left">0.17</td><td align="left">-</td><td align="left">-</td></tr><tr><td align="left" rowspan="8">Bone marrow</td><td align="left">Lumbar vertebrae</td><td align="left">0.47</td><td align="left">0.65</td><td align="left" rowspan="8"><p>9.20</p><p>(Whole body)</p></td><td align="left" rowspan="8"><p>11.00</p><p>(Whole body)</p></td></tr><tr><td align="left">Thoracic vertebrae</td><td align="left">0.62</td><td align="left">0.57</td></tr><tr><td align="left">Upper Femurs</td><td align="left">0.40</td><td align="left">0.35</td></tr><tr><td align="left">Lower Femurs</td><td align="left">0.59</td><td align="left">0.47</td></tr><tr><td align="left">Tibias</td><td align="left">0.42</td><td align="left">0.37</td></tr><tr><td align="left">Pelvis</td><td align="left">0.29</td><td align="left">0.32</td></tr><tr><td align="left">Humerus</td><td align="left">0.41</td><td align="left">0.26</td></tr><tr><td align="left">Sternum</td><td align="left">0.12</td><td align="left">0.21</td></tr></tbody></table><table-wrap-foot><p>For bilateral structures, mean value of both sides is reported. Radiation dosimetry values of investigator center for bone scan and [<sup>18</sup>F]-FDG PET are reported for comparison</p></table-wrap-foot></table-wrap></p></sec></sec><sec id="Sec18"><title>Discussion</title><p id="Par42">This is, to our best knowledge, the first-in-human or the first study to demonstrate the high affinity of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 for human cartilage, and the safety of its utilization in clinical conditions concerning toxicity, pharmacology and dosimetry parameters. For an injected activity of 15 MBq/kg and time of 2&#x000a0;h p.i. for examination, the median rate of joints with a visual uptake higher than the diaphysis was 80.6%. The tracer showed an affinity for periarticular structures composed of proteoglycans, such as bursa. The SPECT-CT performed 30&#x000a0;min later achieved a cartilage S/N ratio&#x02009;&#x0003e;&#x02009;3, similar to healthy bone S/N ratio described in SPECT-CT studies [<xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR22">22</xref>]. The radiation dosimetry levels of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 target organs are consistent with a previous study extrapolating the animal dosimetry study to humans [<xref ref-type="bibr" rid="CR20">20</xref>], and are lower to those of a clinical bone scan [<xref ref-type="bibr" rid="CR23">23</xref>]. The rapid elimination of the radiotracer (elimination half-life of 1.4&#x02009;&#x000b1;&#x02009;0.3&#x000a0;h), could explain the low whole-body effective dose observed in this study (0.43 mSv), far below tolerated radiotoxicity levels, lower than bone scan and [<sup>18</sup>F]-FDG ones (respectively 4,08 mSv and 3.55 mSv in the investigator center), and then consistent for a diagnostic-use purpose. Knowing that scintigraphic examinations are regularly performed in the follow-up of chronic osteo-articular pathologies, benign as well as malignant, we can even consider carrying out [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 scintigraphies safely to monitor osteoarthritis evolution and treatment efficacy in future projects, provided that the diagnostic benefit is greater than the potential radiological risk of a low-irradiation examination carried out repeatedly, which is still discussed nowadays [<xref ref-type="bibr" rid="CR24">24</xref>].</p><p id="Par43">Imaging modalities such as MRI [<xref ref-type="bibr" rid="CR25">25</xref>&#x02013;<xref ref-type="bibr" rid="CR31">31</xref>] or light-near&#x02011;infrared-spectrometry [<xref ref-type="bibr" rid="CR32">32</xref>] can explore the function, the proteoglycan composition of articular cartilage or even the histological stage of osteoarthritis [<xref ref-type="bibr" rid="CR33">33</xref>]. However, these approaches are time-consuming, study one anatomical segment at a time and/or not transposable in routine clinical practice. None of these technics can assess all the joints at once, unlike [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 scintigraphy, which can carry out a cartilage assessment of all joints within a reasonable examination time, like the bone scan used worldwide, but with a different purpose : specific assessment of cartilage functional composition. Furthermore, there is no other cartilage-specific nuclear medicine tracer that has been studied so far in humans : [<sup>18</sup>F]-FDG [<xref ref-type="bibr" rid="CR34">34</xref>] or [<sup>18</sup>F]-FNa [<xref ref-type="bibr" rid="CR35">35</xref>] (or bone scintigraphy) demonstrate subchondral joint lesions uptakes in osteoarthritis, indicating a more advanced pathology and by definition a more pejorative prognosis than early osteoarthritis, which could logically be diagnosed by [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 scintigraphy. Concerning the tumor pathology of cartilage, chondrosarcoma, [<sup>18</sup>F]-FDG remains limited for the diagnosis of low-grade lesions [<xref ref-type="bibr" rid="CR36">36</xref>], rich in proteoglycans, which could probably shows [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 uptakes according to preclinical studies [<xref ref-type="bibr" rid="CR16">16</xref>, <xref ref-type="bibr" rid="CR37">37</xref>], one of them positioning [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 as a potential tracer for evaluating the therapeutic response [<xref ref-type="bibr" rid="CR37">37</xref>]. Concerning inflammatory rheumatisms [<sup>18</sup>F]-FDG is regularly used in the clinical assessment of patients difficult to diagnose, while [<sup>68</sup>Ga]Ga-FAPI shows fibroblastic activation in synovial membranes of patients with rheumatoid arthritis [<xref ref-type="bibr" rid="CR38">38</xref>]. [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 could be positioned in the same diagnostic exploration field, for nuclear medicine centers that do not have PET cameras, for example.</p><p id="Par44">Indeed, proteoglycans are not only present in joint cartilage, but also in periarticular structures such as tendons, periarticular bursas and ligaments [<xref ref-type="bibr" rid="CR39">39</xref>, <xref ref-type="bibr" rid="CR40">40</xref>]. These structures showed high [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 uptake in our study. Since the ischial and trochanteric bursas are clearly distinct from the joint capsules of the hips, particularly the ischial ones, which are visible on the CT sections, the anatomical reality of these uptake is quite certain. This point can be discussed for others measured uptakes: knowing that proteoglycans are present in the synovium of articular capsules, and the capsule is located against the patellar tendons and ligaments, it is possible that the foci visible at these sites correspond to the synovium. These questions were not addressed in preclinical studies but would deserve additional research, including performance of SPECT-CT or planar acquisitions in multiple incidences, in order to distinguish with certainty joint uptakes from those of the periarticular structures. Moreover, given the extent to which these structures are affected in inflammatory rheumatism [<xref ref-type="bibr" rid="CR41">41</xref>], the question arises as to what role [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 should play in the differential diagnosis between osteoarthritis and psoriatic arthritis, for instance, which is difficult to achieve in some cases [<xref ref-type="bibr" rid="CR42">42</xref>].</p><p id="Par45">Despite this set of very encouraging results for the continuation of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 clinical transfer, our study suffer from limitations. The low numbers of patients raise questions about the representativeness of our sample for the general population. In particular, out of our five patients, only one was a male. The results of the dosimetric study, particularly concerning the testicles, must therefore be interpreted with caution. Likewise, the quantitative analysis of osteoarthritis knees lack of power due to low number of patients in this subgroup (<italic>n</italic>&#x02009;=&#x02009;2), and breast cancer and knee osteoarthritis patients could not be compared due to this small number of patients. Additional studies are needed to assess the value of [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 in cartilage pathologies. Thus, two phase II clinical trials already funded will soon be carried out by our team, in order to evaluate the [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 imaging in osteoarthritis, rheumatoid arthritis, and in a multicentric study for the chondrosarcoma.</p></sec><sec id="Sec19"><title>Conclusion</title><p id="Par46">In conclusion, [<sup>99m</sup>Tc]Tc-NTP 15&#x02009;&#x02212;&#x02009;5 is a secure and promising scintigraphy radiotracer for human joints and periarticular functional imaging. Larger clinical trials should confirm its usefulness in a broad spectrum of benign and malignant cartilage pathologies.</p></sec><sec id="Sec20" sec-type="supplementary-material"><title>Supplementary Information</title><p>
<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="13550_2025_1318_MOESM1_ESM.docx"><caption><p>Supplementary Material 1.</p></caption></media></supplementary-material>
</p><p>
<supplementary-material content-type="local-data" id="MOESM2"><media xlink:href="13550_2025_1318_MOESM2_ESM.docx"><caption><p>Supplementary Material 2.</p></caption></media></supplementary-material>
</p></sec></body><back><fn-group><fn><p><bold>Publisher&#x02019;s note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn></fn-group><ack><title>Acknowledgements</title><p>We are grateful to all the patients and their caregivers, the members of the Independent Data Monitoring Committee and the investigators.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>Conception and design: FC, ET and IM.&#x000a0;Investigators of the study: FC, MC, SM and XD.&#x000a0;Revision of study design and protocol: SL, PA, TB, NS, GF, LM, EJ, IM, ET, FC, JR, XD, FP-L and EM-N.&#x000a0;Study coordination: FC and ET.&#x000a0;Data management and statistical analysis: IM.&#x000a0;Obtaining funding and supervision: FC and EM-N.&#x000a0;Drafting <sup>99m</sup>Tc-NTP 15&#x02009;&#x02212;&#x02009;5 IMPD: PA, SL, EM-N, FC.&#x000a0;Drafting the manuscript: MC.&#x000a0;Revision of, adaptation of and final approval of manuscript: All authors.&#x000a0;Accountable for all aspects of the work: All authors.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>The trial was funded by the French government IDEX-ISITE initiative 16-IDEX-0001-CAP 20&#x02013;25 (Challenge 3: mobility-2017) of the University of Clermont Auvergne. The toxicology regulatory studies needed for the IMPD of [<sup>99m</sup>Tc]Tc-NTP 15-5were supported by the French National Research Agency (ANR 15-CE18-003).&#x000a0;The funding parties were not involved in the design and conduct of the study, nor in the collection, management, analysis, and interpretation of the data. They were not involved in the writing of the manuscript.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>The datasets generated and/or analysed during the current study are not publicly available but access may be granted upon reasonable request sent to the team.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par47">The study protocol obtained approval from the French Ethics Committee (Comit&#x000e9; de Protection des Personnes Sud-Ouest et Outre-Mer II) in May 2020 and from the French National Agency for the Safety of Medicines and Health Products (ANSM) (N&#x000b0; EudraCT: 2020-000495-37) in June 2020.&#x000a0;The study is conducted in accordance with the Helsinki Declaration, the Good Clinical Practice (GCP) guidelines of the International Conference on Harmonisation (ICH&#x02013;E6, 17/07/96) and local regulatory requirements.</p></notes><notes id="FPar2"><title>Consent for publication</title><p id="Par48">Written consent to publish anonymized personal data was obtained from all patients at inclusion.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests</title><p id="Par49">The authors declare that they have no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Gilbert</surname><given-names>SJ</given-names></name><name><surname>Bonnet</surname><given-names>CS</given-names></name><name><surname>Blain</surname><given-names>EJ</given-names></name></person-group><article-title>Mechanical cues: bidirectional reciprocity in the extracellular matrix drives Mechano-Signalling in articular cartilage</article-title><source>Int J Mol Sci 18 D&#x000e9;c</source><year>2021</year><volume>22</volume><issue>24</issue><fpage>13595</fpage><pub-id pub-id-type="doi">10.3390/ijms222413595</pub-id></element-citation><mixed-citation id="mc-CR1" publication-type="journal">Gilbert SJ, Bonnet CS, Blain EJ. Mechanical cues: bidirectional reciprocity in the extracellular matrix drives Mechano-Signalling in articular cartilage. Int J Mol Sci 18 D&#x000e9;c. 2021;22(24):13595.</mixed-citation></citation-alternatives></ref><ref id="CR2"><label>2.</label><citation-alternatives><element-citation id="ec-CR2" publication-type="journal"><person-group person-group-type="author"><name><surname>Wilmot</surname><given-names>A</given-names></name><name><surname>Gieschler</surname><given-names>S</given-names></name><name><surname>Behera</surname><given-names>D</given-names></name><name><surname>Gade</surname><given-names>TP</given-names></name><name><surname>Reumann</surname><given-names>MK</given-names></name><name><surname>Biswal</surname><given-names>S</given-names></name><etal/></person-group><article-title>Molecular imaging: an innovative force in musculoskeletal radiology</article-title><source>Am J Roentgenol Ao&#x000fb;t</source><year>2013</year><volume>201</volume><issue>2</issue><fpage>264</fpage><lpage>77</lpage><pub-id pub-id-type="doi">10.2214/AJR.13.10713</pub-id></element-citation><mixed-citation id="mc-CR2" publication-type="journal">Wilmot A, Gieschler S, Behera D, Gade TP, Reumann MK, Biswal S, et al. Molecular imaging: an innovative force in musculoskeletal radiology. Am J Roentgenol Ao&#x000fb;t. 2013;201(2):264&#x02013;77.</mixed-citation></citation-alternatives></ref><ref id="CR3"><label>3.</label><citation-alternatives><element-citation id="ec-CR3" publication-type="journal"><person-group person-group-type="author"><name><surname>Alizai</surname><given-names>H</given-names></name><name><surname>Walter</surname><given-names>W</given-names></name><name><surname>Khodarahmi</surname><given-names>I</given-names></name><name><surname>Burke</surname><given-names>CJ</given-names></name></person-group><article-title>Cartilage imaging in osteoarthritis</article-title><source>Semin Musculoskelet Radiol</source><year>2019</year><volume>23</volume><issue>5</issue><fpage>569</fpage><lpage>77</lpage><pub-id pub-id-type="doi">10.1055/s-0039-1695720</pub-id><pub-id pub-id-type="pmid">31556090</pub-id>

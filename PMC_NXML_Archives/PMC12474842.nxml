><issue>5</issue><fpage>611</fpage><lpage>2</lpage><pub-id pub-id-type="doi">10.1016/j.berh.2018.07.001</pub-id></element-citation><mixed-citation id="mc-CR8" publication-type="journal">Berenbaum F, Kloppenburg M. Osteoarthritis: research in motion. Best Pract Res Clin Rheumatol 1 Oct. 2017;31(5):611&#x02013;2.</mixed-citation></citation-alternatives></ref><ref id="CR9"><label>9.</label><citation-alternatives><element-citation id="ec-CR9" publication-type="journal"><person-group person-group-type="author"><name><surname>Kohn</surname><given-names>MD</given-names></name><name><surname>Sassoon</surname><given-names>AA</given-names></name><name><surname>Fernando</surname><given-names>ND</given-names></name></person-group><article-title>Classifications in brief: Kellgren-Lawrence classification of osteoarthritis</article-title><source>Clin Orthop</source><year>2016</year><volume>474</volume><issue>8</issue><fpage>1886</fpage><lpage>93</lpage><pub-id pub-id-type="doi">10.1007/s11999-016-4732-4</pub-id><pub-id pub-id-type="pmid">26872913</pub-id>

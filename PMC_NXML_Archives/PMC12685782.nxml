<article-meta><article-id pub-id-type="pmid">41377884</article-id><article-id pub-id-type="pmc">12685782</article-id><article-id pub-id-type="publisher-id">gs-14-11-2179</article-id><article-id pub-id-type="doi">10.21037/gs-2025-278</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Article</subject></subj-group></article-categories><title-group><article-title>Ultrasound-guided percutaneous drainage of collections in difficult locations after pancreaticoduodenectomy: experiences from a single Chinese institution</article-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><name><surname>Jiang</surname><given-names>Tao</given-names></name><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-3690-6678</contrib-id><xref rid="afn2" ref-type="author-notes">

<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">EJNMMI Res</journal-id><journal-id journal-id-type="iso-abbrev">EJNMMI Res</journal-id><journal-title-group><journal-title>EJNMMI Research</journal-title></journal-title-group><issn pub-type="epub">2191-219X</issn><publisher><publisher-name>Springer Berlin Heidelberg</publisher-name><publisher-loc>Berlin/Heidelberg</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41251983</article-id><article-id pub-id-type="pmc">12627303</article-id>
<article-id pub-id-type="publisher-id">1329</article-id><article-id pub-id-type="doi">10.1186/s13550-025-01329-0</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Research</subject></subj-group></article-categories><title-group><article-title>First-in-human intranasal [<sup>13</sup>N]oxytocin PET: evaluation of feasibility, biodistribution, and radiation dosimetry</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-8790-7574</contrib-id><name><surname>Winterdahl</surname><given-names>Michael</given-names></name><address><email>m.winterdahl@rn.dk</email></address><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Nielsen</surname><given-names>Erik Nguyen</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Hansen</surname><given-names>S&#x000f8;ren B.</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Dias</surname><given-names>Andr&#x000e9; Henrique</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Vendelbo</surname><given-names>Mikkel Holm</given-names></name><xref ref-type="aff" rid="Aff3">3</xref><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Jakobsen</surname><given-names>Steen</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Yeomans</surname><given-names>David</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/02jk5qe80</institution-id><institution-id institution-id-type="GRID">grid.27530.33</institution-id><institution-id institution-id-type="ISNI">0000 0004 0646 7349</institution-id><institution>Sexological Centre, </institution><institution>Aalborg University Hospital, </institution></institution-wrap>Aalborg, Denmark </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01aj84f44</institution-id><institution-id institution-id-type="GRID">grid.7048.b</institution-id><institution-id institution-id-type="ISNI">0000 0001 1956 2722</institution-id><institution>Translational Neuropsychiatry Unit, Department of Clinical Medicine, </institution><institution>Aarhus University, </institution></institution-wrap>Aarhus, Denmark </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/040r8fr65</institution-id><institution-id institution-id-type="GRID">grid.154185.c</institution-id><institution-id institution-id-type="ISNI">0000 0004 0512 597X</institution-id><institution>Department of Nuclear Medicine PET-Centre, </institution><institution>Aarhus University Hospital, </institution></institution-wrap>Aarhus, Denmark </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01aj84f44</institution-id><institution-id institution-id-type="GRID">grid.7048.b</institution-id><institution-id institution-id-type="ISNI">0000 0001 1956 2722</institution-id><institution>Department of Biomedicine, </institution><institution>Aarhus University, </institution></institution-wrap>Aarhus, Denmark </aff><aff id="Aff5"><label>5</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/00f54p054</institution-id><institution-id institution-id-type="GRID">grid.168010.e</institution-id><institution-id institution-id-type="ISNI">0000 0004 1936 8956</institution-id><institution>Department of Anaesthesiology, Perioperative and Pain Medicine, </institution><institution>Stanford University, </institution></institution-wrap>Palo Alto, CA USA </aff></contrib-group><pub-date pub-type="epub"><day>18</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>18</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>15</volume><elocation-id>137</elocation-id><history><date date-type="received"><day>19</day><month>5</month><year>2025</year></date><date date-type="accepted"><day>30</day><month>9</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">Oxytocin is a neuropeptide with therapeutic potential for several neuropsychiatric and pain-related disorders. Intranasal delivery is proposed to enable access to the central nervous system via the trigeminal nerve and olfactory nerves, thereby bypassing the blood&#x02013;brain barrier. However, direct evidence of biodistribution following intranasal administration in humans is limited. This study evaluated the feasibility of imaging oxytocin uptake using a novel PET tracer, [<sup>13</sup>N]oxytocin, in healthy volunteers.</p></sec><sec><title>Results</title><p id="Par2">Six participants received intranasal [<sup>13</sup>N]oxytocin and underwent whole-body or head PET/MRI scans. High tracer uptake was observed in the nasal cavity within the first 5&#x000a0;min, followed by a decline and systemic absorption. Tracer uptake in the trigeminal ganglia and brain varied between individuals, with no clear dose-dependency. One participant with rhinitis showed altered uptake and clearance patterns. Time&#x02013;activity curves indicated tracer presence in brain regions 25&#x02013;45&#x000a0;min post-administration, but image co-registration was challenged by high nasal activity and spillover effects. Radiation dosimetry analysis identified the nasal cavity as the critical organ, limiting allowable doses. Despite detectable presence in some brain regions, [<sup>13</sup>N]oxytocin uptake was low and variable.</p></sec><sec><title>Conclusions</title><p id="Par3">Intranasal [<sup>13</sup>N]oxytocin administration results in rapid and substantial nasal cavity uptake and detectable, but variable, tracer distribution to trigeminal and brain regions. While this technique offers insight into intranasal peptide delivery, limitations related to variable absorption, short half-life, and image co-registration must be addressed. Accordingly, [<sup>13</sup>N]oxytocin is not presently well suited for central nervous system receptor imaging via intranasal administration. Peripheral receptor imaging after intravenous administration may still be feasible, and further optimisation of tracer chemistry, administration protocols, and imaging strategies is warranted.</p></sec><sec><title>Trial registration</title><p id="Par4">ClinicalTrials.gov identifier: NCT06955650 (registered May 5, 2025).</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Positron emission tomography</kwd><kwd>Oxytocin</kwd><kwd>Intranasal administration</kwd><kwd>Trigeminal nerve</kwd><kwd>Pharmacokinetics</kwd><kwd>Brain imaging</kwd></kwd-group><funding-group><award-group><funding-source><institution-wrap><institution-id institution-id-type="FundRef">http://dx.doi.org/10.13039/100012526</institution-id><institution>Sundhedsvidenskabelige Fakultet, Aarhus Universitet</institution></institution-wrap></funding-source></award-group></funding-group><funding-group><award-group><funding-source><institution>Tonix Pharmaceuticals (US)</institution></funding-source></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer-Verlag GmbH Germany, part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par13">Oxytocin, a neuropeptide traditionally associated with childbirth and lactation, has in recent decades emerged as a key modulator of human social and emotional behaviour. Increasing evidence links oxytocin to social bonding, emotional regulation, and stress resilience [<xref ref-type="bibr" rid="CR2">2</xref>, <xref ref-type="bibr" rid="CR7">7</xref>]. Beyond these functions, oxytocin has garnered significant attention for its therapeutic potential in treating neuropsychiatric and pain-related conditions. Recent research has explored intranasal administration of oxytocin as a promising approach for managing disorders like craniofacial pain, autism spectrum disorder (ASD), schizophrenia, and posttraumatic stress disorder (PTSD) [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR11">11</xref>, <xref ref-type="bibr" rid="CR31">31</xref>]. Intranasal delivery is hypothesised to enable oxytocin to reach peripheral and central nervous system (CNS) sites via both the trigeminal and olfactory pathways, targeting oxytocin receptors in brain regions relevant to these disorders [<xref ref-type="bibr" rid="CR17">17</xref>, <xref ref-type="bibr" rid="CR18">18</xref>, <xref ref-type="bibr" rid="CR26">26</xref>].</p><p id="Par14">The trigeminal nerve, one of the largest cranial nerves, plays a crucial role in transmitting sensory information, including pain, from the face and head to the brain. It is particularly relevant in the context of intranasal oxytocin delivery. Studies suggest that oxytocin administered via the intranasal route can be absorbed through the nasal mucosa and transported to the brain via the trigeminal nerve pathways, effectively bypassing the blood&#x02013;brain barrier [<xref ref-type="bibr" rid="CR5">5</xref>]. This route of administration may provide a direct and efficient means of delivering oxytocin not only to the trigeminal system in order to decrease head pain, but also to brain regions implicated in social cognition, emotional processing, and behaviour. The trigeminal ganglia, therefore, emerge not only as a critical site of action for oxytocin for pain, but also as an important marker of transit to the brain for the modulation of neuropsychological issues [<xref ref-type="bibr" rid="CR30">30</xref>].</p><p id="Par15">Despite the promising therapeutic implications of oxytocin, the lack of an effective positron emission tomography (PET) tracer for oxytocin and its receptors after nasal delivery has posed a significant challenge to the in vivo study of oxytocin&#x02019;s distribution and action in the trigeminal nerve and brain of humans [<xref ref-type="bibr" rid="CR29">29</xref>]. A PET tracer specific to oxytocin receptors would enable the visualisation of ligand and oxytocin receptor distribution and density across the brain and trigeminal nerve ganglia in vivo, providing crucial insights into the pharmacokinetics and mechanisms underlying the effects of intranasal oxytocin administration. Previous attempts to develop such a tracer have faced obstacles, including poor brain uptake, the formation of brain-penetrant metabolites, strong off-target binding to vasopressin receptors, and inconsistencies between brain uptake and known receptor expression profiles [<xref ref-type="bibr" rid="CR29">29</xref>].</p><p id="Par16">In response to these challenges, our study seeks to address the gap in understanding oxytocin&#x02019;s biodistribution by evaluating the potential of a novel PET tracer, [<sup>13</sup>N]oxytocin, when administered intranasally. Indeed, a previous mass spectroscopy study in non-human primates has demonstrated measurable brain delivery of intranasally administered deuterated-labelled oxytocin [<xref ref-type="bibr" rid="CR14">14</xref>], providing proof-of-concept. By employing [<sup>13</sup>N]oxytocin, we aim to elucidate the pharmacokinetics of intranasal oxytocin delivery, providing a foundation for the development of more effective and targeted therapeutic strategies for neuropsychiatric and pain-related conditions. Potentially, this will allow for the direct assessment of the polypeptide&#x02019;s distribution and action within the CNS following intranasal administration.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Radiochemistry</title><p id="Par17">Figure&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref> illustrates the synthesis of [<sup>13</sup>N]oxytocin. The preparation of the tracer begins with [<sup>13</sup>N]ammonia, produced through the proton irradiation of O-16 water using the <sup>16</sup>O(p,&#x003b1;)<sup>13</sup>N nuclear reaction in aluminium targets. The presence of 5&#x02013;10&#x000a0;mM ethanol in the target water ensures the formation of [<sup>13</sup>N]NH<sub>3</sub>. Once the irradiation is complete, the [<sup>13</sup>N]-enriched target water is transported under helium overpressure to the laboratory, where it is collected in an empty glass vial.<fig id="Fig1"><label>Fig.&#x000a0;1</label><caption><p>Synthesis of [13N]oxytocin Activation of <italic>N</italic>-tert-Butyloxycarbonyl (BOC)-protected oxytocin free acid and labelling of diethylphosphoryl cyanide (DEPC)-activated <italic>N</italic>-BOC-protected oxytocin. Reagents and conditions: (i) 0.9 equivalents DEPC, 4-dimethylaminopyridine (PMP), dimethyl sulfoxide (DMSO)/tetrahydrofuran (THF), room temperature (rt); (ii) removal of the BOC group with [<sup>13</sup>N]ammonia ([<sup>13</sup>N]NH&#x02083;, gas), rt; (iii) 4&#x000a0;M hydrochloric acid (HCl) in dioxane, 50&#x000a0;&#x000b0;C, 2.5&#x000a0;min</p></caption><graphic xlink:href="13550_2025_1329_Fig1_HTML" id="MO1"/></fig></p><p id="Par18">To transfer [<sup>13</sup>N]NH<sub>3</sub> from the target to a precursor vial, [<sup>13</sup>N]NH<sub>4</sub> is initially transferred to a glass vial containing a mixture of sodium hydroxide pellets and Devarda&#x02019;s alloy. This mixture facilitates the liberation of [<sup>13</sup>N]NH<sub>3</sub>, which is then trapped in the precursor vial under slight overpressure. This vial is pre-loaded with 1&#x000a0;mg of N-tert-Butyloxycarbonyl (BOC) -protected oxytocin free acid in a solution of 50 &#x000b5;L Dimethyl Sulfoxide (DMSO), 450 &#x000b5;L Tetrahydrofuran (THF), 5 &#x000b5;L 4-Dimethylaminopyridine (PMP), and 0.9&#x000a0;eq Diethylphosphoryl Cyanide (DEPC), typically 0.125 &#x000b5;L. The labelling reaction with DECP-activated N-BOC-protected oxytocin occurs instantaneously. Subsequently, 400 &#x000b5;L of 4&#x000a0;M hydrochloric acid in dioxane is added to remove the BOC-group, heating the mixture at 50&#x000a0;&#x000b0;C for 2.5&#x000a0;min. The process involves three key reactions: activation of N-BOC protected oxytocin free acid, labelling of the resulting DEPC-activated N-BOC protected oxytocin, and finally removal of the BOC-group.</p><p id="Par19">The resulting reaction mixture is diluted with 10&#x000a0;mL of H<sub>2</sub>O and loaded onto a C18 Light Sep-Pak cartridge for solid phase extraction (SPE) purification. The [<sup>13</sup>N]oxytocin, retained on the cartridge, is washed with 20&#x000a0;mL of sterile water to remove organic solvents and then eluted with 1&#x000a0;mL of 85% ethanol. It passes through an NH2 PLUS Sep-Pak cartridge to remove oxytocin free acid and is further concentrated in 10&#x000a0;mL of H<sub>2</sub>O. Finally, [<sup>13</sup>N]oxytocin is eluted from another C18 Light Sep-Pak cartridge with 0.5&#x000a0;mL 50% ethanol and 50% 0.3&#x000a0;M MgCl<sub>2</sub> in 40&#x000a0;mM citrate buffer pH 4.5, then formulated with an additional 2&#x000a0;mL of the same solution. The product is sterilised through a 0.22&#x000a0;&#x000b5;m filter into the final product vial.</p><p id="Par20">The analysis for identifying [<sup>13</sup>N]oxytocin, assessing its radiochemical purity, and determining the mass of oxytocin utilizes an AmaZon Speed/Elute Ultra-High-Performance Liquid Chromatography&#x02013;Mass Spectrometry (UHPLC-MS) system by Bruker, equipped with a gamma-detector between the UV-detector and the MS, operated using Bruker trapControl and Compass Hystar v4.1. MS analysis in negative ion electrospray ionization (ESI) mode, with specified source parameters, identifies the most abundant ions for oxytocin and its precursors. Chromatographic separation was achieved using a Gemini C18 reversed-phase column, with distinct retention times for oxytocin, oxytocin free acid, and BOC-protected oxytocin free acid.</p><p id="Par21">Liquid Chromatography&#x02013;Mass Spectrometry (LCMS) grade acetonitrile and water were supplied by VWR (Rosny-sous-Bois-cedex, France). The oxytocin reference compound (oxytocin acetate) was supplied by Toronto Research Chemicals (Toronto, ON, Canada). Oxytocin free acid, the reference for de-protected precursor and the N-BOC protected oxytocin acid, labelling precursor was acquired from Abcam (CB, UK). Formic acid was supplied by VWR (Leuven, Belgium).</p></sec><sec id="Sec4"><title>Volunteers</title><p id="Par22">Study volunteers were recruited from the Aarhus University campus and online, and then underwent an initial screening via email or phone. After receiving detailed information about the study and providing written consent, participants underwent a health evaluation and a Magnetic Resonance Imaging (MRI) scan to assess brain structure and nasal cavities for PET image co-registration. Recruitment criteria specified participants aged 35&#x02013;50 with normal nasal anatomy and sensory function, excluding those with significant medical conditions or contraindications. The process was conducted individually for each of the six healthy volunteers to ensure comfort and minimise stress. Two volunteers participated in whole-body analysis (a 44-year-old male and a 51-year-old female), while four underwent trigeminal nerve and brain uptake studies (a 37-year-old male, two 42-year-old females, and a 40-year-old female.</p><p id="Par23">The study was registered in the EudraCT database (2017&#x02013;004466-98) and on ClinicalTrials.gov (NCT06955650), <ext-link ext-link-type="uri" xlink:href="https://clinicaltrials.gov/study/NCT06955650">https://clinicaltrials.gov/study/NCT06955650</ext-link>, and approved by the Ethics Committee of Central Denmark Region (77,797). Procedures were performed in accordance with the Declaration of Helsinki. Volunteers were reimbursed for participation.</p></sec><sec id="Sec5"><title>Study design</title><p id="Par24">After the initial MRI of the head to evaluate the brain structure and nasal pathways, the first two volunteers received a whole-body PET/MRI scan, while the remaining four volunteers only underwent a head PET/MRI scan. After training, intranasal [<sup>13</sup>N]oxytocin was self-administered using a conventional pump-actuated nasal spray device (Aptar Pharma, Val-de-Reuil, France) supplied as a 5&#x000a0;mL clear glass vial with a screw-on VP7 pump delivering 50 &#x000b5;L&#x02009;&#x000b1;&#x02009;0.5 &#x000b5;L per actuation. The volunteers administered the tracer to both nostrils, with the administration technique standardised according to published recommendations [<xref ref-type="bibr" rid="CR9">9</xref>]. The volunteers were guided and supervised during the administration. Following nasal administration, volunteers were positioned&#x000a0;headfirst&#x000a0;supine&#x000a0;in the&#x000a0;PET/MRI scanner, with padding provided for additional comfort. They were instructed to remain still and relax throughout the procedure, with the option to fall asleep if desired. The volunteers were under continuous monitoring and support from the medical staff during the approximately one-hour PET/MRI scan. Following the completion of the scan, an investigator debriefed the participant, and a physician conducted a brief clinical examination before discharge. The overall procedure, including preparation, PET/MRI scans, and clinical examination, took approximately three hours.</p></sec><sec id="Sec6"><title>MRI and PET acquisition</title><p id="Par25">For MRI and PET acquisitions, a hybrid PET/MRI system, General Electric (GE) Signa PET/MRI 3&#x000a0;T [<xref ref-type="bibr" rid="CR8">8</xref>], was used.</p></sec><sec id="Sec7"><title>Biodistribution and dosimetry</title><p id="Par26">In the first two volunteers, MRI scans were performed to define anatomic structures (T1 and T2 weighting) and for attenuation correction of the PET images (water/fat ratio from Dixon). The [<sup>13</sup>N]oxytocin solution was administered (<italic>n</italic>&#x02009;=&#x02009;2; median dose 3.05&#x000a0;MBq, range 2.66&#x02013;3.44&#x000a0;MBq). Both volunteers underwent three consecutive whole-body PET/MRI scans (top of the skull to mid-thigh; six bed positions) performed immediately after tracer administration. The PET images were reconstructed using the VPFX-S algorithm (GE implementation of Ordered Subset Expectation Maximisation (OSEM) and point spread function modelling) with 3 iterations and 16 subsets, 3-mm Gauss filter, and 192&#x02009;&#x000d7;&#x02009;192 matrix size, resulting in a voxel size of 3.1&#x02009;&#x000d7;&#x02009;3.1&#x02009;&#x000d7;&#x02009;2.8 mm<sup>3</sup>.</p></sec><sec id="Sec8"><title>Imaging of head and neck</title><p id="Par27">MRI scans were performed to define anatomic structures (T1 and T2 weighting) and for attenuation correction of the PET images (water/fat ratio from Dixon and bone from zero echo time MRI (ZTE)). The [<sup>13</sup>N]oxytocin solution was administered (<italic>n</italic>&#x02009;=&#x02009;4; median dose 6.07&#x000a0;MBq, range 0.98&#x02013;17.52&#x000a0;MBq). All volunteers underwent a dynamic PET scan of 45&#x000a0;min (blood sampling was not acquired) of the head and neck binned into 9 time-frames of 5&#x000a0;min duration. The PET images were reconstructed using the VPFX-S algorithm with 3 iterations and 16 subsets, 3-mm Gauss filter, and 192&#x02009;&#x000d7;&#x02009;192 matrix size, resulting in a voxel size 1.6&#x02009;&#x000d7;&#x02009;1.6&#x02009;&#x000d7;&#x02009;2.8 mm<sup>3</sup>. Data acquisition began approximately 7&#x000a0;min after tracer administration for both biodistribution scans and brain imaging, with particular attention to starting promptly while ensuring that participants were comfortably positioned in the scanner.</p></sec></sec><sec id="Sec9"><title>Image processing</title><sec id="Sec10"><title>Biodistribution and dosimetry</title><p id="Par28">The estimation of radiation dosage utilised the advanced MIRDcalc software, notable for its comprehensive updates and enhancements over previous dosimetry tools [<xref ref-type="bibr" rid="CR13">13</xref>]. This software facilitated the precise calculation of internal radiation exposure based on data obtained from consecutive&#x000a0;PET scans. The volume of interest (VOI) analysis determined activity levels in four primary organs, capturing over 80% of nuclear disintegrations. These critical source organs included the anterior nasal surface (ET1), posterior nasal surface (ET2), oesophageal surface, and stomach contents. Activity in the remaining tissues was uniformly distributed to account for the residual exposure. The body geometry model for these calculations was derived from the International Commission on Radiological Protection (ICRP) adult male and female phantoms, ensuring a comprehensive representation of human anatomy. The final step involved calculating the effective dose (ED), utilising organ weighting factors as outlined in ICRP Publication 103 (&#x0201c;The 2007 Recommendations of the International Commission on Radiological Protection. ICRP Publication 103&#x0201d;, 2007).</p></sec><sec id="Sec11"><title>Imaging of head and neck</title><p id="Par29">The PET/MRI images of the head and neck were analysed using PMOD 4.0 software from PMOD Technologies Ltd., Z&#x000fc;rich, Switzerland. Standard uptake value (SUV) images were generated to investigate tracer distribution and uptake over time. These images were calculated by dividing the activity concentration in the tissue by the administered dose per kilogram of body weight. PET data were corrected for head motion and manually co-registered to the structural MRI. The structural MRI was then normalised to Montreal Neurological Institute (MNI) space, and the resulting transformation matrix was applied to the co-registered PET images.</p><p id="Par30">Regions of interest (ROIs) corresponding to the trigeminal nerve and ganglia were manually delineated on individual structural MRI scans by an experienced investigator. Anatomical localisation was guided by established neuroanatomical landmarks, including the root entry zone at the pons, Meckel&#x02019;s cave, and the cisternal segments of the nerve. Each ROI was verified across multiple planes (axial, coronal, and sagittal) to ensure anatomical accuracy and to minimise partial volume effects. Brain time&#x02013;activity curves were extracted for standardised brain ROIs using the N30R83 Maximum Probability Atlas [<xref ref-type="bibr" rid="CR10">10</xref>], with the corresponding left and right regions averaged prior to analysis. All paired ROIs were defined using this standardised symmetric anatomical atlas, ensuring identical volumes.</p></sec></sec><sec id="Sec12"><title>Results</title><sec id="Sec13"><title>Radiochemistry</title><p id="Par31">Starting with 5&#x02013;10&#x000a0;GBq of [<sup>13</sup>N]NH<sub>3</sub>, a significant portion of the radioactivity is transferred to the precursor vial within 6&#x000a0;min, though the process exhibits considerable variability. The coupling of [<sup>13</sup>N]NH<sub>3</sub> with the precursor occurs swiftly, and, notably, the production of BOC-protected [<sup>13</sup>N]oxytocin is successful even in the presence of trace amounts of water. Utilising 4&#x000a0;M HCl in dioxane, the deprotection step results in approximately 80&#x02013;90% yield. Alternative acids, such as 2&#x000a0;M HCl in ether, TFA in dichloromethane, 10&#x000a0;M H<sub>2</sub>SO<sub>4</sub>, or 12&#x000a0;M HCl, were found to be less effective or introduced issues related to solvent compatibility or solubility. For purification, traditional reversed-phase High-Performance Liquid Chromatography (HPLC) using either 20% acetonitrile or 25% ethanol was able to produce radiochemically pure products. However, this method resulted in undesirably high levels of oxytocin free acid, which is believed to possess pharmacological properties similar to oxytocin. Ion-pair HPLC followed by C18 formulation was deemed too time-consuming to produce sufficient product for administration purposes.</p><p id="Par32">The optimised synthesis pathway involves a sequence of three alternating cartridge purification steps: C18, followed by NH<sub>2</sub>, and then C18 again. This method efficiently produces a radiochemically pure product suitable for use. The final intranasal spray formulation consists of 10% ethanol in an isotonic aqueous solution (0.3&#x000a0;M MgCl<sub>2</sub>-citrate buffer) with a pH between 4 and 5. Typically, this process yields 400&#x000a0;MBq in 2.5&#x000a0;mL, allowing for the administration of up to 20&#x000a0;MBq of [<sup>13</sup>N]oxytocin, containing 0.1 &#x000b5;g of oxytocin, following rigorous radio-HPLC&#x02013;MS quality control. This synthesis and purification approach ensures a high-quality product optimised for both safety and efficacy in intranasal administration.</p></sec><sec id="Sec14"><title>Biodistribution and dosimetry</title><p id="Par33">We evaluated the dosimetry of [<sup>13</sup>N]oxytocin uptake, focusing on selected critical organs that are inherently sensitive to radiotracer distribution. Data from two volunteers, one male and one female, were included in this analysis. Absorbed doses for each organ are itemised in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>. The average absorbed dose for the anterior nasal passages was 10.22&#x000a0;mGy/MBq, while the posterior nasal passages averaged 1.995&#x000a0;mGy/MBq. The combined extrathoracic region, encompassing both anterior and posterior nasal passages, showed an average dose of 2.36&#x000a0;mGy/MBq. Lymph nodes within the extrathoracic region had an average absorbed dose of 0.1125&#x000a0;mGy/MBq. The tonsils and tongue presented average doses of 0.0235&#x000a0;mGy/MBq and 0.0222&#x000a0;mGy/MBq, respectively. The eye lens, a critical and radiosensitive organ, exhibited an average absorbed dose of 0.00795&#x000a0;mGy/MBq, highlighting the necessity of considering the potential for radiation exposure in these tissues.<table-wrap id="Tab1"><label>Table&#x000a0;1</label><caption><p>Biodistribution and dosimetry</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">Male</th><th align="left">Female</th></tr></thead><tbody><tr><td align="left">Organ</td><td align="left">&#x003bc;Gy/MBq</td><td align="left">&#x003bc;Gy/MBq</td></tr><tr><td align="left">Adipose tissue</td><td align="left">0.83</td><td align="left">1.07</td></tr><tr><td align="left">Adrenals</td><td align="left">0.31</td><td align="left">0.89</td></tr><tr><td align="left">Bone&#x02014;endosteal cells</td><td align="left">0.91</td><td align="left">1.39</td></tr><tr><td align="left">Bone marrow&#x02014;red (active)</td><td align="left">0.88</td><td align="left">1.62</td></tr><tr><td align="left">Brain</td><td align="left">3.40</td><td align="left">3.12</td></tr><tr><td align="left">Breast tissue</td><td align="left">0.37</td><td align="left">0.84</td></tr><tr><td align="left">Bronchial basal cells</td><td align="left">0.58</td><td align="left">2.22</td></tr><tr><td align="left">Bronchial secretory cells</td><td align="left">0.58</td><td align="left">2.22</td></tr><tr><td align="left">Bronchiolar secretory cells</td><td align="left">0.50</td><td align="left">1.10</td></tr><tr><td align="left">Colon&#x02014;ICRP133</td><td align="left">0.21</td><td align="left">0.40</td></tr><tr><td align="left">Colon&#x02014;left</td><td align="left">0.28</td><td align="left">0.42</td></tr><tr><td align="left">Colon&#x02014;rectosigmoid</td><td align="left">0.15</td><td align="left">0.39</td></tr><tr><td align="left">Colon&#x02014;right</td><td align="left">0.18</td><td align="left">0.40</td></tr><tr><td align="left">Esophagus</td><td align="left">6.93</td><td align="left">55.60</td></tr><tr><td align="left">Nasal passages, anterior (ET1)</td><td align="left">16,400.00</td><td align="left">4800.00</td></tr><tr><td align="left">Nasal passages, posterior (ET2)</td><td align="left">1790.00</td><td align="left">2200.00</td></tr><tr><td align="left">Extrathoracic region (ET1 and ET2)</td><td align="left">2410.00</td><td align="left">2310.00</td></tr><tr><td align="left">Eye lens</td><td align="left">10.50</td><td align="left">5.38</td></tr><tr><td align="left">Gallbladder wall</td><td align="left">0.27</td><td align="left">0.75</td></tr><tr><td align="left">Heart wall</td><td align="left">0.53</td><td align="left">1.54</td></tr><tr><td align="left">Kidneys</td><td align="left">0.26</td><td align="left">0.71</td></tr><tr><td align="left">Liver</td><td align="left">0.32</td><td align="left">0.80</td></tr><tr><td align="left">Lung&#x02014;ICRP133</td><td align="left">0.48</td><td align="left">1.10</td></tr><tr><td align="left">Lungs (AI)</td><td align="left">0.48</td><td align="left">1.10</td></tr><tr><td align="left">Lymph nodes&#x02014;extrathoracic</td><td align="left">157.00</td><td align="left">74.80</td></tr><tr><td align="left">Lymph nodes&#x02014;systemic</td><td align="left">0.56</td><td align="left">1.32</td></tr><tr><td align="left">Lymph nodes&#x02014;thoracic</td><td align="left">1.93</td><td align="left">13.80</td></tr><tr><td align="left">Lymphatic nodes&#x02014;ICRP133</td><td align="left">13.80</td><td align="left">8.56</td></tr><tr><td align="left">Muscle</td><td align="left">0.50</td><td align="left">0.85</td></tr><tr><td align="left">Oral mucosa</td><td align="left">22.20</td><td align="left">31.80</td></tr><tr><td align="left">Ovaries</td><td align="left">0.00</td><td align="left">0.48</td></tr><tr><td align="left">Pancreas</td><td align="left">0.36</td><td align="left">0.92</td></tr><tr><td align="left">Pituitary gland</td><td align="left">43.00</td><td align="left">11.90</td></tr><tr><td align="left">Prostate</td><td align="left">0.18</td><td align="left">0.00</td></tr><tr><td align="left">Salivary glands</td><td align="left">4.38</td><td align="left">10.20</td></tr><tr><td align="left">Skin</td><td align="left">0.52</td><td align="left">0.58</td></tr><tr><td align="left">Small intestine</td><td align="left">0.20</td><td align="left">0.51</td></tr><tr><td align="left">Spleen</td><td align="left">0.36</td><td align="left">1.13</td></tr><tr><td align="left">Stomach</td><td align="left">3.67</td><td align="left">8.42</td></tr><tr><td align="left">Testes</td><td align="left">0.15</td><td align="left">0.00</td></tr><tr><td align="left">Thymus</td><td align="left">1.17</td><td align="left">2.00</td></tr><tr><td align="left">Thyroid</td><td align="left">3.03</td><td align="left">5.71</td></tr><tr><td align="left">Tongue</td><td align="left">17.20</td><td align="left">27.20</td></tr><tr><td align="left">Tonsils</td><td align="left">17.90</td><td align="left">27.20</td></tr><tr><td align="left">Ureters</td><td align="left">0.22</td><td align="left">0.54</td></tr><tr><td align="left">Urinary bladder wall</td><td align="left">0.16</td><td align="left">0.39</td></tr><tr><td align="left">Uterus</td><td align="left">0.00</td><td align="left">0.46</td></tr><tr><td align="left">Whole body target</td><td align="left">0.78</td><td align="left">1.13</td></tr><tr><td align="left">Effective dose (&#x003bc;Sv/MBq)</td><td align="left">23.80</td><td align="left">26.00</td></tr></tbody></table></table-wrap></p></sec><sec id="Sec15"><title>Imaging of the trigeminal nerve and brain</title><p id="Par34">Superimposed on MRI images, PET data demonstrated rapid delivery of [<sup>13</sup>N]oxytocin to the turbinates and frontal regions of the nasal cavity across all four volunteers (an example is shown in Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>). Uptake in the nasal cavity was several orders of magnitude higher than in neighbouring neural structures, even at late time frames. This pronounced disparity complicated automated co-registration and may have compromised the precision of tracer localisation. Between 65 and 82% of the administered dose was retained in the nasal cavity and turbinates within the first 5&#x000a0;min after administration (see Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>), with the remainder moving to the throat or entering the bloodstream. Uptake decreased over the first 15&#x000a0;min and then stabilised. One volunteer (10.5&#x000a0;MBq dose) with pronounced right-sided rhinitis (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>) exhibited substantially lower uptake relative to the administered dose and a distinct clearance profile compared with the other three volunteers, illustrating the impact of nasal pathology on tracer retention.<fig id="Fig2"><label>Fig.&#x000a0;2</label><caption><p>[<sup>13</sup>N]oxytocin Uptake 5&#x02013;10 Minutes Post Administration [<sup>13</sup>N]oxytocin uptake 5&#x02013;10&#x000a0;min after intranasal administration of 10.5&#x000a0;MBq, superimposed on MR images in axial (bottom left), sagittal (right), and coronal (top left) planes in one volunteer. Marked radiotracer accumulation is evident in the nasal cavity and turbinates, with substantially lower uptake in adjacent structures. The pronounced contrast in uptake intensity between the nasal cavity and surrounding regions complicates automated PET&#x02013;MRI co-registration and presents challenges for accurate localisation and quantification of tracer distribution, particularly in small anatomical targets such as the trigeminal nerve and its associated ganglia. In this volunteer, a clear asymmetry in uptake between the left and right nasal cavities was observed, most likely influenced by rhinitis, which affected tracer retention</p></caption><graphic xlink:href="13550_2025_1329_Fig2_HTML" id="MO2"/></fig><fig id="Fig3"><label>Fig.&#x000a0;3</label><caption><p>Time&#x02013;Activity Curves of [<sup>13</sup>N]oxytocin Across Four Volunteers with Varying Doses Uptake of [<sup>13</sup>N]oxytocin across four healthy volunteers following intranasal administration. The top plot shows time&#x02013;activity curves (TACs) for the nasal cavity, the middle plot the trigeminal ganglia, and the bottom plot the whole brain. The x-axis in all TAC plots indicates five-minute time frames (nine in total); the y-axis denotes standardised uptake values (SUVbw). Across individuals, tracer uptake in the nasal cavity peaked within the first two to three frames (~&#x02009;10&#x02013;15&#x000a0;min), followed by a plateau, with the highest dose (17.5&#x000a0;MBq) yielding the greatest initial uptake. One volunteer (10.5&#x000a0;MBq dose) with marked right-sided rhinitis exhibited substantially reduced nasal retention and a distinct clearance profile relative to the administered dose. In the trigeminal ganglia, delayed and variable uptake patterns were observed, with no clear dose&#x02013;response relationship. Time&#x02013;activity curves for brain regions showed considerable heterogeneity: early time points in some volunteers reflected spillover from adjacent high-uptake regions, whereas others suggested delayed and potentially region-specific uptake</p></caption><graphic xlink:href="13550_2025_1329_Fig3_HTML" id="MO3"/></fig></p><p id="Par35">Time&#x02013;activity curves (TACs) for the trigeminal nerve showed final uptake values between 0.44 and 6.43 SUVbw at 40&#x02013;45&#x000a0;min, with no apparent dose&#x02013;response relationship (see Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>). TACs for brain regions indicated delayed uptake, emerging predominantly in the 25&#x02013;45&#x000a0;min window (see Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>). Two volunteers demonstrated high early spillover from neighbouring structures during the first 20&#x000a0;min, whereas one volunteer showed an early apparent increase in uptake, likely influenced by rhinitis. Across brain regions (see Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>), tracer uptake patterns were inconsistent, though there was a suggestion of a dose&#x02013;dependent trend between trigeminal nerve uptake and overall brain uptake.<fig id="Fig4"><label>Fig.&#x000a0;4</label><caption><p>Regional Distribution of [<sup>13</sup>N]oxytocin Uptake at 40&#x02013;45 Minutes Post-administration Heatmap illustrating standardised uptake values normalised to body weight (SUVbw) across brain regions at the final imaging frame (40&#x02013;45&#x000a0;min) in four volunteers receiving varying doses of [<sup>13</sup>N]oxytocin (17.5, 10.5, 1.6, and 0.98&#x000a0;MBq). Regional uptake was generally low, and no consistent pattern of tracer distribution was observed across volunteers or brain regions.</p></caption><graphic xlink:href="13550_2025_1329_Fig4_HTML" id="MO4"/></fig></p></sec></sec><sec id="Sec16"><title>Discussion</title><p id="Par36">This study explores the utility of a novel [<sup>13</sup>N]oxytocin tracer combined with intranasal administration to image oxytocin ligand and receptor distribution using PET imaging.</p><p id="Par37">Overall, the intranasal administration of PET tracers would have several potential benefits. Intranasal administration would be a non-invasive route of administration to the peripheral and CNS that would be easy to perform and would not require needles or other invasive procedures [<xref ref-type="bibr" rid="CR6">6</xref>]. Compared to other routes of administration, such as intravenous injection, the intranasal route could provide reduced systemic exposure and a lower risk of adverse effects [<xref ref-type="bibr" rid="CR12">12</xref>]. Intranasal administration of PET tracers could potentially result in a higher brain-to-blood ratio compared to other administration routes [<xref ref-type="bibr" rid="CR16">16</xref>].</p><p id="Par38">Oxytocin is frequently administered intranasally in both clinical and experimental settings, with robust evidence from animal research supporting its absorption through the nasal mucosa and subsequent transport to the brain via a trigeminal nerve pathway [<xref ref-type="bibr" rid="CR15">15</xref>, <xref ref-type="bibr" rid="CR20">20</xref>]. Although we show that [<sup>13</sup>N]oxytocin administered intranasally directly accessed the nervous system via the trigeminal and olfactory nerves, the low brain uptake observed here suggests that intranasal administration of [<sup>13</sup>N]oxytocin is not an effective route for imaging central oxytocin pathways, limiting its utility for CNS applications.</p><p id="Par39">In particular, the gene expression analysis by Quintana and coworkers provides a detailed map of oxytocin receptor distribution in the human brain, showing enrichment in subcortical and limbic structures and relatively low expression across most of the neocortex [<xref ref-type="bibr" rid="CR22">22</xref>]. Future PET studies aiming to visualise oxytocin receptor distribution should align their targeting strategies with these high-density receptor regions.</p><p id="Par40">As oxytocin is rapidly metabolised in the blood [<xref ref-type="bibr" rid="CR28">28</xref>], and has limited capacity to cross the blood&#x02013;brain barrier once in the blood [<xref ref-type="bibr" rid="CR19">19</xref>], the capacity to bypass systemic circulation and directly reach neural targets via intranasal delivery holds significant promise for therapeutic interventions that are otherwise inaccessible.</p><p id="Par41">This is the first report on the use of non-aqueous <sup>13</sup>NH<sub>3</sub> in peptide radiosynthesis. Several neural and endocrine peptides require a C-terminal alpha-amide group to gain biological activity [<xref ref-type="bibr" rid="CR4">4</xref>], and despite the short half-life of <sup>13</sup>N, it may be possible to label these molecules with the present method. Because [<sup>13</sup>N] replaces a natural nitrogen atom in an amide group, [<sup>13</sup>N]oxytocin is chemically and biologically identical to endogenous oxytocin, ensuring preserved receptor-binding properties.</p><p id="Par42">The analysis reveals that the effective dose from this tracer is at a reasonable level, comparable to that of other short-lived PET tracers, highlighting its potential for clinical application. However, the nasal passages emerge as a critical organ in this context, limiting the maximum permissible administered dose. To adhere to the general recommended safety threshold of 100&#x000a0;mSv for deterministic tissue reactions, as advised in the relevant guidelines, the dose must not exceed approximately 10&#x000a0;MBq. This precaution ensures that the radiation exposure remains within safe limits, particularly for tissues at risk of deterministic effects.</p><p id="Par43">The relatively high estimated radiation dose to the pituitary gland compared with most other tissues, including the whole brain, is likely due to its close anatomical proximity to the nasal cavity rather than direct tracer uptake. In our dosimetry model, four source organs (anterior nasal surface, posterior nasal surface, oesophageal surface, and stomach contents) accounted for more than 80% of the total signal; the remaining activity was assumed to be homogeneously distributed across other tissues, including the pituitary gland. This standard internal radiation dosimetry approach generally provides reliable effective dose estimates, and the associated radiation dose to the pituitary remains far below established thresholds for deterministic effects [<xref ref-type="bibr" rid="CR24">24</xref>].</p><p id="Par44">Our data showed that [<sup>13</sup>N]oxytocin was rapidly distributed into the nasal cavity and turbinate after administration. The frontal cavity and turbinates, which are inflamed during rhinitis, received the majority of the PET tracer. Most of the administered dose was retained in the turbinate region instead of being swallowed immediately after self-administration. Within the first few minutes after administration, the activity observed in the turbinate regions was approximately three-fourths of the independently measured administered dose. The dynamic data suggested that [<sup>13</sup>N]Oxytocin moved from the frontal cavity over the mucosa of the turbinates and then cleared toward the throat. The data also revealed that the amount of [<sup>13</sup>N]oxytocin in the turbinates area remained significant throughout 45&#x000a0;min of scan time post-administration, and the clearance rates suggested that the [<sup>13</sup>N]oxytocin would persist in those areas.</p></sec><sec id="Sec17"><title>Limitations</title><p id="Par45">Intranasal administration of [<sup>13</sup>N]oxytocin presents several potential limitations that warrant further investigation and optimisation.</p><p id="Par46">The absorption of [<sup>13</sup>N]oxytocin through the nasal mucosa varies by individual and dose, affecting the amount of tracer that reaches the trigeminal nerves, ganglia, and brain. Notably, swelling of the nasal mucosa, observed in one of our six volunteers, appeared to restrict [<sup>13</sup>N]oxytocin uptake. Despite clear nasal airflow reported by the volunteer, mucosal thickness emerged as a significant factor influencing initial tracer uptake and retention. This observation is consistent with previous findings that nasal cavity conditions can modulate the behavioural effects of intranasal oxytocin [<xref ref-type="bibr" rid="CR23">23</xref>], suggesting that further research is needed to clarify how local inflammation impacts delivery efficiency.</p><p id="Par47">Depending on the formula used, intranasal administration may by itself cause nasal irritation, potentially affecting patient compliance and limiting the frequency of dosing. Half of the participants in this study experienced an unpleasant but not painful sensation after dosing. Moreover, the volume of fluid that can be efficiently administered intranasally is limited, which might restrict the amount of PET tracer delivered to the brain. This is particularly pertinent when administering, as in our study, small amounts of radiolabelled tracer.</p><p id="Par48">The short half-life of <sup>13</sup>N (9.9&#x000a0;min) poses a significant challenge, as the optimal PET imaging window is within the tracer&#x02019;s first two to three half-lives. This narrow timeframe demands precise timing to capture meaningful data while minimising background noise and radiation exposure. Labelling with [<sup>11</sup>C] could, in principle, extend the imaging window, although a suitable synthetic route is not yet available. [<sup>1</sup>&#x02078;F] labelling, while advantageous in terms of half-life and positron range, would require substantial molecular modification, resulting in a compound that is no longer chemically identical to endogenous oxytocin and whose receptor-binding properties would need to be re-evaluated. The time it takes for oxytocin to reach the brain following intranasal administration varies across studies; however, evidence suggests that it can be relatively rapid [<xref ref-type="bibr" rid="CR21">21</xref>]. Some research indicates that oxytocin can begin to affect brain activity within approximately 15&#x000a0;min after intranasal administration, with peak levels or effects often observed within 30 to 60&#x000a0;min [<xref ref-type="bibr" rid="CR30">30</xref>]. Our imaging window of 25&#x02013;45&#x000a0;min, therefore, overlaps with the timing commonly used in behavioural studies of intranasal oxytocin, supporting ecological validity despite the low uptake observed.</p><p id="Par49">The anatomical closeness of the nasal cavity to the brain introduces potential tracer signal spillover effects, a significant challenge observed in our study, particularly at the highest and lowest administered doses. This spillover can obscure or interfere with the accurate visualisation of brain structures adjacent to the nasal region. Compared to the targeted areas, the high uptake within the nasal cavity complicates the differentiation between nasal and cerebral tracer accumulation, especially in the initial frames of the PET scan. Moreover, under these conditions, standard PET image reconstruction algorithms may not perform optimally, further complicating the accurate interpretation of the data.</p><p id="Par50">The process of co-registering PET and MRI images is markedly complicated by the substantial contrast in deposition levels between the nasal cavity, adjacent brain structures, and the trigeminal nerve. The nasal cavity exhibits several orders of magnitude higher signal levels than those observed in neighbouring brain regions. This significant disparity challenges automated co-registration techniques, undermining their effectiveness and potentially compromising the precision of tracer distribution localisation and quantification within the brain, especially in smaller regions. This difficulty in accurately aligning PET and MRI data may contribute to the challenges encountered in identifying a consistent pattern of tracer uptake across brain regions, as observed in our study, again suggesting the need for further optimization of technique.</p><p id="Par51">Newer long axial field-of-view (LAFOV) PET/CT scanners with significantly higher sensitivity may offer improvements in imaging this tracer. These advanced scanners provide better image resolution and detection capabilities, which, when combined with the routine practice of co-registering PET with brain MRI, could help mitigate some of the limitations related to dose and half-life challenges [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR27">27</xref>].</p><p id="Par52">The direct connection of the intranasal route to specific brain regions could limit the study of areas not directly linked to the trigeminal nerve ganglia, potentially narrowing the scope of research applications [<xref ref-type="bibr" rid="CR6">6</xref>]. However, these limitations, in themselves, also serve to help elucidate the mechanisms by which intranasal oxytocin might affect different psychological functions and variables.</p><p id="Par53">The efficacy of using intranasally administered [<sup>13</sup>N]oxytocin for PET imaging is influenced by several factors, including absorption variability, potential for nasal irritation, limitations of the intranasal route, and the tracer&#x02019;s short half-life. Additionally, spillover effects and co-registration challenges due to the high uptake in the nasal cavity underscore the need for careful study design. Addressing these limitations through meticulous planning and innovative imaging strategies is crucial for obtaining accurate and clinically relevant results.</p></sec><sec id="Sec18"><title>Conclusion</title><p id="Par54">This first-in-human study aimed to evaluate the feasibility, biodistribution, and dosimetry of intranasal [<sup>13</sup>N]oxytocin using PET imaging. We demonstrate that both production and intranasal administration are feasible; however, brain uptake was low and variable. These findings indicate limited suitability for CNS receptor imaging via intranasal administration, particularly for targets with slow kinetics or low receptor density, and in settings with strict limits on administered activity. Potential remains for peripheral receptor imaging after intravenous administration or for CNS targets with higher receptor density and faster kinetics. Labelling with, for example, [<sup>11</sup>C] could, in principle, extend the imaging window, although a suitable synthetic route is not yet available. Beyond dose constraints from nasal mucosal exposure, quantification is further challenged by spillover from the nasal cavity, where activity levels are 2&#x02013;3 orders of magnitude higher than in adjacent brain tissue. However, future methodological refinements may help mitigate these effects and improve CNS quantification.</p></sec></body><back><glossary><title>Abbreviations</title><def-list><def-item><term>BOC</term><def><p id="Par5">Tert-Butyloxycarbonyl</p></def></def-item><def-item><term>CNS</term><def><p id="Par6">Central nervous system</p></def></def-item><def-item><term>HPLC</term><def><p id="Par7">High-Performance liquid chromatography</p></def></def-item><def-item><term>MRI</term><def><p id="Par8">Magnetic resonance imaging</p></def></def-item><def-item><term>PET</term><def><p id="Par9">Positron emission tomography</p></def></def-item><def-item><term>ROI</term><def><p id="Par10">Region of interest</p></def></def-item><def-item><term>SUV</term><def><p id="Par11">Standard uptake value</p></def></def-item><def-item><term>VOI</term><def><p id="Par12">Volume of interest</p></def></def-item></def-list></glossary><fn-group><fn><p><bold>Publisher's Note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn></fn-group><ack><title>Acknowledgements</title><p>We thank Margit Haislund and Louise Forsmann Gr&#x000f8;nnemark for their technical assistance during the experiments and Professor Paul J. Zak for his valuable advice and encouragement.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>MW, SJ, ENN, and DY initiated the study. SJ and ENN developed and produced the PET tracer. MHV recruited volunteers, while MHV and AHD supervised image acquisition and patient safety. SBH conducted biodistribution and radiation dosimetry. DY provided consultation throughout the study. MW managed the project, analysed the images, and drafted the initial manuscript. All authors contributed to manuscript editing and approved the final version.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>This project was funded by Aarhus University and Tonix Pharmaceuticals.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>The data supporting the findings of this study are available from the corresponding author upon reasonable request.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par55">The study was approved by the Ethics Committee of the Central Denmark Region (case number 77797). All participants provided written informed consent prior to participation. All procedures were conducted in accordance with the Declaration of Helsinki.</p></notes><notes id="FPar2"><title>Consent for publication</title><p id="Par56">Not applicable.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests</title><p id="Par57">David Yeomans is a consultant for Tonix Pharmaceuticals. The remaining authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Alberts</surname><given-names>I</given-names></name><name><surname>Sari</surname><given-names>H</given-names></name><name><surname>Mingels</surname><given-names>C</given-names></name><name><surname>Afshar-Oromieh</surname><given-names>A</given-names></name><name><surname>Pyka</surname><given-names>T</given-names></name><name><surname>Shi</surname><given-names>K</given-names></name><etal/></person-group><article-title>Long-axial field-of-view PET/CT: perspectives and review of a revolutionary development in nuclear medicine based on clinical experience in over 7000 patients</article-title><source>Cancer Imaging</source><year>2023</year><volume>23</volume><issue>1</issue><fpage>28</fpage><pub-id pub-id-type="doi">10.1186/s40644-023-00540-3</pub-id><pub-id pub-id-type="pmid">36934273</pub-id>

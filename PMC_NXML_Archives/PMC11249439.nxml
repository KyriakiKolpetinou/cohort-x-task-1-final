<article-id pub-id-type="publisher-id">3411</article-id><article-id pub-id-type="doi">10.1007/s12094-024-03411-w</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group></article-categories><title-group><article-title>Hypertension as predictive factor for bevacizumab-containing first-line therapy in metastatic breast and colorectal cancer in BRECOL (GEICAM/2011-04) study</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-6823-5290</contrib-id><name><surname>Rodr&#x000ed;guez-Lescure</surname><given-names>&#x000c1;lvaro</given-names></name><address><email>alescure@geicam.org</email></address><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Gallego</surname><given-names>Javier</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Garcia-Alfonso</surname><given-names>Pilar</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Massuti</surname><given-names>Bartomeu</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>M&#x000e1;rquez</surname><given-names>Ra&#x000fa;l</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Calvo</surname><given-names>Lourdes</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>S&#x000e1;nchez-Rovira</surname><given-names>Pedro</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff7">7</xref></contrib><contrib contrib-type="author"><name><surname>Ant&#x000f3;n</surname><given-names>Antonio</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff8">8</xref></contrib><contrib contrib-type="author"><name><surname>Chac&#x000f3;n</surname><given-names>Jos&#x000e9; Ignacio</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff9">9</xref></contrib><contrib contrib-type="author"><name><surname>Ciruelos</surname><given-names>Eva</given-names></name><xref ref-type="aff" rid="Aff10">10</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Ponce</surname><given-names>Jose Juan</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Santaballa</surname><given-names>Ana</given-names></name><xref ref-type="aff" rid="Aff11">11</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Valladares-Ayerbes</surname><given-names>Manuel</given-names></name><xref ref-type="aff" rid="Aff12">12</xref><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Due&#x000f1;as</surname><given-names>Mar&#x000ed;a Rosario</given-names></name><xref ref-type="aff" rid="Aff7">7</xref></contrib><contrib contrib-type="author"><name><surname>Alonso</surname><given-names>Vicente</given-names></name><xref ref-type="aff" rid="Aff8">8</xref></contrib><contrib contrib-type="author"><name><surname>Aparicio</surname><given-names>Jorge</given-names></name><xref ref-type="aff" rid="Aff11">11</xref></contrib><contrib contrib-type="author"><name><surname>Encinas</surname><given-names>Sara</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Robles</surname><given-names>Luis</given-names></name><xref ref-type="aff" rid="Aff10">10</xref></contrib><contrib contrib-type="author"><name><surname>Escudero</surname><given-names>Mar&#x000ed;a Jos&#x000e9;</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Caballero</surname><given-names>Rosal&#x000ed;a</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Bezares</surname><given-names>Susana</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Garc&#x000ed;a-Ortiz</surname><given-names>Mar&#x000ed;a Victoria</given-names></name><xref ref-type="aff" rid="Aff15">15</xref><xref ref-type="aff" rid="Aff16">16</xref><xref ref-type="aff" rid="Aff17">17</xref></contrib><contrib contrib-type="author"><name><surname>Morales-Ruiz</surname><given-names>Teresa</given-names></name><xref ref-type="aff" rid="Aff15">15</xref><xref ref-type="aff" rid="Aff18">18</xref><xref ref-type="aff" rid="Aff19">19</xref></contrib><contrib contrib-type="author"><name><surname>de la Haba-Rodriguez</surname><given-names>Juan</given-names></name><xref ref-type="aff" rid="Aff13">13</xref><xref ref-type="aff" rid="Aff14">14</xref><xref ref-type="aff" rid="Aff2">2</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01jmsem62</institution-id><institution-id institution-id-type="GRID">grid.411093.e</institution-id><institution-id institution-id-type="ISNI">0000 0004 0399 7977</institution-id><institution>Medical Oncology Department, </institution><institution>Hospital General Universitario de Elche, </institution></institution-wrap>Carrer Almazara, 11, 03203 Elche, Alicante Spain </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05ygm7711</institution-id><institution-id institution-id-type="GRID">grid.430580.a</institution-id><institution>GEICAM Spanish Breast Cancer Group, </institution></institution-wrap>Madrid, Spain </aff><aff id="Aff3"><label>3</label><institution-wr
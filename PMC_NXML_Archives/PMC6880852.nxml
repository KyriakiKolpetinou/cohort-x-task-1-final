<article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="research-article"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">Rheumatology (Oxford)</journal-id><journal-id journal-id-type="iso-abbrev">Rheumatology (Oxford)</journal-id><journal-id journal-id-type="publisher-id">brheum</journal-id><journal-title-group><journal-title>Rheumatology (Oxford, England)</journal-title></journal-title-group><issn pub-type="ppub">1462-0324</issn><issn pub-type="epub">1462-0332</issn><publisher><publisher-name>Oxford University Press</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">31184752</article-id><article-id pub-id-type="pmc">6880852</article-id><article-id pub-id-type="doi">10.1093/rheumatology/kez152</article-id><article-id pub-id-type="publisher-id">kez152</article-id><article-categories><subj-group subj-group-type="heading"><subject>Clinical Science</subject></subj-group></article-categories><title-group><article-title>Efficacy and safety of switching from rituximab to biosimilar CT-P10 in rheumatoid arthritis: 72-week data from a randomized Phase 3 trial</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Shim</surname><given-names>Seung Cheol</given-names></name><xref ref-type="aff" rid="kez152-aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Bo&#x0017e;i&#x00107;-Majstorovi&#x00107;</surname><given-names>Ljubinka</given-names></name><xref ref-type="aff" rid="kez152-aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Berrocal Kasay</surname><given-names>Alfredo</given-names></name><xref ref-type="aff" rid="kez152-aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>El-Khouri</surname><given-names>Elias Chalouhi</given-names></name><xref ref-type="aff" rid="kez152-aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Irazoque-Palazuelos</surname><given-names>Fedra</given-names></name><xref ref-type="aff" rid="kez152-aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Cons Molina</surname><given-names>Francisco Fidencio</given-names></name><xref ref-type="aff" rid="kez152-aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Medina-Rodriguez</surname><given-names>Francisco G</given-names></name><xref ref-type="aff" rid="kez152-aff7">7</xref></contrib><contrib contrib-type="author"><name><surname>Miranda</surname><given-names>Pedro</given-names></name><xref ref-type="aff" rid="kez152-aff8">8</xref></contrib><contrib contrib-type="author"><name><surname>Shesternya</surname><given-names>Pavel</given-names></name><xref ref-type="aff" rid="kez152-aff9">9</xref></contrib><contrib contrib-type="author"><name><surname>Chavez-Corrales</surname><given-names>Jose</given-names></name><xref ref-type="aff" rid="kez152-aff10">10</xref></contrib><contrib contrib-type="author"><name><surname>Wiland</surname><given-names>Piotr</given-names></name><xref ref-type="aff" rid="kez152-aff11">11</xref></contrib><contrib contrib-type="author"><name><surname>Jeka</surname><given-names>Slawomir</given-names></name><xref ref-type="aff" rid="kez152-aff12">12</xref></contrib><contrib contrib-type="author"><name><surname>Garmish</surname><given-names>Olena</given-names></name><xref ref-type="aff" rid="kez152-aff13">13</xref></contrib><contrib contrib-type="author"><name><surname>Hrycaj</surname><given-names>Pawel</given-names></name><xref ref-type="aff" rid="kez152-aff14">14</xref></contrib><contrib contrib-type="author"><name><surname>Fomina</surname><given-names>Natalia</given-names></name><xref ref-type="aff" rid="kez152-aff15">15</xref></contrib><contrib contrib-type="author"><name><surname>Park</surname><given-names>Won</given-names></name><xref ref-type="aff" rid="kez152-aff16">16</xref></contrib><contrib contrib-type="author"><name><surname>Suh</surname><given-names>Chang-Hee</given-names></name><xref ref-type="aff" rid="kez152-aff17">17</xref></contrib><contrib contrib-type="author"><name><surname>Lee</surname><given-names>Sang Joon</given-names></name><xref ref-type="aff" rid="kez152-aff18">18</xref></contrib><contrib contrib-type="author"><name><surname>Lee</surname><given-names>Sung Young</given-names></name><xref ref-type="aff" rid="kez152-aff18">18</xref></contrib><contrib contrib-type="author"><name><surname>Bae</surname><given-names>Yun Ju</given-names></name><xref ref-type="aff" rid="kez152-aff18">18</xref></contrib><contrib contrib-type="author"><name><surname>Yoo</surname><given-names>Dae Hyun</given-names></name><xref ref-type="corresp" rid="kez152-cor1"/><xref ref-type="aff" rid="kez152-aff19">19</xref><!--<email>dhyoo@hanyang.ac.kr</email>--></contrib></contrib-group><aff id="kez152-aff1"><label>1</label>

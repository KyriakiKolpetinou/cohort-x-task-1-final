</td><td align="center">37</td><td align="left"/><td align="left"/><td align="left"/><td align="left"/></tr><tr><td align="left">Mean</td><td align="center"/><td align="left">1.4</td><td align="left">
<inline-formula id="IEq66"><alternatives><tex-math id="M133">\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}

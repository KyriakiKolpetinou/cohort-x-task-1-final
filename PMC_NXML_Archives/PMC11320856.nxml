</mixed-citation></citation-alternatives></ref><ref id="CR5"><label>5.</label><citation-alternatives><element-citation id="ec-CR5" publication-type="journal"><person-group person-group-type="author"><name><surname>Sun</surname><given-names>BL</given-names></name><name><surname>Li</surname><given-names>WW</given-names></name><name><surname>Zhu</surname><given-names>C</given-names></name><name><surname>Jin</surname><given-names>WS</given-names></name><name><surname>Zeng</surname><given-names>F</given-names></name><name><surname>Liu</surname><given-names>YH</given-names></name><etal/></person-group><article-title>Clinical Research on Alzheimer&#x02019;s Disease: Progress and perspectives</article-title><source>Neurosci Bull</source><year>2018</year><volume>34</volume><issue>6</issue><fpage>1111</fpage><lpage>8</lpage><pub-id pub-id-type="doi">10.1007/s12264-018-0249-z</pub-id><pub-id pub-id-type="pmid">29956105</pub-id>

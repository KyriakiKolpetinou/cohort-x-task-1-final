</element-citation><mixed-citation id="mc-CR13" publication-type="journal">Knipper, M. et al. Thyroid hormone deficiency before the onset of hearing causes irreversible damage to peripheral and central auditory systems. <italic>J. Neurophysiol.</italic><bold>83</bold>, 3101&#x02013;3112 (2000).<pub-id pub-id-type="pmid">10805704</pub-id>
</mixed-citation></citation-alternatives></ref><ref id="CR14"><label>14.</label><citation-alternatives><element-citation id="ec-CR14" publication-type="journal"><person-group person-group-type="author"><name><surname>Wada</surname><given-names>H</given-names></name><name><surname>Yumoto</surname><given-names>S</given-names></name><name><surname>Iso</surname><given-names>H</given-names></name></person-group><article-title>Irreversible damages to auditory system functions caused by perinatal hypothyroidism in rats</article-title><source>Neurotoxicol. Teratol.</source><year>2013</year><volume>37</volume><fpage>18</fpage><lpage>22</lpage><pub-id pub-id-type="pmid">23422508</pub-id>
</element-citation><mixed-citation id="mc-CR14" publication-type="journal">Wada, H., Yumoto, S. &#x00026; Iso, H. Irreversible damages to auditory system functions caused by perinatal hypothyroidism in rats. <italic>Neurotoxicol. Teratol.</italic><bold>37</bold>, 18&#x02013;22 (2013).<pub-id pub-id-type="pmid">23422508</pub-id>

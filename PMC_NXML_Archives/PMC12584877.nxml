</td><td align="center" rowspan="1" colspan="1">Japan</td><td align="center" rowspan="1" colspan="1">68 (60&#x02013;71)</td><td align="center" rowspan="1" colspan="1">12 (60%)</td><td align="center" rowspan="1" colspan="1">277 (99&#x02013;466)</td><td align="center" rowspan="1" colspan="1">100%</td><td align="center" rowspan="1" colspan="1">2 (2&#x02013;2)</td><td align="center" rowspan="1" colspan="1">

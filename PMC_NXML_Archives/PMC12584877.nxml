</td><td align="center" rowspan="1" colspan="1">Italy</td><td align="center" rowspan="1" colspan="1">56.6 &#x000b1; 18.3</td><td align="center" rowspan="1" colspan="1">31 (79.5%)</td><td align="center" rowspan="1" colspan="1">302 (58&#x02013;1640)</td><td align="center" rowspan="1" colspan="1">26 (66.6%)</td><td align="center" rowspan="1" colspan="1">2 (2&#x02013;2)</td><td align="center" rowspan="1" colspan="1">
<p>2 (5.1%)/</p>

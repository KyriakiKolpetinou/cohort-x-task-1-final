 align="center" rowspan="1" colspan="1">89.5</td><td align="center" rowspan="1" colspan="1">65.9</td><td align="center" rowspan="1" colspan="1">75.8</td><td align="center" rowspan="1" colspan="1">59.3</td><td align="center" rowspan="1" colspan="1">57.4</td><td align="center" rowspan="1" colspan="1">59.7</td></tr><tr><td align="left" rowspan="1" colspan="1">6</td><td align="center" rowspan="1" colspan="1">10+0, 10+4</td><td align="center" rowspan="1" colspan="1">31.7</td><td align="center" rowspan="1" colspan="1">107.3</td><td align="center" rowspan="1" colspan="1">89.8</td><td align="center" rowspan="1" colspan="1">62.3</td><td align="center" rowspan="1" colspan="1">72.3</td><td align="center" rowspan="1" colspan="1">69.8</td><td align="center" rowspan="1" colspan="1">54.8</td><td align="center" rowspan="1" colspan="1">70.7</td></tr><tr><td align="left" rowspan="1" colspan="1">7<sup>*</sup></td><td align="center" rowspan="1" colspan="1">10+0, 10+0, 10+0</td><td align="center" rowspan="1" colspan="1">18.9</td><td align="center" rowspan="1" colspan="1">52.5</td><td align="center" rowspan="1" colspan="1">65.4</td><td align="center" rowspan="1" colspan="1">28.9</td><td align="center" rowspan="1" colspan="1">30.1</td><td align="center" rowspan="1" colspan="1">33.2</td><td align="center" rowspan="1" colspan="1">3.5</td><td align="center" rowspan="1" colspan="1">6.7</td></tr><tr><td align="left" rowspan="1" colspan="1">8</td><td align="center" rowspan="1" colspan="1">10+0, 10+0, 10+3</td><td align="center" rowspan="1" colspan="1">9.4</td><td align="center" rowspan="1" colspan="1">40.1</td><td align="center" rowspan="1" colspan="1">100.9</td><td align="center" rowspan="1" colspan="1">69.6</td><td align="center" rowspan="1" colspan="1">68.2</td><td align="center" rowspan="1" colspan="1">61.1</td><td align="center" rowspan="1" colspan="1">62.0</td><td align="center" rowspan="1" colspan="1">58.0</td></tr><tr><td align="left" rowspan="1" colspan="1">9</td><td align="center" row
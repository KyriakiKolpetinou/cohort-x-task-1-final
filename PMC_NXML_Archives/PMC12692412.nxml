lign="middle" rowspan="1" colspan="1">38 (47.5%)</td><td align="left" valign="middle" rowspan="1" colspan="1">27 (44.3%)</td><td align="left" valign="middle" rowspan="1" colspan="1">65 (46.2%)</td></tr><tr><td align="left" valign="middle" rowspan="1" colspan="1">Rural</td><td align="left" valign="middle" rowspan="1" colspan="1">22 (27.5%)</td><td align="left" valign="middle" rowspan="1" colspan="1">20 (32.8%)</td><td align="left" valign="middle" rowspan="1" colspan="1">42 (29.9%)</td></tr><tr><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">Suburban</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">20 (25.0%)</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">14 (23.0%)</td><td align="left" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">34 (23.9%)</td></tr></tbody></table><table-wrap-foot><fn><p>Family history of PCa was present in 4.6%, while 8.6% reported BRCa, 2.5% OVCa, 4.6% BLCa, and 3.0% gastrointestinal can GIT Ca (in relatives).</p></fn></table-wrap-foot></table-wrap><table-wrap position="float" id="healthcare-13-03135-t002"><object-id pub-id-type="pii">healthcare-13-03135-t002_Table 2</object-id><label>Table 2</label><caption><p>Baseline knowledge, attitudes, and perceptions (KAP) by sociodemographic and lifestyle factors.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" valign="middle" style="border-top:solid thin;border-bottom:solid thin" rowspan="1" colspan="1">Variable</th><th align="left" valign="middle" style="border-top:solid thin;border-bottom:solid thin" rowspan="1" colspan="1">Subgroup</th><th align="center" valign="middle" style="border-top:solid thin;border-bottom:solid thin" rowspan="1" colspan="1">Good Knowledge %</th><th align="center" valign="middle" style="border-top:solid thin;border-bottom:solid thin" rowspan="1" colspan="1">Poor Knowledge %</th><th align="ce
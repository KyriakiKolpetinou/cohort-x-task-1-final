<article-meta><article-id pub-id-type="pmid">41299304</article-id><article-id pub-id-type="pmc">12659085</article-id>
<article-id pub-id-type="publisher-id">4610</article-id><article-id pub-id-type="doi">10.1186/s12882-025-04610-5</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>Fluoroscopy-free insertion of tunneled hemodialysis catheters: ensuring safety and precision &#x02013; a retrospective observational study</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0001-8046-4179</contrib-id><name><surname>Kakareko</surname><given-names>Katarzyna</given-names></name><address><email>katarzyna.kakareko@umb.edu.pl</email></address><xref ref-type="aff" rid="Aff1"/></contrib><contrib contrib-type="author"><name><surname>Kwiatkowska</surname><given-names>Kinga</given-names></name><xref ref-type="aff" rid="Aff1"/></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-8126-3085</contrib-id><name><surname>Rydzewska-Rosolowska</surname><given-names>Alicja</given-names></name><xref ref-type="aff" rid="Aff1"/></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-4701-8422</contrib-id><name><surname>Glowinska</surname><given-names>Irena</given-names></name><xref ref-type="aff" rid="Aff1"/></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-0145-3103</contrib-id><name><surname>Hryszko</surname><given-names>Tomasz</given-names></name><xref ref-type="aff" rid="Aff1"/></contrib><aff id="Aff1"><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/00y4ya841</institution-id><institution-id institution-id-type="GRID">grid.48324.39</institution-id><institution-id institution-id-type="ISNI">0000 0001 2248 2838</institution-id><institution>2nd Department of Nephrology, Hypertension and Internal Medicine with Dialysis Unit, </institution><institution>Medical University of Bialystok, </institution></institution-wrap>Sklodowskiej-Curie 24A, Bialystok, 15-276 Poland </aff></contrib-group><pub-date pub-type="epub"><day>26</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>26</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>26</volume><elocation-id>672</elocation-id><history><date date-type="received"><day>28</day><month>7</month><year>2025</year></date><date date-type="accepted"><day>4</day><month>11</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1" abstract-type="structured"><sec><title>Background</title><p id="Par1">Reliable vascular access is essential for hemodialysis. While arteriovenous fistulas are preferred for long-term use, tunneled hemodialysis catheters (TDCs) remain necessary, especially in urgent settings or when fistula creation is not feasible. Fluoroscopy is traditionally used to confirm catheter tip placement, but limited access and higher costs can be barriers. This study evaluated the safety and feasibility of fluoroscopy-free TDC placement using ultrasound and anatomical landmarks.</p></sec><sec><title>Methods</title><p id="Par2">We performed a retrospective analysis of 266 TDC insertions between 2018 and 2023 at a single center. All procedures were ultrasound-guided with landmark-based planning. Post-procedural imaging verified tip position, and any malposition prompted immediate repositioning. Data collected included insertion site, patient demographics, incident vs. prevalent dialysis status, complications, and need for repositioning.</p></sec><sec><title>Results</title><p id="Par3">The median patient age was 65&#x02009;&#x000b1;&#x02009;15 years, with 58% male. Most catheters were placed via the internal jugular vein (91.7%; 223 right, 21 left). Femoral access was used in 7.9% and subclavian in one case. Bleeding complications were infrequent and occurred in 4% of cases. There was also a single instance of inadvertent carotid artery puncture, successfully managed without major intervention. Tip repositioning was required in 11% of internal jugular placements; repositioning assessment was not applicable for femoral access. Comparative analysis showed no significant differences in bleeding rates or need for repositioning between right and left internal jugular vein insertions.</p></sec><sec><title>Conclusions</title><p id="Par4">Ultrasound and landmark-guided TDC placement without fluoroscopy proved safe and effective, with low complication rates and reliable function. These findings support fluoroscopy-free approaches as practical alternatives, especially in settings with limited imaging access.</p></sec><sec><title>Clinical trial number</title><p id="Par5">Not applicable.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Catheter tip position</kwd><kwd>Hemodialysis</kwd><kwd>Interventional nephrology</kwd><kwd>Tunneled central venous catheter</kwd><kwd>Ultrasound-guided placement</kwd><kwd>Vascular access</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; BioMed Central Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par6">The creation of proper vascular access for hemodialysis is a fundamental component of renal replacement therapy. Arteriovenous fistulas continue to be considered the preferred form of vascular access because they offer the lowest complication rates and superior long-term durability [<xref ref-type="bibr" rid="CR1">1</xref>]. Nevertheless, central venous catheters are frequently employed when creating an arteriovenous fistula is not feasible for clinical or anatomical reasons. Tunneled hemodialysis catheters are particularly important in urgent situations, such as when patients initiate dialysis unexpectedly without prior preparation or an established ESKD life-plan. According to KDOQI guidelines, if catheter use is expected to exceed three weeks, a tunneled dialysis catheter is recommended to reduce risks associated with prolonged catheter dependence. Current guidelines recommend that access procedures be conducted using imaging techniques to verify the catheter tip&#x02019;s placement, which should ideally be located in the right atrium to optimize function and reduce complications [<xref ref-type="bibr" rid="CR1">1</xref>]. Fluoroscopy, commonly favored in the United States [<xref ref-type="bibr" rid="CR1">1</xref>], is one method of verification offering real-time visualization, but it presents certain drawbacks, such as radiation exposure [<xref ref-type="bibr" rid="CR2">2</xref>] and the high costs associated with the necessary equipment and infrastructure [<xref ref-type="bibr" rid="CR3">3</xref>].</p><p id="Par7">In the past, due to the limited availability of fluoroscopy in Poland, alternative methods such as ultrasound guidance and anatomical landmark techniques were widely adopted. As a result, practitioners have developed substantial experience performing these procedures without fluoroscopic assistance, even in urgent or critically ill patients. Despite this widespread practice, there is limited local data assessing complication rates, such as malposition and bleeding, or evaluating the accuracy of catheter tip positioning without fluoroscopy. Moreover, it remains unclear whether certain patient or procedural factors might predispose to complications when fluoroscopy is not used.</p><p id="Par8">Given these gaps, we undertook a retrospective analysis of our center&#x02019;s experience to evaluate the safety and effectiveness of ultrasound and anatomical landmark-guided tunneled hemodialysis catheter insertions without fluoroscopy. Our goal was to assess complication rates and tip positioning accuracy using post-procedural imaging and clinical outcomes, while also exploring potential risk factors for adverse events in this context.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Study design</title><p id="Par9">This study is a retrospective observational analysis of tunneled hemodialysis catheter placements performed at our department between January 2018 and January 2023. The primary objective was to evaluate the safety and accuracy of catheter insertion without fluoroscopic guidance, with particular attention to complication rates and catheter tip positioning. The study was approved by local ethics committee (approval no. APK.002.275.2024).</p></sec><sec id="Sec4"><title>Procedure</title><p id="Par10">In our center, tunneled hemodialysis catheters are inserted by nephrologists in a dedicated procedure room using a standardized, sterile technique with local anesthesia. The procedure is performed on an adjustable procedure table that allows positioning of the patient in the Trendelenburg position.</p><p id="Par11">With the patient in the supine position, the planned catheter is laid over the chest to estimate the required intravascular length and tunnel trajectory. The catheter tip is aligned approximately 5&#x02013;7&#x000a0;cm above the xiphoid process along the midline depending on the patient&#x02019;s height, corresponding to the target position in the right atrium (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>). The body of the catheter is then positioned on the patient&#x02019;s chest following the intended subcutaneous tunnel path. Based on this planned course, the optimal exit site on the anterior chest wall is marked. In patients with markedly increased anteroposterior chest dimension, this initial surface measurement may underestimate the true course, as the tip tends to lie higher; therefore, we adjust the estimated length accordingly during planning.</p><p id="Par12">Ultrasound guidance is employed routinely to identify and puncture the target vein, minimizing the risk of arterial injury and ensuring optimal vessel selection. In our practice, ultrasound is used exclusively for venipuncture and not for confirmation of the final catheter tip position, which is instead verified by post-procedural radiography.</p><p id="Par13">A linear probe, enclosed in a sterile sleeve, is used to visualize the anatomy, confirm venous patency, and detect potential stenosis or thrombus prior to puncture. Puncture is performed under real-time ultrasound visualization using the out-of-plane approach, allowing continuous monitoring of the needle tip during advancement to minimize the risk of arterial injury and optimize placement accuracy.</p><p id="Par14">A modified Seldinger technique is used for guidewire placement. After venous puncture under real-time ultrasound, serial dilators and peel-away sheaths are employed to facilitate catheter introduction while maintaining guidewire position.</p><p id="Par15">For tunneled catheter placement, a subcutaneous tunnel is created from the exit site on the anterior chest to the venous entry point with a smooth curvature to avoid sharp angulation of the catheter. The catheter is advanced using the antegrade technique through the tunnel and introduced over the guidewire into the vein.</p><p id="Par16">Immediately following catheter insertion, a post-procedural chest radiograph in two projections (posteroanterior and lateral) is routinely obtained to confirm correct tip positioning in the right atrium. Radiological verification in our center relies on the tracheal carina as the primary anatomical landmark. The ideal tip location corresponds to the cavoatrial junction, typically situated about 3&#x02013;5 cm below the carina, with the lower third of the superior vena cava extending approximately 3 cm inferior to this point [<xref ref-type="bibr" rid="CR4">4</xref>, <xref ref-type="bibr" rid="CR5">5</xref>]. The lateral view is particularly important for excluding malposition of the catheter into the azygos vein or other aberrant locations [<xref ref-type="bibr" rid="CR6">6</xref>]. If malposition is identified, prompt catheter repositioning is performed, followed by repeat imaging to ensure proper placement before use.</p><p id="Par17">The preferred access order in our practice is the right internal jugular vein, followed by the left internal jugular vein if needed. This preference is based on the more direct anatomical course of the right internal jugular vein to the superior vena cava and right atrium, which facilitates accurate catheter positioning and lowers the risk of complications [<xref ref-type="bibr" rid="CR1">1</xref>]. Evidence also indicates that right-sided insertions are associated with fewer catheter-related infections and a lower likelihood of dysfunction compared to left-sided approaches [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR7">7</xref>]. The femoral vein is used as an alternative when upper body access is not feasible, while the subclavian vein is considered a last resort due to its higher risk of stenosis. In our center ultrasound guidance is used for venipuncture at all access sites to improve safety and accuracy, whereas post-procedural X-ray is not routinely performed after femoral vein catheter placement.</p><p id="Par18">
<fig id="Fig1"><label>Fig. 1</label><caption><p>Demonstrative planning of tunneled catheter placement using anatomical landmarks. The image was obtained for educational purposes, without sterile draping, to better visualize anatomical reference points. The letter &#x02018;A&#x02019; marks the xiphoid process, while the double-headed arrow indicates the distance of 5&#x02013;7&#x000a0;cm above the xiphoid along the midline, corresponding to the estimated target position of the catheter tip in the right atrium. The catheter body is aligned over the chest to outline the subcutaneous tunnel and to identify the optimal exit site</p></caption><graphic xlink:href="12882_2025_4610_Fig1_HTML" id="d33e245"/></fig>
</p></sec><sec id="Sec5"><title>Study population</title><p id="Par19">The study population included all patients who underwent tunneled hemodialysis catheter insertion at our institution during the study period. Patients were identified through institutional procedure logs and electronic medical records.</p></sec><sec id="Sec6"><title>Exclusion criteria</title><p id="Par20">Patients were excluded if they required fluoroscopy (C-arm imaging) for successful catheter placement due to complex vascular anatomy or a history of previous complications necessitating imaging guidance. This included cases with prior failed attempts at fluoroscopy-free catheter insertion, patients with documented central venous stenosis or thrombosis on CT angiography, and those with a history of vascular interventions suggesting altered anatomy.</p></sec><sec id="Sec7"><title>Data collection</title><p id="Par21">Data were collected retrospectively from electronic health records and procedure documentation. Variables extracted included:</p><p id="Par22">
<list list-type="bullet"><list-item><p id="Par23">Insertion site: right or left internal jugular vein, subclavian vein, or femoral vein.</p></list-item><list-item><p id="Par24">Catheter tip position: assessment of post-procedural imaging (chest X-ray) confirming whether the tip was correctly positioned in the right atrium.</p></list-item><list-item><p id="Par25">Repositioning: whether the catheter required repositioning or replacement due to malposition after initial placement.</p></list-item><list-item><p id="Par26">Incident or prevalent hemodialysis status: classification of patients as incident (newly starting hemodialysis) or prevalent (already receiving maintenance hemodialysis) at the time of catheter placement [<xref ref-type="bibr" rid="CR1">1</xref>].</p></list-item><list-item><p id="Par27">Complications: documentation of bleeding events during or after the procedure, as well as major complications such as air embolism, pneumothorax, hemothorax, inadvertent arterial puncture, or procedure-related arrhythmias.</p></list-item></list>
</p></sec><sec id="Sec8"><title>Data analysis</title><p id="Par28">Descriptive statistics are used to summarize the study variables. Categorical data such as insertion site, catheter history, and complication types are presented as frequencies and percentages. Continuous variables such as patient age are summarized using means and standard deviations or medians and interquartile ranges if data are not normally distributed.</p><p id="Par29">The incidence of complications was compared across insertion sites and catheter histories (first vs. subsequent placement). Chi-square tests (or Fisher&#x02019;s exact tests when appropriate) were used to assess associations between categorical variables and complications. For continuous variables, independent samples t-tests or Mann-Whitney U tests were applied to compare groups with and without complications. All analyses were conducted using standard statistical software (Stata, version 18, StataCorp, College Station, TX, USA), with a significance level set at <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.05.</p></sec></sec><sec id="Sec9"><title>Results</title><sec id="Sec10"><title>Study population</title><p id="Par30">A total of 266 tunneled hemodialysis catheter insertion procedures were analyzed. The median age of patients was 65 years (&#x000b1;15), and 58% of the cohort were male (<italic>n</italic>&#x02009;=&#x02009;155). Comorbid conditions were frequent, with diabetes mellitus reported in 35% of patients, chronic heart failure in 36%, and ischemic heart disease in 20% (data presented in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>).</p><p id="Par31">Catheters were primarily inserted via the internal jugular vein, which accounted for 244 of 266 placements (91.7%), with right-sided placement heavily favored (223 right vs. 21 left). Femoral vein access was used in 21 cases (7.9%), while the subclavian vein was used only once (0.4%).</p><p id="Par32">All catheters were subsequently assessed for function and successfully used to deliver effective hemodialysis treatments, defined in our unit as achieving blood flow rates above 300&#x000a0;ml/min, thereby confirming the clinical utility of placements performed.</p><p id="Par33">During the same study period, 40 tunneled catheters were inserted under fluoroscopic guidance in patients requiring imaging support due to complex vascular anatomy or previous access complications.</p></sec><sec id="Sec11"><title>Incident vs. prevalent Hemodialysis patients</title><p id="Par34">Among the 266 procedures analyzed, 130 (49%) were performed in incident hemodialysis patients and 136 (51%) in prevalent patients. Bleeding complications occurred in 7 incident cases (5.4%) and 3 prevalent cases (2.2%), with no statistically significant difference observed between groups (<italic>p</italic>&#x02009;=&#x02009;0.21).</p><p id="Par35">Catheter tip repositioning was required in 13 incident patients (10.0%) and 14 prevalent patients (10.3%), similarly showing no significant difference (<italic>p</italic>&#x02009;=&#x02009;0.9).</p></sec><sec id="Sec12"><title>Procedural outcomes and tip positioning</title><p id="Par36">Catheter tip repositioning was assessed only for insertions into the internal jugular and subclavian veins, as post-procedural chest radiography was not routinely performed after femoral vein access. Among these cases, repositioning was required in 11% overall (27/245), based on post-procedural chest X-ray. In all cases, repositioning was achieved by gentle withdrawal of the catheter under sterile conditions to adjust tip position, without the need for surgical revision or catheter replacement. For internal jugular vein insertions, repositioning was necessary in 11% of procedures (27/244), whereas the single subclavian vein case did not require adjustment (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>).</p></sec><sec id="Sec13"><title>Complications</title><p id="Par37">Complications were infrequent overall. Prolonged bleeding occurred in 10 patients (4%). Among these, 4 required a single blood transfusion (mean 1.75 units of packed red blood cells). In total, 5 of these bleeding episodes resulted in prolonged hospitalization (up to 48&#x000a0;h, primarily due to transfusion requirements). The remaining 6 cases were managed with minor additional measures, such as extra dressings or sutures. There was one instance of inadvertent carotid artery puncture, which was managed conservatively without the need for major intervention. No cases of severe hemorrhage requiring surgical intervention were recorded. Importantly, no cases of air embolism, pneumothorax, hemothorax, or procedure-related arrhythmias were observed across the entire cohort (Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>).</p><p id="Par38">Analysis of bleeding by insertion site revealed similar rates: 4% among internal jugular vein insertions (9/244) and 5% among femoral vein insertions (1/21), with no bleeding events in the single subclavian vein placement (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). Due to the presence of only one subclavian insertion, this site was excluded from the statistical analysis. Statistical comparison between internal jugular and femoral sites did not indicate a significant difference in bleeding rates.</p><p id="Par39">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Characteristics of the study population</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Characteristic</th><th align="left">All<break/>(<italic>n</italic>&#x02009;=&#x02009;266)</th></tr></thead><tbody><tr><td align="left">Demographics</td><td align="left"/></tr><tr><td align="left"><p>Age years median (SD)</p><p>Sex (M/F), n (%)</p></td><td align="left"><p>65&#x000b1;15</p><p>155/111 (58/42)</p></td></tr><tr><td align="left">Comorbidities, n (%)</td><td align="left"/></tr><tr><td align="left"><p>Diabetes mellitus</p><p>Chronic heart failure</p><p>Ischemic heart disease</p><p>Hypertension</p></td><td align="left"><p>94 (35)</p><p>95 (36)</p><p>52 (20)</p></td></tr><tr><td align="left">Patient, n (%)</td><td align="left"/></tr><tr><td align="left"><p>Incident</p><p>Prevalent</p></td><td align="left"><p>130 (49)</p><p>136 (51)</p></td></tr><tr><td align="left">Complications, n (%)</td><td align="left"/></tr><tr><td align="left"><p>Bleeding</p><p>Air embolism</p><p>Pneumothorax</p><p>Hemothorax</p><p>Arrythmias</p><p>Artery puncture</p><p>Tip repositioning</p></td><td align="left"><p>10 (4)</p><p>0 (0)</p><p>0 (0)</p><p>0 (0)</p><p>0 (0)</p><p>1 (0,4)</p><p>27 (11)</p></td></tr><tr><td align="left" colspan="2">Location, n</td></tr><tr><td align="left"><p>Internal jugular vein (L/R)</p><p>Femoral vein (L/R)</p><p>Subclavian vein (L/R)</p></td><td align="left"><p>244 (21/223)</p><p>21 (8/13)</p><p>1 (0/1)</p></td></tr></tbody></table><table-wrap-foot><p>Abbreviations: M-male, F-female, L-left, R- right</p></table-wrap-foot></table-wrap>
</p><p id="Par40">
<table-wrap id="Tab2"><label>Table 2</label><caption><p>Major analyzed outcomes based on the insertion site of the catheter</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">Internal jugular vein<break/>(<italic>n</italic>&#x02009;=&#x02009;244)</th><th align="left">Femoral vein<break/>(<italic>n</italic>&#x02009;=&#x02009;21)</th><th align="left">Subclavian vein (<italic>n</italic>&#x02009;=&#x02009;1)</th><th align="left"><italic>p</italic> value</th></tr></thead><tbody><tr><td align="left"><p>Bleeding, n (%)</p><p>Tip repositioning, n (%)</p></td><td align="left"><p>9 (4)</p><p>27 (11)</p></td><td align="left"><p>1 (5)</p><p>n/a</p></td><td align="left"><p>0 (0)</p><p>0 (0)</p></td><td align="left"><italic>p</italic>&#x02009;=&#x02009;0.8</td></tr></tbody></table></table-wrap>
</p><p id="Par41">Due to the presence of only one subclavian insertion, this site was excluded from the statistical analysis. The p-value refers exclusively to the comparison between internal jugular and femoral vein insertions.</p></sec><sec id="Sec14"><title>Comparison of right and left internal jugular vein catheter insertions</title><p id="Par42">We compared patient and procedural characteristics between right and left internal jugular vein (IJV) catheter insertions. A total of 223 catheters were placed in the right IJV and 21 in the left IJV.</p><p id="Par43">Bleeding rates were similar between the groups (4% vs. 5%; <italic>p</italic>&#x02009;=&#x02009;0.56). There was also no significant difference in the distribution of incident vs. prevalent patients (<italic>p</italic>&#x02009;=&#x02009;0.28), sex (<italic>p</italic>&#x02009;=&#x02009;0.50), diabetes prevalence (<italic>p</italic>&#x02009;=&#x02009;0.10), or the need for catheter tip repositioning (<italic>p</italic>&#x02009;=&#x02009;0.066) (Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>).</p><p id="Par44">
<table-wrap id="Tab3"><label>Table 3</label><caption><p>Comparison of right vs. left internal jugular vein catheter insertions</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">Right IJV (<italic>n</italic>&#x02009;=&#x02009;223)</th><th align="left">Left IJV (<italic>n</italic>&#x02009;=&#x02009;21)</th><th align="left"><italic>p</italic>-value</th></tr></thead><tbody><tr><td align="left">Bleeding, n (%)</td><td align="left">8 (4%)</td><td align="left">1 (5%)</td><td align="left">0.56</td></tr><tr><td align="left">Incident, n (%)</td><td align="left">118 (53%)</td><td align="left">8 (38%)</td><td align="left" rowspan="2">0.28</td></tr><tr><td align="left">Prevalent, n (%)</td><td align="left">105 (47%)</td><td align="left">13 (62%)</td></tr><tr><td align="left">Female sex, n (%)</td><td align="left">93 (42%)</td><td align="left">7 (33%)</td><td align="left">0.50</td></tr><tr><td align="left">Diabetes, n (%)</td><td align="left">76 (34%)</td><td align="left">11 (52%)</td><td align="left">0.10</td></tr><tr><td align="left">Tip reposition, n (%)</td><td align="left">22 (10%)</td><td align="left">5 (24%)</td><td align="left">0.066</td></tr></tbody></table><table-wrap-foot><p>Note: p-values derived using Fisher&#x02019;s exact test (for bleeding, sex, diabetes, tip reposition) and chi-square test (for incident/prevalent status). Abbreviations: IJV &#x02013; internal jugular vein</p></table-wrap-foot></table-wrap>
</p></sec><sec id="Sec15"><title>Comparative analysis of bleeding rates versus historical fluoroscopy-guided cohorts</title><p id="Par45">To contextualize our findings, we compared the observed bleeding rate in our fluoroscopy-free cohort (4.0%, <italic>n</italic> = 10) to bleeding rates reported in published studies of fluoroscopy-guided tunneled hemodialysis catheter placement. Reported rates in these historical fluoroscopy-guided cohorts ranged from 1.5% [<xref ref-type="bibr" rid="CR3">3</xref>], through 3.6% [<xref ref-type="bibr" rid="CR8">8</xref>] and up to 4.6% [<xref ref-type="bibr" rid="CR9">9</xref>]. Statistical comparison using Fisher&#x02019;s exact test revealed no significant differences between our bleeding rate and those reported for fluoroscopy-guided groups (p-values ranging from 0.21 to 0.9), (Table <xref rid="Tab4" ref-type="table">4</xref>).</p><p id="Par46">
<table-wrap id="Tab4"><label>Table 4</label><caption><p>Comparison of bleeding rates in fluoroscopy - guided vs. fluoroscopy-free tunneled hemodialysis catheter placement</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Study</th><th align="left">No Fluoroscopy <italic>n</italic> (%)</th><th align="left">Fluoroscopy <italic>n</italic> (%)</th><th align="left"><italic>p</italic>-value (vs. our <italic>n</italic>: 10/266; 4%)</th></tr></thead><tbody><tr><td align="left">Chang et al. (2022)</td><td align="left">0/90 (0%)</td><td align="left">12/261 (4.6%)</td><td align="left">0.64</td></tr><tr><td align="left">Yevzlin et al. (2007)</td><td align="left">2/66 (3.0%)</td><td align="left">2/136 (1.5%)</td><td align="left">0.21</td></tr><tr><td align="left">Kim et al. (2023)</td><td align="left">5/81 (6.2%)</td><td align="left">17/474 (3.6%)</td><td align="left">0.9</td></tr><tr><td align="left">Konnepati et al. (2024)</td><td align="left">9/87 (10.3%)</td><td align="left">4/62 (6.5%)</td><td align="left">0.37</td></tr></tbody></table></table-wrap>
</p></sec></sec><sec id="Sec16"><title>Discussion</title><p id="Par47">Our retrospective analysis demonstrates that fluoroscopy-free placement of tunneled hemodialysis catheters using ultrasound and anatomical landmarks is feasible and safe, with low rates of complications and successful use for dialysis in all cases. Importantly, both incident and prevalent hemodialysis patients achieved comparable outcomes, underscoring the applicability of this approach in diverse clinical contexts.</p><sec id="Sec17"><title>Complications and bleeding</title><p id="Par48">Overall, complication rates in our cohort were low, with prolonged bleeding occurring in 4% of cases. Although some of these episodes required a single blood transfusion, they were not life-threatening and did not necessitate any advanced intervention. This aligns with existing literature indicating that major bleeding events during tunneled hemodialysis catheter placement are rare, regardless of the use of fluoroscopic guidance [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR9">9</xref>]. Prior comparative studies found no significant differences in bleeding complications between fluoroscopy-guided and non-fluoroscopic techniques [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR9">9</xref>]. In our practice, careful ultrasound-guided venipuncture and use of anatomical landmarks enabled consistent control of access site hemostasis without advanced imaging support.</p><p id="Par49">The adoption of ultrasound guidance has been widely recognized for its ability to lower the risk of adverse events during central venous access procedures. Specifically, for internal jugular vein catheterization, ultrasound use is associated with fewer mechanical complications, higher first-attempt success rates, and shorter procedure times [<xref ref-type="bibr" rid="CR10">10</xref>, <xref ref-type="bibr" rid="CR11">11</xref>]. These findings support the broader body of evidence indicating that ultrasound-guided insertion substantially reduces mechanical complications compared to landmark-only approaches, and can safely replace fluoroscopy when the latter is unavailable or impractical [<xref ref-type="bibr" rid="CR12">12</xref>]. Particularly in settings with limited access to fluoroscopy suites or among critically ill patients who cannot be safely transported (e.g., ICU settings), non-fluoroscopic insertion remains a valuable and evidence-supported strategy [<xref ref-type="bibr" rid="CR8">8</xref>, <xref ref-type="bibr" rid="CR13">13</xref>].</p><p id="Par50">Our findings align closely with those of a recent randomized controlled trial from India, which demonstrated that ultrasound-guided tunneled dialysis catheter insertions without fluoroscopic assistance were equally effective and safe compared to fluoroscopy-guided procedures. That study reported no significant differences in mechanical or thrombotic complications between the two groups, while noting a shorter procedure time for non-fluoroscopic insertions [<xref ref-type="bibr" rid="CR14">14</xref>].</p></sec><sec id="Sec18"><title>Catheter tip repositioning</title><p id="Par51">Catheter tip malposition is a potential concern when fluoroscopic visualization is not available. In our study, repositioning was required in approximately 11% of cases, determined by routine post-procedural imaging. Notably, this rate is similar to those reported in cohorts using modified traditional (blind) techniques as well as fluoroscopy-assisted insertions [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR9">9</xref>].</p><p id="Par52">Our findings are consistent with prior studies suggesting that the majority of catheter placements without fluoroscopy achieve satisfactory tip position on the first attempt, with acceptable rates of minor repositioning [<xref ref-type="bibr" rid="CR15">15</xref>]. Importantly, all catheters in our cohort ultimately achieved functional positioning sufficient to deliver effective hemodialysis. This result demonstrates that systematic post-procedural assessment and readiness to perform repositioning when necessary are key to ensuring quality outcomes without fluoroscopy [<xref ref-type="bibr" rid="CR15">15</xref>].</p><p id="Par53">In addition to post-procedural imaging, other non-fluoroscopic techniques have been described for real-time tip localization. The intracavitary ECG method utilizes the catheter itself as an electrode, with the morphology of the P-wave progressively changing as the tip approaches the cavo-atrial junction, thereby allowing the operator to identify the optimal position [<xref ref-type="bibr" rid="CR16">16</xref>, <xref ref-type="bibr" rid="CR17">17</xref>]. Alternatively, the agitated saline bubble&#x02013;enhanced ultrasound method involves flushing saline mixed with microbubbles through the catheter while simultaneously imaging the right atrium with echocardiography; the immediate appearance of bubbles indicates correct tip location [<xref ref-type="bibr" rid="CR18">18</xref>]. The choice of these adjunctive methods varies among institutions, depending largely on operator experience, local preferences, and the availability of specific equipment.</p><p id="Par54">Further reduction in the need for tip repositioning may be achievable by incorporating real-time ultrasound confirmation of catheter position, as suggested in recent studies [<xref ref-type="bibr" rid="CR15">15</xref>].</p></sec><sec id="Sec19"><title>Left internal jugular vein access without fluoroscopy</title><p id="Par55">Although right internal jugular vein access is the preferred approach due to its straighter course to the superior vena cava and right atrium, left-sided access is sometimes unavoidable. In our cohort, 21 catheters (8%) were placed in the left internal jugular vein without fluoroscopy. Outcomes, including bleeding rates, incident vs. prevalent status distribution, diabetes prevalence, and need for tip repositioning, were statistically comparable to right-sided placements.</p><p id="Par56">Despite these findings, left internal jugular placement without fluoroscopy remains controversial in some settings. Certain guidelines and experts have advised caution or even avoidance due to the increased risk of tip malposition and vessel stenosis [<xref ref-type="bibr" rid="CR1">1</xref>]. For instance, Yevzlin et al. noted that the lack of direct visualization can complicate left-sided placement because of anatomical challenges and potential for suboptimal catheter tip location [<xref ref-type="bibr" rid="CR3">3</xref>]. Similarly, other authors highlight that fluoroscopic guidance is particularly beneficial for left-sided insertions to minimize malposition risk [<xref ref-type="bibr" rid="CR9">9</xref>].</p><p id="Par57">Nonetheless, our experience and that of others [<xref ref-type="bibr" rid="CR8">8</xref>, <xref ref-type="bibr" rid="CR15">15</xref>] indicate that with experienced operators, ultrasound guidance and anatomical landmarks can achieve safe and effective left internal jugular access even without fluoroscopy. Institutions choosing this approach should ensure operator training, systematic post-procedural imaging, and readiness to perform prompt repositioning as needed to mitigate potential risks.</p><p id="Par58">Operator experience plays a crucial role in minimizing complications, with data suggesting that performing 50 or more catheter insertions reduces the likelihood of mechanical issues by about half compared to less experienced physicians [<xref ref-type="bibr" rid="CR19">19</xref>, <xref ref-type="bibr" rid="CR20">20</xref>]. However, there are no universally established guidelines defining the exact number of tunneled catheter procedures required to achieve expert competency. In our center, trainees progress at an early stage from assisting to performing procedures under direct supervision and real-time guidance. Once proficiency is demonstrated, they are encouraged to perform most procedures independently, consolidating skills and building confidence while maintaining safety.</p></sec><sec id="Sec20"><title>Role of different specialties in tunneled catheter placement</title><p id="Par59">Tunneled hemodialysis catheter insertion is a procedure that varies significantly among centers in terms of the specialists performing it. While it is often considered a nephrology-driven intervention, both surgeons and interventional radiologists traditionally play important roles in vascular access management [<xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR22">22</xref>]. Historical studies have compared outcomes between catheters placed by surgeons and those inserted by radiologists, reporting similar immediate complication and success rates across both groups [<xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR22">22</xref>]. This suggests that, in terms of technical success and early complications, procedural expertise rather than specialty designation is likely the key determinant of outcome.</p><p id="Par60">However, as highlighted in subsequent work, fragmented care, where nephrologists rely on other departments for access creation, can contribute to treatment delays and increased use of temporary non-tunneled catheters. A Korean study demonstrated that when nephrologists performed tunneled hemodialysis catheter placement themselves, time from decision to dialysis was significantly shortened compared to radiology-led insertion (median 275 vs. 415 min, <italic>p</italic> &#x0003c; 0.001), with comparable safety and success rates (94.5% vs. 95.3%) [<xref ref-type="bibr" rid="CR8">8</xref>]. While long-term catheter survival was not fully addressed in that analysis, these findings underscore the benefit of aligning procedural responsibility with specialists directly involved in longitudinal dialysis care. Such integration supports continuity, timely decision-making, and potentially improved patient outcomes.</p></sec><sec id="Sec21"><title>Resource and cost considerations</title><p id="Par61">Beyond clinical safety, the choice of technique has important implications for resource utilization. Fluoroscopy-guided insertion in an interventional radiology suite requires specialized infrastructure, additional personnel, and increased logistical coordination, all of which contribute to higher costs. In contrast, ultrasound-guided bedside procedures in the dialysis unit are significantly less resource-intensive while maintaining comparable safety and efficacy. Cost analyses confirm that performing tunneled catheter insertions without fluoroscopy can be nearly twice as cost-effective as fluoroscopy-based approaches [<xref ref-type="bibr" rid="CR3">3</xref>]. Even when accounting for rare instances of malposition requiring secondary fluoroscopic correction, the overall savings remain substantial.</p><p id="Par62">While fluoroscopy ensures near-perfect real-time confirmation of catheter tip position, our findings and prior literature indicate that the need for repositioning is infrequent. This raises the question of whether routine fluoroscopic use is justified in all cases. Although chest X-ray is not radiation-free, its effective dose is relatively low (approximately 0.02 mSv per examination). By contrast, fluoroscopy is associated with substantially higher exposure, as even short procedures may deliver doses several-fold greater depending on duration and technique [<xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR24">24</xref>]. A selective approach, reserving fluoroscopy for anatomically complex or high-risk scenarios, appears practical and resource-conscious. Empowering trained nephrologists to perform ultrasound-guided tunneled hemodialysis catheter placement without fluoroscopy aligns with these principles, offering an effective and patient-centered model of care that optimizes both safety and efficiency.</p><p id="Par63">Our study has several limitations. First, its retrospective single-center design may introduce selection bias and limit the generalizability of findings to other institutions with different patient populations or operator experience levels. The lack of a contemporaneous control group undergoing fluoroscopy-guided placement prevents direct comparison of outcomes between techniques within the same setting. Although post-procedural imaging was routinely used to assess catheter tip position, the accuracy of tip placement evaluation may vary due to differences in imaging interpretation and documentation. Finally, while complication rates were low, the study may have been underpowered to detect rare but clinically significant adverse events.</p></sec></sec><sec id="Sec22"><title>Conclusions</title><p id="Par64">Our study shows that ultrasound- and landmark-guided placement of tunneled hemodialysis catheters without fluoroscopy is safe and effective in experienced hands in cases without anticipated anatomical difficulties (e.g., prior failed catheterization attempts, known central venous stenosis or thrombosis, or history of vascular interventions suggesting altered anatomy). Low complication rates and reliable catheter function in our study population support this approach as a practical alternative where fluoroscopy is unavailable. These findings highlight the value of training in non-fluoroscopic techniques to expand safe vascular access options in clinical practice, particularly in resource-limited or high-volume dialysis centers where timely access is critical.</p></sec></body><back><fn-group><fn><p><bold>Publisher&#x02019;s note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn></fn-group><ack><title>Acknowledgements</title><p>Not applicable.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>KK1 was responsible for statistical analysis and drafting of the manuscript, KK2 collected the data, IG was involved in analysis and interpretation of data, ARR and TH revised the statistics and the manuscript. All authors read and approved the final manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>Not applicable.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>The dataset supporting the conclusions of this article is included within the article.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par65">This study was conducted in accordance with the ethical principles of the Declaration of Helsinki. The study was approved by Medical University of Bialystok ethics committee (approval no. APK.002.275.2024). Due to the retrospective nature of the analysis, individual patient consent was not required.</p></notes><notes id="FPar2"><title>Consent for publication</title><p id="Par66">Not applicable.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests</title><p id="Par67">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Lok</surname><given-names>CE</given-names></name><name><surname>Huber</surname><given-names>TS</given-names></name><name><surname>Lee</surname><given-names>T</given-names></name><name><surname>Shenoy</surname><given-names>S</given-names></name><name><surname>Yevzlin</surname><given-names>AS</given-names></name><name><surname>Abreo</surname><given-names>K</given-names></name><etal/></person-group><article-title>KDOQI clinical practice guideline for vascular access: 2019 update</article-title><source>Am J Kidney Dis</source><year>2020</year><volume>75</volume><issue>4 Suppl 2</issue><fpage>S1</fpage><lpage>164</lpage><p
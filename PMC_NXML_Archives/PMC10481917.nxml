<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" dtd-version="1.3" xml:lang="en" article-type="research-article"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Ann Surg</journal-id><journal-id journal-id-type="iso-abbrev">Ann Surg</journal-id><journal-id journal-id-type="publisher-id">SLA</journal-id><journal-title-group><journal-title>Annals of Surgery</journal-title></journal-title-group><issn pub-type="ppub">0003-4932</issn><issn pub-type="epub">1528-1140</issn><publisher><publisher-name>Lippincott Williams &#x00026; Wilkins</publisher-name><publisher-loc>Hagerstown, MD</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">36847256</article-id><article-id pub-id-type="pmc">10481917</article-id><article-id pub-id-type="publisher-id">ANNSURG-D-22-01476</article-id><article-id pub-id-type="doi">10.1097/SLA.0000000000005822</article-id><article-id pub-id-type="art-access-id">00043</article-id><article-version vocab="JAV" vocab-identifier="http://www.niso.org/publications/rp/RP-8-2008.pdf" article-version-type="Version of Record">3</article-version><article-categories><subj-group subj-group-type="heading"><subject>Original Articles</subject></subj-group></article-categories><title-group><article-title>Circulating Tumor DNA as a Prognostic Factor in Patients With Resectable Hepatic Metastases of Uveal Melanoma</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Mariani</surname><given-names>Pascale</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">*</xref><email>pascale.mariani@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Bidard</surname><given-names>Fran&#x000e7;ois-Cl&#x000e9;ment</given-names></name><degrees>MD, PhD</degrees><xref rid="aff2" ref-type="aff">&#x02020;</xref><xref rid="aff3" ref-type="aff">&#x02021;</xref><xref rid="aff4" ref-type="aff">&#x000a7;</xref><email>francois-clement.bidard@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Rampanou</surname><given-names>Aurore</given-names></name><degrees>BA</degrees><xref rid="aff2" ref-type="aff">&#x02020;</xref><email>aurore.rampanou@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Houy</surname><given-names>Alexandre</given-names></name><degrees>MS</degrees><xref rid="aff5" ref-type="aff">&#x02225;</xref><email>Alexandre.Houy@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Servois</surname><given-names>Vincent</given-names></name><degrees>MD</degrees><xref rid="aff6" ref-type="aff">&#x000b6;</xref><email>vincent.servois@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Ramtohul</surname><given-names>Toulsie</given-names></name><degrees>MD, PhD</degrees><xref rid="aff6" ref-type="aff">&#x000b6;</xref><email>toulsie.ramtohul@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Pierron</surname><given-names>Gaelle</given-names></name><degrees>PhD</degrees><xref rid="aff7" ref-type="aff">#</xref><email>gaelle.pierron@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Chevrier</surname><given-names>Marion</given-names></name><degrees>PhD</degrees><xref rid="aff8" ref-type="aff">**</xref><email>marion.chevrier@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Renouf</surname><given-names>Benjamin</given-names></name><degrees>PhD</degrees><xref rid="aff9" ref-type="aff">&#x02020;&#x02020;</xref><email>benjamin.renouf@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Lantz</surname><given-names>Olivier</given-names></name><degrees>MD, PhD</degrees><xref rid="aff10" ref-type="aff">&#x02021;&#x02021;</xref><xref rid="aff11" ref-type="aff">&#x000a7;&#x000a7;</xref><xref rid="aff12" ref-type="aff">&#x02225;&#x02225;</xref><email>olivier.lantz@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Gardrat</surname><given-names>Sophie</given-names></name><degrees>MD</degrees><xref rid="aff13" ref-type="aff">&#x000b6;&#x000b6;</xref><email>sophie.gardrat@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Vincent-Salomon</surname><given-names>Anne</given-names></name><degrees>MD, PhD</degrees><xref rid="aff13" ref-type="aff">&#x000b6;&#x000b6;</xref><email>anne.salomon@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Roman-Roman</surname><given-names>Sergio</given-names></name><degrees>PharmD, PhD</degrees><xref rid="aff14" ref-type="aff">##</xref><email>Sergio.Roman-Roman@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Rodrigues</surname><given-names>Manuel</given-names></name><degrees>MD, PhD</degrees><xref rid="aff3" ref-type="aff">&#x02021;</xref><xref rid="aff5" ref-type="aff">&#x02225;</xref><email>manuel.rodrigues@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Piperno-Neumann</surname><given-names>Sophie</given-names></name><degrees>MD</degrees><xref rid="aff3" ref-type="aff">&#x02021;</xref><email>sophie.piperno-neumann@curie.fr</email></contrib><contrib contrib-type="author"><name><surname>Cassoux</surname><given-names>Nathalie</given-names></name><degrees>MD, PhD</degrees><email>nathalie.cassoux@curie.fr</email><xref rid="aff1" ref-type="aff">*</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Stern</surname><given-names>Marc-Henri</given-names></name><degrees>MD, PhD</degrees><xref rid="aff5" ref-type="aff">&#x02225;</xref><email>marc-henri.stern@curie.fr</email></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Renault</surname><given-names>Shufang</given-names></name><degrees>PhD</degrees><xref rid="aff2" ref-type="aff">&#x02020;</xref><email>shufang.renault@curie.fr</email></contrib></contrib-group><aff id="aff1">

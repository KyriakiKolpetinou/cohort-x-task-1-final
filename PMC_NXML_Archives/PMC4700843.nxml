="author"><name><surname>Cella</surname><given-names>D</given-names></name><name><surname>Dobrez</surname><given-names>D</given-names></name><name><surname>Glaspy</surname><given-names>J</given-names></name></person-group><article-title>Control of cancer-related anemia with erythropoietic agents: a review of evidence for improved quality of life and clinical outcomes</article-title><source>Ann Oncol</source><year>2003</year><volume>14</volume><fpage>511</fpage><lpage>519</lpage><pub-id pub-id-type="pmid">12649095</pub-id></element-citation></ref><ref id="ref15"><label>15</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Heiss</surname><given-names>MM</given-names></name><name><surname>Tarabichi</surname><given-names>A</given-names></name><name><surname>Delanoff</surname><given-names>C</given-names></name><etal/></person-group><article-title>Perisurgical erythropoietin application in anemic patients with colorectal cancer: A double-blind randomized study</article-title><source>Surgery</source><year>1996</year><volume>119</volume><fpage>523</fpage><lpage>527</lpage><pub-id pub-id-type="pmid">8619207</pub-id></element-citation></ref><ref id="ref16"><label>16</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bokemeyer</surname><given-names>C</given-names></name><name><surname>Aapro</surname><given-names>MS</given-names></name><name><surname>Courdi</surname><given-names>A</given-names></name><etal/></person-group><article-title>EORTC guidelines for the use of erythropoietic proteins in anaemic patients with cancer: 2006 update</article-title><source>Eur J Cancer</source><year>2007</year><volume>43</volume><fpage>258</fpage><lpage>270</lpage><pub-id pub-id-type="pmid">17182241</pub-id></element-citation></ref><ref id="ref17"><label>17</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Tan</surname><giv
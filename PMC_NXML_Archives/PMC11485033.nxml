</td></tr><tr><td align="left">HadlockV [<xref ref-type="bibr" rid="CR16">16</xref>]</td><td align="left">BPD, AC</td><td align="left">
<inline-formula id="IEq8"><alternatives><tex-math id="M9">\documentclass[12pt]{minimal}

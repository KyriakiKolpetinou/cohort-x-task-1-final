</element-citation></ref><ref id="B6-tomography-10-00103"><label>6.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Turrini</surname><given-names>A.</given-names></name>
<name><surname>De Masi</surname><given-names>C.M.</given-names></name>
<name><surname>Sacco</surname><given-names>C.</given-names></name>
<name><surname>Mencarani</surname><given-names>C.</given-names></name>

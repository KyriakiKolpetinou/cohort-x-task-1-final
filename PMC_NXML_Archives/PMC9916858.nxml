</person-group><article-title>Cholesterol binding is a prerequisite for the activity of the steroidogenic acute regulatory protein (StAR)</article-title><source>Biochem. J.</source><year>2008</year><volume>412</volume><fpage>553</fpage><lpage>562</lpage><pub-id pub-id-type="doi">10.1042/BJ20071264</pub-id><pub-id pub-id-type="pmid">18341481</pub-id></element-citation></ref><ref id="B3-ijms-24-02474"><label>3.</label><element-citation publication-type="journal"><person-group person-group-type="author">

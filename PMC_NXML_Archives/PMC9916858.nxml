</person-group><article-title>Steroidogenic Acute Regulatory Protein: Structure, Functioning, and Regulation</article-title><source>Biochemistry</source><year>2019</year><volume>84</volume><fpage>S233</fpage><lpage>S253</lpage><pub-id pub-id-type="doi">10.1134/S0006297919140141</pub-id><pub-id pub-id-type="pmid">31213205</pub-id></element-citation></ref><ref id="B4-ijms-24-02474"><label>4.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Li</surname><given-names>H.</given-names></name>
<name><surname>Yao</surname><given-names>Z.</given-names></name>
<name><surname>Degenhardt</surname><given-names>B.</given-names></name>

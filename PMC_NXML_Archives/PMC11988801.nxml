</person-group><article-title>Metastases to the breast: Differential diagnosis from primary breast carcinoma</article-title><source>J. Surg. Oncol.</source><year>1991</year><volume>48</volume><fpage>112</fpage><lpage>116</lpage><pub-id pub-id-type="doi">10.1002/jso.2930480208</pub-id><pub-id pub-id-type="pmid">1921396</pub-id>
</element-citation></ref><ref id="B2-diagnostics-15-00860"><label>2.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Feder</surname><given-names>J.M.</given-names></name>
<name><surname>de Paredes</surname><given-names>E.S.</given-names></name>

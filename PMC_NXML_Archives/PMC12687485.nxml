ontrib contrib-type="author"><name><surname>Mandegar</surname><given-names>Mohammad Hossein</given-names></name><xref ref-type="aff" rid="Aff8">8</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01c4pz451</institution-id><institution-id institution-id-type="GRID">grid.411705.6</institution-id><institution-id institution-id-type="ISNI">0000 0001 0166 0922</institution-id><institution>Faculty of Medicine, </institution><institution>Tehran University of Medical Sciences, </institution></institution-wrap>Tehran, Iran </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/04waqzz56</institution-id><institution-id institution-id-type="GRID">grid.411036.1</institution-id><institution-id institution-id-type="ISNI">0000 0001 1498 685X</institution-id><institution>Faculty of Medicine, </institution><institution>Isfahan University of Medical Sciences, </institution></institution-wrap>Hezar Jerib Avenue, Isfahan, Isfahan Province Iran </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01c4pz451</institution-id><institution-id institution-id-type="GRID">grid.411705.6</institution-id><institution-id institution-id-type="ISNI">0000 0001 0166 0922</institution-id><institution>Cardiovascular Disease Research Institute, Tehran Heart Center, </institution><institution>Tehran University of Medical Sciences, </institution></institution-wrap>Tehran, 14117-13137 Iran </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01rws6r75</institution-id><institution-id institution-id-type="GRID">grid.411230.5</institution-id><institution-id institution-id-type="ISNI">0000 0000 9296 6873</institution-id><institution>Internal Medicine Department, </institution><institution>Ahvaz Jundishapur University of Medical Sciences, </institution></institution-wrap>Ahvaz, Iran </aff><aff id="Aff5"><label>5</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/04waqzz56</institution-id><institution-id institution-id-type="GRID">grid.411036.1</institution-id><institution-id institution-id-type="ISNI">0000 0001 1498 685X</institution-id><institution>Student Research Committee, School of Medicine, </institution><institution>Isfahan University of Medical Sciences, </institution></institution-wrap>Isfahan, Iran </aff><aff id="Aff6"><label>6</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03w04rv71</institution-id><institution-id institution-id-type="GRID">grid.411746.1</institution-id><institution-id institution-id-type="ISNI">0000 0004 4911 7066</institution-id><institution>Rajaei Cardiovascular Medical and Research Center, </institution><institution>Iran University of Medical Sciences, </institution></institution-wrap>Tehran, Iran </aff><aff id="Aff7"><label>7</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/034m2b326</institution-id><institution-id institution-id-type="GRID">grid.411600.2</institution-id><institution>Department of Cardiology, </institution><institution>Shahid Beheshti University of Medical Sciences, </institution></institution-wrap>Tehran, Iran </aff><aff id="Aff8"><label>8</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01c4pz451</institution-id><institution-id institution-id-type="GRID">grid.411705.6</institution-id><institution-id institution-id-type="ISNI">0000 0001 0166 0922</institution-id><institution>Cardiac Surgery Department, </institution><institution>Shariati Hospital Complex, Tehran University of Medical Sciences, </institution></institution-wrap>Tehran, Iran </aff></contrib-group><pub-date pub-type="epub"><day>9</day><month>12</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>9</day><month>12</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>18</volume><elocation-id>257</elocation-id><history><date date-type="received"><day>19</day><month>7</month><year>2025</year></date><date date-type="accepted"><day>11</day><month>10</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1" abstract-type="structured"><sec><title>Background</title><p id="Par1">An anomalous right coronary artery (RCA) arising from the left coronary sinus with an interarterial/intramural course can cause exertional ischemia and, rarely, sudden death. Functional testing and coronary CT angiography (CCTA) are key for diagnosis and risk stratification.</p></sec><sec><title>Case presentation</title><p id="Par2">We report the case of a 46-year-old woman presenting with exertional dyspnea and jaw discomfort. She had no conventional cardiovascular risk factors aside from hyperlipidemia and a family history of premature coronary disease. Exercise treadmill testing and myocardial perfusion imaging revealed inducible ischemia. Coronary computed tomography angiography demonstrated an anomalous RCA arising from the left coronary sinus with an interarterial and intramural course between the aorta and pulmonary artery. Surgical consultation confirmed a malignant anatomical variant, and the patient underwent successful coronary artery bypass grafting (CABG) with complete symptom resolution.</p></sec><sec><title>Discussion</title><p id="Par3">This case underscores the importance of considering congenital coronary anomalies in the differential diagnosis of exertional angina, especially in patients without atherosclerosis or major cardiovascular risk factors. Functional and anatomical imaging are essential for risk stratification. CABG remains an effective treatment for high-risk anomalies when direct reimplantation is not feasible.</p></sec><sec><title>Conclusion</title><p id="Par4">In symptomatic patients with demonstrable ischemia and high-risk anatomic features, surgery provides excellent outcomes. Early recognition using complementary functional and anatomic imaging is essential.</p></sec></abstract><trans-abstract xml:lang="de" id="Abs2" abstract-type="unstructured"><title>Graphical Abstract</title><p id="Par5">
<graphic position="anchor" xlink:href="12245_2025_1042_Figa_HTML" id="d33e306"/>
</p></trans-abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Coronary artery anomalies</kwd><kwd>Coronary artery bypass</kwd><kwd>Coronary angiography</kwd><kwd>Myocardial ischemia</kwd><kwd>Tomography</kwd><kwd>X-ray computed</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer-Verlag GmbH Germany, part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par6">Coronary artery anomalies (CAAs) are congenital variations in the origin, course, or structure of the coronary arteries, with a prevalence of 0.17% to 1.3% in angiographic studies. Among these, the anomalous origin of the right coronary artery (RCA) from the left coronary sinus with an interarterial course is a rare subtype, occurring in less than 0.1% of cases [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>]. This anomaly is classified as &#x0201c;malignant&#x0201d; due to its potential to cause myocardial ischemia, arrhythmias, and sudden cardiac death (SCD), particularly during exertion. The interarterial path, often combined with an intramural segment and slit-like ostium, leads to dynamic compression between the aorta and pulmonary artery during HF systole, restricting coronary flow and precipitating ischemia [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR4">4</xref>].</p><p id="Par7">The clinical presentation of CAAs varies widely. While many individuals remain asymptomatic, symptomatic cases may manifest as exertional angina, syncope, or SCD, often in younger patients without traditional cardiovascular risk factors [<xref ref-type="bibr" rid="CR5">5</xref>]. Diagnosis is challenging, requiring a high index of suspicion and multimodal imaging, including exercise treadmill testing (ETT), myocardial perfusion imaging (MPI), and coronary computed tomography angiography (CCTA) [<xref ref-type="bibr" rid="CR6">6</xref>, <xref ref-type="bibr" rid="CR7">7</xref>]. Management strategies range from conservative observation to surgical intervention&#x02014;such as coronary artery bypass grafting (CABG) or reimplantation&#x02014;depending on symptoms and anatomical risk features [<xref ref-type="bibr" rid="CR8">8</xref>].</p><p id="Par8">This case report describes a 46-year-old woman with exertional angina and an anomalous RCA with an interarterial course, confirmed via coronary CTA and successfully managed with CABG. We provide a comprehensive review of the literature on the diagnosis and management of malignant RCA anomalies.</p></sec><sec id="Sec2"><title>Case presentation</title><p id="Par9">A 46-year-old woman reported two months of exertional dyspnea with jaw discomfort that resolved with rest. She had no hypertension, diabetes, or smoking history. Family history included premature coronary disease (brother with mild LAD stenosis at age 48). She had previously lost weight from 90&#x000a0;kg to 61&#x000a0;kg; BMI was 26&#x000a0;kg/m&#x000b2; at presentation.</p><p id="Par10">Initial laboratory evaluation revealed hyperlipidemia, with total cholesterol 228&#x000a0;mg/dL (reference: 125&#x02013;200) and LDL 172&#x000a0;mg/dL (reference: &#x0003c;100). Fasting glucose, renal function, and electrolytes were within normal limits. Echocardiography showed a structurally normal heart with preserved left ventricular systolic function (LVEF 60%), mild mitral valve prolapses, and no regional wall motion abnormalities or significant valvular disease. There was no evidence of pulmonary hypertension or pericardial effusion.</p><p id="Par11">Exercise treadmill testing (ETT) using Bruce protocol provoked exertional symptoms with inferolateral ST-depression. Repeat ETT confirmed these findings. Myocardial perfusion imaging (Tc-99&#x000a0;m MIBI SPECT) revealed a moderate reversible perfusion defect in the inferoposterior wall without stress-induced LV dilatation, with a summed stress score (SSS) of 8 and a perfusion defect size of 10&#x02013;15% (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>).</p><p id="Par12">
<fig id="Fig1"><label>Fig. 1</label><caption><p>Myocardial Perfusion Imaging (MPI) Using Technetium (99mTc) Sestamibi. The panel displays tomographic slices in three standard cardiac axes: Short Axis (SA), Vertical Long Axis (VLA), and Horizontal Long Axis (HLA). Row A represents images acquired during stress, while Row B represents images acquired at rest. The color scale indicates relative radiotracer uptake, with red representing maximal perfusion. Stress images show a moderate reversible perfusion defect which improves at rest, consistent with inducible myocardial ischemia</p></caption><graphic xlink:href="12245_2025_1042_Fig1_HTML" id="d33e368"/></fig>
</p><p id="Par13">CCTA identified an RCA arising from the left coronary sinus with interarterial course between the aorta and pulmonary artery. The proximal intramural segment measured&#x02009;~&#x02009;1.1&#x000a0;mm over 13&#x000a0;mm; distal RCA caliber was normal. LAD showed only mild proximal irregularity and the calcium score was zero. No definite obstructive LAD disease was seen on CCTA (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>). However, subsequent invasive coronary angiography (CAG) demonstrated a focal&#x02009;&#x0003e;&#x02009;90% stenosis in the proximal LAD. These findings were confirmed in a surgical consultation and classified as a potentially malignant anomaly, given the patient&#x02019;s exertional symptoms and evidence of ischemia.</p><p id="Par14">
<fig id="Fig2"><label>Fig. 2</label><caption><p>Coronary CT angiography demonstrating anomalous right coronary artery. Axial coronary CT angiography images at different levels show an anomalous right coronary artery (RCA) arising from the left coronary sinus and coursing interarterially between the aorta and the main pulmonary artery. The asterisk (*) marks the site where the RCA originates from the left sinus of Valsalva. The proximal interarterial/intramural segment is markedly narrowed</p></caption><graphic xlink:href="12245_2025_1042_Fig2_HTML" id="d33e383"/></fig>
</p><p id="Par15">The patient was admitted electively and underwent coronary artery bypass grafting (CABG). Intraoperative findings included a severely narrowed and intramural proximal RCA with a slit-like orifice and an interarterial course. Surgical intervention included a left internal mammary artery (LIMA) graft to the LAD and a saphenous vein graft (SVG) to the RCA. Both grafts demonstrated good flow intraoperatively. The postoperative course was uneventful and the patient remained hemodynamically stable; ischemic symptoms resolved.</p><p id="Par16">At the time of discharge, the recommendation was to continue secondary prevention with lipid-lowering therapy and lifestyle modifications. Given the RCA&#x02019;s congenital anomaly and high-risk anatomy, a discussion was initiated regarding the potential long-term role of surgical reimplantation of the RCA. However, graft-based revascularization was considered satisfactory at this stage.</p></sec><sec id="Sec3"><title>Discussion</title><p id="Par17">Anomalous origin of the RCA from the left coronary sinus with an interarterial course is a rare but potentially life-threatening congenital coronary anomaly, accounting for less than 0.1% of coronary angiographic findings [<xref ref-type="bibr" rid="CR9">9</xref>]. This variant is considered &#x0201c;malignant&#x0201d; due to its association with myocardial ischemia, arrhythmias, and sudden cardiac death (SCD), particularly during physical exertion [<xref ref-type="bibr" rid="CR10">10</xref>]. With an interarterial course&#x02014;especially intramural with a slit-like ostium&#x02014;the vessel is squeezed between the aorta and pulmonary artery in systole. This dynamic compression limits flow and can cause ischemia [<xref ref-type="bibr" rid="CR4">4</xref>].</p><p id="Par18">Multimodality imaging plays a pivotal role in diagnosing and risk-stratifying coronary anomalies. ETT and stress MPI help unmask functional significance, while CCTA offers high-resolution anatomical delineation of anomalous vessels [<xref ref-type="bibr" rid="CR11">11</xref>]. Although some cases may be managed conservatively, surgical revascularization is indicated in symptomatic patients with demonstrable ischemia or high-risk features [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR13">13</xref>]. CABG remains the preferred approach when reimplantation is anatomically unfeasible or when the proximal segment is long and intramural [<xref ref-type="bibr" rid="CR14">14</xref>].</p><p id="Par19">This case illustrates the diagnostic challenges in differentiating non-atherosclerotic ischemia from conditions such as microvascular angina, particularly in patients with preserved ventricular function and minimal risk factors. Additionally, it underscores the critical need for early recognition and appropriate management of malignant coronary anomalies, which may manifest subtly [<xref ref-type="bibr" rid="CR15">15</xref>]. A summary of similar published cases is presented in Table <xref rid="Tab1" ref-type="table">1</xref>.</p><p id="Par20">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Summary of reported cases of anomalous right coronary artery origin from the left coronary sinus with interarterial course</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Author, YOP</th><th align="left">Age &#x00026; Gender</th><th align="left">Imaging and Anomaly Details</th><th align="left">Treatment</th></tr></thead><tbody><tr><td align="left">Marcucci et al., 2021 [<xref ref-type="bibr" rid="CR16">16</xref>]</td><td align="left">75/M</td><td align="left">CCTA&#x02009;+&#x02009;invasive angiography; RCA from left sinus with interarterial course</td><td align="left">No RCA surgery; TAVI deferred</td></tr><tr><td align="left">Raikar et al., 2022 [<xref ref-type="bibr" rid="CR17">17</xref>]</td><td align="left">late 70s/F</td><td align="left">Cineangiography&#x02009;+&#x02009;CCTA; RCA from left coronary cusp, interarterial course</td><td align="left">Conservative (declined surgery)</td></tr><tr><td align="left">Tang et al., 2024 [<xref ref-type="bibr" rid="CR18">18</xref>]</td><td align="left">37/M</td><td align="left">CCTA; RCA from left sinus with interarterial and intramural course</td><td align="left">Lifestyle modification</td></tr><tr><td align="left">Al-Ahmad &#x00026; Yager, 2022 [<xref ref-type="bibr" rid="CR19">19</xref>]</td><td align="left">49/F</td><td align="left">Angiography&#x02009;+&#x02009;CCTA; RCA from left cusp with interarterial course</td><td align="left">DES to LCx; evaluation for RCA surgery</td></tr><tr><td align="left">Pujar et al., 2024 [<xref ref-type="bibr" rid="CR20">20</xref>]</td><td align="left">50/F</td><td align="left">CCTA&#x02009;+&#x02009;cath; interarterial narrowing of RCA from left cusp</td><td align="left">CABG (SVG&#x02192;RCA)</td></tr><tr><td align="left">Sch&#x000fc;tze et al., 2024 [<xref ref-type="bibr" rid="CR21">21</xref>]</td><td align="left">52&#x000a0;F, 66&#x000a0;M, 51&#x000a0;M</td><td align="left">CCTA&#x02009;+&#x02009;IVUS/FFR; interarterial/intramural RCA; not hemodynamically significant</td><td align="left">Conservative (FFR&#x02009;&#x0003e;&#x02009;0.80)</td></tr><tr><td align="left">Khan et al., 2022 [<xref ref-type="bibr" rid="CR22">22</xref>]</td><td align="left">51/F</td><td align="left">CAG&#x02009;+&#x02009;CCTA; RCA from LCS, interarterial, proximal narrowing</td><td align="left">CABG (SVG&#x02192;RCA)</td></tr><tr><td align="left">Xie et al., 2022&#x000a0;(<xref ref-type="bibr" rid="CR23">23</xref>]</td><td align="left">54/F</td><td align="left">Echo&#x02009;+&#x02009;CCTA; RCA from LCS, interarterial/intramural; with Stanford type A aortic dissection</td><td align="left">Emergency aortic/arch replacement&#x02009;+&#x02009;RCA bypass graft</td></tr><tr><td align="left">Reddy et al., 2012 [<xref ref-type="bibr" rid="CR24">24</xref>]</td><td align="left">50&#x02013;61 yrs</td><td align="left">CAG&#x02009;+&#x02009;CCTA; RCA from LCS with interarterial course</td><td align="left">MIDCAB (RIMA&#x02192;RCA)&#x02009;&#x000b1;&#x02009;proximal RCA ligation</td></tr><tr><td align="left">Lee, 2009 [<xref ref-type="bibr" rid="CR25">25</xref>]</td><td align="left">39/F</td><td align="left">Angiography (slit-like ostium, acute take-off); MDCT severe proximal narrowing</td><td align="left">Surgical unroofing of intramural segment</td></tr><tr><td align="left">Yildirim et al., 2016 [<xref ref-type="bibr" rid="CR26">26</xref>]</td><td align="left">63/M</td><td align="left">Angiography&#x02009;+&#x02009;MDCT; RCA from LCS with interarterial course; SPECT negative</td><td align="left">Conservative (beta-blocker)</td></tr><tr><td align="left">Narayanan et al., 2016 [<xref ref-type="bibr" rid="CR27">27</xref>]</td><td align="left">42/F</td><td align="left">MDCT; RCA from LCS, interarterial course, slit-like orifice, acute take&#x02011;off angle</td><td align="left">Conservative (surgery advised, refused)</td></tr><tr><td align="left">Mangel et al., 2023 [<xref ref-type="bibr" rid="CR28">28</xref>]</td><td align="left">68/F</td><td align="left">CCTA; RCA from left of left sinus, slit&#x02011;like ostium, interarterial/intramural; proximal narrowing</td><td align="left">Surgical reimplantation of RCA (neo&#x02011;ostium)</td></tr></tbody></table></table-wrap>
</p></sec></body><back><fn-group><fn><p><bold>Publisher&#x02019;s note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn></fn-group><ack><title>Acknowledgements</title><p>None.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>P.E., A.K., M.A., and A.Z. contributed to data curation, supervision, project administration, data collection, analysis, writing the initial draft, and revision of the final manuscript script. M.H.M., T.A., and S.M.N. contributed to data collection, analysis, data curation, and revision of the final manuscript. N.R. and P.R. contributed to literature search, figure preparation, and editing. All authors have read and approved the final version of the manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>No funds were received for this study.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>Data is available from the corresponding author upon reasonable request due to privacy/ethical restrictions.</p></notes><notes><title>Declarations</title><notes id="FPar5"><title>Ethical approval</title><p id="Par21">Not applicable.</p></notes><notes id="FPar6"><title>Consent to participate</title><p id="Par22">The patient provided written informed consent to participate in this clinical case report, ensuring that all personal information and medical data will be kept confidential and used solely for research purposes.</p></notes><notes id="FPar7"><title>Consent for publication</title><p id="Par23">The patient provided informed consent for the publication of this report, and the center&#x02019;s ethical policy approved the procedure.</p></notes><notes id="FPar8" notes-type="COI-statement"><title>Competing interests</title><p id="Par24">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</
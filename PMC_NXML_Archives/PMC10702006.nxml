</element-citation></ref><ref id="CR21"><label>21.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Nakahara</surname><given-names>T</given-names></name><etal/></person-group><article-title>Assessment of mocardial 18F-FDG uptake at PET/CT in asymptomatic SARS-CoV-2&#x02013;vaccinated and nonvaccinated patients</article-title><source>Radiology</source><year>2023</year><volume>308</volume><issue>3</issue><fpage>e230743</fpage><pub-id pub-id-type="doi">10.1148/radiol.230743</pub-id><pub-id pub-id-type="pmid">37724969</pub-id>

<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">J Headache Pain</journal-id><journal-id journal-id-type="iso-abbrev">J Headache Pain</journal-id><journal-title-group><journal-title>The Journal of Headache and Pain</journal-title></journal-title-group><issn pub-type="ppub">1129-2369</issn><issn pub-type="epub">1129-2377</issn><publisher><publisher-name>Springer Milan</publisher-name><publisher-loc>Milan</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41257576</article-id><article-id pub-id-type="pmc">12628996</article-id>
<article-id pub-id-type="publisher-id">2162</article-id><article-id pub-id-type="doi">10.1186/s10194-025-02162-5</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>Trigeminal root demyelination is sufficient to induce trigeminal neuralgia-like facial pain in adult rodents</article-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><name><surname>Wang</surname><given-names>Zhi-Yang</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" corresp="yes" equal-contrib="yes"><name><surname>Ding</surname><given-names>You-Quan</given-names></name><address><email>535345252@qq.com</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Wen</surname><given-names>Ju-Mei</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Zheng</surname><given-names>Bing-Wen</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Zhang</surname><given-names>Kun</given-names></name><address><email>1491990570@qq.com</email></address><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Qi</surname><given-names>Jian-Guo</given-names></name><address><email>jgqi@scu.edu.cn</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/011ashp19</institution-id><institution-id institution-id-type="GRID">grid.13291.38</institution-id><institution-id institution-id-type="ISNI">0000 0001 0807 1581</institution-id><institution>Department of Histology, Embryology and Neurobiology, West China School of Basic Medical Sciences &#x00026; Forensic Medicine, </institution><institution>Sichuan University, </institution></institution-wrap>Chengdu, Sichuan 610041 China </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/011ashp19</institution-id><institution-id institution-id-type="GRID">grid.13291.38</institution-id><institution-id institution-id-type="ISNI">0000 0001 0807 1581</institution-id><institution>Department of Radiology, Key Laboratory of Birth Defects and Related Diseases of Women and Children (Sichuan University), Children&#x02019;s Medicine Key Laboratory of Sichuan Province, West China Second University Hospital, </institution><institution>Ministry of Education, Sichuan University, </institution></institution-wrap>Chengdu, Sichuan 610041 China </aff><aff id="Aff3"><label>3</label>Time Medical Ltd, Hong Kong Science and Technology Park, Hong Kong, 999077 China </aff></contrib-group><pub-date pub-type="epub"><day>19</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>19</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>26</volume><issue>1</issue><elocation-id>264</elocation-id><history><date date-type="received"><day>28</day><month>7</month><year>2025</year></date><date date-type="accepted"><day>19</day><month>9</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">Current etiology-centered management guidelines have not brought about satisfactory outcomes for trigeminal neuralgia patients. Therefore, there is an urgent call for pathology-targeted diagnosis and treatment modalities for this intractable disease. Trigeminal root demyelination has been frequently shown or suggested in trigeminal neuralgia patients of diverse etiologies and then naturally regarded as the common pathological cause of this disease. However, this causal relationship has never been validated so far with success in either preclinical or clinical studies. One of the key obstacles is that trigeminal root demyelination per se has not been proven as yet to be sufficient to induce trigeminal neuralgia-like facial pain in animals.</p></sec><sec><title>Methods</title><p id="Par2">Trigeminal root demyelination was directly induced by MRI-informed stereotactic microinjection of (1) myelin-destructive lysophosphatidylcholine into both extrapontine and intrapontine trigeminal roots of adult rats and (2) recombinant adeno-associated virus that genetically ablates myelin-forming oligodendrocytes via apoptosis into trigeminal root entry zones of adult mice. Long-lasting asymmetric eyelid contraction and asymmetric cluster face-stroking were adopted as the affective and motivational behavioral proxies to assess facial pain. More importantly, carbamazepine versus pregabalin treatment and chemical silencing of primary nociceptive afferents were used to ascertain the resemblance of facial pain in rodent models to trigeminal neuralgia in patients.</p></sec><sec><title>Results</title><p id="Par3">Chemically or viral genetically induced demyelination in trigeminal root entry zones were shown to induce facial pain behaviors in adult rats and mice. More importantly, facial pain in these rodent models was shown to resemble patient trigeminal neuralgia in terms of the preferred responsiveness to carbamazepine and the unique requirement of primary nociceptive afferents. Moreover, focal demyelination in adult rat intrapontine trigeminal roots was also shown to induce trigeminal neuralgia-like facial pain.</p></sec><sec><title>Conclusions</title><p id="Par4">Trigeminal root demyelination is sufficient to induce trigeminal neuralgia-like facial pain in adult rodents. Our noteworthy findings would support trigeminal root demyelination as the common pathological cause of trigeminal neuralgia. This advancement will promote pathological conceptualization and clinical management of this etiologically heterogeneous disease as a unified entity of demyelinating disorders. Meanwhile, a group of simple and reliable pathological rodent models were provided for further investigations into trigeminal neuralgia.</p></sec><sec><title>Graphical Abstract</title><p id="Par5">
<graphic position="anchor" xlink:href="10194_2025_2162_Figa_HTML" id="MO1"/>
</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1186/s10194-025-02162-5.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Trigeminal neuralgia</kwd><kwd>Trigeminal root</kwd><kwd>Demyelination</kwd><kwd>Facial pain</kwd><kwd>Carbamazepine</kwd><kwd>Pregabalin</kwd><kwd>Primary nociceptive afferent</kwd></kwd-group><funding-group><award-group><funding-source><institution-wrap><institution-id institution-id-type="FundRef">https://doi.org/10.13039/501100019649</institution-id><institution>Sichuan Provincial Key Laboratory of Development and Regeneration</institution></institution-wrap></funding-source><award-id>SYS20-03</award-id><award-id>SYS19-01</award-id><award-id>SYS22-01</award-id><principal-award-recipient><name><surname>Wang</surname><given-names>Zhi-Yang</given-names></name><name><surname>Ding</surname><given-names>You-Quan</given-names></name><name><surname>Wen</surname><given-names>Ju-Mei</given-names></name></principal-award-recipient></award-group></funding-group><funding-group><award-group><funding-source><institution-wrap><institution-id institution-id-type="FundRef">https://doi.org/10.13039/501100001809</institution-id><institution>National Natural Science Foundation of China</institution></institution-wrap></funding-source><award-id>31571240</award-id><principal-award-recipient><name><surname>Qi</surname><given-names>Jian-Guo</given-names></name></principal-award-recipient></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer-Verlag Italia S.r.l., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Background</title><p id="Par48">Trigeminal neuralgia (TN) is the most common type of chronic orofacial neuropathic pain and also one of the most excruciating pains that human can suffer [<xref ref-type="bibr" rid="CR1">1</xref>&#x02013;<xref ref-type="bibr" rid="CR3">3</xref>]. It is characterized by intermittent sharp attacks (typically lasting &#x0003c; 2 min) of asymmetric electric shock-like severe pain in the distribution territory of one or more trigeminal divisions [<xref ref-type="bibr" rid="CR1">1</xref>&#x02013;<xref ref-type="bibr" rid="CR3">3</xref>]. Historically, TN is recognized as orofacial pain caused by neurovascular compression (NVC) of trigeminal roots [<xref ref-type="bibr" rid="CR4">4</xref>, <xref ref-type="bibr" rid="CR5">5</xref>]. Later, this etiological factor was shown to be neither sufficient nor necessary to cause TN [<xref ref-type="bibr" rid="CR6">6</xref>&#x02013;<xref ref-type="bibr" rid="CR9">9</xref>]. This controversy was addressed with multi-modal magnetic resonance imaging (MRI)-assisted TN subtype classification based on the presence or absence of NVC following current consensus management guidelines [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR10">10</xref>, <xref ref-type="bibr" rid="CR11">11</xref>]. However, this etiological classification of TN into different subtypes has not brought about a significant improvement in its diagnosis and treatment [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>, <xref ref-type="bibr" rid="CR12">12</xref>]. Therefore, there is an urgent call for pathology-targeted diagnosis and treatment modalities to achieve better patient outcomes for this intractable disease [<xref ref-type="bibr" rid="CR5">5</xref>].</p><p id="Par49">Mounting radiological evidence has shown microstructural abnormalities along the whole course of trigeminal roots, including extrapontine segments (especially their central myelin compartments, i.e. root entry zones &#x0003c; REZs&#x0003e;) (Fig. <xref rid="Fig1" ref-type="fig">1</xref>a) and intrapontine segments in TN of diverse definite and ambiguous etiologies [<xref ref-type="bibr" rid="CR13">13</xref>&#x02013;<xref ref-type="bibr" rid="CR18">18</xref>]. Furthermore, histopathological studies of trigeminal root specimens have provided direct evidence of focal demyelination in trigeminal roots in both classical TN and multiple sclerosis (MS)-related TN [<xref ref-type="bibr" rid="CR19">19</xref>&#x02013;<xref ref-type="bibr" rid="CR27">27</xref>]. As a result, trigeminal root demyelination has been naturally regarded as the common pathological cause of this disease by the TN academic and clinical communities [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR5">5</xref>, <xref ref-type="bibr" rid="CR24">24</xref>]. However, this causal relationship has never been validated with success so far in either preclinical or clinical studies.</p><p id="Par50">
<fig id="Fig1"><label>Fig. 1</label><caption><p>MRI-informed stereotactic microinjection of LPC into extrapontine trigeminal roots induces classical TN-like focal demyelination at the trigeminal REZ in adult rats. (<bold>a</bold>) Schematic illustration of extrapontine trigeminal root (especially trigeminal REZ) demyelination seen in TN patients. Created with bioRender.com. (<bold>b</bold>) Schematic illustration of ex vivo MRI in the stereotactic space for extrapontine trigeminal roots in adult SD male rats (250&#x000a0;g). The implanted ceramic ferrule pairs were used as the fiducial markers of the stereotactic space. Arrows on MRI images indicated the implanted ceramic ferrule pairs. Created with bioRender.com. (<bold>c</bold>) In situ MRI anatomy informs coronal angled stereotactic microinjection from the midline into extrapontine trigeminal roots of SD rats at the coronal plane of AP &#x02212;8.00&#x000a0;mm. (<bold>d</bold>) Coronal angled stereotactic microinjection from the midline into adult rat extrapontine trigeminal roots. (<bold>e</bold>) The reliability of coronal angled stereotactic microinjection into adult rat extrapontine trigeminal roots with different doses. (<bold>f</bold>-<bold>h</bold>) Temporal dynamics of trigeminal REZ demyelination (shown by white dashed line) in adult rats. <bold>f</bold>, representative images of neutral red/FluoroMyelin staining; <bold>g</bold>, the FluoroMyelin intensity of focal demyelination lesions at the trigeminal REZ; <bold>h</bold>, the area of focal demyelination lesions at the trigeminal REZ. <italic>N</italic>&#x02009;=&#x02009;3 animals per timepoint. One-way ANOVA followed by Tukey&#x02019;s multiple comparisons test. Compared with D0: <sup>**</sup><italic>P</italic>&#x0003c;0.01; <sup>***</sup>
<italic>P</italic>&#x0003c;0.001; <sup>****</sup>
<italic>P</italic>&#x0003c;0.0001. Compared with D7: <sup>#</sup><italic>P</italic>&#x0003c;0.05; <sup>##</sup>
<italic>P</italic>&#x0003c;0.001; <sup>###</sup>
<italic>P</italic>&#x0003c;0.001; <sup>####</sup>
<italic>P</italic>&#x0003c;0.0001. (i) The confinement of demyelination lesions (shown by red dashed line) into adult rat trigeminal REZs. <italic>N</italic>&#x02009;=&#x02009;3 animals. (<bold>j</bold>) Representative T2 weighted images of trigeminal REZ (shown by yellow dashed line) demyelination seven days after stereotactic microinjection. <italic>N</italic>&#x02009;=&#x02009;3 animals per group. (<bold>k</bold>-<bold>o</bold>) T2 mapping metric and DTI metrics for trigeminal REZ demyelination seven days after stereotactic microinjection. <italic>N</italic>&#x02009;=&#x02009;5 animals for PBS group. <italic>N</italic>&#x02009;=&#x02009;6 animals for LPC group. Independent samples t-test (<bold>k</bold>, <bold>l</bold>, <bold>m</bold>). Mann Whitney test (<bold>n</bold>, <bold>o</bold>). <sup>**</sup>
<italic>P</italic>&#x0003c;0.01; <sup>***</sup>
<italic>P</italic>&#x0003c;0.001</p></caption><graphic xlink:href="10194_2025_2162_Fig1_HTML" id="d33e660"/></fig>
</p><p id="Par51">One of the key obstacles is that trigeminal root demyelination per se has not been proven as yet in animals to be sufficient to induce facial pain that resembles patient TN. First, most previous animal studies focused on modeling the classic etiology of TN, i.e. mechanical compression of trigeminal roots [<xref ref-type="bibr" rid="CR28">28</xref>&#x02013;<xref ref-type="bibr" rid="CR32">32</xref>]. Only a few animal studies aimed to induce trigeminal root demyelination per se via stereotactic microinjection of lysophosphatidic acid (LPA) [<xref ref-type="bibr" rid="CR33">33</xref>] or experimental autoimmune encephalomyelitis (EAE) mouse model [<xref ref-type="bibr" rid="CR34">34</xref>]. However, pleiotropic LPA additionally results in neuronal hyperexcitability in nearby trigeminal ganglia [<xref ref-type="bibr" rid="CR35">35</xref>&#x02013;<xref ref-type="bibr" rid="CR38">38</xref>], and demyelination in EAE mice is not confined to trigeminal roots [<xref ref-type="bibr" rid="CR34">34</xref>]. More importantly, facial pain has not been assessed in most previous animal studies due to the traditional use of the stimuli-evoked head withdrawal as the sole behavioral proxy [<xref ref-type="bibr" rid="CR29">29</xref>&#x02013;<xref ref-type="bibr" rid="CR33">33</xref>]. In fact, this animal behavior involves neural circuits in the brainstem/spinal cord and should be recognized as the proxy of subconscious nociception [<xref ref-type="bibr" rid="CR39">39</xref>&#x02013;<xref ref-type="bibr" rid="CR44">44</xref>]. In contrast, pain is a complex and conscious experience of unpleasantness, which involves neural circuits in cerebral cortex [<xref ref-type="bibr" rid="CR41">41</xref>, <xref ref-type="bibr" rid="CR42">42</xref>, <xref ref-type="bibr" rid="CR45">45</xref>], affectively manifests as unique facial grimace [<xref ref-type="bibr" rid="CR43">43</xref>, <xref ref-type="bibr" rid="CR46">46</xref>, <xref ref-type="bibr" rid="CR47">47</xref>] and motivationally selects coping behaviors to relieve pain itself [<xref ref-type="bibr" rid="CR45">45</xref>, <xref ref-type="bibr" rid="CR48">48</xref>]. What matter most is that the resemblance of facial pain in animal models to patient TN has never been determined due to the poor identification criteria. In fact, TN is unique among neuropathic pain for the following reasons: (1) it is triggered upon the accurate application of innocuous touch to the punctate trigger zone and followed by a refractory period lasting seconds or minutes [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR11">11</xref>]; (2) carbamazepine is far more effective than pregabalin for its relief [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>, <xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR49">49</xref>]; and (3) its neural circuit requires primary nociceptive afferents [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR50">50</xref>&#x02013;<xref ref-type="bibr" rid="CR53">53</xref>] (for details, see Additional file 1: Figure S1). These symptomatic, pharmacological and neuroanatomical hallmarks should be used as clinically relevant criteria to identify TN-like facial pain in animal models.</p><p id="Par52">In our present study, trigeminal root demyelination was directly induced by MRI-informed precise stereotactic microinjection of (1) the widely used myelin-destructive chemical lysophosphatidylcholine (LPC) [<xref ref-type="bibr" rid="CR54">54</xref>&#x02013;<xref ref-type="bibr" rid="CR57">57</xref>] into both extrapontine and intrapontine trigeminal roots of adult rats and (2) recombinant adeno-associated virus (rAAV) that genetically ablates myelin-forming oligodendrocytes via apoptosis into adult mouse REZs. In these chemical and viral genetic rodent models of trigeminal root demyelination, long-lasting asymmetric eyelid contraction and asymmetric cluster face-stroking were adopted as the affective and motivational behavioral proxies to assess facial pain [<xref ref-type="bibr" rid="CR28">28</xref>, <xref ref-type="bibr" rid="CR34">34</xref>, <xref ref-type="bibr" rid="CR47">47</xref>, <xref ref-type="bibr" rid="CR58">58</xref>&#x02013;<xref ref-type="bibr" rid="CR61">61</xref>]. More importantly, carbamazepine versus pregabalin treatment and chemical silencing of primary nociceptive afferents were used to ascertain the resemblance of facial pain in rodent models to patient TN. Taken together, we showed that focal demyelination along the whole course of adult rodent trigeminal roots is sufficient to induce TN-like facial pain. Our noteworthy findings would have potential impacts on mechanistic and translational insights into TN to improve its diagnosis and treatment.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Animals</title><p id="Par53">Seven-week-old, adult male <italic>Sprague-Dawley</italic> (SD) rats weighing 210&#x02013;230 g or adult male C57BL/6 mice weighing 20&#x02013;21 g at the beginning of the study, were obtained from Chengdu Dossy Experimental Animals and used in the present study. Since there was no sex-dependent feature for trigeminal root demyelination in TN patients [<xref ref-type="bibr" rid="CR1">1</xref>&#x02013;<xref ref-type="bibr" rid="CR3">3</xref>], only male rodents were used for convenience in this proof-of-concept study. The animals were housed with free access to standard chow and water in a room with an ambient temperature of 22 &#x000b1; 1 &#x02103; and a standard 12:12 h light/dark cycle. All the animal manipulations were performed with the approval of the Animal Care and Ethics Committee of Sichuan University (approval number: SCU44-2503-04) and in strict accordance with the National Institutes of Health Guide for the Care and Use of Laboratory Animals (publication no. 85&#x02013;23, revised 1985).</p></sec><sec id="Sec4"><title>Ex vivo MRI of adult male SD rat brains in the stereotactic space</title><p id="Par54">In order to establish reliable stereotactic microinjection methods for targeting adult rat trigeminal REZs, randomly chosen male SD rats (<italic>n</italic>&#x02009;=&#x02009;3 animals) weighing about 250&#x000a0;g were used for ex vivo MRI in the stereotactic space (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>b). The ceramic ferrules, originally used in optogenetics, were used here as MRI-compatible fiducial markers of the stereotactic space. Three identical ceramic ferrules (105&#x000a0;&#x003bc;m in diameter, 6&#x000a0;mm in length; RWD, Shenzhen, China) were stereotactically implanted into rat brains at three paired stereotactic positions (AP &#x02212;3.20&#x000a0;mm, ML 2.50&#x000a0;mm left; AP &#x02212;3.20&#x000a0;mm, ML 2.50&#x000a0;mm right; AP &#x02212;7.20&#x000a0;mm, ML 2.50&#x000a0;mm right). These implanted ceramic ferrules were secured on the head by the application of dental cements.</p><p id="Par55">Then, rat heads were prepared for ex vivo MRI in the stereotactic space as described previously [<xref ref-type="bibr" rid="CR62">62</xref>]. In brief, animals were transcardially perfusion-fixed with 4% paraformaldehyde in 0.01 M phosphate buffered saline (PBS). After perfusion-fixation, the whole heads were collected and post-fixed within 4% paraformaldehyde solution at 4 &#x02103; for 48 h. Subsequently, the whole heads were rehydrated for 48 h in 0.01 M PBS solution. Prior to MRI, the whole head was placed into the 50 mL centrifuge tube filled with the magnetic susceptibility matching fluid Fluorinert FC-40 (3 M, Belgium). Throughout the entire process, the brains were kept in situ within the skulls to avoid any possible damage and deformation.</p><p id="Par56">Ex vivo MRI acquisitions were performed on 7.0 Tesla NOVA small animal MRI scanner with a 40&#x000a0;mm diameter transmit/receive volume coil (Time Medical Systems, Inc., USA). T2-weighted anatomical images were acquired using a fast echo sequence with the following parameters: repetition time&#x02009;=&#x02009;3000 ms, echo time&#x02009;=&#x02009;30 ms, field-of-view&#x02009;=&#x02009;40&#x02009;&#x000d7;&#x02009;40&#x000a0;mm, matrix dimension&#x02009;=&#x02009;256&#x02009;&#x000d7;&#x02009;256, slice thickness&#x02009;=&#x02009;0.8&#x000a0;mm, gap&#x02009;=&#x02009;0&#x000a0;mm, number of averages&#x02009;=&#x02009;6, with 14 coronal slices, 10 axial slices, and 14 sagittal slices. Image acquisitions were performed until the alignment of the scanning orientations to the stereotactic space, for which the implanted ceramic ferrule pairs should be shown in the corresponding coronal, sagittal and axial plane.</p></sec><sec id="Sec5"><title>Coronal angled stereotactic microinjection into adult rodent trigeminal roots</title><sec id="Sec6"><title>Coronal angled stereotactic microinjection in adult rats</title><p id="Par57">The entire surgical procedures were performed under isoflurane anesthesia. Following the induction anesthesia, animals were mounted onto a stereotactic apparatus with a single left arm (Model 68025; RWD, Shenzhen, China) in standard stereotactic orientations. For the REZ compartments of extrapontine trigeminal roots in adult rats, a small hole was drilled on the skull at the stereotactic position (AP &#x02212;8.00&#x000a0;mm, ML 0.00&#x000a0;mm). Then, the glass micro-pipette, which was mounted on a nanoliter microinjector (R480; RWD, Shenzhen, China), was inclined left at an angle of 19.5<sup>&#x000b0;</sup>, moved down with a depth of 9.80&#x000a0;mm from the horizontal plane joining bregma and lambda, and therefore targeted trigeminal REZs at the stereotactic coordinate (AP &#x02212;8.00&#x000a0;mm, ML 3.27&#x000a0;mm, DV &#x02212;9.20&#x000a0;mm) (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>c, d). The designated chemicals were stereotactically injected with the R480 nanoliter microinjector at a flow rate of 0.25 &#x000b5;L/min. The glass micro-pipette was withdrawn at least 5&#x000a0;min after the microinjection. The traceable dye, 1% fast blue (F0500, Sigma-Aldrich), was used for the validation of coronal angled stereotactic microinjection into adult rat trigeminal REZs (0.5 or 1 &#x000b5;L, <italic>n</italic>&#x02009;=&#x02009;3 animals per dose). After the microinjection, extrapontine trigeminal roots were exposed and imaged for the distribution of fast blue after transcardial perfusion. LPC (L1381, Sigma-Aldrich) (1%, 1 &#x000b5;L) and PBS (0.01&#x000a0;M, 1 &#x000b5;L) were used to establish chemical rat model of trigeminal REZ demyelination.</p><p id="Par58">For intrapontine trigeminal roots in adult rats, a small hole was drilled on the skull at the stereotactic position (AP &#x02212;9.86&#x000a0;mm, ML 0.00&#x000a0;mm). Then, the glass micro-pipette was inclined left at an angle of 18<sup>&#x000b0;</sup>, moved down with a depth of 9.22&#x000a0;mm from the horizontal plane joining bregma and lambda, and therefore targeted intrapontine trigeminal roots at the stereotactic coordinate (AP &#x02212;9.86&#x000a0;mm, ML 2.85&#x000a0;mm, DV &#x02212;8.77&#x000a0;mm) (Fig.&#x000a0;<xref rid="Fig7" ref-type="fig">7</xref>b). The designated chemicals were stereotactically injected with the R480 nanoliter microinjector at a flow rate of 0.25 &#x000b5;L/min. The glass micro-pipette was withdrawn at least 5&#x000a0;min after the microinjection. The traceable dye, 0.02 &#x000b5;L blue ink, was used for the validation of coronal angled stereotactic microinjection into adult rat intrapontine trigeminal roots (<italic>n</italic>&#x02009;=&#x02009;3 animals). After the microinjection, coronal sections of intrapontine trigeminal roots were prepared and imaged for the localization of blue ink after transcardial perfusion-fixation. LPC (1%, 0.25 &#x000b5;L) and PBS (0.01&#x000a0;M, 0.25 &#x000b5;L) were titrated to establish chemical rat model of intrapontine trigeminal root demyelination (<italic>n</italic>&#x02009;=&#x02009;3 animals per dose).</p></sec><sec id="Sec7"><title>Coronal angled stereotactic microinjection in adult mice</title><p id="Par59">Adult male mice were prepared for coronal angled stereotactic microinjection from the midline the same as in adult male rats. A small hole was drilled on the skull at the stereotactic position (AP &#x02212;4.00&#x000a0;mm, ML 0.00&#x000a0;mm). Then, the glass micro-pipette was inclined left at an angle of 23<sup>&#x000b0;</sup>, moved down with a depth of 5.50&#x000a0;mm from the horizontal plane joining bregma and lambda, and therefore targeted adult mice trigeminal REZs at the stereotactic coordinate (AP &#x02212;4.00&#x000a0;mm, ML 2.10&#x000a0;mm, DV &#x02212;5.00&#x000a0;mm) (Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>c). The designated chemicals or virus were stereotactically injected with the R480 nanoliter micro-injector at a flow rate of 0.10 &#x000b5;L/min. The glass micro-pipette was withdrawn at least 5&#x000a0;min after the microinjection. The traceable dye, 1% fast blue, was used for the validation of coronal angled stereotactic microinjection into adult mice trigeminal REZs (0.1 &#x000b5;L, <italic>n</italic>&#x02009;=&#x02009;3 animals). After the microinjection, extrapontine trigeminal roots were exposed and imaged for the distribution of fast blue after transcardial perfusion. Recombinant AAVs with the promoters from mice myelin basic protein (MBP) gene or human synapsin (hSyn) gene were used to establish viral genetic mouse model of trigeminal REZ demyelination for fluorescent microscopic or ultrastructural studies and TN-like facial pain behavioral tests.</p></sec></sec><sec id="Sec8"><title>In vivo MRI of adult rat trigeminal REZs</title><p id="Par60">In vivo MRI acquisitions were performed on the same small animal MRI scanner as was used for ex vivo MRI studies, with a transmit/receive coil for rat heads. Seven days after stereotactic microinjection of LPC (<italic>n</italic> = 6 animals) or PBS (<italic>n</italic> = 5 animals), adult rats were prepared for in vivo MRI of adult rat trigeminal REZs. Animals were anesthetized with 2 ~ 4% isoflurane and ventilated with O<sub>2</sub> at the flow rate of 0.8&#x02013;1.0 L/min. Animal heads were then fixed in a dedicated cradle and placed within the magnet.</p><p id="Par61">T2-weighted anatomical images were first acquired via a fast echo sequence with the following parameters: repetition time = 3566 ms, echo time = 32 ms, field-of-view = 40 &#x000d7; 40 mm, matrix dimension = 256 &#x000d7; 256, slice thickness = 0.8 mm, gap = 0 mm, number of averages = 6, with 25 coronal slices and 14 axial slices. Then, quantitative T2 mapping was performed via multi-echo spin-echo sequence with the following parameters: repetition time = 2026 ms, echo spacing = 11 ms, 12 echoes, field-of-view = 40 &#x000d7; 40 mm, matrix dimension = 128 &#x000d7; 128, slice thickness = 0.8 mm, gap = 0 mm, number of averages = 1, with 14 axial slices. Diffusion tensor imaging (DTI) was acquired with the following parameters: repetition time = 2000 ms, echo time = 29 ms, field-of-view = 40 &#x000d7; 40 mm, matrix dimension = 128 &#x000d7; 128, slice thickness = 0.8 mm, gap = 0 mm, number of averages = 1, with 4 axial slices.</p><p id="Par62">The metrics of T2 mapping and DTI were quantified using Fiji software (NIH, Bethesda, Maryland) for the REZ compartments in extrapontine trigeminal roots. By definition, trigeminal REZs specifically refer to the anatomical junctions between extrapontine trigeminal roots and the pons [<xref ref-type="bibr" rid="CR63">63</xref>]. For a practical purpose, trigeminal REZs were delineated by three reliable anatomical landmarks, i.e. the transitional zone and the medial/lateral root-pons junction point (Fig. <xref rid="Fig1" ref-type="fig">1</xref>j) [<xref ref-type="bibr" rid="CR63">63</xref>, <xref ref-type="bibr" rid="CR64">64</xref>]. It was performed by a trained individual, who was blinded to animal grouping.</p></sec><sec id="Sec9"><title>FluoroMyelin staining of adult rodent trigeminal roots</title><p id="Par63">In order to determine the temporal pattern of adult rat trigeminal REZ demyelination, rat extrapontine trigeminal roots were obtained for myelin staining before LPC or PBS microinjection (D0) and different days (3/7/14/21/28) after LPC or PBS microinjection (<italic>n</italic> = 3 animals per timepoint &#x000d7; treatment). Notably, 3.5 mL of 1% neutral red (N4638, Sigma-Aldrich) in 0.01 M PBS was intraperitoneally injected two hours before paraformaldehyde-mediated transcardial perfusion-fixation. The fixed rat extrapontine trigeminal roots were imaged for the macroscopic localization of focal demyelination lesions at the trigeminal REZ before further microscopic studies [<xref ref-type="bibr" rid="CR65">65</xref>, <xref ref-type="bibr" rid="CR66">66</xref>]. In order to determine the optimal dose of 1% LPC for chemical rat model of intrapontine trigeminal root demyelination, 1 mm-thick coronal sections of rat intrapontine trigeminal roots around the microinjection site were harvested with the help of rat brain matrix after transcardial perfusion-fixation seven days after the application of different LPC doses (0/0.25/0.50/1 &#x000b5;L; <italic>n</italic> = 3 animals per dose). In order to determine the temporal pattern of adult rat intrapontine trigeminal root demyelination, rat intrapontine trigeminal roots were similarly obtained for myelin staining before LPC or PBS delivery (D0) and different days (3/7/14) after LPC or PBS microinjection (<italic>n</italic> = 3 animals per timepoint &#x000d7; treatment). In order to ascertain viral genetic mouse model of trigeminal REZ demyelination (<italic>n</italic> = 5 animals per group), mouse extrapontine trigeminal roots at the REZ were harvested the same as their rat counterparts two weeks after stereotactic microinjection of apoptotic cell ablation rAAVs.</p><p id="Par64">These tissue samples were post-fixed within 4% paraformaldehyde solution overnight at 4 &#x02103; and then subjected to sucrose gradient dehydration and OCT embedding. Tissue blocks were serially sectioned on a cryostat (CM3050S, Leica) into 10-&#x000b5;m thick, slide-mounted thin sections. Rat extrapontine trigeminal roots were sectioned longitudinally, and rat intrapontine trigeminal roots and mice extrapontine trigeminal roots coronally. Representative sections across the whole volume of the target tissues (the sampling ratio as 1: 10) were selected for FluoroMyelin staining, which is a simple and reliable method for assessing myelin status [<xref ref-type="bibr" rid="CR67">67</xref>, <xref ref-type="bibr" rid="CR68">68</xref>]. In brief, rehydrated sections were incubated in FluoroMyelin&#x02122; staining solution (F34651 &#x00026; F34652; ThermoFisher) for 25 min at room temperature (RT) under light-free conditions. The sections were then rinsed three times with 0.01 M PBS for 10 min and mounted with anti-fading mounting media with DAPI (S2110, Solarbio, Shanghai, China). Notably, before FluoroMyelin staining, rat extrapontine trigeminal root sections were incubated in a destaining solution of 50% ethanol/1% glacial acetic acid for 30 min at RT to reduce the background of neutral red [<xref ref-type="bibr" rid="CR65">65</xref>, <xref ref-type="bibr" rid="CR66">66</xref>].</p><p id="Par65">Stitched images of rat extrapontine or intrapontine trigeminal roots and mice extrapontine trigeminal roots were acquired with a 10X (NA&#x02009;=&#x02009;0.40) Olympus UPLSAPO objective, which was equipped on a fully motorized, Olympus IX-83 wide-filed epifluorescence microscope with a DP80 CCD camera under the monochromatic mode controlled by Olympus cellSens Dimension software. The acquired images were blindly quantified using Fiji software for FluoroMyelin florescence intensities and areas of focal demyelination lesions. Representative images of almost the same anatomical localization in the matched sections were blindly selected for the assembly of the figures in this publication with Adobe Illustrator CC 2014 (Adobe, San Jose, CA). Coherent parallel processing, appropriate controls and blind experimental design were used to minimize systematic biases or errors, allowing relatively feasible inter-group comparisons in these histopathological experiments.</p></sec><sec id="Sec10"><title>Immunostaining and fluorescent imaging of adult mice trigeminal roots</title><p id="Par66">As mentioned above, extrapontine trigeminal roots and the associated pons were obtained from three normal adult mice and processed into 10-&#x000b5;m thick, slide-mounted longitudinal frozen sections. Representative sections of adult mouse trigeminal REZs were selected, permeabilized with 0.2% Triton X-100 in 0.01&#x000a0;M PBS for 10&#x000a0;min and blocked with 10% goat serum in PBST (0.05% Tween 20 in 0.01&#x000a0;M PBS) for 1&#x000a0;h at RT. Then, sections were incubated overnight at 4&#x000a0;&#x000b0;C with mouse monoclonal antibodies against GFAP (1:500; 60190-1-Ig, Proteintech, Wuhan, China) and then rinsed three times every 5&#x000a0;min in 0.01&#x000a0;M PBS. Alexa Fluor 488-conjugated goat anti-mouse IgG secondary antibodies (1:500; ZSGB-BIO, Beijing, China) were applied for 1&#x000a0;h at RT, and then rinsed five times every 10&#x000a0;min in 0.01&#x000a0;M PBS. FluoroMyelin staining was applied as mentioned above and mounted with anti-fading mounting media with DAPI.</p><p id="Par67">In order to ascertain the efficiency and specificity of mice MBP promoters in AAV2/9 serotype (~&#x02009;1.3&#x000a0;kb, PT-1515, BrainVTA; 1.9&#x000a0;kb, XH594, PackGene Biotech; <italic>n</italic>&#x02009;=&#x02009;3 animals per virus &#x000d7; dose) to drive the expression of exogenous genes using EGFP as an example, adult mice extrapontine trigeminal roots and the associated pons were harvested two weeks after virus microinjection and processed into 10-&#x000b5;m thick, slide-mounted longitudinal frozen sections. Representative sections across the whole volume of the target tissues (the sampling ratio as 1: 10) were selected for FluoroMyelin staining or immunostaining with rabbit polyclonal antibodies against CC1 (1:200; OB-PRB070, OasisBiofarm, Hangzhou, China) or NeuN (1:200, OB-PRB039, OasisBiofarm) followed by Alexa Fluor 594-conjugated goat anti-rabbit IgG secondary antibodies (1:500; ZSGB-BIO). After the final round of PBS washing, tissue sections were mounted with anti-fading mounting media with DAPI. For the microinjection of rAAVs that intended to apoptotically ablate oligodendrocytes (<italic>n</italic>&#x02009;=&#x02009;3 animals per group) or neurons (<italic>n</italic>&#x02009;=&#x02009;4 animals per group), tissue sections were processed similarly without additional staining or with NeuN immunostaining and mounted with anti-fading mounting media with DAPI.</p><p id="Par68">Stitched images of mice extrapontine trigeminal roots and the associated pons were acquired the same as mentioned above. The acquired images from cell ablation virus microinjection were blindly quantified using Fiji software for EGFP florescence intensities and areas in adult mice trigeminal REZs [<xref ref-type="bibr" rid="CR63">63</xref>, <xref ref-type="bibr" rid="CR64">64</xref>] or nearby trigeminal nuclei. We followed the same rules of parallelization and blindness as quantitative FluoroMyelin staining to minimize systematic biases or errors to achieve relatively feasible inter-group comparisons.</p></sec><sec id="Sec11"><title>Transmission electron microscopic imaging of adult mice trigeminal REZs</title><p id="Par69">Transmission electron microscopic (TEM) imaging was used to further ascertain viral genetic mouse model of trigeminal REZ demyelination (<italic>n</italic> = 3 animals per group) at the ultrastructural level as we previously reported [<xref ref-type="bibr" rid="CR69">69</xref>]. Two weeks after stereotactic microinjection of apoptotic cell ablation rAAVs, mice extrapontine trigeminal roots at the REZ were harvested via transcardial perfusion-fixation with 1% glutaraldehyde and 4% paraformaldehyde. Harvested tissues were fixed in 2.5% glutaraldehyde and post-fixed in 1% osmium tetroxide for two hours. These tissues were dehydrated in serial ethanol solutions and then embedded in Eponate 812 resin (Ted Pella Inc., Redding, California, USA). Coronal semi-thin Sect. (0.5 &#x003bc;m) were stained with toluidine blue and examined with a bright-field light microscope to identify demyelinated lesions. Then, ultra-thin Sect. (100 nm) were prepared with an ultramicrotome (UC7 RT, Leica) and stained with uranyl acetate and lead citrate. TEM images of demyelinated lesions were obtained with a transmission electron microscope (JEM-1400FLASH, JEOL).</p></sec><sec id="Sec12"><title>Behavioral testing for TN-like facial pain in adult rodents</title><p id="Par70">In this study, we used long-lasting asymmetric eyelid contraction and asymmetric cluster face-stroking as affective and motivational behavioral proxies to assess touch-triggered facial pain (Fig. <xref rid="Fig2" ref-type="fig">2</xref>a; see Additional file 2: Figure S2) [<xref ref-type="bibr" rid="CR28">28</xref>, <xref ref-type="bibr" rid="CR34">34</xref>, <xref ref-type="bibr" rid="CR47">47</xref>, <xref ref-type="bibr" rid="CR58">58</xref>&#x02013;<xref ref-type="bibr" rid="CR61">61</xref>]. According to clinically relevant identification criteria that incorporate TN pharmacological and neuroanatomical hallmarks, carbamazepine versus pregabalin treatment and chemical silencing of primary nociceptive afferents were further used to ascertain the resemblance of facial pain in rodent models to patient TN. All the behavioral tests were performed by an individual, who was blinded to animal grouping, but trained in the correct execution of behavioral tests. The workflow of behavioral testing for TN-like facial pain was illustrated (see Additional file 3: Figure S3).</p><p id="Par71">
<fig id="Fig2"><label>Fig. 2</label><caption><p>Facial pain in rat model of trigeminal REZ demyelination from the perspective of affective-motivational pain. (<bold>a</bold>) Schematic illustration of asymmetric eyelid contraction and asymmetric cluster face-stroking, the surrogate behaviors of the affective-motivational pain used here to assess facial pain seen in TN patients. Created with bioRender.com. (<bold>b</bold>) Schematic view of the custom-made air puff device. Created with bioRender.com. (<bold>c</bold>) Schematic illustration of the application of dynamic and static touch stimuli to the center of the whisker pads. Created with bioRender.com. (<bold>d</bold>) Schematic illustration of the custom-made non-invasive immobilization device to restrain rat head and body movements. (<bold>e</bold>) Representative time lapse images of asymmetric eyelid contraction and asymmetric face stroking evoked by air puffs at 2.50 psi in rat model of trigeminal REZ demyelination. The positive emotional pain response was indicated by long-lasting asymmetric eyelid contraction (more than 10&#x000a0;s) after the cessation of touch stimulation with no delay or a delay less than 5&#x000a0;s. The positive motivational pain response was indicated by asymmetric cluster face-stroking immediately after the initiation of touch stimulation, in which at least two or three rapid strokes were continuously present (indicated by arrows). (<bold>f</bold>-<bold>g</bold>) The durations of asymmetric eyelid contraction and the counts of asymmetric isolated/cluster face-stroking evoked by air puffs of increasing strength in rat model of trigeminal REZ demyelination. <italic>N</italic>&#x02009;=&#x02009;9 animals for LPC microinjection and <italic>N</italic>&#x02009;=&#x02009;6 animals for PBS microinjection. Independent samples t-test for touch stimuli at each strength. <sup>*</sup><italic>P</italic>&#x0003c;0.05; <sup>**</sup><italic>P</italic>&#x0003c;0.01; <sup>***</sup><italic>P</italic>&#x0003c;0.001; <sup>****</sup><italic>P</italic>&#x0003c;0.0001</p></caption><graphic xlink:href="10194_2025_2162_Fig2_HTML" id="d33e1027"/></fig>
</p><p id="Par72">For chemical rat model of trigeminal REZ demyelination, long-lasting asymmetric eyelid contraction and asymmetric cluster face-stroking facial pain were used to assess facial pain evoked by both dynamic innocuous touch stimulus via air puffs of increasing strengths and static innocuous touch stimulus via von Frey filaments of increasing forces in one cohort (<italic>n</italic>&#x02009;=&#x02009;9 animals for LPC microinjection and <italic>n</italic>&#x02009;=&#x02009;6 animals for PBS microinjection). Then, in other two cohorts of this rat model, the responsiveness to carbamazepine versus pregabalin (<italic>n</italic>&#x02009;=&#x02009;6 or 7 animals microinjected with LPC per group) and the requirement of primary nociceptive afferents (<italic>n</italic>&#x02009;=&#x02009;6 animals microinjected with LPC per group) were determined for facial pain evoked by air puffs of the same increasing strengths. For chemical rat model of intrapontine trigeminal root demyelination, facial pain evoked by air puffs of the same increasing strengths was determined in one cohort (<italic>n</italic>&#x02009;=&#x02009;6 animals for either LPC or PBS microinjection), and the responsiveness of facial pain in the form of asymmetric cluster face-stroking evoked by air puffs at 5.00 psi to carbamazepine was determined in another cohort (<italic>n</italic>&#x02009;=&#x02009;6 animals microinjected with LPC per group).</p><p id="Par73">For viral genetic mouse model of trigeminal REZ demyelination, facial pain was assess the same as in its rat counterpart in one cohort (<italic>n</italic>&#x02009;=&#x02009;7 animals for AAV2/9:MBP(~&#x02009;1.3&#x000a0;kb)-Cre-EGFP&#x02009;&#x0003c;&#x02009;PT-6928, BrainVTA&#x02009;&#x0003e;&#x02009;+&#x02009;AAV2/9:CMV-DIO-taCasp3-TEVp mixture&#x02009;&#x0003c;&#x02009;PT-0390, BrainVTA&#x0003e;; <italic>n</italic>&#x02009;=&#x02009;6 animals for AAV2/9:MBP(~&#x02009;1.3&#x000a0;kb)-Cre-EGFP; <italic>n</italic>&#x02009;=&#x02009;7 animals for AAV2/9:hSyn-Cre-EGFP&#x02009;&#x0003c;&#x02009;PT-0156, BrainVTA&#x02009;&#x0003e;&#x02009;+&#x02009;AAV2/9:CMV-DIO-taCasp3-TEVp mixture; <italic>n</italic>&#x02009;=&#x02009;6 animals for AAV2/9-hSyn-Cre-eGFP). Then, in other two cohorts of this mouse model, the responsiveness to carbamazepine versus pregabalin (<italic>n</italic>&#x02009;=&#x02009;6 animals for either vehicle or carbamazepine or pregabalin) and the requirement of primary nociceptive afferents (<italic>n</italic>&#x02009;=&#x02009;8 animals for silencer, <italic>n</italic>&#x02009;=&#x02009;6 animals for vehicle) were determined for facial pain evoked by both air puffs and von Frey filaments.</p><p id="Par74">Facial pain behavioral tests were performed seven days after LPC/PBS microinjection in adult rats or two weeks after virus microinjection in adult mice. Before facial pain assessment, all the microinjected animals were allowed for two acclimation sessions (before and after microinjection). Individual acclimation session includes serial habituation to the testing environment, the experimental devices and the experimental manipulations except the innocuous touch stimuli once a day for four consecutive days. At the end of facial pain behavioral tests, intraperitoneally injected neutral red was used to macroscopically verify focal demyelination lesions at the trigeminal REZ or in intrapontine trigeminal roots in LPC microinjected rats. For mice, viral EGFP labeling of adult mice trigeminal roots and the associated pons were analyzed with fluorescent imaging. Only data from animals with trigeminal root demyelination or nearby neuronal ablation were included in further statistical analysis. Notably, almost all the animals were included in final statistical analysis due to the reliability of MRI-informed stereotactic microinjection.</p><p id="Par75">Carbamazepine (PHR1067, Sigma-Aldrich) and pregabalin (P831453; Macklin, Shanghai, China) were dissolved in 45% (w/v) 2-hydroxypropyl-&#x003b2;-cyclodextrin (abs42007271; Absin Bioscience, Shanghai, China) solution in saline. Drugs (carbamazepine: 36 mg/kg for rats, 26 mg/kg for mice; pregabalin: 10 mg/kg for rats, 14 mg/kg for mice) and the corresponding vehicle (2.5 mL for rats, 1.5mL for mice) were given intraperitoneally at the end of before-drug facial pain measurement. One hour after drug application, the after-drug facial pain was further determined. To determine the requirement of primary nociceptive afferents, the chemical silencer, membrane-impermeable lidocaine derivative QX-314 (2% for rats and 0.2% for mice; L5783, Sigma-Aldrich) plus 0.1% (1 &#x000b5;g/&#x000b5;L) TRPV1 agonist capsaicin (SC8100, Solarbio), was dissolved in the vehicle solution consisting of 20% ethanol and 5% Tween-20 in saline [<xref ref-type="bibr" rid="CR70">70</xref>]. Chemical silencer or vehicle of 10 &#x000b5;L was subcutaneously injected into the corresponding (left-sided) whisker pads using a Hamilton microliter syringe at the end of pre-silencing facial pain measurement. One hour after chemical silencer application, the post-silencing facial pain was further determined.</p><p id="Par76">The experimental devices were prepared for the assessment of facial pain triggered by dynamic and static innocuous touch stimuli. The air-puff device was custom-made with a gas controller (ML-5000XII, Musashi, Japan) to control the pressure and duration of air puffs blowing out from the connecting 26G blunt needle (Fig. <xref rid="Fig2" ref-type="fig">2</xref>b; see Additional file 4: Figure S4). The custom-made air-puff device and von Frey filaments (DanMic Global; California, USA) were used to deliver dynamic and static innocuous touch stimuli to the center of the whisker pads ipsilateral to the microinjected side (Fig. <xref rid="Fig2" ref-type="fig">2</xref>c; see Additional file 3: Figure S3; see Additional file 5: Figure S5a). For more reliable facial pain behavioral tests, non-invasive immobilization devices were custom-made to restrain rodent head and body movements and therefore to facilitate precise and consistent targeting of sensory stimuli to the rodent face (see Additional file 5: Figure S5; see Additional file 6: Figure S6) [<xref ref-type="bibr" rid="CR59">59</xref>, <xref ref-type="bibr" rid="CR71">71</xref>, <xref ref-type="bibr" rid="CR72">72</xref>]. The custom-made rat fixation device used a body immobilizer to minimize body movements. Instead of invasive and breakable head-plates or head-rings, a small pet vest was used to retrain the rat head and neck to the fixation post via an adjustable strapping tape (see Additional file 6: Figure S6). For mice, a simple body fixation device was used to minimize head and body movements (see Additional file 5: Figure S5b). The animals were allowed to run with their forelimbs on a roller to minimize the stress from the fixation.</p><p id="Par77">For individual session of facial pain behavioral test (see Additional file 3: Figure S3e), the designated touch stimuli were applied after the acclimatization to the testing environment (lighting:15&#x02009;~&#x02009;20&#x000a0;lx) and devices around the onset of the dark phase (6:00 pm). For dynamic touch stimulation, air puffs of 4&#x000a0;s were delivered through the blunt needle perpendicular to the center of the whisker pads with a distance of 1&#x000a0;cm. For static touch stimulation, the von Frey filaments were perpendicularly applied to the center of the whisker pads with enough force to cause slight buckling against the pads, and held for about 1&#x000a0;s. Testing began with the subtlest air puffs or von Frey filaments and progressed to air puffs of next pressure or von Frey filaments of next force with a resting period of more than 30&#x000a0;s. For air puffs of each pressure, facial pain behavioral tests were repeated five times with an interval of 10&#x000a0;s for both rats and mice. For von Frey filaments of each force, facial pain behavioral tests were repeated ten times for rats and five times for mice with an interval of 10&#x000a0;s. The interval of 10&#x000a0;s was set arbitrarily to avoid the negative impact of the potential refractory period on facial pain behavioral tests.</p><p id="Par78">A video camera was positioned in front of the rodent faces to record asymmetric eyelid contraction and asymmetric face stroking. The positive emotional pain response was indicated by long-lasting asymmetric eyelid contraction (more than 10 s) after the cessation of touch stimulation with no delay or a delay less than 5 s [<xref ref-type="bibr" rid="CR28">28</xref>, <xref ref-type="bibr" rid="CR45">45</xref>, <xref ref-type="bibr" rid="CR47">47</xref>]. The time periods from the contraction of eyelid after the cessation of touch stimulation to its recovery to the resting state was quantified as the duration of asymmetric eyelid contraction. Replicates were averaged as the duration of asymmetric eyelid contraction for touch stimuli of each strength. We set a 10-second threshold of asymmetric eyelid contraction for positive versus negative emotional pain response, since the average durations of asymmetric eyelid contraction were no more than 10 s in most PBS or control virus microinjection groups and no less than 10 s in most LPC or cell ablation virus microinjection groups. This threshold setting was further validated by the presence of other facial action units in the rat grimace scale of pain, such as nose/cheek flattening and ear flopping, in LPC but not PBS microinjected animals (see Additional file 7: Figure S7). In fact, after the cessation of touch stimulation, the brief eyelid contraction in PBS or control virus microinjected animals is the continuum of asymmetric eyelid contraction during the stimulation period in both animal groups, which represents the eye blinking reflex to the spread of touch stimuli from air puffs and the experimenter behaviors [<xref ref-type="bibr" rid="CR73">73</xref>]. The positive motivational pain response was indicated by asymmetric cluster face-stroking immediately after the initiation of touch stimulation, in which at least two or three rapid strokes were continuously present. The counts of asymmetric isolated and cluster face-stroking were quantified and averaged for touch stimuli of each strength.</p></sec><sec id="Sec13"><title>Statistical analysis</title><p id="Par79">All the quantitative data were presented as mean&#x02009;&#x000b1;&#x02009;S.E.M. Since in situ MRI anatomy of adult rodent trigeminal roots in the stereotactic space enabled targeted delivery of chemicals or virus in a reproducible manner, neither priori nor post hoc verification of the microinjection accuracy was performed expect for behavioral tests. Statistical comparisons were made with GraphPad Prism 10.1.0 (GraphPad Software, Inc.; Northampton, MA) after testing normality and homogeneity of variance. One-way analysis of variance (ANOVA) followed by Tukey&#x02019;s multiple comparisons test was used for temporal data of adult rat trigeminal REZ demyelination. Independent samples t-test and Mann Whitney test were used for the comparison between LPC and PBS microinjected rats in in vivo MRI. Independent samples t-test was used for behavioral tests after stereotactic microinjection of LPC or PBS in rats and histological comparisons between oligodendrocyte/neuron ablation virus microinjection or control virus microinjection. One-way ANOVA followed by Tukey&#x02019;s multiple comparisons test was used for inter-group comparisons for touch stimuli at each strength in viral genetic mouse model of trigeminal REZ demyelination. Two-way repeated-measures analysis of variance (2&#x000a0;W-RM ANOVA) followed by &#x00160;&#x000ed;d&#x000e1;k&#x02019;s multiple comparisons test was used for behavioral tests after the application of drugs or chemical silencer in both rats and mice. For all the data analysis, <italic>P</italic> value less than 0.05 was considered as statistical significance. All the statistical graphs were plotted using GraphPad Prism and assembled into the figures of this publication with Adobe Illustrator CC.</p></sec></sec><sec id="Sec14"><title>Results</title><sec id="Sec15"><title>MRI-informed stereotactic microinjection of LPC into extrapontine trigeminal roots induces classical TN-like focal demyelination at the trigeminal REZ in adult rats</title><p id="Par80">Trigeminal REZ demyelination was first modeled via targeted delivery of myelin-destructive LPC into extrapontine trigeminal roots of adult rats, since it was very frequently shown in classical TN induced by NVC, the most common subtype of TN [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR10">10</xref>, <xref ref-type="bibr" rid="CR11">11</xref>] (Fig. <xref rid="Fig1" ref-type="fig">1</xref>a). In the pilot study, upright stereotactic microinjection, which is conventionally used by neuroscientists, failed to reliably deliver chemicals into extrapontine trigeminal roots (at the coronal plane of AP &#x02212;7.20 mm) (for details, see Additional file 8: Figure S8). Then, ex vivo MRI of SD rat brains in the stereotactic space was performed with the help of the implanted fiducial markers to inform a reliable channel to approach extrapontine trigeminal roots, especially trigeminal REZs (Fig. <xref rid="Fig1" ref-type="fig">1</xref>b). The coronal 19.5<sup>&#x000b0;</sup> angled stereotactic microinjection from the midline at the coronal plane of AP &#x02212;8.00 mm was expected to medially approach adult rat extrapontine trigeminal roots at the trigeminal REZ without the interference of obstruction and deviation (Fig. <xref rid="Fig1" ref-type="fig">1</xref>c; see Additional file 8: Figure S8c, e; see Additional file 9: Figure S9). Fast blue tracing was used to test the reliability of this MRI-informed stereotactic microinjection method to target adult rat trigeminal REZs (Fig. <xref rid="Fig1" ref-type="fig">1</xref>d), and the dose of 1 &#x000b5;L was shown to target larger DV areas of trigeminal REZs than the dose of 0.5 &#x000b5;L (Fig. <xref rid="Fig1" ref-type="fig">1</xref>e).</p><p id="Par81">With MRI-informed coronal angled stereotactic microinjection method, 1 &#x000b5;L of 1% LPC was specifically delivered into extrapontine trigeminal roots of adult rats to chemically induce focal demyelination at the trigeminal REZ. Histopathological methods were first used to characterize demyelination features. Neutral red staining was used to efficiently localize focal demyelination lesions at the trigeminal REZ for both the macroscopic and microscopic scale (Fig. <xref rid="Fig1" ref-type="fig">1</xref>f; see Additional file 10: Figure S10). Then, FluoroMyelin staining was further used to quantify a temporal pattern of demyelination that is consistent with LPC-induced chemical demyelination in other neural tissues [<xref ref-type="bibr" rid="CR54">54</xref>, <xref ref-type="bibr" rid="CR56">56</xref>, <xref ref-type="bibr" rid="CR57">57</xref>] (Fig. <xref rid="Fig1" ref-type="fig">1</xref>f, g, h; see Additional file 10: Figure S10). Three days after the microinjection, there are apparent lesions of focal demyelination at the trigeminal REZ (Fig. <xref rid="Fig1" ref-type="fig">1</xref>g, h; see Additional file 10: Figure S10). Seven days after the microinjection, focal demyelination lesions reach their maximum in terms of intensity (lesion fluorescence, Fig. <xref rid="Fig1" ref-type="fig">1</xref>f, g; see Additional file 10: Figure S10) and extensity (lesion area, Fig. <xref rid="Fig1" ref-type="fig">1</xref>f, h; see Additional file 10: Figure S10). It is worth noting that these focal demyelination lesions are confined exclusively in the central myelin compartments of extrapontine trigeminal roots (Fig. <xref rid="Fig1" ref-type="fig">1</xref>i). Then, focal demyelination lesions gradually resolve at the 14th, 21&#x02009;st and 28th day after the microinjection (Fig. <xref rid="Fig1" ref-type="fig">1</xref>g, h; see Additional file 10: Figure S10). There are no visible lesions in PBS microinjected animals for all the time (data not shown). Therefore, MRI-informed stereotactic microinjection of LPC into extrapontine trigeminal roots induces focal demyelination at the trigeminal REZ in adult rats.</p><p id="Par82">In vivo MRI was further used to determine clinical resemblance of chemical rat model of trigeminal REZ demyelination. Qualitative and quantitative T2-weighted imaging were first used to identify these focal demyelination lesions at the peak time. In consistent with genetically induced demyelination [<xref ref-type="bibr" rid="CR74">74</xref>], there are significantly higher T2-weighted signals specifically in the territory of trigeminal REZs after the microinjection of LPC but not PBS (Fig. <xref rid="Fig1" ref-type="fig">1</xref>j, k). Then, these focal demyelination lesions at the trigeminal REZ were further subjected to DTI assessment of microstructural abnormalities compatible with demyelination [<xref ref-type="bibr" rid="CR75">75</xref>]. Fractional anisotropy (FA), the metric for the overall integrity of the white matter microstructure [<xref ref-type="bibr" rid="CR76">76</xref>], was shown to be significantly decreased (Fig. <xref rid="Fig1" ref-type="fig">1</xref>l). Moreover, radial diffusivity (RD), the metric for myelination [<xref ref-type="bibr" rid="CR77">77</xref>], was shown to be obviously increased (Fig. <xref rid="Fig1" ref-type="fig">1</xref>m). However, axial diffusivity (AD), the metric for axon integrity [<xref ref-type="bibr" rid="CR77">77</xref>], and mean diffusivity (MD), the metric for neuroinflammation [<xref ref-type="bibr" rid="CR77">77</xref>], were shown to remain unaffected (Fig. <xref rid="Fig1" ref-type="fig">1</xref>n, o). These DTI metric changes in this chemical rat model were in consistent with DTI metric changes compatible with trigeminal REZ demyelination seen in classical TN patients [<xref ref-type="bibr" rid="CR14">14</xref>]. Therefore, MRI-informed stereotactic microinjection of LPC into extrapontine trigeminal roots induces classical TN-like focal demyelination at the trigeminal REZ in adult rats.</p></sec><sec id="Sec16"><title>Focal demyelination at the trigeminal REZ is sufficient to induce facial pain in adult rats</title><p id="Par83">Brief shock-like pain with a refractory period triggered by innocuous touch in the punctate trigger zone has been suggested to qualify as the diagnosis criterion for clinically established TN [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR11">11</xref>]. In contrast, spontaneous pain paroxysms have not been shown in isolation in TN patients and may in fact be triggered by very subtle touch stimuli [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR11">11</xref>]. Therefore, innocuous touch-triggered pain rather than spontaneous pain was measured in the present study in comparison with previous studies [<xref ref-type="bibr" rid="CR28">28</xref>, <xref ref-type="bibr" rid="CR30">30</xref>]. In brief, long-lasting asymmetric eyelid contraction and asymmetric cluster face-stroking (Fig. <xref rid="Fig2" ref-type="fig">2</xref>a; see Additional file 2: Figure S2) were used as affective and motivational behavioral proxies for facial pain, which was triggered by dynamic and static innocuous touch stimulus from the custom-made air-puff device and von Frey filaments (Fig. <xref rid="Fig2" ref-type="fig">2</xref>b, c, d; see Additional file 3: Figure S3) [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR11">11</xref>, <xref ref-type="bibr" rid="CR28">28</xref>, <xref ref-type="bibr" rid="CR34">34</xref>, <xref ref-type="bibr" rid="CR47">47</xref>, <xref ref-type="bibr" rid="CR58">58</xref>&#x02013;<xref ref-type="bibr" rid="CR61">61</xref>].</p><p id="Par84">When innocuous air puffs of increasing strengths (ranging from 1.25 to 6.25 psi) were applied to the corresponding (left-sided) whisker pads, long-lasting asymmetric eyelid contraction (more than 10&#x000a0;s) was shown to have an average duration of approximately 30&#x000a0;s in LPC but not PBS microinjected animals after the cessation of touch stimulation (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>e, upper panel &#x00026; Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>f; see Additional file 20: Movie S1). Moreover, asymmetric cluster face-stroking, in which at least two or three rapid strokes were continuously present, was evoked in LPC but not PBS microinjected animals (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>e, lower panel &#x00026; Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>g; see Additional file 20: Movie S1). Notably, long-lasting asymmetric eyelid contraction (approximately 20&#x000a0;s on average) and asymmetric cluster face-stroking were obviously but very unreliably evoked by static innocuous touch stimuli in the form of von Frey filaments ranging from 0.008&#x000a0;g to 0.40&#x000a0;g (see Additional file 11: Figure S11; see Additional file 21: Movie S2). Therefore, focal demyelination at the trigeminal REZ is sufficient to induce touch-triggered facial pain in adult rats.</p><p id="Par85">Long-lasting asymmetric eyelid contraction and asymmetric cluster face-stroking assessed facial pain symptoms seen not only in TN patients but also in other facial pain patients. It is necessary to use TN symptomatic hallmarks, i.e. the refractory period and the punctate trigger zone, to ascertain the symptomatic resemblance of facial pain in this rat model to patient TN. In our pilot study, we incidentally observed that facial pain cannot be triggered again by the immediate delivery of touch stimuli after the recovery of former facial pain (see Additional file 22: Movie S3). This qualitative result implies the existence of the refractory period for facial pain in this rat model. Moreover, there were much more non-responsive and low-responsive animals microinjected with LPC during point-like touch stimulation (von Frey filaments) compared with area-based touch stimulation (air puffs) (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>c, f, g; see Additional file 11: Figure S11). The existence of a punctate trigger zone for facial pain in this rat model may account for this difference, since it is more difficult to precisely deliver point-like than area-based touch stimuli to a punctate trigger zone which would have variable locations relative to the stimulation target, i.e. the center of the whisker pads (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>c; see Additional file 11: Figure S11a). However, both the refractory period and the punctate trigger zone cannot be quantified or mapped due to incomplete head fixation, manual but not automatic touch stimulation and direct exposure to experimenters and testing environment. Therefore, facial pain in chemical rat model of trigeminal REZ demyelination may resemble patient TN in terms of TN symptomatic hallmarks.</p></sec><sec id="Sec17"><title>Facial pain in chemical rat model of trigeminal REZ demyelination resembles patient TN in terms of Pharmacological and neuroanatomical hallmarks</title><p id="Par86">What matters most is to verify whether facial pain possibly with TN symptomatic hallmarks in rat model of trigeminal REZ demyelination really resembles patient TN. We intended to include pharmacological and neuroanatomical hallmarks of patient TN in clinically relevant identification criteria to address this key question. In brief, carbamazepine is far more effective than pregabalin in the relief of patient TN [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>, <xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR49">49</xref>] (Fig. <xref rid="Fig3" ref-type="fig">3</xref>a, b), and the neural circuit basis for patient TN requires primary nociceptive afferents (Fig. <xref rid="Fig3" ref-type="fig">3</xref>g; for details, see Additional file 1: Figure S1) [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR50">50</xref>&#x02013;<xref ref-type="bibr" rid="CR53">53</xref>]. As far as we know, we pioneered the use of pharmacological and neuroanatomical hallmarks of patient TN as clinically relevant criteria to identify TN-like facial pain.</p><p id="Par87">
<fig id="Fig3"><label>Fig. 3</label><caption><p>Facial pain in rat model of trigeminal REZ demyelination recapitulated TN pharmacological and neuroanatomical hallmarks. (<bold>a</bold>) Schematic illustration of mechanisms of action for the anticonvulsant carbamazepine (a voltage-gated sodium channel inhibitor and GABA agonist) and the analgesic pregabalin (a GABA analog and voltage-gated calcium channel inhibitor). Created with bioRender.com. (<bold>b</bold>) Schematic illustration of TN pharmacological hallmark. TN is unique among neuropathic pain in that the anti-epileptic drug carbamazepine is far more effective than the analgesic drug pregabalin for pain relief. Created with bioRender.com. (<bold>c</bold>-<bold>f</bold>) The responsiveness of facial pain to carbamazepine versus pregabalin in rat model of trigeminal REZ demyelination. Animals microinjected with LPC: <italic>N</italic>&#x02009;=&#x02009;6 for vehicle, <italic>N</italic>&#x02009;=&#x02009;7 for carbamazepine and <italic>N</italic>&#x02009;=&#x02009;6 for pregabalin. 2&#x000a0;W-RM ANOVA followed by &#x00160;&#x000ed;d&#x000e1;k&#x02019;s multiple comparisons test. After-drug versus before-drug: <sup>*</sup><italic>P</italic>&#x0003c;0.05; <sup>***</sup>
<italic>P</italic>&#x0003c;0.001; <sup>****</sup>
<italic>P</italic>&#x0003c;0.0001. (<bold>g</bold>) Schematic illustration of the unique drug features of TN. TN is unique among neuropathic pain in that its neural circuit requires primary nociceptive afferents. Created with bioRender.com. (<bold>h</bold>) Schematic illustration of chemical silencer for primary nociceptive afferents (mainly TRPV1<sup>+</sup>). The charged, membrane-impermeable lidocaine derivative QX-314 is allowed to enter in primary nociceptive afferents through the pore of the TRPV1 channel that is opened by the co-applied TRPV1 agonist capsaicin, resulting in selective neuronal silencing. Created with bioRender.com. (<bold>i</bold>-<bold>l</bold>) The requirement of primary nociceptive afferents for facial pain in rat model of trigeminal REZ demyelination. <italic>N</italic>&#x02009;=&#x02009;6 animals microinjected with LPC for either vehicle or chemical silencer. 2&#x000a0;W-RM ANOVA followed by &#x00160;&#x000ed;d&#x000e1;k&#x02019;s multiple comparisons test. Post-silencing versus pre-silencing: <sup>**</sup><italic>P</italic>&#x0003c;0.01; <sup>***</sup><italic>P</italic>&#x0003c;0.001; <sup>****</sup><italic>P</italic>&#x0003c;0.0001</p></caption><graphic xlink:href="10194_2025_2162_Fig3_HTML" id="MO4"/></fig>
</p><p id="Par88">First, the drug responsiveness of facial pain in chemical rat model of trigeminal REZ demyelination was tested following carbamazepine versus pregabalin treatment. While carbamazepine was shown to substantially reduce the duration of asymmetric eyelid contraction evoked by the air puff at every strength to ~&#x02009;20&#x000a0;s, pregabalin was shown to minimally reduce the duration of asymmetric eyelid contraction evoked by the air puff only at 2.5 psi and 3.75 psi (Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>c, d; see Additional file 12: Figure S12a; see Additional file 23: Movie S4). Moreover, carbamazepine but not pregabalin was shown to significantly reduce asymmetric cluster face-stroking evoked by the air puff at every strength (Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>e, f; see Additional file 12: Figure S12b; see Additional file 23: Movie S4). Therefore, carbamazepine is far more effective than pregabalin to relieve facial pain in chemical rat model of trigeminal REZ demyelination.</p><p id="Par89">Then, the requirement of primary nociceptive afferents for facial pain in chemical rat model of trigeminal REZ demyelination was tested via chemical silencing (Fig. <xref rid="Fig3" ref-type="fig">3</xref>g; see Additional file 1: Figure S1). Since TRPV1<sup>+</sup> primary afferents represent the main population of A-&#x003b4;/C nociceptors, the charged, membrane-impermeable lidocaine derivative QX-314 is allowed to enter into primary nociceptive neurons through the pore of the TRPV1 channel that is opened by the co-applied TRPV1 agonist capsaicin and therefore selectively silences primary nociceptive afferents (Fig. <xref rid="Fig3" ref-type="fig">3</xref>h; see Additional file 13: Figure S13) [<xref ref-type="bibr" rid="CR70">70</xref>]. In the present study, a mixture of 2% QX-314 and 0.1% capsaicin was injected into the rat whisker pads. Chemical silencing of primary nociceptive afferents (mainly TRPV1<sup>+</sup>) was shown to substantially reduce asymmetric eyelid contraction and asymmetric cluster face-stroking evoked by the air puff at every strength (Fig. <xref rid="Fig3" ref-type="fig">3</xref>i, j, k, l; see Additional file 14: Figure S14; see Additional file 24: Movie S5). Therefore, primary nociceptive afferents (mainly TRPV1<sup>+</sup>) are required for facial pain in chemical rat model of trigeminal REZ demyelination.</p><p id="Par90">Taken together, facial pain in chemical rat model of trigeminal REZ demyelination recapitulates pharmacological and neuroanatomical hallmarks of patient TN. Therefore, classical TN-like focal demyelination at the trigeminal REZ is sufficient to induce TN-like facial pain in adult rats.</p></sec><sec id="Sec18"><title>Viral genetic apoptotic ablation of myelin-forming oligodendrocytes induces trigeminal REZ demyelination in adult mice</title><p id="Par91">It is worth noting that LPC has been shown to damage brain cells other than myelin-forming oligodendrocytes, such as neurons [<xref ref-type="bibr" rid="CR78">78</xref>], astrocytes and endothelial cells [<xref ref-type="bibr" rid="CR79">79</xref>]. The non-specific cell damage during this chemical demyelination process prevented attributing TN-like facial pain to trigeminal root demyelination per se. Then, we intended to use a rAAV-based conditional genetic tool, which uses mice MBP gene promoter in AAV2/9 serotype and is expected to specifically ablate myelin-forming oligodendrocytes via apoptosis to precisely induce trigeminal root demyelination (Fig. <xref rid="Fig4" ref-type="fig">4</xref>a). Since adult mouse trigeminal REZ is more delicate than its rat counterpart (Fig. <xref rid="Fig4" ref-type="fig">4</xref>b), in situ MRI anatomical geometry [<xref ref-type="bibr" rid="CR80">80</xref>] was used again to inform a coronal angled stereotactic microinjection method for the precise delivery of rAAV (Fig. <xref rid="Fig4" ref-type="fig">4</xref>c, d).</p><p id="Par92">
<fig id="Fig4"><label>Fig. 4</label><caption><p>Viral genetic ablation of myelin-forming oligodendrocytes induces trigeminal REZ demyelination in adult mice. (<bold>a</bold>) Schematic illustration of the rAAV-based conditional genetic tool that utilizes mice MBP gene promoter in AAV2/9 serotype and is expected to specifically ablate myelin-forming oligodendrocytes via apoptosis to more precisely induce trigeminal REZ demyelination. Created with bioRender.com. (<bold>b</bold>) The very delicate trigeminal REZs in adult mice. (<bold>c</bold>) In situ MRI anatomy informs coronal angled stereotactic microinjection from the midline into adult mice trigeminal REZs at the coronal plane of AP &#x02212;4.00&#x000a0;mm. (<bold>d</bold>) The reliability of coronal angled stereotactic microinjection into adult mice trigeminal REZs. (<bold>e</bold>-<bold>h</bold>) The efficiency and specificity of ~&#x02009;1.3&#x000a0;kb mouse MBP gene promoter in AAV2/9 serotype to drive the expression of exogenous genes with EGFP as an example after stereotactic microinjection into adult mice trigeminal REZs. e, EGFP expression around trigeminal REZs after stereotactic microinjection of different doses of AAV2/9:MBP(~&#x02009;1.3&#x000a0;kb)-EGFP; <bold>f</bold>, EGFP expression along the entire course of adult mice trigeminal roots after stereotactic microinjection of AAV2/9:MBP(~&#x02009;1.3&#x000a0;kb)-EGFP (~&#x02009;5E&#x02009;+&#x02009;12 vg/ml, 0.1&#x000a0;&#x000b5;l); <bold>g</bold>, co-staining with the OL marker CC1; <bold>h</bold>, co-staining with the neuronal marker NeuN. <italic>N</italic>&#x02009;=&#x02009;3 animals per group or experiment. (<bold>i</bold>-<bold>k</bold>) Viral genetic ablation of myelin-forming oligodendrocytes in adult mice trigeminal REZs. White dashed lines, trigeminal REZs plus S5; red dashed lines, Pr5. <italic>N</italic>&#x02009;=&#x02009;3 animals per group. Independent samples t-test. <sup>**</sup><italic>P</italic>&#x0003c;0.01. (<bold>l</bold>-<bold>o</bold>) Trigeminal REZ demyelination via viral genetic ablation of myelin-forming oligodendrocytes in adult mice. <bold>l</bold>-<bold>n</bold>, FluoroMyelin staining, <italic>N</italic>&#x02009;=&#x02009;5 animals per group; <bold>o</bold>, TEM analysis, <italic>N</italic>&#x02009;=&#x02009;3 animals per group. Independent samples t-test. <sup>**</sup><italic>P</italic>&#x0003c;0.01</p></caption><graphic xlink:href="10194_2025_2162_Fig4_HTML" id="d33e1548"/></fig>
</p><p id="Par93">In line with previous studies [<xref ref-type="bibr" rid="CR81">81</xref>&#x02013;<xref ref-type="bibr" rid="CR85">85</xref>], ~ 1.9 kb mouse MBP gene promoter showed a higher efficiency than its ~ 1.3 kb counterpart in AAV2/9 serotype (~ 5E + 12 vg/mL, 0.1 &#x000b5;L) to drive the expression of exogenous genes in oligodendrocytes two weeks after virus microinjection (Fig. <xref rid="Fig4" ref-type="fig">4</xref>e, g; see Additional file 15: Figure S15a, b). Notably, 0.1 &#x000b5;L but not 0.2 &#x000b5;L of AAV2/9 recombinant virus with ~ 1.3 kb mouse MBP gene promoter (~ 5E + 12 vg/mL) drove oligodendroglial expression of exogenous genes in the territory of adult mouse trigeminal REZs (Fig. <xref rid="Fig4" ref-type="fig">4</xref>e, f). In contrast, 0.1 &#x000b5;L of AAV2/9 recombinant virus with ~ 1.9 kb mouse MBP gene promoter (~ 5E + 12 vg/mL) drove oligodendroglial expression of exogenous genes beyond the territory of adult mouse trigeminal REZs (see Additional file 15: Figure S15a). Notably, AAV2/9 recombinant virus with both MBP promoters did not drive any expression of exogenous genes in Schwann cells (SCs) from the peripheral myelin compartments of extrapontine trigeminal roots (Fig. <xref rid="Fig4" ref-type="fig">4</xref>e, f; see Additional file 15: Figure S15a). Unexpectedly, AAV2/9:MBP-EGFP of either ~ 1.3 or ~ 1.9 kb MBP promoter labeled nearby neurons in trigeminal principal sensory nucleus (Pr5) and the rostral parts of trigeminal spinal nucleus (Sp5) in adult mice (Fig. <xref rid="Fig4" ref-type="fig">4</xref>e, f, h; see Additional file 15: Figure S15a, c).</p><p id="Par94">Due to the gene payload limit for high-quality rAAV packaging [<xref ref-type="bibr" rid="CR86">86</xref>], the ~ 1.3 kb mice MBP gene promoter was selected to drive the expression of Cre recombinase for amplified expression and conditional activation of apoptosis-triggering taCaspase3 [<xref ref-type="bibr" rid="CR87">87</xref>] (Fig. <xref rid="Fig4" ref-type="fig">4</xref>a). This rAAV-based conditional genetic tool, i.e. AAV2/9:MBP(~ 1.3 kb)-Cre-EGFP + AAV2/9:CMV-DIO-taCasp3-TEVp mixture (for each virus: ~5E + 12 vg/mL, 0.1 &#x000b5;L), was microinjected into trigeminal REZs of adult mice. Two weeks after virus microinjection [<xref ref-type="bibr" rid="CR88">88</xref>&#x02013;<xref ref-type="bibr" rid="CR90">90</xref>], EGFP-labeled oligodendrocytes were shown to be significantly ablated in the territory of adult mouse trigeminal REZs (Fig. <xref rid="Fig4" ref-type="fig">4</xref>i, j, k). As a result, FluoroMyelin staining of trigeminal REZs at the same time showed significant loss of myelin lipids in mice microinjected with the cell ablation virus mixture (Fig. <xref rid="Fig4" ref-type="fig">4</xref>l, m, n). More importantly, TEM ultrastructural analysis at the same time showed obvious demyelinating micro-lesions at the trigeminal REZ in mice microinjected with the cell ablation virus mixture (Fig. <xref rid="Fig4" ref-type="fig">4</xref>o). Therefore, this apoptotic cell ablation viral tool can genetically induce trigeminal REZ demyelination in adult mice two weeks after virus microinjection. Notably, nearby neurons in pontine trigeminal nuclei were also significantly ablated by this apoptotic cell ablation viral tool that was intended to target oligodendrocytes (Fig. <xref rid="Fig4" ref-type="fig">4</xref>i). This is in line with the non-specific labeling of these neurons (Fig. <xref rid="Fig4" ref-type="fig">4</xref>e, f, h).</p></sec><sec id="Sec19"><title>Viral genetic trigeminal REZ demyelination induces TN-like facial pain in adult mice</title><p id="Par95">Then, we assessed whether viral genetic trigeminal REZ demyelination is sufficient to induce TN-like facial pain in adult mice. Notably, we simultaneously adopted the widely used, neuron-specific apoptotic cell ablation viral tool (AAV2/9:hSyn-Cre-EGFP + AAV2/9:CMV-DIO-taCasp3-TEVp mixture, for each virus: ~5E + 12 vg/mL, 0.1 &#x000b5;L) (see Additional file 16: Figure S16) [<xref ref-type="bibr" rid="CR87">87</xref>]. This experimental design can overcome the limitation of non-specific neuron ablation for the apoptotic oligodendrocyte ablation viral tool we have tested above. Asymmetric eyelid contraction and asymmetric face stroking were used in mice the same as in rats to assess facial pain evoked by air puffs and von Frey filaments with animal body immobilization (see Additional file 5: Figure S5). When innocuous air puffs or von Frey filaments of increasing strengths were applied to the corresponding (left-side) whisker pads, both asymmetric eyelid contraction and asymmetric cluster face-stroking were significantly evoked in adult mice microinjected with AAV2/9:MBP(~ 1.3 kb)-Cre-EGFP + AAV2/9:CMV-DIO-taCasp3-TEVp mixture (Fig. <xref rid="Fig5" ref-type="fig">5</xref>; see Additional file 17: Figure S17; see Additional file 25: Movie S6). In contrast, asymmetric eyelid contraction and asymmetric cluster face-stroking were not evoked by innocuous air puffs or von Frey filaments in adult mice microinjected with AAV2/9:hSyn-Cre-EGFP + AAV2/9:CMV-DIO-taCasp3-TEVp mixture (Fig. <xref rid="Fig5" ref-type="fig">5</xref>; see Additional file 17: Figure S17; see Additional file 25: Movie S6). Therefore, it is trigeminal REZ demyelination but not neuronal apoptosis in nearby trigeminal nuclei that can induce facial pain in adult mice.</p><p id="Par96">
<fig id="Fig5"><label>Fig. 5</label><caption><p>Facial pain in viral genetic mouse model of trigeminal REZ demyelination from the perspective of affective-motivational pain. (<bold>a</bold>, <bold>b</bold>) Representative time lapse images of asymmetric eyelid contraction (<bold>a</bold>) and asymmetric face stroking (<bold>b</bold>) evoked by air puffs at 0.50 psi in viral genetic mouse model of trigeminal REZ demyelination. The positive emotional pain response was indicated by long-lasting asymmetric eyelid contraction (more than 10&#x000a0;s) after the cessation of touch stimulation with no delay or a delay less than 5&#x000a0;s. The positive motivational pain response was indicated by asymmetric cluster face-stroking immediately after the initiation of touch stimulation, in which at least two or three rapid strokes were continuously present (indicated by arrows). (<bold>c</bold>, <bold>d</bold>) The duration of asymmetric eyelid contraction and the counts of asymmetric isolated/cluster face-stroking evoked by air puffs of increasing strength in viral genetic mouse model of trigeminal REZ demyelination. <italic>N</italic>&#x02009;=&#x02009;7 animals for AAV2/9:MBP-Cre-EGFP&#x02009;+&#x02009;AAV2/9:CMV-DIO-taCasp3-TEVp mixture or AAV2/9:hSyn-Cre-EGFP&#x02009;+&#x02009;AAV2/9:CMV-DIO-taCasp3-TEVp mixture; <italic>N</italic>&#x02009;=&#x02009;6 animals for AAV2/9:MBP-Cre-EGFP or AAV2/9-hSyn-Cre-eGFP. One way analysis of variance (ANOVA) followed by Tukey&#x02019;s multiple comparisons test for touch stimuli at each strength. <sup>*</sup><italic>P</italic>&#x0003c;0.05; <sup>**</sup>
<italic>P</italic>&#x0003c;0.01; <sup>***</sup>
<italic>P</italic>&#x0003c;0.001; <sup>****</sup>
<italic>P</italic>&#x0003c;0.0001</p></caption><graphic xlink:href="10194_2025_2162_Fig5_HTML" id="d33e1671"/></fig>
</p><p id="Par97">The resemblance of facial pain in this mouse model to patient TN was determined the same as in chemical rat model of trigeminal REZ demyelination with pharmacological and neuroanatomical hallmarks of patient TN. While carbamazepine was shown to substantially reduce the duration of asymmetric eyelid contraction evoked by both the air puff at every strength and the von Frey filament of every force, pregabalin was shown to minimally reduce the duration of asymmetric eyelid contraction evoked only by the von Frey filament of 0.04&#x000a0;g and 0.40&#x000a0;g (Fig.&#x000a0;<xref rid="Fig6" ref-type="fig">6</xref>a; see Additional file 18: Figure S18a; see Additional file 26: Movie S7). Similarly, carbamazepine but not pregabalin was shown to significantly reduce asymmetric cluster face-stroking evoked by the air puff at every strength (Fig.&#x000a0;<xref rid="Fig6" ref-type="fig">6</xref>b; see Additional file 26: Movie S7). More importantly, chemical silencing of primary nociceptive afferents (mainly TRPV1<sup>+</sup>) was shown to substantially reduce asymmetric eyelid contraction and asymmetric cluster face-stroking evoked by both the air puff at every strength and the von Frey filament of every force (Fig.&#x000a0;<xref rid="Fig6" ref-type="fig">6</xref>c, d; see Additional file 18: Figure S18b; see Additional file 27: Movie S8). Therefore, facial pain in viral genetic mice model of trigeminal REZ demyelination also recapitulates pharmacological and neuroanatomical hallmarks of patient TN. In another word, viral genetic trigeminal REZ demyelination is sufficient to induce TN-like facial pain in adult mice.</p><p id="Par98">
<fig id="Fig6"><label>Fig. 6</label><caption><p>Facial pain in viral genetic mouse model of trigeminal REZ demyelination recapitulated the unique drug and circuit features of TN. (<bold>a</bold>, <bold>b</bold>) The responsiveness of facial pain to carbamazepine versus pregabalin in viral genetic mouse model of trigeminal REZ demyelination. Animals microinjected with AAV2/9:MBP(~&#x02009;1.3&#x000a0;kb)-Cre-EGFP&#x02009;+&#x02009;AAV2/9:CMV-DIO-taCasp3-TEVp mixture: <italic>N</italic>&#x02009;=&#x02009;6 for either vehicle or carbamazepine or pregabalin. 2&#x000a0;W-RM ANOVA followed by &#x00160;&#x000ed;d&#x000e1;k&#x02019;s multiple comparisons test. After-drug versus before-drug: <sup>*</sup><italic>P</italic>&#x0003c;0.05; <sup>**</sup><italic>P</italic>&#x0003c;0.01; <sup>***</sup>
<italic>P</italic>&#x0003c;0.001; <sup>****</sup>
<italic>P</italic>&#x0003c;0.0001. (<bold>c</bold>, <bold>d</bold>) The requirement of primary nociceptive afferents for facial pain in viral genetic mouse model of trigeminal REZ demyelination. Animals microinjected with AAV2/9:MBP(~&#x02009;1.3&#x000a0;kb)-Cre-EGFP&#x02009;+&#x02009;AAV2/9:CMV-DIO-taCasp3-TEVp mixture: <italic>N</italic>&#x02009;=&#x02009;6 animals for vehicle, <italic>N</italic>&#x02009;=&#x02009;8 animals for chemical silencer. 2&#x000a0;W-RM ANOVA followed by &#x00160;&#x000ed;d&#x000e1;k&#x02019;s multiple comparisons test. Post-silencing versus pre-silencing: <sup>***</sup><italic>P</italic>&#x0003c;0.001; <sup>****</sup><italic>P</italic>&#x0003c;0.0001</p></caption><graphic xlink:href="10194_2025_2162_Fig6_HTML" id="MO7"/></fig>
</p></sec><sec id="Sec20"><title>Chemically focal demyelination in intrapontine trigeminal roots induces TN-like facial pain in adult rats</title><p id="Par99">Intrapontine trigeminal roots are the intrapontine extensions of extrapontine trigeminal roots and also called as trigeminal tracts. Focal demyelination in intrapontine trigeminal roots has also been shown in TN patients secondary to MS and solitary intrapontine lesions (Fig. <xref rid="Fig7" ref-type="fig">7</xref>a) [<xref ref-type="bibr" rid="CR13">13</xref>, <xref ref-type="bibr" rid="CR17">17</xref>, <xref ref-type="bibr" rid="CR19">19</xref>, <xref ref-type="bibr" rid="CR20">20</xref>, <xref ref-type="bibr" rid="CR22">22</xref>, <xref ref-type="bibr" rid="CR91">91</xref>, <xref ref-type="bibr" rid="CR92">92</xref>]. As a result, we further determined whether focal demyelination in intrapontine trigeminal roots can induce TN-like facial pain in adult rats.</p><p id="Par100">
<fig id="Fig7"><label>Fig. 7</label><caption><p>TN-like facial pain in chemical model of adult rat intrapontine trigeminal root demyelination. (<bold>a</bold>) Schematic illustration of intrapontine trigeminal root demyelination seen in TN patients. Created with bioRender.com. (<bold>b</bold>) Schematic illustration of MRI-informed coronal angled stereotactic microinjection into adult rat intrapontine trigeminal roots. Created with bioRender.com. (<bold>c</bold>) The optimal microinjection dose of 1% LPC to induce intrapontine trigeminal root demyelination in adult rats. <italic>N</italic>&#x02009;=&#x02009;3 animals per dose. (<bold>d</bold>) Temporal dynamics of intrapontine trigeminal root demyelination in adult rats. <italic>N</italic>&#x02009;=&#x02009;3 animals per timepoint. (<bold>f</bold>, <bold>g</bold>) Facial pain evoked by air puffs of increasing pressures in rat model of intrapontine trigeminal root demyelination. <italic>N</italic>&#x02009;=&#x02009;6 animals for either LPC or PBS microinjection. Independent samples t-test for air puffs at each pressure. <sup>*</sup><italic>P</italic>&#x0003c;0.05; <sup>**</sup>
<italic>P</italic>&#x0003c;0.01; <sup>***</sup>
<italic>P</italic>&#x0003c;0.001; <sup>****</sup>
<italic>P</italic>&#x0003c;0.0001. (<bold>h</bold>) The responsiveness of facial pain (asymmetric cluster face-stroking triggered by air puffs at 5.00 psi) to carbamazepine in rat model of intrapontine trigeminal root demyelination. <italic>N</italic>&#x02009;=&#x02009;6 animals microinjected with LPC for either vehicle or carbamazepine. Two-way repeated-measures analysis of variance (2&#x000a0;W-RM ANOVA) followed by &#x00160;&#x000ed;d&#x000e1;k&#x02019;s multiple comparisons test. After-drug versus before-drug: <sup>***</sup>
<italic>P</italic>&#x0003c;0.001</p></caption><graphic xlink:href="10194_2025_2162_Fig7_HTML" id="MO8"/></fig>
</p><p id="Par101">Given that intrapontine trigeminal roots resemble trigeminal REZs in terms of in situ MRI anatomical geometry (see Additional file 19: Figure S19a), we adopted again a MRI-informed coronal angled stereotactic microinjection method to reliably target intrapontine trigeminal roots of adult rats (Fig.&#x000a0;<xref rid="Fig7" ref-type="fig">7</xref>b; for details, see Additional file 19: Figure S19). The dose of 0.25 &#x000b5;L of 1% LPC was shown to efficiently cause focal demyelination in the territory of intrapontine trigeminal roots, while the dose of 0.5 &#x000b5;L and 1 &#x000b5;L of 1% LPC were shown to result in widespread and severe demyelination both in and beyond the territory of intrapontine trigeminal roots and eventually swelling cavities in neural tissues (Fig.&#x000a0;<xref rid="Fig7" ref-type="fig">7</xref>c). Furthermore, following targeted delivery of 0.25 &#x000b5;L of 1% LPC into intrapontine trigeminal roots of adult rats, focal demyelination emerged at the 3rd day, peaked at the 7th day and resolved at the 14th day (Fig.&#x000a0;<xref rid="Fig7" ref-type="fig">7</xref>d). Therefore, MRI-informed stereotactic microinjection of 0.25 &#x000b5;L of 1% LPC enabled successful rat modeling of intrapontine trigeminal root demyelination.</p><p id="Par102">Next, facial pain was evaluated in this chemical rat model of intrapontine trigeminal root demyelination at the peak time of demyelination. When innocuous air puffs of increasing strengths were applied to the corresponding (left-side) whisker pads, both asymmetric eyelid contraction and asymmetric cluster face-stroking were significantly evoked in adult rats microinjected with LPC but not PBS (Fig.&#x000a0;<xref rid="Fig7" ref-type="fig">7</xref>e, f; see Additional file 28: Movie S9). Therefore, focal demyelination in intrapontine trigeminal roots can induce facial pain in adult rats. More importantly, facial pain in this rat model also resembles patient TN in terms of pharmacological hallmark, since carbamazepine was shown to effectively decrease asymmetric face cluster-stoking evoked by air puffs of a representative strength of 5.00 psi (Fig.&#x000a0;<xref rid="Fig7" ref-type="fig">7</xref>g). Therefore, focal demyelination in intrapontine trigeminal roots is also sufficient to induce TN-like facial pain in adult rats.</p></sec></sec><sec id="Sec21"><title>Discussion</title><p id="Par103">The pathological conceptualization of TN as demyelinating disorders is fundamental for mechanistic and translational insights into this intractable disease and therefore holds the promise to improve TN diagnosis and treatment via targeting demyelination. For this purpose, there is an essential need to address an important and long-standing question-whether trigeminal root demyelination per se is sufficient to induce TN-like facial pain in animals. In our present study, we overcame previous methodological limitations in animal studies by rational and integrative use of chemical/viral genetic rodent models of trigeminal root demyelination, affective-emotional behavioral proxies for facial pain and clinically relevant criteria for TN-like facial pain. As far as we know, we for the first time showed experimentally that focal demyelination along the whole course of trigeminal roots is sufficient to induce TN-like facial pain in adult rodents.</p><p id="Par104">Our noteworthy findings would support trigeminal root demyelination as the common pathological cause of TN. This advancement will promote pathological conceptualization of TN of diverse definite and ambiguous etiologies as a unified entity of demyelinating disorders. This shift from etiological classification to pathological unification will add new insights into both the diagnosis and treatment of TN. Currently, the diagnosis of TN is largely dependent on the identification of the symptomatic hallmarks, and multi-modal MRI is used in the classification rather than the diagnosis of clinically established TN [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR11">11</xref>]. This diagnostic workup is particularly challenging to make efficient and accurate differential diagnosis among diverse orofacial pain. If TN was verified as a unified entity of demyelinating disorders along trigeminal roots, MRI modalities that can access this pathological hallmark can be used to improve the diagnosis of TN. However, the widely used DTI modality does not directly assess demyelination <italic>per se.</italic> In fact, this MRI modality identifies microstructural abnormalities that are compatible with demyelination [<xref ref-type="bibr" rid="CR17">17</xref>, <xref ref-type="bibr" rid="CR18">18</xref>, <xref ref-type="bibr" rid="CR92">92</xref>&#x02013;<xref ref-type="bibr" rid="CR97">97</xref>]. Direct identification of demyelination may be achieved via some promising MRI modalities, such as myelin bilayer mapping, myelin water imaging and myelin-targeted MRI/PET probes [<xref ref-type="bibr" rid="CR98">98</xref>, <xref ref-type="bibr" rid="CR99">99</xref>]. Moreover, targeting demyelination will hold the promise to optimize current TN therapies and to inspire new treatment modalities for TN. For example, microvascular decompression might be adopted early in the disease course to prevent the progression into severe demyelination and medically refractory TN [<xref ref-type="bibr" rid="CR100">100</xref>, <xref ref-type="bibr" rid="CR101">101</xref>]. Notably, FDA-approved drugs, such as clemastine and liothyronine, would be tested or optimized as new non-surgical therapeutics for TN via enhancing remyelination, especially for medically refractory TN [<xref ref-type="bibr" rid="CR102">102</xref>&#x02013;<xref ref-type="bibr" rid="CR105">105</xref>].</p><p id="Par105">Meanwhile, our present study would provide a group of simple and reliable pathological rodent models for future TN studies. Previous preclinical studies of TN adopted mechanical or toxic injury to the infraorbital nerve from the maxillary trigeminal nerve, which in fact induces trigeminal neuropathic pain, a condition significantly different from TN [<xref ref-type="bibr" rid="CR106">106</xref>&#x02013;<xref ref-type="bibr" rid="CR109">109</xref>]. During the past two decades, either natural or man-made anatomical channels were surgically employed to model NVC along extrapontine trigeminal roots via implanted materials, such as small plastic filaments, super-absorbent polymer crystals and surgifoam pieces [<xref ref-type="bibr" rid="CR28">28</xref>&#x02013;<xref ref-type="bibr" rid="CR32">32</xref>]. Stereotactic LPA microinjection into adult rats and EAE mouse model have also been used to model TN core pathology or MS-related TN [<xref ref-type="bibr" rid="CR33">33</xref>, <xref ref-type="bibr" rid="CR34">34</xref>]. However, TN-like facial pain has never been successfully demonstrated due to methodological shortcomings, such as inaccurate and unreproducible modeling of TN etiological factors or core pathology, inappropriate facial pain behavioral tests and poor criteria for clinical relevance [<xref ref-type="bibr" rid="CR108">108</xref>]. As far as we know, there is no successful animal model for TN [<xref ref-type="bibr" rid="CR108">108</xref>]. In the present study, we provided a simple and reproducible method to chemically or viral genetically induce trigeminal root demyelination in adult rodents and then behaviorally showed TN-like facial pain according to clinically relevant identification criteria. These simple and reliable pathological TN rodent models from our present study can be referred during the development of etiological TN rodent models and also used in further mechanistic and translational studies of this intractable disease.</p><p id="Par106">Last but not least, we acknowledge some main limitations of our present study. First, the apoptosis-inducing viral genetic tool that we intended to ablate oligodendrocytes in trigeminal REZs of adult mice also ablated nearby neurons. As a result, we included the neuron-specific apoptotic ablation viral genetic tool alongside to overcome this unexpected limitation. However, further studies should develop oligodendrocyte-specific apoptotic ablation viral genetic tools via promoter optimization and therefore induce animal trigeminal root demyelination in a specific manner. Second, touch-triggered facial pain cannot be successfully measured for all the time due to the failure to accurately and consistently stimulate the punctate trigger zone with touch stimuli, especially von Frey hairs. More importantly, the symptomatic hallmarks of touch-triggered neuralgic pain, such as the punctate trigger zone and the refractory period, have not been successfully shown in a direct and quantitative manner [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR11">11</xref>]. Consequently, we pioneered the use of pharmacological and neuroanatomical hallmarks to ascertain the resemblance of rodent facial pain to patient TN. This essential limitation results from the incomplete and stressful head fixation, the manual but not automatic application of dynamic and static touch stimuli and the stress from the direct exposure to the experimenters and environment on current behavioral protocols for TN-like facial pain. Third, female animals would be included in addition to males in future studies, since TN is more frequently observed in female patients than in males [<xref ref-type="bibr" rid="CR1">1</xref>]. Fourth, the existence of <italic>bona fide</italic> spontaneous neuralgic pain, which is under debate in clinical studies [<xref ref-type="bibr" rid="CR11">11</xref>], should also be addressed in experimental settings that minimize very subtle touch stimuli.</p></sec><sec id="Sec22"><title>Conclusions</title><p id="Par107">There is an essential need to ascertain the sufficiency of trigeminal root demyelination per se to cause TN for either mechanistic understanding or clinical management of this intractable disease. Due to methodological limitations in either preclinical or clinical studies, this important question has never been addressed so far with success. In our present study, we overcame methodological limitations in previous animal studies by rational and integrative use of chemical/viral genetic rodent models of trigeminal root demyelination, affective-emotional behavioral proxies for facial pain and clinically relevant criteria for TN-like facial pain. As far as we know, we for the first time showed experimentally that trigeminal root demyelination is sufficient to induce TN-like facial pain in adult rodents (Fig.&#x000a0;<xref rid="Fig8" ref-type="fig">8</xref>). Our noteworthy results here would support trigeminal root demyelination as the common pathological cause of TN. This advancement will promote pathological conceptualization and clinical management of this etiologically heterogeneous disease as a unified entity of demyelinating disorders. Meanwhile, a group of simple and reliable pathological rodent models were provided for further investigations into this disease.</p><p id="Par108">
<fig id="Fig8"><label>Fig. 8</label><caption><p>Schematic summary for the sufficiency of trigeminal root demyelination to induce TN-like facial pain in adult rodents. MRI-informed coronal angled stereotactic microinjection of (1) 1% LPC into rat extrapontine and intrapontine trigeminal roots and (2) oligodendrocyte-ablating AAV into adult mice trigeminal REZs modeled trigeminal root demyelination seen in TN patients of diverse etiologies and resulted in the manifestation of TN-like facial pain on the basis of TN pharmacological and neuroanatomical hallmarks. Therefore, trigeminal root demyelination is sufficient to induce TN-like facial pain in adult rodents. Created with bioRender.com</p></caption><graphic xlink:href="10194_2025_2162_Fig8_HTML" id="MO9"/></fig>
</p></sec><sec id="Sec23" sec-type="supplementary-material"><title>Supplementary Information</title><p>
<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="10194_2025_2162_MOESM1_ESM.jpg"><caption><p>Additional file 1: Figure S1.&#x000a0;Schematic illustration of TN neuroanatomical hallmark. Under physiological conditions, a large amount of A&#x003b2; touch receptors get separate from A&#x003b4;/C nociceptors next to Pr5 and further terminate into this nucleus; some trunk or collateral afferents from A&#x003b2; touch receptors go in parallel and intermingle with A&#x003b4;/C nociceptive afferents in SpT5 and further terminate into Sp5C (a, upper panel). Following focal demyelination along either extrapontine or intrapontine trigeminal roots, the closely apposed demyelinated axons may lead to ephaptic transmission from A&#x003b2; touch afferents to A&#x003b4;/C nociceptive afferents, resulting in the formation of the neural circuit for touch-triggered pain in TN (a, lower panel). Therefore, the neural circuit for TN requires primary nociceptive afferents. This is in line with clinical findings that TN is effectively relieved by radiofrequency thermocoagulation which preferentially damages small-diameter A&#x003b4;/C pain fibers. In contrast, touch-evoked pain under other neuropathic pain conditions, i.e. tactile allodynia, involves the coupling of the separate touch and pain neurocircuits after the projection of primary sensory neurons into the the spinal or medullary dorsal horns and excludes the requirement of primary nociceptive afferents (b). Created with bioRender.com.</p></caption></media></supplementary-material>
</p><p>
<supplementary-material content-type="local-data" id="MOESM2"><media xlink:href="10194_2025_2162_MOESM2_ESM.jpg"><caption><p>Additional file 2: Figure S2.&#x000a0;Photographs of long-lasting asymmetric eyelid contraction and asymmetric cluster face-stroking to assess affective-motivational facial pain.</p></caption></media></supplementary-material>
</p><p>
<supplementary-material content-type="local-data" id="MOESM3"><media xlink:href="10194_2025_2162_MOESM3_ESM.jpg"><caption><p>Additional file 3: Figure S3.&#x000a0;Schematic illustration of the workflow for behavioral testing of TN-like facial pain in adult rodents.</p></caption></media></supplementary-material>
</p><p>

p person-group-type="author"><name><surname>Finks</surname><given-names>JF</given-names></name><name><surname>Osborne</surname><given-names>NH</given-names></name><name><surname>Birkmeyer</surname><given-names>JD</given-names></name></person-group><article-title>Trends in hospital volume and operative mortality for high-risk surgery</article-title><source>N Engl J Med</source><year>2011</year><volume>364</volume><issue>22</issue><fpage>2128</fpage><lpage>2137</lpage><pub-id pub-id-type="doi">10.1056/NEJMsa1010705</pub-id><pub-id pub-id-type="pmid">21631325</pub-id></element-citation></ref><ref id="CR17"><label>17.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lau</surname><given-names>K</given-names></name><name><surname>Salami</surname><given-names>A</given-names></name><name><surname>Barden</surname><given-names>G</given-names></name><name><surname>Khawja</surname><given-names>S</given-names></name><name><surname>Castillo</surname><given-names>DL</given-names></name><name><surname>Poppelaars</surname><given-names>V</given-names></name><etal/></person-group><article-title>The effect of a regional hepatopancreaticobiliary surgical program on clinical volume, quality of cancer care, and outcomes in the veterans affairs system</article-title><source>JAMA Surg</source><year>2014</year><volume>149</volume><issue>11</issue><fpage>1153</fpage><lpage>1161</lpage><pub-id pub-id-type="doi">10.1001/jamasurg.2014.1711</pub-id><pub-id pub-id-type="pmid">25207711</pub-id></element-citation></ref><ref id="CR18"><label>18.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Violi</surname><given-names>V</given-names></name><name><surname>Costi</surname><given-names>R</given-names></name><name><surname>De Bernardinis</surname><given-names>M</given-names></name><name><surname>Roncoroni</surname><given-names>L</given-names></name></person-group><article-title>Volume-o
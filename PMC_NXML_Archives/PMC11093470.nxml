<article-id pub-id-type="publisher-id">IJS-D-23-02812</article-id><article-id pub-id-type="doi">10.1097/JS9.0000000000001191</article-id><article-id pub-id-type="art-access-id">00013</article-id><article-version vocab="JAV" vocab-identifier="http://www.niso.org/publications/rp/RP-8-2008.pdf" article-version-type="Version of Record">3</article-version><article-categories><subj-group subj-group-type="heading"><subject>Original Research</subject></subj-group></article-categories><title-group><article-title>A novel stratification scheme combined with internal arteries in CT imaging for guiding postoperative adjuvant transarterial chemoembolization in hepatocellular carcinoma: a retrospective cohort study</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Li</surname><given-names>Xinming</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">a</xref><xref rid="aff2" ref-type="aff">b</xref><email>lixinmingsmu@163.com</email></contrib><contrib contrib-type="author"><name><surname>Liang</surname><given-names>Xiangjing</given-names></name><degrees>MS</degrees><xref rid="aff3" ref-type="aff">c</xref><email>772431643@qq.com</email></contrib><contrib contrib-type="author"><name><surname>Li</surname><given-names>Zhipeng</given-names></name><degrees>MS</degrees><xref rid="aff5" ref-type="aff">e</xref><email>lizp@sysucc.org.cn</email></contrib><contrib contrib-type="author"><name><surname>Liang</surname><given-names>Jianye</given-names></name><degrees>MD</degrees><xref rid="aff5" ref-type="aff">e</xref><email>ljyjnu@foxmail.com</email></contrib><contrib contrib-type="author"><name><surname>Qi</surname><given-names>Zhendong</given-names></name><degrees>MS</degrees><xref rid="aff2" ref-type="aff">b</xref><email>qdehua666@163.com</email></contrib><contrib contrib-type="author"><name><surname>Zhong</surname><given-names>Liming</given-names></name><degrees>PhD</degrees><xref rid="aff4" ref-type="aff">d</xref><email>limingzhongmindy@gmail.com</email></contrib><contrib contrib-type="author"><name><surname>Geng</surname><given-names>Zhijun</given-names></name><degrees>MD</degrees><xref rid="aff5" ref-type="aff">e</xref><email>gengzhj@sysucc.org.cn</email></contrib><contrib contrib-type="author"><name><surname>Liang</surname><given-names>Wen</given-names></name><degrees>MD</degrees><xref rid="aff2" ref-type="aff">b</xref><email>liangwendoc@163.com</email></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Quan</surname><given-names>Xianyue</given-names></name><degrees>MD</degrees><email>quanxianyue2014@163.com</email><xref rid="aff2" ref-type="aff">b</xref><xref rid="cor1" ref-type="corresp"/></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Liang</surname><given-names>Changhong</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">a</xref><xref rid="aff6" ref-type="aff">f</xref><xref rid="cor1" ref-type="corresp"/><email>liangchanghong@gdph.org.cn</email></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Liu</surname><given-names>Zaiyi</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">a</xref><xref rid="aff6" ref-type="aff">f</xref><xref rid="cor1" ref-type="corresp"/><email>liuzaiyi@gdph.org.cn</email></contrib></contrib-group><aff id="aff1">

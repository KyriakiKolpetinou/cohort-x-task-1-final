eft" rowspan="1" colspan="1">&#x02003;&#x02264;40</td><td align="char" char="(" rowspan="1" colspan="1">938 (63.0%)</td><td align="char" char="(" rowspan="1" colspan="1">675 (62.8%)</td><td align="char" char="(" rowspan="1" colspan="1">263 (63.5%)</td><td align="char" char="." rowspan="1" colspan="1">0.01</td><td align="char" char="." rowspan="1" colspan="1">0.05</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x0003e;40</td><td align="char" char="(" rowspan="1" colspan="1">550 (37.0%)</td><td align="char" char="(" rowspan="1" colspan="1">399 (37.2%)</td><td align="char" char="(" rowspan="1" colspan="1">151 (36.5%)</td><td align="char" char="." rowspan="1" colspan="1">0.01</td><td align="char" char="." rowspan="1" colspan="1">0.05</td></tr><tr><td align="left" rowspan="1" colspan="6">GGT (U/l)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02264;75</td><td align="char" char="(" rowspan="1" colspan="1">938 (63.0%)</td><td align="char" char="(" rowspan="1" colspan="1">689 (64.2%)</td><td align="char" char="(" rowspan="1" colspan="1">249 (60.1%)</td><td align="char" char="." rowspan="1" colspan="1">0.08</td><td align="char" char="." rowspan="1" colspan="1">0.03</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x0003e;75</td><td align="char" char="(" rowspan="1" colspan="1">550 (37.0%)</td><td align="char" char="(" rowspan="1" colspan="1">385 (35.8%)</td><td align="char" char="(" rowspan="1" colspan="1">165 (39.9%)</td><td align="char" char="." rowspan="1" colspan="1">0.08</td><td align="char" char="." rowspan="1" colspan="1">0.03</td></tr><tr><td align="left" rowspan="1" colspan="6">TBIL (&#x003bc;mol/l)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02264;17.1</td><td align="char" char="(" rowspan="1" colspan="1">1101 (74.0%)</td><td align="char" char="(" rowspan="1" colspan="1">783 (72.9%)</td><td align="char" char="(" rowspan="1" colspan="1">318 (76.8%)</td><td align="char" char="." rowspan="1" colspan="1">0.09</td><td align="char" char="." rowspan="1" colspan="1">0.10</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x0003e;17.1</td><td align="char" char="(" rowspan="1" colspan="1">387 (26.0%)</td><td align="char" char="(" rowspan="1" colspan="1">291 (27.1%)</td><td align="char" char="(" rowspan="1" colspan="1">96 (23.2%)</td><td align="char" char="." rowspan="1" colspan="1">0.09</td><td align="char" char="." rowspan="1" colspan="1">0.10</td></tr><tr><td align="left" rowspan="1" colspan="6">AFP (ng/ml)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02264;200</td><td align="char" char="(" rowspan="1" colspan="1">1001 (67.3%)</td><td align="char" char="(" rowspan="1" colspan="1">710 (66.1%)</td><td align="char" char="(" rowspan="1" colspan="1">282 (68.1%)</td><td align="char" char="." rowspan="1" colspan="1">0.04</td><td align="char" char="." rowspan="1" colspan="1">0.04</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x0003e;200</td><td align="char" char="(" rowspan="1" colspan="1">487 (32.7%)</td><td align="char" char="(" rowspan="1" colspan="1">364 (33.9%)</td><td align="char" char="(" rowspan="1" colspan="1">132 (32.9%)</td><td align="char" char="." rowspan="1" colspan="1">0.04</td><td align="char" char="." rowspan="1" colspan="1">0.04</td></tr><tr><td align="left" rowspan="1" colspan="6">AJCC</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Stage I</td><td align="char" char="(" rowspan="1" colspan="1">919 (61.8%)</td><td align="char" char="(" rowspan="1" colspan="1">676 (62.9%)</td><td align="char" char="(" rowspan="1" colspan="1">243 (58.7%)</td><td align="char" char="." rowspan="1" colspan="1">0.09</td><td align="char" char="." rowspan="1" colspan="1">0.06</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Stage II/IIIA</td><td align="char" char="(" rowspan="1" colspan="1">569 (38.2%)</td><td align="char" char="(" rowspan="1" colspan="1">398 (37.1%)</td><td align="char" char="(" rowspan="1" colspan="1">171 (41.3%)</td><td align="char" char="." rowspan="1" colspan="1">0.09</td><td align="char" char="." rowspan="1" colspan="1">0.06</td></tr><tr><td align="left" rowspan="1" colspan="6">Extent of resection</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Major resection</td><td align="char" char="(" rowspan="1" colspan="1">279 (18.8%)</td><td align="char" char="(" rowspan="1" colspan="1">199 (18.5%)</td><td align="char" char="(" rowspan="1" colspan="1">80 (19.3%)</td><td align="char" char="." rowspan="1" colspan="1">0.02</td><td align="char" char="." rowspan="1" colspan="1">0.01</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Minor resection</td><td align="char" char="(" rowspan="1" colspan="1">1209 (81.3%)</td><td align="char" char="(" rowspan="1" colspan="1">875 (81.5%)</td><td align="char" char="(" rowspan="1" colspan="1">334 (80.7%)</td><td align="char" char="." rowspan="1" colspan="1">0.02</td><td align="char" char="." rowspan="1" colspan="1">0.01</td></tr></tbody></table><table-wrap-foot><fn id="T1fn1"><label>a</label><p>Absolute difference in means or proportions divided by pooled SD. Imbalance between the PA-TACE and Hepatectomy alone groups was defined as an absolute value greater than 0.10; smaller values indicated better balance.</p></fn><fn id="T1fn2"><label>b</label><p>Inverse probability of treatment weighted standardized differences. All demographic characteristics and medical histories were used to estimate the weights.</p></fn><fn fn-type="other"><p>AFP, alpha-fetoprotein; AJCC, American Joint Committee on Cancer; ALB, albumin; ALT, alanine aminotransferase; AST, aspartate aminotransferase; GGT, gamma-glutamyl transpeptidase; HBV, hepatitis B virus; HCV, hepatitis C virus; MVI, microvascular invasion; PA-TACE, postoperative adjuvant transarterial chemoembolization; PLT, platelet; TBIL, total bilirubin.</p></fn></table-wrap-foot></table-wrap><fig position="float" id="F1"><label>Figure 1</label><caption><p>Kaplan&#x02013;Meier curves in primary and IPTW analysis of the overall cohort. Kaplan&#x02013;Meier curves of RFS and OS between the PA-TACE and hepatectomy alone groups in primary (A, B) and IPTW (C, D) analysis of the overall cohort. IPTW, inverse probability of treatment weighting; NR, not reach; OS, overall survival; PA-TACE, postoperative adjuvant transarterial chemoembolization; RFS, recurrence-free survival.</p></caption><graphic xlink:href="js9-110-2556-g001" position="float"/></fig></sec><sec><title>Subgroup and interaction analysis</title><p>Clinical data, imaging features, and pathological indicators were used to investigate survival benefits from PA-TACE. Patients with MVI positive (<italic toggle="yes">n</italic>=546) experienced a significant benefit from PA-TACE versus hepatectomy alone (HR, 0.656, 95% CI: 0.517&#x02013;0.832, <italic toggle="yes">P</italic>&#x0003c;0.001, Fig. S3A, Supplemental Digital Content 1, <ext-link xlink:href="http://links.lww.com/JS9/B998" ext-link-type="uri">http://links.lww.com/JS9/B998</ext-link>; HR, 0.694; 95% CI: 0.518&#x02013;0.930, <italic toggle="yes">P</italic>=0.014, Fig. S3B, Supplemental Digital Content 1, <ext-link xlink:href="http://links.lww.com/JS9/B998" ext-link-type="uri">http://links.lww.com/JS9/B998</ext-link>). However, patients with MVI negative showed no significant benefit (HR, 0.960; 95% CI: 0.769&#x02013;1.199, <italic toggle="yes">P</italic>=0.721, Fig. S3C, Supplemental Digital Content 1, <ext-link xlink:href="http://links.lww.com/JS9/B998" ext-link-type="uri">http://links.lww.com/JS9/B998</ext-link>; HR, 0.888; 95% CI: 0.650&#x02013;1.214, <italic toggle="yes">P</italic>=0.457; Fig. S3D, Supplemental Digital Content 1, <ext-link xlink:href="http://links.lww.com/JS9/B998" ext-link-type="uri">http://links.lww.com/JS9/B998</ext-link>). Importantly, a significant interaction was detected between PA-TACE and MVI in terms of RFS (<italic toggle="yes">P</italic>=0.035), with MVI positive patients achieving higher RFS benefit from the addition of PA-TACE. However, no significant interaction was detected for OS (<italic toggle="yes">P</italic>=0.389).</p><p>A significant benefit from PA-TACE was observed in patients with two or three tumors (Fig. S4A, B, Supplemental Digital Content 1, <ext-link xlink:href="http://links.lww.com/JS9/B998" ext-link-type="uri">http://links.lww.com/JS9/B998</ext-link>). However, single tumor patients did not derive significant RFS and OS (Fig. S4C, D, Supplemental Digital Content 1, <ext-link xlink:href="http://links.lww.com/JS9/B998" ext-link-type="uri">http://links.lww.com/JS9/B998</ext-link>) benefits from PA-TACE therapy. A significant interaction between two or three tumors and PA-TACE was observed in terms of RFS (<italic toggle="yes">P</italic>=0.037), although no significant interaction was present in terms of OS (<italic toggle="yes">P</italic>=0.222).</p><p>PA-TACE significantly improved RFS (HR, 0.700; 95% CI: 0.566&#x02013;0.866, <italic toggle="yes">P</italic>=0.001, Fig. <xref rid="F2" ref-type="fig">2</xref>A) and OS (HR, 0.637; 95% CI: 0.481&#x02013;0.844, <italic toggle="yes">P</italic>=0.002, Fig. <xref rid="F2" ref-type="fig">2</xref>) in IA-positive patients. The 10-year survival rates were 55.3% (95% CI: 46.1&#x02013;66.3) and 41.8% (95% CI: 36.7&#x02013;47.6) for PA-TACE and hepatectomy alone patients, respectively, demonstrating a 13.5% survival benefit associated with PA-TACE for a patient following hepatectomy. However, IA-negative patients did not obtain significant survival benefits from PA-TACE (Fig. <xref rid="F2" ref-type="fig">2</xref>C, D). The PA-TACE and IA interaction was significant for both RFS (<italic toggle="yes">P</italic>=0.042) and OS (<italic toggle="yes">P</italic>=0.015), indicating that IA-positive patients benefited more from PA-TACE than IA-negative patients. Similar results were observed for TTPVI (Fig. S5, Supplemental Digital Content 1, <ext-link xlink:href="http://links.lww.com/JS9/B998" ext-link-type="uri">http://links.lww.com/JS9/B998</ext-link>). Other clinical data, imaging features, pathological indicators, subgroup analyses, and interaction analyses are presented in Table S4 (Supplemental Digital Content 1, <ext-link xlink:href="http://links.lww.com/JS9/B998" ext-link-type="uri">http://links.lww.com/JS9/B998</ext-link>). No interaction was detected between PA-TACE and age, Edmondson&#x02013;Steiner grade, AFP, halos, capsule, margin, or peritumoral enhancement.</p><fig position="float" id="F2"><label>Figure 2</label><caption><p>IA is associated with HCC patient outcomes for hepatectomy plus PA-TACE. The Kaplan&#x02013;Meier curves illustrate RFS and OS improvements for PA-TACE over hepatectomy alone among IA-positive (A, B) and IA-negative (C, D) patients. IA, internal arteries; NR, not reach; OS, overall survival; PA-TACE, postoperative adjuvant transarterial chemoembolization; RFS, recurrence-free survival.</p></caption><graphic xlink:href="js9-110-2556-g002" position="float"/></fig></sec><sec><title>Original risk group prediction of PA-TACE benefit</title><p>We also investigated the association between the risk group and the PA-TACE effectiveness. The baseline data stratified by risk group are described in Table S5 (Supplemental Digital Content 1, <ext-link xlink:href="http://links.lww.com/JS9/B998" ext-link-type="uri">http://links.lww.com/JS9/B998</ext-link>). PA-TACE treatment did not decrease recurrence or prolong survival in the low-risk group (Table <xref rid="T2" ref-type="table">2</xref>, Fig. <xref rid="F3" ref-type="fig">3</xref>A, B) compared to patients who did not receive PA-TACE. PA-TACE did not reduce recurrence time (Fig. <xref rid="F3" ref-type="fig">3</xref>C), but it may improve OS (Fig. <xref rid="F3" ref-type="fig">3</xref>D) in the intermediate risk group. The 10-year OS rates were 69.5% (95% CI: 57.5&#x02013;84.0) and 52.2% (95% CI: 43.8&#x02013;62.2) for patients with PA-TACE or hepatectomy alone, respectively, demonstrating a PA-TACE absolute benefit of 17.3% in reducing of the risk of death.</p><table-wrap position="float" id="T2"><label>Table 2</label><caption><p>Original risk group, integrate IA, and HIPC group subgroup analyses and interaction analyses.</p></caption><table frame="hsides" rules="groups"><col align="left" width="1*" span="1"/><col align="left" width="1*" span="1"/><col align="left" width="1*" span="1"/><col align="left" width="1*" span="1"/><col align="left" width="1*" span="1"/><col align="left" width="1*" span="1"/><col align="left" width="1*" span="1"/><col align="left" width="1*" span="1"/><thead><tr><th align="left" rowspan="1" colspan="1"/><th align="left" rowspan="1" colspan="1"/><th align="center" rowspan="1" colspan="3" axis="1">RFS</th><th align="center" rowspan="1" colspan="3" axis="1">OS</th></tr><tr><th align="left" rowspan="1" colspan="1" axis="1">Subgroups</th><th align="center" rowspan="1" colspan="1" axis="1">
<italic toggle="yes">N</italic>

<article-id pub-id-type="publisher-id">CN-23-9-1081</article-id><article-id pub-id-type="doi">10.2174/1570159X23666250127161855</article-id><article-categories><subj-group subj-group-type="heading"><subject>Medicine, Neurology, Pharmacology, Neuroscience</subject></subj-group></article-categories><title-group><article-title>Quantification of [<sup>11</sup>C]ABP688 Binding to mGluR5 in Human Brain using Cerebellum as Reference Region: Biological Interpretation and Limitations</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Milella</surname><given-names>Michele S.</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Minuzzi</surname><given-names>Luciano</given-names></name><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>Benkelfat</surname><given-names>Chawki</given-names></name><xref rid="aff3" ref-type="aff">3</xref><xref rid="aff4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><name><surname>Soucy</surname><given-names>Jean-Paul</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Kirlow</surname><given-names>Alexandre</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Schirrmacher</surname><given-names>Esther</given-names></name><xref rid="aff5" ref-type="aff">5</xref></contrib><contrib contrib-type="author"><name><surname>Angle</surname><given-names>Mark</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Verhaeghe</surname><given-names>Jeroen A.J.</given-names></name><xref rid="aff6" ref-type="aff">6</xref></contrib><contrib contrib-type="author"><name><surname>Massarweh</surname><given-names>Gassan</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Reader</surname><given-names>Andrew J.</given-names></name><xref rid="aff7" ref-type="aff">7</xref></contrib><contrib contrib-type="author"><name><surname>Aliaga</surname><given-names>Antonio</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Peixoto-Santos</surname><given-names>Jose Eduardo</given-names></name><xref rid="aff8" ref-type="aff">8</xref></contrib><contrib contrib-type="author"><name><surname>Guiot</surname><given-names>Marie-Christine</given-names></name><xref rid="aff3" ref-type="aff">3</xref><xref rid="aff9" ref-type="aff">9</xref></contrib><contrib contrib-type="author"><name><surname>Kobayashi</surname><given-names>Eliane</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Rosa-Neto</surname><given-names>Pedro</given-names></name><xref rid="aff3" ref-type="aff">3</xref><xref rid="aff4" ref-type="aff">4</xref><xref rid="aff5" ref-type="aff">5</xref><xref rid="aff10" ref-type="aff">10</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Leyton</surname><given-names>Marco</given-names></name><xref rid="aff3" ref-type="aff">3</xref><xref rid="aff4" ref-type="aff">4</xref><xref rid="cor1" ref-type="corresp">*</xref></contrib><aff id="aff1">

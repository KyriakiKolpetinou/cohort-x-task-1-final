<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" dtd-version="1.3" xml:lang="en" article-type="research-article"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Urol Res Pract</journal-id><journal-id journal-id-type="iso-abbrev">Urol Res Pract</journal-id><journal-title-group><journal-title>Urology Research and Practice</journal-title></journal-title-group><issn pub-type="epub">2980-1478</issn><publisher><publisher-name>Turkish Association of Urology</publisher-name></publisher></journal-meta>

conventional imaging</article-title><trans-title-group xml:lang="pt"><trans-title>O estado da arte da PET/RM para o c&#x000e2;ncer retal: o valor
agregado &#x000e0; imagem convencional</trans-title></trans-title-group></title-group><contrib-group><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-5364-6337</contrib-id><name><surname>Zampieri</surname><given-names>Poliana Fonseca</given-names></name><xref rid="c1" ref-type="corresp"/><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0009-0000-1417-1124</contrib-id><name><surname>Hernandes</surname><given-names>Daniel Barros Garcia</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0002-5879-5382</contrib-id><name><surname>Albenda</surname><given-names>David Alberto Guti&#x000e9;rrez</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0001-8849-5789</contrib-id><name><surname>Horvat</surname><given-names>Natally</given-names></name><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0001-7733-4138</contrib-id><name><surname>Catalano</surname><given-names>Onofrio Antonio</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0003-0956-2790</contrib-id><name><surname>Buchpiguel</surname><given-names>Carlos Alberto</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid">http://orcid.org/0000-0003-0052-0682</contrib-id><name><surname>Queiroz</surname><given-names>Marcelo Ara&#x000fa;jo</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib></contrib-group><aff id="aff1">

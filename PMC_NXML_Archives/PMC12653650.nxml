</person-group><article-title>Best practice advice on pre-hospital emergency anaesthesia &#x00026; advanced airway management</article-title><source>Scand. J. Trauma Resusc. Emerg. Med.</source><year>2019</year><volume>27</volume><fpage>6</fpage><pub-id pub-id-type="doi">10.1186/s13049-018-0554-6</pub-id><pub-id pub-id-type="pmid">30665441</pub-id>
</element-citation></ref><ref id="B3-life-15-01725"><label>3.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Fevang</surname><given-names>E.</given-names></name>

id-type="doi">10.1016/j.ijrobp.2012.01.012</pub-id><pub-id pub-id-type="pmid">22417800</pub-id></element-citation></ref><ref id="CR7"><label>7.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Shields</surname><given-names>AF</given-names></name><name><surname>Grierson</surname><given-names>JR</given-names></name><name><surname>Dohmen</surname><given-names>BM</given-names></name><name><surname>Machulla</surname><given-names>HJ</given-names></name><name><surname>Stayanoff</surname><given-names>JC</given-names></name><name><surname>Lawhorn-Crews</surname><given-names>JM</given-names></name><name><surname>Obradovich</surname><given-names>JE</given-names></name><name><surname>Muzik</surname><given-names>O</given-names></name><name><surname>Mangner</surname><given-names>TJ</given-names></name></person-group><article-title>Imaging proliferation in vivo with [F-18] FLT and positron emission tomography</article-title><source>Nat Med</source><year>1998</year><volume>4</volume><issue>11</issue><fpage>1334</fpage><lpage>1336</lpage><pub-id pub-id-type="doi">10.1038/3337</pub-id><pub-id pub-id-type="pmid">9809561</pub-id></element-citation></ref><ref id="CR8"><label>8.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Pio</surname><given-names>BS</given-names></name><name><surname>Park</surname><given-names>CK</given-names></name><name><surname>Pietras</surname><given-names>R</given-names></name><name><surname>Hsueh</surname><given-names>WA</given-names></name><name><surname>Satyamurthy</surname><given-names>N</given-names></name><name><surname>Pegram</surname><given-names>MD</given-names></name><name><surname>Czernin</surname><given-names>J</given-names></name><name><surname>Phelps</surname><given-names>ME</given-names></name><name><surname>Silverman</surname><given-names>DHS</given-names></name></person-group><article-title>Usefulness of 3&#x02032;-[F-18] fluoro-3&#x02032;-deoxythymidine with positron emission tomography in predicting breast cancer response to therapy</article-title><source>Mol Imaging Biol</source><year>2006</year><volume>8</volume><issue>1</issue><fpage>36</fpage><lpage>42</lpage><pub-id pub-id-type="doi">10.1007/s11307-005-0029-9</pub-id><pub-id pub-id-type="pmid">16362149</pub-id></element-citation></ref><ref id="CR9"><label>9.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Kostakoglu</surname><given-names>L</given-names></name><name><surname>Duan</surname><given-names>F</given-names></name><name><surname>Idowu</surname><given-names>MO</given-names></name><name><surname>Jolles</surname><given-names>PR</given-names></name><name><surname>Bear</surname><given-names>HD</given-names></name><name><surname>Muzi</surname><given-names>M</given-names></name><name><surname>Cormack</surname><given-names>J</given-names></name><name><surname>Muzi</surname><given-names>JP</given-names></name><name><surname>Pryma</surname><given-names>DA</given-names></name><name><surname>Specht</surname><given-names>JM</given-names></name><name><surname>Hovanessian-Larsen</surname><given-names>L</given-names></name><name><surname>Miliziano</surname><given-names>J</given-names></name><name><surname>Mallett</surname><given-names>S</given-names></name><name><surname>Shields</surname><given-names>AF</given-names></name><name><surname>Mankoff</surname><given-names>DA</given-names></name><collab>ACRIN 668 Investigative Team</collab></person-group><article-title>A phase II study of 3&#x02032;-deoxy-3&#x02032;-18f-fluorothymidine PET in the assessment of early response of breast cancer to neoadjuvant chemotherapy: results from ACRIN 6688</article-title><source>J Nucl Med</source><year>2015</year><volume>56</volume><issue>11</issue><fpage>1681</fpage><lpage>1689</lpage><pub-id pub-id-type="doi">10.2967/jnumed.115.160663</pub-id><pub-id pub-id-type="pmid">26359256</pub-id></element-
</element-citation></ref><ref id="CR16"><label>16.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Chen</surname><given-names>L</given-names></name><name><surname>Greisberg</surname><given-names>J</given-names></name></person-group><article-title>Achilles lengthening procedures</article-title><source>Foot Ankle Clin N Am</source><year>2009</year><volume>14</volume><fpage>627</fpage><lpage>637</lpage><pub-id pub-id-type="doi">10.1016/j.fcl.2009.08.002</pub-id></element-citation></ref><ref id="CR17"><label>17.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>DeHeer</surname><given-names>PA</given-names></name><name><surname>Standish</surname><given-names>SN</given-names></name><name><surname>Kirchner</surname><given-names>KJ</given-names></name><name><surname>Fleischer</surname></name></person-group><article-title>Prevalence and distribution of ankle joint eqnius in 249 consecutive patients attending a foot and ankle specialty clinic</article-title><source>J Am Podiatr Med Assoc</source><year>2021</year><volume>111</volume><fpage>1</fpage><lpage>8</lpage><pub-id pub-id-type="doi">10.7547/18-18</pub-id></element-citation></ref><ref id="CR18"><label>18.</label><element-citation publication-type="book"><person-group person-group-type="author"><name><surname>Vulpius</surname><given-names>O</given-names></name></person-group><source>Orthopadische Operationslehre</source><year>1913</year><publisher-loc>Stutgart</publisher-loc><publisher-name>Ferdinand Enke</publisher-name></element-citation></ref><ref id="CR19"><label>19.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cychosz</surname><given-names>C</given-names></name><name><surname>Phisitkul</surname><given-names>P</given-names></name><name><surname>Belatti</surname><given-names>D</given-names></name><name><surname>Glazebrook</surname><given-nam
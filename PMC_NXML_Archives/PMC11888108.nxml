<article-meta><article-id pub-id-type="pmid">39946688</article-id><article-id pub-id-type="pmc">11888108</article-id><article-id pub-id-type="publisher-id">v13i1e55720</article-id><article-id pub-id-type="doi">10.2196/55720</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Paper</subject></subj-group><subj-group subj-group-type="article-type"><subject>Original Paper</subject></subj-group></article-categories><title-group><article-title>Improving Pediatric Patients&#x02019; Magnetic Resonance Imaging Experience With an In-Bore Solution: Design and Usability Study</article-title></title-group><contrib-group><contrib contrib-type="editor"><name><surname>Coristine</surname><given-names>Andrew</given-names></name></contrib></contrib-group><contrib-group><contrib contrib-type="reviewer"><name><surname>Liszio</surname><given-names>Stefan</given-names></name></contrib><contrib contrib-type="reviewer"><name><surname>Qian</surname><given-names>Kun</given-names></name></contrib><contrib contrib-type="reviewer"><name><surname>Grilo</surname><given-names>Ana</given-names></name></contrib><contrib contrib-type="reviewer"><name><surname>Toomey</surname><given-names>Rachel</given-names></name></contrib></contrib-group><contrib-group><contrib id="contrib1" contrib-type="author" corresp="yes"><name><surname>Heuvelink</surname><given-names>Annerieke</given-names></name><degrees>PhD</degrees><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0001-1534-9358</contrib-id><xref rid="aff1" ref-type="aff">1</xref><address><institution/><institution>Imaging Innovation</institution><institution>Philips Medical Systems</institution><addr-line>High Tech Campus 34</addr-line><addr-line>Eindhoven, 5656 AE</addr-line><country>Netherlands</country><phone>31 639833471</phone><email>Annerieke.Heuvelink@philips.com</email></address></contrib><contrib id="contrib2" contrib-type="author"><name><surname>Saini</surname><given-names>Privender</given-names></name><degrees>PDEng</degrees><xref rid="aff2" ref-type="aff">2</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0009-2021-9783</contrib-id></contrib><contrib id="contrib3" contrib-type="author"><name><surname>Ta&#x0015f;ar</surname><given-names>&#x000d6;zg&#x000fc;r</given-names></name><degrees>MFA</degrees><xref rid="aff3" ref-type="aff">3</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0002-6259-2243</contrib-id></contrib><contrib id="contrib4" contrib-type="author"><name><surname>Nauts</surname><given-names>Sanne</given-names></name><degrees>PhD</degrees><xref rid="aff1" ref-type="aff">1</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0009-4815-4096</contrib-id></contrib></contrib-group><aff id="aff1">

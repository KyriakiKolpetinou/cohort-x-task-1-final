<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="review-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Eur Urol Open Sci</journal-id><journal-id journal-id-type="iso-abbrev">Eur Urol Open Sci</journal-id><journal-title-group><journal-title>European Urology Open Science</journal-title></journal-title-group><issn pub-type="ppub">2666-1691</issn><issn pub-type="epub">2666-1683</issn><publisher><publisher-name>Elsevier</publisher-name></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41280159</article-id><article-id pub-id-type="pmc">12630327</article-id><article-id pub-id-type="pii">S2666-1683(25)01439-9</article-id><article-id pub-id-type="doi">10.1016/j.euros.2025.10.009</article-id><article-categories><subj-group subj-group-type="heading"><subject>Review &#x02013; Kidney Cancer</subject></subj-group></article-categories><title-group><article-title>Genetic Testing and Counselling for Hereditary Renal Carcinoma: What Do Clinicians Need to Know?</article-title></title-group><contrib-group><contrib contrib-type="author" id="au005"><name><surname>Re</surname><given-names>Chiara</given-names></name><email>re.chiara@hsr.it</email><xref rid="af005" ref-type="aff">a</xref><xref rid="af010" ref-type="aff">b</xref><xref rid="af015" ref-type="aff">c</xref><xref rid="cor1" ref-type="corresp">&#x0204e;</xref></contrib><contrib contrib-type="author" id="au010"><name><surname>Pecoraro</surname><given-names>Angela</given-names></name><xref rid="af020" ref-type="aff">d</xref></contrib><contrib contrib-type="author" id="au015"><name><surname>Stewart</surname><given-names>Grant D.</given-names></name><xref rid="af015" ref-type="aff">c</xref><xref rid="af025" ref-type="aff">e</xref></contrib><contrib contrib-type="author" id="au020"><name><surname>Cali&#x000f2;</surname><given-names>Anna</given-names></name><xref rid="af030" ref-type="aff">f</xref></contrib><contrib contrib-type="author" id="au025"><name><surname>Erdem</surname><given-names>Selcuk</given-names></name><xref rid="af035" ref-type="aff">g</xref></contrib><contrib contrib-type="author" id="au030"><name><surname>Kalayci</surname><given-names>Tugba</given-names></name><xref rid="af040" ref-type="aff">h</xref></contrib><contrib contrib-type="author" id="au035"><name><surname>Uyguner</surname><given-names>Zehra Oya</given-names></name><xref rid="af040" ref-type="aff">h</xref></contrib><contrib contrib-type="author" id="au040"><name><surname>Larcher</surname><given-names>Alessandro</given-names></name><xref rid="af005" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au045"><name><surname>Campi</surname><given-names>Riccardo</given-names></name><xref rid="af045" ref-type="aff">i</xref><xref rid="af050" ref-type="aff">j</xref></contrib><contrib contrib-type="author" id="au050"><name><surname>Amparore</surname><given-names>Daniele</given-names></name><xref rid="af055" ref-type="aff">k</xref><xref rid="af060" ref-type="aff">l</xref></contrib><contrib contrib-type="author" id="au055"><name><surname>Whitworth</surname><given-names>James</given-names></name><xref rid="af025" ref-type="aff">e</xref><xref rid="af065" ref-type="aff">m</xref><xref rid="fn1" ref-type="fn">&#x02020;</xref></contrib><contrib contrib-type="author" id="au060"><name><surname>Marandino</surname><given-names>Laura</given-names></name><xref rid="af070" ref-type="aff">n</xref><xref rid="fn1" ref-type="fn">&#x02020;</xref></contrib><on-behalf-of>on behalf of </on-behalf-of><contrib contrib-type="author"><collab>European Association of Urology Young Academic Urologists Renal Cancer Working Group</collab></contrib><aff id="af005"><label>a</label>Division of Experimental Oncology, Unit of Urology; Urological Research Institute, IRCCS San Raffaele Scientific Institute, Milan, Italy</aff><aff id="af010"><label>b</label>Vita-Salute San Raffaele University, Milan, Italy</aff><aff id="af015"><label>c</label>Department of Surgery, University of Cambridge, Cambridge Biomedical Centre, Cambridge, UK</aff><aff id="af020"><label>d</label>Department of Urology, Pederzoli Hospital, Peschiera del Garda, Italy</aff><aff id="af025"><label>e</label>Cancer Research UK Cambridge Centre, Cambridge Biomedical Campus, Cambridge, UK</aff><aff id="af030"><label>f</label>Department of Diagnostics and Public Health, Section of Pathology, University of Verona, Verona, Italy</aff><aff id="af035"><label>g</label>Division of Urologic Oncology, Department of Urology, Istanbul University, Istanbul, Turkey</aff><aff id="af040"><label>h</label>Department of Medical Genetics, Istanbul University, Istanbul, Turkey</aff><aff id="af045"><label>i</label>Department of Experimental and Clinical Medicine, University of Florence, Florence, Italy</aff><aff id="af050"><label>j</label>Unit of Urology and Renal Transplantation, Oncology Department, Careggi University Hospital, Florence, Italy</aff><aff id="af055"><label>k</label>Department of Oncology, University of Turin, Orbassano, Turin, Italy</aff><aff id="af060"><label>l</label>Division of Urology, Department of Surgery, Candiolo Cancer Institute, FPO-IRCCS, Candiolo, Turin, Italy</aff><aff id="af065"><label>m</label>Department of Medical Genetics, School of Clinical Medicine, University of Cambridge, Cambridge, UK</aff><aff id="af070"><label>n</label>Department of Medical Oncology, The Royal Marsden NHS Foundation Trust, London, UK</aff></contrib-group><author-notes><corresp id="cor1"><label>&#x0204e;</label>Corresponding author. Division of Experimental Oncology, Unit of Urology, Urological Research Institute, IRCCS San Raffaele Scientific Institute, Milan, Italy. <email>re.chiara@hsr.it</email></corresp><fn id="fn1"><label>&#x02020;</label><p id="np025">These authors contributed equally to this work.</p></fn></author-notes><pub-date pub-type="pmc-release"><day>04</day><month>11</month><year>2025</year></pub-date><!-- PMC Release delay is 0 months and 0 days and was based on <pub-date
						pub-type="epub">.--><pub-date pub-type="collection"><month>12</month><year>2025</year></pub-date><pub-date pub-type="epub"><day>04</day><month>11</month><year>2025</year></pub-date><volume>82</volume><fpage>131</fpage><lpage>141</lpage><history><date date-type="accepted"><day>16</day><month>10</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; 2025 The Authors. Published by Elsevier B.V. on behalf of European Association of Urology.</copyright-statement><copyright-year>2025</copyright-year><copyright-holder/><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p>This is an open access article under the CC BY-NC-ND license (http://creativecommons.org/licenses/by-nc-nd/4.0/).</license-p></license></permissions><abstract abstract-type="teaser" id="ab005"><title>Take Home Message</title><p>Genetic testing for hereditary renal cell carcinoma remains underutilised in clinical practice. However, testing crucial for early disease detection, targeted surveillance, individualised surgical planning, and cascade testing of at-risk relatives. In this setting, multidisciplinary management is essential to ensure comprehensive and effective care.</p></abstract><abstract id="ab010"><sec><title>Background and objective</title><p>Hereditary renal cell carcinoma (H-RCC) accounts for 5&#x02013;8% of kidney cancers and has important clinical implications. However, H-RCC is frequently underdiagnosed, and genetic counselling is underutilised in clinical practice. This review provides an overview of the main H-RCC syndromes and offers a step-by-step clinical guide to support clinicians in the identification, counselling, and management of affected individuals.</p></sec><sec><title>Methods</title><p>A nonsystematic search of PubMed/MEDLINE was performed in June 2024 and updated in February 2025, covering guidelines, consensus statements, and original studies. Additional sources were identified via manual reference screening.</p></sec><sec><title>Key findings and limitations</title><p>Although H-RCC syndromes may present with overlapping features, they vary significantly in genetics, histology, and aggressiveness. While referral criteria for genetic testing in RCC are outlined in multiple international guidelines, certain criteria are still debated. Genetic counselling is essential both before and after testing. Pretest counselling ensures informed consent and helps patients to understand the implications of results. Post-test counselling discusses medical and psychological implications, and guides cascade testing for at-risk relatives. Mainstream genetic testing led by clinicians other than genetic specialists is increasingly adopted, but adequate training and structured collaboration with genetics services are required. Clinical management differs across syndromes: while aggressive entities such as FH-associated RCC warrant prompt surgical intervention, others such as clear-cell RCC associated with von Hippel-Lindau disease benefit from active surveillance, with nephron-sparing approaches typically recommended when the largest tumour reaches a threshold of 3 cm to balance oncological control and renal preservation. The main limitation of this review is its nonsystematic design.</p></sec><sec><title>Conclusions and clinical implications</title><p>Genetic assessment is a key component of RCC management. Enhancement of clinician awareness and fostering of multidisciplinary collaboration are key to improving care and outcomes.</p></sec><sec><title>Patient summary</title><p>For patients with kidney cancer, genetic risk assessment and testing are crucial for improving patient care, guiding surveillance, and offering tailored treatments to those who might have a hereditary form of cancer. Collaboration among different specialists is vital to provide the best care for patients with hereditary kidney cancer syndromes.</p></sec></abstract><kwd-group id="kg005"><title>Keywords</title><kwd>Genetic counselling</kwd><kwd>Genetic testing</kwd><kwd>Germline variant</kwd><kwd>Hereditary syndrome</kwd><kwd>Renal cell carcinoma</kwd><kwd>Recommendations</kwd></kwd-group></article-meta><notes><p id="ms005"><bold><italic>Associate Editor:</italic></bold> Maria Carmen Mir</p></notes></front><body><sec id="s0005"><label>1</label><title>Introduction</title><p id="p0030">It is estimated that hereditary renal cell carcinoma (H-RCC) accounts for 5&#x02013;8% of all newly diagnosed kidney cancers [<xref rid="b0005" ref-type="bibr">1</xref>,<xref rid="b0010" ref-type="bibr">2</xref>]; however, this approximation may be significantly underestimated particularly in patients with advanced non&#x02013;clear-cell RCC [<xref rid="b0015" ref-type="bibr">3</xref>]. Although it has been well established that several variants are associated with higher risk of RCC [<xref rid="b0015" ref-type="bibr">3</xref>], genetic counselling is often underutilised as a component of the work-up for patients with kidney cancer [<xref rid="b0020" ref-type="bibr">4</xref>]. Accurate and prompt diagnosis allows for an appropriate surveillance programme that can reduce morbidity and mortality. Identification of H-RCC can guide tailored surgical management and, when available, specific systemic treatment. Recognition of H-RCC also allows &#x0201c;cascade testing&#x0201d; for early identification of other potentially affected family members and supports prenatal genetic management [<xref rid="b0025" ref-type="bibr">5</xref>]. Various barriers at the patient, clinician, and health-care system levels may complicate identification of individuals suitable for referral to cancer genetics services [<xref rid="b0030" ref-type="bibr">6</xref>]. Because of the significant implications for clinical practice, enhanced clinical guidelines on genetic testing and counselling are needed [<xref rid="b0030" ref-type="bibr">6</xref>].</p><p id="p0035">The aim of this review is to provide a comprehensive overview of the most well-characterised H-RCC syndromes and to offer a practical step-by-step clinical guide for diagnosis and management to assist clinicians in the care of patients with suspected or diagnosed H-RCC.</p></sec><sec id="s0010"><label>2</label><title>Methods</title><p id="p0040">We performed a nonsystematic, narrative review on H-RCC with a focus on genetic risk assessment, counselling, testing, and clinical aspects of RCC syndromes. A PubMed/MEDLINE search was conducted to identify scientific guidelines, consensus statements, original studies, and review articles on H-RCC. Keywords included &#x0201c;kidney cancer&#x0201d;, &#x0201c;kidney neoplasm&#x0201d;, &#x0201c;renal cancer&#x0201d;, &#x0201c;renal cell carcinoma&#x0201d;, &#x0201c;genetic testing&#x0201d;, &#x0201c;genetic counselling&#x0201d;, &#x0201c;germline variants&#x0201d;, &#x0201c;germline mutations&#x0201d;, &#x0201c;hereditary RCC&#x0201d;, &#x0201c;hereditary syndromes&#x0201d;, and &#x0201c;recommendations&#x0201d;, along with free-text and related and derivative terms. The search was conducted in June 2024 and updated in February 2025. To focus on the most up-to-date guidelines and recommendations, we initially included articles published in the last 20&#x000a0;yr. Additional relevant manuscripts were subsequently identified via a manual search of the reference lists of the articles retrieved. The resulting review provides a summary of the most well-characterised H-RCC syndromes, and a step-by-step clinical guide based on existing recommendations that covers all relevant aspects, from patient identification and counselling to the uro-oncological management of confirmed cases in clinical practice. <xref rid="s0115" ref-type="sec">Supplementary Table 1</xref> provides a practical vocabulary of the genetics terminology used in the text.</p></sec><sec id="s0015"><label>3</label><title>Results</title><sec id="s0020"><label>3.1</label><title>H-RCC syndromes: key features</title><p id="p0045">More than a dozen genes (including <italic>VHL, FH, FLCN, MET, SDHB, BAP-1</italic>, and <italic>PTEN</italic>, among others) for which germline alterations significantly increase the risk of RCC and possibly other benign/malignant manifestations are currently recognised [<xref rid="b0035" ref-type="bibr">7</xref>]. Many of these represent the underlying cause of monogenic syndromes related to germline alterations in tumour suppressor genes, except for hereditary papillary RCC syndrome (HPRC), which is characterised by activating variants in the <italic>MET</italic> proto-oncogene. Although these syndromes have overlapping features, they vary significantly in histological characteristics, aggressiveness, penetrance, and associated clinical manifestations [<xref rid="b0035" ref-type="bibr">7</xref>,<xref rid="b0040" ref-type="bibr">8</xref>]. <xref rid="t0005" ref-type="table">Table 1</xref> summarises the most well-characterised H-RCC syndromes and their manifestations and management.<table-wrap position="float" id="t0005"><label>Table 1</label><caption><p>Overview of genetic and clinical characteristics of the most well-characterised hereditary syndromes associated with renal cell carcinoma, including recommendations for surgical treatment and surveillance protocols regarding renal tumour management</p></caption><table frame="hsides" rules="groups"><thead><tr><th>Syndrome</th><th>Gene(s)</th><th>Renal histophatology</th><th>Other selected manifestations</th><th>Surgical treatment [<xref rid="b0215" ref-type="bibr">43</xref>]</th><th>Specific sTx <xref rid="tblfn1" ref-type="table-fn">a</xref></th><th>RCC screening protocol [<xref rid="b0215" ref-type="bibr">43</xref>]</th></tr></thead><tbody><tr><td>VHL [<xref rid="b0045" ref-type="bibr">[9]</xref>, <xref rid="b0050" ref-type="bibr">[10]</xref>, <xref rid="b0055" ref-type="bibr">[11]</xref>, <xref rid="b0060" ref-type="bibr">[12]</xref>, <xref rid="b0065" ref-type="bibr">[13]</xref>, <xref rid="b0070" ref-type="bibr">[14]</xref>,<xref rid="b0315" ref-type="bibr">[63]</xref>, <xref rid="b0320" ref-type="bibr">[64]</xref>, <xref rid="b0325" ref-type="bibr">[65]</xref>]</td><td><italic>VHL</italic></td><td>ccRCC</td><td>Retinal and CNS HAB, PCC, PGL, retinal angioma, epididymal cyst, EST, pancreatic cyst, NE tumour</td><td>NSS in VHL centre when tumour reaches 3 cm [<xref rid="b0010" ref-type="bibr">2</xref>,<xref rid="b0320" ref-type="bibr">64</xref>]<break/>Ablative treatment <xref rid="tblfn2" ref-type="table-fn">b</xref></td><td>Belzutifan (preferred) [<xref rid="b0010" ref-type="bibr">2</xref>,<xref rid="b0215" ref-type="bibr">43</xref>,<xref rid="b0335" ref-type="bibr">[67]</xref>, <xref rid="b0340" ref-type="bibr">[68]</xref>, <xref rid="b0345" ref-type="bibr">[69]</xref>]<break/>Pazopanib (useful in some circumstances) [<xref rid="b0215" ref-type="bibr">43</xref>]</td><td>aMRI (preferred) or CT-IVC to assess kidneys, pancreas, and adrenal glands every 2&#x000a0;yr starting at age 15&#x000a0;yr [<xref rid="b0320" ref-type="bibr">64</xref>]</td></tr><tr><td>BHDS [<xref rid="b0070" ref-type="bibr">[14]</xref>, <xref rid="b0075" ref-type="bibr">[15]</xref>, <xref rid="b0080" ref-type="bibr">[16]</xref>, <xref rid="b0085" ref-type="bibr">[17]</xref>,<xref rid="b0360" ref-type="bibr">72</xref>]</td><td><italic>FLCN</italic></td><td>chRCC, HOT, ccRCC, oncocytoma</td><td>Lung cysts, spontaneous PMT, cutaneous FFO</td><td>NSS<break/>Ablative treatment <xref rid="tblfn2" ref-type="table-fn">b</xref></td><td>&#x02013;</td><td>aMRI (preferred) or CT-IVC every 3&#x000a0;yr starting at age 20&#x000a0;yr</td></tr><tr><td>FH TPDS/HLRCC [<xref rid="b0070" ref-type="bibr">14</xref>,<xref rid="b0090" ref-type="bibr">[18]</xref>, <xref rid="b0095" ref-type="bibr">[19]</xref>, <xref rid="b0100" ref-type="bibr">[20]</xref>, <xref rid="b0105" ref-type="bibr">[21]</xref>]</td><td><italic>FH</italic></td><td>FH-deficient RCC or HLRCC-associated RCC (unilateral, solitary)</td><td>Cutaneous leiomyomas, uterine leiomyomas</td><td>Immediate surgery, RN [<xref rid="b0010" ref-type="bibr">2</xref>,<xref rid="b0215" ref-type="bibr">43</xref>]</td><td>Erlotinib + bevacizumab [<xref rid="b0010" ref-type="bibr">2</xref>,<xref rid="b0215" ref-type="bibr">43</xref>,<xref rid="b0375" ref-type="bibr">75</xref>]<break/>Cabozantinib + nivolumab [<xref rid="b0215" ref-type="bibr">43</xref>]</td><td>aMRI (preferred) or CT-IVC annually starting at age 8&#x02013;10&#x000a0;yr</td></tr><tr><td>HPRC [<xref rid="b0070" ref-type="bibr">14</xref>,<xref rid="b0135" ref-type="bibr">[27]</xref>, <xref rid="b0140" ref-type="bibr">[28]</xref>]</td><td><italic>MET</italic></td><td>pRCC (multifocal, bilateral)</td><td>&#x02013;</td><td>NSS<break/>Ablative treatment <xref rid="tblfn2" ref-type="table-fn">b</xref></td><td>&#x02013;</td><td>aMRI (preferred) or CT-IVC every 1&#x02013;2 y starting at age 30 y</td></tr><tr><td>Hereditary PGL/PCC syndrome [<xref rid="b0070" ref-type="bibr">14</xref>,<xref rid="b0145" ref-type="bibr">[29]</xref>, <xref rid="b0150" ref-type="bibr">[30]</xref>, <xref rid="b0155" ref-type="bibr">[31]</xref>]</td><td><italic>SDHA</italic><break/><italic>SDHB</italic><break/><italic>SDHC</italic><break/><italic>SDHD</italic></td><td>SDH-deficient RCC</td><td>PGL, PCC, GIST</td><td>RN (larger tumours or aggressive HST)<break/>PN can be considered in the absence if aggressive HST and in early-stage disease [<xref rid="b0215" ref-type="bibr">43</xref>]</td><td>&#x02013;</td><td>aMRI (preferred) or CT-IVC every 2 y concurrently with PGL/PCC screening recommendations starting at age 12 y</td></tr><tr><td>TSC [<xref rid="b0035" ref-type="bibr">7</xref>,<xref rid="b0040" ref-type="bibr">8</xref>,<xref rid="b0070" ref-type="bibr">14</xref>]</td><td><italic>TSC1</italic><break/><italic>TSC2</italic></td><td>AML renal cysts, eosinophilic solid and cystic RCC, RCC with fibromyomatous stroma, eosinophilic<break/>vacuolated tumour, low-grade oncocytic tumour, ccRCC</td><td>Angiofibromas, cortical dysplasias, hypopigmented macules, multiple retinal nodular hamartomas,<break/>cardiac rhabdomyoma,<break/>lymphangioleiomyomatosis, SGCA, subependymal nodules, ungual fibromas, Shagreen patch</td><td>NSS<break/>Ablative treatment <xref rid="tblfn2" ref-type="table-fn">b</xref><break/>AML managed separately as a benign lesion.<sup>31</sup><break/>Epithelioid AML treated with a combination of radical surgery + sTx</td><td>Everolimus (preferred) [<xref rid="b0010" ref-type="bibr">2</xref>,<xref rid="b0215" ref-type="bibr">43</xref>]<break/>Sirolimus [<xref rid="b0215" ref-type="bibr">43</xref>]</td><td>aMRI (preferred) or CT-IVC every 1&#x02013;3 y starting at age 12&#x000a0;yr</td></tr><tr><td>BAP1 TPDS [<xref rid="b0035" ref-type="bibr">7</xref>,<xref rid="b0040" ref-type="bibr">8</xref>,<xref rid="b0070" ref-type="bibr">14</xref>]</td><td>BAP1</td><td>ccRCC</td><td>cutaneous and uveal melanoma, mesothelioma</td><td>&#x02013;</td><td>&#x02013;</td><td>aMRI (preferred) or CT-IVC every 2&#x000a0;yr starting at age 30&#x000a0;yr</td></tr><tr><td>Chromosome 3 translocation syndrome [<xref rid="b0035" ref-type="bibr">7</xref>,<xref rid="b0040" ref-type="bibr">8</xref>,<xref rid="b0070" ref-type="bibr">14</xref>]</td><td>Translocations<break/>3:6; 3:8; 3:11</td><td>ccRCC</td><td>None</td><td>&#x02013;</td><td>&#x02013;</td><td>&#x02013;</td></tr><tr><td>Cowden syndrome [<xref rid="b0035" ref-type="bibr">7</xref>,<xref rid="b0040" ref-type="bibr">8</xref>,<xref rid="b0070" ref-type="bibr">14</xref>]</td><td><italic>PTEN</italic></td><td>ccRCC, pRCC, chRCC</td><td>Macrocephaly; breast, thyroid, endometrial cancers; GI hamartoma or GGN; mucocutaneous lesions; LDD</td><td>&#x02013;</td><td>&#x02013;</td><td>&#x02013;</td></tr><tr><td>MITF predisposition to fRCC [<xref rid="b0400" ref-type="bibr">80</xref>,<xref rid="b0405" ref-type="bibr">81</xref>]</td><td><italic>MITF</italic> p.E318K germline variant</td><td>MITF translocation RCC</td><td>Melanoma, pancreatic cancer, PCC</td><td>&#x02013;</td><td>&#x02013;</td><td>&#x02013;</td></tr></tbody></table><table-wrap-foot><fn><p>VHL = von Hippel-Lindau; BHDS = Birt-Hogg-Dub&#x000e9; syndrome ; HLRCC = hereditary leyomiomatosis and renal cell carcinoma; HPRC = hereditary papillary renal carcinoma; TPDS = tumour predisposition syndrome; PGL = paraganglioma; PCC = phaeochromocytoma; TSC = tuberous sclerosis complex; AML = angiomyolipoma; CNS = central nervous system; RCC = renal cell carcinoma; ccRCC = clear-cell RCC; chRCC = chromophobe RCC; fRCC = familial RCC; pRCC = papillary RCC; MITF = microphthalmia-associated transcription facto; EST = endolymphatic sac tumour; FFO = fibrofolliculoma; GGN = ganglioneuroma; GI = gastrointestinal; GIST = GI stromal tumour; HAB = hae, MRI = abdominal magnetic resonance imaging; CT-IVC = computed tomography with and without intravenous contrast.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tblfn1"><label>a</label><p id="np005">Approval and reimbursement vary by health care system.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tblfn2"><label>b</label><p id="np010">For patients with significant medical or surgical risk [<xref rid="b0215" ref-type="bibr">43</xref>].</p></fn></table-wrap-foot></table-wrap></p><sec id="s0025"><label>3.1.1</label><title>Von Hippel-Lindau disease</title><p id="p0050">Von Hippel-Lindau (VHL) disease is a rare autosomal-dominant hereditary disorder caused by germline pathogenic variants in the <italic>VHL</italic> tumour suppressor gene located on the short arm of chromosome 3. VHL disease represents the most common hereditary disorder associated with RCC; prevalence rates range from 1/36 000 to 1/91 000 individuals worldwide [<xref rid="b0045" ref-type="bibr">9</xref>,<xref rid="b0050" ref-type="bibr">10</xref>]. Affected individuals are predisposed to the development of lesions in multiple organs, such as retinal and central nervous system (CNS) haemangioblastomas, RCC, phaeochromocytoma, pancreatic neuroendocrine tumours, endolymphatic sac tumours, and renal, pancreatic, and epididymal cysts [<xref rid="b0045" ref-type="bibr">9</xref>]. While the risk of RCC varies among different VHL subtypes, it has been reported that the lifetime risk for the most common forms reaches up to 70% [<xref rid="b0055" ref-type="bibr">11</xref>]. VHL-associated RCC is typically bilateral and multifocal, exhibits clear-cell histology, and presents a more indolent course than its sporadic counterpart [<xref rid="b0060" ref-type="bibr">12</xref>]. The expression of VHL disease is variable. <italic>VHL</italic> pathogenic variants are highly penetrant, with nearly all individuals showing symptoms by the age of 61&#x02013;70&#x000a0;yr [<xref rid="b0065" ref-type="bibr">13</xref>]. De novo variants are relatively common and account for approximately 20% of cases [<xref rid="b0065" ref-type="bibr">13</xref>]. Therefore, individuals may lack a family history of VHL disease [<xref rid="b0070" ref-type="bibr">14</xref>].</p></sec><sec id="s0030"><label>3.1.2</label><title>Birt-Hogg-Dub&#x000e9; syndrome</title><p id="p0055">Birt-Hogg-Dub&#x000e9; (BHD) syndrome is caused by germline variants in the <italic>FLCN</italic> tumour suppressor gene, which encodes the protein folliculin. Although the commonly reported prevalence of BHD syndrome is 1/200 000, it is believed that the condition is underdiagnosed [<xref rid="b0075" ref-type="bibr">15</xref>,<xref rid="b0080" ref-type="bibr">16</xref>]. BHD syndrome is associated with fibrofolliculomas/trichodischomas (raised pale or skin-coloured papules that predominantly occur on the face and upper trunk) and multiple pulmonary cysts, which may lead to spontaneous pneumothorax [<xref rid="b0040" ref-type="bibr">8</xref>,<xref rid="b0085" ref-type="bibr">17</xref>]. Approximately one-third of affected individuals develop bilateral and multifocal renal tumours with variable histology, including hybrid oncocytic tumours containing features of both chromophobe RCC and oncocytoma. These tumours are characterised by indolent behaviour and lower metastatic potential in comparison to sporadic RCC [<xref rid="b0080" ref-type="bibr">16</xref>]. There has been a recent proposal to rename this neoplasm as <italic>FCLN</italic>-mutated tumour and use an immunohistochemical panel for screening [<xref rid="b0090" ref-type="bibr">18</xref>].</p></sec><sec id="s0035"><label>3.1.3</label><title>FH tumour predisposition syndrome</title><p id="p0060">FH tumour predisposition (FHTP) syndrome, previously known as hereditary leiomyomatosis and RCC (HLRCC) syndrome, is caused by germline variants in the <italic>FH</italic> gene, which encodes the Krebs-cycle enzyme fumarate hydratase. This syndrome is associated with higher risk of cutaneous leiomyomas, multiple uterine leiomyomas (fibroids) in women, and approximately 15&#x02013;20% risk of RCC [<xref rid="b0095" ref-type="bibr">19</xref>,<xref rid="b0100" ref-type="bibr">20</xref>]. Phaeochromocytoma and paraganglioma have also been reported. The prevalence of FHTP syndrome is unknown. While previous estimates suggest 1/200 000 individuals, the increasing availability of genetic panel testing that includes the <italic>FH</italic> gene suggests a higher prevalence and lower RCC penetrance than previously thought [<xref rid="b0105" ref-type="bibr">21</xref>]. FHTP syndrome&#x02013;associated RCC can be highly aggressive [<xref rid="b0095" ref-type="bibr">19</xref>]. Advanced disease at presentation with nodal involvement or distant metastases can occur even when renal tumours are small [<xref rid="b0110" ref-type="bibr">22</xref>].</p><p id="p0065">From a pathology point of view, these tumours are characterised by a mixed architectural pattern, including papillary, solid, and cribriform tubulocystic patterns and high nucleolar grade [<xref rid="b0115" ref-type="bibr">23</xref>]. Sarcomatoid or rhabdoid differentiation and tumour necrosis are frequently seen and reflect the intrinsic aggressiveness of the tumour. FH deficiency can be detected as abnormal negative immunohistochemical staining for FH in approximately 80&#x02013;90% of FH-deficient tumours. However, this marker might not be sensitive enough to exclude FH-deficient RCC, considering that there are many different FH variants and some pathogenic variants exhibit normal expression despite loss of heterozygosity, which could potentially lead to false-negative results [<xref rid="b0120" ref-type="bibr">24</xref>,<xref rid="b0125" ref-type="bibr">25</xref>]. Next-generation sequencing (NGS) remains the gold standard for confirming the diagnosis, but it is time-consuming and expensive. In this scenario, <italic>S</italic>-(2-succino)-cysteine (2SC) protein (derived from the reaction between fumarate and cysteine sulfhydryl groups of proteins) has emerged as a promising biomarker [<xref rid="b0130" ref-type="bibr">26</xref>].</p></sec><sec id="s0040"><label>3.1.4</label><title>Hereditary papillary RCC</title><p id="p0070">HPRC is a very rare autosomal-dominant syndrome caused by germline variants in the <italic>MET</italic> proto-oncogene, located on chromosome 7. Prevalence has been estimated as &#x0003c;1/100 000 [<xref rid="b0135" ref-type="bibr">27</xref>]. HPRC is characterised by the development of slow-growing, bilateral, multifocal papillary RCC with no known extrarenal manifestations [<xref rid="b0140" ref-type="bibr">28</xref>]. The disease is mostly detected after the age of 30&#x000a0;yr and the risk of RCC increases with age, with penetrance close to 100% by the age of 80&#x000a0;yr [<xref rid="b0040" ref-type="bibr">8</xref>].</p></sec><sec id="s0045"><label>3.1.5</label><title>Hereditary SDH-deficient RCC</title><p id="p0075">SDH is an enzyme composed of multiple subunits, including SDHA, SDHB, SDHC, and SDHD [<xref rid="b0145" ref-type="bibr">29</xref>]. SDH takes part in both the Krebs tricarboxylic acid cycle and the mitochondrial electron transport chain. Germline variants in the genes encoding all subunits have been associated with paragangliomas, phaeochromocytomas, and, less frequently, gastrointestinal stromal tumours and RCC [<xref rid="b0150" ref-type="bibr">30</xref>]. SDH-deficient RCC is most commonly associated with variants in subunit B [<xref rid="b0145" ref-type="bibr">29</xref>]. Individuals with an <italic>SDHB</italic> pathogenic variant have 4.7% risk of developing RCC by the age of 60&#x000a0;yr [<xref rid="b0155" ref-type="bibr">31</xref>]. SDH-deficient RCC has specific histological features; most commonly, it presents as an oncocytic low-grade tumour with cytoplasmic vacuoles and occasionally flocculent inclusions, which should prompt evaluation of SDH on immunohistochemistry [<xref rid="b0160" ref-type="bibr">32</xref>]. Loss of SDHB on immunohistochemistry is a sensitive and specific marker and should prompt genetic referral [<xref rid="b0165" ref-type="bibr">33</xref>]. The prognosis of SDH-deficient RCC is variable; a few cases with aggressive behaviour have been observed in the presence of high nuclear grade, sarcomatoid differentiation, and necrosis [<xref rid="b0145" ref-type="bibr">29</xref>,<xref rid="b0160" ref-type="bibr">32</xref>,<xref rid="b0165" ref-type="bibr">33</xref>].</p></sec><sec id="s0050"><label>3.1.6</label><title>Tuberous sclerosis complex</title><p id="p0080">Tuberous sclerosis complex (TSC) is an autosomal-dominant genetic disorder caused by germline loss-of-function mutations in either the <italic>TSC1</italic> or <italic>TSC2</italic> gene, which lead to dysregulation of the mTOR pathway [<xref rid="b0170" ref-type="bibr">34</xref>,<xref rid="b0175" ref-type="bibr">35</xref>]. TSC incidence is approximately 1 in 6000 births worldwide, with approximately two-thirds of cases arising from de novo mutations [<xref rid="b0180" ref-type="bibr">36</xref>]. TSC is characterised by the development of hamartomas in multiple organs, including the brain, skin, heart, and lungs. A subset of patients also presents with cognitive impairment and neurological manifestations [<xref rid="b0170" ref-type="bibr">34</xref>,<xref rid="b0175" ref-type="bibr">35</xref>]. The most common abdominal lesions include bilateral multifocal angiomyolipomas, renal epithelial cysts, and RCC, which represent a major source of morbidity and mortality in TSC [<xref rid="b0185" ref-type="bibr">37</xref>]. Although angiomyolipomas and their variants are typically indolent tumours, some epithelioid angiomyolipomas and pure perivascular epithelioid cell neoplasms exhibit aggressive behaviour, with a non-negligible risk of embolisation or surgery. Malignancy criteria have been proposed to aid in their identification [<xref rid="b0190" ref-type="bibr">[38]</xref>, <xref rid="b0195" ref-type="bibr">[39]</xref>, <xref rid="b0200" ref-type="bibr">[40]</xref>].</p></sec></sec><sec id="s0055"><label>3.2</label><title>Current recommendations regarding genetic risk assessment and genetic testing</title><p id="p0085">Recommendations regarding genetic risk assessment and testing in RCC have been developed by several organisations, including the Canadian Urological Association [<xref rid="b0205" ref-type="bibr">41</xref>], the American College of Medical Genetics and Genomics (ACMG), the National Society of Genetic Counselors [<xref rid="b0030" ref-type="bibr">6</xref>], the American Urological Association [<xref rid="b0210" ref-type="bibr">42</xref>], the European Association of Urology [<xref rid="b0010" ref-type="bibr">2</xref>], the National Comprehensive Cancer Network (NCCN) [<xref rid="b0215" ref-type="bibr">43</xref>], and the UK genomic test directory for rare and inherited disease [<xref rid="b0220" ref-type="bibr">44</xref>] (<xref rid="t0010" ref-type="table">Table 2</xref>). In 2021, a North American multidisciplinary panel published the first clinical consensus statement on genetic risk assessment for H-RCC to address critical gaps in existing guidelines [<xref rid="b0020" ref-type="bibr">4</xref>], which provides a unified approach to evaluation as outlined across various guidelines and within the consensus statement itself.<table-wrap position="float" id="t0010"><label>Table 2</label><caption><p>International guideline criteria for referring patients with renal tumours for genetic counselling</p></caption><table frame="hsides" rules="groups"><thead><tr><th>Criterion</th><th>EAU guidelines [<xref rid="b0010" ref-type="bibr">2</xref>]</th><th>AUA guidelines [<xref rid="b0210" ref-type="bibr">42</xref></th><th>ACMG guidelines [<xref rid="b0030" ref-type="bibr">6</xref>]</th><th>NCCN guidelines [<xref rid="b0215" ref-type="bibr">43</xref>]</th><th>UK genomic test directory [<xref rid="b0220" ref-type="bibr">44</xref>]</th><th>KCRNC [<xref rid="b0205" ref-type="bibr">41</xref>]</th></tr></thead><tbody><tr><td>Age at diagnosis</td><td>&#x02264;46&#x000a0;yr</td><td>&#x02264;46&#x000a0;yr</td><td>&#x0003c;50&#x000a0;yr</td><td>&#x02264;46&#x000a0;yr</td><td>&#x02264;46&#x000a0;yr</td><td>&#x02264;45&#x000a0;yr <xref rid="tblfn3" ref-type="table-fn">a</xref></td></tr><tr><td>Radiology findings</td><td>Bilateral or multifocal tumours/cysts</td><td>Bilateral or multifocal renal masses</td><td>Bilateral or multifocal tumours</td><td>Bilateral or multifocal tumours</td><td>Bilateral/multifocal renal cancer</td><td>Bilateral or multifocal renal masses (benign/malignant) <xref rid="tblfn3" ref-type="table-fn">a</xref></td></tr><tr><td>Family Hx</td><td>1DR/2DR with RCC<break/>Close blood relative with a known pathogenic variant</td><td>Personal or family Hx suggests fRNPS<break/>1DR/2DR with Hx of renal malignancy or known clinical or genetic diagnosis of fRNPS (even if KC not observed)</td><td>&#x02265;1 close relative with ccRCC</td><td>Close blood relative (1DR or 2DR) with a known pathogenic/likely pathogenic variant in a cancer susceptibility gene<break/>&#x02265;1 1DR/2DR with RCC</td><td>1DR with RCC diagnosed at age &#x0003c;60&#x000a0;yr<break/>2DR with RCC diagnosed at age &#x0003c;50&#x000a0;yr</td><td>1DR/2DR with any renal tumour <xref rid="tblfn3" ref-type="table-fn">a</xref><break/>Any family member with a known clinical or genetic diagnosis of VHL, BHDS, HLRCC, HPRC, hereditary PGL/PCC, or TSC</td></tr><tr><td>HST characteristics</td><td>Multifocal pRCC HST<break/>Hereditary FH-deficient RCC<break/>RCC with FH deficiency<break/>Multiple chRCCs, oncocytomas, or HOTs<break/>SDH-deficient RCC HST</td><td>HOT/chRCC tumours suggestive of BHDS<break/>Histology suggesting HLRCC/FH deficiency or SDH-deficient RCC</td><td>RCC with papillary type 1 HST<break/>RCC with papillary type 2 HST<break/>RCC with collecting duct HST<break/>RCC with tubule-papillary HST<break/>RCC with BHDS-related HST (chRCC, oncocytoma, HOT)</td><td>Multifocal pRCC HST<break/>HLRCC-associated RCC, RCC with FH deficiency or other HLRCC-associated HST features<break/>BHD-related HST (multiple chRCC, oncocytoma, or HOTs)<break/>SDH-deficient RCC HST</td><td>Type 2 papillary HLRCC-associated RCC<break/>Tubulopapillary renal tumour</td><td>Non-ccRCC with unusual associated features (eg, chRCC, oncocytoma, or HOT)</td></tr><tr><td>Other manifestations</td><td>Additional TSC criteria should be assessed in individuals with AML</td><td>Additional TSC criteria should be assessed in individuals with AML</td><td>UC (or TCC) and 2 additional cases of any LS-associated cancer in the family (patient and relatives)<break/>RCC and 2 additional Cowden syndrome criteria in the same person<break/>AML of the kidney and one additional TSC criterion in the same person</td><td>AML of the kidney and one additional TSC criterion in the same person<break/>Unaffected individual (no RCC diagnosis) with:<break/>&#x02013; &#x02265;2 1DRs/2DRs with RCC (on the same side of the family)<break/>&#x02013; Any 1DR meeting the criteria above who is unable or unwilling to undergo genetic testing</td><td>Cerebellar/spinal HAB<break/>Retinal angioma<break/>PCC/PGL<break/>Spontaneous PMT<break/>FFO<break/>Trichodiscoma<break/>Cutaneous leiomyomata<break/>Uterine leiomyoma (age &#x0003c;40&#x000a0;yr with pathology suggesting FH variant)<break/>Mesothelioma<break/>Uveal melanoma</td><td>Hx of PMT <xref rid="tblfn3" ref-type="table-fn">a</xref>, <xref rid="tblfn4" ref-type="table-fn">b</xref><break/>One of the following dermatologic findings:<list list-type="simple" id="l0005"><list-item id="o0005"><label>&#x000ad;</label><p id="p0005">Skin leiomyomas <xref rid="tblfn3" ref-type="table-fn">a</xref>, <xref rid="tblfn4" ref-type="table-fn">b</xref></p></list-item><list-item id="o0010"><label>&#x000ad;</label><p id="p0010">Skin FFO/TCD <xref rid="tblfn3" ref-type="table-fn">a</xref>, <xref rid="tblfn4" ref-type="table-fn">b</xref></p></list-item></list>One of the following associated tumours:<list list-type="simple" id="l0010"><list-item id="o0015"><label>&#x000ad;</label><p id="p0015">PCC/PGL <xref rid="tblfn3" ref-type="table-fn">a</xref>, <xref rid="tblfn4" ref-type="table-fn">b</xref></p></list-item><list-item id="o0020"><label>&#x000ad;</label><p id="p0020">HAB of the retina/BCSC <xref rid="tblfn3" ref-type="table-fn">a</xref>, <xref rid="tblfn4" ref-type="table-fn">b</xref></p></list-item><list-item id="o0025"><label>&#x000ad;</label><p id="p0025">Early-onset MUFs (age &#x0003c;30&#x000a0;yr) <xref rid="tblfn3" ref-type="table-fn">a</xref>, <xref rid="tblfn4" ref-type="table-fn">b</xref></p></list-item></list>Lymphangiomyomatosis <xref rid="tblfn3" ref-type="table-fn">a</xref>, <xref rid="tblfn4" ref-type="table-fn">b</xref><break/>Childhood seizure disorder <xref rid="tblfn3" ref-type="table-fn">a</xref>, <xref rid="tblfn4" ref-type="table-fn">b</xref></td></tr></tbody></table><table-wrap-foot><fn><p>ACMG = American College of Medical Genetics and Genomics; AUA = American Urological Association; EAU = European Association of Urology; KCRNC = Kidney Cancer Research Network of Canada; NCCN = National Comprehensive Cancer Network; HST = histology; Hx = history; RCC = renal cell carcinoma; ccRCC = clear-cell RCC; fRPNS = familial renal neoplastic syndrome; BHDS = Birt-Hogg-Dub&#x000e9; syndrome; HLRCC = hereditary leiomyomatosis and renal cell cancer; AML = angiomyolipoma; TCC = transitional cell carcinoma; TSC = tuberous sclerosis complex; VHL = von Hippel-Lindau; HPRC = hereditary papillary renal cancer; BCSC = brainstem, cerebellum, or spinal cord; FFO = FFO = fibrofolliculoma; HAB = haemangioblastoma; HOT = hybrid oncocytic tumour; KC = kidney cancer; LS = Lynch syndrome; MUFs = multiple uterine fibroids; PGL = paraganglioma; PCC = phaeochromocytoma; PMT = pneumothorax; TCD = trichodisoma; UC = urothelial carcinoma; 1DR = first-degree relative; 2DR = second-degree relative.</p></fn></table-wrap-foot><table-wrap-foot><fn id="tblfn3"><label>a</label><p id="np015">Applicable to patients with any renal tumour (benign or malignant).</p></fn></table-wrap-foot><table-wrap-foot><fn id="tblfn4"><label>b</label><p id="np020">Or first-degree relative with the same.</p></fn></table-wrap-foot></table-wrap></p></sec><sec id="s0060"><label>3.3</label><title>Which patients should be considered for genetic assessment?</title><p id="p0090">Key clinical guidelines for RCC recommend genetic assessment for individuals [<xref rid="b0010" ref-type="bibr">2</xref>,<xref rid="b0205" ref-type="bibr">[41]</xref>, <xref rid="b0210" ref-type="bibr">[42]</xref>, <xref rid="b0215" ref-type="bibr">[43]</xref>]:<list list-type="simple" id="l0015"><list-item id="o0030"><label>(a)</label><p id="p0095">With a close blood relative (patient&#x02019;s first-degree [parents, siblings, children] and second-degree [half-siblings, aunts, uncles, nieces, nephews, grandparents, grandchildren] relatives) with a known pathogenic/likely pathogenic (P/LP) variant in a cancer susceptibility gene;</p></list-item><list-item id="o0035"><label>(b)</label><p id="p0100">With early-onset RCC, defined as age &#x02264;46&#x000a0;yr;</p></list-item><list-item id="o0040"><label>(c)</label><p id="p0105">With multifocal or bilateral renal masses;</p></list-item><list-item id="o0045"><label>(d)</label><p id="p0110">With a diagnosis of RCC and one or more first- or second-degree relatives with RCC;</p></list-item><list-item id="o0050"><label>(e)</label><p id="p0115">With suspicious histological characteristics (multifocal papillary histology, RCC with FH deficiency or other histological features associated with FHTP syndrome, BHD-related histology [multiple chromophobe, oncocytoma, or oncocytic hybrid], angiomyolipomas of the kidney and one additional TSC criterion in the same person, histology suggestive for SDH-deficient RCC) [<xref rid="b0010" ref-type="bibr">2</xref>,<xref rid="b0210" ref-type="bibr">42</xref>,<xref rid="b0215" ref-type="bibr">43</xref>];</p></list-item><list-item id="o0055"><label>(f)</label><p id="p0120">Without RCC if they have two or more first- or second-degree relatives with RCC (on the same side of the family) and/or any first-degree relative who meets the above criteria for genetic assessment who is unable or unwilling to undergo genetic testing [<xref rid="b0215" ref-type="bibr">43</xref>];</p></list-item><list-item id="o0060"><label>(g)</label><p id="p0125">With RCC and suspicious clinical features associated with hereditary syndromes (eg, history of pneumothorax, skin leiomyomas, early onset of multiple uterine fibroids) [<xref rid="b0225" ref-type="bibr">45</xref>]; and</p></list-item><list-item id="o0065"><label>(h)</label><p id="p0130">With RCC and genetic testing for the solid tumour revealed a variant that is reported to be associated with hereditary cancer syndromes [<xref rid="b0225" ref-type="bibr">45</xref>].</p></list-item></list></p><p id="p0135">While guidelines assist clinicians in identifying high-risk cases, the evidence for these recommendations sometimes lacks support from the literature. For instance, a cohort study of 254 patients with advanced RCC by Carlo et al [<xref rid="b0015" ref-type="bibr">3</xref>] revealed that 36% of individuals with high-penetrance RCC-associated variants would have been missed if ACMG referral criteria had been strictly followed. Their findings suggest the need for a broader genetic testing approach, particularly for patients with advanced non&#x02013;clear-cell RCC [<xref rid="b0015" ref-type="bibr">3</xref>].</p><p id="p0140">Regarding the age cutoff for genetic testing [<xref rid="b0230" ref-type="bibr">46</xref>], analysis by Shuch et al [<xref rid="b0235" ref-type="bibr">47</xref>] of the RCC age distribution in the general population (SEER-17 programme) and in their institutional hereditary kidney cancer population revealed a median age at diagnosis of 37&#x000a0;yr for H-RCC, and the authors recommended &#x02264;46&#x000a0;yr as the onset cutoff for genetic testing. Truong et al [<xref rid="b0240" ref-type="bibr">48</xref>] retrospectively analysed data for 232 patients with early-onset RCC (&#x02264;46&#x000a0;yr). P/LP germline variants were detected in 17.7%, with 9.1% in RCC-associated genes and 8.6% in non-RCC genes. P/LP variants were associated with bilateral/multifocal tumours, non&#x02013;clear-cell histology, and extrarenal malignancies. In solitary clear-cell RCC, the P/LP variant prevalence was 0% in RCC-associated genes and 9.9% in non-RCC genes [<xref rid="b0240" ref-type="bibr">48</xref>]. Other studies questioned age as an independent criterion for genetic testing, and the NCCN guidelines emphasise its limited sensitivity as a sole criterion for risk evaluation [<xref rid="b0245" ref-type="bibr">49</xref>,<xref rid="b0250" ref-type="bibr">50</xref>]. In the first consensus conference on genetic risk assessment for H-RCC [<xref rid="b0020" ref-type="bibr">4</xref>], there was general agreement on age alone as a sufficient criterion, with 67% of participants favouring a cutoff of &#x02264;46&#x000a0;yrs, although uniform consensus was not reached.</p><p id="p0145">At the same conference, there was uniform consensus on offering genetic risk assessment to patients with bilateral or multifocal tumours. However, discussions highlighted that individuals aged &#x0003e;60&#x000a0;yr may not require testing or are likely to test negative [<xref rid="b0020" ref-type="bibr">4</xref>]. Agreement was reached on assessment for individuals, with or without RCC, with a personal or family history of classic syndromic features associated with H-RCC [<xref rid="b0020" ref-type="bibr">4</xref>]. The panel also considered whether genetic risk assessment is necessary for patients who have undergone somatic tumour testing. Most participants agreed that if a variant is found in a gene associated with hereditary cancer syndromes, the decision to proceed with further genetic evaluation should be based on the specific gene involved. Meanwhile, parallel testing of tumour and normal tissues, which allows distinction between somatic and germline variants, is increasingly being integrated into clinical oncology. Emerging evidence indicates that 8&#x02013;18% of patients undergoing parallel testing harbour clinically actionable germline variants, and many of these patients would not meet traditional criteria for germline testing [<xref rid="b0255" ref-type="bibr">51</xref>].</p></sec><sec id="s0065"><label>3.4</label><title>What is the appropriate timing for genetic testing?</title><p id="p0150">For patients with a new diagnosis of RCC, genetic testing results may influence the management strategy for their kidney cancer [<xref rid="b0260" ref-type="bibr">52</xref>]. In the first consensus conference on RCC genetic risk assessment, the panel agreed (93%) on genetic testing before initiation of management for individuals with a localised renal lesion &#x0003c;3 cm and strong suspicion of a H-RCC syndrome [<xref rid="b0020" ref-type="bibr">4</xref>]. There was also agreement (79%) that patients with multifocal or bilateral disease should undergo genetic risk assessment before treatment. In patients with metastatic RCC, systemic therapy is typically initiated on confirmation of the pathological diagnosis. The consensus panel did not reach agreement on whether genetic risk assessment should precede management in metastatic disease not requiring urgent treatment when a H-RCC form is suspected [<xref rid="b0020" ref-type="bibr">4</xref>].</p><p id="p0155">The timing of genetic testing often intersects with the availability and interpretation of pathological findings, typically obtained via core needle biopsy or renal surgery. There are currently no guidelines regarding the use of renal mass biopsy in the H-RCC setting, and the role of pathology in guiding genetic assessment remains a matter of debate. Nonetheless, pathological features can be highly informative&#x02014;sometimes distinctive&#x02014;even in the absence of other syndromic manifestations. In such cases, histology may support targeted or even single-gene testing. The utility of testing must be evaluated on a case-by-case basis.</p></sec><sec id="s0070"><label>3.5</label><title>Who should request genetic testing?</title><p id="p0160">Genetic testing regulations differ across countries and health care systems. Medical geneticists traditionally hold a central role in prescribing tests, providing pretest counselling, and delivering results [<xref rid="b0265" ref-type="bibr">53</xref>,<xref rid="b0270" ref-type="bibr">54</xref>]. Genetic counsellors are highly skilled health care professionals with training in genomic medicine and counselling skills [<xref rid="b0275" ref-type="bibr">55</xref>].While the role of genetic counsellors is well defined in many countries, especially in USA [<xref rid="b0280" ref-type="bibr">56</xref>], it is still debated in other countries, including countries in Europe [<xref rid="b0265" ref-type="bibr">53</xref>,<xref rid="b0270" ref-type="bibr">54</xref>].</p><p id="p0165">The increasing number of patients eligible for genetic testing and the limited capacity of genetics departments to accommodate this growing demand have recently paved the way for mainstream genetic testing. In a mainstream genetic testing pathway, health care professionals who are not genetic specialists provide pretest counselling and order the genetic test [<xref rid="b0285" ref-type="bibr">57</xref>]. The first consensus panel on RCC genetic risk assessment agreed (92%) that physicians such as urologists and oncologists with expertise in H-RCC syndromes may offer counselling before genetic testing [<xref rid="b0020" ref-type="bibr">4</xref>]. However, while specialist physicians might have the expertise to integrate genetic test results into treatment decisions, they may find themselves in unfamiliar situations. A structured pathway for implementation of mainstream genetic testing, including dedicated training, is needed, as well as close collaboration between genetics and other clinical departments [<xref rid="b0285" ref-type="bibr">57</xref>,<xref rid="b0290" ref-type="bibr">58</xref>].</p></sec><sec id="s0075"><label>3.6</label><title>Pretest counselling: what patients should expect</title><p id="p0170">Genetic counselling is a process that helps individuals to understand and adapt to the medical, psychological, and familial implications of genetic contributions to their disease [<xref rid="b0295" ref-type="bibr">59</xref>]. As part of pretest genetic management, a multisystem evaluation of the patient and a thorough pedigree analysis are essential for identifying syndromic RCC and at-risk family members with subtle phenotypes [<xref rid="b0025" ref-type="bibr">5</xref>], particularly given the variable expressivity and incomplete penetrance of these conditions. Before proceeding with genetic testing, individuals should be informed about the purpose, scope, potential outcomes, and implications of the test results [<xref rid="b0300" ref-type="bibr">60</xref>], and informed consent must be obtained. In the context of pretest counselling for multigene panel testing, high-penetrance syndromes under evaluation should be clearly outlined and particular attention should be paid to the implications of less well-understood or less-penetrant genes and possible variants associated with syndromes not suggested by the personal or family history. In addition, the high rate of variants of uncertain significance (VUS) should be acknowledged [<xref rid="b0300" ref-type="bibr">60</xref>]. It is crucial to address the potential implications of genetic testing, including the risk of new primary tumours, the preventive or therapeutic options available, surveillance pathways, psychological aspects, and identification of familial risk [<xref rid="b0300" ref-type="bibr">60</xref>]. In addition, it should be clearly emphasised that further genetic tests may be necessary following the initial test. Patients should also be informed that rigorous clinical follow-up remains necessary, regardless of the genetic testing results.</p></sec><sec id="s0080"><label>3.7</label><title>What genetic testing should be requested and how to interpret the results</title><p id="p0175">When deciding on which genetic test to use, if the molecular genetic diagnosis has already been established within the family, targeted Sanger sequencing of the associated variant identified is sufficient [<xref rid="b0215" ref-type="bibr">43</xref>]. This approach is cost effective and allows for rapid diagnosis. However, while genetic analysis via Sanger sequencing is excellent at detecting small genetic variations such as single-nucleotide variants and small insertions or deletions, it cannot detect large deletions or insertions.</p><p id="p0180">In the absence of a known familial P/LP variant, genetic testing using a kidney cancer&#x02013;focused multigene panel or clinically guided single-gene testing is recommended. With NGS, multiple genes can be tested together in a larger panel. If a molecular genetic diagnosis has not been established but the clinical diagnosis is suspected, sequencing of the relevant gene(s) to identify the pathogenic variant is more appropriate. This is consistent with clinical guidelines recommendations [<xref rid="b0215" ref-type="bibr">43</xref>] and the first consensus conference on RCC genetic risk assessment [<xref rid="b0020" ref-type="bibr">4</xref>], at which 83% of experts endorsed single-gene testing over multigene panel testing for suspected syndromes with a defined gene. For patients with suspected H-RCC without syndromic features, multigene panels are recommended [<xref rid="b0020" ref-type="bibr">4</xref>,<xref rid="b0300" ref-type="bibr">60</xref>]. Whole-exome sequencing (WES) has increased in popularity in oncology but has some limitations, particularly in detecting mosaicism. In addition, expanded genetic testing often results in identification of VUS in a considerable number of cases, which can complicate diagnosis [<xref rid="b0295" ref-type="bibr">59</xref>]. Finally, the interpretation of genetic test results is typically carried out by diagnostic laboratories in collaboration with clinicians and adheres to the ACMG standards and guidelines for sequence variant classification [<xref rid="b0305" ref-type="bibr">61</xref>].</p></sec><sec id="s0085"><label>3.8</label><title>Positive genetic testing: what happens next?</title><sec id="s0090"><label>3.8.1</label><title>Post-test counselling</title><p id="p0185">Post-test genetic counselling involves the delivery of genetic testing results along with comprehensive information about the associated condition. This includes an evaluation of organ-specific penetrance risks and a discussion on follow-up care, preventive strategies, and the therapeutic options available. Cascade testing, which involves offering genetic counselling and testing to at-risk relatives of an individual who has been diagnosed with a genetic condition, depends on the age of renal cancer onset for the specific syndrome, and other disease manifestations [<xref rid="b0260" ref-type="bibr">52</xref>]. Psychological support should be made available to assist patients and their families in managing the emotional and practical implications of the genetic findings. For complex conditions, centralisation of care via referral to a comprehensive clinic is useful in ensuring care coordination and optimal patient outcomes [<xref rid="b0025" ref-type="bibr">5</xref>].</p></sec><sec id="s0095"><label>3.8.2</label><title>Impact of genetics on clinical management of patients</title><p id="p0190">Patients with H-RCC syndromes require a comprehensive multidisciplinary care model involving urologists, oncologists, geneticists, and other specialists, depending on the specific syndrome. Whenever feasible, patients should be under the care of physicians with expertise in managing each specific rare condition, ideally at specialised centres such as a VHL Clinical Care Centre (<ext-link ext-link-type="uri" xlink:href="https://www.vhl.org/" id="ir005">https://www.vhl.org/</ext-link>) for patients diagnosed with VHL disease [<xref rid="b0310" ref-type="bibr">62</xref>]. Surveillance and nephron-sparing approaches are usually recommended in most H-RCCs [<xref rid="b0010" ref-type="bibr">2</xref>,<xref rid="b0080" ref-type="bibr">16</xref>,<xref rid="b0215" ref-type="bibr">43</xref>,<xref rid="b0315" ref-type="bibr">63</xref>]. Ablative treatment options may be considered for those with significant risk factors for surgery, including patients with VHL disease, for which multiple resections can potentially increase the risk of chronic renal failure [<xref rid="b0310" ref-type="bibr">62</xref>]. Nonetheless, exceptions exist, such as SDH-deficient RCC, cases with larger tumours or aggressive histological features (eg, high-grade or sarcomatoid differentiation), and FH-deficient RCC, for which immediate surgical intervention and radical nephrectomy are recommended owing to the aggressive nature of these tumours [<xref rid="b0010" ref-type="bibr">2</xref>,<xref rid="b0215" ref-type="bibr">43</xref>].</p><p id="p0195">Active surveillance of multiple organs is crucial for individuals at risk of VHL disease who do not yet have symptoms, or who are known to have VHL disease but do not yet have clinical manifestations [<xref rid="b0315" ref-type="bibr">63</xref>]. Renal tumours are managed with active surveillance and then surgical intervention when the largest renal tumour reaches 3 cm in diameter to potentially reduce the risk of metastatic disease while minimising the need for repeat surgeries and preserving renal function [<xref rid="b0320" ref-type="bibr">64</xref>,<xref rid="b0325" ref-type="bibr">65</xref>]. Care for patients with VHL disease has been transformed by belzutifan, an HIF2&#x003b1; inhibitor, for which an objective response rate of 49% was observed in a phase 2 trial in VHL-associated RCC without tumours &#x0003e;3 cm requiring immediate surgery and no metastatic disease [<xref rid="b0330" ref-type="bibr">66</xref>]. Responses to belzutifan were also observed in patients with pancreatic lesions (77%), CNS haemangioblastomas (30%), and retinal haemangioblastomas [<xref rid="b0330" ref-type="bibr">66</xref>]. Belzutifan was first approved by the US Food and Drug Administration (FDA) in August 2021 [<xref rid="b0335" ref-type="bibr">67</xref>], with a more recent conditional approval from the European Medicines Agency (EMA) [<xref rid="b0340" ref-type="bibr">68</xref>].</p><p id="p0200">In HPRC, renal tumours tend to be slow-growing and are often managed with nephron-sparing surgery when the largest tumour dimension reaches 3 cm [<xref rid="b0345" ref-type="bibr">69</xref>]. For advanced disease, identification of activating <italic>MET</italic> variants in patients with HPRC and sporadic papillary RCC has led to trials of MET pathway inhibitors [<xref rid="b0350" ref-type="bibr">70</xref>]. There are currently no systemic therapy options specifically approved for patients with HPRC-associated metastatic RCC [<xref rid="b0355" ref-type="bibr">71</xref>]. As with VHL-associated RCC and HPRC, current recommendations for managing <italic>FCLN</italic>-mutated renal tumours include active surveillance until the largest diameter reaches 3 cm, at which time nephron-sparing surgery is recommended [<xref rid="b0360" ref-type="bibr">72</xref>]. Metastases are uncommon, and the best systemic treatment approach for metastatic tumours with <italic>FCLN</italic> mutation is unknown.</p><p id="p0205">Considering the aggressive behaviour of FHTP syndrome&#x02013;associated RCC, radical nephrectomy should be considered first [<xref rid="b0010" ref-type="bibr">2</xref>,<xref rid="b0215" ref-type="bibr">43</xref>]. Favourable outcomes with immune checkpoint inhibitor/tyrosine kinase inhibitor combination therapy among patients with advanced disease have been observed in retrospective series and for the small numbers of patients with FH-deficient RCC included in prospective trials [<xref rid="b0365" ref-type="bibr">73</xref>,<xref rid="b0370" ref-type="bibr">74</xref>]. The NCCN guidelines currently recommend the combination of cabozantinib + nivolumab in certain circumstances [<xref rid="b0215" ref-type="bibr">43</xref>]. The combination of bevacizumab + erlotinib has shown promising results in advanced disease, achieving a response rate of 64% and median progression-free survival of 21.1 mo, compared to 37% and 8.7 mo in sporadic papillary RCC, in a phase 2 trial [<xref rid="b0375" ref-type="bibr">75</xref>]. Bevacizumab + erlotinib is considered a treatment option for this population according to the ESMO and NCCN guidelines, despite lacking EMA and FDA approval [<xref rid="b0215" ref-type="bibr">43</xref>]. Both the EMA and FDA have approved everolimus, an mTOR inhibitor, for abdominal manifestations of TSC on the basis of its demonstrated efficacy in reducing the volume of renal angiomyolipomas by &#x0003e;50% and delaying disease progression [<xref rid="b0380" ref-type="bibr">76</xref>]. Everolimus has also been approved for the treatment of subependymal giant-cell astrocytomas and TSC-associated seizures, with promising clinical results [<xref rid="b0385" ref-type="bibr">77</xref>,<xref rid="b0390" ref-type="bibr">78</xref>].</p></sec></sec><sec id="s0100"><label>3.9</label><title>Negative genetic testing: what happens next?</title><p id="p0210">Post-test counselling remains essential following a negative result, as it should still cover the possible genetic, clinical, and emotional implications. Individuals must understand that general population cancer risks remain, and that personal risk may still be influenced by other factors.</p><p id="p0215">In cases in which genetic testing yields negative results despite strong clinical suspicion of H-RCC, three possible paths can be taken:<list list-type="simple" id="l0020"><list-item id="o0070"><label>&#x02022;</label><p id="p0220"><bold>Expand the scope of genetic testing</bold>: If initial testing was limited to a single gene or panel testing, consider broader approaches such as WES or whole-genome sequencing.</p></list-item><list-item id="o0075"><label>&#x02022;</label><p id="p0225"><bold>Evaluate for somatic mosaicism</bold>: In cases with no family history but features suggestive of a H-RCC syndrome, somatic mosaicism should also be considered [<xref rid="b0395" ref-type="bibr">79</xref>].</p></list-item><list-item id="o0080"><label>&#x02022;</label><p id="p0230"><bold>Account for unknown genetic aetiologies</bold>: The possibility of currently unidentified genetic causes of RCC remains. Therefore, it is essential to reanalyse genetic test results annually and incorporate insights from the latest advances in the literature [<xref rid="b0025" ref-type="bibr">5</xref>].</p></list-item></list></p><p id="p0235">As negative test results in cases of strong clinical suspicion do not definitively exclude the presence of a germline variant, it may be advisable to refer patients for further genetic investigations when negative testing has been performed via the mainstream pathway and the index of suspicion remains high. A step-by-step guide for identification and counselling of patients with suspected H-RCC is summarised in <xref rid="f0005" ref-type="fig">Fig. 1</xref>.<fig id="f0005"><label>Fig. 1</label><caption><p>Step-by-step guide for identification and counselling of patients with suspected hereditary renal cell carcinoma (RCC). NGS = next-generation sequencing; P/LP = pathogenic/likely pathogenic; VUS = variant of unknown significance.</p></caption><graphic xlink:href="gr1" id="lk00005"/></fig></p></sec></sec><sec id="s0105"><label>4</label><title>Conclusions</title><p id="p0240">Several guidelines recognise genetic assessment as a key component of RCC management. However, gaps and controversies exist regarding certain referral criteria. Specific findings may aid a clinician&#x02019;s assessment and prompt consideration of H-RCC. Nevertheless, physicians may be misled by incomplete information for family history, isolated cases with de novo variants, or unrecognised subtle clinical features. Identification of H-RCC is essential, as it may influence both surgical and, in some cases, systemic management. Therefore, enhancement of education and awareness is essential for health care professionals. While the variety of professionals authorised to provide pretest counselling and request genetic testing is expanding, adequate training and multidisciplinary collaboration with genetic specialists remain paramount.</p><p id="p0245">&#x02028;&#x02028;<bold><italic>Author contributions</italic></bold>: Chiara Re had full access to all the data in the study and takes responsibility for the integrity of the data and the accuracy of the data analysis.</p><p id="p0250">&#x02028;&#x02028;<italic>Study concept and design</italic>: Re, Pecoraro, Whitworth, Marandino.</p><p id="p0255"><italic>Acquisition of data</italic>: Re, Pecoraro.</p><p id="p0260"><italic>Analysis and interpretation of data</italic>: Re, Pecoraro.</p><p id="p0265"><italic>Drafting of the manuscript</italic>: Re, Pecoraro, Erdem, Kalayci, Uyguner.</p><p id="p0270"><italic>Critical revision of the manuscript for important intellectual content</italic>: Stewart, Cali&#x000f2;, Erdem, Kalayci, Uyguner, Larcher, Campi, Amparore, Whitworth, Marandino.</p><p id="p0275"><italic>Statistical analysis</italic>: None.</p><p id="p0280"><italic>Obtaining funding</italic>: None.</p><p id="p0285"><italic>Administrative, technical, or material support</italic>: None.</p><p id="p0290"><italic>Supervision</italic>: Stewart, Cali&#x000f2;, Erdem, Kalayci, Uyguner, Larcher, Campi, Amparore, Whitworth, Marandino.</p><p id="p0295"><italic>Other</italic>: None.</p><p id="p0300">&#x02028;&#x02028;<bold><italic>Financial disclosures:</italic></bold> Chiara Re certifies that all conflicts of interest, including specific financial interests and relationships and affiliations relevant to the subject matter or materials discussed in the manuscript (eg, employment/affiliation, grants or funding, consultancies, honoraria, stock ownership or options, expert testimony, royalties, or patents filed, received, or pending), are the following: Grant D. Stewart reports educational grants from AstraZeneca; consultancy fees from Evinova and Qurin; travel expenses from MSD; and leadership roles as clinical lead (urology) for the National Kidney Cancer Audit and topic advisor for the National Institute of Health and Care Excellence kidney cancer guidelines. Alessandro Larcher reports a consulting role for Telix and Merck Sharp &#x00026; Dohme; and restricted grants from the VHL Alliance and from the Italian Ministry of Health and the EU (PNRR-MR1-2022-12375818 and PNRR-POC-2023-12377493) for research on von Hippel-Lindau&#x02013;related renal cancer, and from the Intuitive Foundation for research on robotic surgery for partial nephrectomy. Riccardo Campi reports honoraria for advisory roles from Telix, MSD, and Nucleix; and travel grants from Telix and MSD. James Whitworth is a committee member for the National Institute of Health and Care Excellence kidney cancer guidelines Laura Marandino reports travel and accommodation expenses from Immunocore. The remaining authors have nothing to disclose.</p><p id="p0305">&#x02028;&#x02028;<bold><italic>Funding/Support and role of the sponsor</italic>:</bold> None.</p></sec></body><back><ref-list id="bi005"><title>References</title><ref id="b0005"><label>1</label><element-citation publication-type="journal" id="h0005"><person-group person-group-type="author"><name><surname>Linehan</surname><given-names>W.M.</given-names></name><name><surname>Srinivasan</surname><given-names>R.</given-names></name><name><surname>Schmidt</surname><given-names>L.S.</given-names></name></person-group><article-title>The genetic basis of kidney cancer: a metabolic disease</article-title><source>Nat Rev Urol</source><volume>7</volume><year>2010</year><fpage>277</fpage><lpage>285</lpage><pub-id pub-id-type="pmid">20448661</pub-id>

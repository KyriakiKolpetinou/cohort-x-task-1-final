middle" rowspan="1" colspan="1">No PTX</td><td align="center" valign="middle" rowspan="1" colspan="1">Negative</td><td align="center" valign="middle" rowspan="1" colspan="1">Positive</td><td align="center" valign="middle" rowspan="1" colspan="1">Negative</td></tr><tr><td align="center" valign="middle" rowspan="1" colspan="1">No PTX</td><td align="center" valign="middle" rowspan="1" colspan="1">Positive</td><td align="center" valign="middle" rowspan="1" colspan="1">Negative</td><td align="center" valign="middle" rowspan="1" colspan="1">Negative</td></tr><tr><td align="center" valign="middle" rowspan="1" colspan="1">No PTX</td><td align="center" valign="middle" rowspan="1" colspan="1">Inconclusive</td><td align="center" valign="middle" rowspan="1" colspan="1">Positive/negative</td><td align="center" valign="middle" rowspan="1" colspan="1">Negative</td></tr><tr><td align="center" valign="middle" rowspan="1" colspan="1">PTX</td><td align="center" valign="middle" rowspan="1" colspan="1">Negative</td><td align="center" valign="middle" rowspan="1" colspan="1">Positive</td><td align="center" valign="middle" rowspan="1" colspan="1">Positive</td></tr><tr><td align="center" valign="middle" rowspan="1" colspan="1">PTX</td><td align="center" valign="middle" rowspan="1" colspan="1">Positive</td><td align="center" valign="middle" rowspan="1" colspan="1">Positive</td><td align="center" valign="middle" rowspan="1" colspan="1">N/A</td></tr><tr><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">PTX</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">Inconclusive</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">Positive/negative</td><td align="center" valign="middle" style="border-bottom:solid thin" rowspan="1" colspan="1">Positive</td></tr></tbody></table><table-wrap-foot><fn><p>* Reference standard for the purpose of the study. CXR, chest X-ray; PTX, pne
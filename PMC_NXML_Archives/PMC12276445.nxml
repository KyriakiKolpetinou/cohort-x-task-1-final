</element-citation></ref><ref id="bib9"><label>9</label><element-citation publication-type="journal" id="sref9"><person-group person-group-type="author"><name><surname>Ferrusqu&#x000ed;a-Acosta</surname><given-names>J.</given-names></name><name><surname>Bassegoda</surname><given-names>O.</given-names></name><name><surname>Turco</surname><given-names>L.</given-names></name><etal/></person-group><article-title>Agreement between wedged hepatic venous pressure and portal pressure in non-alcoholic steatohepatitis-related cirrhosis</article-title><source>J Hepatol</source><volume>74</volume><issue>4</issue><year>2021</year><fpage>811</fpage><lpage>818</lpage><pub-id pub-id-type="doi">10.1016/j.jhep.2020.10.003</pub-id><pub-id pub-id-type="pmid">33068638</pub-id>

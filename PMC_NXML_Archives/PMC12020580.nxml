</th></tr></thead><tbody><tr><td align="left" rowspan="2" valign="top">Gender</td><td align="left" valign="top">Male</td><td align="left" valign="top">19 (59.4%)</td><td align="left" valign="top"/><td align="left" valign="top"/><td align="left" valign="top"/></tr><tr><td align="left" valign="top">Female</td><td align="left" valign="top">13 (40.6%)</td><td align="left" valign="top"/><td align="left" valign="top"/><td align="left" valign="top"/></tr><tr><td align="left" rowspan="3" valign="top">Age</td><td align="left" valign="top">Mean (SD)</td><td align="left" valign="top">46.34 (11.67)</td><td align="left" valign="top"/><td align="left" valign="top"/><td align="left" valign="top"/></tr><tr><td align="left" valign="top">Median (MAD)</td><td align="left" valign="top">46.50 (6.50)</td><td align="left" valign="top"/><td align="left" valign="top"/><td align="left" valign="top"/></tr><tr><td align="left" valign="top">Range</td><td align="left" valign="top">22.00&#x02013;70.00</td><td align="left" valign="top"/><td align="left" valign="top"/><td align="left" valign="top"/></tr><tr><td align="left" rowspan="2" valign="top">Smoking</td><td align="left" valign="top">Yes</td><td align="left" valign="top">12 (37.5%)</td><td align="left" valign="top"/><td align="left" valign="top"/><td align="left" valign="top"/></tr><tr><td align="left" valign="top">No</td><td align="left" valign="top">20 (62.5%)</td><td align="left" valign="top"/><td align="left" valign="top"/><td align="left" valign="top"/></tr><tr><td align="left" rowspan="3" valign="top">PI (%)</td><td align="left" valign="top">Mean (SD)</td><td align="left" valign="top">75.01 (36.05)</td><td align="left" valign="top">74.1%</td><td align="left" valign="top">73.4%</td><td align="left" valign="top">0.54</td></tr><tr><td align="left" valign="top">Median (MAD)</td><td align="left" valign="top">100.00 (0.00)</td><td align="left" valign="top"/><td align="left" valign="top"/><td align="left" valign="top"/></tr><tr><td align="left
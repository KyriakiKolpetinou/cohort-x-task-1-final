<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" dtd-version="1.3" xml:lang="en" article-type="research-article"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">JMIR Res Protoc</journal-id><journal-id journal-id-type="iso-abbrev">JMIR Res Protoc</journal-id><journal-id journal-id-type="publisher-id">ResProt</journal-id><journal-title-group><journal-title>JMIR Research Protocols</journal-title></journal-title-group><issn pub-type="epub">1929-0748</issn><publisher><publisher-name>JMIR Publications</publisher-name><publisher-loc>Toronto, Canada</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">35947435</article-id><article-id pub-id-type="pmc">9403824</article-id><article-id pub-id-type="publisher-id">v11i8e35051</article-id><article-id pub-id-type="doi">10.2196/35051</article-id><article-categories><subj-group subj-group-type="heading"><subject>Protocol</subject></subj-group><subj-group subj-group-type="article-type"><subject>Protocol</subject></subj-group></article-categories><title-group><article-title>Magnetic Resonance Imaging Angiography of Physiological and Pathological Pregnancy Placentas Ex Vivo: Protocol for a Prospective Pilot Study</article-title></title-group><contrib-group><contrib contrib-type="editor"><name><surname>Leung</surname><given-names>Tiffany</given-names></name></contrib></contrib-group><contrib-group><contrib contrib-type="reviewer"><name><surname>Ben Bashat</surname><given-names>Dafna</given-names></name></contrib><contrib contrib-type="reviewer"><name><surname>Ndabu</surname><given-names>Theophile</given-names></name></contrib></contrib-group><contrib-group><contrib id="contrib1" contrib-type="author" corresp="yes"><name><surname>Dap</surname><given-names>Matthieu</given-names></name><degrees>MD</degrees><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-2846-1509</contrib-id><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref><address><institution>Obstetric and Fetal Medicine Unit</institution><institution>Centre Hospitalier R&#x000e9;gional Universitaire of Nancy</institution><addr-line>10, rue du docteur Heydenreich</addr-line><addr-line>Nancy, 54000</addr-line><country>France</country><phone>33 630736896</phone><email>m.dap@chru-nancy.fr</email></address></contrib><contrib id="contrib2" contrib-type="author"><name><surname>Chen</surname><given-names>Bailiang</given-names></name><degrees>PhD</degrees><xref rid="aff3" ref-type="aff">3</xref><xref rid="aff4" ref-type="aff">4</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-1038-7846</contrib-id></contrib><contrib id="contrib3" contrib-type="author"><name><surname>Banasiak</surname><given-names>Claire</given-names></name><xref rid="aff4" ref-type="aff">4</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-7069-4226</contrib-id></contrib><contrib id="contrib4" contrib-type="author"><name><surname>Hossu</surname><given-names>Gabriela</given-names></name><degrees>PhD</degrees><xref rid="aff4" ref-type="aff">4</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-1178-9097</contrib-id></contrib><contrib id="contrib5" contrib-type="author"><name><surname>Morel</surname><given-names>Olivier</given-names></name><degrees>MD, PhD</degrees><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff3" ref-type="aff">3</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0001-6359-1328</contrib-id></contrib><contrib id="contrib6" contrib-type="author"><name><surname>Beaumont</surname><given-names>Marine</given-names></name><degrees>PhD</degrees><xref rid="aff3" ref-type="aff">3</xref><xref rid="aff4" ref-type="aff">4</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-3269-5447</contrib-id></contrib><contrib id="contrib7" contrib-type="author"><name><surname>Bertholdt</surname><given-names>Charline</given-names></name><degrees>MD, PhD</degrees><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff3" ref-type="aff">3</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0001-9297-5363</contrib-id></contrib></contrib-group><aff id="aff1">

</td><td align="center" rowspan="1" colspan="1">46</td><td align="center" rowspan="1" colspan="1">M</td><td align="center" rowspan="1" colspan="1">Y</td><td align="center" rowspan="1" colspan="1">Y</td><td align="center" rowspan="1" colspan="1">18.6</td><td align="center" rowspan="1" colspan="1">0.11</td><td align="center" rowspan="1" colspan="1">169</td><td align="center" rowspan="1" colspan="1">NS</td><td align="center" rowspan="1" colspan="1">N</td><td align="center" rowspan="1" colspan="1">Y</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">Normal</td></tr><tr><td align="left" rowspan="1" colspan="1">
<bold>

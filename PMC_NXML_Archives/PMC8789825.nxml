tion-type="journal"><person-group person-group-type="author"><name><surname>Lichtenstein</surname><given-names>D</given-names></name><name><surname>M&#x000e9;zi&#x000e8;re</surname><given-names>G</given-names></name><name><surname>Biderman</surname><given-names>P</given-names></name><name><surname>Gepner</surname><given-names>A</given-names></name><name><surname>Barr&#x000e9;</surname><given-names>O</given-names></name></person-group><article-title>The comet-tail artifact: An ultrasound sign of alveolar-interstitial syndrome</article-title><source>Am. J. Respir. Crit. Care Med.</source><year>1997</year><volume>156</volume><fpage>1640</fpage><lpage>1646</lpage><pub-id pub-id-type="doi">10.1164/ajrccm.156.5.96-07096</pub-id><pub-id pub-id-type="pmid">9372688</pub-id></element-citation></ref><ref id="CR13"><label>13.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Lichtenstein</surname><given-names>D</given-names></name><name><surname>Mezi&#x000e8;re</surname><given-names>G</given-names></name></person-group><article-title>The BLUE-points: Three standardized points used in the BLUE-protocol for ultrasound assessment of the lung in acute respiratory failure</article-title><source>Crit. Ultrasound J.</source><year>2011</year><volume>3</volume><fpage>109</fpage><lpage>110</lpage><pub-id pub-id-type="doi">10.1007/s13089-011-0066-3</pub-id></element-citation></ref><ref id="CR14"><label>14.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Denault</surname><given-names>A</given-names></name><name><surname>Girard</surname><given-names>M</given-names></name><name><surname>Cavayas</surname><given-names>YA</given-names></name></person-group><article-title>Lung ultrasound in the critically ill: The BLUE protocol: Daniel A. Lichtenstein</article-title><source>Can. J. Anesth. Can. Anesth.</source><year>2016</year><volume>63</volume><fpage>903</fpage><lpage>904</lpag
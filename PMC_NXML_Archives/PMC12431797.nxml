<article-meta><article-id pub-id-type="pmid">40951078</article-id><article-id pub-id-type="pmc">12431797</article-id><article-id pub-id-type="doi">10.7759/cureus.90019</article-id><article-categories><subj-group subj-group-type="heading"><subject>Neurosurgery</subject></subj-group><subj-group><subject>Orthopedics</subject></subj-group></article-categories><title-group><article-title>Fresh Platelet-Rich Plasma Gel Reduces Sciatic Nerve-Associated Neuropathic Pain in Rats by Suppressing Tumor Necrosis Factor-&#x003b1; and Interleukin-6 Expression</article-title></title-group><contrib-group><contrib contrib-type="editor"><name><surname>Muacevic</surname><given-names>Alexander</given-names></name></contrib><contrib contrib-type="editor"><name><surname>Adler</surname><given-names>John R</given-names></name></contrib></contrib-group><contrib-group><contrib contrib-type="author" corresp="yes"><name><surname>Mukai</surname><given-names>Michiaki</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Uchida</surname><given-names>Kentaro</given-names></name><xref rid="aff-2" ref-type="aff">2</xref><xref rid="aff-3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Miyagi</surname><given-names>Masayuki</given-names></name><xref rid="aff-2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>Inoue</surname><given-names>Gen</given-names></name><xref rid="aff-2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>Sekiguchi</surname><given-names>Hiroyuki</given-names></name><xref rid="aff-3" ref-type="aff">3</xref></contrib><contrib contrib-type="author"><name><surname>Yokozeki</surname><given-names>Yuji</given-names></name><xref rid="aff-2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>Shiga</surname><given-names>Yasuhiro</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Inage</surname><given-names>Kazuhide</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Yawara</surname><given-names>Eguchi</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>Orita</surname><given-names>Sumihisa</given-names></name><xref rid="aff-1" ref-type="aff">1</xref><xref rid="aff-4" ref-type="aff">4</xref></contrib><contrib contrib-type="author"><name><surname>Takaso</surname><given-names>Masashi</given-names></name><xref rid="aff-2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>Ohtori</surname><given-names>Seiji</given-names></name><xref rid="aff-1" ref-type="aff">1</xref></contrib></contrib-group><aff id="aff-1">

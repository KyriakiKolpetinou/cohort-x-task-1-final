</element-citation></ref><ref id="B3-ijms-26-06057"><label>3.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Aarthy</surname><given-names>R.</given-names></name>
<name><surname>Aston-Mourney</surname><given-names>K.</given-names></name>
<name><surname>Mikocka-Walus</surname><given-names>A.</given-names></name>
<name><surname>Radha</surname><given-names>V.</given-names></name>
<name><surname>Amutha</surname><given-names>A.</given-names></name>
<name><surname>Anjana</surname><given-names>R.M.</given-names></name>

<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">JHEP Rep</journal-id><journal-id journal-id-type="iso-abbrev">JHEP Rep</journal-id><journal-title-group><journal-title>JHEP Reports</journal-title></journal-title-group><issn pub-type="epub">2589-5559</issn><publisher><publisher-name>Elsevier</publisher-name></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">40677691</article-id><article-id pub-id-type="pmc">12270624</article-id><article-id pub-id-type="pii">S2589-5559(25)00130-2</article-id><article-id pub-id-type="doi">10.1016/j.jhepr.2025.101452</article-id><article-id pub-id-type="publisher-id">101452</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group></article-categories><title-group><article-title>Mapping the hemodynamic effects of terlipressin in patients with hepatorenal syndrome using advanced magnetic resonance imaging</article-title></title-group><contrib-group><contrib contrib-type="author" id="au1"><name><surname>Danielsen</surname><given-names>Karen Vagner</given-names></name><email>kvdanielsen@gmail.com</email><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref><xref rid="cor1" ref-type="corresp">&#x0204e;</xref></contrib><contrib contrib-type="author" id="au2"><name><surname>Hove</surname><given-names>Jens Dahlgaard</given-names></name><xref rid="aff2" ref-type="aff">2</xref><xref rid="aff3" ref-type="aff">3</xref><xref rid="aff4" ref-type="aff">4</xref></contrib><contrib contrib-type="author" id="au3"><name><surname>Nabilou</surname><given-names>Puria</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib contrib-type="author" id="au4"><name><surname>Kronborg</surname><given-names>Thit Mynster</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib contrib-type="author" id="au5"><name><surname>Wiese</surname><given-names>Signe</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib contrib-type="author" id="au6"><name><surname>Siebner</surname><given-names>Hartwig Roman</given-names></name><xref rid="aff4" ref-type="aff">4</xref><xref rid="aff5" ref-type="aff">5</xref><xref rid="aff6" ref-type="aff">6</xref></contrib><contrib contrib-type="author" id="au7"><name><surname>Scott</surname><given-names>Robert</given-names></name><xref rid="aff7" ref-type="aff">7</xref></contrib><contrib contrib-type="author" id="au8"><name><surname>Francis</surname><given-names>Susan T.</given-names></name><xref rid="aff8" ref-type="aff">8</xref></contrib><contrib contrib-type="author" id="au9"><name><surname>Aithal</surname><given-names>Guruprasad P.</given-names></name><xref rid="aff7" ref-type="aff">7</xref><xref rid="aff9" ref-type="aff">9</xref></contrib><contrib contrib-type="author" id="au10"><name><surname>M&#x000f8;ller</surname><given-names>S&#x000f8;ren</given-names></name><xref rid="aff2" ref-type="aff">2</xref><xref rid="aff4" ref-type="aff">4</xref><xref rid="fn1" ref-type="fn">&#x02021;</xref></contrib><contrib contrib-type="author" id="au11"><name><surname>Bendtsen</surname><given-names>Flemming</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff4" ref-type="aff">4</xref><xref rid="fn1" ref-type="fn">&#x02021;</xref></contrib><aff id="aff1"><label>1</label>Centre of Gastroenterology, Medical Division, Copenhagen University Hospital Hvidovre, Denmark</aff><aff id="aff2"><label>2</label>Department of Clinical Physiology and Nuclear Medicine, Centre of Functional and Diagnostic Imaging and Research, Copenhagen University Hospital Hvidovre, Hvidovre, Denmark</aff><aff id="aff3"><label>3</label>Department of Cardiology, Copenhagen University Hospital Hvidovre, Hvidovre, Denmark</aff><aff id="aff4"><label>4</label>Institute of Clinical Medicine, Faculty of Health Sciences, University of Copenhagen, Copenhagen, Denmark</aff><aff id="aff5"><label>5</label>Danish Research Centre for Magnetic Resonance, Centre for Functional and Diagnostic Imaging and Research, Copenhagen University Hospital Hvidovre, Hvidovre, Denmark</aff><aff id="aff6"><label>6</label>Department of Neurology, Copenhagen University Bispebjerg and Frederiksberg, Copenhagen, Denmark</aff><aff id="aff7"><label>7</label>National Institute for Health and Care Research (NIHR) Nottingham Biomedical Research Unit, Nottingham University Hospitals NHS Trust and the University of Nottingham, Nottingham, UK</aff><aff id="aff8"><label>8</label>Sir Peter Mansfield Imaging Centre, University of Nottingham, Nottingham, UK</aff><aff id="aff9"><label>9</label>Nottingham Digestive Diseases Centre, Translational Medical Sciences, School of Medicine, University of Nottingham, Nottingham, UK</aff></contrib-group><author-notes><corresp id="cor1"><label>&#x0204e;</label>Corresponding author. Address: Centre of Gastroenterology, Medical Division, Copenhagen University Hospital Hvidovre, Kettegaard Alle 30, DK-2650 Hvidovre, Denmark. Tel.: +45 22 43 94 49. <email>kvdanielsen@gmail.com</email></corresp><fn id="fn1"><label>&#x02021;</label><p id="ntpara0015">Joint senior authors.</p></fn></author-notes><pub-date pub-type="pmc-release"><day>10</day><month>5</month><year>2025</year></pub-date><!-- PMC Release delay is 0 months and 0 days and was based on <pub-date
						pub-type="epub">.--><pub-date pub-type="collection"><month>8</month><year>2025</year></pub-date><pub-date pub-type="epub"><day>10</day><month>5</month><year>2025</year></pub-date><volume>7</volume><issue>8</issue><elocation-id>101452</elocation-id><history><date date-type="received"><day>31</day><month>10</month><year>2024</year></date><date date-type="rev-recd"><day>1</day><month>5</month><year>2025</year></date><date date-type="accepted"><day>6</day><month>5</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; 2025 The Authors</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p>This is an open access article under the CC BY-NC-ND license (http://creativecommons.org/licenses/by-nc-nd/4.0/).</license-p></license></permissions><abstract id="abs0010"><sec><title>Background &#x00026; aims</title><p>Terlipressin improves renal function in &#x0223c;40% of patients with hepatorenal syndrome&#x02013;acute kidney injury (HRS-AKI). Nonetheless, the pathophysiological mechanisms of terlipressin remain unclear. Therefore, we investigated the cardiovascular changes that occur after terlipressin is given to patients with HRS-AKI.</p></sec><sec><title>Methods</title><p>Cardiac and phase-contrast magnetic resonance imaging were used to assess cardiac function, as well as renal, splanchnic, and peripheral blood flow changes after the first bolus of 2 mg terlipressin in 10 patients with HRS-AKI, six of whom also had acute-on-chronic liver failure. Hemodynamic changes were analyzed using the Wilcoxon matched-pairs signed-rank test. Patients were followed prospectively to investigate any associations between terlipressin-induced hemodynamic changes and clinical outcomes.</p></sec><sec><title>Results</title><p>Cardiac output (CO) decreased by 15% following terlipressin (<italic>p</italic> &#x0003c;0.01). Despite this decrease in CO, renal artery blood flow increased by 23% (<italic>p</italic> &#x0003c;0.01), and the renal artery blood flow percentage of CO increased by 49% (<italic>p</italic> = 0.01). Superior mesenteric artery blood flow and femoral artery blood flow decreased by 27% and 40%, respectively (both <italic>p</italic> &#x0003c;0.01). Mean arterial pressure (MAP) and systemic vascular resistance increased by 13% and 32%, respectively (both <italic>p</italic> &#x0003c;0.01). Baseline renal artery blood flow correlated with serum creatinine (<italic>p</italic> &#x0003c;0.01). By contrast, changes in renal artery blood flow and other cardiocirculatory variables did not correlate with changes in serum creatinine after terlipressin or with mortality.</p></sec><sec><title>Conclusions</title><p>Terlipressin increases renal artery blood flow, reduces CO, and alleviates splanchnic and peripheral vasodilatation. These effects, combined with an increase in MAP, appear to explain the therapeutic benefits of terlipressin in patients with HRS-AKI.</p></sec><sec><title>Impact and implications</title><p>This study is the first to provide a detailed mapping of the hemodynamic changes following terlipressin treatment in patients critically ill with HRS-AKI. The results indicate that the beneficial effects of terlipressin are driven by selective peripheral and splanchnic vasoconstriction, which redistributes blood flow, normalizes MAP, and ultimately improves renal perfusion despite reduced cardiac output. This study also highlights the advantages of using magnetic resonance imaging as a non-invasive method to evaluate pharmacological interventions, with the potential to contribute to future advances in personalized medicine for patients with cirrhosis.</p></sec><sec><title>Clinical Trials registration</title><p>NCT03483272.</p></sec></abstract><abstract abstract-type="graphical" id="abs0015"><title>Graphical abstract</title><p><fig id="undfig1" position="anchor"><alt-text id="alttext0010">Image 1</alt-text><graphic xlink:href="ga1"/></fig></p></abstract><abstract abstract-type="author-highlights" id="abs0020"><title>Highlights</title><p><list list-type="simple" id="ulist0010"><list-item id="u0010"><label>&#x02022;</label><p id="p0010">Terlipressin improves kidney perfusion in patients with HRS-AKI, despite reduced CO.</p></list-item><list-item id="u0015"><label>&#x02022;</label><p id="p0015">Terlipressin induces selective peripheral and splanchnic vasoconstriction, redistributing blood to the kidneys.</p></list-item><list-item id="u0020"><label>&#x02022;</label><p id="p0020">This detailed mapping of the pharmacodynamics of terlipressin encourages future personalized treatment strategies.</p></list-item><list-item id="u0025"><label>&#x02022;</label><p id="p0025">MRI is a promising, non-invasive method for evaluating treatment responses in patients with cirrhosis.</p></list-item></list></p></abstract><kwd-group id="kwrds0010"><title>Keywords</title><kwd>Acute kidney injury</kwd><kwd>Acute-on-chronic liver failure</kwd><kwd>Portal hypertension</kwd><kwd>Terlipressin</kwd><kwd>Pharmacodynamic</kwd></kwd-group></article-meta></front><body><sec id="sec1"><title>Introduction</title><p id="p0030">Hepatorenal syndrome&#x02013;acute kidney injury (HRS-AKI) is one of the most severe complications of cirrhosis and has a high mortality.<xref rid="bib1" ref-type="bibr"><sup>1</sup></xref><sup>,</sup><xref rid="bib2" ref-type="bibr"><sup>2</sup></xref> The progression of hemodynamic changes seen in patients with cirrhosis is considered a quintessential part of the pathophysiology behind HRS-AKI. Although a direct causal relationship has not yet been established, the assumed progression in systemic and splanchnic vasodilatation in patients with cirrhosis is believed to reduce effective central arterial blood volume. This activates the sympathetic nervous system and the renin&#x02013;angiotensin&#x02013;aldosterone system, which subsequently induces renal vasoconstriction and hypoperfusion, leading to HRS-AKI.<xref rid="bib1" ref-type="bibr"><sup>1</sup></xref><sup>,</sup><xref rid="bib3" ref-type="bibr"><sup>3</sup></xref> Kidney dysfunction in HRS-AKI is potentially reversible, and therapy with albumin and terlipressin has been shown to improve renal function.<xref rid="bib4" ref-type="bibr"><sup>4</sup></xref> Terlipressin has been a cornerstone of HRS-AKI treatment in Europe and Asia for over a decade and was recently approved by the FDA.<xref rid="bib5" ref-type="bibr"><sup>5</sup></xref> It is a potent vasoconstrictor, believed to work by redistributing blood from the splanchnic to the systemic circulation, thereby improving renal perfusion.<xref rid="bib1" ref-type="bibr"><sup>1</sup></xref><sup>,</sup><xref rid="bib3" ref-type="bibr"><sup>3</sup></xref> The pharmacological efficacy of albumin and terlipressin for reversing HRS-AKI varies from 20% to 80%, with the severity of renal dysfunction being one of the few predictors of treatment success.<xref rid="bib6" ref-type="bibr"><sup>6</sup></xref></p><p id="p0035">Evidence of the specific cardiac and circulatory effects of terlipressin originates mainly from animal studies and human studies in patients without HRS-AKI.<xref rid="bib3" ref-type="bibr"><sup>3</sup></xref><sup>,</sup><xref rid="bib7" ref-type="bibr">[7]</xref>, <xref rid="bib8" ref-type="bibr">[8]</xref>, <xref rid="bib9" ref-type="bibr">[9]</xref>, <xref rid="bib10" ref-type="bibr">[10]</xref>, <xref rid="bib11" ref-type="bibr">[11]</xref>, <xref rid="bib12" ref-type="bibr">[12]</xref>, <xref rid="bib13" ref-type="bibr">[13]</xref>, <xref rid="bib14" ref-type="bibr">[14]</xref> We are not aware of any studies that have assessed the detailed regional hemodynamic effects of terlipressin and response to treatment in patients with HRS-AKI.</p><p id="p0040">Using cardiac magnetic resonance imaging (MRI) and phase contrast (PC)-MRI of renal, splanchnic, and peripheral blood flow, we previously showed that patients with HRS-AKI have low renal artery blood flow despite hyperdynamic circulation with markedly increased cardiac output (CO).<xref rid="bib15" ref-type="bibr"><sup>15</sup></xref> Evidence of the detailed hemodynamic effects of terlipressin in patients with HRS-AKI is essential for improving our understanding of the effects of vasoconstrictors in these patients. Thus, in this pathophysiological study of patients with HRS-AKI, we investigated terlipressin-induced changes in cardiac, renal, splanchnic, and peripheral hemodynamics using cardiac and PC-MRI.</p></sec><sec id="sec2"><title>Patients and methods</title><sec id="sec2.1"><title>Patients and study design</title><p id="p0045">For this prospective, interventional study, we initially screened 89 patients with HRS-AKI. Of these, 10 patients who met the inclusion criteria for terlipressin therapy were enrolled between January 2018 and May 2021. A flowchart describing enrolment and exclusion is shown in <xref rid="fig1" ref-type="fig">Fig. 1</xref>.<fig id="fig1"><label>Fig. 1</label><caption><p>Flowchart of screening and enrolment.</p><p>ECG, electrocardiogram; HRS-AKI, hepatorenal syndrome&#x02013;acute kidney injury; MR, magnetic resonance.</p></caption><alt-text id="alttext0030">Fig. 1</alt-text><graphic xlink:href="gr1"/></fig></p><p id="p0050">The criteria for HRS-AKI were according to EASL and AASLD guidelines.<xref rid="bib4" ref-type="bibr"><sup>4</sup></xref><sup>,</sup><xref rid="bib16" ref-type="bibr"><sup>16</sup></xref> The initial diagnosis of acute kidney injury (AKI) was based on an increase in serum creatinine of 26.5 &#x003bc;mol/L (&#x02265;0.3 mg/dl) or more within 48 h, or an increase in serum creatinine of 50% or more that was known or was presumed to have occurred within the preceding 7 days. Patients with AKI received a 20% albumin solution at a dose of 1 g/kg of body weight, up to a maximum of 100 g/day, for 2 consecutive days. Upon diagnosis of HRS-AKI, patients were given 40 g of albumin per day, divided into two doses of 20 g in the morning and evening. Albumin was not administered during the MRI scan.</p><p id="p0055">Diuretics and nephrotoxic drugs were withdrawn, and precipitating factors were treated. A diagnosis of HRS-AKI was made if other phenotypes of AKI had been excluded and the initial volume expansion therapy failed to improve kidney function, as reflected by an increase in serum creatinine &#x02265;26 &#x003bc;mol/L above the baseline value and with serum creatinine remaining above 133 &#x003bc;mol/L (AKI stage 1B with creatinine &#x02265;1.5 mg/dl). Exclusion criteria were hepatic encephalopathy (with a score &#x0003e;2 according to the West Haven criteria) at the time of inclusion, heart failure or arrhythmia, transjugular intrahepatic portosystemic shunts, contraindication to MRI, pregnancy, or any condition that would impede a participant&#x02019;s competence, compliance, or completion of the study.</p><p id="p0060"><xref rid="fig2" ref-type="fig">Fig. 2</xref> illustrates the study design. All patients underwent a detailed medical history, physical examination, fasting blood sampling, electrocardiogram (ECG), and a combined cardiac MRI scan and PC-MRI flow scan before and after being given terlipressin.<fig id="fig2"><label>Fig. 2</label><caption><p>Study design.</p><p>AKI, acute kidney injury; HRS-AKI, hepatorenal syndrome&#x02013;acute kidney injury; MRI, magnetic resonance imaging.</p></caption><alt-text id="alttext0035">Fig. 2</alt-text><graphic xlink:href="gr2"/></fig></p><p id="p0065">MRI scans were performed within 24 h of a HRS-AKI diagnosis and before treatment with terlipressin. The baseline MRI scan took 65 min. The first 2 mg of terlipressin (Glypressin&#x000ae;, Ferring Pharmaceuticals A/S, Malm&#x000f6;, Sweden) was injected after the baseline MRI scan. Twenty minutes after the terlipressin bolus, the patients were rescanned using the same MRI protocol. The second MRI scan took only 25 min because the scan sequences were prepared and optimized during the baseline scan.</p><p id="p0070">Subsequently, terlipressin was administered intravenously at 1 mg every 4 h. After 1&#x02013;2 days of treatment, terlipressin was increased to 2 mg every 4 h if the treatment response was considered insufficient according to the guidelines, or reduced to 1 mg every 6 h if the patient was experiencing too many side effects.</p><p id="p0075">Response to terlipressin treatment was defined according to the EASL criteria as<xref rid="bib4" ref-type="bibr"><sup>4</sup></xref>: (1) non-response if there was no regression in the AKI stage; (2) partial response if there was a regression in the AKI stage and a reduction in serum creatinine, but without reaching a reduction of &#x02265;26.5 &#x003bc;mol/L compared with the baseline value; or (3) full response if serum creatinine returned to a value within 26.5 &#x003bc;mol/L of the baseline value.</p><p id="p0080">The patients&#x02019; clinical outcomes were followed, and serum creatinine was assessed 2, 5, and 7 days after initial treatment, at 3 months, and again at study termination in May 2021. AKI relapse was defined as a verified reversal of HRS-AKI. Mortality was continuously registered using medical records beginning at patient enrolment and lasting until the termination of the study.</p></sec><sec id="sec2.2"><title>Magnetic resonance imaging</title><p id="p0085">The MRI methods and acquisition parameters are described in detail elsewhere.<xref rid="bib15" ref-type="bibr"><sup>15</sup></xref> Briefly, MRI examinations were conducted using a 1.5T Siemens Avanto scanner (Siemens Health Care, Erlangen, Germany), incorporating PC-MRI to assess blood flow in different vascular compartments (renal, systemic, and splanchnic) and cardiac MRI protocols. The initial PC-MRI protocol included an assessment of blood flow in seven vessels: the aorta, superior mesenteric artery, left and right renal arteries, left and right femoral arteries, and portal vein. The PC-MRI flow protocol was later expanded to include blood flow measurements in the azygos vein (n = 4). A cardiac MRI was performed with standard end-expiratory breath hold-segmented and ECG-gated cine imaging to assess end-diastolic volume, end-systolic volume, and left ventricular global longitudinal strain (GLS), the latter being a sensitive measure of cardiac contractility. Tricuspid annular plane systolic excursion (TAPSE) denotes the distance the tricuspid annulus moves longitudinally during systole, and is a standard measurement of right ventricular function, being lower in patients with pulmonary hypertension.</p></sec><sec id="sec2.3"><title>MR image analysis</title><p id="p0090">All MRI images were analyzed using Circle Cardiovascular Imaging software (CVI42, version 5.11.2; Circle Cardiovascular Imaging, Amsterdam, The Netherlands). In brief, for the PC-MRI data, a region of interest (ROI) was manually drawn by outlining the vessel wall in one of the slice images. Subsequently, an automated contour detection method was applied, and the ROI was forwarded in all slices. If needed, the automated ROI was corrected. All images were quality rated and inadequate images were excluded (&#x0003c;10%). Flow results from the femoral and renal arteries are presented as the mean of the left and right arteries. Cardiac index (CI) was calculated from flow through the aorta to calculate CO, which was then divided by the total body surface area (BSA), calculated using the Du Bois formula. Blood flow within the vessel is presented as the absolute flow in ml/min and the relative flow as a percentage of CO (calculated as flow divided by CO multiplied by 100). The cardiac images were also analyzed using CVI42, drawing an ROI at the endocardial and epicardial contours of the heart to calculate left ventricular stroke volume. For assessing cardiac contractility, a feature-tracking algorithm was applied to the long axis of the endocardial contour of the left ventricle in both two- and four-chamber views to compute GLS. Intra- and interobserver variation has been documented elsewhere,<xref rid="bib15" ref-type="bibr"><sup>15</sup></xref> and all coefficients of variation were &#x0003c;10%, which is comparable to the variation observed in other studies.<xref rid="bib17" ref-type="bibr"><sup>17</sup></xref><sup>,</sup><xref rid="bib18" ref-type="bibr"><sup>18</sup></xref></p></sec><sec id="sec2.4"><title>Ethical considerations</title><p id="p0095">All participants provided written informed consent before enrolment. The study protocols were approved by the Ethics Committee for Medical Research in Copenhagen (H-17001401) and conducted in accordance with the ethical standards outlined in the 1975 Declaration of Helsinki. The study is registered at <ext-link ext-link-type="uri" xlink:href="http://ClinicalTrials.gov" id="intref0010">ClinicalTrials.gov</ext-link> under ID: NCT03483272.</p></sec><sec id="sec2.5"><title>Statistical analysis</title><p id="p0100">Categorical variables are presented as n (%). Quantitative variables are presented as medians with a minimum and maximum or IQR. Flow is presented as absolute median flow in ml/min and as a median flow percentage of CO. Changes in blood flow were calculated as both absolute changes (blood flow after terlipressin minus blood flow at baseline) and relative change (blood flow at baseline minus blood flow after terlipressin, divided by blood flow at baseline, multiplied by 100), resulting in the change and expressed as a percentage. The Wilcoxon matched-pairs signed-rank test was used to analyze hemodynamic differences after terlipressin. For independent samples, the Mann-Whitney <italic>U</italic> test was used to assess the association between changes in hemodynamic parameters and terlipressin response (yes/no), acute-on-chronic liver failure (ACLF) (yes/no), or death within 3 months (yes/no). The statistical tests were based on a two-sided probability, and <italic>p</italic> &#x0003c;0.05 was considered significant. Given the exploratory nature of this study, no adjustments were made for multiple comparisons. Figures were created with BioRender (<ext-link ext-link-type="uri" xlink:href="http://biorender.com" id="intref0015">biorender.com</ext-link>) or R Statistical Software (version 4.4.0). All analyses were performed using SPSS Statistics software version 29 (IBM, Armonk, NY, USA).</p></sec></sec><sec id="sec3"><title>Results</title><sec id="sec3.1"><title>Baseline characteristics and diagnoses</title><p id="p0105"><xref rid="tbl1" ref-type="table">Table 1</xref> summarizes the clinical and biochemical characteristics of the 10 patients with HRS-AKI. The median age of the patients was 61 years, and seven were men. Eight of the patients had alcohol-related cirrhosis and the remaining two patients had alcohol-related cirrhosis in combination with either chronic HBV or &#x003b1;1-antitrypsin deficiency. Six patients had ongoing or periodic alcohol intake, while four patients were abstainers. The median MELD-Na score was 30. Six patients had ACLF, and the median CLIF-C organ failure score was 8. The median serum albumin was 28 g/L, and three patients had serum albumin of 30 g/L or more, apparently as a result of albumin infusion in the days before their inclusion in the study. The median creatinine was 207 &#x003bc;mol/L (2.34 mg/dl), and the maximum creatinine was 358 &#x003bc;mol/L (4.1 mg/dl).<table-wrap position="float" id="tbl1"><label>Table 1</label><caption><p>Clinical and biochemical characteristics of patients with HRS-AKI at baseline.</p></caption><alt-text id="alttext0060">Table 1</alt-text><table frame="hsides" rules="groups"><thead><tr><th rowspan="2">Characteristic</th><th colspan="2">Patients (n = 10)<hr/></th></tr><tr><th align="right">Median</th><th align="right">Minimum; maximum</th></tr></thead><tbody><tr><td>Age (years)</td><td>61</td><td>33; 73</td></tr><tr><td>Gender (n = men)</td><td>7 (70)</td><td>&#x02013;</td></tr><tr><td>Body surface area (m<sup>2</sup>)</td><td>2.0</td><td>1.7; 2.7</td></tr><tr><td colspan="3">Etiology</td></tr><tr><td>&#x000a0;Alcohol</td><td>8 (80)</td><td rowspan="2">&#x02013;</td></tr><tr><td>&#x000a0;Alcohol and HBV or &#x003b1;1-AT</td><td>2 (20)</td></tr><tr><td>Months from cirrhosis diagnosis to HRS-AKI</td><td>5</td><td>0; 143</td></tr><tr><td>Child-Pugh score</td><td>12</td><td>9; 13</td></tr><tr><td>MELD-Na score</td><td>30</td><td>17; 40</td></tr><tr><td>ACLF</td><td>6 (60)</td><td>&#x02013;</td></tr><tr><td>CLIF-C organ failure score</td><td>8</td><td>6; 13</td></tr><tr><td>Creatinine (&#x003bc;mol/L)</td><td>207 (50&#x02013;90)</td><td>145; 243</td></tr><tr><td>Cystatin C (mg/L)</td><td>3.5 (0.61&#x02013;0.95)</td><td>1.5; 3.7</td></tr><tr><td>Renin (ng/L)</td><td>239 (5&#x02013;35)</td><td>10; 6,220</td></tr><tr><td>Sodium (mmol/L)</td><td>130 (137&#x02013;144)</td><td>114; 139</td></tr><tr><td>Platelet count (x10<sup>9</sup>/L)</td><td>91 (145&#x02013;390)</td><td>29; 136</td></tr><tr><td>High-sensitivity CRP (mg/L)</td><td>16 (&#x0003c;10)</td><td>5; 79</td></tr><tr><td>Bilirubin (&#x003bc;mol/L)</td><td>55 (5&#x02013;25)</td><td>15; 158</td></tr><tr><td>INR</td><td>2.1 (&#x0003c;1.2)</td><td>1.4; 2.6</td></tr><tr><td>Albumin (g/L)</td><td>28 (36&#x02013;45)</td><td>19; 40</td></tr><tr><td>ALT (U/L)</td><td>25 (10&#x02013;45)</td><td>15; 72</td></tr><tr><td>QTc <sub>F</sub></td><td>436</td><td>383; 465</td></tr></tbody></table><table-wrap-foot><fn id="tspara0015"><p>Results are presented as n, n (%), medians (normal values), or medians (minimum and maximum values).</p></fn><fn id="tspara0020"><p>&#x003b1;1-AT, &#x003b1;1-antitrypsin deficiency; ACLF, acute-on-chronic liver failure; ALT, alanine aminotransferase; CRP, serum C-reactive protein; HRS-AKI, hepatorenal syndrome&#x02013;acute kidney injury; HVPG, hepatic vein pressure gradient; INR, international normalized ratio; MELD-Na score, Model for End-stage Liver Disease with sodium score; QTc <sub>F</sub>, electrocardiogram-calculated QT interval with Fridericia&#x02019;s formula.</p></fn></table-wrap-foot></table-wrap></p><p id="p0110">The median time from diagnosis of cirrhosis to an episode of HRS-AKI was 5 months; one patient received the diagnosis of cirrhosis while hospitalized for HRS-AKI. Seven patients were treated with diuretics, one patient was treated with propranolol, seven patients had signs of infection, and two patients had alcoholic hepatitis as a possible precipitating factor for developing HRS-AKI.</p></sec><sec id="sec3.2"><title>Impact of terlipressin on cardiac parameters</title><p id="p0115">Following terlipressin, CO decreased by 15% (<italic>p</italic> &#x0003c;0.01) (<xref rid="fig3" ref-type="fig">Fig. 3</xref>A). Stroke volume and heart rate fell by 10% and 8%, respectively, although these changes did not reach statistical significance (<xref rid="tbl2" ref-type="table">Table 2</xref> and <xref rid="fig3" ref-type="fig">Fig. 3</xref>B,C). Terlipressin had no significant effect on GLS (<xref rid="fig3" ref-type="fig">Fig. 3</xref>D) or TAPSE, but the changes in GLS after terlipressin correlated significantly with changes in both mean arterial pressure (MAP) (r = -0.83, <italic>p</italic> = 0.01) and systemic vascular resistance (SVR) (r = -0.79, <italic>p</italic> = 0.02) (<xref rid="appsec1" ref-type="sec">Figs. S1 and S2</xref>, respectively).<fig id="fig3"><label>Fig. 3</label><caption><p>Cardiac parameters before and after terlipressin.</p><p>(A) Cardiac output, (B) stroke volume, (C) heart rate, and (D) global longitudinal strain. Hemodynamic changes are illustrated with (green) or without (red) the terlipressin response. Black dots and lines are median values and IQR before and after terlipressin treatment.</p></caption><alt-text id="alttext0040">Fig. 3</alt-text><graphic xlink:href="gr3"/></fig><table-wrap position="float" id="tbl2"><label>Table 2</label><caption><p>Hemodynamic parameters of patients with HRS-AKI before and after terlipressin treatment.</p></caption><alt-text id="alttext0065">Table 2</alt-text><table frame="hsides" rules="groups"><thead><tr><th>Parameter</th><th>Before terlipressin</th><th>After terlipressin</th><th>Relative change (%)</th><th align="right"><italic>p</italic> value</th></tr></thead><tbody><tr><td colspan="5"><bold>Cardiac parameters</bold></td></tr><tr><td>Cardiac output (L/min)</td><td>9.7 (7.6&#x02013;13.2)</td><td>8.3 (6.7&#x02013;11.6)</td><td>-15.1</td><td><bold>&#x0003c;0.01</bold></td></tr><tr><td>Cardiac index (L/min/m<sup>2</sup>)</td><td>4.8 (3.6&#x02013;6.3)</td><td>4.2 (3.0&#x02013;5.5)</td><td>-15.1</td><td><bold>&#x0003c;0.01</bold></td></tr><tr><td>Heart rate (beat/min)</td><td>85 (78&#x02013;98)</td><td>77 (69&#x02013;90)</td><td>-8.0</td><td>0.07</td></tr><tr><td>Stroke volume (ml)</td><td>102 (98&#x02013;145)</td><td>98 (84&#x02013;135)</td><td>-9.8</td><td>0.31</td></tr><tr><td>Global longitudinal strain (%)</td><td>17.0 (19.9&#x02013;13.9)</td><td>15.4 (20.4&#x02013;9.2)</td><td>-20.0</td><td>0.48</td></tr><tr><td>TAPSE (mm)</td><td>23.8 (16.2&#x02013;30.1)</td><td>23.3 (11.8&#x02013;28.8)</td><td>-2.1</td><td>0.14</td></tr><tr><td colspan="5"><hr/></td></tr><tr><td colspan="5"><bold>Renal and systemic parameters</bold></td></tr><tr><td>Mean arterial pressure (mmHg)</td><td>72 (66&#x02013;81)</td><td>84 (81&#x02013;97)</td><td>12.8</td><td><bold>&#x0003c;0.01</bold></td></tr><tr><td>SVR (dynes &#x000b7; sec/cm<sup>5</sup>)</td><td>560 (479&#x02013;734)</td><td>902 (566&#x02013;1,022)</td><td>32.2</td><td><bold>&#x0003c;0.01</bold></td></tr><tr><td colspan="5">Renal artery</td></tr><tr><td>&#x000a0;Blood flow (ml/min)</td><td>242 (182&#x02013;304)</td><td>296 (233&#x02013;371)</td><td>22.7</td><td><bold>&#x0003c;0.01</bold></td></tr><tr><td>&#x000a0;Blood flow/CO (%)</td><td>2.5 (1.9: 2.8)</td><td>3.4 (2.4&#x02013;4.3)</td><td>49.1</td><td><bold>0.01</bold></td></tr><tr><td colspan="5">Femoral artery</td></tr><tr><td>&#x000a0;Blood flow (ml/min)</td><td>702 (515&#x02013;1,132)</td><td>447 (333&#x02013;628)</td><td>-39.8</td><td><bold>&#x0003c;0.01</bold></td></tr><tr><td>&#x000a0;Blood flow/CO (%)</td><td>7.7 (6.6&#x02013;9.5)</td><td>5.3 (4.1&#x02013;7.2)</td><td>-28.7</td><td><bold>&#x0003c;0.01</bold></td></tr><tr><td colspan="5"><hr/></td></tr><tr><td colspan="5"><bold>Splanchnic parameters</bold></td></tr><tr><td colspan="5">Superior mesenteric artery</td></tr><tr><td>&#x000a0;Blood flow (ml/min)</td><td>647 (486&#x02013;1,050)</td><td>451 (272&#x02013;783)</td><td>-27.4</td><td><bold>&#x0003c;0.01</bold></td></tr><tr><td>&#x000a0;Blood flow/CO (%)</td><td>7.9 (5.5&#x02013;9.0)</td><td>5.8 (4.6&#x02013;8.4)</td><td>-19.4</td><td><bold>0.05</bold></td></tr><tr><td colspan="5">Portal vein</td></tr><tr><td>&#x000a0;Blood flow (ml/min)</td><td>1,040 (595&#x02013;1,214)</td><td>821 (695&#x02013;1,039)</td><td>-33.2</td><td>0.13</td></tr><tr><td>&#x000a0;Blood flow/CO (%)</td><td>8.8 (6.3&#x02013;12.4)</td><td>7.7 (6.4&#x02013;11.8)</td><td>-21.8</td><td>0.31</td></tr><tr><td colspan="5">Azygos vein</td></tr><tr><td>&#x000a0;Blood flow (ml/min)</td><td>517 (61&#x02013;1,410)</td><td>264 (18&#x02013;653)</td><td>-50.0</td><td>0.14</td></tr><tr><td>&#x000a0;Blood flow/CO (%)</td><td>4.8 (0.7&#x02013;8.9)</td><td>2.5 (0.2&#x02013;5.6)</td><td>-39.1</td><td>0.14</td></tr></tbody></table><table-wrap-foot><fn id="tspara0030"><p>Results are presented as median &#x000b1; (IQR). Flow is categorized as absolute flow or percentage flow of CO (flow/CO). Median femoral and renal flow are presented as means of the left and right arteries. Data were analyzed using the Wilcoxon matched-pairs signed-rank test; <italic>p</italic> &#x0003c;0.05 was considered statistically significant and marked in bold. The relative change was calculated as ([X-baseline - X-after]/X-baseline) x 100, expressed as a median percentage change.</p></fn><fn id="tspara0035"><p>CO, cardiac output; HRS-AKI, hepatorenal syndrome&#x02013;acute kidney injury; SVR, systemic vascular resistance; TAPSE, tricuspid annular plane systolic excursion.</p></fn></table-wrap-foot></table-wrap></p></sec><sec id="sec3.3"><title>Impact of terlipressin on renal blood flow and systemic parameters</title><p id="p0120">Absolute renal artery blood flow increased by 23% after terlipressin (<italic>p</italic> &#x0003c;0.01) and, even more strikingly, was found to have increased when analyzed as the renal artery blood flow percentage of CO (49%, <italic>p</italic> = 0.01) (<xref rid="tbl2" ref-type="table">Table 2</xref> and <xref rid="fig4" ref-type="fig">Fig. 4</xref>C). Baseline renal artery blood flow correlated with serum creatinine (r = -0.77, <italic>p</italic> &#x0003c;0.01). MAP and SVR increased after terlipressin by 13% and 32% (<italic>p</italic> &#x0003c;0.01), respectively. Both femoral artery blood flow and femoral artery blood flow as a percentage of CO decreased after terlipressin (-40% and -29%, respectively, <italic>p</italic> &#x0003c;0.01) (<xref rid="tbl2" ref-type="table">Table 2</xref> and <xref rid="fig4" ref-type="fig">Fig. 4</xref>D).<fig id="fig4"><label>Fig. 4</label><caption><p>Renal and systemic parameters before and after terlipressin.</p><p>(A) Mean arterial pressure, (B) systemic vascular resistance, (C) renal blood flow, and (D) femoral artery blood flow. Hemodynamic changes are illustrated according to the terlipressin response (green) or without the response to terlipressin (red). Black dots and lines are median values and interquartile ranges (IQR) before and after terlipressin treatment.</p></caption><alt-text id="alttext0045">Fig. 4</alt-text><graphic xlink:href="gr4"/></fig></p></sec><sec id="sec3.4"><title>Impact of terlipressin on splanchnic flow</title><p id="p0125">Superior mesenteric artery blood flow decreased by -27% (<italic>p</italic> &#x0003c;0.01) and by -19% relative to the change in CO (<italic>p</italic> = 0.05). Portal venous blood flow decreased non-significantly by -21% from 1,040 ml/min to 821 ml/min after terlipressin (<xref rid="fig5" ref-type="fig">Fig. 5</xref>B). The median azygos venous blood flow fell by -50% from 517 ml/min to 264 ml/min after terlipressin (again non-significantly), but data for this were only available from four patients (<xref rid="fig5" ref-type="fig">Fig. 5</xref>C).<fig id="fig5"><label>Fig. 5</label><caption><p>Splanchnic blood flow before and after terlipressin.</p><p>(A) Superior mesenteric artery blood flow, (B) portal venous blood flow, and (C) azygous venous blood flow. Hemodynamic changes are illustrated with (green) or without (red) the response to terlipressin. Black dots and lines are median values and IQR before and after terlipressin treatment.</p></caption><alt-text id="alttext0050">Fig. 5</alt-text><graphic xlink:href="gr5"/></fig></p></sec><sec id="sec3.5"><title>Consequences of ACLF, severity of kidney failure, and inflammation on the hemodynamic response to terlipressin</title><p id="p0130">Six patients had ACLF grade 1 or 2 with organ failure, including kidney failure and/or coagulopathy (<xref rid="appsec1" ref-type="sec">Table S1</xref>). Patients with ACLF and HRS-AKI had significantly lower baseline renal artery blood flow compared with those with HRS-AKI only (<italic>p</italic> = 0.02). However, the hemodynamic changes after terlipressin treatment did not differ significantly between the two groups (<xref rid="appsec1" ref-type="sec">Table S2</xref> and <xref rid="appsec1" ref-type="sec">Fig. S3&#x02013;S5</xref>). The severity of kidney failure (according to creatinine levels) did not correlate significantly with changes in renal artery blood flow after terlipressin or with other hemodynamic changes. Serum C-reactive protein (CRP) levels were significantly associated with the increase in SVR after terlipressin (<italic>p</italic> = 0.002) and patients with the highest CRP levels tended to have the most pronounced decreases in CO, although this trend was not significant (<italic>p</italic> = 0.14; <xref rid="appsec1" ref-type="sec">Figs. S6 and S7</xref>).</p></sec><sec id="sec3.6"><title>Hemodynamic changes in relation to terlipressin response and clinical outcome</title><p id="p0135">We found no significant correlations between changes in cardiac or blood flow parameters and changes in serum creatinine or terlipressin response (non- or partial response/full response) (<xref rid="appsec1" ref-type="sec">Figs. S8 and S9</xref>); neither did we find any associations between hemodynamic changes following terlipressin and rates of survival.</p><p id="p0140"><xref rid="fig6" ref-type="fig">Fig. 6</xref> illustrates the study timeline. One week after the diagnosis of HRS-AKI, seven patients were classified as terlipressin responders (<xref rid="appsec1" ref-type="sec">Table S3</xref>), one as a partial responder, and two as non-responders. During follow-up, three of the seven terlipressin responders had a relapse of AKI within 3 months of their HRS-AKI diagnosis, two died, and two patients maintained a normal renal function. When looking at the entire cohort, three patients died within 3 weeks of follow-up, and four patients died within the first 3 months. The median survival time was 87 days. Two of the 10 patients were still alive at the end of the follow-up period.<fig id="fig6"><label>Fig. 6</label><caption><p>Follow-up timeline.</p><p>Ten patients were included in the study, two of whom were still alive at the end of follow-up. AKI, acute kidney injury; HRS-AKI, hepatorenal syndrome&#x02013;acute kidney injury.</p></caption><alt-text id="alttext0055">Fig. 6</alt-text><graphic xlink:href="gr6"/></fig></p></sec></sec><sec id="sec4"><title>Discussion</title><p id="p0145">This study is the first to non-invasively assess several regional hemodynamic changes following terlipressin treatment in patients with HRS-AKI. Our previous research established that patients with HRS-AKI are characterized by extremely hyperdynamic circulation, marked by peripheral and splanchnic vasodilatation, low SVR, and reduced renal artery blood flow despite elevated CO.<xref rid="bib15" ref-type="bibr"><sup>15</sup></xref> The current study comprehensively maps how terlipressin alleviates this hyperdynamic state and improves renal artery blood flow in HRS-AKI.</p><p id="p0150">The main findings of this study are that: (1) terlipressin increases renal artery blood flow despite a marked reduction in CO; (2) terlipressin decreases splanchnic and peripheral blood flow as a result of both reduced CO and selective vasoconstriction; and (3) MRI is a feasible and non-invasive tool for characterizing the hemodynamic effects of terlipressin in patients with HRS-AKI.</p><sec id="sec4.1"><title>Terlipressin-induced redistribution of blood volume</title><p id="p0155">A key finding of this study is that terlipressin increases renal artery blood flow while simultaneously decreasing CO and reducing blood flow in other vascular regions. Notably, we observed a lower percentage of CO directed toward the splanchnic and peripheral circulation after terlipressin. This indicates that the reduced absolute blood flow to these areas cannot be attributed solely to the decrease in CO, but is also influenced by selective vasoconstriction and redistribution of blood volume. Our results are supported by a study by Snowdon <italic>et al.</italic>, who reported a similar blood volume redistribution with reduced flow observed in the superior mesenteric artery, portal vein, and azygos vein following terlipressin.<xref rid="bib3" ref-type="bibr"><sup>3</sup></xref> In their study, the total renal arterial blood flow was not significantly altered by terlipressin, although they reported that the mean renal blood flow increased by 14%. However, their cohort comprised 19 patients with compensated cirrhosis with a high baseline renal arterial blood flow of 700 ml/min (total for both renal arteries). These patients are unlikely to have had a hyperdynamic circulation with splanchnic and systemic vasodilatation, unlike our patients with a hyperdynamic circulation with HRS-AKI. This indicates that the renal effects of terlipressin depend on the intensity of vasodilatation and severity of cirrhosis.<xref rid="bib9" ref-type="bibr"><sup>9</sup></xref><sup>,</sup><xref rid="bib19" ref-type="bibr"><sup>19</sup></xref> These findings serve to reiterate the importance of investigating the effects of terlipressin in patients with HRS-AKI, where circulatory dynamics differ markedly from those of patients with compensated cirrhosis.</p></sec><sec id="sec4.2"><title>Effect of terlipressin on cardiac output</title><p id="p0160">It is well known that terlipressin reduces CO, which may affect renal perfusion. We found a 15% reduction in CO after terlipressin, similar to previous studies (which reported reductions of 11&#x02013;18%).<xref rid="bib7" ref-type="bibr"><sup>7</sup></xref><sup>,</sup><xref rid="bib10" ref-type="bibr"><sup>10</sup></xref><sup>,</sup><xref rid="bib20" ref-type="bibr"><sup>20</sup></xref><sup>,</sup><xref rid="bib21" ref-type="bibr"><sup>21</sup></xref> Although not reaching statistical significance, both stroke volume and heart rate were lower after terlipressin and both contributed to the reduction in CO. Accordingly, reduced CO may be a direct physiological consequence of the increase in MAP and the redistribution of blood volume to the systemic circulation, leading to both reflex bradycardia and increased afterload with reduced stroke volume, and thereby reduced CO.<xref rid="bib20" ref-type="bibr"><sup>20</sup></xref> Whether this effect is harmful and influences the efficacy of terlipressin is a matter of ongoing debate.<xref rid="bib7" ref-type="bibr"><sup>7</sup></xref><sup>,</sup><xref rid="bib8" ref-type="bibr"><sup>8</sup></xref><sup>,</sup><xref rid="bib20" ref-type="bibr"><sup>20</sup></xref><sup>,</sup><xref rid="bib21" ref-type="bibr"><sup>21</sup></xref> A recent study reported that an increase in CO induced by dobutamine did not provide additional benefits to renal function compared with the effect of terlipressin alone.<xref rid="bib22" ref-type="bibr"><sup>22</sup></xref> Furthermore, although terlipressin reduces CO, it appears to enhance cardiac reserve and alleviate hyperdynamic circulation during long-term continuous infusion.<xref rid="bib13" ref-type="bibr"><sup>13</sup></xref></p></sec><sec id="sec4.3"><title>Risk of respiratory failure</title><p id="p0165">Recent results from the CONFIRM study identified an increased risk of respiratory failure in patients with ACLF grade 3 who received terlipressin.<xref rid="bib23" ref-type="bibr"><sup>23</sup></xref> Although the underlying mechanisms remain unclear, these findings have prompted new recommendations from the EMA and FDA. These highlight the importance of avoiding terlipressin treatment in patients with HRS-AKI with advanced renal failure (creatinine &#x02265;442 &#x003bc;mol/L [5.0 mg/dl]) or ACLF 3 to prevent respiratory failure.<xref rid="bib24" ref-type="bibr"><sup>24</sup></xref> In our study, no patients had ACLF 3 or creatinine &#x0003e;442 &#x003bc;mol/L; however, one patient with ACLF 2 and creatinine of 358 &#x003bc;mol/L developed respiratory failure during follow-up and died on day 8.</p><p id="p0170">In the CONFIRM study, only one-third of the patients had pulmonary edema reported as the cause of respiratory failure, while most cases of respiratory failure were related to aspiration pneumonia or infection.<xref rid="bib25" ref-type="bibr"><sup>25</sup></xref> In our study, greater inflammation (CRP) correlated with more pronounced systemic vasoconstriction after terlipressin, measured as an increase in SVR and a trend toward a compensatory, more pronounced decrease in CO (<xref rid="appsec1" ref-type="sec">Figs. S6 and S7</xref>). Hypothetically, this intense systemic vasoconstriction could result in a high afterload, contributing to cardiac failure and pulmonary edema. Furthermore, this effect might be exacerbated in cases of fluid overload, which is likely to be more pronounced in patients with ACLF 3 because of extensive fluid resuscitation and more severe kidney failure. However, we did not observe any significant differences following terlipressin in the left atrial or ventricular volumes compared with the right heart volumes, indicating no acute left-side cardiac failure after the first dose of terlipressin. In addition, terlipressin caused no significant change in TAPSE, which is the standard measurement of right ventricular function. Pulmonary congestion causes pulmonary hypertension, which (because of the strain on the right ventricular function) causes a subsequent reduction in TAPSE, but we did not observe this in our study. However, in the CONFIRM study, respiratory failure developed on days 5&#x02013;7 and not on the first day of treatment.<xref rid="bib23" ref-type="bibr"><sup>23</sup></xref> Furthermore, our study did not include patients with ACLF 3, and it was not statistically powered to demonstrate a risk of respiratory failure. This possibly fatal side effect of terlipressin warrants further investigations in larger studies to elucidate the underlying mechanisms.</p></sec><sec id="sec4.4"><title>Effect of terlipressin on renal function and clinical outcome</title><p id="p0175">We found no correlation between renal function, as measured by changes in creatinine, and alterations in renal artery blood flow, CO, MAP, or GLS; however, this study was not statistically powered to detect such possible associations. One explanation of the missing link between the hemodynamic changes after terlipressin and clinical outcome is that other factors, such as comorbidity, coexisting inflammation, baseline kidney function, and higher age, all interfere with the course and outcome of terlipressin treatment. In addition, a recently published study reported an increased risk of multidrug-resistant organism colonization after treatment with terlipressin, which is yet another of the effects of terlipressin that remains underexplored.<xref rid="bib26" ref-type="bibr"><sup>26</sup></xref> Finally, many of the aforementioned factors and cardiocirculatory mechanisms are inter-related, further complicating the elucidation of effects of terlipressin on renal function.</p><p id="p0180">A major strength of this study is its comprehensive description of the cardiocirculatory changes following terlipressin, which have not previously been investigated in patients with HRS-AKI. Our results indicate a selective cardiovascular effect that alleviates hyperdynamic circulation and helps to normalize splanchnic and peripheral vasodilatation, thus redistributing the blood volume to central compartments and improving renal blood flow despite a concurrent reduction in CO. However, the small sample size of our study might have been inadequate for detecting other significant changes and potential associations. Patients with HRS-AKI eligible for a clinical study are rare, and it is difficult to ensure their safety in a MR scanner. We screened patients with HRS-AKI for more than 3 years and excluded patients if they had arrhythmia, hepatic encephalopathy above grade two, or concurrent comorbidities that would have impeded the completion of the study protocol (<xref rid="fig1" ref-type="fig">Fig. 1</xref>). These exclusion criteria were necessary to ensure patient safety and optimize the quality of the MR images, but they might have introduced selection bias. PC-MRI of renal artery blood flow is a well-established, non-invasive method<xref rid="bib27" ref-type="bibr"><sup>27</sup></xref><sup>,</sup><xref rid="bib28" ref-type="bibr"><sup>28</sup></xref> and requires no contrast agents. Our study emphasizes PC-MRI and cardiac MRI as useful tools for characterizing, and potentially monitoring, the hemodynamic effects of vasoactive therapies for patients with cirrhosis. Future studies should focus on exploring the hemodynamic effects of terlipressin in larger cohorts to identify prognostic imaging markers for response to treatment in HRS-AKI, with the potential to contribute to future advances in personalized medicine for patients with cirrhosis.</p><p id="p0185">In conclusion, terlipressin reduces CO and alleviates splanchnic and peripheral vasodilatation. These effects, together with an increase in MAP, appear to induce a selective increase in renal artery blood flow, which is beneficial to patients with HRS-AKI. However, the precise relationship between hemodynamic changes and clinical outcomes in the context of treatment with terlipressin remains unclear, and larger studies are recommended. MRI without contrast agents appears to be a practical, non-invasive tool for assessing potential new drugs in the treatment of complications related to portal hypertension.</p></sec></sec><sec id="sec5"><title>Abbreviations</title><p id="p0190">&#x003b1;1-AT, &#x003b1;-1-antitrypsin deficiency; ACLF, acute-on-chronic liver failure; AKI, acute kidney injury; ALT, alanine aminotransferase; BSA, body surface area; CI, cardiac index; CO, cardiac output; CRP, Serum C-reactive protein; ECG, electrocardiogram; GLS, global longitudinal strain; HRS-AKI, hepatorenal syndrome&#x02013;acute kidney injury; HVPG, hepatic vein pressure gradient; MAP, mean arterial pressure; MELD-Na score, Model for End-stage Liver Disease with sodium score; MRI, magnetic resonance imaging; PC, phase contrast; QTc F, electrocardiogram-calculated QT interval with Fridericia&#x02019;s formula; ROI, region of interest; SVR, systemic vascular resistance; TAPSE, tricuspid annular plane systolic excursion.</p></sec><sec id="sec8"><title>Financial support</title><p id="p0205">This project received primary financial support from Ferring Pharmaceuticals A/S, along with supplementary funding from the Amager Hvidovre University Hospital Research Foundation and The Liver Disease Foundation at Amager and Hvidovre University Hospital.</p></sec><sec id="sec6"><title>Authors&#x02019; contributions</title><p id="p0195">Study concept and design; obtaining of funding; interpretation of data: KVD, JDH, SM, FB. Drafting of manuscript; guarantor of article: KVD. Acquisition and analysis of data: KVD, JDH, SM, FB, PN, SW, TMK. MR study concept, administrative, and technical support: HRS, RS, STF, GPA. Critical revision of manuscript: JDH, SM, FB. All authors approved the final version of the manuscript, including the list of authors.</p></sec><sec sec-type="data-availability" id="sec7"><title>Data availability statement</title><p id="p0200">In compliance with ethical guidelines and to protect participants&#x02019; anonymity, raw data remain confidential and will not be shared.</p></sec><sec sec-type="COI-statement" id="coi0010"><title>Conflicts of interest</title><p id="p0210">The study was supported by an independent research grant from Ferring Pharmaceuticals A/S. HRS has received honoraria as speaker and consultant from Lundbeck AS, and as editor (of <italic>Neuroimage Clinical</italic>) from Elsevier. He has received royalties as a book editor from Springer, Oxford University Press, and Gyldendal.</p><p id="p0215">Please refer to the accompanying ICMJE disclosure forms for further details.</p></sec></body><back><ref-list id="cebib0010"><title>References</title><ref id="bib1"><label>1</label><element-citation publication-type="journal" id="sref1"><person-group person-group-type="author"><name><surname>Wong</surname><given-names>F.</given-names></name><name><surname>Pappas</surname><given-names>S.C.</given-names></name><name><surname>Curry</surname><given-names>M.P.</given-names></name><etal/></person-group><article-title>Terlipressin plus albumin for the treatment of type 1 hepatorenal syndrome</article-title><source>N Engl J Med</source><volume>384</volume><year>2021</year><fpage>818</fpage><lpage>828</lpage><pub-id pub-id-type="pmid">33657294
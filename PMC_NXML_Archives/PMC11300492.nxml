<inline-formula id="IEq11"><alternatives><tex-math id="M19">\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\beta$$\end{document}</tex-math><mml:math id="M20"><mml:mi>&#x003b2;</mml:mi></mml:math><inline-graphic xlink:href="259_2023_6560_Article_IEq11.gif"/></alternatives></inline-formula><sup>&#x02212;</sup>

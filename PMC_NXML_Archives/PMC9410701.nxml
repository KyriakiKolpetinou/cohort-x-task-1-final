t" rowspan="1" colspan="1">S5</td><td valign="top" align="center" rowspan="1" colspan="1">0.29</td><td valign="top" align="center" rowspan="1" colspan="1">2.46</td><td valign="top" align="center" rowspan="1" colspan="1">1.93<xref rid="TN2" ref-type="table-fn"><sup>*</sup></xref></td><td valign="top" align="center" rowspan="1" colspan="1">4.15<xref rid="TN3" ref-type="table-fn"><sup>**</sup></xref></td><td valign="top" align="center" rowspan="1" colspan="1">0.49</td><td valign="top" align="center" rowspan="1" colspan="1">2.16</td><td valign="top" align="center" rowspan="1" colspan="1">0.91</td><td valign="top" align="center" rowspan="1" colspan="1">1.81</td><td valign="top" align="center" rowspan="1" colspan="1">0.18</td><td valign="top" align="center" rowspan="1" colspan="1">1.38</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02212;0.01</td><td valign="top" align="center" rowspan="1" colspan="1">0.73</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">S6</td><td valign="top" align="center" rowspan="1" colspan="1">5.55</td><td valign="top" align="center" rowspan="1" colspan="1">0.26</td><td valign="top" align="center" rowspan="1" colspan="1">6.23</td><td valign="top" align="center" rowspan="1" colspan="1">4.82</td><td valign="top" align="center" rowspan="1" colspan="1">6.27</td><td valign="top" align="center" rowspan="1" colspan="1">2.46</td><td valign="top" align="center" rowspan="1" colspan="1">8.10<xref rid="TN2" ref-type="table-fn"><sup>*</sup></xref></td><td valign="top" align="center" rowspan="1" colspan="1">9.70<xref rid="TN3" ref-type="table-fn"><sup>**</sup></xref></td><td valign="top" align="center" rowspan="1" colspan="1">7.56</td><td valign="top" align="center" rowspan="1" colspan="1">&#x02212;0.36</td><td valign="top" align="center" rowspan="1" colspan="1">6.87</td><td valign="top" align="center" rowspan="1" colspan="1">7.43</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">S7</td><td valign="top" align="center" rowspan="1" colspan="1">2.75</td><td valign="top" align="center" rowspan="1" colspan="1">0.80</td><td valign="top" align="center" rowspan="1" colspan="1">4.11<xref rid="TN2" ref-type="table-fn"><sup>*</sup></xref></td><td valign="top" align="center" rowspan="1" colspan="1">1.03</td><td valign="top" align="center" rowspan="1" colspan="1">3.23</td><td valign="top" align="center" rowspan="1" colspan="1">0.85</td><td valign="top" align="center" rowspan="1" colspan="1">3.27</td><td valign="top" align="center" rowspan="1" colspan="1">4.78<xref rid="TN3" ref-type="table-fn"><sup>**</sup></xref></td><td valign="top" align="center" rowspan="1" colspan="1">2.04</td><td valign="top" align="center" rowspan="1" colspan="1">1.47</td><td valign="top" align="center" rowspan="1" colspan="1">2.98</td><td valign="top" align="center" rowspan="1" colspan="1">2.33</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">S8</td><td valign="top" align="center" rowspan="1" colspan="1">1.76</td><td valign="top" align="center" rowspan="1" colspan="1">3.18</td><td valign="top" align="center" rowspan="1" colspan="1">5.00<xref rid="TN2" ref-type="table-fn"><sup>*</sup></xref></td><td valign="top" align="center" rowspan="1" colspan="1">4.22</td><td valign="top" align="center" rowspan="1" colspan="1">2.75</td><td valign="top" align="center" rowspan="1" colspan="1">2.18</td><td valign="top" align="center" rowspan="1" colspan="1">4.41</td><td valign="top" align="center" rowspan="1" colspan="1">2.68</td><td valign="top" align="center" rowspan="1" colspan="1">2.05</td><td valign="top" align="center" rowspan="1" colspan="1">2.13</td><td valign="top" align="center" rowspan="1" colspan="1">4.35</td><td valign="top" align="center" rowspan="1" colspan="1">4.51<xref rid="TN3" ref-type="table-fn"><sup>**</sup></xref></td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">Mean</td><td valign="top" align="center" rowspan="1" colspan="1">2.49</td><td valign="top" align="center" rowspan="1" colspan="1">1.45</td><td valign="top" align="center" rowspan="1" colspan="1">4.06<xref rid="TN2" ref-type="table-fn"><sup>*</sup></xref></td><td valign="top" align="center" rowspan="1" colspan="1">0.94</td><td valign="top" align="center" rowspan="1" colspan="1">2.26</td><td valign="top" align="center" rowspan="1" colspan="1">1.40</td><td valign="top" align="center" rowspan="1" colspan="1">3.55</td><td valign="top" align="center" rowspan="1" colspan="1">6.70<xref rid="TN3" ref-type="table-fn"><sup>**</sup></xref></td><td valign="top" align="center" rowspan="1" colspan="1">2.52</td><td valign="top" align="center" rowspan="1" colspan="1">1.15</td><td valign="top" align="center" rowspan="1" colspan="1">2.94</td><td valign="top" align="center" rowspan="1" colspan="1">3.21</td></tr></tbody></table><table-wrap-foot><p><italic>Pre, pre-intervention; Post, post-intervention; L(R)SMC, Left (Right)sensorimotor cortex; L(R)PMC, Left (Right)premotor cortex; L(R)PFC, Left (Right) prefrontal cortex</italic>.</p><fn id="TN2"><label>*</label><p><italic>the maximum mean beta value of 6 ROIs pre intervention</italic>.</p></fn><fn id="TN3"><label>**</label><p><italic>the maximum mean beta value of 6 ROIs post intervention</italic>.</p></fn></table-wrap-foot></table-wrap><table-wrap position="float" id="T3"><label>Table 3</label><caption><p>Change Patterns of brain regions from pre-intervention to post-intervention according to &#x003b2; value.</p></caption><table frame="hsides" rules="groups"><thead><tr><th valign="top" align="left" rowspan="1" colspan="1">

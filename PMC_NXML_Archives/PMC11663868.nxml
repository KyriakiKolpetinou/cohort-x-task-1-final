<bold>Sex</bold>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Male</td><td align="center" valign="top" rowspan="1" colspan="1">7 (70%)</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Female</td><td align="center" valign="top" rowspan="1" colspan="1">3 (30%)</td></tr><tr><td align="left" valign="top" colspan="2" rowspan="1">

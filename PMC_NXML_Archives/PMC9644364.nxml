<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" dtd-version="1.3" xml:lang="en" article-type="research-article"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Open Heart</journal-id><journal-id journal-id-type="iso-abbrev">Open Heart</journal-id><journal-id journal-id-type="hwp">openhrt</journal-id><journal-id journal-id-type="publisher-id">openheart</journal-id><journal-title-group><journal-title>Open Heart</journal-title></journal-title-group><issn pub-type="epub">2053-3624</issn><publisher><publisher-name>BMJ Publishing Group</publisher-name><publisher-loc>BMA House, Tavistock Square, London, WC1H 9JR</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">36344108</article-id><article-id pub-id-type="pmc">9644364</article-id><article-id pub-id-type="publisher-id">openhrt-2022-002105</article-id><article-id pub-id-type="doi">10.1136/openhrt-2022-002105</article-id><article-categories><subj-group subj-group-type="heading"><subject>Heart Failure and Cardiomyopathies</subject></subj-group><subj-group subj-group-type="hwp-journal-coll"><subject>1506</subject></subj-group><series-title>Protocol</series-title></article-categories><title-group><article-title>Design and rationale of the inferior vena CAVA and Lung UltraSound-guided therapy in Acute Heart Failure (CAVAL US-AHF Study): a randomised controlled trial</article-title></title-group><contrib-group><contrib id="author-100320462" contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0002-3999-1265</contrib-id><name><surname>Burgos</surname><given-names>Lucrecia Maria</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib id="author-100323835" contrib-type="author"><name><surname>Baro Vila</surname><given-names>Rocio</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib id="author-100325280" contrib-type="author"><name><surname>Goyeneche</surname><given-names>Ailin</given-names></name><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-100325315" contrib-type="author"><name><surname>Mu&#x000f1;oz</surname><given-names>Florencia</given-names></name><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-100325344" contrib-type="author"><name><surname>Spaccavento</surname><given-names>Ana</given-names></name><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-100325415" contrib-type="author"><name><surname>Fasan</surname><given-names>Martin Andres</given-names></name><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-100325435" contrib-type="author"><name><surname>Ballari</surname><given-names>Franco</given-names></name><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-100325472" contrib-type="author"><name><surname>Vivas</surname><given-names>Martin</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-100325528" contrib-type="author"><name><surname>Riznyk</surname><given-names>Laura</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-100325560" contrib-type="author"><name><surname>Ghibaudo</surname><given-names>Sebastian</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-100325642" contrib-type="author"><name><surname>Trivi</surname><given-names>Marcelo</given-names></name><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-100325662" contrib-type="author"><name><surname>Ronderos</surname><given-names>Ricardo</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-90363495" contrib-type="author"><name><surname>Costabel</surname><given-names>Juan Pablo</given-names></name><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-100325721" contrib-type="author"><name><surname>Botto</surname><given-names>Fernando</given-names></name><xref rid="aff4" ref-type="aff">4</xref></contrib><contrib id="author-100325733" contrib-type="author"><name><surname>Diez</surname><given-names>Mirta</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><collab>CAVAL US-AHF group</collab></contrib></contrib-group><aff id="aff1">

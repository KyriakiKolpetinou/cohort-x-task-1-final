<institution content-type="department">Heart Failure, Pulmonary Hypertension and Heart Transplant</institution>, <institution>Instituto Cardiovascular de Buenos Aires</institution>, <addr-line content-type="city">Buenos Aires</addr-line>, <country>Argentina</country>
</aff><aff id="aff2">
<label>2</label>

<article-meta><article-id pub-id-type="pmid">41376913</article-id><article-id pub-id-type="pmc">12688498</article-id><article-id pub-id-type="publisher-id">jtd-17-11-9528</article-id><article-id pub-id-type="doi">10.21037/jtd-2025-1407</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Article</subject></subj-group></article-categories><title-group><article-title>The continued importance of surgical resection in the management of pulmonary neuroendocrine tumours</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Starova</surname><given-names>Urim</given-names></name><contrib-id contrib-id-type="orcid">https://orcid.org/0009-0002-0521-3243</contrib-id><xref rid="aff1" ref-type="aff">

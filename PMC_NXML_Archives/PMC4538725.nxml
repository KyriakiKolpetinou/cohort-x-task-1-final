43492.EF</pub-id><pub-id pub-id-type="pmid">12471312</pub-id></element-citation></ref><ref id="A17184R24"><label>24</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Bradway</surname><given-names>JK</given-names></name><name><surname>Klassen</surname><given-names>RA</given-names></name><name><surname>Peterson</surname><given-names>HA</given-names></name></person-group><article-title>Blount disease: a review of the English literature.</article-title><source>J Pediatr Orthop.</source><year>1987</year><volume>7</volume><issue>4</issue><fpage>472</fpage><lpage>80</lpage><pub-id pub-id-type="pmid">3301898</pub-id></element-citation></ref><ref id="A17184R25"><label>25</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Cook</surname><given-names>SD</given-names></name><name><surname>Lavernia</surname><given-names>CJ</given-names></name><name><surname>Burke</surname><given-names>SW</given-names></name><name><surname>Skinner</surname><given-names>HB</given-names></name><name><surname>Haddad</surname><given-names>RJ</given-names></name></person-group><article-title>A biomechanical analysis of the etiology of tibia vara.</article-title><source>J Pediatr Orthop.</source><year>1983</year><volume>3</volume><issue>4</issue><fpage>449</fpage><lpage>54</lpage><pub-id pub-id-type="pmid">6630488</pub-id></element-citation></ref><ref id="A17184R26"><label>26</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Johnston</surname><given-names>CE, 2nd.</given-names></name></person-group><article-title>Infantile tibia vara.</article-title><source>Clin Orthop Relat Res.</source><year>1990</year><issue>255</issue><fpage>13</fpage><lpage>23</lpage><pub-id pub-id-type="pmid">2347147</pub-id></element-citation></ref><ref id="A17184R27"><label>27</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Loder</surname><given-names>RT</given-names></name><name><surname>Johnston</surname><given-names>CE, 2nd.</given-names></name></person-group><article-title>Infantile tibia vara.</article-title><source>J Pediatr Orthop.</source><year>1987</year><volume>7</volume><issue>6</issue><fpage>639</fpage><lpage>46</lpage><pub-id pub-id-type="pmid">3429646</pub-id></element-citation></ref></ref-list></back></article>
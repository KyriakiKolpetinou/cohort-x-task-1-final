</corresp></author-notes><pub-date pub-type="epub"><day>11</day><month>7</month><year>2024</year></pub-date><pub-date pub-type="collection"><month>9</month><year>2025</year></pub-date><volume>8</volume><issue seq="100">9</issue><issue-id pub-id-type="doi">10.1002/ame2.v8.9</issue-id><issue-title content-type="special-issue-title">Themed Issue: Multidimensional Mechanisms and Therapeutic Strategies in Diabetes</issue-title><fpage>1635</fpage><lpage>1644</lpage><history>

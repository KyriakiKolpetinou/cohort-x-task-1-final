</element-citation></ref><ref id="bib6"><label>6</label><element-citation publication-type="journal" id="sref6"><person-group person-group-type="author"><name><surname>Huang</surname><given-names>W.</given-names></name><name><surname>Kan</surname><given-names>H.</given-names></name><name><surname>Kovats</surname><given-names>S.</given-names></name></person-group><article-title>The impact of the 2003 heat wave on mortality in Shanghai, China</article-title><source>Sci Total Environ</source><volume>408</volume><year>2010</year><fpage>2418</fpage><lpage>2420</lpage><pub-id pub-id-type="pmid">20219235</pub-id>
</element-citation></ref><ref id="bib7"><label>7</label><element-citation publication-type="journal" id="sref7"><person-group person-group-type="author"><name><surname>Wolf</surname><given-names>S.T.</given-names></name><name><surname>Vecellio</surname><given-names>D.J.</given-names></name><name><surname>Kenney</surname><given-names>W.L.</given-names></name></person-group><article-title>Adverse heat-health outcomes and critical environmental limits (Pennsylvania State University human environmental age thresholds project)</article-title><source>Am J Hum Biol</source><volume>35</volume><year>2023</year><object-id pub-id-type="publisher-id">e23801</object-id></element-citation></ref><ref id="bib8"><label>8</label><element-citation publication-type="journal" id="sref8"><person-group person-group-type="author"><name><surname>Benmarhnia</surname><given-names>T.</given-names></name><name><surname>Deguen</surname><given-names>S.</given-names></name><name><surname>Kaufman</surname><given-names>J.S.</given-names></name><name><surname>Smargiassi</surname><given-names>A.</given-names></name></person-group><article-title>Review article: vulnerability to heat-related mortality: a systematic review, meta-analysis, and meta-regression analysis</article-title><source>Epidemiology</source><volume>26</volume><year>2015</year><fpage>781</fpage><lpage>793</lpage><pub-id pub-id-type="pmid">26332052</pub-id>
</element-citation></ref><ref id="bib9"><label>9</label><element-citation publication-type="journal" id="sref9"><person-group person-group-type="author"><name><surname>Liu</surname><given-names>J.</given-names></name><name><surname>Varghese</surname><given-names>B.M.</given-names></name><name><surname>Hansen</surname><given-names>A.</given-names></name><etal/></person-group><article-title>Heat exposure and cardiovascular health outcomes: a systematic review and meta-analysis</article-title><source>Lancet Planet Health</source><volume>6</volume><year>2022</year><fpage>e484</fpage><lpage>e495</lpage><pub-id pub-id-type="pmid">35709806</pub-id>
</element-citation></ref><ref id="bib10"><label>10</label><element-citation publication-type="journal" id="sref10"><person-group person-group-type="author"><name><surname>Bunker</surname><given-names>A.</given-names></name><name><surname>Wildenhain</surname><given-names>J.</given-names></name><name><surname>Vandenbergh</surname><given-names>A.</given-names></name><etal/></person-group><article-title>Effects of air temperature on climate-sensitive mortality and morbidity outcomes in the elderly; a systematic review and meta-analysis of epidemiological evidence</article-title><source>EBioMedicine</source><volume>6</volume><year>2016</year><fpage>258</fpage><lpage>268</lpage><pub-id pub-id-type="pmid">27211569</pub-id>

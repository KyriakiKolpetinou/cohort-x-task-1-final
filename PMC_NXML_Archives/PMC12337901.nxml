<article-id pub-id-type="publisher-id">MCO280504</article-id><article-id pub-id-type="doi">10.1097/MCO.0000000000001142</article-id><article-id pub-id-type="art-access-id">00005</article-id><article-version vocab="JAV" vocab-identifier="http://www.niso.org/publications/rp/RP-8-2008.pdf" article-version-type="Version of Record">3</article-version><article-categories><subj-group subj-group-type="heading"><subject>ASSESSMENT OF NUTRITIONAL &#x00026; METABOLIC STATUS: Edited by Jann Arends and Kianoush B Kashani</subject></subj-group></article-categories><title-group><article-title>Bioelectrical impedance analysis instruments: how do they differ, what do we need for clinical assessment?</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Dupertuis</surname><given-names>Yves M.</given-names></name><xref rid="aff1" ref-type="aff">

ref-type="aff">6</xref><email>iriseshed@gmail.com</email></contrib><contrib contrib-type="author"><name><surname>Haibel</surname><given-names>Hildrun</given-names></name><xref rid="aff7" ref-type="aff">7</xref><email>Hildrun.Haibel@charite.de</email></contrib><contrib contrib-type="author"><name><surname>Hermann</surname><given-names>Kay Geert</given-names></name><xref rid="aff1" ref-type="aff">1</xref><email>kghermann@gmail.com</email></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0002-0652-9808</contrib-id><name><surname>de Hooge</surname><given-names>Manouk</given-names></name><xref rid="aff8" ref-type="aff">8</xref><email>msmdehooge@gmail.com</email></contrib><contrib contrib-type="author"><name><surname>Jans</surname><given-names>Lennart</given-names></name><xref rid="aff9" ref-type="aff">9</xref><email>lennart.jans@ugent.be</email></contrib><contrib contrib-type="author"><name><surname>Jurik</surname><given-names>Anne Grethe</given-names></name><xref rid="aff10" ref-type="aff">10</xref><email>anne.jurik@aarhus.rm.dk</email></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0003-0305-3290</contrib-id><name><surname>Lambert</surname><given-names>Robert GW</given-names></name><xref rid="aff11" ref-type="aff">11</xref><email>rlambert@ualberta.ca</email></contrib><contrib contrib-type="author"><name><surname>Maksymowych</surname><given-names>Walter</given-names></name><xref rid="aff12" ref-type="aff">12</xref><email>walter.maksymowych@carearthritis.com</email></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="twitter" authenticated="false">https://twitter.com/LeedsTeamSpA</contrib-id><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0002-9683-3407</contrib-id><name><surname>Marzo-Ortega</surname><given-names>Helena</given-names></name><xref rid="aff13" ref-type="aff">13</xref><email>h.marzo-ortega@leeds.ac.uk</email></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0002-4527-852X</contrib-id><name><surname>Navarro-Comp&#x000e1;n</surname><given-names>Victoria</given-names></name><xref rid="aff14" ref-type="aff">14</xref><email>mvictoria.navarroc@gmail.com</email></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0003-3690-467X</contrib-id><name><surname>&#x000d8;stergaard</surname><given-names>Mikkel</given-names></name><xref rid="aff15" ref-type="aff">15</xref><email>mo@dadlnet.dk</email></contrib><contrib contrib-type="author"><name><surname>Pedersen</surname><given-names>Susanne Juhl</given-names></name><xref rid="aff16" ref-type="aff">16</xref><xref rid="aff17" ref-type="aff">17</xref><email>susanne_juhl_ped@dadlnet.dk</email></contrib><contrib contrib-type="author"><name><surname>Reijnierse</surname><given-names>Monique</given-names></name><xref rid="aff18" ref-type="aff">18</xref><email>M.Reijnierse@lumc.nl</email></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0001-5445-548X</contrib-id><name><surname>Rudwaleit</surname><given-names>Martin</given-names></name><xref rid="aff19" ref-type="aff">19</xref><email>MARTIN.RUDWALEIT@KLINIKUMBIELEFELD.DE</email></contrib><contrib contrib-type="author"><name><surname>Sommerfleck</surname><given-names>Fernando A</given-names></name><xref rid="aff20" ref-type="aff">20</xref><email>fersommerfleck@gmail.com</email></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0001-6701-670X</contrib-id><name><surname>Weber</surname><given-names>Ulrich</given-names></name><xref rid="aff21" ref-type="aff">21</xref><email>ulrich.weber02@bluewin.ch</email></contrib><contrib contrib-type="author"><contrib-id contrib-id-type="orcid" 
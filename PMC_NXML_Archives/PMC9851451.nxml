<label>*</label>Correspondence to: Tomotaka Dohi, Department of Cardiovascular Biology and Medicine, Juntendo University Graduate School of Medicine, 2&#x02010;1&#x02010;1 Hongo, Bunkyo&#x02010;ku, Tokyo 113&#x02010;0033, Japan. Email: <email>tdohi@juntendo.ac.jp</email>
</corresp></author-notes><pub-date pub-type="collection"><month>12</month><year>2022</year></pub-date><pub-date pub-type="epub"><day>06</day><month>12</month><year>2022</year></pub-date><volume>11</volume><issue seq="180">23</issue><issue-id pub-id-type="doi">10.1002/jah3.v11.23</issue-id><elocation-id>e026569</elocation-id><history>

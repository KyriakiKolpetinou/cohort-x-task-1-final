nt Restenosis</alt-title><alt-title alt-title-type="left-running-head">Takeuchi et al</alt-title></title-group><contrib-group><contrib id="jah37991-cr-0001" contrib-type="author"><name><surname>Takeuchi</surname><given-names>Mitsuhiro</given-names></name><degrees>MD</degrees><contrib-id contrib-id-type="orcid" authenticated="false">https://orcid.org/0000-0001-7815-6505</contrib-id><xref rid="jah37991-aff-0001" ref-type="aff">

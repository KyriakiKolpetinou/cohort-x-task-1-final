				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\:-$$\end{document}</tex-math><inline-graphic xlink:href="12888_2025_6925_Article_IEq1.gif"/></alternatives></inline-formula>0.592 to <inline-formula id="IEq10"><alternatives><tex-math id="d33e1159">\documentclass[12pt]{minimal}

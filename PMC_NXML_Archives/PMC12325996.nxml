<article-meta><article-id pub-id-type="pmid">40764338</article-id><article-id pub-id-type="pmc">12325996</article-id>
<article-id pub-id-type="publisher-id">11734</article-id><article-id pub-id-type="doi">10.1038/s41598-025-11734-z</article-id><article-categories><subj-group subj-group-type="heading"><subject>Article</subject></subj-group></article-categories><title-group><article-title>Effect of a single ultra processed meal on myocardial endothelial function, adenosine mediated effects and cognitive performances</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Lucinian</surname><given-names>Yousif A.</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Gagnon</surname><given-names>Christine</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Latour</surname><given-names>&#x000c9;lise</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Hamel</surname><given-names>Virginie</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Iglesies-Grau</surname><given-names>Josep</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Nigam</surname><given-names>Anil</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Harel</surname><given-names>Francois</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Nozza</surname><given-names>Anna</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Juneau</surname><given-names>Martin</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Moubarac</surname><given-names>Jean-Claude</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Bherer</surname><given-names>Louis</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Pelletier-Galarneau</surname><given-names>Matthieu</given-names></name><address><email>Matthieu.pelletier-galarneau@icm-mhi.org</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03vs03g62</institution-id><institution-id institution-id-type="GRID">grid.482476.b</institution-id><institution-id institution-id-type="ISNI">0000 0000 8995 9090</institution-id><institution>Department of Medical Imaging, </institution><institution>Montreal Heart Institute, </institution></institution-wrap>Montreal, QC Canada </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03vs03g62</institution-id><institution-id institution-id-type="GRID">grid.482476.b</institution-id><institution-id institution-id-type="ISNI">0000 0000 8995 9090</institution-id><institution>Research Center and Centre &#x000c9;PIC, </institution><institution>Montreal Heart Institute, </institution></institution-wrap>Montreal, QC Canada </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03vs03g62</institution-id><institution-id institution-id-type="GRID">grid.482476.b</institution-id><institution-id institution-id-type="ISNI">0000 0000 8995 9090</institution-id><institution>Department of Medicine, </institution><institution>Montreal Heart Institute, </institution></institution-wrap>Montreal, QC Canada </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03vs03g62</institution-id><institution-id institution-id-type="GRID">grid.482476.b</institution-id><institution-id institution-id-type="ISNI">0000 0000 8995 9090</institution-id><institution>Montreal Health Innovations Coordinating Center, </institution><institution>Montreal Heart Institute, </institution></institution-wrap>Montreal, QC Canada </aff><aff id="Aff5"><label>5</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0161xgx34</institution-id><institution-id institution-id-type="GRID">grid.14848.31</institution-id><institution-id institution-id-type="ISNI">0000 0001 2104 2136</institution-id><institution>Nutrition Department, </institution><institution>Universit&#x000e9; de Montr&#x000e9;al, </institution></institution-wrap>Montreal, QC Canada </aff><aff id="Aff6"><label>6</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/031z68d90</institution-id><institution-id institution-id-type="GRID">grid.294071.9</institution-id><institution-id institution-id-type="ISNI">0000 0000 9199 9374</institution-id><institution>Research Center, </institution><institution>Institut Universitaire de G&#x000e9;riatrie de Montr&#x000e9;al, </institution></institution-wrap>Montreal, QC Canada </aff></contrib-group><pub-date pub-type="epub"><day>6</day><month>8</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>6</day><month>8</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>15</volume><elocation-id>28671</elocation-id><history><date date-type="received"><day>27</day><month>1</month><year>2025</year></date><date date-type="accepted"><day>11</day><month>7</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><p id="Par1">Consumption of ultra-processed foods has been linked to various adverse health effects; however, the mechanisms underlying these effects remain poorly understood. This study aimed to evaluate the impact of a single ultra-processed meal on myocardial blood flow (MBF), measured using positron emission tomography/computed tomography (PET/CT), and its effects on cognitive performance. Fourteen healthy adult males were enrolled in a randomized crossover trial, receiving either a non-ultra-processed meal (comprising foods from NOVA groups 1 to 3) or an ultra-processed meal (comprising foods from NOVA groups 1 to 4) before crossing over to the alternate meal. After each meal, rubidium-chloride PET/CT scans were conducted at baseline and during intermediate (80&#x000a0;&#x000b5;g/kg/min) and high-dose adenosine (140&#x000a0;&#x000b5;g/kg/min). Neuropsychological testing followed each meal. MBF and MFR at intermediate-dose adenosine was significantly higher after the ultra-processed meal compared to the non-ultra-processed meal (1.62 vs. 1.22 mL/min/g, <italic>p</italic>&#x02009;=&#x02009;0.015, and 2.43 vs. 1.88, <italic>p</italic>&#x02009;=&#x02009;0.012, respectively), with a mean relative difference of 40.7%. No significant differences were observed between the meals at baseline or high-dose adenosine for both MBF and MFR. When considering carry-over and learning effects, overall performance on neuropsychological testing was worse following the ultra-processed meal during the first period. In healthy adult males, a single ultra-processed meal enhanced adenosine-mediated MBF and MFR at intermediate-dose adenosine and was associated with potentially reduced cognitive performance compared to a non-ultra-processed meal.</p><p id="Par2"><italic>Trial registration number</italic>: NCT06353009 (ClinicalTrials.gov ID).</p><p id="Par3">
<italic>Trial registration Date</italic>: 08/04/2024 <ext-link ext-link-type="uri" xlink:href="https://clinicaltrials.gov/study/NCT06353009">https://clinicaltrials.gov/study/NCT06353009</ext-link>.</p></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Ultra-processed food</kwd><kwd>Positron emission tomography</kwd><kwd>Endothelial function</kwd><kwd>Adenosine</kwd><kwd>Myocardial blood flow</kwd><kwd>Rubidium</kwd></kwd-group><kwd-group kwd-group-type="npg-subject"><title>Subject terms</title><kwd>Nutrition</kwd><kwd>Clinical trials</kwd><kwd>Radionuclide imaging</kwd></kwd-group><funding-group><award-group><funding-source><institution>Quebec Bio-Imaging Network</institution></funding-source></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer Nature Limited 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par9">Engineered for cost-effectiveness, extended shelf life, and enhanced palatability, ultra-processed foods (UPF) often boast high levels of saturated fats, salt, and added sugar, coupled with a low fiber, vitamin and mineral content, elevated energy density, and include various cosmetic additives<sup><xref ref-type="bibr" rid="CR1">1</xref>,<xref ref-type="bibr" rid="CR2">2</xref></sup>. The consumption of UPF has been associated with a myriad of health problems, including obesity, hypertension, diabetes, dyslipidemia, hypertension, depression, cardiovascular diseases, various types of cancer, cognitive decline, and dementia<sup><xref ref-type="bibr" rid="CR3">3</xref>&#x02013;<xref ref-type="bibr" rid="CR11">11</xref></sup>. Despite these known risks, 50 to 60% of calories consumed by children and adults in North America are from UPF<sup><xref ref-type="bibr" rid="CR12">12</xref>&#x02013;<xref ref-type="bibr" rid="CR14">14</xref></sup>. Several hypotheses have been put forward to explain the detrimental effects of UPF, with evidence suggesting that the purpose of the processing or the methods themselves, beyond their nutritional composition, contribute to the associated health risks<sup><xref ref-type="bibr" rid="CR15">15</xref></sup>. However, the precise mechanisms underlying the adverse effects of ultra-processing remain incompletely understood.</p><p id="Par10">Endothelial dysfunction, recognized for its association with various cardiovascular diseases and metabolic syndrome, emerges as a potential mechanism behind the cardiovascular effects of UPF<sup><xref ref-type="bibr" rid="CR16">16</xref></sup>. Studies have demonstrated that a single high-fat meal leads to measurable impairment in endothelial function as measured by flow-mediated dilation on brachial ultrasonography as early as 2 h following consumption<sup><xref ref-type="bibr" rid="CR17">17</xref>&#x02013;<xref ref-type="bibr" rid="CR19">19</xref></sup>; however, no study evaluated the impact of food processing on myocardial endothelial function. Furthermore, beyond its cardiovascular ramifications, endothelial dysfunction has also been shown to impact neurocognitive health, revealing correlations with diminished performance in neuropsychological tests assessing executive functions and attention<sup><xref ref-type="bibr" rid="CR20">20</xref></sup>.</p><p id="Par11">The purpose of this randomized crossover study is three-fold. First, we aim at determining whether a single ultra-processed meal can lead to alterations in myocardial endothelial function as assessed by positron emission tomography/computed tomography (PET/CT), which allows accurate and reproducible quantification of myocardial blood flow (MBF)<sup><xref ref-type="bibr" rid="CR21">21</xref>,<xref ref-type="bibr" rid="CR22">22</xref></sup>. Second, we sought to determine whether a single ultra-processed meal can enhance the adenosine-induced MBF increase at intermediate adenosine dosage. Third, as an exploratory objective, we compared the effects of the two meal types on cognitive performances.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Study design</title><p id="Par12">Participants were enrolled in a single-center, open, randomized crossover trial during which they were randomly assigned to receive 1 of 2 meals and then crossed over to the other meal (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>). Participants were instructed to consume the same non-ultra-processed meal on the evening preceding both experimental visits according to provided standardized meal recipes. Participants were also instructed to follow a 12-h fast and to refrain from caffeine, alcoholic beverages, and strenuous physical activity for 24&#x000a0;h prior to experimental meal consumption. Approximately 60&#x000a0;min following each meal ingestion, neuropsychological testing was conducted. Rubidium PET/CT imaging was subsequently performed and analyzed by a certified nuclear medicine specialist blinded to all clinical information and randomization group. Each experimental visit was completed in a single day.</p><p id="Par13">
<fig id="Fig1"><label>Fig. 1</label><caption><p>Schematic representation of the study design. PET, positron emission tomography.</p></caption><graphic xlink:href="41598_2025_11734_Fig1_HTML" id="d33e396"/></fig>
</p></sec><sec id="Sec4"><title>Patient population</title><p id="Par14">Adult healthy male patients were recruited at the Montreal Heart Institute and at the Montreal Heart Institute Center for Preventive Medicine and Physical Activity (Centre EPIC). Only men were recruited to avoid endothelial function variations related to the hormonal cycle<sup><xref ref-type="bibr" rid="CR23">23</xref></sup>. Other inclusion criteria were age between 18 and 60 years and absence of cardiovascular symptoms. Exclusion criteria were the presence of cardiovascular disease, smoking within the past 12 months, resting blood pressure&#x02009;&#x0003e;&#x02009;140/60mmHg, renal failure with estimated glomerular filtration rate&#x02009;&#x0003c;&#x02009;90 mL/min/1.73m<sup>2</sup>, type 1 or 2 diabetes mellitus, dyslipidemia (defined as LDL&#x02009;&#x02265;&#x02009;3.5 mmol/L or ratio of total cholesterol/HDL&#x02009;&#x02265;&#x02009;5.0), left ventricular ejection fraction&#x02009;&#x0003c;&#x02009;50%, congenital heart disease, body mass index (BMI)&#x02009;&#x0003e;&#x02009;35&#x000a0;kg/m<sup>2</sup>, uncontrolled asthma, chronic obstructive pulmonary disease (COPD), known hypersensitivity to adenosine or dipyridamole, second degree Mobitz 2 or third-degree atrioventricular block (AVB), resting heart rate&#x02009;&#x0003c;&#x02009;40&#x000a0;bpm, chronic alcoholism, drug abuse, statin or beta-blocker use, claustrophobia, neurocognitive disorder or medication affecting cognition. Eligibility was assessed at a preliminary visit during which participants underwent a medical evaluation that included a complete medical history and physical examination. Sitting blood pressure, heart rate, waist circumference, body weight and body fat percentage (BFP) were measured. Blood work was also completed if it had not been performed in the 3 months preceding recruitment. It included serum glucose, lipid profile, serum creatinine, serum insulin, C-reactive protein (CRP) and glycated hemoglobin test (HbA1C). Finally, a baseline electrocardiogram (ECG) was performed. All experiments were conducted in accordance with the Declaration of Helsinki and approved by the Montreal Heart Institute research ethics board approved the study protocol (#2021&#x02013;2720). All participants provided signed informed consent.</p></sec><sec id="Sec5"><title>Intervention</title><p id="Par15">The NOVA classification is used to categorize foods based on the type of processing, dividing foods into 4 groups: unprocessed or minimally processed foods (NOVA 1), processed culinary ingredients (NOVA 2), processed foods (NOVA 3) and ultra-processed foods (NOVA 4)<sup><xref ref-type="bibr" rid="CR24">24</xref></sup>. The standardized non-ultra-processed meal consisted exclusively of foods from NOVA groups 1 to 3 (labeled NOVA 1&#x02013;3) and was prepared at the hospital kitchen, while the ultra-processed meal contained foods from NOVA groups 1 to 4 (labeled NOVA 4) and was prepared in a fast-food restaurant chain. Both meals had similar amounts of lipids, carbohydrates, proteins, and calories (Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>). Subjects were instructed to consume the meals provided in their entirety in less than 15&#x000a0;min.</p><p id="Par16">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Composition and macronutrient content of test meals.</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">Calories</th><th align="left">Lipids</th><th align="left">Carbohydrates</th><th align="left">Proteins</th></tr></thead><tbody><tr><td align="left" colspan="5"><italic>Non-ultra-processed meal (NOVA 1&#x02013;3</italic>)</td></tr><tr><td align="left">Cooked oatmeal (175mL)</td><td align="left" rowspan="6">522&#x000a0;kcal</td><td align="left" rowspan="6">24&#x000a0;g</td><td align="left" rowspan="6">61.5&#x000a0;g</td><td align="left" rowspan="6">19&#x000a0;g</td></tr><tr><td align="left">&#x000bd; cup of blueberries</td></tr><tr><td align="left">&#x000bd; banana</td></tr><tr><td align="left">&#x000bc; cup of walnuts</td></tr><tr><td align="left">Cow milk (175 mL)</td></tr><tr><td align="left">Maple syrup (5 mL)</td></tr><tr><td align="left" colspan="5">
<italic>Ultra-processed meal (NOVA 4)</italic>
</td></tr><tr><td align="left">English muffin egg sandwich with bacon</td><td align="left" rowspan="3">608&#x000a0;kcal</td><td align="left" rowspan="3">29&#x000a0;g</td><td align="left" rowspan="3">70&#x000a0;g</td><td align="left" rowspan="3">19&#x000a0;g</td></tr><tr><td align="left">1 hashbrown</td></tr><tr><td align="left">Orange juice (200mL)</td></tr></tbody></table></table-wrap>
</p></sec><sec id="Sec6"><title>PET imaging</title><p id="Par17">MBF was measured using rubidium-chloride (<sup>82</sup>Rb) on a Siemens Biograph mCT Flow PET/CT scanner with time-of-flight capabilities. Approximately 225&#x000a0;min after each experimental meal, three rubidium PET scans were performed: (1) a baseline acquisition; (2) a scan with an intermediate adenosine dose of 80&#x000a0;&#x000b5;g/kg/min infused over 6&#x000a0;min; and (3) a scan with a high adenosine dose of 140&#x000a0;&#x000b5;g/kg/min infused over 6&#x000a0;min<sup><xref ref-type="bibr" rid="CR25">25</xref>,<xref ref-type="bibr" rid="CR26">26</xref></sup>. There was a resting period of at least 10&#x000a0;min between the two adenosine acquisitions. For each scan, an intravenous injection of 10 MBq/kg of <sup>82</sup>Rb was administered over 30&#x02009;s using a commercial rubidium generator and elution system (Rubyfill, Jubilant Radiopharma, Kirkland, Canada) and simultaneous list-mode PET was acquired over a period of 6&#x000a0;min<sup><xref ref-type="bibr" rid="CR26">26</xref></sup>. For adenosine acquisitions, <sup>82</sup>Rb injection and imaging started 3&#x000a0;min after the beginning of the adenosine infusion. Prior to the baseline PET acquisition, a low-dose CT scan was performed for attenuation correction purposes. Global MBF quantification, encompassing all myocardial regions, was done using Corridor4DM (INVIA Medical Imaging Solutions, Ann Arbor, Michigan, USA), which relies on one-tissue-compartment model with flow-dependent extraction correction<sup><xref ref-type="bibr" rid="CR27">27</xref></sup> Iterative reconstruction of the rest and pharmacological stress acquisitions was performed using the ordered subsets expectation maximization (OSEM) algorithm with point spread function (PSF) modeling and time-of-flight (TOF) information, employing 3 iterations and 21 subsets with the following time frames: 12&#x02009;&#x000d7;&#x02009;5&#x000a0;s, 6&#x02009;&#x000d7;&#x02009;10&#x000a0;s, 4&#x02009;&#x000d7;&#x02009;20&#x000a0;s, and 4&#x02009;&#x000d7;&#x02009;40&#x000a0;s. Motion correction was performed manually using the tools available in Corridor4DM (INVIA), by visually aligning the dynamic frames to the displayed LV contours. When misalignment of tracer activity was observed, rigid translation adjustments were applied to individual frames to ensure proper alignment with the myocardial contours. The quality of correction was assessed visually by verifying that the tracer activity was symmetrically aligned with the left ventricular geometry across the dynamic sequence.</p></sec><sec id="Sec7"><title>Neuropsychological testing</title><p id="Par18">Paper and pencil neuropsychological tests and tablet-based cognitive tasks were administered following each meal consumption in a fixed order. Key components of cognition were assessed: episodic memory (Rey Auditory Verbal Learning Test [RAVLT])<sup><xref ref-type="bibr" rid="CR28">28</xref></sup>&#x000a0;processing speed (Coding of the WAIS-IV, Stroop, Trail Making Test A)<sup><xref ref-type="bibr" rid="CR29">29</xref>&#x02013;<xref ref-type="bibr" rid="CR31">31</xref></sup>&#x000a0;and executive functions (Stroop and Verbal Fluency from the D-KEFS, Trail Making Test B)<sup><xref ref-type="bibr" rid="CR29">29</xref>&#x02013;<xref ref-type="bibr" rid="CR32">32</xref></sup>. In addition, participants also completed tablet-based executive functions assessments (Neuropeak platform developed by Dr. Bherer&#x02019;s laboratory)<sup><xref ref-type="bibr" rid="CR33">33</xref></sup>: dual-tasking (divided attention) and n-back (updating and working memory).</p></sec><sec id="Sec8"><title>Randomization</title><p id="Par19">A research assistant conducted block randomization using a MATLAB script to generate random allocation before the start of the study. Subsequently, participants were assigned by the research assistant to the appropriate intervention according to the predetermined allocation sequence after their recruitment. Investigators were blinded to the allocation sequence. By design, the research assistant and participants were not blinded to the allocation sequence (meal type/order). The investigators assessing the outcomes (both imaging and neuropsychological testing) were blinded to the allocation sequence and interventions.</p></sec><sec id="Sec9"><title>Statistical analysis</title><p id="Par20">Two-way repeated-measures analysis of variance (ANOVA) for crossover study was conducted to compare MBF, MFR, glycemia and cognitive performances following the two meals. The analysis included Treatment (meal), Period (visit), and Sequence (order of meal) of both visits as fixed effects, and Sequence assignment as a random effect. Numbers and percentages are presented for categorical variables. The mean, standard deviation, median, and range are presented for continuous variables. A multiple linear regression analysis was performed to determine the relationship between clinical variables and the relative difference of MBF at intermediate-dose adenosine between the meals. Paired t-tests were performed to compare hemodynamic parameters. All statistical analyses were two-tailed, and <italic>p</italic> values of &#x0003c;&#x02009;0.05 were considered statistically significant. All analyses were performed using SPSS (IBM Corp. Released 2020. IBM SPSS Statistics for Macintosh, Version 27.0.1.0. Armonk, NY: IBM Corp.) and SAS statistical software version 9.4 (SAS Institute Inc., Cary, NC. Released 2013.). Graphics were produced using GraphPad Prism (GraphPad Software for Windows, Version 10.1.2).</p><p id="Par21">The primary endpoint of this study is MBF at high adenosine dosage. As this is a two-group crossover study, the primary endpoint will be measured twice for the same patient, and the correlation between the two measurements must be accounted for. We examined correlations ranging from 0.4 to 0.6, which produced standard deviations of differences of 0.351 and 0.286, respectively (using a standard deviation of 0.32 for both groups)<sup><xref ref-type="bibr" rid="CR34">34</xref>,<xref ref-type="bibr" rid="CR35">35</xref></sup>. For our sample size calculation, we used a standard deviation of differences equal to 0.30. Setting the significance level at 0.05, a total of 20 patients will allow us to detect a difference of 0.2 mL/min/g (a standardized effect size of 0.67) with a power of 80%. Previous studies, however, have demonstrated differences in hyperemic blood flow of the order of 0.2&#x02013;0.7 mL/min/g following various interventions affecting endothelial function<sup><xref ref-type="bibr" rid="CR35">35</xref>&#x02013;<xref ref-type="bibr" rid="CR38">38</xref></sup>. (ClinicalTrials.gov: NCT06353009, 08/04/2024)</p></sec></sec><sec id="Sec10"><title>Results</title><sec id="Sec11"><title>Population characteristics</title><p id="Par22">Out of 17 participants assessed for eligibility between May of 2021 and April of 2023, two were excluded because of LDL cholesterol&#x02009;&#x02265;&#x02009;3.5 mmol/L. Consent was obtained from all the remaining 15 participants who were randomized and imaged. One participant was excluded because of a significant weight loss between both experimental visits, resulting in a significant change in the adenosine dosage that was administered. The characteristics of the remaining 14 participants are shown in Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>, with 7/14 participants assigned to each meal sequence. The mean age was 31&#x02009;&#x000b1;&#x02009;11 years. The mean waist circumference and BMI were 88&#x02009;&#x000b1;&#x02009;8&#x000a0;cm and 25.0&#x02009;&#x000b1;&#x02009;2.8&#x000a0;kg/m<sup>2</sup>, respectively. Baseline screening blood tests and ECG were unremarkable for the 14 participants included (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). Recruitment was halted before reaching the target due to significant challenges posed by the COVID-19 pandemic, which severely impacted participant enrollment, and prolonged delays that led to increased costs.</p><p id="Par23">
<table-wrap id="Tab2"><label>Table 2</label><caption><p>Baseline characteristics of all included participants.</p></caption><table frame="hsides" rules="groups"><tbody><tr><td align="left" colspan="2">Participants&#x02019; characteristics (<italic>n</italic>&#x02009;=&#x02009;14)</td></tr><tr><td align="left">&#x000a0;Age (years), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">31&#x02009;&#x000b1;&#x02009;11</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">29 (22&#x02013;60)</td></tr><tr><td align="left">&#x000a0;Alcohol consumption, n (%)</td><td align="left">2 (14.3)</td></tr><tr><td align="left">&#x000a0;Alcohol, quantity per week (#) mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">2&#x02009;&#x000b1;&#x02009;3</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">2 (0&#x02013;10)</td></tr><tr><td align="left">&#x000a0;SBP (mmHg), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">129&#x02009;&#x000b1;&#x02009;10</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">132 (112&#x02013;139)</td></tr><tr><td align="left">&#x000a0;DBP (mmHg), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">76&#x02009;&#x000b1;&#x02009;5</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">62 (46&#x02013;82)</td></tr><tr><td align="left">&#x000a0;HR (bpm), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">64&#x02009;&#x000b1;&#x02009;10</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">62 (46&#x02013;82)</td></tr><tr><td align="left">&#x000a0;Mass (kg), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">79.7&#x02009;&#x000b1;&#x02009;9.0</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">77.7 (67.4-101.3)</td></tr><tr><td align="left">&#x000a0;BFP (%), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">19.4&#x02009;&#x000b1;&#x02009;6.2</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">20.7 (8.2&#x02013;30.0)</td></tr><tr><td align="left">&#x000a0;Height (cm), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">179&#x02009;&#x000b1;&#x02009;6</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">179 (168&#x02013;188)</td></tr><tr><td align="left">&#x000a0;BMI (kg/m<sup>2</sup>), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">25.0&#x02009;&#x000b1;&#x02009;2.8</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">25.8 (20.7&#x02013;29.5)</td></tr><tr><td align="left">&#x000a0;Waist circumference (cm), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">88&#x02009;&#x000b1;&#x02009;8</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">89 (73&#x02013;101)</td></tr><tr><td align="left" colspan="2">Baseline ECG findings</td></tr><tr><td align="left">&#x000a0;HR (bpm), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">63&#x02009;&#x000b1;&#x02009;10</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">61 (46&#x02013;82)</td></tr><tr><td align="left">&#x000a0;QRS (ms), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">91&#x02009;&#x000b1;&#x02009;18</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">94 (46&#x02013;116)</td></tr><tr><td align="left">&#x000a0;PR (ms), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">153&#x02009;&#x000b1;&#x02009;28</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">151 (96&#x02013;218)</td></tr><tr><td align="left">&#x000a0;QTc (ms), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">398&#x02009;&#x000b1;&#x02009;22</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">398 (375&#x02013;454)</td></tr><tr><td align="left">&#x000a0;LBBB, n (%)</td><td align="left">0 (0.0)</td></tr><tr><td align="left">&#x000a0;RBBB, n (%)</td><td align="left">1 (7.1)</td></tr><tr><td align="left">&#x000a0;LPFB, n (%)</td><td align="left">3 (21.4)</td></tr><tr><td align="left">&#x000a0;LAFB, n (%)</td><td align="left">1 (7.1)</td></tr><tr><td align="left">&#x000a0;1st-degree AVB, n (%)</td><td align="left">1 (7.1)</td></tr><tr><td align="left">&#x000a0;2nd-degree Mobitz 1, n (%)</td><td align="left">0 (0.0)</td></tr><tr><td align="left">&#x000a0;2nd-degree Mobitz 2, n (%)</td><td align="left">0 (0.0)</td></tr><tr><td align="left">&#x000a0;3rd-degree AVB, n (%)</td><td align="left">0 (0.0)</td></tr><tr><td align="left" colspan="2">Laboratory tests</td></tr><tr><td align="left">&#x000a0;Creatinine (mmol/L), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">84&#x02009;&#x000b1;&#x02009;11</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">84 (66&#x02013;108)</td></tr><tr><td align="left">&#x000a0;Total cholesterol (mmol/L), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">4.1&#x02009;&#x000b1;&#x02009;0.7</td></tr><tr><td align="left">&#x000a0;&#x000a0;Median (min, max)</td><td align="left">4.0 (2.7&#x02013;5.2)</td></tr><tr><td align="left">&#x000a0;HDL (mmol/L), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">1.39&#x02009;&#x000b1;&#x02009;0.33</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">1.28 (0.98&#x02013;2.23)</td></tr><tr><td align="left">&#x000a0;LDL (mmol/L), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">2.26&#x02009;&#x000b1;&#x02009;0.51</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">2.2 (1.5&#x02013;3.3)</td></tr><tr><td align="left">&#x000a0;Non-HDL (mmol/L), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">2.72&#x02009;&#x000b1;&#x02009;0.597</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">2.65(1.63&#x02013;3.91)</td></tr><tr><td align="left">&#x000a0;Triglycerides (mmol/L), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">1.00&#x02009;&#x000b1;&#x02009;0.43</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">0.99 (0.38&#x02013;1.65)</td></tr><tr><td align="left">&#x000a0;Insulin (pmol/L), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">65.4&#x02009;&#x000b1;&#x02009;24.2</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">56 (38&#x02013;116)</td></tr><tr><td align="left">&#x000a0;CRP (mg/L), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">0.82&#x02009;&#x000b1;&#x02009;0.50</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">0.71 (0.16&#x02013;1.6)</td></tr><tr><td align="left">&#x000a0;HbA1C, mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">0.052&#x02009;&#x000b1;&#x02009;0.0035</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">0.052 (0.016&#x02013;0.058)</td></tr><tr><td align="left">&#x000a0;Glycemia (mmol/L), mean&#x02009;&#x000b1;&#x02009;SD</td><td align="left">5.2&#x02009;&#x000b1;&#x02009;0.5</td></tr><tr><td align="left">&#x000a0;Median (min, max)</td><td align="left">5.2 (4.0&#x02013;6.0)</td></tr></tbody></table><table-wrap-foot><p>CRP, C-reactive protein; BFP, body fat percentage; BMI, body mass index; DBP, diastolic blood pressure; HDL, high-density lipoprotein; HR, heart rate; LDL, low-density lipoprotein; LAFB, left anterior fascicular block; LBBB, left bundle branch block; LPFB, left posterior fascicular block; RBBB, right bundle branch block; SBP, systolic blood pressure.</p></table-wrap-foot></table-wrap>
</p></sec><sec id="Sec12"><title>Hemodynamics</title><p id="Par24">At baseline, heart rate (55&#x02009;&#x000b1;&#x02009;9 vs. 59&#x02009;&#x000b1;&#x02009;6 bpm, <italic>p</italic>&#x02009;=&#x02009;0.20), systolic blood pressure (120&#x02009;&#x000b1;&#x02009;12 vs. 114&#x02009;&#x000b1;&#x02009;11 mmHg, <italic>p</italic>&#x02009;=&#x02009;0.16) and diastolic blood pressure (55&#x02009;&#x000b1;&#x02009;8 vs. 59&#x02009;&#x000b1;&#x02009;7 mmHg, <italic>p</italic>&#x02009;=&#x02009;0.18) were not significantly different between the NOVA 1&#x02013;3 and NOVA 4 meals, respectively. There were no statistically significant differences in hemodynamic parameters between the first and second experimental visits.</p></sec><sec id="Sec13"><title>ECG changes during adenosine administration</title><p id="Par25">Two participants developed sinus bradycardia (&#x0003c;&#x02009;40&#x000a0;bpm), while two others exhibited first-degree AVB. Two participants experienced second-degree AVB Mobitz type 2, one following the NOVA 4 meal and the other following the NOVA 1&#x02013;3 meal, both after the administration of high-dose adenosine. All recorded bradyarrhythmia resolved spontaneously shortly following the end of the adenosine infusion and did not result in hemodynamic instability.</p></sec><sec id="Sec14"><title>Myocardial blood flow</title><p id="Par26">In all subjects, MBF at maximal pharmacological stress following both experimental meals was within the normal range per guidelines (&#x02265;&#x02009;2.0)<sup><xref ref-type="bibr" rid="CR39">39</xref></sup>.Two-way crossover ANOVA analysis was carried out to examine the Treatment, Period, and Sequence effects on MBF and MFR. All performed analyses had no statistically significant carry-over effect (Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>). MBF at intermediate-dose adenosine was significantly greater after the NOVA 4 meal compared to the NOVA 1&#x02013;3 meal (1.62 vs. 1.22 mL/min/g, F[1, 12]&#x02009;=&#x02009;8.12, <italic>p</italic>&#x02009;=&#x02009;0.015), with a mean relative difference of 40.7% (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>). There was no statistically significant difference in MBF at baseline (F[1, 12]&#x02009;=&#x02009;0.10, <italic>p</italic>&#x02009;=&#x02009;0.758) and at high-dose adenosine (F[1, 12]&#x02009;=&#x02009;0.24, <italic>p</italic>&#x02009;=&#x02009;0.634) between the two meals. MFR at intermediate-dose adenosine was greater after the NOVA 4 meal compared to the NOVA 1&#x02013;3 meal (2.43 vs. 1.88, F[1, 12]&#x02009;=&#x02009;8.81, <italic>p</italic>&#x02009;=&#x02009;0.012), whereas there was no statistically significant difference at high-dose adenosine (F[1, 12]&#x02009;=&#x02009;0.02, <italic>p</italic>&#x02009;=&#x02009;0.887).</p><p id="Par27">
<table-wrap id="Tab3"><label>Table 3</label><caption><p>Two-way ANOVA for crossover study analysis of myocardial blood flow (MBF) and myocardial flow reserve (MFR) (<italic>n</italic>&#x02009;=&#x02009;14).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2"/><th align="left" rowspan="2">NOVA 1&#x02013;3</th><th align="left" rowspan="2">NOVA 4</th><th align="left" colspan="3"><italic>p</italic> value</th></tr><tr><th align="left">Treatment</th><th align="left">Period</th><th align="left">Sequence</th></tr></thead><tbody><tr><td align="left" colspan="6">MBF (mL/min/g) (means)</td></tr><tr><td align="left">&#x000a0;Baseline</td><td char="." align="char">0.65</td><td char="." align="char">0.66</td><td char="." align="char">0.7582</td><td char="." align="char">0.0334</td><td char="." align="char">0.8356</td></tr><tr><td align="left">&#x000a0;Intermediate</td><td char="." align="char">1.22</td><td char="." align="char">1.62</td><td char="." align="char">0.0147</td><td char="." align="char">0.0636</td><td char="." align="char">0.8765</td></tr><tr><td align="left">&#x000a0;High</td><td char="." align="char">2.81</td><td char="." align="char">2.90</td><td char="." align="char">0.6339</td><td char="." align="char">0.4508</td><td char="." align="char">0.6454</td></tr><tr><td align="left" colspan="6">MFR (means)</td></tr><tr><td align="left">&#x000a0;Intermediate</td><td char="." align="char">1.88</td><td char="." align="char">2.43</td><td char="." align="char">0.0117</td><td char="." align="char">0.0023</td><td char="." align="char">0.5697</td></tr><tr><td align="left">&#x000a0;High</td><td char="." align="char">4.40</td><td char="." align="char">4.46</td><td char="." align="char">0.8869</td><td char="." align="char">0.3710</td><td char="." align="char">0.7416</td></tr></tbody></table></table-wrap>
</p><p id="Par28">
<fig id="Fig2"><label>Fig. 2</label><caption><p>(<bold>A</bold>) Myocardial blood flow (MBF) and (<bold>B</bold>) myocardial flow reserve (MFR) at baseline and during intermediate and high adenosine. ns indicates not significant.</p></caption><graphic xlink:href="41598_2025_11734_Fig2_HTML" id="d33e1088"/></fig>
</p><p id="Par29">There was a significant Period effect for MBF at baseline (F[1, 12]&#x02009;=&#x02009;5.77, <italic>p</italic>&#x02009;=&#x02009;0.033) and MFR at intermediate-dose adenosine (F[1, 12]&#x02009;=&#x02009;14.82, <italic>p</italic>&#x02009;=&#x02009;0.002), but not with MBF at intermediate (F[1, 12]&#x02009;=&#x02009;4.18, <italic>p</italic>&#x02009;=&#x02009;0.064), MBF at high-dose adenosine (F[1, 12]&#x02009;=&#x02009;0.61, <italic>p</italic>&#x02009;=&#x02009;0.451) and MFR at high-dose adenosine (<italic>p</italic>&#x02009;=&#x02009;0.371). MBF at baseline was greater at the first visit compared to the second visit (0.70&#x02009;&#x000b1;&#x02009;0.13 vs. 0.61&#x02009;&#x000b1;&#x02009;0.08 mL/min/g), resulting in a lower MFR at intermediate-dose adenosine at the first visit compared to the second visit.</p><p id="Par30">Multiple linear regression analysis was conducted to assess which variables were associated with greater differences in MBF at intermediate-dose adenosine between the two meals. Age (<italic>p</italic>&#x02009;=&#x02009;0.144), BMI (<italic>p</italic>&#x02009;=&#x02009;0.392), BFP (<italic>p</italic>&#x02009;=&#x02009;0.419), waist circumference (<italic>p</italic>&#x02009;=&#x02009;0.297), triglycerides levels (<italic>p</italic>&#x02009;=&#x02009;0.257), and LDL cholesterol levels (<italic>p</italic>&#x02009;=&#x02009;0.442) were not significant predictors of greater MBF relative differences at intermediate-dose adenosine.</p></sec><sec id="Sec15"><title>Cognitive performances</title><p id="Par31">Data from two participants were excluded from the analyses because their age range differed significantly from that of the sample (over 50 years old), as age influences cognitive performances. Hence, the total sample included 12 participants for paper-and-pencil tests. For one of the tablet-based tasks (n-back), data was missing for one participant.</p><p id="Par32">For paper-and-pencil tests, repeated-measures ANOVA were conducted with Treatment as within-subject variable and Sequence as between-subject variable, to determine potential learning/carry-over effects on the tests. First, no main effect of Treatment (meal type) was observed, with the exception for a trend on the Coding test, with participants producing more symbols following the NOVA 4 meal (NOVA 1&#x02013;3, 82.46&#x02009;&#x000b1;&#x02009;5.07 vs. NOVA 4, 85.47&#x02009;&#x000b1;&#x02009;4.98, <italic>F</italic>[1,10]&#x02009;=&#x02009;3.88, <italic>p</italic>&#x02009;=&#x02009;0.077). Sequence &#x000d7; Treatment interactions were significant for most tests, which suggests different Period effects among both Sequence groups because performances were generally worse following the NOVA-4 meal when consumed at Period 1 (Table&#x000a0;<xref rid="Tab4" ref-type="table">4</xref>). Performances on paper-and-pencil tests for participants from both Sequence groups were compared on their first testing period: NOVA 1&#x02013;3 for Sequence 1 Vs NOVA 4 for Sequence 2. No significant differences were observed on either test for this analysis.</p><p id="Par33">
<table-wrap id="Tab4"><label>Table 4</label><caption><p>Performance presented as means on paper-and-pencil results according to sequence and treatment (<italic>n</italic>&#x02009;=&#x02009;12).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2"/><th align="left" colspan="2">Sequence 1</th><th align="left" colspan="2">Sequence 2</th><th align="left">Treatment</th><th align="left" rowspan="2">Sequence &#x000d7; Treatment</th></tr><tr><th align="left">Period 1 (NOVA 1&#x02013;3)</th><th align="left">Period 2 (NOVA 4)</th><th align="left">Period 1 (NOVA 4)</th><th align="left">Period 2 (NOVA 1&#x02013;3)</th><th align="left"><italic>p</italic> value</th></tr></thead><tbody><tr><td align="left">RAVLT Total 1&#x02013;5</td><td char="&#x000b1;" align="char">51&#x02009;&#x000b1;&#x02009;10.44</td><td char="&#x000b1;" align="char">62.6&#x02009;&#x000b1;&#x02009;7.44</td><td char="&#x000b1;" align="char">55.14&#x02009;&#x000b1;&#x02009;5.46</td><td char="&#x000b1;" align="char">63&#x02009;&#x000b1;&#x02009;2.00</td><td char="." align="char">0.304</td><td char="." align="char">&#x0003c;&#x02009;0.001</td></tr><tr><td align="left">RAVLT Delayed</td><td char="&#x000b1;" align="char">11&#x02009;&#x000b1;&#x02009;3.54</td><td char="&#x000b1;" align="char">13.2&#x02009;&#x000b1;&#x02009;2.17</td><td char="&#x000b1;" align="char">12.43&#x02009;&#x000b1;&#x02009;1.72</td><td char="&#x000b1;" align="char">13.29&#x02009;&#x000b1;&#x02009;1.11</td><td char="." align="char">0.265</td><td char="." align="char">0.023</td></tr><tr><td align="left">TMT A (s)</td><td char="&#x000b1;" align="char">27.3&#x02009;&#x000b1;&#x02009;9.86</td><td char="&#x000b1;" align="char">21.25&#x02009;&#x000b1;&#x02009;6.49</td><td char="&#x000b1;" align="char">29.03&#x02009;&#x000b1;&#x02009;12.31</td><td char="&#x000b1;" align="char">24.75&#x02009;&#x000b1;&#x02009;10.99</td><td char="." align="char">0.727</td><td char="." align="char">0.061</td></tr><tr><td align="left">TMT B (s)</td><td char="&#x000b1;" align="char">57.26&#x02009;&#x000b1;&#x02009;17.98</td><td char="&#x000b1;" align="char">51.89&#x02009;&#x000b1;&#x02009;21.15</td><td char="&#x000b1;" align="char">62.95&#x02009;&#x000b1;&#x02009;15.21</td><td char="&#x000b1;" align="char">54.84&#x02009;&#x000b1;&#x02009;28.06</td><td char="." align="char">0.793</td><td char="." align="char">0.215</td></tr><tr><td align="left">Stroop Naming (s)</td><td char="&#x000b1;" align="char">31.36&#x02009;&#x000b1;&#x02009;9.03</td><td char="&#x000b1;" align="char">30.4&#x02009;&#x000b1;&#x02009;9.26</td><td char="&#x000b1;" align="char">33&#x02009;&#x000b1;&#x02009;7.36</td><td char="&#x000b1;" align="char">31.92&#x02009;&#x000b1;&#x02009;6.72</td><td char="." align="char">0.953</td><td char="." align="char">0.328</td></tr><tr><td align="left">Stroop Reading (s)</td><td char="&#x000b1;" align="char">21.15&#x02009;&#x000b1;&#x02009;3.52</td><td char="&#x000b1;" align="char">18.85&#x02009;&#x000b1;&#x02009;3.72</td><td char="&#x000b1;" align="char">22.99&#x02009;&#x000b1;&#x02009;4.98</td><td char="&#x000b1;" align="char">20.71&#x02009;&#x000b1;&#x02009;3.46</td><td char="." align="char">0.975</td><td char="." align="char">0.003</td></tr><tr><td align="left">Stroop Inhibition (s)</td><td char="&#x000b1;" align="char">50&#x02009;&#x000b1;&#x02009;11.62</td><td char="&#x000b1;" align="char">49.44&#x02009;&#x000b1;&#x02009;14.19</td><td char="&#x000b1;" align="char">54.97&#x02009;&#x000b1;&#x02009;20.57</td><td char="&#x000b1;" align="char">49.52&#x02009;&#x000b1;&#x02009;9.88</td><td char="." align="char">0.485</td><td char="." align="char">0.393</td></tr><tr><td align="left">Stroop Switching (s)</td><td char="&#x000b1;" align="char">52.87&#x02009;&#x000b1;&#x02009;10.22</td><td char="&#x000b1;" align="char">48.64&#x02009;&#x000b1;&#x02009;13.15</td><td char="&#x000b1;" align="char">61.63&#x02009;&#x000b1;&#x02009;11.41</td><td char="&#x000b1;" align="char">54.73&#x02009;&#x000b1;&#x02009;9.63</td><td char="." align="char">0.557</td><td char="." align="char">0.034</td></tr><tr><td align="left">Coding (symbols)</td><td char="&#x000b1;" align="char">76.2&#x02009;&#x000b1;&#x02009;15.16</td><td char="&#x000b1;" align="char">89.8&#x02009;&#x000b1;&#x02009;14.45</td><td char="&#x000b1;" align="char">81.14&#x02009;&#x000b1;&#x02009;18.50</td><td char="&#x000b1;" align="char">88.71&#x02009;&#x000b1;&#x02009;18.61</td><td char="." align="char">0.077</td><td char="." align="char">&#x0003c;&#x02009;0.001</td></tr></tbody></table></table-wrap>
</p><p id="Par34">For tablet-based tests, there were no significant main effects or interaction effects in reaction time or error rate on the N-Back task. In the dual-task, Trial Type (Single-Pure, Single-Mixed and Dual-Mixed) was added as a within-subject variable, to analyze specific attentional costs by contrasting the different dual-task conditions (Table&#x000a0;<xref rid="Tab5" ref-type="table">5</xref>). First, reaction time analyses showed no main effect of Treatment or Sequence, but a significant Sequence &#x000d7; Treatment interaction was observed (<italic>F</italic>[2, 20]&#x02009;=&#x02009;6.494, <italic>p</italic>&#x02009;=&#x02009;0.029). This effect was qualified by a Sequence &#x000d7; Treatment X Trial Type interaction (<italic>F</italic>[2, 20]&#x02009;=&#x02009;11.094, <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). Repeated-contrast analyses showed that the Sequence &#x000d7; Treatment interaction was significant only when comparing dual-mixed vs. single-mixed trials (<italic>F</italic>[1, 10]&#x02009;=&#x02009;8.71, <italic>p</italic>&#x02009;=&#x02009;0.015), which reflects dual-task cost, the cost of coordinating multiple tasks. This interaction was due to a larger dual-task cost when the NOVA-4 meal was consumed in the first period (Sequence 2), compared to when it was consumed in the second period (Sequence 1) (<italic>F</italic>[1,10]&#x02009;=&#x02009;5.59, <italic>p</italic>&#x02009;=&#x02009;0.040, Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>).</p><p id="Par35">
<table-wrap id="Tab5"><label>Table 5</label><caption><p>Performances on the dual-task according per trial type, sequence, and treatment (<italic>n</italic>&#x02009;=&#x02009;12).</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2"/><th align="left" colspan="2">Sequence 1</th><th align="left" colspan="2">Sequence 2</th></tr><tr><th align="left">Period 1 (NOVA 1&#x02013;3)</th><th align="left">Period 2 (NOVA 4)</th><th align="left">Period 1 (NOVA 4)</th><th align="left">Period 2 (NOVA 1&#x02013;3)</th></tr></thead><tbody><tr><td align="left">Single-pure (ms)</td><td char="&#x000b1;" align="char">706.50&#x02009;&#x000b1;&#x02009;106.29</td><td char="&#x000b1;" align="char">706.60&#x02009;&#x000b1;&#x02009;114.51</td><td char="&#x000b1;" align="char">726.50&#x02009;&#x000b1;&#x02009;106.41</td><td char="&#x000b1;" align="char">720.14&#x02009;&#x000b1;&#x02009;89.77</td></tr><tr><td align="left">Single-mixed (ms)</td><td char="&#x000b1;" align="char">964.40&#x02009;&#x000b1;&#x02009;211.15</td><td char="&#x000b1;" align="char">895.50&#x02009;&#x000b1;&#x02009;140.33</td><td char="&#x000b1;" align="char">968.21&#x02009;&#x000b1;&#x02009;161.19</td><td char="&#x000b1;" align="char">935.57&#x02009;&#x000b1;&#x02009;150.91</td></tr><tr><td align="left">Dual-mixed (ms)</td><td char="&#x000b1;" align="char">1523.00&#x02009;&#x000b1;&#x02009;244.51</td><td char="&#x000b1;" align="char">1398.80&#x02009;&#x000b1;&#x02009;189.45</td><td char="&#x000b1;" align="char">1653.50&#x02009;&#x000b1;&#x02009;246.06</td><td char="&#x000b1;" align="char">1557.93&#x02009;&#x000b1;&#x02009;222.25</td></tr><tr><td align="left">Single-pure (% errors)</td><td char="&#x000b1;" align="char">1.25&#x02009;&#x000b1;&#x02009;1.86</td><td char="&#x000b1;" align="char">1.25&#x02009;&#x000b1;&#x02009;1.86</td><td char="&#x000b1;" align="char">2.98&#x02009;&#x000b1;&#x02009;2.03</td><td char="&#x000b1;" align="char">0.89&#x02009;&#x000b1;&#x02009;1.11</td></tr><tr><td align="left">Single-mixed (% errors)</td><td char="&#x000b1;" align="char">0.59&#x02009;&#x000b1;&#x02009;0.81</td><td char="&#x000b1;" align="char">0.29&#x02009;&#x000b1;&#x02009;0.69</td><td char="&#x000b1;" align="char">1.89&#x02009;&#x000b1;&#x02009;1.64</td><td char="&#x000b1;" align="char">1.68&#x02009;&#x000b1;&#x02009;1.98</td></tr><tr><td align="left">Dual-mixed (% errors)</td><td char="&#x000b1;" align="char">0.78&#x02009;&#x000b1;&#x02009;0.56</td><td char="&#x000b1;" align="char">0.79&#x02009;&#x000b1;&#x02009;0.74</td><td char="&#x000b1;" align="char">0.56&#x02009;&#x000b1;&#x02009;0.60</td><td char="&#x000b1;" align="char">0.49&#x02009;&#x000b1;&#x02009;0.28</td></tr></tbody></table></table-wrap>
</p><p id="Par36">
<fig id="Fig3"><label>Fig. 3</label><caption><p>Attentional costs on the tablet-based dual-task according to treatment and sequence. DTC, dual-task cost; TSC, task-set cost.</p></caption><graphic xlink:href="41598_2025_11734_Fig3_HTML" id="d33e1466"/></fig>
</p><p id="Par37">For errors on the dual-task, a main effect of Treatment was observed (<italic>F</italic>[1, 10]&#x02009;=&#x02009;5.492, <italic>p</italic>&#x02009;=&#x02009;0.041), showing overall a greater percentage of errors following the NOVA 4 meal (1.3%) vs. the NOVA 1&#x02013;3 meal (0.9%). A significant Sequence &#x000d7; Treatment interaction was also observed (<italic>F</italic>[1,10]&#x02009;=&#x02009;9.026, <italic>p</italic>&#x02009;=&#x02009;0.013). This was reflected by a larger Treatment effect in Sequence 2, when NOVA 4 was consumed first (NOVA 4: 1.8% vs. NOVA 1&#x02013;3: 1.0%) than in Sequence 1 (NOVA 4: 0.8% vs. NOVA 1&#x02013;3: 0.9%) (Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>).</p><p id="Par38">
<fig id="Fig4"><label>Fig. 4</label><caption><p>Errors on the tablet-based dual-task according to treatment and sequence.</p></caption><graphic xlink:href="41598_2025_11734_Fig4_HTML" id="d33e1493"/></fig>
</p></sec></sec><sec id="Sec16"><title>Discussion</title><p id="Par39">In this randomized crossover study, we found that a single ultra-processed meal significantly enhanced MBF at an intermediate dose of adenosine compared to a minimally processed meal with matched macronutrient content. This suggests that food processing,&#x000a0;independent of lipid, carbohydrate, protein, or caloric composition,&#x000a0;may acutely modulate purinergic signaling. No differences were observed at baseline or under high-dose adenosine, consistent with the nonlinear, sigmoid response curve of adenosine receptor activation. At intermediate levels of receptor occupancy, where sensitivity to endogenous adenosine fluctuations is greatest, even modest changes in adenosine availability or receptor responsiveness&#x02014;potentially induced by food processing&#x02014;may lead to measurable changes in vascular tone. These findings highlight a potential mechanism through which UPF may exert acute physiological effects on vascular regulation.</p><p id="Par40">Adenosine is a homeostatic mediator often referred to as a &#x0201c;stress signal,&#x0201d; with extracellular concentrations increasing in response to metabolic perturbations, tissue injury, and inflammation. Acutely, adenosine promotes vasodilation and exerts protective effects aimed at restoring equilibrium<sup><xref ref-type="bibr" rid="CR40">40</xref></sup>. Chronically, however, dysregulated adenosine signaling has been implicated in a range of pathological processes, including fibrosis, metabolic syndrome, and chronic inflammation<sup><xref ref-type="bibr" rid="CR41">41</xref></sup>. The observed enhancement of adenosine-mediated MBF response after a UPF meal may reflect a short-term perturbation in purinergic tone that, if sustained or repeatedly triggered, could contribute to the pro-inflammatory and cardiometabolic risks associated with UPF consumption.</p><p id="Par41">Cognitive testing, included as an exploratory outcome, revealed modest but intriguing effects. Specifically, performance was worse on several cognitive tasks following the ultra-processed meal when it was consumed in the first study period, suggesting a Sequence &#x000d7; Treatment interaction. This pattern may reflect an interplay between meal type and cognitive readiness or resilience, as well as the influence of practice effects inherent in crossover designs. The most consistent effect was observed in tasks requiring divided attention, with significantly more errors on the dual-task following the UPF meal. Although these results are preliminary and not conclusive due to limited power and potential learning effects, they align with epidemiological studies linking higher UPF intake to lower cognitive performance<sup><xref ref-type="bibr" rid="CR11">11</xref>,<xref ref-type="bibr" rid="CR42">42</xref></sup>. Mechanistically, adenosine plays a key role in regulating neurotransmitter release,&#x000a0;including dopamine and glutamate,&#x000a0;in brain regions critical for attention and executive function<sup><xref ref-type="bibr" rid="CR43">43</xref></sup>. Dysregulation of adenosinergic signaling has been implicated in cognitive decline<sup><xref ref-type="bibr" rid="CR44">44</xref></sup>. Our findings suggest the possibility that even a single UPF exposure may transiently alter cognitive function via purinergic or inflammatory pathways.</p><p id="Par42">Prior studies have reported acute impairments in peripheral endothelial function following meals rich in saturated fats, using techniques such as brachial artery ultrasound to assess endothelium-dependent dilation. For instance, Lacroix et al. reported reduced reactive hyperemia following an ultra-processed meal but not after a Mediterranean-style meal in the same subjects<sup><xref ref-type="bibr" rid="CR18">18</xref></sup>. However, these studies did not isolate the effect of processing per se, nor did they assess myocardial endothelial function directly. In contrast, we used meals with matched nutrient profiles and assessed MBF with PET imaging. Our finding that MBF and MFR did not differ between meals at high-dose adenosine suggests that nutrient composition, rather than processing method, may underlie the endothelial changes observed in earlier studies. This interpretation is supported by literature showing endothelial improvements with low-fat diets, lipid-lowering therapies, and exercise conditioning<sup><xref ref-type="bibr" rid="CR36">36</xref>&#x02013;<xref ref-type="bibr" rid="CR38">38</xref>,<xref ref-type="bibr" rid="CR45">45</xref></sup>. Differences may also reflect varying sensitivity of vascular beds; myocardial and peripheral vasculature do not necessarily respond in parallel. A study by Scholtens et al.<sup><xref ref-type="bibr" rid="CR46">46</xref></sup> using PET-NH&#x02083; imaging found no correlation between myocardial and peripheral perfusion reserve, reinforcing the idea that peripheral assessments may not fully capture myocardial vascular function.</p><p id="Par43">This study has several limitations. The small sample size limited power to detect small differences in MBF at baseline and high adenosine dose, and constrained our ability to draw firm conclusions from the cognitive data, especially regarding sequence effects. While the observed increase in MBF at intermediate dose was statistically robust, a longer intervention or repeated exposures may be necessary to evaluate cumulative or sustained effects. Additionally, we relied on an indirect proxy&#x02014;MBF under intermediate-dose adenosine&#x02014;to infer differences in endogenous adenosine activity. While pharmacologic adenosine challenge has been used previously (e.g., to compare ticagrelor vs. clopidogrel effects on adenosine bioavailability<sup><xref ref-type="bibr" rid="CR47">47</xref></sup>), direct measurement of endogenous adenosine remains technically challenging and is not routinely feasible in clinical studies.</p><p id="Par44">We also explored whether glycemia could account for differences in adenosine signaling, as elevated blood glucose has been shown to trigger astrocytic adenosine release in the hypothalamus. However, blood glucose levels just prior to PET imaging were only minimally higher after the UPF meal (4.90&#x02009;&#x000b1;&#x02009;0.39 vs. 4.52&#x02009;&#x000b1;&#x02009;0.46 mmol/L), and this small difference, while statistically significant, is unlikely to explain the observed vascular changes. Lastly, this study enrolled only healthy participants, limiting generalizability to populations with cardiometabolic disease, in whom purinergic tone and vascular reactivity may already be altered.</p></sec><sec id="Sec17"><title>Conclusion</title><p id="Par45">In healthy adults, a single ultra-processed meal increased MBF and MFR under intermediate-dose adenosine stress, suggesting an acute enhancement of adenosine-mediated vascular effects independent of macronutrient content. These findings point to a potential mechanistic link between food processing and purinergic signaling. Exploratory cognitive data suggested modest impairments following the ultra-processed meal, particularly in attention-related tasks, raising the possibility of short-term neurocognitive effects. While preliminary, these results support further investigation into how UPFs may acutely affect vascular and brain function, and whether purinergic signaling plays a mediating role in the adverse health outcomes associated with these foods.</p></sec></body><back><glossary><title>Abbreviations</title><def-list><def-item><term>UPF</term><def><p id="Par4">Ultra-processed foods</p></def></def-item><def-item><term>PET/CT</term><def><p id="Par5">Positron emission tomography/computed tomography</p></def></def-item><def-item><term>MBF</term><def><p id="Par6">Myocardial blood flow</p></def></def-item><def-item><term>MFR</term><def><p id="Par7">Myocardial flow reserve</p></def></def-item><def-item><term><sup>82</sup>Rb</term><def><p id="Par8">Rubidium-chloride</p></def></def-item></def-list></glossary><fn-group><fn><p><bold>Publisher&#x02019;s note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn></fn-group><ack><title>Acknowledgements</title><p>We would like to acknowledge the contribution of Caroline D&#x02019;Oliviera-Sousa, Julie Lalong&#x000e9;, and Sophie Marcil to this project.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>MPG, AN, LB, FH, MJ, EL, VH and JCM designed research; MPG and YAL conducted research; YAL, AN, LB and CG analyzed data; and YAL, MPG, LB, JIG, AN, MJ, JCM and CG wrote the paper. MPG had primary responsibility for final content. All authors read and approved the final manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>This project was supported by a Quebec Bio-Imaging Network grant and a support from the department of Radiology, Radio-oncology and Nuclear Medicine of the Universit&#x000e9; de Montr&#x000e9;al.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>The datasets generated and analyzed during the current study are available from the corresponding author upon reasonable request.</p></notes><notes><title>Declarations</title><notes id="FPar1" notes-type="COI-statement"><title>Competing interests</title><p id="Par46">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Mart&#x000ed;nez Steele</surname><given-names>E</given-names></name><etal/></person-group><article-title>Ultra-processed foods and added sugars in the US diet: Evidence from a nationally representative cross-sectional study</article-title><source>BMJ Open.</source><year>2016</year><volume>
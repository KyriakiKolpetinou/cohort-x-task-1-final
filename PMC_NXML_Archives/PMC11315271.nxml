<article-meta><article-id pub-id-type="pmid">39886504</article-id><article-id pub-id-type="pmc">11315271</article-id><article-id pub-id-type="publisher-id">bmjonc-2023-000057</article-id><article-id pub-id-type="doi">10.1136/bmjonc-2023-000057</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Research</subject></subj-group><subj-group subj-group-type="hwp-journal-coll"><subject>1506</subject></subj-group></article-categories><title-group><article-title>Prevalence of MRI lesions in men responding to a GP-led invitation for a prostate health check: a prospective cohort study</article-title></title-group><contrib-group><contrib id="author-100639394" contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0003-0202-7912</contrib-id><name><surname>Moore</surname><given-names>Caroline M</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-105329607" contrib-type="author"><name><surname>Frangou</surname><given-names>Elena</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-105329608" contrib-type="author"><name><surname>McCartan</surname><given-names>Neil</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff4" ref-type="aff">4</xref></contrib><contrib id="author-105329609" contrib-type="author"><name><surname>Santaolalla</surname><given-names>Aida</given-names></name><xref rid="aff5" ref-type="aff">5</xref></contrib><contrib id="author-105329610" contrib-type="author"><name><surname>Kopcke</surname><given-names>Douglas</given-names></name><xref rid="aff6" ref-type="aff">6</xref><xref rid="aff7" ref-type="aff">7</xref></contrib><contrib id="author-105329611" contrib-type="author"><name><surname>Brembilla</surname><given-names>Giorgio</given-names></name><xref rid="aff6" ref-type="aff">6</xref></contrib><contrib id="author-105329612" contrib-type="author"><name><surname>Hadley</surname><given-names>Joanna</given-names></name><xref rid="aff2" ref-type="aff">2</xref><xref rid="aff6" ref-type="aff">6</xref></contrib><contrib id="author-105329613" contrib-type="author"><name><surname>Giganti</surname><given-names>Francesco</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff7" ref-type="aff">7</xref></contrib><contrib id="author-100634280" contrib-type="author"><name><surname>Marsden</surname><given-names>Teresa</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-105329615" contrib-type="author"><name><surname>Van Hemelrijck</surname><given-names>Mieke</given-names></name><xref rid="aff5" ref-type="aff">5</xref></contrib><contrib id="author-105329616" contrib-type="author"><name><surname>Gong</surname><given-names>Fiona</given-names></name><xref rid="aff6" ref-type="aff">6</xref></contrib><contrib id="author-105329617" contrib-type="author"><name><surname>Freeman</surname><given-names>Alex</given-names></name><xref rid="aff8" ref-type="aff">8</xref></contrib><contrib id="author-105329618" contrib-type="author"><name><surname>Haider</surname><given-names>Aiman</given-names></name><xref rid="aff8" ref-type="aff">8</xref></contrib><contrib id="author-105329619" contrib-type="author"><name><surname>Tuck</surname><given-names>Steve</given-names></name><xref rid="aff9" ref-type="aff">9</xref></contrib><contrib id="author-105329620" contrib-type="author"><name><surname>Pashayan</surname><given-names>Nora</given-names></name><xref rid="aff10" ref-type="aff">10</xref></contrib><contrib id="author-105329621" contrib-type="author"><name><surname>Callender</surname><given-names>Thomas</given-names></name><xref rid="aff11" ref-type="aff">11</xref></contrib><contrib id="author-105329622" contrib-type="author"><name><surname>Green</surname><given-names>Saran</given-names></name><xref rid="aff5" ref-type="aff">5</xref></contrib><contrib id="author-105329623" contrib-type="author"><name><surname>Brown</surname><given-names>Louise C</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-105329624" contrib-type="author"><name><surname>Punwani</surname><given-names>Shonit</given-names></name><xref rid="aff6" ref-type="aff">6</xref><xref rid="aff7" ref-type="aff">7</xref></contrib><contrib id="author-105329625" contrib-type="author"><name><surname>Emberton</surname><given-names>Mark</given-names></name><xref rid="aff2" ref-type="aff">2</xref><xref rid="aff12" ref-type="aff">12</xref></contrib><on-behalf-of>on behalf of the Re-Imagine Study group</on-behalf-of></contrib-group><contrib-group content-type="collaborators"><contrib contrib-type="collab"><collab>on behalf of the Re-Imagine Study group</collab></contrib><contrib contrib-type="collab"><name><surname>Emberton</surname><given-names>Mark</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Ahmed</surname><given-names>Hashim U</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Moore</surname><given-names>Caroline M</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Hemelrijck</surname><given-names>Mieke Van</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Punwani</surname><given-names>Shonit</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Rodriguez-Justo</surname><given-names>Manuel</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Attard</surname><given-names>Gerhardt</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Brown</surname><given-names>Louise</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Frangou</surname><given-names>Elena</given-names></name></contrib><contrib contrib-type="collab"><name><surname>Brew-Graves</surname><given-names>Chris</given-names></name></contrib><contrib contrib-type=
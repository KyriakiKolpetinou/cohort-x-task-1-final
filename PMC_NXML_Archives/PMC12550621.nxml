</element-citation></ref><ref id="ref13"><element-citation publication-type="journal" id="cit13"><name><surname>Blauwendraat</surname><given-names>C.</given-names></name><etal/><article-title>Genetic modifiers of risk and age at onset in GBA associated Parkinson&#x02019;s
disease and Lewy body dementia</article-title><source>Brain</source><year>2020</year><volume>143</volume><fpage>234</fpage><lpage>248</lpage><pub-id pub-id-type="doi">10.1093/brain/awz350</pub-id><pub-id pub-id-type="pmid">31755958</pub-id>

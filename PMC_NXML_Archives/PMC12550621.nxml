Genome-wide Screening for Modifiers
of Lysosomal Glucocerebrosidase Uncovers Candidate Risk Factors for
Parkinson&#x02019;s Disease</article-title></title-group><contrib-group id="CONTRIB-GROUP-d14e22-autogenerated"><contrib id="ath1" contrib-type="author"><contrib-id contrib-id-type="paragon-plus" authenticated="true">7494537</contrib-id><name><surname>Udayar</surname><given-names>Vinod</given-names></name><xref rid="aff1" ref-type="aff"/><xref rid="aff2" ref-type="aff"/></contrib><contrib id="ath2" contrib-type="author"><contrib-id contrib-id-type="paragon-plus" authenticated="true">5896119</contrib-id><contrib-id contrib-id-type="orcid" authenticated="true">https://orcid.org/0000-0003-1491-1174</contrib-id><name><surname>Gilormini</surname><given-names>Pierre-Andr&#x000e9;</given-names></name><xref rid="aff3" ref-type="aff"/><xref rid="aff4" ref-type="aff"/></contrib><contrib id="ath3" contrib-type="author"><contrib-id contrib-id-type="paragon-plus" authenticated="true">7494543</contrib-id><name><surname>Bryois</surname><given-names>Julien</given-names></name><xref rid="aff1" ref-type="aff"/></contrib><contrib id="ath4" contrib-type="author"><contrib-id contrib-id-type="paragon-plus" authenticated="true">7494548</contrib-id><name><surname>Gehrlein</surname><given-names>Alexandra</given-names></name><xref rid="aff1" ref-type="aff"/></contrib><contrib id="ath5" contrib-type="author"><contrib-id contrib-id-type="paragon-plus" authenticated="true">6480148</contrib-id><name><surname>Chen</surname><given-names>Xi</given-names></name><xref rid="aff4" ref-type="aff"/></contrib><contrib id="ath6" contrib-type="author"><contrib-id contrib-id-type="paragon-plus" authenticated="true">7494553</contrib-id><name><surname>Sonea</surname><given-names>Stephanie</given-names></name><xref rid="aff3" ref-type="aff"/></contrib><contrib id="ath7" contrib-type="author"><contrib-id contrib-id-type="paragon-plus" authenticated="true">6480144</contrib-id><name><surname>Zhu</surname><given-names>Sha</given-names></name><xref rid="aff4" ref-type="aff"/></contrib><contrib id="ath8" contrib-type
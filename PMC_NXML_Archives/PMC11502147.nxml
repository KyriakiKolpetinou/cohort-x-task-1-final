<institution>Department of Structural Engineering, Norwegian University of Science and Technology</institution>, <addr-line>Trondheim</addr-line>, <country country="NO">Norway</country></aff></contrib><contrib contrib-type="author"><name><surname>Wiseth</surname><given-names>Rune</given-names></name><aff>

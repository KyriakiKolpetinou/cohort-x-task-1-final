<article-meta><article-id pub-id-type="pmid">41204221</article-id><article-id pub-id-type="pmc">12595635</article-id>
<article-id pub-id-type="publisher-id">5718</article-id><article-id pub-id-type="doi">10.1186/s13054-025-05718-8</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>Persistent inspiratory muscle weakness among extubated patients after prolonged intubation is frequent and can be predicted early by maximal inspiratory pressure measured 12 days after its initial diagnosis: a prospective observational study</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes" equal-contrib="yes"><name><surname>Oestreicher</surname><given-names>Valentin</given-names></name><address><email>valentin.oestreicher@hug.ch</email></address><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Hennemann</surname><given-names>Marius</given-names></name><xref ref-type="aff" rid="Aff3">3</xref><xref ref-type="aff" rid="Aff4">4</xref><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Hilfiker</surname><given-names>Roger</given-names></name><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Faivre</surname><given-names>Thibault</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Zoni</surname><given-names>Greg</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Demont</surname><given-names>Marianne</given-names></name><xref ref-type="aff" rid="Aff4">4</xref><xref ref-type="aff" rid="Aff5">5</xref><xref ref-type="aff" rid="Aff7">7</xref></contrib><contrib contrib-type="author"><name><surname>Teixeira</surname><given-names>M&#x000e9;lanie</given-names></name><xref ref-type="aff" rid="Aff8">8</xref></contrib><contrib contrib-type="author"><name><surname>Ucchino</surname><given-names>Roberto</given-names></name><xref ref-type="aff" rid="Aff9">9</xref></contrib><contrib contrib-type="author"><name><surname>Tassaux</surname><given-names>Didier</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Piquilloud</surname><given-names>Lise</given-names></name><xref ref-type="aff" rid="Aff5">5</xref><xref ref-type="aff" rid="Aff10">10</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Contal</surname><given-names>Olivier</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01m1pv723</institution-id><institution-id institution-id-type="GRID">grid.150338.c</institution-id><institution-id institution-id-type="ISNI">0000 0001 0721 9812</institution-id><institution>Care directorate, </institution><institution>University Hospital of Geneva (HUG), </institution></institution-wrap>Geneva, Switzerland </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01m1pv723</institution-id><institution-id institution-id-type="GRID">grid.150338.c</institution-id><institution-id institution-id-type="ISNI">0000 0001 0721 9812</institution-id><institution>Acute Medicine Department, Intensive Care Unit, </institution><institution>University Hospital of Geneva (HUG), </institution></institution-wrap>Geneva, Switzerland </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01xkakk17</institution-id><institution-id institution-id-type="GRID">grid.5681.a</institution-id><institution-id institution-id-type="ISNI">0000 0001 0943 1999</institution-id><institution>University of Applied Sciences and Arts Western Switzerland (HES-SO), </institution></institution-wrap>Del&#x000e9;mont, Switzerland </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05a353079</institution-id><institution-id institution-id-type="GRID">grid.8515.9</institution-id><institution-id institution-id-type="ISNI">0000 0001 0423 4662</institution-id><institution>Physiotherapy Department for the Departments of Surgery, Cardiovascular Surgery, and Interdisciplinary Centres, </institution><institution>University Hospital of Lausanne (CHUV), </institution></institution-wrap>Lausanne, Switzerland </aff><aff id="Aff5"><label>5</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05a353079</institution-id><institution-id institution-id-type="GRID">grid.8515.9</institution-id><institution-id institution-id-type="ISNI">0000 0001 0423 4662</institution-id><institution>Adult Intensive Care Unit, </institution><institution>University Hospital of Lausanne (CHUV), </institution></institution-wrap>Lausanne, Switzerland </aff><aff id="Aff6"><label>6</label>Physiotherapy Tschopp &#x00026; Hilfiker, Brig, Switzerland </aff><aff id="Aff7"><label>7</label>Intensive Care Unit, Hospital Group la C&#x000f4;te (EHC), Hospital of Morges, Morges, Switzerland </aff><aff id="Aff8"><label>8</label>Intensive Care Medicine Department, Hospital Network of Neuch&#x000e2;tel (RHNe), Neuch&#x000e2;tel, Switzerland </aff><aff id="Aff9"><label>9</label>Critical Care Medicine Department, Hospital of Riviera &#x02013; Chablais (HRC), Hospital Centre of Rennaz, Rennaz, Switzerland </aff><aff id="Aff10"><label>10</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/019whta54</institution-id><institution-id institution-id-type="GRID">grid.9851.5</institution-id><institution-id institution-id-type="ISNI">0000 0001 2165 4204</institution-id><institution>Faculty of Biology and Medicine, </institution><institution>University of Lausanne, </institution></institution-wrap>Lausanne, Switzerland </aff></contrib-group><pub-date pub-type="epub"><day>7</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>7</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>29</volume><elocation-id>477</elocation-id><history><date date-type="received"><day>14</day><month>7</month><year>2025</year></date><date date-type="accepted"><day>10</day><month>10</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">Prolonged mechanical ventilation (MV) frequently results in inspiratory and peripheral muscle weakness, impairing recovery. These conditions can be identified at the bedside using respectively Maximal Inspiratory Pressure (MIP) measurement and Medical Research Council (MRC) score. This study investigated the evolution over the acute-care hospital stay of MIP and MRC score in patients with documented post-extubation inspiratory muscle weakness (IMW), defined as MIP&#x02009;&#x02264;&#x02009;30 cmH<sub>2</sub>O, and looked for the factors associated with persistent IMW at the end of the acute care hospital stay.</p></sec><sec><title>Method</title><p id="Par2">This exploratory prospective observational study was conducted across five Swiss hospitals. Patients in the Intensive Care Unit (ICU) who were extubated after &#x02265;&#x02009;7 days of MV, with IMW diagnosed within 48&#x000a0;h post planned extubation, were included. Patients&#x02019; characteristics and ICU-related factors were recorded throughout the acute care stay as were MIP and MRC score. ICU-acquired weakness (ICU-AW) recorded in the medical file, ICU readmission, reintubation, and hospital mortality were also documented. Descriptive statistics and linear interpolation for missing MIP data were applied, and associations with persistent IMW (MIP&#x02009;&#x02264;&#x02009;30 cmH<sub>2</sub>O) at study completion were explored using univariable logistic regression. The optimal timepoint for predicting persistent IMW using MIP was identified using a random forest model.</p></sec><sec><title>Results</title><p id="Par3">Sixty-nine patients (48 men, 21 women) completed the study. At study completion, persistent IMW was observed in 30 patients (43%), with a median MIP of 22 [13&#x02013;24] cmH<sub>2</sub>O. MIP was of 44 [36&#x02013;64] in patients without persistent IMW. Persistent IMW was positively associated in univariable logistic regression with female sex, duration of catecholamine use until inclusion, MIP at day 12, MRC score at day 12 and changes in MIP from inclusion to day 12. The presence of respiratory comorbidities was negatively associated with persistent IMW.</p></sec><sec><title>Conclusion</title><p id="Par4">Persistent IMW following prolonged MV is frequent throughout the acute care stay and until acute care hospital discharge. The MIP measured at day 12 after inclusion, as well as its change from inclusion to day 12, were strongly associated with persistent IMW.</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1186/s13054-025-05718-8.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Intensive care</kwd><kwd>Prolonged mechanical ventilation</kwd><kwd>Maximal inspiratory pressure</kwd><kwd>Inspiratory muscle weakness</kwd><kwd>Peripheral muscle weakness</kwd><kwd>Intensive care unit acquired weakness</kwd></kwd-group><funding-group><award-group><funding-source><institution>University of Geneva</institution></funding-source></award-group><open-access><p>Open access funding provided by University of Geneva</p></open-access></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; BioMed Central Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Background</title><p id="Par15">Inspiratory Muscle Weakness (IMW) is frequent in patients undergoing Mechanical ventilation (MV) in Intensive Care Units (ICUs) [<xref ref-type="bibr" rid="CR1">1</xref>&#x02013;<xref ref-type="bibr" rid="CR4">4</xref>]. Risk factors for IMW include MV itself, deep sedation and muscle paralysis, among other contributing factors [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR5">5</xref>&#x02013;<xref ref-type="bibr" rid="CR9">9</xref>]. At the bedside IMW can simply and non-invasively be evaluated with Maximal Inspiratory Pressure (MIP) measurement [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR5">5</xref>, <xref ref-type="bibr" rid="CR10">10</xref>&#x02013;<xref ref-type="bibr" rid="CR12">12</xref>]. In ICU settings, a threshold of MIP&#x02009;&#x02264;&#x02009;30 cmH<sub>2</sub>O is often used to define IMW, independently from individual patient characteristics [<xref ref-type="bibr" rid="CR5">5</xref>, <xref ref-type="bibr" rid="CR7">7</xref>, <xref ref-type="bibr" rid="CR8">8</xref>, <xref ref-type="bibr" rid="CR10">10</xref>, <xref ref-type="bibr" rid="CR11">11</xref>, <xref ref-type="bibr" rid="CR13">13</xref>]. Similarly to ICU acquired weakness (ICU-AW), IMW is associated with longer duration of MV, a higher risk of re-intubation, difficult weaning, impaired physical function after ICU discharge, reduced quality of life up to five years after ICU discharge and reduced survival [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR5">5</xref>&#x02013;<xref ref-type="bibr" rid="CR7">7</xref>, <xref ref-type="bibr" rid="CR12">12</xref>&#x02013;<xref ref-type="bibr" rid="CR20">20</xref>]. In this context, early detection of patients at risk of persistent IMW after prolonged MV may provide guidance for therapies [<xref ref-type="bibr" rid="CR5">5</xref>, <xref ref-type="bibr" rid="CR6">6</xref>]. However, the evolution of IMW during the acute care hospital stay is largely underexplored [<xref ref-type="bibr" rid="CR4">4</xref>, <xref ref-type="bibr" rid="CR7">7</xref>, <xref ref-type="bibr" rid="CR21">21</xref>]. It was hypothesized that some patients extubated after prolonged MV will recover inspiratory muscle strength during their hospital stay in acute care, while others will not. Furthermore, it was hypothesized that the trajectory of IMW recovery was associated with clinical parameters identifiable early during acute care hospitalization.</p><p id="Par16">The primary objective of this study was to describe the natural course of inspiratory muscle strength throughout acute care in adult patients invasively ventilated during at least 7 days and with documented IMW within the 48&#x000a0;h after planned extubation. The secondary objective was to explore associations between persistent IMW at study completion defined as MIP&#x02009;&#x02264;&#x02009;30 cmH<sub>2</sub>O and clinical parameters available earlier during hospitalization. Additionally, investigations were undertaken to explore whether these clinical parameters were associated with the absolute value of MIP at study completion.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Study design and participants</title><p id="Par17">This prospective, multicentre, exploratory observational study was conducted across two tertiary academic hospitals in Lausanne (CHUV) and Geneva (HUG) and three non-academic hospitals (Morges, Neuch&#x000e2;tel and Rennaz) in Switzerland. Ethical approval was obtained, and written informed consent was provided by all participants or their representatives. The study adhered to the Declaration of Helsinki, Good Clinical Practice Guidelines (ICH-GCP), and national regulations.</p><p id="Par18">Inclusion criteria were age&#x02009;&#x02265;&#x02009;18 years, hospitalization in an adult ICU, extubation after &#x02265;&#x02009;7 days of MV (either consecutive days or non-consecutive days in case of extubation failure), and documented IMW, defined as a MIP&#x02009;&#x02264;&#x02009;30 cmH<sub>2</sub>O within 48&#x000a0;h post-planned extubation, independently from individual predicted normal MIP value. Non-inclusion criteria were absence of consent, recent solid organ transplantation, primary neurological disorders, major burns, palliative care or planned therapeutic withdrawal, laryngeal oedema, continuous dependence on non-invasive ventilation or significant hemodynamic instability. In addition, for organisational reasons, recruitment was interrupted during the first and second waves of the COVID-19 pandemia.</p><p id="Par19">Due to the exploratory nature of the study and the absence of available quantitative data, no formal sample size calculation was performed. A convenience sample of 90 patients was targeted.</p></sec><sec id="Sec4"><title>Measurements procedures and data collection</title><p id="Par20">Baseline and ICU-related clinical data leading to inclusion were recorded. According to the usual practice of the participating centres, assessment of MIP in accordance with the ERS statement [<xref ref-type="bibr" rid="CR10">10</xref>] and MRC score [<xref ref-type="bibr" rid="CR22">22</xref>, <xref ref-type="bibr" rid="CR23">23</xref>] were routinely performed by trained physiotherapists within 48&#x000a0;h post-planned extubation in patients who had undergone&#x02009;&#x02265;&#x02009;7 days of MV.</p><p id="Par21">In more detail, measurement of MIP was performed via handheld electronic manometers: the POWERbreathe KH2 (POWERbreathe, United Kingdom) in Lausanne and Geneva, and the micro-RPM<sup>&#x000ae;</sup> (MD Spiro, United States) in Morges, Neuch&#x000e2;tel, and Rennaz. Measurements were performed at residual volume. Patients were instructed to maintain a maximal inspiratory effort for at least two seconds, with pressure sustained over one second. Initially, two different interfaces were used in each patient (see below), a naso-oral anaesthesia mask and a mouthpiece with a nose clip in place. The highest MIP value obtained with each interface was recorded. If patients were unable to generate a numeric value (reported as &#x0201c;measurement error&#x0201d; on the device), due to insufficient effort or poor coordination during the measurement, the result was documented as IMW.</p><p id="Par22">For the 24 first included patients, five measurements using the mouthpiece and five measurements using the naso-oral mask were made. Assessment of MIP and MRC score were conducted daily during the ICU stay, every three days following ICU discharge, and weekly beyond day 28 after inclusion. An analysis of the data of the first 21 patients for whom analysis was possible (i.e. after the exclusion of the data from three patients who did not sign post-hoc consent) showed a strong correlation between the MIP measurements performed with the two different interfaces (see additional file 1). Based on this correlation, the protocol was amended starting with patient 25: assessments were then performed using the preferred interface, with three to five MIP measurements at each session. From patient 25, MIP and MRC evaluations were conducted on days 0 (inclusion), 4, and 7, and subsequently every seven days. For all patients MIP and MRC score were also recorded at ICU discharge and at study completion. Study completion corresponded to the end of the follow-up, that was defined as: discharge from the acute care hospitalization, transfer to a non-participating acute care facility, death, or day 90 post-inclusion, whichever occurred first.</p></sec><sec id="Sec5"><title>Outcomes</title><p id="Par23">The primary outcome was persistent IMW, defined as MIP&#x02009;&#x02264;&#x02009;30 cmH<sub>2</sub>O at study completion. Secondary outcomes included absolute value of MIP and MRC score at study completion, changes in MIP and MRC score from inclusion to study completion, clinical diagnosis of ICU-AW, reintubation, ICU and hospital length of stay, ICU readmission, and hospital mortality.</p></sec><sec id="Sec6"><title>Statistical analysis</title><p id="Par24">Results are presented as median with first and third quartiles for continuous variables, and as numbers and percentages for categorical variables. Descriptive statistics are reported for the population and separately for the subgroups with and without persistent IMW, namely with and without MIP&#x02009;&#x02264;&#x02009;30 cmH<sub>2</sub>O at study completion. Between-groups comparisons were conducted using chi-squared for categorical variables and Mann-Whitney tests for continuous variables. To evaluate associations between clinical factors and persistent IMW at study completion, univariable logistic regression was used, reporting Odds-Ratios (OR) with corresponding 95% confidence intervals (CI). As a sensitivity analysis, univariable linear regression was used to identify factors associated with the absolute MIP value measured at study completion. Those results are presented as raw coefficients and standardized coefficients (standardized by 2 standard deviations of the given variable) with 95% CI and p-values.</p></sec></sec><sec id="Sec7"><title>Inference of missing data and identification of the best timepoint to predict persistent IMW</title><p id="Par25">As daily MIP measurements were not performed in all patients, missing MIP data for days 7 to 12 post-inclusion were imputed using linear interpolation with the Stata <italic>ipolate</italic> command. The optimal early timepoint for predicting persistent IMW at study completion was then identified using a random forest model in R (see additional file 2) [<xref ref-type="bibr" rid="CR24">24</xref>]. The same strategy was used to interpolate MRC scores values between days 7 and 12.</p></sec><sec id="Sec8"><title>Results</title><sec id="Sec9"><title>Study population</title><p id="Par26">From 28th February 2021 to 31&#x02009;st January 2023, a total of 136 patients invasively ventilated for a minimum of 7 days were routinely assessed for IMW within 48&#x000a0;h post-extubation. Of these, 22 had MIP&#x02009;&#x0003e;&#x02009;30 cmH<sub>2</sub>O, and 41 either declined participation or were not recruited due to lack of resources.</p><p id="Par27">To note, no patients were excluded due to laryngeal oedema, continuous dependence on non-invasive ventilation or significant hemodynamic instability. Overall, 73 patients were thus included across participating centres. Most of them (<italic>N</italic>&#x02009;=&#x02009;63) were recruited from the two tertiary academic centres. As four patients did not sign post-hoc consent, 69 patients completed the study. The study flowchart is shown in Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>. Most patients (90%) were included after one continuous episode of at least 7 days of MV. The remaining 10% experienced extubation failure but had at least 7 days of MV in total. No adverse effects were reported for either peripheral or inspiratory muscle testing. Patients underwent a median of 6 [4&#x02013;9] MIP measurements during the study.</p><p id="Par28">
<fig id="Fig1"><label>Fig. 1</label><caption><p>Recruitment flowchart</p></caption><graphic xlink:href="13054_2025_5718_Fig1_HTML" id="d33e532"/></fig>
</p></sec><sec id="Sec10"><title>Patient characteristics and outcomes</title><p id="Par29">The study population consisted of 48 men (70%) and 21 women (30%), aged 68 [59&#x02013;75] years, with a Simplified Acute Physiology (SAPS) 2 score at admission of 45 [35&#x02013;60]. Detailed patient characteristics, data related to the ICU stay until inclusion and results from univariable logistic regression with persistent IMW are presented in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>, both for the study population and for the two subgroups with and without persistent IMW at study completion.</p><p id="Par30">
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Patient characteristics for the study population and subgroups with and without persistent IMW at study completion</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">Study population<break/><italic>N</italic>&#x02009;=&#x02009;69</th><th align="left">MIP&#x02009;&#x02264;&#x02009;30 cmH<sub>2</sub>O at study completion<break/><italic>N</italic>&#x02009;=&#x02009;30 (43%)</th><th align="left">MIP&#x02009;&#x0003e;&#x02009;30 cmH<sub>2</sub>O at study completion<break/><italic>N</italic>&#x02009;=&#x02009;39 (57%)</th><th align="left"><italic>P</italic>-value</th><th align="left">Odds Ratio<break/>(95% CI)</th><th align="left"><italic>P</italic>-value<break/>(logistic regression)</th></tr></thead><tbody><tr><td align="left" colspan="5">

</person-group><article-title>Radiographer&#x02019;s confidence in managing patients with claustrophobia during magnetic resonance imaging</article-title><source>Radiography</source><year>2022</year><volume>28</volume><issue>1</issue><fpage>148</fpage><lpage>153</lpage><pub-id pub-id-type="doi">10.1016/j.radi.2021.09.007</pub-id><pub-id pub-id-type="pmid">34598898</pub-id>
</element-citation></ref><ref id="B2-behavsci-15-01059"><element-citation publication-type="journal"><person-group person-group-type="author">

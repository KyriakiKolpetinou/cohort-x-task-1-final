</td><td valign="top" align="left" rowspan="1" colspan="1">1.6&#x02009;&#x000b1;&#x02009;0.6 (6)</td><td valign="top" align="left" rowspan="1" colspan="1">1.1&#x02009;&#x000b1;&#x02009;0.6 (6)</td><td valign="top" align="left" rowspan="1" colspan="1">36.4 (&#x02212;0.4 &#x02012; 62.7)</td><td valign="top" align="left" rowspan="1" colspan="1">48.5 (11.1&#x02013;77.9)</td><td valign="top" align="left" rowspan="1" colspan="1">52.5</td><td valign="top" align="left" rowspan="1" colspan="1">0.12</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">

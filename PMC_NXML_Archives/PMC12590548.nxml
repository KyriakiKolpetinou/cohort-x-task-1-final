<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Ultrason Sonochem</journal-id><journal-id journal-id-type="iso-abbrev">Ultrason Sonochem</journal-id><journal-title-group><journal-title>Ultrasonics Sonochemistry</journal-title></journal-title-group><issn pub-type="ppub">1350-4177</issn><issn pub-type="epub">1873-2828</issn><publisher><publisher-name>Elsevier</publisher-name></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41138493</article-id><article-id pub-id-type="pmc">12590548</article-id><article-id pub-id-type="pii">S1350-4177(25)00391-8</article-id><article-id pub-id-type="doi">10.1016/j.ultsonch.2025.107612</article-id><article-id pub-id-type="publisher-id">107612</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Research Article</subject></subj-group></article-categories><title-group><article-title>Rapidly dissolving polymeric microbubbles promote supersaturation and in-situ formation of acoustic nanobubbles capable of dynamic pressure sensing</article-title></title-group><contrib-group><contrib contrib-type="author" id="au005"><name><surname>Tran</surname><given-names>Quang</given-names></name><xref rid="af005" ref-type="aff">a</xref><xref rid="af010" ref-type="aff">b</xref></contrib><contrib contrib-type="author" id="au010"><name><surname>Lee</surname><given-names>Garam</given-names></name><xref rid="af015" ref-type="aff">c</xref></contrib><contrib contrib-type="author" id="au015"><name><surname>Balcarcel-Monzon</surname><given-names>Michelle</given-names></name><xref rid="af005" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au020"><name><surname>Zhang</surname><given-names>Yongzhi</given-names></name><xref rid="af010" ref-type="aff">b</xref></contrib><contrib contrib-type="author" id="au025"><name><surname>Dominguez</surname><given-names>Saffron</given-names></name><xref rid="af005" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au030"><name><surname>Sack</surname><given-names>Kristen</given-names></name><xref rid="af005" ref-type="aff">a</xref></contrib><contrib contrib-type="author" id="au035"><name><surname>Kheir</surname><given-names>John N.</given-names></name><email>John.Kheir@childrens.harvard.edu</email><xref rid="af005" ref-type="aff">a</xref><xref rid="cor1" ref-type="corresp">&#x0204e;</xref></contrib><contrib contrib-type="author" id="au040"><name><surname>Bird</surname><given-names>James</given-names></name><email>jbird@bu.edu</email><xref rid="af015" ref-type="aff">c</xref><xref rid="cor1" ref-type="corresp">&#x0204e;</xref></contrib><contrib contrib-type="author" id="au045"><name><surname>McDannold</surname><given-names>Nathan</given-names></name><email>njm@bwh.harvard.edu</email><xref rid="af010" ref-type="aff">b</xref><xref rid="cor1" ref-type="corresp">&#x0204e;</xref></contrib><contrib contrib-type="author" id="au050"><name><surname>Peng</surname><given-names>Yifeng</given-names></name><email>yifeng.peng@childrens.harvard.edu</email><xref rid="af005" ref-type="aff">a</xref><xref rid="cor1" ref-type="corresp">&#x0204e;</xref></contrib><aff id="af005"><label>a</label>Department of Cardiology, Department of Pediatrics. Boston Children&#x02019;s Hospital, Harvard Medical School. Boston, MA 02115, USA</aff><aff id="af010"><label>b</label>Department of Radiology, Brigham and Women&#x02019;s Hospital, Harvard Medical School. Boston, MA 02115, USA</aff><aff id="af015"><label>c</label>Department of Mechanical Engineering, Boston University, Boston, MA 02215, USA</aff></contrib-group><author-notes><corresp id="cor1"><label>&#x0204e;</label>Corresponding authors. <email>John.Kheir@childrens.harvard.edu</email><email>jbird@bu.edu</email><email>njm@bwh.harvard.edu</email><email>yifeng.peng@childrens.harvard.edu</email></corresp></author-notes><pub-date pub-type="pmc-release"><day>13</day><month>10</month><year>2025</year></pub-date><!-- PMC Release delay is 0 months and 0 days and was based on <pub-date
						pub-type="epub">.--><pub-date pub-type="collection"><month>11</month><year>2025</year></pub-date><pub-date pub-type="epub"><day>13</day><month>10</month><year>2025</year></pub-date><volume>122</volume><elocation-id>107612</elocation-id><history><date date-type="received"><day>24</day><month>7</month><year>2025</year></date><date date-type="rev-recd"><day>2</day><month>10</month><year>2025</year></date><date date-type="accepted"><day>9</day><month>10</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; 2025 The Author(s)</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbynclicense">https://creativecommons.org/licenses/by-nc/4.0/</ali:license_ref><license-p>This is an open access article under the CC BY-NC license (http://creativecommons.org/licenses/by-nc/4.0/).</license-p></license></permissions><abstract abstract-type="author-highlights" id="ab005"><title>Highlights</title><p><list list-type="simple" id="l0005"><list-item id="o0005"><label>&#x02022;</label><p id="p0005">A pH-responsive polymeric microbubble system allows a novel method to generate acoustic nanobubbles in situ on demand.</p></list-item><list-item id="o0010"><label>&#x02022;</label><p id="p0010">The dissolution mechanism of microbubbles is elucidated; triggered dissolution of microbubbles enable supersaturation.</p></list-item><list-item id="o0015"><label>&#x02022;</label><p id="p0015">In situ generated nanobubbles enable high-sensitivity pressure sensing using focused ultrasound in ex vivo heart.</p></list-item></list></p></abstract><abstract id="ab010"><p>Developing noninvasive methods for monitoring intravascular and intracardiac pressures is crucial for advancing the diagnosis and management of cardiovascular diseases. Here we report an approach utilizing pH-responsive polymeric microbubbles (PMBs) as precursors to produce in situ generated nanobubbles (NBs) as acoustic pressure sensors. Upon exposure to physiologic pH, PMBs rapidly dissolve their gas core, inducing gas supersaturation and transient formation of acoustically active NBs with cavitation thresholds characteristic of their sizes. In situ generated NBs exhibit subharmonic emission inversely correlated with hydrostatic pressure. As proof of concept, we show in an ex vivo Langendorff working heart model in situ generated NBs achieve excellent linear sensitivity to monitor intracardiac pressures (R<sup>2</sup> 0.94 and 0.2&#x000a0;dB/mmHg) using focused ultrasound, highlighting the potential of the current system for noninvasive pressure monitoring. Moreover, this work introduces a new concept of on-demand in situ NB generation, which may allow expand NB applications among various fields.</p></abstract><kwd-group id="kg005"><title>Keywords</title><kwd>Microbubbles</kwd><kwd>Supersaturation</kwd><kwd>Nanobubbles</kwd><kwd>Ultrasound</kwd><kwd>Gas delivery</kwd><kwd>Pressure sensing</kwd><kwd>Cavitation</kwd></kwd-group></article-meta></front><body><sec id="s0005"><label>1</label><title>Introduction</title><p id="p0020">Monitoring pressures in heart chambers and major blood vessels provides critical information for the diagnosis and management of cardiovascular diseases, such as high blood pressure, pulmonary arterial hypertension and heart failure [<xref rid="b0005" ref-type="bibr">[1]</xref>, <xref rid="b0010" ref-type="bibr">[2]</xref>, <xref rid="b0015" ref-type="bibr">[3]</xref>]. However, the gold standard to measure intracardiac and intravascular pressures requires highly invasive catheterization. As an alternative, the use of ultrasound contrast agents (UCAs) has emerged as a promising technique for noninvasive pressure monitoring. Several commercia UCAs, based on lipid or protein coated microbubbles (CMBs), can emit subharmonic signals that exhibit an inverse linear correlation with ambient pressure, dubbed as subharmonic-aided pressure estimation (SHAPE). However, translation of SHAPE faces barriers including concerns of signal consistency and safety risk associated with the use of high dose of UCAs [<xref rid="b0020" ref-type="bibr">4</xref>,<xref rid="b0025" ref-type="bibr">5</xref>]. Besides, only a limited numbers of CMBs were identified as pressure sensitive, and there is limited understanding in how the materials design be optimized to improve acoustic-pressure response [<xref rid="b0030" ref-type="bibr">6</xref>,<xref rid="b0035" ref-type="bibr">7</xref>]. Therefore, it is worthwhile to explore alternative acoustic pressure sensors beyond commercial CMBs.</p><p id="p0025">Nanobubbles (NBs) are an emerging class of materials with promising potential for acoustic applications [<xref rid="b0040" ref-type="bibr">[8]</xref>, <xref rid="b0045" ref-type="bibr">[9]</xref>, <xref rid="b0050" ref-type="bibr">[10]</xref>, <xref rid="b0055" ref-type="bibr">[11]</xref>, <xref rid="b0060" ref-type="bibr">[12]</xref>, <xref rid="b0065" ref-type="bibr">[13]</xref>]. Types of NBs include surface NBs (SNBs) and bulk NBs (BNBs) [<xref rid="b0040" ref-type="bibr">[8]</xref>, <xref rid="b0045" ref-type="bibr">[9]</xref>, <xref rid="b0050" ref-type="bibr">[10]</xref>, <xref rid="b0055" ref-type="bibr">[11]</xref>, <xref rid="b0060" ref-type="bibr">[12]</xref>, <xref rid="b0065" ref-type="bibr">[13]</xref>]. As a particular type of BNBs, coated NBs (CNBs) consist of a lipid or polymer shell that encapsulates a heavy gas core (e.g., perfluorocarbons), which have been extensively investigated as UCA [<xref rid="b0070" ref-type="bibr">[14]</xref>, <xref rid="b0075" ref-type="bibr">[15]</xref>, <xref rid="b0080" ref-type="bibr">[16]</xref>, <xref rid="b0085" ref-type="bibr">[17]</xref>, <xref rid="b0090" ref-type="bibr">[18]</xref>]. Besides CNBs, BNBs more generally refer to nano-sized gas cavities (e.g., air) lacking a uniform surface layer of stabilizers [<xref rid="b0095" ref-type="bibr">19</xref>,<xref rid="b0100" ref-type="bibr">20</xref>]. The existence of such BNBs seemingly contradicts the classic theory that predicts that their high internal pressure necessarily results in instant dissolution [<xref rid="b0095" ref-type="bibr">19</xref>]. However, it is shown that metastable BNBs can be produced by various methods, including repeated compression-decompression, mechanical agitation or acoustic cavitation, solvent exchange, and electrolysis [<xref rid="b0040" ref-type="bibr">8</xref>,<xref rid="b0095" ref-type="bibr">19</xref>,<xref rid="b0100" ref-type="bibr">[20]</xref>, <xref rid="b0105" ref-type="bibr">[21]</xref>, <xref rid="b0110" ref-type="bibr">[22]</xref>, <xref rid="b0115" ref-type="bibr">[23]</xref>, <xref rid="b0120" ref-type="bibr">[24]</xref>, <xref rid="b0125" ref-type="bibr">[25]</xref>]. Studies have shown that the stability of BNBs are highly dependent on hydrostatic pressure [<xref rid="b0105" ref-type="bibr">21</xref>], therefore suggesting the possibility of using BNBs for acoustic pressure sensing. However, there are certain drawbacks of using BNBs as ultrasound reporter. First, the more stable BNBs are of very small size (e.g., &#x0223c;100&#x000a0;nm), which require undesirably high energy of acoustic excitation [<xref rid="b0130" ref-type="bibr">26</xref>]. Secondly, unlike CNBs that can be prepared as concentrated solutions (&#x0003e;10<sup>11</sup> particle/ml) [<xref rid="b0070" ref-type="bibr">14</xref>,<xref rid="b0135" ref-type="bibr">27</xref>], (non-coated) BNBs are usually produced in low concentration (&#x0226a;&#x0223c;10<sup>8</sup> particle/ml) [<xref rid="b0120" ref-type="bibr">24</xref>,<xref rid="b0140" ref-type="bibr">28</xref>], thus significantly hindering their in vivo use, because further dilution in vivo may render them undetectable. As a result, the applications of BNBs under medically relevant ultrasound have been largely unexplored.</p><p id="p0030">Herein, we report an alternative approach to generate acoustically active BNB as pressure sensors. Recently, we have developed pH-responsive polymeric microbubbles (PMBs) for intravenous delivery of gases [<xref rid="b0145" ref-type="bibr">29</xref>,<xref rid="b0150" ref-type="bibr">30</xref>]. PMBs consist of pH-responsive polymeric shell that encapsulates a gas core and are stable in storage; when added to physiological pH, the shell and gas core immediately dissolve due to hydration of the shell [<xref rid="b0145" ref-type="bibr">29</xref>,<xref rid="b0150" ref-type="bibr">30</xref>]. We hypothesize that PMBs may be used as precursor for in situ generated BNBs, because dissolution of PMBs may produce gas supersaturation that are known to induce the formation of quasi stable BNB [<xref rid="b0155" ref-type="bibr">[31]</xref>, <xref rid="b0160" ref-type="bibr">[32]</xref>, <xref rid="b0165" ref-type="bibr">[33]</xref>]. In this paper, we show that administration of low dose of air-filled PMBs increases the dissolved gas content and results in formation of transitory but acoustically active BNBs on demand. We have elucidated this process via mechanistic studies. The acoustic response of these in-situ generated BNBs show high sensitivity to ambient pressure changes in a physiologically relevant range. To our knowledge, this is the first example of using NBs as acoustic pressure sensor, and this system may be further developed to enable noninvasive monitoring of intracardiac and intravascular pressures.</p></sec><sec id="s0010"><label>2</label><title>Results</title><sec id="s0015"><label>2.1</label><title>pH-Triggered dissolution of PMBs in the absence of a sink</title><p id="p0035">PMBs were fabricated using dextran modified via acetylation and succinylation as previously reported [<xref rid="b0145" ref-type="bibr">29</xref>]. The ability of PMBs to dissolve in the absence of sink was confirmed by adding an air-filled PMBs (mean size&#x000a0;&#x0223c;&#x000a0;4 &#x000b5;m, Fig. 1B, <bold>C</bold>) to air-saturated PBS buffer, which completely disappear in seconds and produce a transparent solution, whereas the shell readily reverts to soluble polymers with a size less than 10&#x000a0;nm (<xref rid="f0005" ref-type="fig">Fig. 1D</xref>) [<xref rid="b0145" ref-type="bibr">29</xref>]. Our previous work focused on characterizing the apparent dissolution kinetics of a cluster of PMBs [<xref rid="b0145" ref-type="bibr">29</xref>], but the dissolution mechanism of individual PMBs remains unclear. To study this mechanism, it is necessary to first conceptualize two critical processes that affect the dissolution of a single PMB, as outlined below (<xref rid="f0005" ref-type="fig">Fig. 1A</xref>).<fig id="f0005"><label>Fig. 1</label><caption><p><bold>A,</bold> The proposed scheme that describes the mechanism of PMBs in a pre-saturated solution (<italic>f</italic>&#x000a0;=&#x000a0;1) to produce in situ generated BNBs as acoustic pressure sensors. (Step 1) The pH triggers acid-based reactions with the shell, causing its destabilization. (Step 2) The shell gradually dissolves and leads to increased surface tension at the gas core. (Step 3) The overpressure of the gas core due to Laplace pressure drives its dissolution in an already saturated solution to produce supersaturation. This supersaturated solution reveals transiently stable yet acoustically active BNBs. <bold>B</bold>, Microscopic image showing intact air-filled PMBs suspended in D10. <bold>C</bold>, The size distribution of PMBs as in B (mean size&#x000a0;&#x0223c;&#x000a0;4 &#x000b5;m) measured by Accusizer. <bold>D</bold>, After administration of PMBs, the shell polymers hydrated to revert to soluble components of less than 10&#x000a0;nm as measured by DLS. <bold>E</bold>, Photo showing adding PMBs to PBS buffers. <bold>F</bold>, Photo showing administered PMBs completely disappeared within 3&#x000a0;s.</p></caption><graphic xlink:href="gr1" id="lk00005"/></fig></p><sec id="s0020"><label>2.1.1</label><title>[process A] shell hydration</title><p id="p0040">The gas core is initially encapsulated by a rigid shell with no Laplace overpressure applied at the air&#x02013;solid interface. Upon contact with hydroxide (OH<sup>&#x02013;</sup>) in the bulk liquid, carboxyl (&#x02013;COOH) bearing polymers in the shell deprotonate via acid-base reactions (i.e., pH trigger). The deprotonated polymers increase hydrophilicity and water permeability of the shell, initiating disintegration toward complete solubilization.</p></sec><sec id="s0025"><label>2.1.2</label><title>[process B] gas core dissolution</title><p id="p0045">Shell hydration exposes the gas core to the liquid, forming an air&#x02013;liquid interface. The associated surface tension imposes a Laplace pressure on the gas core, elevating the internal gas concentration. The resulting concentration gradient relative to the pre-saturated surrounding liquid drives dissolution of gas into the liquid and can supersaturate it. Process A and B can overlap since Phase II initiates as soon as the air&#x02013;liquid interface forms, while the shell is still present and continues to hydrate.</p><p id="p0050">To better understand these processes, we filmed the dissolution of PMBs with a high-speed camera in a microfluidic device. A stream of PMBs (1v/v%) in 10&#x000a0;% dextrose solution and a separate stream of PBS buffer were simultaneously flowed into the device at 20 nL/min where they merged into a single stream at a T-junction (<xref rid="f0010" ref-type="fig">Fig. 2A</xref>). In contrast to the PMBs vigorously agitated with the buffer solution (Fig. 1C, D), the laminar flow in the microfluidic device enabled clearer visualization and analysis of the dissolution process. The concurrent flow of two solutions remains biphasic in the main channel, and the PMB only dissolves as far as OH<sup>-</sup>s passively diffuse across the interface (<xref rid="f0010" ref-type="fig">Fig. 2A</xref>). To vary the concentration of OH<sup>-</sup>s, we titrated air-saturated PBS buffers to pH 4.5, 7.4 and 10. At pH 4.5, the shape of bubble cloud remains unchanged, indicating negligible dissolution (<xref rid="f0010" ref-type="fig">Fig. 2B</xref><bold>, Mov 1</bold>). This result is expected as the shell would remain intact since the pH is below the pKa of COOH (&#x0223c;4.8). At pH 7.4, the bubble cloud disappeared downstream of the T junction, indicating moderate dissolution (<xref rid="f0010" ref-type="fig">Fig. 2C</xref><bold>, Mov 2</bold>). Finally, at pH 10, the bubble cloud disappears near the T-junction, indicating a high dissolution rate (<xref rid="f0010" ref-type="fig">Fig. 2D</xref><bold>, Mov 3</bold>). These results are consistent with the acid-base reaction needed to initiate the shell hydration, therefore diffusion-limited; at higher pH greater flux of OH<sup>-</sup>s cross the fluid interface result in more rapid dissolution of PMBs. Note that this dissolution distribution in the current setup of minimal agitation is significantly different from administering PMBs in physiological environment [<xref rid="b0145" ref-type="bibr">29</xref>], such as in a major blood vessel or heart chamber, where more effective mixing occurs and cause greater flux of flux of OH<sup>-</sup>s thus much faster dissolution of PMBs at lower pHs.<fig id="f0010"><label>Fig. 2</label><caption><p><bold>A</bold>, Scheme of microfluidic experiments. The concurrent laminar flow minimizes turbulent mixing, and OH<sup>-</sup>s diffuses from PBS buffer to D10 phase to trigger the dissolution of PMBs. <bold>B</bold>, Flowing pH4.5 buffer resulted in no dissolution of PMBs. <bold>C</bold>, Flowing pH7.4 buffer led to moderate dissolution, with greater disappearance of bubble cloud at further distance from T-junction. <bold>D</bold>, Flowing pH10 buffer led to rapid dissolution of most bubble cloud near the T-junction. <bold>E</bold>, <bold>F,</bold> Snapshots of the dissolution of select PMBs (<bold>E</bold>) and their size change over time (<bold>F</bold>). <bold>G</bold>, Measured dissolution time (&#x003c4;) of single PMBs as a function of size. The lines were theoretical values calculated by Epstein-Plesset model at &#x003b3;&#x000a0;=&#x000a0;50 (solid line) and 10 (dotted line) mN/m under saturated condition (f&#x000a0;=&#x000a0;1). <bold>H</bold>, photos showing the dissolution of gas core in a large PMB was hampered by the incompletely hydrated shells. <bold>I</bold>, photo showing a large gas core that remained stable against further dissolution in a highly swollen shell. <bold>J</bold>, the &#x003c4; of PMBs were significantly smaller when flowing pH10 buffer than pH7 buffer due to higher concentration of OH<sup>&#x02013;</sup> to promote shell dissolution. <bold>K</bold>, Administering air-filled PMBs (pO<sub>2</sub> 153&#x000a0;&#x000b1;&#x000a0;3&#x000a0;mmHg) to air-saturated pH7.4 PBS buffer (pO<sub>2</sub> 153&#x000a0;&#x000b1;&#x000a0;3&#x000a0;mmHg) led to supersaturation as shown by increased pO<sub>2</sub>, where control was administered with air-saturated D10 solution and showed no change in pO<sub>2</sub>. <bold>L</bold>, Rapid repeat dosing of air-filled PMBs led to greater degree of supersaturation (larger increase in pO2), however, upon adding the 3rd dose, no increase in pO2 was seen due to rapid re-nucleation to form large bubbles, followed by rapid decrease in dissolve gas content. <bold>M</bold>, The setup of pO2 probe to measure supersaturation as in <bold>K</bold> and <bold>L</bold>. <bold>N</bold>, newly formed large bubbles upon supersaturation were visible immediately following administering the 3rd dose of PMBs in experiment <bold>L</bold>.</p></caption><graphic xlink:href="gr2" id="lk00010"/></fig></p><p id="p0055">Next, we measured the dissolution time &#x003c4; of individual air-filled PMBs as a function of size in an air saturated solution (Fig. 2<bold>E-G and Fig. S1</bold>). The dissolution time &#x003c4; was defined as the duration from the initial gas volume change to the complete disappearance of the gas core due to gas dissolution into the surrounding liquid. For instance, PMBs with the diameter of&#x000a0;&#x0223c;&#x000a0;4 and&#x000a0;&#x0223c;&#x000a0;6 &#x000b5;m were shown to completely dissolve in around 0.5 and 2.6&#x000a0;s, respectively (Fig. 2<bold>E, F)</bold>. Although the hydration of the shell was not observable under microscope due to its thinness [<xref rid="b0145" ref-type="bibr">29</xref>], using the well-established Epstein-Plesset model, the observed &#x003c4; can provide insight into how the hydration rate of the shell affects that of the gas core (see more discussion in Supplemental Information) [<xref rid="b0170" ref-type="bibr">[34]</xref>, <xref rid="b0175" ref-type="bibr">[35]</xref>, <xref rid="b0180" ref-type="bibr">[36]</xref>, <xref rid="b0185" ref-type="bibr">[37]</xref>, <xref rid="b0190" ref-type="bibr">[38]</xref>].</p><p id="p0060">The Epstein-Plesset model considers that the dissolution of a spherical gas bubble is driven by a difference in the gas concentration at the bubble surface and that in the surrounding quiescent liquid [<xref rid="b0170" ref-type="bibr">[34]</xref>, <xref rid="b0175" ref-type="bibr">[35]</xref>, <xref rid="b0180" ref-type="bibr">[36]</xref>, <xref rid="b0185" ref-type="bibr">[37]</xref>, <xref rid="b0190" ref-type="bibr">[38]</xref>]. Prior to the pH-triggered hydration of the shell, an intact PMB behaves as a hard-shell, featuring a physical barrier between the core gas and the surrounding liquid preventing gas dissolution through the shell. At the same time, as PMBs are stored in pre-saturated solution in our setting, there is no gas concentration difference across the shell to drive the gas dissolution as well. Thus, the dissolution time &#x003c4; will approach infinity (<bold>Fig. S2B</bold>), and this longevity is consistent with the high storage stability of PMBs in D10 [<xref rid="b0145" ref-type="bibr">29</xref>].</p><p id="p0065">After pH-trigger, the contact between the gas core and the surrounding liquid starts to develop through the hydrated shell allowing the gas dissolution. The newly created air&#x02013;liquid interface poses a surface tension, and the combination of this surface tension and bubble curvature produces internal pressure that compresses and concentrates the gas core (<bold>Fig. S3A</bold>). With the gas concentration difference generated through this process, the gas will dissolve into the surrounding liquid and the resulting radius change <italic>R(t)</italic> of the gas core follows an Epstein-Plesset model:<disp-formula id="e0005"><label>(1)</label><mml:math id="M1" altimg="si1.svg"><mml:mrow><mml:msup><mml:mrow><mml:mfenced open="{" close="}"><mml:mrow><mml:mi>R</mml:mi><mml:mfenced open="(" close=")"><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced></mml:mrow></mml:mfenced></mml:mrow><mml:mn>3</mml:mn></mml:msup><mml:mo linebreak="badbreak">-</mml:mo><mml:msubsup><mml:mi>R</mml:mi><mml:mrow><mml:mn>0</mml:mn></mml:mrow><mml:mn>3</mml:mn></mml:msubsup><mml:mo linebreak="badbreak">+</mml:mo><mml:mfenced open="(" close=")"><mml:mrow><mml:msup><mml:mrow><mml:mfenced open="{" close="}"><mml:mrow><mml:mi>R</mml:mi><mml:mfenced open="(" close=")"><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced></mml:mrow></mml:mfenced></mml:mrow><mml:mn>2</mml:mn></mml:msup><mml:mo linebreak="badbreak">-</mml:mo><mml:msubsup><mml:mi>R</mml:mi><mml:mrow><mml:mn>0</mml:mn></mml:mrow><mml:mn>2</mml:mn></mml:msubsup></mml:mrow></mml:mfenced><mml:mfrac><mml:mrow><mml:mn>2</mml:mn><mml:msub><mml:mi>M</mml:mi><mml:mi>W</mml:mi></mml:msub><mml:mi>&#x003b3;</mml:mi></mml:mrow><mml:mrow><mml:mi>&#x003c1;</mml:mi><mml:mi>B</mml:mi><mml:mi>T</mml:mi></mml:mrow></mml:mfrac><mml:mo linebreak="goodbreak">=</mml:mo><mml:mfrac><mml:mrow><mml:mn>6</mml:mn><mml:msub><mml:mi>D</mml:mi><mml:mrow><mml:mi mathvariant="italic">air</mml:mi></mml:mrow></mml:msub><mml:msub><mml:mi>k</mml:mi><mml:mi>H</mml:mi></mml:msub><mml:msub><mml:mi>M</mml:mi><mml:mi>W</mml:mi></mml:msub><mml:mi>&#x003b3;</mml:mi></mml:mrow><mml:mi>&#x003c1;</mml:mi></mml:mfrac><mml:mi>t</mml:mi></mml:mrow></mml:math></disp-formula>(Equation <xref rid="e0005" ref-type="disp-formula">(1)</xref> [<xref rid="b0170" ref-type="bibr">[34]</xref>, <xref rid="b0175" ref-type="bibr">[35]</xref>, <xref rid="b0180" ref-type="bibr">[36]</xref>, <xref rid="b0185" ref-type="bibr">[37]</xref>, <xref rid="b0190" ref-type="bibr">[38]</xref>].</p><p id="p0070">Here, <italic>R</italic><sub>0</sub> is the initial bubble radius, <italic>M<sub>w</sub></italic> is the molar weight of the air, &#x003c1; is the density of the air, and &#x003b3; is the effective air&#x02013;liquid surface tension, <italic>B</italic> is the universal gas constant, T is the temperature, <inline-formula><mml:math id="M2" altimg="si2.svg"><mml:msub><mml:mi>D</mml:mi><mml:mrow><mml:mi mathvariant="italic">air</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> is the diffusivity of air in water, <inline-formula><mml:math id="M3" altimg="si3.svg"><mml:msub><mml:mi>k</mml:mi><mml:mi>H</mml:mi></mml:msub></mml:math></inline-formula> is Henry&#x02019;s law constant. The time for complete dissolution &#x003c4; can be obtained by solving Eq-1 for the time <inline-formula><mml:math id="M4" altimg="si4.svg"><mml:mi>t</mml:mi></mml:math></inline-formula> when <inline-formula><mml:math id="M5" altimg="si5.svg"><mml:mrow><mml:mi>R</mml:mi><mml:mfenced open="(" close=")"><mml:mrow><mml:mi>t</mml:mi><mml:mo linebreak="goodbreak">=</mml:mo><mml:mi>&#x003c4;</mml:mi></mml:mrow></mml:mfenced><mml:mo linebreak="goodbreak" linebreakstyle="after">=</mml:mo><mml:mn>0</mml:mn></mml:mrow></mml:math></inline-formula>:<disp-formula id="e0010"><label>(2)</label><mml:math id="M6" altimg="si6.svg"><mml:mrow><mml:mi>&#x003c4;</mml:mi><mml:mo linebreak="goodbreak">=</mml:mo><mml:mfrac><mml:msubsup><mml:mi>R</mml:mi><mml:mrow><mml:mn>0</mml:mn></mml:mrow><mml:mn>2</mml:mn></mml:msubsup><mml:mrow><mml:mn>3</mml:mn><mml:msub><mml:mi>D</mml:mi><mml:mrow><mml:mi mathvariant="italic">air</mml:mi></mml:mrow></mml:msub><mml:msub><mml:mi>k</mml:mi><mml:mi>H</mml:mi></mml:msub></mml:mrow></mml:mfrac><mml:mfenced open="(" close=")"><mml:mrow><mml:mfrac><mml:mrow><mml:msub><mml:mi>R</mml:mi><mml:mn>0</mml:mn></mml:msub><mml:mi>&#x003c1;</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn><mml:msub><mml:mi>M</mml:mi><mml:mi>W</mml:mi></mml:msub><mml:mi>&#x003b3;</mml:mi></mml:mrow></mml:mfrac><mml:mo linebreak="badbreak">+</mml:mo><mml:mfrac><mml:mn>1</mml:mn><mml:mrow><mml:mi mathvariant="italic">BT</mml:mi></mml:mrow></mml:mfrac></mml:mrow></mml:mfenced></mml:mrow></mml:math></disp-formula>(Equation <xref rid="e0010" ref-type="disp-formula">(2)</xref> [<xref rid="b0170" ref-type="bibr">[34]</xref>, <xref rid="b0175" ref-type="bibr">[35]</xref>, <xref rid="b0180" ref-type="bibr">[36]</xref>, <xref rid="b0185" ref-type="bibr">[37]</xref>, <xref rid="b0190" ref-type="bibr">[38]</xref>].</p><p id="p0075">The effective air&#x02013;liquid surface tension &#x003b3; is determined by the extent that the shell hydration exposes the liquid to the gas core.</p><p id="p0080">If the rate of shell hydration is slow relative to the rate of gas dissolution, then the shell remains nearly intact around the gas core leading to minimal liquid exposure and an infinitesimal effective surface tension. As the shell hydrates and more of the core is exposed to surrounding liquid, the effective surface tension increases. In the other limit, where the entire shell hydrates instantaneously upon pH trigger, the gas core is subject to a surface tension close to &#x003b3;&#x000a0;=&#x000a0;50 mN/m, representative of air-polyanionic solution interface [<xref rid="b0195" ref-type="bibr">39</xref>]. The dissolution time <inline-formula><mml:math id="M7" altimg="si7.svg"><mml:mi>&#x003c4;</mml:mi></mml:math></inline-formula> measured with various gas core radius <inline-formula><mml:math id="M8" altimg="si8.svg"><mml:msub><mml:mi>R</mml:mi><mml:mn>0</mml:mn></mml:msub></mml:math></inline-formula> is compared with the dissolution time predicted by Eq.2 (<xref rid="f0010" ref-type="fig">Fig. 2G</xref>). The effective surface tension &#x003b3; fitted from measured dissolution time <inline-formula><mml:math id="M9" altimg="si7.svg"><mml:mi>&#x003c4;</mml:mi></mml:math></inline-formula> were &#x003b3;&#x000a0;&#x0223c;&#x000a0;10 mN/m, which is significantly lower than &#x003b3;&#x000a0;=&#x000a0;50 mN/m of the fully hydrated shell. These results indicate that the shell does not instantly disintegrate; instead, the presence of a partially intact shell modulates the dissolution time <inline-formula><mml:math id="M10" altimg="si7.svg"><mml:mi>&#x003c4;</mml:mi></mml:math></inline-formula> of the gas core. For example, even though the optical resolution was not sufficient to observe the shell dissolution for most PMBs, the hydration of the shell in some abnormally large PMBs could be visually decoupled from its gas core (Fig. 2H, I). Here a partially disintegrated shell still possessed an intact inner surface to stabilize the gas core and hamper its shrinkage. Although these were extreme examples, it is possible that similar effects still occur for the smaller PMBs to a lesser degree. Evidence of shell hydration rates affecting the gas dissolution time &#x003c4; is further illustrated by the fact the dissolution time &#x003c4; was significantly longer when the PBS was pH 7.4 than when it was pH 10 (<xref rid="f0010" ref-type="fig">Fig. 2J</xref>). Since the shell hydration can be viewed in terms of an acid-based reaction with a fixed acid (COOH) concentration, the hydration rate is positively related to the concentration of OH<sup>-</sup>s, which were lower with pH 7.4 buffer. Consequently, shell hydration proceeded more slowly at lower pH buffer, limiting dissolution of the gas core and resulting in the longer &#x003c4; as observed.</p></sec></sec><sec id="s0030"><label>2.2</label><title>Dissolved PMBs resulted in supersaturation</title><p id="p0085">Since the pH triggers overpressure of the gas cores, it is expected that the dissolution of PMBs in an already saturated fluid will lead to supersaturation. To test this prediction, we measured the continuous change of dissolved oxygen content (pO<sub>2</sub>) prior and after administering air-filled PMBs in PBS (pH&#x000a0;=&#x000a0;7). At the beginning, both PMB D10 solution and PBS were equilibrated with room air and showed identical pO2 of 153&#x000a0;&#x000b1;&#x000a0;3 mmHg. As in <xref rid="f0010" ref-type="fig">Fig. 2K</xref>, adding 0.5&#x000a0;ml PMBs (6&#x000a0;%, 15&#x000a0;&#x003bc;l air) to PBS (8&#x000a0;ml) under stirring, the pO2 of bulk PBS solution rapidly increased by&#x000a0;&#x0223c;&#x000a0;12&#x000a0;mmHg (thus an estimated&#x000a0;&#x0223c;&#x000a0;60&#x000a0;mmHg of total gas content including oxygen and nitrogen), indicating dissolution of PMBs raised dissolved air content above saturation. The supersaturated gas gradually outgassed under continuous stirring (500&#x000a0;rpm), while the pO2 remained slightly elevated after 20&#x000a0;min (<xref rid="f0010" ref-type="fig">Fig. 2J</xref>). We then tested whether increasing the dosage of PMBs may further increase supersaturation. As in <xref rid="f0010" ref-type="fig">Fig. 2K</xref>, in a 3-repeat rapidly dosing, the first two doses collectively raised the pO2 by&#x000a0;&#x0223c;&#x000a0;20&#x000a0;mmHg (an estimated&#x000a0;&#x0223c;&#x000a0;100&#x000a0;mmHg in total gas content), however, following the third dose, a rapid decrease in pO2 was observed, accompanied by sudden appearance of large bubbles that are readily visible (<xref rid="f0010" ref-type="fig">Fig. 2M</xref>), which accelerated the removal of dissolved gas from supersaturated solution. It is worthwhile to note that due to the rapid outgassing of dissolved gas and slow response of the probe, the measured increase in partial gas pressure of the bulk fluids likely underestimated the degree of supersaturation or dynamic flux at microscopic level, which may be significant for the formation of BNBs. Nonetheless, these results confirm that PMBs delivered gas to produce supersaturation.</p></sec><sec id="s0035"><label>2.3</label><title>Detection of acoustically active BNBs</title><p id="p0090">Next, we test whether the supersaturated solution after dissolving PMBs produces acoustically detectable BNBs. In this test, we administered various concentrations of air-filled PMBs to pre-saturated pH7.4 PBS and monitored their acoustic response only after the added PMBs were fully dissolved. <xref rid="f0015" ref-type="fig">Fig. 3A</xref> showed that various concentrations of PMBs completely dissolved within 3&#x000a0;s, as indicated by the rapid disappearance of opacity. To eliminate the potential acoustic interference by undissolved PMBs or nucleated MBs, we performed a transmission/attenuation test to confirm the dissolution kinetics of PMBs, as this test used a non-destructive excitation (frequency range of 0.25 to 40&#x000a0;MHz) that is highly sensitive to detect trace of micron-sized gas cavities [<xref rid="b0200" ref-type="bibr">40</xref>]. Upon adding 50&#x000a0;% PMBs to the PBS buffer, the transmitted signals recovered to baseline in less than 3&#x000a0;s, indicating the absence of PMBs or other micron-sized cavities (<xref rid="f0015" ref-type="fig">Fig. 3B</xref>). To acoustically detect BNBs, we used a setup as shown in <bold>Fig. S4</bold>, in which a passive acoustic detector was placed at 90&#x000b0; to the direction of a focused transducer (<italic>f</italic><sub>0</sub>&#x000a0;=&#x000a0;3.5&#x000a0;MHz). PBS solutions post complete dissolution of PMBs at various concentrations were subject to repeated ramp tests over time; by ramping up the incident acoustic power (i.e., the peak negative pressure) (each ramp test last&#x000a0;&#x0223c;&#x000a0;1 min), we monitored changes in both sub-harmonic emission (SHE) (i.e., 1.75&#x000a0;MHz) and broadband noise as respective indicators for identifying nonlinear stable cavitation and inertial cavitation from potential gas cavities [<xref rid="b0200" ref-type="bibr">40</xref>,<xref rid="b0205" ref-type="bibr">41</xref>].<fig id="f0015"><label>Fig. 3</label><caption><p><bold>A,</bold> Photos showing administering various concentration of PMBs in pH7.4 PBS solutions led to rapid dissolution as shown by the rapid disappearance of their opacity. <bold>B</bold>, Acoustic transmission measurement (frequency range 0.25 to 40&#x000a0;Hz) upon adding 50&#x000a0;% PMBs to pH7.4 PBS solution showed that complete dissolution occurred in less than 3&#x000a0;s. <bold>C</bold>-<bold>F</bold>: Detection of SHE under different acoustic pressures in PBS solutions at different time points post dissolving various concentrations of PMBs (f<sub>0</sub>&#x000a0;=&#x000a0;3.5&#x000a0;MHz). The observed SHE occurring with high cavitation inception thresholds was indicative of formation of nanosized gas cavities. <bold>G</bold>, Nanoparticle Tracking Analysis (NTA) of the PBS solution (administering 10&#x000a0;&#x000b5;L of 50&#x000a0;% PMBs into 1.5&#x000a0;mL PBS, <bold>F</bold>) showed the prolonged presence of small BNBs with a mean size&#x000a0;&#x0223c;&#x000a0;100&#x000a0;nm.</p></caption><graphic xlink:href="gr3" id="lk00015"/></fig></p><p id="p0095">As in Fig. 3C-F<bold>,</bold> for all PMB concentrations tested, we observed the strongest SHE under high acoustic power when the PBS solution was excited 5&#x000a0;s post administering PMBs. While the SHE response decreased over time especially when lower dose of PMBs were administered (5&#x000a0;% and 10&#x000a0;%, Fig. 3C, D), however, at higher dose at 25&#x000a0;% and 50&#x000a0;%, prominent SHE remained observable 2&#x000a0;min post PMB administration (Fig. 3E, F). The observed cavitation threshold in SHE response was substantially higher than that of CMBs [<xref rid="b0210" ref-type="bibr">42</xref>], typically observable below 200&#x000a0;kPa (as shown in <bold>Fig. S5</bold>). Instead, here SHE was observed only at&#x000a0;&#x0223c;&#x000a0;1,500&#x000a0;kPa with 5&#x000a0;% and 10&#x000a0;% of PMBs and at&#x000a0;&#x0223c;&#x000a0;600&#x02013;&#x02013;&#x02013;800&#x000a0;kPa with 25&#x000a0;% and 50&#x000a0;%, thus ruling out the presence of large micron-sized bubbles developed from supersaturation or undissolved PMBs, corroborating with the transmission test in <xref rid="f0015" ref-type="fig">Fig. 3B</xref>. For instance, the 50&#x000a0;% PMBs treated solution showed strong SHE signals (up to 7&#x000a0;dB) 2&#x000a0;min post PMB administration (<xref rid="f0015" ref-type="fig">Fig. 3F</xref>), with a cavitation threshold around&#x000a0;&#x0223c;&#x000a0;800&#x000a0;kPa, which is consistent with theoretical values for gas cavities on the order of several hundred nanometers, i.e., BNBs [<xref rid="b0215" ref-type="bibr">43</xref>]. Besides transmission test, the observed acoustic response also ruled out the presence of intact PMBs, which should have exhibited much higher cavitation threshold and much slower increase in SHE due to the presence of the hard shell (<bold>Fig. S6</bold>) [<xref rid="b0200" ref-type="bibr">40</xref>]. In the 50&#x000a0;% PMBs treated PBS solution, the SHE decreased over time with the threshold approaching&#x000a0;&#x0003e;&#x000a0;2 M Pa yet remained observable, i.e., 2&#x000a0;dB at 5&#x000a0;min and 1&#x000a0;dB up to 20&#x000a0;min, suggesting the persistent existence of small gas cavities. Taken together, these results provided evidence for the existence of acoustically active BNBs post dissolution of PMBs, which were revealed to be transitorily stable.</p><p id="p0100">To corroborate the BNBs detected by acoustic studies, we performed nanoparticle tracking analysis (NTA) with the 50&#x000a0;% PMBs treated PBS solution. For practical reasons, we were unable to obtain NTA measurement in less than 5&#x000a0;min post dissolving PMBs, however, the solutions after 5&#x000a0;min revealed the existence of BNBs with a size range between 50 &#x02013; 150&#x000a0;nm (<xref rid="f0015" ref-type="fig">Fig. 3G</xref>). BNBs of this size range are often associated with good longevity, and indeed the number of the BNBs in this solution did not significantly change over time. However, BNBs of this size range will possess an unusually high cavitation inception threshold [<xref rid="b0215" ref-type="bibr">43</xref>,<xref rid="b0220" ref-type="bibr">44</xref>], and it is unlikely that they contributed to the majority of our detected SHE signals in <xref rid="f0015" ref-type="fig">Fig. 3F</xref><bold>,</bold> although their existence may explain the minor increase in SHE above 2&#x000a0;M Pa excitation. Because it was known that in non-equilibrium state larger BNBs may disappear faster due to continuous growth and higher buoyance [<xref rid="b0155" ref-type="bibr">31</xref>], thus we hypothesized that dissolution of PMBs likely produced BNBs of multiple size ranges, where a population of BNBs of larger size have existed to account for most of the observed acoustic signals but were only transitorily stable and not detected by NTA.</p></sec><sec id="s0040"><label>2.4</label><title>Salt effect on stabilizing acoustically active BNBs</title><p id="p0105">To show the majority of detected acoustic response resulted from larger sized and transiently stable BNBs, we investigated the BNB formation by dissolving PMBs in concentrated salt solution. Because salts are known to stabilize BNBs, [<xref rid="b0225" ref-type="bibr">[45]</xref>, <xref rid="b0230" ref-type="bibr">[46]</xref>, <xref rid="b0235" ref-type="bibr">[47]</xref>, <xref rid="b0240" ref-type="bibr">[48]</xref>] they may prolong the half-life of larger BNBs formed post dissolution of PMBs, thus making it easier to detect by acoustic study and NTA. The acoustic response of PMB in 2x PBS was similar to PBS, where no cavitation was found below 600&#x000a0;kPa (<xref rid="f0020" ref-type="fig">Fig. 4A</xref><bold>),</bold> again characteristic of nanosized gas cavities. In 5x and 10x PBS, however, the acoustic response was markedly different and prolonged (Fig. 4B, C). First, an early SHE spike was observable at the lowest acoustic pressure tested (20&#x000a0;kPa) at early timepoint of 5&#x000a0;s post PMB administration, indicative of the presence of MBs. Because the intact PMBs have a much higher cavitation threshold close to 1&#x000a0;M Pa (<bold>Fig. S6</bold>), the observed MBs likely resulted from partially dissolved PMBs or nucleated large bubbles by supersaturation, due to the transitory stabilizing effect by salts. However, the early SHE spikes due to MBs disappeared quickly so that over time the observed thresholds of SHE became characteristic of BNBs, similar to that in 1x PBS as in <xref rid="f0015" ref-type="fig">Fig. 3C</xref>. Overall, we found a general trend between prolonged SHE signals and either higher PMB concentrations or higher salt concentrations. In 5x and 10x PBS, long after the dissolution of PMBs, persistent SHE signals from BNBs were seen for extended period (Fig. 4B, C). Notably, in 10x PBS, at 50&#x000a0;% PMBs, greater than 3&#x000a0;dB of SHE signals was detected at 60-minute post dissolving PMBs. For any given administered dose of PMBs, the maximum amplitude of signals decreased over time, indicating the number of acoustically active BNBs slowly decreased; and the cavitation threshold for SHE signals gradually increased, suggesting the size of remaining BNBs became smaller. Both trends were similar in 1x PBS but much more prolonged, indicating acoustically active BNBs were stabilized by high salt concentrations.<fig id="f0020"><label>Fig. 4</label><caption><p><bold>A-C</bold>, Plots of SHE versus acoustic pressure for different doses of PMBs dissolved in PBS solutions of different salt concentrations. Higher salt concentrations stabilize the gas bubbles and lead to prolonged acoustic response. Black arrows were used to mark examples of high inception thresholds indicative of cavitation of nanosized cavities (NBs); red arrows were used to mark examples of low inception thresholds indicative of the presence of micro-sized bubbles (MBs), not all curves were labelled. Note the detection of MBs was short-lived and the acoustic signals characteristic to BNBs were observable over long period of time. <bold>D</bold>, NTA performed on 50% PMB-dissolved in 10x PBS at different times, revealed the BNBs initially had a wide size distribution and their mean sizes gradually decreased. <bold>E</bold>, Populations of different sized bubbles over time, showing that number of larger sized BNBs rapidly decreased, consistent with the trend of the acoustic measurements. <bold>F</bold>, Comparison between the theoretical cavitation threshold of bulk NBs of various sizes and experimentally observed threshold obtained in 50% PMB-dissolved in 10x PBS at different time points, showing the trend of increasing cavitation thresholds of the solution is consistent with the size evolution trend observed by NTA.</p></caption><graphic xlink:href="gr4" id="lk00020"/></fig></p><p id="p0110">Next, to confirm the size evolution of BNBs as inferred from acoustic study, we conducted NTA measurements on 50&#x000a0;% PMB treated 10x PBS as a function of time (Fig. 4D, E<bold>).</bold> At 5-min post dissolving the PMBs, we observed polydisperse BNBs between 20&#x02013;900&#x000a0;nm, and the presence of BNBs with upper size limit was consistent with the acoustic finding that low but detectable SHE signals were observable below 600&#x000a0;kPa. NTA showed the larger sized BNB (&#x0003e; 150&#x000a0;nm) were less stable and decreased over time (<xref rid="f0020" ref-type="fig">Fig. 4E</xref>), in agreement with the trend in acoustic response, i.e., increased cavitation threshold and decreased amplitude. In contrast, the small sized BNBs (&#x0003c; 150&#x000a0;nm) remained stable, similar to those found in 1x PBS (<xref rid="f0010" ref-type="fig">Fig. 2D</xref>), were hence shown not responsible for most detected acoustic activities.</p><p id="p0115">Next, we calculated the theoretical cavitation threshold of various sizes of BNBs at different incidence frequencies based on Hong and Son&#x02019;s model [<xref rid="b0215" ref-type="bibr">43</xref>]. Using the experimentally observed cavitation thresholds over 30&#x000a0;min post administering 50&#x000a0;% PMB in 10x PBS solution in <xref rid="f0020" ref-type="fig">Fig. 4C</xref>, we plotted theoretical sizes of BNBs at different time points in <xref rid="f0020" ref-type="fig">Fig. 4</xref>
<bold>F</bold>, which predicted the mean size of acoustically active BNBs gradually decreased from between 300 to 150&#x000a0;nm, showing a similar trend of size evolution as indicated by NTA. It is worth mentioning that in <xref rid="f0020" ref-type="fig">Fig. 4C</xref>, the same solution was repeatedly exposed to US excitation over time, thus each ramp test likely preferentially destructed the larger sized BNB, while the NTA measurement of the solution were conducted with solution without US treatment, thus a smaller fraction of larger sized BNBs remained observable at 30&#x000a0;min. However, most importantly, both NTA and acoustic study evidenced a similar trend in the size evolution of BNBs. Taken together, NTA and acoustic studies established that the dissolution of PMBs led to in situ formation of BNBs of various sizes, where the larger BNBs were highly acoustic active but have only transitory stability, while the smaller ones were more stable but acoustically less active.</p></sec><sec id="s0045"><label>2.5</label><title>Dynamic pressure response of in situ generated BNBs</title><sec id="s0050"><label>2.5.1</label><title>Optimization of nonlinear acoustic response of BNBs</title><p id="p0120">While the acoustically active BNBs are transitory, we hypothesized that continuous administration of PMBs could steadily supply BNBs as acoustic reporters for pressure sensing. To test this hypothesis, we created an in vitro model to simulate the typical cardiovascular pressure cycles by circulating physiological buffer in plastic tubing using a peristaltic pump to produce physiological-relevant dynamic pressure cycles (<bold>Fig. S7</bold>). Air-loaded PMBs were administered through a needle via syringe pump at a constant rate, as shown in <xref rid="f0025" ref-type="fig">Fig. 5A</xref>. The focal point of the focused ultrasound transducer was placed at the center of the tubing as the region of interest (ROI), and a pressure catheter was placed right to it for validation. The acoustic response was captured using a separate ultrasound imaging probe. Based on our findings under static conditions, only a small number of PMBs were administered into the fluid so that they could fully dissolve prior reaching the ROI, otherwise undissolved PMBs nucleated larger bubbles could lead to signal attenuation. We tested PMBs with two different mean sizes (<xref rid="f0025" ref-type="fig">Fig. 5</xref>, <xref rid="f0020" ref-type="fig">Fig. 4</xref> &#x003bc;m and 11&#x000a0;&#x003bc;m; the latter has slower dissolution kinetics due to larger size) at different concentrations and varying distances to ROI and monitored SHE by quickly ramping up the acoustic pressure (Fig. 5C-F). For the 4&#x000a0;&#x003bc;m PMBs tested in the previous sections, we observed the maximal acoustic response at 1 and 2&#x000a0;% with a profile similar to those under static conditions and a cavitation threshold of&#x000a0;&#x0223c;&#x000a0;700&#x000a0;kPa (indicative of BNBs) and a total enhancement of&#x000a0;&#x0223c;&#x000a0;13&#x000a0;dB at 1500&#x000a0;kPa (<xref rid="f0025" ref-type="fig">Fig. 5C</xref>). The &#x0201c;S-curve&#x0201d; shape of the plot SHE vs. acoustic pressure is reminiscent of elastic microbubbles [<xref rid="b0245" ref-type="bibr">49</xref>,<xref rid="b0250" ref-type="bibr">50</xref>] with three clearly identifiable stages of occurrence, growth, and saturation, but with a significantly higher cavitation threshold. Interestingly, the power spectra (<xref rid="f0025" ref-type="fig">Fig. 5G</xref>) show an increase in SHE without broadband noise, indicating free from inertial cavitation. In comparison, as anticipated, increasing the gas content by infusing 4 to 15&#x000a0;% PMBs led to a decrease in SHE due to attenuation (<xref rid="f0025" ref-type="fig">Fig. 5C</xref>). Because the dissolution of PMBs is kinetically dependent, we tested the acoustic response at ROI as a function of the distance to the injection site (<xref rid="f0025" ref-type="fig">Fig. 5E</xref>). Little change in SHE was observed for administering 4&#x000a0;&#x003bc;m PMBs after increasing this distance from 4 to 11&#x000a0;cm; at 19&#x000a0;cm, slight elevation in SHE was observed at low acoustic pressures, likely indicating larger bubbles nucleating from the supersaturated solution. In the case of infusing 11&#x000a0;&#x003bc;m PMBs (<xref rid="f0025" ref-type="fig">Fig. 5D</xref>), 1 and 2&#x000a0;% resulted SHE response similar to that of the 4&#x000a0;&#x003bc;m PMBs, the response was maximum at 4&#x000a0;% (&#x0223c;17&#x000a0;dB at 1500&#x000a0;kPa) and attenuated at 9 and 15&#x000a0;%. With 4&#x000a0;% 11&#x000a0;&#x003bc;m PMBs, a small SHE increases evident below 500&#x000a0;kPa suggests the presence of MBs likely due to the slower dissolution because of their larger size. Varying the distance between ROI and injection of 2&#x000a0;% 11&#x000a0;&#x003bc;m PMBs showed an increase in SHE at 4&#x000a0;cm at a relatively low acoustic pressure (<xref rid="f0025" ref-type="fig">Fig. 5F</xref>), suggesting that the larger 11&#x000a0;&#x003bc;m PMBs take longer time to dissolve and may reach the ROI before dissolution. The presence of larger bubbles was also indicated by the presence of broadband noise in the power spectra (<xref rid="f0025" ref-type="fig">Fig. 5H</xref>). When the injection site was moved to 11 and 19&#x000a0;cm, the SHE signals from MBs were no longer observable, indicating full dissolution (<xref rid="f0025" ref-type="fig">Fig. 5F</xref>). Taken together, these results indicate that the acoustic response of the in situ generated BNBs at the ROI can be tuned and optimized by varying the sizes and the concentrations or flux of infused PMBs. For the proof-of-concept study, we selected 4&#x000a0;&#x003bc;m PMBs at 4&#x000a0;% at 11&#x000a0;cm for subsequent pressure sensing.<fig id="f0025"><label>Fig. 5</label><caption><p><bold>A</bold>, In vitro model designed to simulate typical cardiovascular pressure cycles. Physiological buffer is circulated through plastic tubing using a roller pump to create dynamic pressure cycles that resemble physiological conditions. Air-loaded PMBs are administered as BNB precursors through a needle via a syringe pump at a constant rate. <bold>B</bold>, Size distribution analysis of PMBs with diameters of 4&#x000a0;&#x000b5;m and 11&#x000a0;&#x000b5;m, <bold>C, D</bold>, SHE-acoustic pressure relationship for different concentrations of 4&#x000a0;&#x000b5;m (<bold>C</bold>) and 11&#x000a0;&#x000b5;m (<bold>D</bold>). SHE was measured in an ROI 11&#x000a0;cm from the injection point. <bold>E, F</bold>, SHE-acoustic pressure relationship measured at ROI at different distances from the injection site by infusion 2&#x000a0;% of 4&#x000a0;&#x000b5;m PMBs (<bold>E</bold>) and 11&#x000a0;&#x000b5;m PMBs (<bold>F</bold>). <bold>G</bold>, The power spectra obtained by infusing 4&#x000a0;&#x000b5;m PMBs (2&#x000a0;%, 11&#x000a0;cm) showed that stable cavitation of BNBs maintained at acoustic pressures up to 1950&#x000a0;kPa without observable broadband noise produced by inertial cavitation. &#x0201c;PMB&#x0201d; and &#x0201c;BL&#x0201d; indicate spectra with and without administered PMBs. <bold>H</bold>, The power spectra obtained by infusing 11&#x000a0;&#x000b5;m PMBs (4&#x000a0;cm, 2&#x000a0;%) revealed broadband noise indicative of inertial cavitation of large MBs.</p></caption><graphic xlink:href="gr5" id="lk00025"/></fig></p></sec><sec id="s0055"><label>2.5.2</label><title>Dynamic pressure sensing</title><p id="p0125">Next, we tested whether in situ generated BNBs can be used as acoustic pressure sensors to monitor dynamic changes of hydrostatic pressure. We first tested SHE-hydrostatic pressure relationships of BNBs under various acoustic pressures, as shown in <xref rid="t0005" ref-type="table">Table 1</xref>. When pressure was dynamically cycled between 0 to 100&#x000a0;mmHg, good negative correlations (R<sup>2</sup>&#x000a0;&#x0003e;&#x000a0;0.8) were obtained under a broad range of acoustic pressure (768&#x02013;1920&#x000a0;kPa). For example, at 1536&#x000a0;kPa (MI = 0.82) the SHE showed an excellent 0.11&#x000a0;dB per mmHg change, where a scatter plot SHE vs. hydrostatic pressure was shown in <xref rid="f0030" ref-type="fig">Fig. 6A</xref>. <xref rid="f0030" ref-type="fig">Fig. 6B</xref> shows the hydrostatic pressure vs. time measured with the catheter overlayed with the SHE. To confirm that the signals arose from BNBs instead of undissolved PMBs, we tested the acoustic response of intact PMBs of various concentrations by circulating them in D10 solution in the same experimental setup. The intact PMB had a weaker SHE response and failed to exhibit any dependence of SHE on hydrostatic pressure (<xref rid="f0030" ref-type="fig">Fig. 6A</xref>). These findings support that the detected acoustic response to pressure change was due to in situ generated BNBs. We also tested the SHE-hydrostatic pressure response over a narrower pressure range between 53 &#x02013; 83&#x000a0;mmHg in the same setup<bold>,</bold> which showed a nearly identical SHE response with a R<sup>2</sup> 0.86 and sensitivity 0.1&#x000a0;dB/mmHg (<xref rid="f0030" ref-type="fig">Fig. 6C</xref><bold>)</bold>. We also noticed that emissions at the 2nd harmonic showed an excellent inverse correlation with hydrostatic pressure (Fig. 6D, E), albeit with much lower sensitivity. However, this reduced sensitivity may have been due to our receiving transducer (center frequency: 2.5&#x000a0;MHz) being less sensitive to the high frequency of the 2nd harmonic signals.<table-wrap position="float" id="t0005"><label>Table 1</label><caption><p>R<sup>2</sup> and sensitivity for the plots of SHE vs. hydrostatic pressure.</p></caption><table frame="hsides" rules="groups"><thead><tr><th>Incident acoustic pressure [kPa]</th><th><italic>R<sup>2</sup></italic></th><th>Sensitivity [dB/mmHg]</th></tr></thead><tbody><tr><td>384</td><td>0.53&#x000a0;&#x000b1;&#x000a0;0.04</td><td>0.03&#x000a0;&#x000b1;&#x000a0;0.01</td></tr><tr><td>768</td><td>0.7&#x000a0;&#x000b1;&#x000a0;0.02</td><td>0.05&#x000a0;&#x000b1;&#x000a0;0.02</td></tr><tr><td>1152</td><td>0.81&#x000a0;&#x000b1;&#x000a0;0.11</td><td>0.09&#x000a0;&#x000b1;&#x000a0;0.01</td></tr><tr><td>1344</td><td>0.7&#x000a0;&#x000b1;&#x000a0;0.01</td><td>0.08&#x000a0;&#x000b1;&#x000a0;0.01</td></tr><tr><td>1536</td><td>0.84&#x000a0;&#x000b1;&#x000a0;0.03</td><td>0.11&#x000a0;&#x000b1;&#x000a0;0.01</td></tr><tr><td>1920</td><td>0.8&#x000a0;&#x000b1;&#x000a0;0.02</td><td>0.11&#x000a0;&#x000b1;&#x000a0;0.001</td></tr></tbody></table></table-wrap><fig id="f0030"><label>Fig. 6</label><caption><p><bold>In situ generated BNBs as acoustic pressure sensors. A</bold>, Scatter plots showing BNBs exhibited a negative linear correlation with hydrostatic pressure at 1536&#x000a0;kPa with a sensitivity of 0.11&#x000a0;dB/mmHg between 0 and 100&#x000a0;mmHg; intact PMBs themselves showed lower SHE signals without clear dependence on hydrostatic pressure. <bold>B</bold>, Plot of SHE as a function of time overlaid on a plot of hydrostatic pressure measured with a pressure catheter. <bold>C</bold>, The SHE-hydrostatic pressure relationship for in situ generated BNBs over a narrower pressure range of 53&#x02013;83&#x000a0;mmHg showing a similar pressure sensing response. <bold>D, E</bold>, The 2nd harmonic also showed a negative linear correlation to hydrostatic pressure, albeit with much decreased sensitivity using the current detection conditions.</p></caption><graphic xlink:href="gr6" id="lk00030"/></fig></p><p id="p0130">Finally, we performed a proof-of-concept study to evaluate in situ generated BNBs for intracardiac pressure monitoring using an ex vivo Langendorff heart model (<xref rid="f0035" ref-type="fig">Fig. 7A</xref>). In this model as previously established by us [<xref rid="b0255" ref-type="bibr">51</xref>], the left atrium of a rat heart was cannulated via a preload block with adjustable diastolic pressure to circulate Krebs buffer via left ventricle (LV) into cannulated aorta. A pressure&#x02013;volume catheter was placed in the LV via apical puncture and BNBs were supplied into the LV by infusing air-filled 5&#x000a0;% (4&#x000a0;&#x000b5;m) PMBs at a flow rate of 0.2&#x000a0;ml/min via a syringe pump. The focused US transducer was manually adjusted to target the center cavity of the LV, and a separate imaging probe was used to record the SHE. An acoustic pressure of 1536&#x000a0;kPa was used. The LV pressure varied from 0 to 80&#x000a0;mmHg; the heart rate was 3&#x000a0;&#x0223c;&#x000a0;4 Hz.<fig id="f0035"><label>Fig. 7</label><caption><p><bold>In situ generated BNBs to monitor intracardiac pressures. A</bold>. A photo of an ex vivo working rat heart model using a Langendorff system. The cavity of the LV was targeted by a focused transducer. NB precursors were infused at 0.2&#x000a0;ml/min using 5&#x000a0;% PMBs. <bold>B</bold>, Scatter plots showing the SHE of in-situ generated BNBs has a negative linear correlation with hydrostatic pressure at an acoustic pressure of 1536&#x000a0;kPa (R<sup>2</sup>&#x000a0;=&#x000a0;0.94), and a sensitivity of 0.2&#x000a0;dB per mmHg. <bold>C</bold>, Overlay of dynamic pressure measurements from a catheter with the pressure converted from SHE acoustic data. <bold>D,</bold> The power spectra showed stable cavitation by in situ generated BNBs maintained up to 1954&#x000a0;kPa with minimal broadband noise due to inertial cavitation.</p></caption><graphic xlink:href="gr7" id="lk00035"/></fig></p><p id="p0135">Consistent with the in vitro model, scatter plots from the experimental data revealed an inverse linear correlation (R<sup>2</sup>&#x000a0;=&#x000a0;0.94) between SHE and hydrostatic pressure and an excellent sensitivity of&#x000a0;&#x0223c;&#x000a0;0.2&#x000a0;dB/mmHg (<xref rid="f0035" ref-type="fig">Fig. 7B</xref>). <xref rid="f0035" ref-type="fig">Fig. 7C</xref> shows the acoustically-derived pressure curve overlayed on the catheter measurements during one experiment. Power spectra obtained at various acoustic pressures (<xref rid="f0035" ref-type="fig">Fig. 7D</xref>) showed prominent SHE signals with little or no evident broadband noise at pressures up to 1954&#x000a0;kPa, indicating that in situ generated NBs maintained stable cavitation during acoustic excitation and diminished the risks of destructive bioeffects associated with inertial cavitation. Overall, our results collectively demonstrate that in situ generated BNBs via dissolution of PMBs can be used as a novel acoustic pressure reporter for monitoring physiological pressures.</p></sec></sec></sec><sec id="s0060"><label>3</label><title>Discussion</title><p id="p0140">Supersaturation was shown to be effective to produce quasi-stable BNBs [<xref rid="b0155" ref-type="bibr">[31]</xref>, <xref rid="b0160" ref-type="bibr">[32]</xref>, <xref rid="b0165" ref-type="bibr">[33]</xref>], however, BNBs were usually produced in low concentrations that limit their use for medical ultrasound [<xref rid="b0120" ref-type="bibr">24</xref>,<xref rid="b0140" ref-type="bibr">28</xref>]. In this work, we showed that the rapidly dissolving PMBs deliver local supersaturation and produce in situ generated BNBs as acoustic pressure sensors. Using the classic Epstein-Plesset model we have identified major steps in affecting the dissolution behaviors of individual PMBs, in which, the driving force was initiated by the pH-induced shell hydration which increases surface tension. The resultant Laplace pressure produces higher concentration gradient at the gas core, driving its dissolution into the surrounding fluid, resulting in supersaturation (Fig. 2J, K). The formation of BNBs in PBS buffer after dissolving PMBs was first evidenced by acoustic detection of transient SHE response with a cavitation threshold characteristic of nanosized gas bubbles, theoretically on the orders of several hundreds of nanometers [<xref rid="b0215" ref-type="bibr">43</xref>] (<xref rid="f0020" ref-type="fig">Fig. 4F</xref>). The transitory signals implies that acoustic BNBs were short-lived. These observations are consistent with literature, as it is known that thermodynamically unstable BNBs can form and grow to a range of sizes, where larger BNBs tend to eliminate more quickly due to propensity for continuous growth and higher buoyance [<xref rid="b0155" ref-type="bibr">31</xref>], while smaller BNBs, e.g., &#x0223c;100&#x000a0;nm, can possess great longevity [<xref rid="b0120" ref-type="bibr">24</xref>,<xref rid="b0125" ref-type="bibr">25</xref>,<xref rid="b0260" ref-type="bibr">52</xref>]. Not surprisingly, NTA measurement of PMB-treated PBS solution only revealed small BNBs, which are less acoustic active due to their small size. However, using concentrated salt solutions that provide a stronger stabilizing effect to BNBs, we were able to delay the disappearance of the transiently stable BNBs, where NTA (<xref rid="f0020" ref-type="fig">Fig. 4D</xref>) and acoustic measurement (Fig. 4A-C) together confirmed that dissolution of PMBs led to formation of various sized BNBs, and that the larger BNBs had shorter lifespan and contributed to the majority of observed SHE signals.</p><p id="p0145">As proof-of-concept, we demonstrated the utility of BNBs as acoustic pressure sensors. To date, the most successful technique to measure pressure relies on the SHE response of commercially available CMBs, as pioneered by Forsberg group [<xref rid="b0020" ref-type="bibr">4</xref>,<xref rid="b0265" ref-type="bibr">[53]</xref>, <xref rid="b0270" ref-type="bibr">[54]</xref>, <xref rid="b0275" ref-type="bibr">[55]</xref>]. It was found the SHE response of CMBs is dependent on the material compositions, while an inverse correlation between SHE and hydrostatic pressure is considered as an ideal response and was only noted in select CMBs. Here, the SHE of BNBs and hydrostatic pressure revealed a well correlated inverse linear relationship. Notably, in a fast-beating Langendorff heart (3&#x02013;4 beat per second), the SHE of in situ generated BNBs showed excellent sensitivity (up to 0.2&#x000a0;dB/mmHg), significantly higher than those reported in literature with CMBs (between 0.02 to 0.07&#x000a0;mmHg) [<xref rid="b0280" ref-type="bibr">56,57</xref>]. In our tested pressure range between 0 to 120&#x000a0;mmHg, the best linear relationship was found above 10&#x000a0;mmHg, although the response appeared to be less reliable at lower pressure, which may be further improved via optimizing the dosage and PMB sizes. The high sensitivity of CMBs may be due to their inherently large surface area to volume ratio and lack of a dampening shell. Several differences between BNBs and CMBs are noticeable. First, much higher acoustic energy was required to exceed the cavitation threshold of BNBs to produce SHE due to their smaller size. Second, unlike most CMBs, even when SHE approached saturation under high acoustic energy excitation, the BNBs appeared to be free from inertial cavitation, as evidenced by the absence of broadband noise (<xref rid="f0025" ref-type="fig">Fig. 5G</xref> and <xref rid="f0035" ref-type="fig">Fig. 7D</xref>). This phenomenon may be beneficial for safety reason because inertial cavitation of CMBs is common and known for harmful bioeffects. In addition, unlike CMBs, because PMBs rapidly dissolve to avoid potential pulmonary obstruction and can be continuously infused in large volume [<xref rid="b0145" ref-type="bibr">29</xref>], they may be advantageous for prolonged or repeated pressure monitoring.</p><p id="p0150">More work is required to better understand the interplays among dissolution kinetics, supersaturation and BNB formation. With the current material compositions of PMBs, the hydration of the shell occurred gradually and significantly slowed the dissolution rate of the gas core. Because surface tension and the overpressure of the gas core are dictated by the hydration stage of the shell and bubble size, they may ultimately affect the ability of PMBs to produce supersaturation, especially the flux in their microscopic surroundings, which may then in turn affect the formation of BNBs. These phenomena may be studied in future by tuning the dissolution kinetics of PMBs via varying the shell materials and their sizes. While this work described the dissolution behavior of a single PMB, more studies are needed to investigate how dissolution of individual PMBs may be altered by co-dissolving PMBs in their vicinity, as well as how such collective distribution of dissolution kinetics affect supersaturation and formation of BNBs in nonequilibrium states, as well as the influences of other parameters e.g., temperature and mechanical mixing. Based on others&#x02019; work [<xref rid="b0155" ref-type="bibr">[31]</xref>, <xref rid="b0160" ref-type="bibr">[32]</xref>, <xref rid="b0165" ref-type="bibr">[33]</xref>], it is reasonable to believe that the observed BNBs were developed through nucleation from the supersaturated solution post dissolving PMBs. It may also be plausible that a dissolving PMB, experiencing a high gas gradient and flux in its microscopic surrounding due to dissolution of adjacent PMBs, may be directly stabilized as BNB. Therefore, more work is needed to gain more mechanistic insight into the formation of BNBs as well as tuning their acoustic response to optimize their pressure sensing in vivo.</p></sec><sec id="s0065"><label>4</label><title>Conclusions</title><p id="p0155">To summarize, we have presented a novel approach for in situ delivery of acoustically active BNBs that can function as acoustic pressure sensors. To advance these findings toward clinical translation, future studies will focus on optimizing their performance in in vivo models, particularly through the development of standardized pulse parameters and calibration protocols. In addition, the underlying mechanism for BNB formation relies on a triggered surface tension change that dissolves a pre-stabilized gas core to induce local supersaturation. This mechanism offers an alternative strategy for BNB fabrication and may extend their use beyond biomedicine. We anticipate that the concept of on-demand BNB generation may create new opportunities to explore applications across diverse fields.</p></sec><sec id="s0070"><label>5</label><title>Materials and methods</title><sec id="s9000"><label>5.1</label><title>Materials</title><p id="p0160">All chemicals and reagents were purchased from Millipore Sigma are used as received.</p></sec><sec id="s0075"><label>5.2</label><title>PMBs fabrication</title><p id="p0165">The synthesis of modified dextran was conducted using a previously reported procedure [<xref rid="b0130" ref-type="bibr">26</xref>]. Briefly, dextran (MW 6&#x000a0;k Da, 5&#x000a0;g) and 4-dimethylaminopyridine (16&#x000a0;g) were added to react with 1.4&#x000a0;g of succinic anhydride and 5&#x000a0;ml of acetic anhydride in 60&#x000a0;ml of anhydrous DMSO at 55&#x000a0;&#x000b0;C for 12&#x000a0;h. The reaction mixture was then precipitated in acidic water and subsequently washed by water and dried to yield polymer products with the degree of succinylation of 1.3 and acetyl 0.3 as determined from <sup>1</sup>H NMR.</p><p id="p0170">To fabricate PMBs, the polymer was dissolved in a beaker in 30&#x000a0;% dextrose at 11&#x000a0;mg/ml with the addition of sodium hydroxide to adjust pH to&#x000a0;&#x0223c;&#x000a0;6. The beaker was placed in a water bath of 33&#x000a0;&#x000b0;C, the polymer solution was subject to continuous homogenization (Silverson L5M-a, USA) at air&#x02013;water interface in the presence of room air (5&#x000a0;k to 8&#x000a0;k rpm) with simultaneously addition of dilute hydrochloric acid over a course of a total 12&#x000a0;min until the pH reaches below 4. The result foam (PMBs) was let cream and repeatedly washed with 10&#x000a0;% dextrose solution to remove excess of acid and stored at room temperature.</p></sec><sec id="s0080"><label>5.3</label><title>Size characterization</title><p id="p0175">Microbubble size distribution was determined via Accusizer Particle measurement system (Particle Sizing Systems, Santa Barbara, CA, USA). Size distribution was then determined using MATLAB (The MathWorks, Natick, MA, USA).</p></sec><sec id="s0085"><label>5.4</label><title>Dissolution mechanism probed by microfluidic experiments</title><p id="p0180">To capture the dissolution process of shell and gas core, a microfluidics device with a T-junction was used. The channels&#x02019; side walls were constructed using a double-sided polyimide tape (Bertech PPTDE-2) with a total thickness 101.6&#x000a0;<inline-formula><mml:math id="M11" altimg="si9.svg"><mml:mi>&#x003bc;</mml:mi></mml:math></inline-formula>&#x000a0;m which becomes the thickness of the flow channel. The desired channel geometry with a flow channel width of approximately 1&#x000a0;mm was cut and removed from the tape. The channel negative was placed on a hard acrylic substrate for mechanical stability, and covered with transparent PET film (Grafix Dura-Lar Clear Acetate Alternative) as a top layer.</p><p id="p0185">The PMBs in 10&#x000a0;% dextrose solution and PBS buffer were introduced through each side of the T-junction with each incoming stream having the same flow rate, 20&#x000a0;nl/min. The fabricated microfluidic device was imaged on an inverted microscope with magnifications ranging from 5x to 63x, and the dissolution process recorded using a high-speed camera (Photron SA-X2) with a frame rate of 500 fps.</p><p id="p0190">The high-speed videos were used to measure and analyze the size changes of PMBs with custom image analysis scripts written in MATLAB. The workflow for these scripts is illustrated in Fig. S1. The analysis separated the data into two regions, one immediately before the rapid dissolution and the other during it. The portion of the data immediately prior to the dissolution (black region in <bold>Fig. S1</bold>, top) was averaged to determine the initial PMBs size (<inline-formula><mml:math id="M12" altimg="si10.svg"><mml:msub><mml:mi>D</mml:mi><mml:mn>0</mml:mn></mml:msub></mml:math></inline-formula>); whereas the data during dissolution (red region in <bold>Fig. S1</bold>) was linearized to determine the dissolution time (<inline-formula><mml:math id="M13" altimg="si7.svg"><mml:mi>&#x003c4;</mml:mi></mml:math></inline-formula>). <bold>Fig. S1</bold> also depicts some selected results of the dissolution process for various sized PMBs to highlight that larger PMBs dissolve slower than smaller PMBs.</p></sec><sec id="s0090"><label>5.5</label><title>Measurement of dissolved gas (pO<sub>2</sub>)</title><p id="p0195">Oxygen partial pressure (pO<sub>2</sub>) of all air-equilibrated solutions at room temperature was measured using OxyLite Pro XL (Oxford Optronix, UK) that is equipped with fiber-optical oxygen sensor with temperature correction with a sampling frequency of 1&#x000a0;Hz.</p></sec><sec id="s0095"><label>5.6</label><title>Nano-tracking analysis (NTA)</title><p id="p0200">Nano size distribution was determined via Nanoparticle tracking analysis (Zetaview Nanoparticle Tracking Analysis Instrument). Size distribution was then determined using MATLAB.</p></sec><sec id="s0100"><label>5.7</label><title>In-vitro measurement for acoustic response under static environment</title><p id="p0205">Experimental acoustic measurement setup (see <bold>Fig. S3</bold>) is employed for measuring the acoustic response upon pH-triggered dissolution of PMBs. The setup used a 3.5&#x000a0;MHz focused ultrasound (FUS) transducer (A382S-SU F1.00IN-PTF), which was driven by an arbitrary function generator (Agilent 33250A, Santa Clara, CA, USA) and was amplified by a radiofrequency amplifier (Model 2100L, E&#x00026;I, Rochester, NY, USA). The receiver, a P4-1 transducer with 96 elements and a center frequency of 2.5&#x000a0;MHz, was connected to a Verasonics Vantage system for ultrasonic signal acquisition.</p><p id="p0210">For each sample, two groups of sonications were conducted within this setup. The first group serves as the baseline, where an Eppendorf tube was filled with PBS to measure the baseline acoustic emissions. Subsequently, in the second group, PMBs were injected into the Eppendorf filled with PBS to measure the acoustic emissions produced by the bubbles. In both baseline and bubble samples, a total of 250 sonications were applied at 50&#x000a0;Hz pulse repetition frequency (PRF). Each sonication consisted of a 1&#x000a0;<italic>ms</italic> burst.</p></sec><sec id="s0105"><label>5.8</label><title>In-vitro measurement for acoustic response under dynamic pressure cycles</title><p id="p0215">A dynamic in vitro model was designed to replicate typical cardiovascular pressure cycles for pressure sensing by BNBs (<bold>Fig. S6</bold>). The model aimed to simulate physiological conditions by circulating a physiological buffer through plastic tubing using a roller pump, thereby generating dynamic pressure cycles. The same components from the static setup are utilized in this dynamic model.</p><p id="p0220">To capture the dynamic hydrostatic pressures, a calibrated catheter pressure transducer was placed near the sonicated area and connected to a PowerLab data acquisition system for hydrostatic pressure signal acquisition. The PowerLab was then connected to Verasonics Vantage to synchronize the pressure transducer and P4-1. To ensure a consistently positive dynamic pressure, the beaker is elevated to a certain height &#x0210e;. A syringe pump was employed to infuse PMBs at 1&#x000a0;ml/min. The injection point was located at a distance d away from the sonicated area.</p><p id="p0225">The ultrasound research platform was connected to a host desktop to save data and provide real-time display during experiments. A MATLAB program was used to process the signal and analyze acoustic emissions in the temporal and frequency domain.</p><p id="p0230">In each bubble sample, two groups of sonications were performed. The first group served as the baseline, where the tube contained only PBS. Subsequently, PMBs were injected into the tube to measure the acoustic emissions produced by the bubbles. For both the baseline and bubble cases, a total of 250 sonications were administered at PRF of 50&#x000a0;Hz. Each sonication consists of 1&#x000a0;<italic>ms</italic> bursts.</p></sec><sec id="s0110"><label>5.9</label><title>Sample preparation and measurement sequence for dynamic pressure sensing</title><p id="p0235">A 500&#x000a0;ml solution was introduced into the tube via the beaker. Two distinct solutions were utilized. The first solution, intended for dissolving the injected PMBs, consisted of 50&#x000a0;ml of PBS and 450&#x000a0;ml of degassed water. The second solution, denoted as D10, served as a control solution that did not dissolve PMBs. The peristaltic pump regulated the circulation of the solution and maintained the desired pressure within the tube.</p><p id="p0240">The measurement sequence proceeded as follows: PMBs with a predetermined concentration were prepared in a syringe; a syringe pump controlled the injection rate. The PMBs were subsequently injected into the flow. The 3.5&#x000a0;MHz FUS transducer was activated to generate pulses with a duration of 1&#x000a0;<italic>ms</italic> and a PRF of 50&#x000a0;Hz. These pulses interacted with the bubbles, causing them to scatter the ultrasound waves, which were then received by the P4-1 transducer. The received pulses were sampled at a sampling rate of 14 MS/s. Simultaneously, the dynamic hydrostatic pressure within the tube was acquired using a synchronized catheter sensor, ensuring coordination between the pressure measurements and ultrasound signal acquisition.</p><p id="p0245">For experiments that explored different exposure levels, 20 measurements were collected at each incident acoustic pressure. For experiments at a fixed exposure level, 250 samples were collected at a PRF of 50&#x000a0;Hz. The fixed exposure tests were repeated three times.</p></sec><sec id="s0115"><label>5.10</label><title>Acoustic signal processing</title><p id="p0250">Signal processing of the received pulses was done on a computer using MATLAB (The Math Works, Inc., Natick, MA). Power spectrum (PS) was calculated from fast Fourier transform (FFT). The averaged PS from 96 receivers per measurement was obtained first in baseline acquisitions without MBs (BL), and then repeated with microbubbles (MB). The mean broadband acoustic emission PS (MBEPS) at a frequency of interest (<inline-formula><mml:math id="M14" altimg="si11.svg"><mml:msub><mml:mi>f</mml:mi><mml:mi>i</mml:mi></mml:msub></mml:math></inline-formula>) was calculated as<disp-formula id="e0015"><mml:math id="M15" altimg="si12.svg"><mml:mrow><mml:mi mathvariant="normal">M</mml:mi><mml:mi mathvariant="normal">B</mml:mi><mml:mi mathvariant="normal">E</mml:mi><mml:mi mathvariant="normal">P</mml:mi><mml:mi mathvariant="normal">S</mml:mi><mml:mo linebreak="goodbreak">=</mml:mo><mml:mn>10</mml:mn><mml:mfrac><mml:mn>1</mml:mn><mml:msub><mml:mi>f</mml:mi><mml:mi>b</mml:mi></mml:msub></mml:mfrac><mml:msub><mml:mi mathvariant="normal">log</mml:mi><mml:mn>10</mml:mn></mml:msub><mml:mfenced open="(" close=")"><mml:mrow><mml:munder><mml:mover><mml:mo>&#x0222b;</mml:mo><mml:mrow><mml:msub><mml:mi>f</mml:mi><mml:mi>i</mml:mi></mml:msub><mml:mo>+</mml:mo><mml:mn>0.01</mml:mn><mml:msub><mml:mi>f</mml:mi><mml:mi>b</mml:mi></mml:msub></mml:mrow></mml:mover><mml:mrow><mml:msub><mml:mi>f</mml:mi><mml:mi>i</mml:mi></mml:msub><mml:mo>-</mml:mo><mml:mn>0.01</mml:mn><mml:msub><mml:mi>f</mml:mi><mml:mi>b</mml:mi></mml:msub></mml:mrow></mml:munder><mml:mfrac><mml:mrow><mml:mi>P</mml:mi><mml:msub><mml:mi>S</mml:mi><mml:mi>m</mml:mi></mml:msub><mml:mfenced open="(" close=")"><mml:mrow><mml:mi>f</mml:mi></mml:mrow></mml:mfenced></mml:mrow><mml:mrow><mml:mi>P</mml:mi><mml:msub><mml:mi>S</mml:mi><mml:mrow><mml:mi mathvariant="italic">noise</mml:mi></mml:mrow></mml:msub><mml:mfenced open="(" close=")"><mml:mrow><mml:mi>f</mml:mi></mml:mrow></mml:mfenced></mml:mrow></mml:mfrac><mml:mi>d</mml:mi><mml:mi>f</mml:mi></mml:mrow></mml:mfenced></mml:mrow></mml:math></disp-formula>where <inline-formula><mml:math id="M16" altimg="si11.svg"><mml:msub><mml:mi>f</mml:mi><mml:mi>i</mml:mi></mml:msub></mml:math></inline-formula> is the frequency of subharmonic or second harmonic and <inline-formula><mml:math id="M17" altimg="si13.svg"><mml:msub><mml:mi>f</mml:mi><mml:mi>b</mml:mi></mml:msub></mml:math></inline-formula> is the frequency bandwidth of the spectrum of interest, which was <inline-formula><mml:math id="M18" altimg="si14.svg"><mml:mrow><mml:msub><mml:mi>f</mml:mi><mml:mi>i</mml:mi></mml:msub><mml:mo stretchy="false">/</mml:mo><mml:mn>10</mml:mn></mml:mrow></mml:math></inline-formula> in this study. <inline-formula><mml:math id="M19" altimg="si15.svg"><mml:mrow><mml:mi>P</mml:mi><mml:msub><mml:mi>S</mml:mi><mml:mi>m</mml:mi></mml:msub><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mi>f</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:mrow></mml:math></inline-formula> is the PS for BL or MB. <inline-formula><mml:math id="M20" altimg="si16.svg"><mml:mrow><mml:mi>P</mml:mi><mml:msub><mml:mi>S</mml:mi><mml:mrow><mml:mi mathvariant="italic">noise</mml:mi></mml:mrow></mml:msub><mml:mrow><mml:mo stretchy="false">(</mml:mo><mml:mi>f</mml:mi><mml:mo stretchy="false">)</mml:mo></mml:mrow></mml:mrow></mml:math></inline-formula> was the PS of the electronic noise of the system, which was estimated by averaging 100 acquisitions without ultrasound transmission. Then, the enhancement in dB is calculated as<disp-formula id="e0020"><mml:math id="M21" altimg="si17.svg"><mml:mrow><mml:mi mathvariant="italic">Enhacement</mml:mi><mml:mo linebreak="goodbreak">=</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="normal">M</mml:mi><mml:mi mathvariant="normal">B</mml:mi><mml:mi mathvariant="normal">E</mml:mi><mml:mi mathvariant="normal">P</mml:mi><mml:mi mathvariant="normal">S</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">MB</mml:mi></mml:mrow></mml:msub><mml:mo linebreak="badbreak">-</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="normal">M</mml:mi><mml:mi mathvariant="normal">B</mml:mi><mml:mi mathvariant="normal">E</mml:mi><mml:mi mathvariant="normal">P</mml:mi><mml:mi mathvariant="normal">S</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">BL</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:math></disp-formula>where <inline-formula><mml:math id="M22" altimg="si18.svg"><mml:msub><mml:mrow><mml:mi mathvariant="normal">M</mml:mi><mml:mi mathvariant="normal">B</mml:mi><mml:mi mathvariant="normal">E</mml:mi><mml:mi mathvariant="normal">P</mml:mi><mml:mi mathvariant="normal">S</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">MB</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> and <inline-formula><mml:math id="M23" altimg="si19.svg"><mml:msub><mml:mrow><mml:mi mathvariant="normal">M</mml:mi><mml:mi mathvariant="normal">B</mml:mi><mml:mi mathvariant="normal">E</mml:mi><mml:mi mathvariant="normal">P</mml:mi><mml:mi mathvariant="normal">S</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="italic">BL</mml:mi></mml:mrow></mml:msub></mml:math></inline-formula> are the MBEPS for BL and MB, respectively.</p></sec><sec id="s0120"><label>5.11</label><title>Ex-vivo isolated Langendorff working heart model</title><p id="p0255">The ex-vivo working heart model procedure was conducted following the methodology outlined by DeWitt et al. [71]. To prepare the Krebs-Henseleit buffer (KHB), a total of 4&#x000a0;L of the solution was formulated. The KHB composition contains 27.584&#x000a0;g NaCl, 1.58&#x000a0;g KCl, 0.578&#x000a0;g MgSO<sub>4</sub>, 8.401&#x000a0;g NaHCO<sub>3</sub>, 1.47&#x000a0;g CaCl<sub>2</sub>, 0.744&#x000a0;g EDTA, 0.22&#x000a0;g NaC<sub>3</sub>H<sub>3</sub>O<sub>3</sub>, and 7.208&#x000a0;g dextrose. The KHB was transferred into a reservoir and subsequently circulated in the Langendorff apparatus. To maintain the desired temperature for the isolated heart model, a water bath was set to 42&#x000a0;&#x000b0;C to adequately heat the KHB reservoir during the experiment.</p><p id="p0260">All animal experiments were performed in accordance with the Institutional Animal Care and Use Committee at Brigham and Women&#x02019;s Hospital. Rats were deeply anesthetized via 1&#x02013;2&#x000a0;% isoflurane and oxygen. Anesthesia depth was confirmed using a toe pinch. To prevent blood clotting and facilitate subsequent dissection, a dose of 500 units of heparin was injected IP approximately 10&#x000a0;min prior to dissection. Two clean beakers, each containing 50&#x000a0;ml of ice-cold KHB, were prepared and placed in a bucket filled with ice near the dissection station.</p><p id="p0265">Following the dissection of the heart and lungs, the organs were immediately submerged in one of the prepared beakers containing ice-cold KHB. Subsequently, they were carefully transferred to the Langendorff apparatus. The heart was suspended on the Langendorff apparatus according to the configuration illustrated in <bold>Fig. S8A</bold>. To monitor the heartbeat and measure the pressure, a pressure&#x02013;volume catheter, calibrated for accuracy, was carefully inserted into the left ventricle of the heart. Subsequently, the heart was immersed in degassed water heated to a temperature of 42&#x000a0;&#x000b0;C. In accordance with the experimental setup described in the dynamic configuration, the immersion ultrasound transducer and the receiver P4-1 were positioned as depicted in <bold>Fig. S8B</bold>. They functioned in the same manner as described earlier in the dynamic setup in <bold>Fig. S6</bold>, ensuring consistency in their operation and data acquisition.</p></sec></sec><sec id="s0125"><title>Funding Sources</title><p id="p0270">This work is supported by Office of the Assistant Secretary of Defense for Health Affairs through Defense Medical Research and Development Program under Award No W81XWH2210111 (YP), and through the Peer Reviewed Medical Research Program under Award No W81XWH1910237 (JNK/YP). Opinions, interpretations, conclusions, and recommendations are those of the author and are not necessarily endorsed by the Department of Defense. Further, it was supported by the National Institute of Heart, Lung, and Blood Institute (1R01HL141818-02 JNK/YP) and (1R01HL178815-01 YP/JNK) and through a pilot award by Boston Children&#x02019;s (YP).</p></sec><sec id="s0135"><title>CRediT authorship contribution statement</title><p id="p0280"><bold>Quang Tran:</bold> Writing &#x02013; review &#x00026; editing, Writing &#x02013; original draft, Methodology, Investigation, Conceptualization. <bold>Garam Lee:</bold> Writing &#x02013; review &#x00026; editing, Writing &#x02013; original draft, Investigation, Formal analysis, Data curation. <bold>Michelle Balcarcel-Monzon:</bold> Investigation. <bold>Yongzhi Zhang:</bold> Investigation. <bold>Saffron Dominguez:</bold> Investigation. <bold>Kristen Sack:</bold> Investigation. <bold>John N. Kheir:</bold> Writing &#x02013; review &#x00026; editing, Investigation, Funding acquisition, Conceptualization. <bold>James Bird:</bold> Writing &#x02013; review &#x00026; editing, Writing &#x02013; original draft, Supervision, Methodology, Investigation, Conceptualization. <bold>Nathan McDannold:</bold> Writing &#x02013; review &#x00026; editing, Writing &#x02013; original draft, Methodology, Investigation, Funding acquisition. <bold>Yifeng Peng:</bold> Writing &#x02013; review &#x00026; editing, Writing &#x02013; original draft, Project administration, Investigation, Funding acquisition, Conceptualization.</p></sec><sec sec-type="COI-statement" id="coi005"><title>Declaration of competing interest</title><p id="p0285">The authors declare the following financial interests/personal relationships which may be considered as potential competing interests: Yifeng Peng, John Kheir has patent pending to Boston Children&#x02019;s Hospital. If there are other authors, they declare that they have no known competing financial interests or personal relationships that could have appeared to influence the work reported in this paper.</p></sec></body><back><ref-list id="bi005"><title>References</title><ref id="b0005"><label>1</label><element-citation publication-type="journal" id="h0005"><person-group person-group-type="author"><name><surname>Schutte</surname><given-names>A.E.</given-names></name><name><surname>Kollias</surname><given-names>A.</given-names></name><name><surname>Stergiou</surname><given-names>G.S.</given-names></name></person-group><article-title>Blood pressure and its variability: classic and novel measurement techniques</article-title><source>Nat. Rev. Cardiol.</source><volume>19</volume><year>2022</year><fpage>643</fpage><lpage>654</lpage><pub-id pub-id-type="doi">10.1038/s41569-022-00690-0</pub-id><pub-id pub-id-type="pmid">35440738</pub-id>
</element-citation></ref><ref id="b0010"><label>2</label><element-citation publication-type="journal" id="h0010"><person-group person-group-type="author"><name><surname>Ruopp</surname><given-names>N.F.</given-names></name><name><surname>Cockrill</surname><given-names>B.A.</given-names></name></person-group><article-title>Diagnosis and treatment of pulmonary arterial hypertension</article-title><source>JAMA</source><volume>327</volume><year>2022</year><fpage>1379</fpage><lpage>1391</lpage><pub-id pub-id-type="doi">10.1001/jama.2022.4402</pub-id><pub-id pub-id-type="pmid">35412560</pub-id>
</element-citation></ref><ref id="b0015"><label>3</label><element-citation publication-type="journal" id="h0015"><person-group person-group-type="author"><name><surname>Solomon</surname><given-names>S.D.</given-names></name><name><surname>Stevenson</surname><given-names>L.W.</given-names></name></person-group><article-title>Recalibrating the barometer: is it time to take a critical look at noninvasive approches to measureing filling pressures</article-title><source>Circulation</source><volume>119</volume><year>2009</year><fpage>13</fpage><lpage>15</lpage><pub-id pub-id-type="doi">10.1161/CIRCULATIONAHA.108.823591</pub-id><pub-id pub-id-type="pmid">19075101</pub-id>
</element-citation></ref><ref id="b0020"><label>4</label><element-citation publication-type="journal" id="h0020"><person-group person-group-type="author"><name><surname>Esposito</surname><given-names>C.</given-names></name><name><surname>Machado</surname><given-names>P.</given-names></name><name><surname>McDonald</surname><given-names>M.E.</given-names></name><name><surname>Savage</surname><given-names>M.P.</given-names></name><name><surname>Fischman</surname><given-names>D.</given-names></name><name><surname>Mehrotra</surname><given-names>P.</given-names></name><name><surname>Cohen</surname><given-names>I.S.</given-names></name><name><surname>Ruggiero</surname><given-names>N.</given-names></name><name><surname>Walinsky</surname><given-names>P.</given-names></name><name><surname>Vishnevsky</surname><given-names>A.</given-names></name><name><surname>Dickie</surname><given-names>K.</given-names></name><name><surname>Davis</surname><given-names>M.</given-names></name><name><surname>Forsberg</surname><given-names>F.</given-names></name><name><surname>Dave</surname><given-names>J.K.</given-names></name></person-group><article-title>Noninvasive Evaluation of Cardiac&#x000a0;Chamber Pressures Using Subharmonic-Aided Pressure Estimation&#x000a0;with Definity Microbubbles</article-title><source>J. Am. Coll. Cardiol. Img.</source><volume>16</volume><year>2023</year><fpage>224</fpage><lpage>235</lpage><pub-id pub-id-type="doi">10.1016/j.jcmg.2022.09.013</pub-id></element-citation></ref><ref id="b0025"><label>5</label><element-citation publication-type="journal" id="h0025"><person-group person-group-type="author"><name><surname>Porter</surname><given-names>T.R.</given-names></name></person-group><article-title>Getting in SHAPE to noninvsively measure intracardiac pressure: is it possible</article-title><source>J. Am. Coll. Cardiol. Img.</source><volume>16</volume><year>2023</year><fpage>236</fpage><lpage>238</lpage></element-citation></ref><ref id="b0030"><label>6</label><element-citation publication-type="journal" id="h0030"><person-group person-group-type="author"><name><surname>Kalayeh</surname><given-names>K.</given-names></name><name><surname>Fowlkes</surname><given-names>J.B.</given-names></name><name><surname>Yeras</surname><given-names>S.</given-names></name><name><surname>Chen</surname><given-names>A.</given-names></name><name><surname>Daignault-Newton</surname><given-names>S.</given-names></name><name><surname>Schultz</surname><given-names>W.W.</given-names></name><name><surname>Sack</surname><given-names>B.S.A.</given-names></name></person-group><article-title>Comparative Study of Commercially Available Ultrasound Contrast Agents for Sub-harmonic-Aided Pressure Estimation (SHAPE) in a Bladder Phantom</article-title><source>Ultrasound Med. Biol.</source><volume>50</volume><year>2024</year><fpage>1494</fpage><lpage>1505</lpage><pub-id pub-id-type="pmid">39054243</pub-id>

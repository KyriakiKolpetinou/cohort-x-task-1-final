</person-group><article-title>Fever of Unexplained Origin: Report on 100 Cases</article-title><source>Medicine</source><year>1961</year><volume>40</volume><fpage>1</fpage><lpage>30</lpage><pub-id pub-id-type="doi">10.1097/00005792-196102000-00001</pub-id><pub-id pub-id-type="pmid">13734791</pub-id></element-citation></ref><ref id="B2-jcm-11-00386"><label>2.</label><element-citation publication-type="journal"><person-group person-group-type="author">

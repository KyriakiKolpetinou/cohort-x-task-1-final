<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">BMC Med Imaging</journal-id><journal-id journal-id-type="iso-abbrev">BMC Med Imaging</journal-id><journal-title-group><journal-title>BMC Medical Imaging</journal-title></journal-title-group><issn pub-type="epub">1471-2342</issn><publisher><publisher-name>BioMed Central</publisher-name><publisher-loc>London</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">40399835</article-id><article-id pub-id-type="pmc">12096732</article-id>
<article-id pub-id-type="publisher-id">1726</article-id><article-id pub-id-type="doi">10.1186/s12880-025-01726-w</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>The value of multisequence MR in the morphological evaluation of peripheral lung cancer</article-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><name><surname>Li</surname><given-names>Zhenzhen</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Jiang</surname><given-names>Jianqin</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Hong</surname><given-names>Qin</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Fu</surname><given-names>Yigang</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Xiao</surname><given-names>Yong</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Zhu</surname><given-names>Mingming</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Zhou</surname><given-names>Xiao</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Xu</surname><given-names>Gaofeng</given-names></name><address><email>18905100082@163.com</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Shi</surname><given-names>Xun</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/04fe7hy80</institution-id><institution-id institution-id-type="GRID">grid.417303.2</institution-id><institution-id institution-id-type="ISNI">0000 0000 9927 0537</institution-id><institution>Department of Radiology, </institution><institution>The Yancheng Clinical College of Xuzhou Medical University and The First People&#x02019;s Hospital of Yancheng, </institution></institution-wrap>No.166 Yulong West Road, Yancheng, 224001 China </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/04fe7hy80</institution-id><institution-id institution-id-type="GRID">grid.417303.2</institution-id><institution-id institution-id-type="ISNI">0000 0000 9927 0537</institution-id><institution>Department of Nuclear Medicine, </institution><institution>The Yancheng Clinical College of Xuzhou Medical University and The First People&#x02019;s Hospital of Yancheng, </institution></institution-wrap>No.166 Yulong West Road, Yancheng, 224001 China </aff></contrib-group><pub-date pub-type="epub"><day>21</day><month>5</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>21</day><month>5</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>25</volume><elocation-id>178</elocation-id><history><date date-type="received"><day>4</day><month>8</month><year>2024</year></date><date date-type="accepted"><day>12</day><month>5</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">An increasing number of studies have shown that thoracic magnetic resonance imaging (MRI) has potential value in the early diagnosis of lung cancer. While the ability of T2 fast-BLADE (T2fBLADE), three-dimensional T1-weighted volumetric interpolated breath-hold examination (T1-VIBE) and T1 mapping to display morphological signs of lung cancer has been less well studied. Our study aimed to compare the image quality of stack-of-stars VIBE (Star-VIBE) and T1-VIBE and to investigate the ability of T2fBLADE, T1-VIBE, Star-VIBE and T1 mapping to show the morphological signs of lung cancer.</p></sec><sec><title>Methods</title><p id="Par2">Patients with a proposed diagnosis of peripheral lung cancer by computed tomography (CT) were collected prospectively and underwent MR scanning before pathological confirmation. MR scan Star-VIBE, T1-VIBE, T2fBLADE and T1 mapping sequences. Signal to noise ratio (SNR) and contrast to noise ratio (CNR) of Star-VIBE and T1-VIBE images were independently measured and compared by two radiologists. With CT images as the gold standard, the morphological signs (including lobulation, spiculation, pleural retraction, halo, cavitation, air bronchogram, necrosis, pleural effusion and mediastinal lymphadenopathy) and maximum diameters of the lesions on four MR sequences were evaluated and measured. A paired Wilcoxon test was used to compare the SNR, CNR and Likert scale of T1-VIBE and Star-VIBE. The Kruskal&#x02012;Wallis H test was used to compare the subjective scores of MR sequences. The intraclass correlation coefficient (ICC) and Cohen&#x02019;s kappa coefficient (k) were used to compare the agreement of lesion size and subjective scores between the two radiologists.</p></sec><sec><title>Results</title><p id="Par3">65 patients with a total of 69 lesions were included. The image quality of Star-VIBE was statistically higher than T1-VIBE (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05). The overall detection rate of morphological signs of lung cancer by MR was 76.9&#x02013;100%. MR (Star-VIBE and T1-VIBE) have a high sensitivity and specificity (96.5&#x02212;100%) for the display of various morphological signs. The detection rates of halo and cavitation by Star-VIBE and T1-VIBE (61.5&#x02212;83.3%) were higher than those by the T2fBLADE (23.1% and 33.3%). The detection rate of necrosis by the T2fBLADE (84.2%) was higher than that of Star-VIBE and T1-VIBE (73.7% and 63.2%), and the detection rate of residual signs was similar (91.7&#x02212;100%). Except for lobulation, spiculation and pleural effusion (81.3&#x02212;100%), the detection rates of all morphological signs by the T1 mapping sequence were low (0&#x02212;77.4%). The subjective scores of lobulation, spiculation, pleural retraction and mediastinal lymphadenopathy in Star-VIBE and T2fBLADE were higher than in T1-VIBE (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.013).</p></sec><sec><title>Conclusions</title><p id="Par4">Star-VIBE can provide higher image quality than T1-VIBE. Combined multisequence MR can better show the morphological signs of peripheral lung cancer.</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1186/s12880-025-01726-w.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Lung cancer</kwd><kwd>MRI</kwd><kwd>Star-VIBE</kwd><kwd>T1 mapping</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; BioMed Central Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par5">Lung cancer is a common malignant tumor, and its fatality rate ranks first among malignant tumors [<xref ref-type="bibr" rid="CR1">1</xref>]. CT is currently the most commonly used screening method for chest lesions. However, breath-hold requirements during chest CT scanning in lung cancer patients limit its use in older and poorly breath-holding patients. Besides, patients with contrast agent allergies or renal insufficiency cannot utilize enhanced CT contrast agents due to their negative side effects. With the application of ultrahigh-field magnetic resonance equipments and the development of fast scanning technologies, an increasing number of studies have shown that thoracic MR has potential value in the detection of small nodules in the lungs and the determination of benign and malignant lesions [<xref ref-type="bibr" rid="CR2">2</xref>&#x02013;<xref ref-type="bibr" rid="CR5">5</xref>].</p><p id="Par6">Three-dimensional T1-weighted volumetric interpolated breath-hold examination (T1-VIBE) is the most commonly used sequence in clinical practice. It can obtain thinner slices, higher resolution images than conventional MR sequences and has a shorter scanning time, but requires breath-holding during the examination. The stack-of-stars VIBE (Star-VIBE) sequence is based on gradient-echo K-space radial acquisition, which can effectively reduce breathing artifacts and improve image quality. Star-VIBE is insensitive to respiratory motion and allows scanning and image acquisition in a free-breathing state. but its scanning time is longer than that of T1-VIBE. Longitudinal relaxation time imaging (T1 mapping) can directly measure the longitudinal relaxation time (T1) of tissues, reflect subtle differences in tissue composition and water content. Some studies [<xref ref-type="bibr" rid="CR6">6</xref>&#x02013;<xref ref-type="bibr" rid="CR8">8</xref>] have concluded that T1 mapping could potentially be used to differentiate benign from malignant lesions. Most studies have used functional imaging to differentiate between benign and malignant lung lesions [<xref ref-type="bibr" rid="CR9">9</xref>&#x02013;<xref ref-type="bibr" rid="CR12">12</xref>]. There are few studies using morphological signs to identify benign and malignant lung lesions. Schaefer [<xref ref-type="bibr" rid="CR13">13</xref>] used an ECG-gated, gradient echo sequence to show that MR is comparable to CT for the display of internal structures of lung cancer but not as good as CT for marginal features such as spiculation and halo sign. A few studies concluded that Star-VIBE is feasible for assessing morphological signs of lung lesions [<xref ref-type="bibr" rid="CR14">14</xref>], while the ability of T2WI, T1-VIBE and T1 mapping to display morphological signs of lung cancer has been less well studied.</p><p id="Par7">Hence, this study aimed to compare the image quality of Star-VIBE and T1-VIBE and to investigate the ability of T2 fast-BLADE (T2fBLADE), T1-VIBE, Star-VIBE and T1 mapping to show the morphological signs of lung cancer.</p></sec><sec id="Sec2"><title>Materials and methods</title><sec id="Sec3"><title>Patients</title><p id="Par8">All of the patients gave informed written consent and the study was performed in conformity with the ethical guidelines of the Declaration of Helsinki. The inclusion criteria were as follows: (1) suspected to be peripheral lung cancer by CT, with a maximum lesion diameter greater than 1.0&#x000a0;cm and a solid component greater than 1/2 of the volume of the lesion. Due to the reason that the low signal intensity of pure ground glass lesions with a low solid component [<xref ref-type="bibr" rid="CR15">15</xref>, <xref ref-type="bibr" rid="CR16">16</xref>]; (2) no antitumor treatment or invasive examinations; (3) no contraindications to MRI examination and can cooperate with the examination. A total of 65 patients were enrolled from July 2020 to July 2022, including 42 males and 23 females, aged 64.8&#x02009;&#x000b1;&#x02009;9.3 years (range 32&#x02212;80 years). There were 69 lesions with a lesion size of approximately 3.4&#x02009;&#x000b1;&#x02009;2.8&#x000a0;cm (range of approximately 1.3 to 11.3&#x000a0;cm).</p></sec><sec id="Sec4"><title>Chest CT protocol</title><p id="Par9">A Siemens SOMATOM Definition AS CT machine was used. Before scanning, metal foreign bodies were removed, thyroid and pelvic protection were performed, and patients were given breathing training. The tube voltage was 120 KV, the frame speed was 0.5&#x000a0;s/r, the pitch was 1.2, the reconstructed slice thickness was 1.0&#x000a0;mm, and the collimator was 128&#x000a0;mm&#x000d7;0.6&#x000a0;mm. The standard lung algorithm was used for image collection. The lung window width and level were 1000 Hounsfield units (HU) and &#x02212;&#x02009;700 HU, respectively. The mediastinal window width and level were 400 HU and 40 HU, respectively.</p></sec><sec id="Sec5"><title>MRI protocols</title><p id="Par10">A 3 T MR scanner (MAGNETOM Skyra, Siemens Healthcare, Erlangen, Germany) equipped with an 18-channel body surface coil was used. The patients entered the scanner headfirst while lying supine. Both a respiratory belt and an abdominal belt were used to monitor the breathing phase and lessen respiratory motion artifacts. Prior to the examination, the patients received breathing instruction. The scanning sequences T2fBLADE, T1-VIBE, Star-VIBE and T1 mapping were used. Before 3D VFA T1 mapping, a B1-field inhomogeneity correction sequence (T1-turbo fast low angle shot [FLASH]) was used to acquire a correction map of the entire lung utilizing the stimulated echo/spin&#x02012;echo approach, reducing the slice profile and position mismatches. The rectification map required an extra 10&#x000a0;s of scanning [<xref ref-type="bibr" rid="CR17">17</xref>, <xref ref-type="bibr" rid="CR18">18</xref>]. T1-VIBE sequences with flip angles of 3&#x000b0; and 15&#x000b0; and CAIPIRINHA were utilized for VFA T1 mapping (controlled blending in parallel imaging leads to higher acceleration). At the scanner, the MapIt program generated inline T1 maps automatically (Siemens Healthineers). Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref> displays the comprehensive sequence parameters.</p><p id="Par11">
<table-wrap id="Tab1"><label>Table 1</label><caption><p><bold>Detailed parameters of T2fBLADE</bold>,<bold> T1-VIBE</bold>,<bold> Star-VIBE</bold>,<bold> T1 mapping</bold></p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">T2fBLADE</th><th align="left">T1-VIBE</th><th align="left">Star-VIBE</th><th align="left">T1 mapping</th></tr></thead><tbody><tr><td align="left">Position</td><td align="left">Transverse</td><td align="left">Transverse</td><td align="left">Transverse</td><td align="left">Transverse</td></tr><tr><td align="left">Breath</td><td align="left">Respiratory triggered</td><td align="left">Breath-hold</td><td align="left">Free breathing</td><td align="left">Breath-hold</td></tr><tr><td align="left">TR/TE (ms)</td><td align="left">2000/90</td><td align="left">4.22/1.9</td><td align="left">2.79</td><td align="left">5.01/2.3</td></tr><tr><td align="left">FOV (mm2)</td><td align="left">360&#x02009;&#x000d7;&#x02009;360</td><td align="left">380&#x02009;&#x000d7;&#x02009;380</td><td align="left">320&#x02009;&#x000d7;&#x02009;320</td><td align="left">380&#x02009;&#x000d7;&#x02009;305</td></tr><tr><td align="left">Matrix</td><td align="left">320&#x02009;&#x000d7;&#x02009;320</td><td align="left">384&#x02009;&#x000d7;&#x02009;384</td><td align="left">320&#x02009;&#x000d7;&#x02009;320</td><td align="left">135&#x02009;&#x000d7;&#x02009;224</td></tr><tr><td align="left">Slice thickness (mm)</td><td align="left">5</td><td align="left">3</td><td align="left">1.2</td><td align="left">4</td></tr><tr><td align="left">Slices</td><td align="left">24</td><td align="left">64</td><td align="left">208</td><td align="left">64</td></tr><tr><td align="left">Acquisition time (sec)</td><td align="left"><p>Dependent on breathing</p><p>pattern</p></td><td align="left">21</td><td align="left">330</td><td align="left">20</td></tr></tbody></table></table-wrap>
</p></sec><sec id="Sec64"><title>Image analysis</title><sec id="Sec6"><title>Subjective and objective image analysis</title><p id="Par12">Subjective Image analysis was scored on a Likert scale from 1 to 5 (5; best- 1; worst). Objective image evaluation using signal-to-noise ratio (SNR) and contrast-to-noise ratio (CNR). Independent analysis of Star-VIBE and T1-VIBE images was performed by two radiologists with 5 and 10 years of diagnostic chest imaging experience. Taking into account the effect of background noise and motion artifacts in the blood vessels and bronchus, two different methods were used to compare the SNR and CNR [<xref ref-type="bibr" rid="CR19">19</xref>&#x02013;<xref ref-type="bibr" rid="CR21">21</xref>] (see Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>). Regions of interest (ROIs) had a consistent size during measurement (1&#x02009;~&#x02009;3 cm<sup>2</sup>). Standard deviation (SD) represents the average of the SDs of the background. For Method 1, SNR<sup>a</sup> = Signal intensity (SI) lung/SD and CNR<sup>a</sup>= (SI muscle-SI lung)/SD. For Method 2, SNR<sup>b</sup> = (SI lung/SI airway) &#x000b7;100% and CNR<sup>b</sup> = (SI lung &#x02013; SI airway)/SI vessel&#x000b7;100%.</p><p id="Par13">
<fig id="Fig1"><label>Fig. 1</label><caption><p>Drawing ROIs in both the anterior and posterior regions of the lungs to obtain the signal intensity of the lung parenchyma (<bold>a</bold>). Drawing ROIs in the aortic arch or the thoracic aorta allowed for the measurement of the signal intensity in the vessels (<bold>b</bold>). By drawing ROIs within the muscle, signal intensity in the muscles was obtained (<bold>c</bold>). By drawing ROIs in the lumen of the trachea, left, or right main bronchus, signal intensity in the airways was obtained (<bold>d, e</bold>). The average of ROIs which were generated in the anterior and posterior, left and right four areas in the background was signal intensity in the background (<bold>f</bold>)</p></caption><graphic xlink:href="12880_2025_1726_Fig1_HTML" id="d33e445"/></fig>
</p></sec><sec id="Sec7"><title>Comparison of morphological features and maximum diameter of lung cancer</title><p id="Par14">All CT and MR images were examined on a postprocessing workstation (syngoMMWP, Siemens Healthcare). Morphological characteristics of lung cancer included lobulation, spiculation, pleural retraction, halo sign, cavitation, air bronchogram, necrosis, pleural effusion and mediastinal lymphadenopathy [<xref ref-type="bibr" rid="CR22">22</xref>, <xref ref-type="bibr" rid="CR23">23</xref>]. Two independent radiologists with 5 and 10 years of experience reading MRI images recorded the number of morphological signs of lung cancer in each sequence and calculated the detection rate while subjectively scoring the morphological signs of lung cancer on a 5-point scale (5; sharp edge of sign and no artifact-1; unable to display and severe artifact) and recording the maximum lesion diameter for each sequence). The signs on the CT images were determined by two other radiologists with 5 and 10 years of experience, and a consensus decision was made in case of disagreement. The maximum diameter of the lesions on the CT images was then measured separately, and the mean value measured by two radiologists was taken as the maximum diameter of the lesions measured by CT.</p></sec></sec><sec id="Sec8"><title>Statistical analysis</title><p id="Par15">SPSS-26.0 software was used for statistical analysis. The Kolmogorov&#x02012;Smirnov test was used for the normal distribution test. A paired Wilcoxon test was used to compare the SNR, CNR and likert scale of T1-VIBE and Star-VIBE. The Kruskal&#x02012;Wallis H test was used to compare the differences in subjective scores among Star-VIBE, T1-VIBE, T2fBLADE and T1 mapping. If there were differences, the Wilcoxon rank sum test was used for two-way comparison. The Wilcoxon rank sum test was used to compare the differences in the maximum diameter of lesions measured by each MR sequence and CT. Cohen&#x02019;s kappa coefficient (k) was used to compare the agreement of subjective scores between the two radiologists. The chi-square test was used to compare the detection rates of morphological signs of lung cancer. The intraclass correlation coefficient (ICC) was used to evaluate the consistency of CNR, SNR, and lesion size between the two measurements. Statistics were considered significant at a value of <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.05.</p></sec></sec><sec id="Sec9"><title>Results</title><sec id="Sec10"><title>Comparisons of image quality</title><p id="Par16">The likert scale of Star-VIBE calculated by the two observers were statistically higher than those of T1-VIBE (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001). Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref> presents the results of the image quality assessment by SNR and CNR. The SNR and CNR of Star-VIBE calculated by the two methods were statistically higher than those of T1-VIBE (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001&#x02212;0.045). The repeatability of likert scale, CNRs and SNRs of both Star-VIBE and T1-VIBE were consistent (ICC&#x02009;=&#x02009;0.764&#x02212;0.904).</p><p id="Par17">
<table-wrap id="Tab2"><label>Table 2</label><caption><p>Comparisons of SNR and CNR in the Star-VIBE and T1-VIBE</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2"/><th align="left" colspan="2">SNR<sup>a</sup></th><th align="left" colspan="2">CNR<sup>a</sup></th><th align="left" colspan="2">SNR<sup>b</sup></th><th align="left" colspan="2">CNR<sup>b</sup></th></tr><tr><th align="left">Observer A</th><th align="left">Observer B</th><th align="left">Observer A</th><th align="left">Observer B</th><th align="left">Observer A</th><th align="left">Observer B</th><th align="left">Observer A</th><th align="left">Observer B</th></tr></thead><tbody><tr><td align="left">Star-VIBE</td><td align="left">47.55&#x02009;&#x000b1;&#x02009;12.19</td><td align="left">50.87&#x02009;&#x000b1;&#x02009;10.83</td><td align="left">141.84&#x02009;&#x000b1;&#x02009;51.67</td><td align="left">166.11&#x02009;&#x000b1;&#x02009;57.22</td><td align="left">0.26&#x02009;&#x000b1;&#x02009;0.06</td><td align="left">0.26&#x02009;&#x000b1;&#x02009;0.05</td><td align="left">-0.04&#x02009;&#x000b1;&#x02009;0.04*</td><td align="left">-0.04&#x02009;&#x000b1;&#x02009;0.04*</td></tr><tr><td align="left">T1-VIBE</td><td align="left">8.41&#x02009;&#x000b1;&#x02009;3.12*</td><td align="left">8.07&#x02009;&#x000b1;&#x02009;3.09*</td><td align="left">104.31&#x02009;&#x000b1;&#x02009;35.67*</td><td align="left">119.38&#x02009;&#x000b1;&#x02009;39.37*</td><td align="left">0.09&#x02009;&#x000b1;&#x02009;0.03*</td><td align="left">0.08&#x02009;&#x000b1;&#x02009;0.02*</td><td align="left">-0.06&#x02009;&#x000b1;&#x02009;0.04</td><td align="left">-0.05&#x02009;&#x000b1;&#x02009;0.04*</td></tr><tr><td align="left">Z</td><td align="left">-7.22</td><td align="left">-7.220</td><td align="left">-5.37</td><td align="left">-5.767</td><td align="left">-7.22</td><td align="left">-7.223</td><td align="left">-2.51</td><td align="left">-1.843</td></tr><tr><td align="left">P</td><td align="left">&#x0003c;&#x02009;0.001</td><td align="left">&#x0003c;&#x02009;0.001</td><td align="left">&#x0003c;&#x02009;0.001</td><td align="left">&#x0003c;&#x02009;0.001</td><td align="left">&#x0003c;&#x02009;0.001</td><td align="left">&#x0003c;&#x02009;0.001</td><td align="left">0.012</td><td align="left">0.045</td></tr></tbody></table></table-wrap>
</p><p id="Par18">* Non normal distribution is expressed as median&#x02009;&#x000b1;&#x02009;interquartile interval, and the rest is normal distribution, expressed as mean&#x02009;&#x000b1;&#x02009;standard deviation.</p></sec><sec id="Sec11"><title>Comparison of morphological features</title><sec id="Sec12"><title>Comparison of the detection rate of lung cancer morphology between MRI and CT</title><p id="Par19">The detection of morphological signs of lung cancer by CT was the gold standard, MR had a slightly lower detection rate for halo signs (76.9%) and a higher overall detection rate, sensitivity and specificity for the remaining morphological signs of lung cancer (83.3&#x02212;100%) (Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>). The detection rates of halo sign and cavitation were higher for the Star-VIBE and T1-VIBE (61.5&#x02212;83.3%) than T2fBLADE (23.1% and 33.3%), while the detection rate of necrosis was slightly higher for the T2fBLADE (84.2%) than Star-VIBE and T1-VIBE (73.7% and 63.2%), and the remaining signs were comparable (91.7&#x02212;100%). The T2fBLADE sequence identified trace pleural effusion not identified by CT in 8 cases. Except for lobulation, spiculation and pleural effusion (81.3&#x02212;100%), the T1 mapping had low detection rates for all morphological signs, especially halo sign, cavitation, air bronchogram and necrosis (&#x0003c;&#x02009;50%).</p><p id="Par20">
<table-wrap id="Tab3"><label>Table 3</label><caption><p>Detection rate of signs in MR sequences</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2"/><th align="left" colspan="2">MR</th><th align="left" colspan="2">Star-VIBE</th><th align="left" colspan="2">T1-VIBE</th><th align="left" rowspan="2">T2fBLADE</th><th align="left" rowspan="2">T1 mapping</th></tr><tr><th align="left">Sensitivity</th><th align="left">Specificity</th><th align="left">Sensitivity</th><th align="left">Specificity</th><th align="left">Sensitivity</th><th align="left">Specificity</th></tr></thead><tbody><tr><td align="left">Lobulation</td><td align="left"><p>100%</p><p>(64/64)</p></td><td align="left">100%</td><td align="left">100% (64/64)</td><td align="left">100%</td><td align="left">100% (64/64)</td><td align="left">100%</td><td align="left">100% (64/64)</td><td align="left">100% (64/64)</td></tr><tr><td align="left">Spiculation</td><td align="left"><p>100%</p><p>(64/64)</p></td><td align="left">100%</td><td align="left">98.4% (63/64)</td><td align="left">100%</td><td align="left">96.9% (62/64)</td><td align="left">83.3%</td><td align="left">98.4% (63/64)</td><td align="left">81.3% (52/64)</td></tr><tr><td align="left">Pleural retraction</td><td align="left"><p>100%</p><p>(53/53)</p></td><td align="left">100%</td><td align="left">94.3% (50/53)</td><td align="left">100%</td><td align="left">94.3% (50/53)</td><td align="left">94.1%</td><td align="left">96.2% (51/53)</td><td align="left">77.4% (41/53)</td></tr><tr><td align="left">Halo sign</td><td align="left"><p>76.9%</p><p>(10/13)</p></td><td align="left">96.5%</td><td align="left">76.9% (10/13)</td><td align="left">94.9%</td><td align="left"><p>61.5%</p><p>(8/13)</p></td><td align="left">96.5%</td><td align="left"><p>23.1%</p><p>(3/13)</p></td><td align="left">0% (0/13)</td></tr><tr><td align="left">Cavitation</td><td align="left"><p>83.3%</p><p>(5/6)</p></td><td align="left">100%</td><td align="left"><p>83.3%</p><p>(5/6)</p></td><td align="left">100%</td><td align="left"><p>83.3%</p><p>(5/6)</p></td><td align="left">100%</td><td align="left"><p>33.3%</p><p>(2/6)</p></td><td align="left"><p>16.7%</p><p>(1/6)</p></td></tr><tr><td align="left">Air bronchogram</td><td align="left"><p>100%</p><p>(34/34)</p></td><td align="left">100%</td><td align="left"><p>100%</p><p>(34/34)</p></td><td align="left">100%</td><td align="left">100% (34/34)</td><td align="left">100%</td><td align="left">94.1% (32/34)</td><td align="left">17.6% (6/34)</td></tr><tr><td align="left">Necrosis</td><td align="left"><p>94.7%</p><p>(18/19)</p></td><td align="left">98.0%</td><td align="left">73.7% (14/19)</td><td align="left">98.0%</td><td align="left">63.2% (12/19)</td><td align="left">98.0%</td><td align="left">84.2% (16/19)</td><td align="left"><p>42.1%</p><p>(8/19)</p></td></tr><tr><td align="left">Pleural effusion</td><td align="left"><p>100%</p><p>(12/12)</p></td><td align="left">100%</td><td align="left">100% (12/12)</td><td align="left">100%</td><td align="left"><p>91.7%</p><p>(11/12)</p></td><td align="left">98.3%</td><td align="left">100% (20/12)</td><td align="left">91.7% (11/12)</td></tr><tr><td align="left">Mediastinal lymphadenopathy</td><td align="left"><p>100%</p><p>(34/34)</p></td><td align="left">100%</td><td align="left">100% (34/34)</td><td align="left">100%</td><td align="left">100% (34/34)</td><td align="left">100%</td><td align="left">100% (34/34)</td><td align="left">76.5% (26/34)</td></tr></tbody></table></table-wrap>
</p></sec></sec><sec id="Sec13"><title>Comparison of the morphological subjective scores of Star-VIBE, T1-VIBE and T2fBLADE</title><p id="Par21">There was no statistically significant difference among the three sequences for cavitation and pleural effusion (<italic>P</italic>&#x02009;=&#x02009;0.078 and 0.368), while there were statistically significant differences in the subjective scores of the remaining morphological signs (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001&#x02212;0.034) (Tables&#x000a0;<xref rid="Tab4" ref-type="table">4</xref> and <xref rid="Tab5" ref-type="table">5</xref>, see Figs.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>, <xref rid="Fig3" ref-type="fig">3</xref> and <xref rid="Fig4" ref-type="fig">4</xref>). The subjective scores for lobulation, spiculation, pleural retraction, air bronchogram, necrosis and mediastinal lymphadenopathy were significantly higher in Star-VIBE sequence than T1-VIBE sequence (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.017); The subjective scores for air bronchogram and mediastinal lymphadenopathy were significantly higher in the Star-VIBE sequence than T2fBLADE sequence (<italic>P</italic>&#x02009;=&#x02009;0.011 and 0.015); The T2fBLADE sequence scored higher than T1-VIBE sequence for lobulation, spiculation, pleural retraction, necrosis, and mediastinal lymphadenopathy (<italic>P</italic>&#x02009;&#x0003c;&#x02009;0.013). There was no statistically significant difference in subjective scores for the remaining signs (<italic>P</italic>&#x02009;=&#x02009;0.017&#x02212;1.000). The subjective scores of the morphological signs of lung cancer on MR images were in good agreement between the two physicians (kappa values: 0.619&#x02212;0.900, <italic>P</italic>&#x02009;&#x0003c;&#x02009;0.001).</p><p id="Par22">
<table-wrap id="Tab4"><label>Table 4</label><caption><p>Star-VIBE, T1-VIBE and T2fBLADE morphological signs subjective scores</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">Lobulation</th><th align="left">Spiculation</th><th align="left">Pleural retraction</th><th align="left">Halo sign</th><th align="left">Cavitation</th><th align="left">Air bronchogram</th><th align="left">Necrosis</th><th align="left">Pleural effusion</th><th align="left">Mediastinal lymphadenopathy</th></tr></thead><tbody><tr><td align="left">Star-VIBE</td><td char="." align="char">5</td><td char="." align="char">5</td><td char="." align="char">5</td><td char="." align="char">4</td><td char="." align="char">5</td><td char="." align="char">4</td><td char="." align="char">4</td><td char="." align="char">5</td><td char="." align="char">5</td></tr><tr><td align="left">T1-VIBE</td><td char="." align="char">5</td><td char="." align="char">4</td><td char="." align="char">4</td><td char="." align="char">3</td><td char="." align="char">3</td><td char="." align="char">4</td><td char="." align="char">3</td><td char="." align="char">5</td><td char="." align="char">4</td></tr><tr><td align="left">T2fBLADE</td><td char="." align="char">5</td><td char="." align="char">5</td><td char="." align="char">5</td><td char="." align="char">0</td><td char="." align="char">0</td><td char="." align="char">4</td><td char="." align="char">5</td><td char="." align="char">5</td><td char="." align="char">5</td></tr></tbody></table><table-wrap-foot><p>* non-normally distributed and expressed as medians</p></table-wrap-foot></table-wrap>
</p><p id="Par23">
<fig id="Fig2"><label>Fig. 2</label><caption><p>CT image showed mass in the left upper lobe, and the mass showed necrosis (<bold>a, b</bold>). Necrosis was hyperintense on T2fBLADE (<bold>c</bold>), which were scored as 5-points. Necrosis is hypointense on Star-VIBE (<bold>d</bold>) and T1-VIBE (<bold>e</bold>), which were scored as 4-points. Necrosis was shown as red in T1 mapping (<bold>f</bold>), which was scored as 4-points</p></caption><graphic xlink:href="12880_2025_1726_Fig2_HTML" id="d33e1028"/></fig>
</p><p id="Par24">
<fig id="Fig3"><label>Fig. 3</label><caption><p>CT image showed mass in the right upper lobe, and the mass showed halo sign (<bold>a</bold>). Star-VIBE (<bold>d</bold>) could clearly show halo sign, which were scored as 5-points. T2fBLADE (<bold>c</bold>) and T1-VIBE (<bold>e</bold>) could display part of halo sign, which were scored as 3-points, while T1 mapping (<bold>f</bold>) could not display halo sign, which was scored as 0 points</p></caption><graphic xlink:href="12880_2025_1726_Fig3_HTML" id="d33e1054"/></fig>
</p><p id="Par25">
<fig id="Fig4"><label>Fig. 4</label><caption><p>CT image does not show pleural effusion (<bold>a, b</bold>). However, T2fBLADE (<bold>c</bold>) and Star-VIBE (<bold>d</bold>) showed a little pleural effusion on both sides, T1-VIBE (<bold>e</bold>) without significant pleural effusion. T1 mapping (<bold>f</bold>) showed a little pleural effusion on the right side</p></caption><graphic xlink:href="12880_2025_1726_Fig4_HTML" id="d33e1080"/></fig>
</p><p id="Par26">
<table-wrap id="Tab5"><label>Table 5</label><caption><p>Comparison of subjective scores of morphological signs of Star-VIBE, T1-VIBE and T2fBLADE</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2"/><th align="left">Kruskal-Wallis H test<break/>X<sup>2</sup>, <italic>P</italic></th><th align="left"/><th align="left" colspan="3">Wilcoxon rank sum test (Bonferroni correction,<break/><italic>P</italic>&#x02009;&#x0003c;&#x02009;0.0167)</th></tr><tr><th align="left">Star-VIBE-T1-VIBE- T2fBLADE</th><th align="left"/><th align="left">Star-VIBE-T1-VIBE</th><th align="left">Star-VIBE-T2fBLADE</th><th align="left">T1-VIBE-T2fBLADE</th></tr></thead><tbody><tr><td align="left">Lobulation</td><td align="left">55.809, &#x0003c;&#x02009;0.001</td><td align="left"/><td align="left">&#x0003c;&#x02009;0.001</td><td align="left">0.317</td><td align="left">&#x0003c;&#x02009;0.001</td></tr><tr><td align="left">Spiculation</td><td align="left">49.218, &#x0003c;&#x02009;0.001</td><td align="left"/><td align="left">&#x0003c;&#x02009;0.001</td><td align="left">0.132</td><td align="left">&#x0003c;&#x02009;0.001</td></tr><tr><td align="left">Pleural retraction</td><td align="left">14.320, 0.001</td><td align="left"/><td align="left">0.001</td><td align="left">0.126</td><td align="left">0.003</td></tr><tr><td align="left">Halo sign</td><td align="left">6.790, 0.034</td><td align="left"/><td align="left">0.020</td><td align="left">0.047</td><td align="left">0.481</td></tr><tr><td align="left">Cavitation</td><td align="left">5.111, 0.078</td><td align="left"/><td align="left">0.157</td><td align="left">0.066</td><td align="left">0.068</td></tr><tr><td align="left">Air bronchogram</td><td align="left">12.575, 0.002</td><td align="left"/><td align="left">0.001</td><td align="left">0.011</td><td align="left">0.312</td></tr><tr><td align="left">Necrosis</td><td align="left">8.064, 0.018</td><td align="left"/><td align="left">0.017</td><td align="left">0.131</td><td align="left">0.013</td></tr><tr><td align="left">Pleural effusion</td><td align="left">2.000, 0.368</td><td align="left"/><td align="left">0.317</td><td align="left">1.000</td><td align="left">0.317</td></tr><tr><td align="left">Mediastinal lymphadenopathy</td><td align="left">22.451, &#x0003c;&#x02009;0.001</td><td align="left"/><td align="left">&#x0003c;&#x02009;0.001</td><td align="left">0.015</td><td align="left">0.001</td></tr></tbody></table></table-wrap>
</p></sec><sec id="Sec14"><title>Comparison of measurements of the maximum diameter of lung lesions</title><p id="Par27">The maximum diameters of the lung lesions detected by CT were 3.4&#x02009;&#x000b1;&#x02009;2.8&#x000a0;cm (measurer A) and 3.3&#x02009;&#x000b1;&#x02009;2.6&#x000a0;cm (measurer B). Using Star-VIBE, the measurements were 3.3&#x02009;&#x000b1;&#x02009;2.6&#x000a0;cm (measurer A) and 3.4&#x02009;&#x000b1;&#x02009;2.3&#x000a0;cm (measurer B). T1-VIBE yielded results of 3.4&#x02009;&#x000b1;&#x02009;3.0&#x000a0;cm (measurer A) and 3.4&#x02009;&#x000b1;&#x02009;4.1&#x000a0;cm (measurer B), those measured by T2fBLADE were 3.5&#x02009;&#x000b1;&#x02009;2.8&#x000a0;cm (measurer A) and 3.5&#x02009;&#x000b1;&#x02009;2.5&#x000a0;cm (measurer B), and those measured by T1 mapping were 3.3&#x02009;&#x000b1;&#x02009;2.8&#x000a0;cm (measurer A) and 3.3&#x02009;&#x000b1;&#x02009;0.7&#x000a0;cm (measurer B). The maximum diameter of the lesions detected by MR sequences and those detected by CT was not statistically significant (Z=-1.82&#x02212;-0.62, <italic>P</italic>&#x02009;=&#x02009;0.07&#x02212;0.54). There was good agreement between the two measurers for the measurement of the maximum diameter of the lesion (ICC&#x02009;=&#x02009;0.890&#x02212;0.998).</p></sec></sec><sec id="Sec15"><title>Discussion</title><p id="Par28">Our study results showed that the image quality of Star-VIBE was higher than those of T1-VIBE, which was consistent with the findings of previous studies [<xref ref-type="bibr" rid="CR14">14</xref>, <xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR24">24</xref>, <xref ref-type="bibr" rid="CR25">25</xref>]; Relevant studies [<xref ref-type="bibr" rid="CR16">16</xref>, <xref ref-type="bibr" rid="CR24">24</xref>, <xref ref-type="bibr" rid="CR34">34</xref>] have shown that MR has good sensitivity and specificity for lung nodules&#x02009;&#x02265;&#x02009;6&#x000a0;mm (detection rate is 100%). Star-VIBE sequence can be an effective complementary mean of detecting early-stage lung cancer, especially for patients contraindicated for CT or requiring detailed soft-tissue imaging.</p><p id="Par29">Morphological signs of lung lesions are closely related to the benignity or malignancy of the lesion. In this study, the overall detection rates of MR were high (83.3&#x02212;100%) for most morphological signs of lung cancer, except for the halo sign (76.9%), confirming the potential value of MR for the morphological assessment of peripheral lung cancer. A previous study [<xref ref-type="bibr" rid="CR13">13</xref>] concluded that MR is less able to detect morphological features of lung cancer margins (such as lobulation, spiculation and halo sign) than CT, especially fine spiculation. Our study had low detection rate of halo signs (76.9%). This might be because the halo sign is a ground glass shadow surrounding the lesion with fewer solid components and lower signal intensity than the solid components [<xref ref-type="bibr" rid="CR16">16</xref>, <xref ref-type="bibr" rid="CR26">26</xref>]. Ohno Y [<xref ref-type="bibr" rid="CR26">26</xref>, <xref ref-type="bibr" rid="CR27">27</xref>] concluded that an ultrashort echo time (UTE) could accurately show the ground glass component within the lesion. Some studies have reported the advantage of the half-Fourier single-shot turbo spin&#x02012;echo (HASTE) sequence for visualization of infiltrative lesions [<xref ref-type="bibr" rid="CR28">28</xref>&#x02013;<xref ref-type="bibr" rid="CR30">30</xref>]. Therefore, new sequences could be added in the future to assess the halo sign. The detection rate of lobulation and spiculation of peripheral-type lung cancer was 100% in this study, which may be explained by the fact that most of the cases included in this study were deeply lobulated and had long spiculation. The T2fBLADE sequence in this study detected trace pleural effusion not detected by CT in 8 cases, which were subsequently confirmed by ultrasonography (see Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>). Apart from this, T2fBLADE are radial acquisition methods and the associated artifacts could mimic the appearance of pleural effusion. However, there are no similar reports in the literature. A small amount of pleural effusion is more difficult to distinguish from normal pleura or pleural thickening on CT mediastinal windows, but the fluid shows a distinct high signal on T2fBLADE images and is more easily visualized, so the T2fBLADE sequence can be a useful supplement to CT assessment of pleural effusion.</p><p id="Par30">The thickness of Star-VIBE images is thinner than that of T1-VIBE images, is insensitive to respiratory movement and has high image contrast, so the detection rate and subjective score of most lung cancer morphological signs are higher than those of T1-VIBE and T1 mapping, which is similar to the previous studies [<xref ref-type="bibr" rid="CR21">21</xref>]. The detection rates of halo signs and cavitation were higher for T1-VIBE than T2fBLADE. However, the detection rate and subjective score of necrosis in this study were higher for T2fBLADE than Star-VIBE and T1-VIBE. The fluid-containing components showed low signal and poor contrast on T1WI, while they showed significantly high signal on the T2fBLADE, which is easier to display. Yan [<xref ref-type="bibr" rid="CR21">21</xref>] had the same result. Therefore, the T2fBLADE sequence is more advantageous than CT in showing fluid-containing lesion components such as liquefied necrosis and mucus plugs. The subjective score of the T1-VIBE sequence for lobulation, spiculation and mediastinal lymphadenopathy in this study was lower than that of T2fBLADE, probably because the T1-VIBE is a breath-hold examination sequence, which is more sensitive to motion artifacts. While T2BLADE uses a radially filled K-space acquisition technique, which can minimize motion artifacts. In addition, our study did not subdivide lobulation and spiculation, and further subdivision studies are needed in the future. The detection rate and subjective score of the T1 mapping sequence for most morphological signs of lung cancer are lower. T1 mapping can quantitatively measure the T1 value of tissues and has been used in the pathological staging identification of lung cancer, but its layers are thicker, and it is a breath-hold examination sequence, which is sensitive to respiratory motion and prone to partial volume effect artifacts and motion artifacts. In addition, studies [<xref ref-type="bibr" rid="CR31">31</xref>, <xref ref-type="bibr" rid="CR32">32</xref>] concluded that the initial T1 value of small cell lung cancer is high, the T1 mapping image shows a high signal which is easily confused with a necrotic signal. Therefore, T1 mapping is not recommended for the morphological assessment of lung cancer at present.</p><p id="Par31">The likelihood of lung lesion malignancy is closely linked to lesion size. In our study, the measurement results of the maximum diameter of the lesions in four MR sequences had no statistical significance compared with CT, which was similar to the findings of Zhang [<xref ref-type="bibr" rid="CR33">33</xref>, <xref ref-type="bibr" rid="CR34">34</xref>], suggesting that MR can measure the size of the lesions accurately. However, some studies have also suggested that the partial volume effect of MR and the inhomogeneity of the magnetic field at the lung nodule margins may result in smaller MR maximum diameter measurements [<xref ref-type="bibr" rid="CR26">26</xref>, <xref ref-type="bibr" rid="CR27">27</xref>, <xref ref-type="bibr" rid="CR35">35</xref>]. Further studies with larger samples are needed in the future.</p><p id="Par32">There are also limitations in this study. First, the sample size included was small and did not include central lung cancer, lesions less than 1&#x000a0;cm and lesions with a solid component of less than 1/2. Because current studies [<xref ref-type="bibr" rid="CR26">26</xref>] concluded that MR has low sensitivity and specificity for this type of lung nodules, which may limit the extrapolation and generalizability of the study results, especially in the field of lung cancer screening and diagnosis, a larger sample size is needed to verify the effectiveness of MRI sequences. Second, except for SNR and CNR, some other quantitative metrics were not quoted to evaluate the image quality and artifacts. Third, the lung lesions were not analyzed in categories according to their location and size, and short fine burrs were not observed separately from coarse long burrs or deep lobes from superficial lobes, which needs to be improved in the future. Fourth, the assessment of lung lesions by visual analysis alone is susceptible to the subjective factors of the observer, without applying automatic 3D volumetric analysis techniques for evaluation. Relevant studies [<xref ref-type="bibr" rid="CR36">36</xref>, <xref ref-type="bibr" rid="CR37">37</xref>] have shown that artificial intelligence (AI) has considerable potential to improve the sensitivity of detecting lung nodules on CT images, reduce the false-positive rate, and classify nodules. But there are also challenges: such as scarcity of comprehensive and well-annotated datasets, poor interpretability of diagnostic result, and challenges with the generalization ability. There are fewer studies related to the application of artificial intelligence in MR lung cancer screening, which need to be further explored in the future.</p></sec><sec id="Sec16"><title>Conclusion</title><p id="Par33">In summary, Star-VIBE has better image quality than T1-VIBE, shows lung cancer lesions more clearly, and has high patient compliance. Star-VIBE is suitable for patients with poor breath-holding or who cannot cooperate with breath-holding. Star-VIBE, T1-VIBE, and T2fBLADE have their own advantages in showing morphological signs of lung cancer, but T1 mapping are currently not recommended for lung cancer morphology. Combined multisequence MR can better display the morphological signs of peripheral lung cancer, which is expected to be an effective complementary means of observing the morphological signs of lung cancer and a radiation-free alternative to CT.</p></sec><sec id="Sec17" sec-type="supplementary-material"><title>Electronic supplementary material</title><p>Below is the link to the electronic supplementary material.</p><p>
<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="12880_2025_1726_MOESM1_ESM.docx"><caption><p>Supplementary Material 1</p></caption></media></supplementary-material>
</p><p>
<supplementary-material content-type="local-data" id="MOESM2"><media xlink:href="12880_2025_1726_MOESM2_ESM.xlsx"><caption><p>Supplementary Material 2</p></caption></media></supplementary-material>
</p><p>
<supplementary-material content-type="local-data" id="MOESM3"><media xlink:href="12880_2025_1726_MOESM3_ESM.xlsx"><caption><p>Supplementary Material 3</p></caption></media></supplementary-material>

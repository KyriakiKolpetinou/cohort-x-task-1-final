</sup></td><td rowspan="1" colspan="1">++</td><td rowspan="1" colspan="1">++</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">++</td><td rowspan="1" colspan="1">+</td></tr><tr><td rowspan="1" colspan="1">Kalani 1999<sup>

</sup></td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">++</td><td rowspan="1" colspan="1">+++</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">++</td></tr><tr><td rowspan="1" colspan="1">Ladurner 2010<sup>
<xref rid="bibr32-1358863X241309326" ref-type="bibr">32</xref>

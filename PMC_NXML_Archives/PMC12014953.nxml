</sup></td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">++</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">+</td><td rowspan="1" colspan="1">++</td></tr><tr><td rowspan="1" colspan="1">Kawai 2017<sup>

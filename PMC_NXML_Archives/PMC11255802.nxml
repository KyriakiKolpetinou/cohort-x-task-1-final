</bold>
</td></tr><tr><td align="left" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">78 (61.9%)</td></tr><tr><td align="left" rowspan="1" colspan="1">2</td><td align="center" rowspan="1" colspan="1">25 (19.8%)</td></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">15 (11.9%)</td></tr><tr><td align="left" rowspan="1" colspan="1">4 or more</td><td align="center" rowspan="1" colspan="1">08 (06.3%)</td></tr><tr><td align="left" colspan="2" rowspan="1">

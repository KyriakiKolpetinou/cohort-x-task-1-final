</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">1</td><td align="center" rowspan="1" colspan="1">12 (10.5%)</td><td align="center" rowspan="1" colspan="1">02 (18.2%)</td><td align="center" rowspan="5" colspan="1">0.2<sup>&#x02021;</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">2</td><td align="center" rowspan="1" colspan="1">26 (22.8%)</td><td align="center" rowspan="1" colspan="1">03 (27.3%)</td></tr><tr><td align="left" rowspan="1" colspan="1">3</td><td align="center" rowspan="1" colspan="1">30 (26.3%)</td><td align="center" rowspan="1" colspan="1">03 (27.3%)</td></tr><tr><td align="left" rowspan="1" colspan="1">4</td><td align="center" rowspan="1" colspan="1">19 (16.7%)</td><td align="center" rowspan="1" colspan="1">03 (27.3%)</td></tr><tr><td align="left" rowspan="1" colspan="1">5 or more</td><td align="center" rowspan="1" colspan="1">27 (23.7%)</td><td align="center" rowspan="1" colspan="1">0 (0.0%)</td></tr><tr><td align="left" rowspan="1" colspan="1">Scar Thickness</td><td align="center" rowspan="1" colspan="1">3.7 (2.8-4.3)</td><td align="center" rowspan="1" colspan="1">3.5 (2.1-4.0)</td><td align="center" rowspan="1" colspan="1">0.1<sup>&#x000b6;</sup></td></tr><tr><td align="left" colspan="3" rowspan="1">

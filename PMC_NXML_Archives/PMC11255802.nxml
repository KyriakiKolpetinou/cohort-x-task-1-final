</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">None</td><td align="center" rowspan="1" colspan="1">96 (83.5%)</td><td align="center" rowspan="1" colspan="1">07 (63.6%)</td><td align="center" rowspan="1" colspan="1">0.4<sup>&#x000a7;</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">GDM</td><td align="center" rowspan="1" colspan="1">07 (6.1%)</td><td align="center" rowspan="1" colspan="1">03 (27.3%)</td><td align="center" rowspan="1" colspan="1">0.05<sup>&#x000a7;</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">PIH/Preeclampsia</td><td align="center" rowspan="1" colspan="1">04 (3.5%)</td><td align="center" rowspan="1" colspan="1">01 (9.1%)</td><td align="center" rowspan="1" colspan="1">1.00<sup>&#x000a7;</sup></td></tr><tr><td align="left" rowspan="1" colspan="1">Other</td><td align="center" rowspan="1" colspan="1">09 (7.8%)</td><td align="center" rowspan="1" colspan="1">01 (9.1%)</td><td align="center" rowspan="1" colspan="1">1.00<sup>&#x000a7;</sup></td></tr><tr><td align="left" colspan="3" rowspan="1">

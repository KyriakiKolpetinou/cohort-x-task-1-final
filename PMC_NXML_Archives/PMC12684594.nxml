<styled-content style="fixed-case" toggle="no">GATA2</styled-content> Mediates Macrophage Proliferation During Atherosclerosis</article-title><alt-title alt-title-type="right-running-head">
<styled-content style="fixed-case" toggle="no">GATA2</styled-content> in Atherosclerosis</alt-title><alt-title alt-title-type="left-running-head">Aktar et&#x000a0;al</alt-title></title-group><contrib-group><contrib id="jah311546-cr-0001" contrib-type="author"><name><surname>Aktar</surname><given-names>Amena</given-names></name><degrees>PhD</degrees><xref rid="jah311546-aff-0001" ref-type="aff">

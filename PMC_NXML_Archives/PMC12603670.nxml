owspan="1" colspan="1">&#x02212;0.507</td><td align="center" valign="top" rowspan="1" colspan="1">0.518</td><td align="center" valign="top" rowspan="1" colspan="1">0.978</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T2&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.143</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.61</td><td align="center" valign="top" rowspan="1" colspan="1">0.399</td><td align="center" valign="top" rowspan="1" colspan="1">0.612</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T3&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T4&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.284</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.695</td><td align="center" valign="top" rowspan="1" colspan="1">0.267</td><td align="center" valign="top" rowspan="1" colspan="1">0.306</td></tr><tr><td align="center" rowspan="8" valign="top" colspan="1">Linge &#x00026; Linge</td><td align="center" valign="top" rowspan="1" colspan="1">RANKL T1&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.127</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.601</td><td align="center" valign="top" rowspan="1" colspan="1">0.412</td><td align="center" valign="top" rowspan="1" colspan="1">0.651</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">RANKL T2&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.019</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.526</td><td align="center" valign="top" rowspan="1" colspan="1">0.498</td><td align="center" valign="top" rowspan="1" colspan="1">0.947</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">RANKL T3&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">RANKL T4&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">0.271</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.281</td><td align="center" valign="top" rowspan="1" colspan="1">0.688</td><td align="center" valign="top" rowspan="1" colspan="1">0.329</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T1&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.002</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.514</td><td align="center" valign="top" rowspan="1" colspan="1">0.511</td><td align="center" valign="top" rowspan="1" colspan="1">0.995</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T2&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.227</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.662</td><td align="center" valign="top" rowspan="1" colspan="1">0.323</td><td align="center" valign="top" rowspan="1" colspan="1">0.415</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T3&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T4&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.282</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.694</td><td align="center" valign="top" rowspan="1" colspan="1">0.269</td><td align="center" valign="top" rowspan="1" colspan="1">0.309</td></tr><tr><td align="center" rowspan="8" valign="top" colspan="1">Malmgrem</td><td align="center" valign="top" rowspan="1" colspan="1">RANKL T1&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">0.236</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.315</td><td align="center" valign="top" rowspan="1" colspan="1">0.667</td><td align="center" valign="top" rowspan="1" colspan="1">0.398</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">RANKL T2&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">0.018</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.499</td><td align="center" valign="top" rowspan="1" colspan="1">0.525</td><td align="center" valign="top" rowspan="1" colspan="1">0.95</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">RANKL T3&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">RANKL T4&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.267</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.685</td><td align="center" valign="top" rowspan="1" colspan="1">0.285</td><td align="center" valign="top" rowspan="1" colspan="1">0.337</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T1&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">0.031</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.489</td><td align="center" valign="top" rowspan="1" colspan="1">0.535</td><td align="center" valign="top" rowspan="1" colspan="1">0.914</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T2&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">0.18</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.366</td><td align="center" valign="top" rowspan="1" colspan="1">0.634</td><td align="center" valign="top" rowspan="1" colspan="1">0.52</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T3&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02014;</td></tr><tr><td align="center" valign="top" rowspan="1" colspan="1">OPG T4&#x02010;T0</td><td align="center" valign="top" rowspan="1" colspan="1">0.32</td><td align="center" valign="top" rowspan="1" colspan="1">&#x02212;0.23</td><td align="center" valign="top" rowspan="1" colspan="1">0.715</td><td align="center" valign="top" rowspan="1" colspan="1">0.246</td></tr></tbody></table></table-wrap></sec><sec id="ocr70028-sec-0021"><label>3.2.4</label><title>Aligner Fit</title><p>Clinical assessment of aligner fit showed minimal cases of detectable misfit across all visits, with no significant differences among groups (<italic toggle="yes">p</italic>&#x02009;=&#x02009;0.798). Neither the application of vibratory forces nor the aligner change protocol (7&#x02010; or 14&#x02010;day intervals) had an impact on the clinical fit of the aligners throughout treatment.</p></sec></sec></sec><sec sec-type="discussion" id="ocr70028-sec-0022"><label>4</label><title>Discussion</title><p>This study analysed EARR in patients treated with clear aligners, with and without vibratory forces, using three established radiographic assessment methods: Linge &#x00026; Linge, Fritz &#x00026; Krieger, and Malmgren. An ITT analysis was conducted to preserve the integrity of randomisation and minimise potential bias from patient dropout.</p><sec id="ocr70028-sec-0023"><label>4.1</label><title>Methods for Assessing <styled-content style="fixed-case" toggle="no">EARR</styled-content>
</title><p>EARR was evaluated using digital panoramic radiographs, a widely used imaging modality in orthodontics due to its accessibility and lower radiation exposure. However, its accuracy is limited compared to cone&#x02010;beam computed tomography (CBCT) [<xref rid="ocr70028-bib-0024" ref-type="bibr">24</xref>], which eliminates geometric distortions and anatomical superimpositions. While panoramic radiographs remain a standard diagnostic tool, their precision depends on image quality, magnification control, and standardisation techniques. Methods relying on proportional measurements, such as Linge &#x00026; Linge and Fritz &#x00026; Krieger, attempt to correct for radiographic distortions but may still be affected by image inconsistencies [<xref rid="ocr70028-bib-0005" ref-type="bibr">5</xref>, <xref rid="ocr70028-bib-0020" ref-type="bibr">20</xref>]. The Malmgren scale, although useful for grading resorption severity, introduces a subjective component that can create variability among evaluators [<xref rid="ocr70028-bib-0005" ref-type="bibr">5</xref>, <xref rid="ocr70028-bib-0020" ref-type="bibr">20</xref>, <xref rid="ocr70028-bib-0024" ref-type="bibr">24</xref>].</p><p>CBCT has been shown to be more reliable for assessing root resorption, as it compensates for positional changes during treatment and offers volumetric analysis [<xref rid="ocr70028-bib-0025" ref-type="bibr">25</xref>]. However, its routine use is limited by higher radiation exposure and cost, making it ethically unsuitable for routine orthodontic monitoring, particularly in paediatric and adolescent patients [<xref rid="ocr70028-bib-0005" ref-type="bibr">5</xref>, <xref rid="ocr70028-bib-0026" ref-type="bibr">26</xref>]. Current guidelines recommend its use only when clinical or two&#x02010;dimensional radiographic findings are inconclusive.</p><p>While panoramic radiographs offer a practical and ethically acceptable option for monitoring root resorption in clinical settings, they lack the detail and localised accuracy of periapical radiographs. Although periapical imaging was not included in this study due to field&#x02010;of&#x02010;view constraints and standardisation challenges, its inclusion in future research could improve the precision of EARR assessment and provide a valuable comparative perspective.</p><p>Recent computational and digital advancements have improved measurement reproducibility, even when using panoramic images. Software, such as Dolphin Imaging and ARIAS, has been validated for orthodontic research, enabling more accurate EARR assessments [<xref rid="ocr70028-bib-0027" ref-type="bibr">27</xref>, <xref rid="ocr70028-bib-0028" ref-type="bibr">28</xref>]. Future studies should explore hybrid protocols integrating digitisation techniques, correction algorithms, and (AI)&#x02010;assisted image analysis to enhance diagnostic precision. The incorporation of biomarkers [<xref rid="ocr70028-bib-0029" ref-type="bibr">29</xref>] and volumetric imaging [<xref rid="ocr70028-bib-0030" ref-type="bibr">30</xref>] may further advance early detection and prevention strategies for EARR in orthodontics.</p></sec><sec id="ocr70028-sec-0024"><label>4.2</label><title>Effect of Vibration on <styled-content style="fixed-case" toggle="no">EARR</styled-content>
</title><p>Intermittent vibratory forces have been proposed as a non&#x02010;invasive technique to accelerate tooth movement and potentially reduce adverse effects such as EARR and periodontal complications [<xref rid="ocr70028-bib-0003" ref-type="bibr">3</xref>, <xref rid="ocr70028-bib-0016" ref-type="bibr">16</xref>, <xref rid="ocr70028-bib-0017" ref-type="bibr">17</xref>]. However, the increase in osteoclastic activity during treatment may pose a potential risk, especially in patients with a genetic predisposition or specific anatomical characteristics that favour the development of EARR. Studies have shown conflicting results&#x02014;some reporting no significant increase in EARR with vibration [<xref rid="ocr70028-bib-0017" ref-type="bibr">17</xref>], while others suggest potential adverse effects when combined with high orthodontic forces [<xref rid="ocr70028-bib-0030" ref-type="bibr">30</xref>]. DiBiase et&#x000a0;al. [<xref rid="ocr70028-bib-0031" ref-type="bibr">31</xref>] investigated the effect of AcceleDent on EARR using periapical radiographs and found no significant impact on maxillary central incisors. Their results are consistent with ours, though direct comparisons are limited due to differences in appliance type (fixed appliances) and imaging method. In contrast, El&#x02010;Bialy et&#x000a0;al. [<xref rid="ocr70028-bib-0032" ref-type="bibr">32</xref>] found that low&#x02010;intensity pulsed ultrasound (1.5&#x02009;MHz) significantly reduced root resorption, but their methodology differed from ours in terms of force application and target teeth (canines only).</p><p>Studies using higher vibrational forces (50&#x02009;Hz, 150&#x02009;g), such as those by Yilmaz et&#x000a0;al. [<xref rid="ocr70028-bib-0030" ref-type="bibr">30</xref>], also reported no effect on EARR, consistent with our findings. Mayama et&#x000a0;al. [<xref rid="ocr70028-bib-0016" ref-type="bibr">16</xref>] and Abd Elmotaleb et&#x000a0;al. [<xref rid="ocr70028-bib-0033" ref-type="bibr">33</xref>] further support this, showing that supplemental vibration did not increase root resorption in patients treated with fixed appliances. However, these studies primarily examined patients treated with fixed appliances undergoing canine retraction, making direct comparisons with our aligner&#x02010;based study difficult.</p><p>While all previous research on vibration and EARR involved fixed appliances, our study is among the first to investigate its effects in clear aligner therapy. Our results indicate that vibration did not significantly impact EARR, regardless of the aligner change protocol (7 or 14&#x02010;day intervals). The absence of significant differences may be attributed to sample size limitations (<italic toggle="yes">n</italic>&#x02009;=&#x02009;45), though this was based on prior power calculations.</p></sec><sec id="ocr70028-sec-0025"><label>4.3</label><title>Correlation Between <styled-content style="fixed-case" toggle="no">EARR</styled-content> and Biomarkers</title><p>Since OIEARR is mediated by the RANKL/OPG axis, where RANKL promotes bone resorption and OPG acts as its inhibitor [<xref rid="ocr70028-bib-0034" ref-type="bibr">34</xref>, <xref rid="ocr70028-bib-0035" ref-type="bibr">35</xref>], it has been hypothesised that vibration could modulate these biomarkers [<xref rid="ocr70028-bib-0008" ref-type="bibr">8</xref>]. However, similar to Yilmaz et&#x000a0;al. [<xref rid="ocr70028-bib-0030" ref-type="bibr">30</xref>], our study found no significant differences in RANKL and OPG levels between patients with and without vibration. A key finding in this study was the significant negative correlation observed in Group B (aligner changes every 14&#x02009;days initially, followed by vibration and 7&#x02010;day changes) between EARR at T2 to T0 (Fritz &#x00026; Krieger, <italic toggle="yes">p</italic>&#x02009;=&#x02009;0.010) and OPG levels, with a trend toward significance using Linge &#x00026; Linge (<italic toggle="yes">p</italic>&#x02009;=&#x02009;0.080). This suggests a possible interaction between aligner change frequency and vibration timing in influencing root resorption, warranting further investigation. The negative correlation between OPG and EARR may indicate that while OPG plays a protective role in bone resorption, its expression alone may not be sufficient to counteract orthodontic forces in all case&#x000a0;[<xref rid="ocr70028-bib-0035" ref-type="bibr">35</xref>]. However, this is an isolated finding among many correlations tested across groups, time points, and measurement methods. Therefore, it should be interpreted with caution, as it may represent a type I error rather than a true biological association. Inflammatory cytokines, particularly IL&#x02010;1&#x003b2; and TNF&#x02010;&#x003b1;, have also been associated with osteoclast activation and increased EARR [<xref rid="ocr70028-bib-0036" ref-type="bibr">36</xref>, <xref rid="ocr70028-bib-0037" ref-type="bibr">37</xref>], with some studies reporting a correlation between elevated IL&#x02010;1&#x003b2; levels and greater EARR in orthodontic patients [<xref rid="ocr70028-bib-0038" ref-type="bibr">38</xref>]. However, our findings did not show a uniform correlation between these biomarkers and EARR, which could be influenced by individual biological responses, genetic variability, applied force magnitude [<xref rid="ocr70028-bib-0037" ref-type="bibr">37</xref>], and vibration frequency, amplitude, and duration [<xref rid="ocr70028-bib-0034" ref-type="bibr">34</xref>]. These results reinforce that EARR is a multifactorial process, where biomarker regulation alone does not always translate into clinically observable differences. While the RANKL/OPG axis and inflammatory cytokines contribute to root resorption, their predictive value remains uncertain. Additionally, the absence of notable biomarker changes further suggests that vibration alone may not be sufficient to influence the biological mechanisms of root resorption and repair [<xref rid="ocr70028-bib-0002" ref-type="bibr">2</xref>, <xref rid="ocr70028-bib-0022" ref-type="bibr">22</xref>]. Future studies should explore alternative vibrational parameters, patient&#x02010;specific factors, and combination therapies to better understand their impact on EARR and develop personalised prevention strategies.</p><p>Overall, vibration did not produce a clinically significant reduction in EARR. The lack of a clinically relevant reduction in EARR aligns with previous studies [<xref rid="ocr70028-bib-0005" ref-type="bibr">5</xref>, <xref rid="ocr70028-bib-0020" ref-type="bibr">20</xref>, <xref rid="ocr70028-bib-0031" ref-type="bibr">31</xref>], supporting the idea that vibration, as currently applied, does not significantly affect resorption processes. This study provides new insights into the effects of intermittent vibratory forces on EARR in clear aligner therapy. While vibration did not significantly impact root resorption, a correlation between OPG levels and EARR in one group suggests complex biological interactions. These findings highlight the need for standardised vibration protocols and further research to optimise clinical applications. Understanding the biological and mechanical factors influencing root resorption could improve patient safety and treatment outcomes in orthodontics.</p></sec><sec id="ocr70028-sec-0026"><label>4.4</label><title>Limitations and Generalizability</title><p>Limitations of this study include a relatively small sample size, which may have contributed to the lack of statistically significant differences. Additionally, the sample size calculation was based on biomarker data (RANKL levels), not on the clinical outcome of EARR, which was the primary outcome of this study. As a result, the study may have been underpowered to detect smaller, yet clinically relevant differences in root resorption. Therefore, this limitation should be considered when interpreting the results, as a type II error cannot be ruled out.</p><p>Additionally, root length measurements were based on two&#x02010;dimensional radiographs, as ethical concerns prevented the use of cone&#x02010;beam computed tomography (CBCT) to minimise radiation exposure.</p><p>Although the overall study design combined two variables&#x02014;vibration application and aligner change frequency&#x02014;the structure of this three&#x02010;arm RCT allowed for their independent evaluation within specific time periods. Vibration was intentionally paired with a 7&#x02010;day aligner change protocol, as this combination is clinically recommended to enhance tooth movement and reduce overall treatment time. For example, the effect of vibration alone could be assessed by comparing group A and group C during weeks 0&#x02013;6, while the effect of aligner change frequency without vibration could be evaluated by comparing groups B and C during the same period. However, we recognise that beyond these intervals, the combination of variables may introduce confounding and limit the interpretation of long&#x02010;term effects attributed to each factor independently. Future studies using a fully factorial design would be valuable to clarify the interaction and individual contributions of these variables.</p><p>Future studies should focus on standardising protocols, including vibration application, treatment duration, and vibration frequency, to enhance comparability and reproducibility.</p></sec></sec><sec sec-type="conclusions" id="ocr70028-sec-0027"><label>5</label><title>Conclusions</title><p>
<list list-type="bullet" id="ocr70028-list-0003"><list-item id="ocr70028-li-0007"><p>Vibration did not have a significant impact on EARR in patients treated with clear aligners, indicating that its use does not offer a clear advantage in preventing root resorption.</p></list-item><list-item id="ocr70028-li-0008"><p>Correlations between biomarkers and EARR were variable, suggesting that susceptibility to root resorption does not depend exclusively on the expression of RANKL and OPG, but rather on a complex interaction of biological and mechanical factors.</p></list-item></list>
</p></sec><sec id="ocr70028-sec-0028"><title>Author Contributions</title><p>C.M., F.Y.&#x02010;O., and A.C. designed the study. M.S.M. recorded the data. L.T. extracted the data and, together with C.M., played a leading role in interpreting the results and drafting the manuscript. A.P.&#x02010;I. and L.T. were major contributors to the study implementation. A.P.&#x02010;I. secured partial funding for the study. A.C., F.Y.&#x02010;O., and M.S.M. supported manuscript preparation. All authors read and approved the final manuscript.</p></sec><sec id="ocr70028-sec-0030"><title>Ethics Statement</title><p>This study was conducted in accordance with the Declaration of Helsinki and was approved by the San Carlos Hospital's ethics committee (ref: C.P.&#x02010;C.I: 15/313).</p></sec><sec sec-type="conclusions" id="ocr70028-sec-0031"><title>Consent</title><p>Written informed consent was obtained from all participants, and patient confidentiality was maintained throughout the study.</p></sec><sec sec-type="COI-statement" id="ocr70028-sec-0032"><title>Conflicts of Interest</title><p>The authors declare no conflicts of interest.</p></sec></body><back><ack id="ocr70028-sec-0029"><title>Acknowledgements</title><p>The authors thank the Department of Dental Clinical Specialties at Complutense University of Madrid for hosting the study's clinical part. We would like to thank the BIOCRAN (Craniofacial Biology: Orthodontics and Dentofacial Orthopaedics) Research Group, Faculty of Odontology, Complutense University of Madrid, for its support.</p></ack><sec sec-type="data-availability" id="ocr70028-sec-0034"><title>Data Availability Statement</title><p>The datasets used and/or analysed during the current study are available from the corresponding author on reasonable request.</p></sec><ref-list content-type="cited-references" id="ocr70028-bibl-0001"><title>References</title><ref id="ocr70028-bib-0001"><label>1</label><mixed-citation publication-type="journal" id="ocr70028-cit-0001">

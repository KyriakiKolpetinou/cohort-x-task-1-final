</person-group><article-title>Actual flip-angle imaging in the pulsed steady state: A method for rapid three-dimensional mapping of the transmitted radiofrequency field</article-title><source>Magn. Reson. Med.</source><year>2007</year><volume>57</volume><fpage>192</fpage><lpage>200</lpage><pub-id pub-id-type="doi">10.1002/mrm.21120</pub-id><pub-id pub-id-type="pmid">17191242</pub-id></element-citation></ref><ref id="B8-tomography-09-00128"><label>8.</label><element-citation publication-type="journal"><person-group person-group-type="author">

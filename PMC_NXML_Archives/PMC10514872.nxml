<name><surname>Wiesinger</surname><given-names>F.</given-names></name>
</person-group><article-title>Transmit gain calibration for nonproton MR using the Bloch-Siegert shift</article-title><source>NMR Biomed.</source><year>2011</year><volume>24</volume><fpage>1068</fpage><lpage>1072</lpage><pub-id pub-id-type="doi">10.1002/nbm.1657</pub-id><pub-id pub-id-type="pmid">21387441</pub-id></element-citation></ref><ref id="B9-tomography-09-00128"><label>9.</label><element-citation publication-type="journal"><person-group person-group-type="author">

</td></tr><tr><td align="center" rowspan="4" colspan="1">Stair Up Test</td><td align="center" rowspan="1" colspan="1">Single centrifuged PRP</td><td align="center" rowspan="1" colspan="1">20.33 &#x000b1; 5.56</td><td align="center" rowspan="1" colspan="1">23.50 &#x000b1; 9.27</td><td align="left" colspan="2" rowspan="1"> 0.006</td></tr><tr><td align="center" rowspan="1" colspan="1">Double-centrifuged PRP</td><td align="center" rowspan="1" colspan="1">21.48 &#x000b1; 6.99</td><td align="center" rowspan="1" colspan="1">26.05 &#x000b1; 8.72</td><td align="left" colspan="2" rowspan="1">&#x0003c;0.001</td></tr><tr><td align="center" rowspan="1" colspan="1">Placebo</td><td align="center" rowspan="1" colspan="1">17.33 &#x000b1; 4.03</td><td align="center" rowspan="1" colspan="1">14.60 &#x000b1; 3.73</td><td align="left" colspan="2" rowspan="1">&#x0003c;0.001</td></tr><tr><td align="left" colspan="5" rowspan="1">

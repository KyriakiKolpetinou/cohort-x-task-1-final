</td></tr><tr><td style="background-color:#D9D9D9;" align="center" rowspan="4" colspan="1">TUG</td><td style="background-color:#D9D9D9;" align="center" rowspan="1" colspan="1">Single centrifuged PRP</td><td style="background-color:#D9D9D9;" align="center" rowspan="1" colspan="1">12.0 (11.0, 12.0)</td><td style="background-color:#D9D9D9;" align="center" rowspan="1" colspan="1">9.45 &#x000b1; 2.01</td><td style="background-color:#D9D9D9;" align="left" colspan="2" rowspan="1">0.046</td></tr><tr><td style="background-color:#D9D9D9;" align="center" rowspan="1" colspan="1">Double-centrifuged PRP</td><td style="background-color:#D9D9D9;" align="center" rowspan="1" colspan="1">12.0 (8.0, 13.0)</td><td style="background-color:#D9D9D9;" align="center" rowspan="1" colspan="1">9.81 &#x000b1; 2.04</td><td style="background-color:#D9D9D9;" align="left" colspan="2" rowspan="1">0.001</td></tr><tr><td style="background-color:#D9D9D9;" align="center" rowspan="1" colspan="1">Placebo</td><td style="background-color:#D9D9D9;" align="center" rowspan="1" colspan="1">13.0 (10.0, 15.0)</td><td style="background-color:#D9D9D9;" align="center" rowspan="1" colspan="1">11.80 &#x000b1; 2.65</td><td style="background-color:#D9D9D9;" align="left" colspan="2" rowspan="1">0.831</td></tr><tr><td style="background-color:#D9D9D9;" align="left" colspan="5" rowspan="1">
<bold>

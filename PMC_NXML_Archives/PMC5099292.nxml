<table-wrap id="Tab4"><label>Table 4</label><caption><p>Bland-Altman analysis results for differences between voxelwise tumour-to-blood ratio values</p></caption><table frame="hsides" rules="groups"><thead><tr valign="top"><th>Lesion #</th><th>Mean&#x02009;&#x000b1;&#x02009;SD (95&#x000a0;% CI)</th><th>LLA, ULA</th></tr></thead><tbody><tr valign="top"><td>1</td><td>&#x02212;0.21&#x02009;&#x000b1;&#x02009;0.12 (&#x02212;0.45 to 0.04)</td><td>&#x02212;0.45, 0.04</td></tr><tr valign="top"><td>2</td><td>0.11&#x02009;&#x000b1;&#x02009;0.10 (0.10 to 0.12)</td><td>&#x02212;0.09, 0.31</td></tr><tr valign="top"><td>3</td><td>&#x02212;0.04&#x02009;&#x000b1;&#x02009;0.09 (&#x02212;0.05 to &#x02212;0.03)</td><td>&#x02212;0.21, 0.13</td></tr><tr valign="top"><td>4</td><td>&#x02212;0.01&#x02009;&#x000b1;&#x02009;0.13 (&#x02212;0.03 to 0.00)</td><td>&#x02212;0.26, 0.23</td></tr><tr valign="top"><td>5</td><td>0.14&#x02009;&#x000b1;&#x02009;.19 (0.11 to 0.17)</td><td>&#x02212;0.23, 0.51</td></tr><tr valign="top"><td>6</td><td>0.04&#x02009;&#x000b1;&#x02009;0.09 (0.03 to 0.05)</td><td>&#x02212;0.13, 0.21</td></tr><tr valign="top"><td>7</td><td>0.04&#x02009;&#x000b1;&#x02009;0.07 (0.03 to 0.05)</td><td>&#x02212;0.11, 0.18</td></tr><tr valign="top"><td>8</td><td>0.04&#x02009;&#x000b1;&#x02009;0.04 (0.03 to 0.05)</td><td>&#x02212;0.04, 0.13</td></tr><tr valign="top"><td>9</td><td>&#x02212;0.03&#x02009;&#x000b1;&#x02009;0.09 (&#x02212;0.03 to &#x02212;0.02)</td><td>&#x02212;0.20, 0.15</td></tr><tr valign="top"><td>10</td><td>&#x02212;0.01&#x02009;&#x000b1;&#x02009;0.06 (&#x02212;0.02 to &#x02212;0.01)</td><td>&#x02212;0.12, 0.09</td></tr><tr valign="top"><td>11</td><td>0.10&#x02009;&#x000b1;&#x02009;0.05 (0.09 to 0.11)</td><td>0.00, 0.20</td></tr><tr valign="top"><td>12</td><td>0.05&#x02009;&#x000b1;&#x02009;0.09 (0.04 to 0.06)</td><td>&#x02212;0.13, 0.24</td></tr><tr valign="top"><td>13</td><td>0.01&#x02009;&#x000b1;&#x02009;0.11 (0.00 to 0.02)</td><td>&#x02212;0.20, 0.22</td></tr><tr valign="top"><td>14</td><td>0.01&#x02009;&#x000b1;&#x02009;0.10 (&#x02212;0.01 to 0.02)</td><td>&#x02212;0.19, 0.20</td></tr><tr valign="top"><td>15</td><td>0.09&#x02009;&#x000b1;&#x02009;.07 (0.07 to 0.11)</td><td>&#x02212;0.05, 0.22</td></tr><tr valign="top"><td>16</td><td>&#x02212;0.13&#x02009;&#x000b1;&#x02009;0.07 (&#x02212;0.14 to &#x02212;0.12)</td><td>&#x02212;0.28, 0.01</td></tr><tr valign="top"><td>17</td><td>0.07&#x02009;&#x000b1;&#x02009;0.07 (0.06 to 0.08)</td><td>&#x02212;0.06, 0.20</td></tr><tr valign="top"><td>18</td><td>0.01&#x02009;&#x000b1;&#x02009;0.07 (0.00 to 0.02)</td><td>&#x02212;0.12, 0.14</td></tr><tr valign="top"><td>19</td><td>0.08&#x02009;&#x000b1;&#x02009;0.07 (0.07 to 0.10)</td><td>&#x02212;0.05, 0.22</td></tr><tr valign="top"><td>Pooled data</td><td>0.01&#x02009;&#x000b1;&#x02009;0.12 (0.01 to 0.02)</td><td>&#x02212;0.22, 0.24</td></tr></tbody></table><table-wrap-foot><p>

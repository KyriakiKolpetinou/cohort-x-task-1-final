&#x05408;&#x072b6;&#x06001;&#x03002;&#x076f4;&#x080a0;&#x09634;&#x09053;&#x07b4b;&#x0819c;&#x0ff0c;&#x0901a;&#x05e38;&#x079f0;&#x04e3a;Douvillier&#x07b4b;&#x0819c;&#x0ff0c;&#x04f4d;&#x04e8e;&#x076f4;&#x080a0;&#x0809b;&#x07ba1;&#x04e0e;&#x09634;&#x09053;&#x0540e;&#x058c1;&#x04e4b;&#x095f4;&#x0ff0c;&#x08d1f;&#x08d23;&#x08fde;&#x063a5;&#x04e3b;&#x09ab6;&#x097e7;&#x05e26;&#x0590d;&#x05408;&#x04f53;&#x04e0e;&#x04f1a;&#x09634;&#x04f53;<sup>[<xref rid="b20" ref-type="bibr">20</xref>]</sup>&#x0ff0c;&#x05e76;&#x07ef4;&#x06301;&#x09634;&#x09053;&#x08fdc;&#x07aef;&#x07684;H&#x05f62;&#x07ed3;&#x06784;&#x03002;GUANZON&#x07b49;<sup>[<xref rid="b27" ref-type="bibr">27</xref>]</sup>&#x053d1;&#x073b0;&#x0ff0c;&#x05728;&#x04fee;&#x0590d;&#x09876;&#x07aef;&#x07684;&#x0540c;&#x065f6;&#x04fee;&#x0590d;&#x04f1a;&#x09634;&#x04f53;&#x05e76;&#x07f29;&#x05c0f;&#x0751f;&#x06b96;&#x088c2;&#x05b54;&#x080fd;&#x06709;&#x06548;&#x0964d;&#x04f4e;&#x0672f;&#x0540e;&#x0590d;&#x053d1;&#x07387;&#x03002;SCHMIDT&#x07b49;<sup>[<xref rid="b28" ref-type="bibr">28</xref>]</sup>&#x0901a;&#x08fc7;&#x0672f;&#x0524d;MRI&#x053d1;&#x073b0;&#x0ff0c;&#x09759;&#x0606f;&#x072b6;&#x06001;&#x04e0b;&#x0809b;&#x063d0;&#x0808c;&#x088c2;&#x05b54;&#x05927;&#x05c0f;&#x04e0e;&#x0672f;&#x0540e;&#x0590d;&#x053d1;&#x06709;&#x076f8;&#x05173;&#x06027;&#x03002;KRISSI&#x07b49;<sup>[<xref rid="b29" ref-type="bibr">29</xref>]</sup>&#x04e5f;&#x053d1;&#x073b0;&#x0ff0c;&#x0751f;&#x06b96;&#x088c2;&#x05b54;&#x07684;&#x0589e;&#x05927;&#x0662f;&#x095ed;&#x05408;&#x0624b;&#x0672f;&#x0590d;&#x053d1;&#x07684;&#x04e00;&#x04e2a;&#x09ad8;&#x05371;&#x056e0;&#x07d20;&#x03002;</p></sec></sec><sec id="s04"><label>4</label><title>&#x052a8;&#x06001;MRI&#x05728;&#x04e2d;&#x076c6;&#x08154;&#x07f3a;&#x09677;&#x04fee;&#x0590d;&#x0672f;&#x0540e;&#x07684;&#x05e94;&#x07528;</title><sec id="s04.01"><label>4.1</label><title>&#x0624b;&#x0672f;&#x07597;&#x06548;&#x07684;&#x08bc4;&#x04f30;</title><p>CHEN&#x07b49;<sup>[<xref rid="b30" ref-type="bibr">30</xref>]</sup>&#x0901a;&#x08fc7;&#x091cf;&#x05316;&#x05206;&#x06790;&#x076c6;&#x05e95;&#x091cd;&#x05efa;&#x0624b;&#x0672f;&#x0524d;&#x0540e;&#x07684;MRI&#x056fe;&#x050cf;&#x053d1;&#x073b0;&#x0ff0c; 92%&#x07684;&#x060a3;&#x08005;&#x05728;&#x09876;&#x07aef;&#x04fee;&#x0590d;&#x0672f;&#x0540e;&#x080fd;&#x0591f;&#x06062;&#x0590d;&#x081f3;&#x06b63;&#x05e38;&#x07684;&#x089e3;&#x05256;&#x04f4d;&#x07f6e;&#x03002;BROCKER&#x07b49;<sup>[<xref rid="b31" ref-type="bibr">31</xref>]</sup>&#x05bf9;69&#x0540d;&#x07ecf;&#x09634;&#x09053;&#x07f51;&#x07247;&#x0690d;&#x05165;&#x0672f;&#x07684;&#x060a3;&#x08005;&#x08fdb;&#x0884c;&#x052a8;&#x06001;MRI&#x08bc4;&#x04f30;&#x0ff0c;&#x07ed3;&#x0679c;&#x0663e;&#x0793a;&#x0672f;&#x0540e;&#x08180;&#x080f1;&#x03001;&#x05b50;&#x05bab;&#x03001;&#x09053;&#x0683c;&#x062c9;&#x065af;&#x07a9d;&#x0548c;&#x076f4;&#x080a0;&#x07684;&#x04f4d;&#x07f6e;&#x05747;&#x06709;&#x0663e;&#x08457;&#x06539;&#x05584;&#x03002;MEDINA&#x07b49;<sup>[<xref rid="b32" ref-type="bibr">32</xref>]</sup>&#x053d1;&#x073b0;&#x0ff0c;&#x09ac2;&#x05c3e;&#x0808c;&#x056fa;&#x05b9a;&#x0672f;&#x0548c;&#x09ab6;&#x068d8;&#x097e7;&#x05e26;&#x056fa;&#x05b9a;&#x0672f;&#x0ff08;&#x05747;&#x04fdd;&#x07559;&#x05b50;&#x05bab;&#x0ff09;&#x0540e;&#x0ff0c;&#x089e3;&#x05256;&#x0590d;&#x04f4d;&#x0826f;&#x0597d;&#x03002;SENTURK&#x07b49;<sup>[<xref rid="b33" ref-type="bibr">33</xref>]</sup>&#x06bd4;&#x08f83;&#x04e86;&#x05355;&#x04fa7;&#x0548c;&#x053cc;&#x04fa7;&#x07ecf;&#x08179;&#x05b50;&#x05bab;&#x09ab6;&#x09aa8;&#x056fa;&#x05b9a;&#x0672f;&#x0ff0c;&#x07ed3;&#x0679c;&#x08868;&#x0660e;&#x04e24;&#x079cd;&#x0624b;&#x0672f;&#x065b9;&#x05f0f;&#x077ed;&#x0671f;&#x05185;&#x05747;&#x08868;&#x073b0;&#x0826f;&#x0597d;&#x07684;&#x089e3;&#x05256;&#x0548c;&#x0529f;&#x080fd;&#x06062;&#x0590d;&#x0ff0c;&#x05c24;&#x05176;&#x0662f;&#x053cc;&#x04fa7;&#x07ecf;&#x08179;&#x05b50;&#x05bab;&#x09ab6;&#x09aa8;&#x056fa;&#x05b9a;&#x0672f;&#x089e3;&#x05256;&#x0590d;&#x04f4d;&#x066f4;&#x063a5;&#x08fd1;&#x04e8e;&#x0751f;&#x07406;&#x072b6;&#x06001;&#x03002;</p><p>KASHIHARA&#x07b49;<sup>[<xref rid="b34" ref-type="bibr">34</xref>]</sup>&#x05bf9;&#x08179;&#x08154;&#x0955c;&#x05b50;&#x05bab;&#x09ab6;&#x09aa8;&#x056fa;&#x05b9a;&#x0672f;&#x0548c;&#x07ecf;&#x09634;&#x09053;&#x07f51;&#x07247;&#x0690d;&#x05165;&#x0672f;&#x0540e;MRI&#x056fe;&#x050cf;&#x08fdb;&#x0884c;&#x05bf9;&#x06bd4;&#x05206;&#x06790;&#x0ff0c;&#x053d1;&#x073b0;&#x05b50;&#x05bab;&#x09ab6;&#x09aa8;&#x056fa;&#x05b9a;&#x0672f;&#x0540e;&#x060a3;&#x08005;&#x09053;&#x0683c;&#x062c9;&#x065af;&#x07a9d;&#x04f4d;&#x07f6e;&#x076f8;&#x05bf9;&#x066f4;&#x09ad8;&#x0ff0c;&#x0800c;&#x05728;&#x06700;&#x05927;&#x05c4f;&#x06c14;&#x072b6;&#x06001;&#x04e0b;&#x0ff0c;&#x07ecf;&#x09634;&#x09053;&#x07f51;&#x07247;&#x0690d;&#x05165;&#x0672f;&#x0540e;&#x060a3;&#x08005;&#x07684;&#x09634;&#x09053;&#x079fb;&#x052a8;&#x05ea6;&#x066f4;&#x05927;&#x0ff0c;&#x08fd9;&#x053ef;&#x080fd;&#x04e0e;&#x07ecf;&#x09634;&#x09053;&#x07f51;&#x07247;&#x0690d;&#x05165;&#x0672f;&#x0540e;&#x0590d;&#x053d1;&#x098ce;&#x09669;&#x07684;&#x0589e;&#x052a0;&#x06709;&#x05173;&#x03002;SANTOS JUNIOR&#x07b49;<sup>[<xref rid="b35" ref-type="bibr">35</xref>]</sup>&#x0901a;&#x08fc7;&#x052a8;&#x06001;MRI&#x08bc4;&#x04f30;&#x04e86;&#x07ecf;&#x08179;&#x05bab;&#x09888;&#x09ab6;&#x09aa8;&#x056fa;&#x05b9a;&#x0672f;&#x0ff08;&#x05b50;&#x05bab;&#x06b21;&#x05168;&#x05207;&#x09664;&#x0ff09;&#x0548c;&#x09634;&#x09053;&#x09ab6;&#x068d8;&#x056fa;&#x05b9a;&#x0672f;&#x0ff08;&#x05b50;&#x05bab;&#x05168;&#x05207;&#x0672f;&#x0ff09;&#x07684;&#x04e2d;&#x0957f;&#x0671f;&#x07597;&#x06548;&#x0ff0c;&#x07ed3;&#x0679c;&#x0663e;&#x0793a;&#x04e24;&#x07ec4;&#x06cbb;&#x06108;&#x07387;&#x05206;&#x0522b;&#x04e3a;45%&#x0548c;60%&#x0ff0c;&#x05747;&#x04f4e;&#x04e8e;POP-Q&#x08bc4;&#x04f30;&#x07684;&#x05ba2;&#x089c2;&#x06cbb;&#x06108;&#x07387;&#x0ff08;75%&#x0548c;65%&#x0ff09;&#x0ff0c;&#x04e5f;&#x04f4e;&#x04e8e;&#x056fd;&#x09645;&#x05c3f;&#x05931;&#x07981;&#x054a8;&#x08be2;&#x059d4;&#x05458;&#x04f1a;-&#x09634;&#x09053;&#x075c7;&#x072b6;&#x095ee;&#x05377;&#x0ff08;ICIQ-VS&#x0ff09;&#x08bc4;&#x04f30;&#x07684;&#x04e3b;&#x089c2;&#x06cbb;&#x06108;&#x07387;&#x0ff08;&#x05747;&#x04e3a;85%&#x0ff09;&#x0ff0c;&#x08be6;&#x089c1;<xref rid="Table1" ref-type="table">&#x08868;1</xref>&#x03002;</p><table-wrap position="float" id="Table1"><label>&#x08868; 1</label><caption><title>The role of MRI in postoperative evaluation</title><p>MRI&#x05728;&#x0672f;&#x0540e;&#x08bc4;&#x04f30;&#x04e2d;&#x07684;&#x05e94;&#x07528;</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left" valign="middle" rowspan="1" colspan="1">Author (year)</td><td align="center" valign="middle" rowspan="1" colspan="1">Number of patients</td><td align="center" valign="middle" rowspan="1" colspan="1">Age of treatment/yr.</td><td align="center" valign="middle" rowspan="1" colspan="1">Normal control group (<italic toggle="yes">n</italic>)</td><td align="center" valign="middle" rowspan="1" colspan="1">MRI time</td><td align="center" valign="middle" rowspan="1" colspan="1">Surgical technique</td><td align="center" valign="middle" rowspan="1" colspan="1">Reference <break/>line</td><td align="center" valign="middle" rowspan="1" colspan="1">Results</td></tr></thead><tfoot><tr><td align="justify" valign="middle" colspan="8" rowspan="1">&#x03000;op: operation; MPL: midpubic line; HMO: H line, M line, and organ prolapes; the other abbreviations are explained in the note to <xref rid="Figure1" ref-type="fig">Fig 1</xref> and <xref rid="Figure3" ref-type="fig">Fig 3</xref>.</td></tr></tfoot><tbody><tr><td align="left" valign="top" rowspan="1" colspan="1">CHEN<sup>[<xref rid="b36" ref-type="bibr">36</xref>]</sup> (2022)</td><td align="center" valign="top" rowspan="1" colspan="1">31</td><td align="center" valign="top" rowspan="1" colspan="1">67.5</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Post-operation</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Native tissue suspension</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>SCIPP</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Increased vaginal wall length and an enlarged urogenital hiatus are associated with an increased risk of prolapse recurrence.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>SCHMIDT<sup>[<xref rid="b28" ref-type="bibr">28</xref>]</sup> (2022)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>35</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>67.7</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>19</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-operation</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Native tissue suspension</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>SCIPP</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>An increased levator ani area is correlated with an increased risk of prolapse recurrence.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>ZHANG<sup>[<xref rid="b37" ref-type="bibr">37</xref>]</sup> (2022)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>29</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>61.8</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>12</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre/1 month post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>MRI can demonstrate the position of prolapsed organs.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>SANTOS<sup>[<xref rid="b35" ref-type="bibr">35</xref>]</sup> (2021)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>20/20</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>67.9/67.1</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>27 months post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Abdominal sacrocolpopexy/Bilateral vaginal sacrospinous fixation</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>MRI is more sensitive in detecting recurrence at the apical and posterior vaginal walls.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>SHATKIN<sup>[<xref rid="b38" ref-type="bibr">38</xref>]</sup> (2021)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>14</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>62.1</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>6 months pre-op/12- 20 weeks post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Native tissue vaginal vault suspension</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL and HMO</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The degree of anterior vaginal wall prolapse and apical prolapse was significantly improved.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>Van IJSSELMUIDEN<sup>[<xref rid="b39" ref-type="bibr">39</xref>]</sup> (2020)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>5/5/5</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>62/68/57</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>6 months post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Vaginal sacrospinous hysteropexy (SSHP)/Laparoscopic sacrocolpopexy</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PICS</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The recurrence rate of anterior vaginal wall prolapse was higher after SSHP.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>MAHFOUZ<sup>[<xref rid="b40" ref-type="bibr">40</xref>]</sup> (2020)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>20</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>53</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op and post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Abdominal sacrocolpopexy</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The anatomical positions of the bladder neck and urethra were restored to normal.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>ZACHARAKIS<sup>[<xref rid="b41" ref-type="bibr">41</xref>]</sup> (2018)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>30</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>54</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>3 months post-op/1 year post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Laparoscopic sacrocolpopexy</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The position and integrity of the mesh were clearly visible.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>Van der WEIDEN<sup>[<xref rid="b42" ref-type="bibr">42</xref>]</sup> (2014)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>49</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op/6 months post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Laparoscopic sacrocolpopexy</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>MRI demonstrated significant improvement in all three compartments postoperatively.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>BROCKER<sup>[<xref rid="b31" ref-type="bibr">31</xref>]</sup> (2015)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>69</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>64.7</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>&#x03000;Normal group &#x03000;(10)</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op/12 weeks and 1 year post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Transvaginal mesh surgery</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL and MPL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>MRI evaluation is more sensitive in detecting cystocele and enterocoele.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>KASHIHARA<sup>[<xref rid="b34" ref-type="bibr">34</xref>]</sup> (2014)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>13/14</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>49.3/61.9</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op/1 year post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Transvaginal mesh surgery/Laparoscopic sacrocolpopexy</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The position of the pouch of Douglas was significantly higher in the sacrocolpopexy group.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>GINATH<sup>[<xref rid="b43" ref-type="bibr">43</xref>]</sup> (2012)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>5/5</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>53.6/67.2</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>&#x03000;Normal group &#x03000;(6)</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op/3 months post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Abdominal sacrocolpopexy/Vaginal mesh lit repair (total prolift)</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Both POP-Q and MRI indicated that the two surgical procedures achieved similar effectiveness.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>BROCKER<sup>[<xref rid="b44" ref-type="bibr">44</xref>]</sup> (2011)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>36</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>65</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op/4 weeks and 12 weeks post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Bilateral vaginal sacrospinous fixation with a mesh</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL and MPL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>MRI and POP-Q showed a high correlation in the evaluation of cystocele and apical prolapse.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>KASTURI<sup>[<xref rid="b45" ref-type="bibr">45</xref>]</sup> (2010)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>10</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>62.2</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op/6-12 weeks post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Vaginal mesh lit repair (total prolift)</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>MRI demonstrated greater sensitivity in evaluating cystocele, enterocoele, and apical prolapse.</p>
</td></tr></tbody></table></table-wrap><p>&#x052a8;&#x06001;MRI&#x053ef;&#x04ee5;&#x05168;&#x09762;&#x0663e;&#x0793a;&#x0672f;&#x0540e;&#x07684;&#x04e09;&#x08154;&#x05ba4;&#x03001;&#x04e09;&#x06c34;&#x05e73;&#x089e3;&#x05256;&#x060c5;&#x051b5;&#x03002;&#x0800c;&#x052a8;&#x06001;MRI&#x05219;&#x066f4;&#x080fd;&#x053cd;&#x06620;&#x076c6;&#x08154;&#x05668;&#x05b98;&#x05728;&#x08fd0;&#x052a8;&#x072b6;&#x06001;&#x04e0b;&#x053ca;&#x06700;&#x05927;&#x05c4f;&#x06c14;&#x065f6;&#x07684;&#x08131;&#x05782;&#x07a0b;&#x05ea6;&#x0ff0c;&#x080fd;&#x0591f;&#x066f4;&#x07cbe;&#x051c6;&#x05730;&#x05224;&#x065ad;&#x08180;&#x080f1;&#x081a8;&#x051fa;&#x03001;&#x080a0;&#x0759d;&#x07b49;&#x04e34;&#x05e8a;&#x05987;&#x079d1;&#x068c0;&#x067e5;&#x053ef;&#x080fd;&#x09057;&#x06f0f;&#x07684;&#x060c5;&#x051b5;<sup>[<xref rid="b46" ref-type="bibr">46</xref>]</sup>&#x0ff0c;&#x04e3a;&#x0672f;&#x0540e;&#x08bc4;&#x04f30;&#x05668;&#x05b98;&#x089e3;&#x05256;&#x0590d;&#x04f4d;&#x063d0;&#x04f9b;&#x076f4;&#x063a5;&#x08bc1;&#x0636e;&#x03002;</p></sec><sec id="s04.02"><label>4.2</label><title>&#x09634;&#x09053;&#x08f74;&#x05411;&#x053d8;&#x05316;&#x05728;&#x04e2d;&#x076c6;&#x08154;&#x07f3a;&#x09677;&#x04fee;&#x0590d;&#x0624b;&#x0672f;&#x04e2d;&#x07684;&#x08bc4;&#x04f30;</title><p>&#x08bc4;&#x04f30;&#x04e2d;&#x076c6;&#x08154;&#x07f3a;&#x09677;&#x04fee;&#x0590d;&#x0624b;&#x0672f;&#x07684;&#x07597;&#x06548;&#x065f6;&#x0ff0c;&#x09634;&#x09053;&#x08f74;&#x05411;&#x07684;&#x053d8;&#x05316;&#x0662f;&#x04e00;&#x04e2a;&#x091cd;&#x08981;&#x06307;&#x06807;&#x0ff0c;&#x076f4;&#x063a5;&#x05f71;&#x054cd;&#x0672f;&#x0540e;&#x07684;&#x089e3;&#x05256;&#x0590d;&#x04f4d;&#x06548;&#x0679c;&#x0548c;&#x060a3;&#x08005;&#x07684;&#x0529f;&#x080fd;&#x06062;&#x0590d;&#x03002;NICHOLS&#x07b49;<sup>[<xref rid="b47" ref-type="bibr">47</xref>]</sup>&#x0901a;&#x08fc7;&#x09634;&#x09053;&#x09020;&#x05f71;&#x053d1;&#x073b0;&#x0ff0c;&#x09634;&#x09053;&#x05728;&#x0901a;&#x08fc7;&#x0809b;&#x063d0;&#x0808c;&#x088c2;&#x05b54;&#x065f6;&#x051fa;&#x073b0;&#x04e86;&#x0663e;&#x08457;&#x07684;&#x08f74;&#x05411;&#x053d8;&#x05316;&#x0ff0c;&#x05c06;&#x09634;&#x09053;&#x05206;&#x04e3a;&#x04e0a;&#x04e0b;&#x04e24;&#x06bb5;&#x0ff0c;&#x04e0b;&#x06bb5;&#x06307;&#x05411;&#x04f1a;&#x09634;&#x0ff0c;&#x04e0a;&#x06bb5;&#x05219;&#x06574;&#x04f53;&#x05448;&#x06c34;&#x05e73;&#x065b9;&#x05411;&#x03002;FUNT&#x07b49;<sup>[<xref rid="b48" ref-type="bibr">48</xref>]</sup>&#x053d1;&#x073b0;&#x0ff0c;&#x06b63;&#x05e38;&#x07684;&#x09634;&#x09053;&#x04e0a;1/3&#x08f74;&#x05411;&#x0901a;&#x05e38;&#x06307;&#x05411;&#x07b2c;3&#x0ff5e;4&#x09ab6;&#x09aa8;&#x0ff0c;&#x09634;&#x09053;&#x04e0a;&#x04e0b;&#x06bb5;&#x04e4b;&#x095f4;&#x05f62;&#x06210;&#x07ea6;130&#x000b0;&#x07684;&#x05939;&#x089d2;&#x03002;LEE&#x07b49;<sup>[<xref rid="b49" ref-type="bibr">49</xref>]</sup>&#x053d1;&#x073b0;&#x0ff0c;&#x05b50;&#x05bab;&#x05207;&#x09664;&#x0672f;&#x0540e;&#x0ff0c;&#x09634;&#x09053;&#x04e2d;&#x06bb5;&#x05411;&#x0524d;&#x0503e;&#x0659c;&#x0ff0c;&#x09634;&#x09053;&#x05404;&#x06bb5;&#x04e4b;&#x095f4;&#x07684;&#x089d2;&#x05ea6;&#x053d8;&#x0949d;&#x0ff0c;&#x05bfc;&#x081f4;&#x09634;&#x09053;&#x06574;&#x04f53;&#x05f62;&#x06001;&#x08d8b;&#x04e8e;&#x05e73;&#x076f4;&#x03002;</p><p>GINATH&#x07b49;<sup>[<xref rid="b50" ref-type="bibr">50</xref>]</sup>&#x053d1;&#x073b0;&#x0ff0c;POP&#x060a3;&#x08005;&#x07684;&#x09634;&#x09053;&#x05448;&#x073b0;&#x05411;&#x0540e;&#x0503e;&#x0659c;&#x07684;&#x08d8b;&#x052bf;&#x03002;LI&#x07b49;<sup>[<xref rid="b51" ref-type="bibr">51</xref>]</sup>&#x06307;&#x051fa;&#x0ff0c;&#x08131;&#x05782;&#x060a3;&#x08005;&#x05b50;&#x05bab;&#x053ca;&#x09634;&#x09053;&#x08f74;&#x05411;&#x06574;&#x04f53;&#x05411;&#x0540e;&#x04e0b;&#x065b9;&#x0504f;&#x079fb;&#x03002;SENTURK&#x07b49;<sup>[<xref rid="b33" ref-type="bibr">33</xref>]</sup>&#x053d1;&#x073b0;&#x0ff0c;&#x05b50;&#x05bab;&#x09ab6;&#x09aa8;&#x056fa;&#x05b9a;&#x0672f;&#x0540e;&#x09634;&#x09053;&#x08f74;&#x05411;&#x06574;&#x04f53;&#x05448;&#x073b0;&#x05411;&#x053f3;&#x04fa7;&#x0503e;&#x0659c;&#x03002;SZE&#x07b49;<sup>[<xref rid="b52" ref-type="bibr">52</xref>]</sup>&#x07814;&#x07a76;&#x0663e;&#x0793a;&#x0ff0c;&#x09ab6;&#x068d8;&#x097e7;&#x05e26;&#x056fa;&#x05b9a;&#x0672f;&#x0540e;&#x0ff0c;&#x060a3;&#x08005;&#x07684;&#x09634;&#x09053;&#x04e0a;&#x06bb5;&#x08f74;&#x05411;&#x0504f;&#x05411;&#x0524d;&#x076c6;&#x0ff0c;&#x05bfc;&#x081f4;&#x0672f;&#x0540e;&#x09634;&#x09053;&#x05f62;&#x06001;&#x05f02;&#x05e38;&#x0ff0c;&#x08fd9;&#x079cd;&#x05f02;&#x05e38;&#x053ef;&#x080fd;&#x04e0e;&#x08f83;&#x09ad8;&#x07684;&#x0590d;&#x053d1;&#x07387;&#x0548c;&#x05c3f;&#x05931;&#x07981;&#x07387;&#x076f8;&#x05173;&#x0ff0c;&#x05c1a;&#x09700;&#x08fdb;&#x04e00;&#x06b65;&#x07814;&#x07a76;&#x03002;JULIATO&#x07b49;<sup>[<xref rid="b53" ref-type="bibr">53</xref>]</sup>&#x053d1;&#x073b0;&#x0ff0c;&#x05bab;&#x09888;&#x09ab6;&#x09aa8;&#x056fa;&#x05b9a;&#x0672f;&#x0ff08;&#x05b50;&#x05bab;&#x06b21;&#x05168;&#x05207;&#x0ff09;&#x04ee5;&#x053ca;&#x09634;&#x05f0f;&#x05b50;&#x05bab;&#x05168;&#x05207;+&#x09634;&#x09053;&#x09ab6;&#x068d8;&#x097e7;&#x05e26;&#x056fa;&#x05b9a;&#x0672f;&#x0540e;&#x0ff0c;&#x0672f;&#x0540e;&#x09634;&#x09053;&#x08f74;&#x05411;&#x05747;&#x051fa;&#x073b0;&#x0504f;&#x079bb;&#x0751f;&#x07406;&#x072b6;&#x06001;&#x07684;&#x060c5;&#x051b5;&#x0ff0c;&#x08868;&#x073b0;&#x04e3a;&#x09634;&#x09053;&#x04e2d;&#x06bb5;&#x07684;&#x0524d;&#x079fb;&#x053ca;&#x09634;&#x09053;&#x04e0b;&#x06bb5;&#x07684;&#x05f2f;&#x066f2;&#x0ff0c;&#x04f46;&#x05e76;&#x0672a;&#x0663e;&#x08457;&#x05f71;&#x054cd;&#x0624b;&#x0672f;&#x07684;&#x04e3b;&#x05ba2;&#x089c2;&#x06cbb;&#x06108;&#x07387;&#x053ca;&#x0672f;&#x0540e;&#x06027;&#x0751f;&#x06d3b;&#x03001;&#x06392;&#x05c3f;&#x03001;&#x06392;&#x04fbf;&#x07b49;&#x0529f;&#x080fd;&#x0ff0c;&#x08be6;&#x089c1;<xref rid="Table2" ref-type="table">&#x08868;2</xref>&#x03002;</p><table-wrap position="float" id="Table2"><label>&#x08868; 2</label><caption><title>The role of MRI in assessing vaginal axis</title><p>MRI&#x05728;&#x09634;&#x09053;&#x08f74;&#x05411;&#x08bc4;&#x04f30;&#x07684;&#x05e94;&#x07528;</p></caption><table frame="hsides" rules="groups"><thead><tr><td align="left" valign="middle" rowspan="1" colspan="1">Author (year)</td><td align="center" valign="middle" rowspan="1" colspan="1">Number of patients</td><td align="center" valign="middle" rowspan="1" colspan="1">Age of treatment/yr.</td><td align="center" valign="middle" rowspan="1" colspan="1">Normal control group (<italic toggle="yes">n</italic>)</td><td align="center" valign="middle" rowspan="1" colspan="1">MRI time</td><td align="center" valign="middle" rowspan="1" colspan="1">Surgical technique</td><td align="center" valign="middle" rowspan="1" colspan="1">Reference line</td><td align="center" valign="middle" rowspan="1" colspan="1">Results</td></tr></thead><tfoot><tr><td align="justify" valign="middle" colspan="8" rowspan="1">&#x03000;op: operation; PCL and PICS denote the same as those in <xref rid="Figure1" ref-type="fig">Fig 1</xref> and <xref rid="Figure3" ref-type="fig">Fig 3</xref>.</td></tr></tfoot><tbody><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>PULATO&#x0011e;LU<sup>[<xref rid="b46" ref-type="bibr">46</xref>]</sup> (2021)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>11</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>50.9</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Normal group (10)</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op/Post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Laparoscopic lateral mesh suspension</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The postoperative vaginal axis was close to the normal vaginal axis.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">Van<break/> &#x03000;IJSSELMUIDEN<sup>[<xref rid="b39" ref-type="bibr">39</xref>]</sup>
<break/>&#x03000;(2020)</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>5/5/5</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>61/68/57</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>6 months post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Vaginal sacrospinous hysteropexy/Laparoscopic sacrocolpopexy/Vaginal hysterectomy</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>PICS</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The upper vaginal axis was more posteriorly inclined in the vaginal hysterectomy group.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>JULIATO<sup>[<xref rid="b53" ref-type="bibr">53</xref>]</sup> (2019)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>20/20</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>67.5</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Normal group (40)</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>27 months post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Vaginal sacrospinous hysteropexy/Abdominal sacrocolpopexy</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>PICS</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Both surgical procedures resulted in deviation of the vaginal axis from its physiological orientation.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>LEE<sup>[<xref rid="b49" ref-type="bibr">49</xref>]</sup> (2019)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>21/27</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>51.9/50.3</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op/Post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Vaginal hysterectomy</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>PICS</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The women underwent total hysterectomy exhibited a more anteriorly positioned mid-vaginal axis.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>SENTURK<sup>[<xref rid="b33" ref-type="bibr">33</xref>]</sup> (2018)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>10/10</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>34.8/32.2</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Normal group (10)</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Bilateral abdominal sacral hysteropexy/Abdominal sacrocolpopexy</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The vaginal axis after bilateral sacrocolpopexy was closer to the normal vaginal axis.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>KASHIHARA<sup>[<xref rid="b34" ref-type="bibr">34</xref>]</sup> (2014)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>13/14</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>49.3/61.9</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op/1 year post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Transvaginal mesh surgery/Laparoscopic sacrocolpopexy</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The vaginal axis exhibited greater changes after transvaginal mesh surgery.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>RANE<sup>[<xref rid="b54" ref-type="bibr">54</xref>]</sup> (2004)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>7/7/7</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>65.4/62.5/60.5</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">/</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Pre-op/6-12 weeks post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Transvaginal sacrospinous fixation/Posterior intravaginal slingplasty/Sacrocolpopexy</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The upper vaginal segment showed anterior pelvic torsion in transvaginal sacrospinous fixation group.</p>
</td></tr><tr><td align="left" valign="top" rowspan="1" colspan="1">
<p>SZE<sup>[<xref rid="b52" ref-type="bibr">52</xref>]</sup> (2001)</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>3/3</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>66/63</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Normal group (6)</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>Post-op</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>vaginal sacrospinous liagment suspension/abdominal sacrocolpopexy</p>
</td><td align="center" valign="top" rowspan="1" colspan="1">
<p>PCL</p>
</td><td align="left" valign="top" rowspan="1" colspan="1">
<p>The angle between the upper vaginal axis and the PCL was significantly increased in sacrospinous liagment suspension.</p>
</td></tr></tbody></table></table-wrap><p>&#x09634;&#x09053;&#x08f74;&#x0662f;&#x053cd;&#x06620;&#x076c6;&#x08154;&#x05668;&#x05b98;&#x072b6;&#x06001;&#x07684;&#x091cd;&#x08981;&#x053c2;&#x06570;&#x0ff0c;&#x05bf9;&#x04e8e;&#x07ef4;&#x06301;&#x076c6;&#x08154;&#x05668;&#x05b98;&#x07684;&#x089e3;&#x05256;&#x04f4d;&#x07f6e;&#x081f3;&#x05173;&#x091cd;&#x08981;&#x03002;&#x07531;&#x04e8e;&#x04f20;&#x07edf;&#x05987;&#x079d1;&#x068c0;&#x067e5;&#x065e0;&#x06cd5;&#x076f4;&#x063a5;&#x06d4b;&#x091cf;&#x09634;&#x09053;&#x08f74;&#x05411;&#x0ff0c;&#x0591a;&#x05e74;&#x06765;&#x07814;&#x07a76;&#x04eba;&#x05458;&#x05c1d;&#x08bd5;&#x04f7f;&#x07528;&#x05404;&#x079cd;&#x05f71;&#x050cf;&#x05b66;&#x065b9;&#x06cd5;&#x095f4;&#x063a5;&#x08bc4;&#x04f30;&#x09634;&#x09053;&#x08f74;&#x05411;&#x04e0e;&#x076c6;&#x08154;&#x05668;&#x05b98;&#x089e3;&#x05256;&#x04f4d;&#x07f6e;&#x07684;&#x05173;&#x07cfb;<sup>[<xref rid="b55" ref-type="bibr">55</xref>]</sup>&#x03002;&#x077e2;&#x072b6;&#x04f4d;MRI&#x056fe;&#x050cf;&#x080fd;&#x0591f;&#x051c6;&#x0786e;&#x091cf;&#x05316;&#x09634;&#x09053;&#x08f74;&#x05411;&#x0ff0c;&#x05e76;&#x0901a;&#x08fc7;&#x04e09;&#x07ef4;&#x091cd;&#x05efa;&#x08fd8;&#x0539f;&#x09634;&#x09053;&#x05f62;&#x06001;&#x0ff0c;&#x04e3a;&#x07814;&#x07a76;&#x04e0d;&#x0540c;&#x0624b;&#x0672f;&#x0540e;&#x09634;&#x09053;&#x08f74;&#x05411;&#x063d0;&#x04f9b;&#x076f4;&#x089c2;&#x04f9d;&#x0636e;&#x03002;</p></sec><sec id="s04.03"><label>4.3</label><title>&#x0672f;&#x0540e;&#x07f51;&#x07247;&#x07684;&#x08bc4;&#x04f30;</title><p>&#x0968f;&#x07740;&#x078c1;&#x05171;&#x0632f;&#x053ef;&#x089c6;&#x05316;&#x07f51;&#x07247;&#x07684;&#x05e94;&#x07528;&#x0ff0c;&#x052a8;&#x06001;MRI&#x05df2;&#x06210;&#x04e3a;&#x07cbe;&#x0786e;&#x05b9a;&#x04f4d;&#x04f53;&#x05185;&#x07f51;&#x07247;&#x04f4d;&#x07f6e;&#x07684;&#x091cd;&#x08981;&#x05de5;&#x05177;&#x0ff0c;&#x05bf9;&#x0672f;&#x0540e;&#x0590d;&#x053d1;&#x053ca;&#x07f51;&#x07247;&#x05e76;&#x053d1;&#x075c7;&#x07684;&#x05f71;&#x050cf;&#x05b66;&#x08bc4;&#x04f30;&#x081f3;&#x05173
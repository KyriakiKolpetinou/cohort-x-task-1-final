<article xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" dtd-version="1.3" xml:lang="en" article-type="research-article"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">JMIR Res Protoc</journal-id><journal-id journal-id-type="iso-abbrev">JMIR Res Protoc</journal-id><journal-id journal-id-type="publisher-id">ResProt</journal-id><journal-title-group><journal-title>JMIR Research Protocols</journal-title></journal-title-group><issn pub-type="epub">1929-0748</issn><publisher><publisher-name>JMIR Publications</publisher-name><publisher-loc>Toronto, Canada</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">34348889</article-id><article-id pub-id-type="pmc">8479598</article-id><article-id pub-id-type="publisher-id">v10i9e30726</article-id><article-id pub-id-type="doi">10.2196/30726</article-id><article-categories><subj-group subj-group-type="heading"><subject>Protocol</subject></subj-group><subj-group subj-group-type="article-type"><subject>Protocol</subject></subj-group></article-categories><title-group><article-title>Using Electronically Delivered Therapy and Brain Imaging to Understand Obsessive-Compulsive Disorder Pathophysiology: Protocol for a Pilot Study</article-title></title-group><contrib-group><contrib contrib-type="editor"><name><surname>Eysenbach</surname><given-names>Gunther</given-names></name></contrib></contrib-group><contrib-group><contrib contrib-type="reviewer"><name><surname>Matsumoto</surname><given-names>Kazuki</given-names></name></contrib><contrib contrib-type="reviewer"><name><surname>Rusu</surname><given-names>Lucia</given-names></name></contrib></contrib-group><contrib-group><contrib id="contrib1" contrib-type="author" corresp="yes"><name><surname>Stephenson</surname><given-names>Callum</given-names></name><degrees>BScH</degrees><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-7929-1546</contrib-id><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref><address><institution>Centre for Neuroscience Studies</institution><institution>Faculty of Health Sciences</institution><institution>Queen's University</institution><addr-line>Botterell Hall</addr-line><addr-line>18 Stuart Street</addr-line><addr-line>Kingston, ON, K7L 3N6</addr-line><country>Canada</country><phone>1 2894075895</phone><email>callum.stephenson@queensu.ca</email></address></contrib><contrib id="contrib2" contrib-type="author"><name><surname>Malakouti</surname><given-names>Niloufar</given-names></name><degrees>MD</degrees><xref rid="aff2" ref-type="aff">2</xref><xref rid="aff3" ref-type="aff">3</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0001-9752-8597</contrib-id></contrib><contrib id="contrib3" contrib-type="author"><name><surname>Nashed</surname><given-names>Joseph Y</given-names></name><degrees>PhD</degrees><xref rid="aff4" ref-type="aff">4</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0003-3668-4670</contrib-id></contrib><contrib id="contrib4" contrib-type="author"><name><surname>Salomons</surname><given-names>Tim</given-names></name><degrees>MSc, PhD</degrees><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff5" ref-type="aff">5</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-1871-6969</contrib-id></contrib><contrib id="contrib5" contrib-type="author"><name><surname>Cook</surname><given-names>Douglas J</given-names></name><degrees>MD, PhD</degrees><xref rid="aff6" ref-type="aff">6</xref><contrib-id contrib-id-type="orcid">https://orcid.org/0000-0002-4353-6716</contrib-id></contrib><contrib id="contrib6" contrib-type="author"><name><surname>Milev</surname><given-names>Roumen</given-names></name><degrees>MD, PhD, FRCPC</degrees><xref rid="aff1" ref-type="aff">1</xref><xref r
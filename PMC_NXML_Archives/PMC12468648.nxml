</person-group><article-title>Host&#x02013;Microbiome Interaction in the Intensive Care Unit</article-title><source>Diseases</source><year>2025</year><volume>13</volume><elocation-id>250</elocation-id><pub-id pub-id-type="doi">10.3390/diseases13080250</pub-id><pub-id pub-id-type="pmid">40863224</pub-id>
</element-citation></ref><ref id="B2-diagnostics-15-02349"><label>2.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Bravo-Frank</surname><given-names>N.</given-names></name>
<name><surname>Zende</surname><given-names>R.</given-names></name>
<name><surname>Feng</surname><given-names>L.</given-names></name>
<name><surname>Mesyngier</surname><given-names>N.</given-names></name>

<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">BMC Med</journal-id><journal-id journal-id-type="iso-abbrev">BMC Med</journal-id><journal-title-group><journal-title>BMC Medicine</journal-title></journal-title-group><issn pub-type="epub">1741-7015</issn><publisher><publisher-name>BioMed Central</publisher-name><publisher-loc>London</publisher-loc></publisher></journal-meta>
<article-meta><article-id pub-id-type="pmid">41199253</article-id><article-id pub-id-type="pmc">12590770</article-id><article-id pub-id-type="publisher-id">4465</article-id><article-id pub-id-type="doi">10.1186/s12916-025-04465-5</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>Long-term efficacy of anterior nucleus of the thalamus deep brain stimulation in drug-resistant epilepsy: a 5-year multicenter study</article-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><name><surname>Hu</surname><given-names>Tianqi</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Xie</surname><given-names>Hutao</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>Shan</surname><given-names>Ming</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Sang</surname><given-names>Lin</given-names></name><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Yang</surname><given-names>Bowen</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Zhang</surname><given-names>Quan</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Gao</surname><given-names>Dongmei</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Jiao</surname><given-names>Yuanyuan</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Guo</surname><given-names>Qinglong</given-names></name><xref ref-type="aff" rid="Aff2">2</xref></contrib><contrib contrib-type="author"><name><surname>Li</surname><given-names>Sizhe</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Wang</surname><given-names>Yuxin</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Du</surname><given-names>Xinnan</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Yang</surname><given-names>Anchao</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Meng</surname><given-names>Fangang</given-names></name><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff6">6</xref><xref ref-type="aff" rid="Aff7">7</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Zhang</surname><given-names>Jianguo</given-names></name><address><email>zjguo73@126.com</email></address><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff6">6</xref><xref ref-type="aff" rid="Aff7">7</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Zhang</surname><given-names>Kai</given-names></name><address><email>zhangkai62035@sina.com</email></address><xref ref-type="aff" rid="Aff1">1</xref><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Zhang</surname><given-names>Hua</given-names></name><address><email>zhanghua3579@hotmail.com</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/013xs5b60</institution-id><institution-id institution-id-type="GRID">grid.24696.3f</institution-id><institution-id institution-id-type="ISNI">0000 0004 0369 153X</institution-id><institution>Department of Neurosurgery, </institution><institution>Beijing Tiantan Hospital, Capital Medical University, </institution></institution-wrap>Beijing, China </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03t1yn780</institution-id><institution-id institution-id-type="GRID">grid.412679.f</institution-id><institution-id institution-id-type="ISNI">0000 0004 1771 3402</institution-id><institution>Department of Neurosurgery, </institution><institution>The First Affiliated Hospital of Anhui Medical University, </institution></institution-wrap>Hefei, China </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0579e9266</institution-id><institution-id institution-id-type="GRID">grid.459359.7</institution-id><institution-id institution-id-type="ISNI">0000 0004 1763 3154</institution-id><institution>Department of Neurosurgery, </institution><institution>Beijing Fengtai Hospital, </institution></institution-wrap>Beijing, China </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0569k1630</institution-id><institution-id institution-id-type="GRID">grid.414367.3</institution-id><institution>Department of Neurosurgery, </institution><institution>Beijing Shijitan Hospital, Capital Medical University, </institution></institution-wrap>Beijing, China </aff><aff id="Aff5"><label>5</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/013xs5b60</institution-id><institution-id institution-id-type="GRID">grid.24696.3f</institution-id><institution-id institution-id-type="ISNI">0000 0004 0369 153X</institution-id><institution>School of Basic Medical Sciences, </institution><institution>Capital Medical University, </institution></institution-wrap>Beijing, China </aff><aff id="Aff6"><label>6</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/00k7r7f88</institution-id><institution-id institution-id-type="GRID">grid.413259.8</institution-id><institution-id institution-id-type="ISNI">0000 0004 0632 3337</institution-id><institution>Beijing Key Laboratory of Neurostimulation, </institution></institution-wrap>Beijing, 100070 China </aff><aff id="Aff7"><label>7</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/013xs5b60</institution-id><institution-id institution-id-type="GRID">grid.24696.3f</institution-id><institution-id institution-id-type="ISNI">0000 0004 0369 153X</institution-id><institution>Department of Functional Neurosurgery, </institution><institution>Beijing Neurosurgical Institute, Capital Medical University, </institution></institution-wrap>Beijing, China </aff></contrib-group><pub-date pub-type="epub"><day>6</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>6</day><month>11</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>23</volume><elocation-id>615</elocation-id><history><date date-type="received"><day>10</day><month>5</month><year>2025</year></date><date date-type="accepted"><day>20</day><month>10</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">Deep brain stimulation (DBS) of the anterior nucleus of the thalamus (ANT-DBS) has demonstrated potential in reducing seizure frequency (SF) in patients with drug-resistant epilepsy (DRE). This multicenter retrospective study aimed to comprehensively evaluate the long-term effects of ANT-DBS on seizure reduction and neuropsychological outcomes, as well as to identify prognostic factors associated with postoperative efficacy.</p></sec><sec><title>Methods</title><p id="Par2">We retrospectively analyzed data from DRE patients who underwent ANT-DBS across three epilepsy centers between July 2019 and December 2022. SF, responder rate, neuropsychological outcomes, and quality of life (QoL) were assessed using seizure diaries and standardized rating scales at baseline and annual follow-up. Univariate and multivariate regression analyses were performed to identify predictors of postoperative SF reduction.</p></sec><sec><title>Results</title><p id="Par3">A total of 40 patients were included, with a mean age at surgery of 28.6&#x02009;&#x000b1;&#x02009;11.1&#x000a0;years. The average monthly SF decreased from 15 at baseline to 6.5 at the 5-year follow-up (a 56.7% reduction, <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001), with a responder rate of 62.5%. Therapeutic effect was most pronounced within the first 24&#x000a0;months after implantation. The Liverpool Seizure Severity Scale (LSSS) scores improved from 26.7&#x02009;&#x000b1;&#x02009;5.2 to 17.9&#x02009;&#x000b1;&#x02009;8.6 (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). Mood conditions (measured by the Hamilton Depression and Anxiety Rating Scales) improved from baseline to the final follow-up, while cognitive status remained stable. QoL also improved significantly, particularly in Overall QoL, Emotional Well-being, Energy/Fatigue and Social Functioning. Multivariate logistic regression identified temporal lobe seizures (OR 8.3, <italic>p</italic>&#x02009;=&#x02009;0.022) and stimulation amplitude (OR 4.2, <italic>p</italic>&#x02009;=&#x02009;0.034) as independent predictors of responder status following DBS implantation. Multivariate linear regression identified baseline LSSS scores (standardized &#x003b2;: 3.5, p&#x02009;=&#x02009;0.016) and temporal lobe seizures (standardized <italic>&#x003b2;</italic> 35.4, <italic>p</italic>&#x02009;=&#x02009;0.024) as independent predictors of SF reduction.</p></sec><sec><title>Conclusions</title><p id="Par4">ANT-DBS significantly reduces SF in patients with DRE and shows stable long-term efficacy. The seizure onset zone, preoperative seizure severity and stimulation amplitude are critical predictors of postoperative outcomes, providing valuable information for optimal patient selection for this intervention.</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1186/s12916-025-04465-5.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Epilepsy</kwd><kwd>Seizures</kwd><kwd>Deep brain stimulation</kwd><kwd>Neuromodulation</kwd><kwd>Thalamus</kwd><kwd>Neuropsychology</kwd></kwd-group><funding-group><award-group><funding-source><institution-wrap><institution-id institution-id-type="FundRef">https://doi.org/10.13039/501100001809</institution-id><institution>National Natural Science Foundation of China</institution></institution-wrap></funding-source><award-id>82401713</award-id></award-group></funding-group><funding-group><award-group><funding-source><institution>Postdoctoral Fellowship Program of CPSF</institution></funding-source><award-id>GZC20231742</award-id></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; BioMed Central Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Background</title><p id="Par27">Epilepsy affects over 60 million people worldwide [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>]. Approximately 30% of these individuals fail to achieve seizure control despite treatment with two or more anti-seizure medications (ASM), classifying them as having drug-resistant epilepsy (DRE) [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR4">4</xref>]. While resective surgery is an effective intervention for DRE, many patients are ineligible due to poorly localized or multifocal seizure onset [<xref ref-type="bibr" rid="CR5">5</xref>&#x02013;<xref ref-type="bibr" rid="CR7">7</xref>]. For these individuals, neuromodulation&#x02014;particularly deep brain stimulation (DBS), offers a promising alternative for seizure management.</p><p id="Par28">Among DBS targets, the anterior nucleus of the thalamus (ANT-DBS) has been approved by the U.S. Food and Drug Administration (FDA) for the treatment of DRE [<xref ref-type="bibr" rid="CR8">8</xref>, <xref ref-type="bibr" rid="CR9">9</xref>]. As a neuromodulation therapy for epilepsy, ANT-DBS enables targeted and sustained stimulation of specific brain regions [<xref ref-type="bibr" rid="CR10">10</xref>]. The landmark Stimulation of the Anterior Nucleus of the Thalamus for Epilepsy (SANTE) trial and the Medtronic Registry for Epilepsy (MORE) study, along with their extended follow-up reports, have demonstrated the efficacy and safety of ANT-DBS [<xref ref-type="bibr" rid="CR11">11</xref>&#x02013;<xref ref-type="bibr" rid="CR14">14</xref>]. Several additional single-center studies support the effectiveness of ANT-DBS. However, unlike the SANTE and MORE trials, these single-center studies are often limited by small sample sizes and shorter follow-up durations, making generalizability challenging [<xref ref-type="bibr" rid="CR15">15</xref>&#x02013;<xref ref-type="bibr" rid="CR19">19</xref>].
</p><p id="Par29">To our knowledge, there are few published reports on the efficacy of ANT-DBS for DRE in Chinese populations. Given the potential ethnic and geographic variations in epilepsy, this is an important area of investigation. Moreover, most studies have primarily focused on seizure frequency (SF), with relatively little attention given to neuropsychological dysfunction and declines in quality of life (QoL). In addition to the above-mentioned limitations, a critical question remains: which clinical characteristics best predict a favorable response to ANT-DBS? Addressing this knowledge gap is essential for optimizing patient selection and treatment outcomes.</p><p id="Par30">To this end, we conducted a multicenter retrospective study to comprehensively evaluate the long-term effects of ANT-DBS in Chinese patients with DRE. Our study assesses not only SF but also cognitive function, mood, and QoL. Furthermore, we aim to identify prognostic factors that may help determine the ideal candidates for ANT-DBS implantation.</p></sec><sec id="Sec2"><title>Methods</title><p id="Par31">This study was conducted in accordance with the Declaration of Helsinki and approved by the institutional ethics committees of all participating hospitals: Beijing Tiantan Hospital, Beijing Fengtai Hospital (KY 2019&#x02013;020-01), and the First Affiliated Hospital of Anhui Medical University (2019H022). Written informed consent was obtained from all patients or their legal guardians for the use of their medical data in research, in accordance with institutional requirements for retrospective data collection. We confirm that we have read the Journal&#x02019;s position on issues involved in ethical publication and affirm that this report is consistent with those guidelines.</p><sec id="Sec3"><title>Patient selection</title><p id="Par32">This retrospective study consecutively enrolled patients with DRE who underwent bilateral ANT-DBS at the Epilepsy Centers of Beijing Tiantan Hospital (BTH), Beijing Fengtai Hospital (BFH), and the First Affiliated Hospital of Anhui Medical University (FAH-AMU) between July 2019 and December 2022. All patients were diagnosed with refractory epilepsy and were not eligible for resective surgery due to the presence of multiple seizure foci or poor surgical prognosis. The exclusion criteria were as follows: (1) refusal to participate in the study; (2) follow-up duration less than 12&#x000a0;months; (3) missing seizure diaries or incomplete neuropsychological assessments. Patients with a history of prior resective surgery or vagus nerve stimulation were also excluded to avoid potential confounding effects from previous surgical interventions. A detailed overview of the patient selection process is shown in Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>.<fig id="Fig1"><label>Fig.&#x000a0;1</label><caption><p>Flow chart of inclusion</p></caption><graphic xlink:href="12916_2025_4465_Fig1_HTML" id="MO1"/></fig></p></sec><sec id="Sec4"><title>Surgical procedures and stimulation programming</title><p id="Par33">The surgeries were performed following standardized protocols across the participating centers with respect to target identification and equipment. Preoperative magnetic resonance imaging (MRI) and computed tomography (CT) scans were conducted for surgical planning, and the coordinates of the ANT were determined. Generally, the ANT target coordinates are 4&#x02013;6&#x000a0;mm posterior to the anterior commissure (AC), 7&#x02013;9&#x000a0;mm lateral to the midline, and 6&#x02013;8&#x000a0;mm superior to the inter-commissural line, adjacent to the anterior limb of the internal capsule and closely associated with the mammillothalamic tract (MMT) [<xref ref-type="bibr" rid="CR20">20</xref>]. Bilateral quadripolar DBS electrodes (model 3389, Medtronic, Minneapolis, MN, USA) were implanted into the ANT under the guidance of the Leksell Stereotactic System (Elekta Instrument AB, Stockholm, Sweden) under general anesthesia. Intraoperative microelectrode recording (MER) was performed to confirm the trajectory&#x02019;s passage from the ventricle into the thalamic parenchyma and to verify the accuracy of the electrode implantation site [<xref ref-type="bibr" rid="CR21">21</xref>]. Additional File 1: Fig. S1 illustrates the targeting of the ANT in one patient, including the implantation trajectory and intraoperative MER recordings. The electrodes were then connected to an implantable pulse generator (IPG, Activa PC, Medtronic) via subcutaneously tunneled extensions. Electrode localization was performed by co-registering postoperative CT with preoperative MRI, followed by normalization to ICBM 2009b Nonlinear Asymmetrical (Montreal Neurological Institute, MNI) space using Lead-DBS toolbox (version 3.1; http://www.lead-dbs.org) [<xref ref-type="bibr" rid="CR22">22</xref>]. Each step was verified by meticulous visual inspection and refined as necessary.</p><p id="Par34">The stimulator was activated one month after implantation. The ideal stimulation contacts, located at the ventral and anterior parts of the ANT, were selected based on the electrode reconstruction. The initial stimulation parameters were set to a 90&#x000a0;&#x000b5;s pulse width, 145&#x000a0;Hz frequency, and 3.0&#x000a0;V amplitude with a cycling mode of &#x0201c;ON&#x0201d; for 1&#x000a0;min and &#x0201c;OFF&#x0201d; for 5&#x000a0;min. These parameters were adjusted over time based on individual patient responses, to avoid stimulation-related side effects. The amplitude of stimulation was modified as clinically required during the annual follow-up. All adjustments were made by an experienced neuromodulation physician.</p></sec><sec id="Sec5"><title>Seizure and neuropsychological assessments</title><p id="Par35">Outcome measurements were performed at baseline and during each yearly follow-up visit in dedicated evaluation rooms. To ensure accuracy and consistency, assessments were carried out by professionally trained teams at each participating center. The primary efficacy outcome, defined as the reduction in SF, was recorded using seizure diaries and follow-up assessments. Seizure documentation was maintained by caregivers or legal guardians, based on direct observation of the patients&#x02019; seizure events. Both patients and caregivers received appropriate training to ensure the accuracy and reliability of seizure diaries. The percentage change in SF at each follow-up compared to baseline was calculated. Seizure onset zones (SOZ) and seizure semiology were classified based on video-electroencephalography (VEEG) recordings and patient descriptions, in accordance with the 2017 International League Against Epilepsy (ILAE) classification of seizure semiology [<xref ref-type="bibr" rid="CR23">23</xref>]. To ensure consistency in the evaluation results, SOZ evaluations were based on standardized protocols agreed upon by all three centers, and assessments were conducted by consensus among experienced clinicians at each center. Patients were further categorized into two groups based on SF reduction: &#x0201c;Responders&#x0201d; with a&#x02009;&#x02265;&#x02009;50% reduction and &#x0201c;Non-responders&#x0201d; with&#x02009;&#x0003c;&#x02009;50% reduction [<xref ref-type="bibr" rid="CR11">11</xref>]. Additionally, the Liverpool Seizure Severity Scale (LSSS) was used to assess overall seizure severity.</p><p id="Par36">Neuropsychological outcomes were assessed using clinical standard scales, including the Hamilton Depression Rating Scale (HAMD) and the Hamilton Anxiety Rating Scale (HAMA) to assess mood disorders, as well as the Mini-Mental State Examination (MMSE) and the Montreal Cognitive Assessment (MoCA) for cognitive status. The 31-item version of the Quality of Life in Epilepsy (QoLIE-31) was administered to evaluate changes in quality of life. Additionally, the seven subscales of the QOLIE-31 were also evaluated to assess domain-specific changes in quality of life [<xref ref-type="bibr" rid="CR24">24</xref>]. Any adverse effects (AEs) related to the surgery that occurred during follow-up were also recorded.</p></sec><sec id="Sec6"><title>Statistical analysis</title><p id="Par37">Continuous variables are presented as means&#x02009;&#x000b1;&#x02009;standard deviation (SD), while categorical variables are expressed as counts and percentages. Seizure frequency is presented as median and interquartile range (IQR). Differences between baseline and follow-up visits for continuous variables were compared using the Paired T-test or the Wilcoxon signed-rank test, depending on the distribution of the data. Categorical variables were compared using the Chi-square test. Each matched pair represents the same subject at different time points. To adjust for multiple comparisons, the Bonferroni correction was applied. For patients lost during the postoperative follow-up period, data from their last available follow-up was used to maximize the follow-up duration while ensuring consistency in outcome evaluation. Little&#x02019;s Missing Completely at Random (MCAR) test was conducted to assess the randomness of missing values. Kaplan&#x02013;Meier survival analysis was used to evaluate the time distribution of achieving a 50% reduction in SF across centers. Patients who were lost to follow-up were treated as censored.</p><p id="Par38">Multiple linear and logistic regression analyses were performed to identify predictors of long-term DBS efficacy. The outcome variables were the percentage improvement in SF at the final follow-up and the achievement of &#x0201c;responder&#x0201d; status. Initial univariable regression models included variables such as gender, age, disease duration, baseline SF, number of anti-seizure medications, and scores on neuropsychological scales. Variables with unadjusted <italic>p</italic>-values&#x02009;&#x0003c;&#x02009;0.05 were entered into the multivariable model to identify significant independent predictors. Statistical and imaging analyses were performed using SPSS (version 25, IBM, USA), Python (version 3.11, PSF, USA), and MATLAB (R2023b, MathWorks, USA), with two-tailed tests and significance set at p&#x02009;&#x0003c;&#x02009;0.05.</p></sec></sec><sec id="Sec7"><title>Results</title><sec id="Sec8"><title>Patient characteristics</title><p id="Par39">A total of 46 DRE patients who underwent ANT-DBS were identified from three centers. Following screening, 40 patients were included in the study: 19 from BTH, 16 from BFH, and 5 from FAH-AMU. Of the 40 patients enrolled, 30 patients (75%) completed the 5-year follow-up, whereas the remaining 10 patients (25%) failed to complete the entire follow-up period. MCAR testing confirmed that the data were missing at random (<italic>p</italic>&#x02009;=&#x02009;0.498). The number of patients evaluated at each time point, as well as the attrition and corresponding reasons, are summarized in Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>. The demographic characteristics of the patients are summarized in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>. The mean age at surgery was 28.6&#x02009;&#x000b1;&#x02009;11.1&#x000a0;years, with 12 patients (30.0%) being female. The mean disease duration was 12.8&#x02009;&#x000b1;&#x02009;9.6&#x000a0;years, and the median baseline SF was 15.0 (5.3&#x02013;30.0) per month, ranging from 2 in the least severe case to over 100 in the most severe. Temporal lobe epilepsy (TLE) was the most common epileptic focus, found in 26 patients (65.0%). Among them, 7 had mesial TLE (26.9%), 3 had lateral TLE (11.5%), 10 were classified as mesio-lateral TLE (38.5%), and 6 had bilateral temporal lobe involvement (23.1%). 8 patients (20.0%) had frontal lobe epilepsy (FLE). Fewer patients had parietal (2.5%) or occipital (12.5%) lobe foci. Seizure types were predominantly focal to bilateral tonic&#x02013;clonic seizures (FBTCS) (<italic>n</italic>&#x02009;=&#x02009;29, 72.5%) and focal impaired awareness seizures (FIAS) (<italic>n</italic>&#x02009;=&#x02009;24, 60.0%). Focal aware seizures (FAS) (<italic>n</italic>&#x02009;=&#x02009;7, 17.5%) and generalized seizures (<italic>n</italic>&#x02009;=&#x02009;7, 17.5%) were less frequent. In terms of ASMs use, the majority of patients (<italic>n</italic>&#x02009;=&#x02009;29, 82.5%) were on 1&#x02013;3 ASMs, with 11 patients (27.5%) on more than 4 ASMs. Detailed characteristics for each center are also shown in Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>.
<table-wrap id="Tab1"><label>Table 1</label><caption><p>Baseline characteristics of patients included</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Variables</th><th align="left">Total<break/>(<italic>N</italic>&#x02009;=&#x02009;40)</th><th align="left">BTH<break/>(<italic>n</italic>&#x02009;=&#x02009;19)</th><th align="left">BFH<break/>(<italic>n</italic>&#x02009;=&#x02009;16)</th><th align="left">FAH-AMU<break/>(<italic>n</italic>&#x02009;=&#x02009;5)</th></tr></thead><tbody><tr><td align="left">Age at surgery (y)</td><td align="left">28.6&#x02009;&#x000b1;&#x02009;11.1</td><td align="left">27.3&#x02009;&#x000b1;&#x02009;10.5</td><td align="left">26.2&#x02009;&#x000b1;&#x02009;8.3</td><td align="left">39.6&#x02009;&#x000b1;&#x02009;17.7</td></tr><tr><td align="left">Gender (female, %)</td><td align="left">12 (30.0%)</td><td align="left">15 (79.0%)</td><td align="left">10 (62.5%)</td><td align="left">3 (60.0%)</td></tr><tr><td align="left">Duration of epilepsy (y)</td><td align="left">12.8&#x02009;&#x000b1;&#x02009;9.6</td><td align="left">11.4&#x02009;&#x000b1;&#x02009;8.2</td><td align="left">11.1&#x02009;&#x000b1;&#x02009;9.0</td><td align="left">23.2&#x02009;&#x000b1;&#x02009;11.8</td></tr><tr><td align="left">Total seizure frequency</td><td align="left">15.0 (5.3&#x02013;30.0)</td><td align="left">15.0 (15.0&#x02013;30.0)</td><td align="left">12.0 (5.3&#x02013;15.0)</td><td align="left">60.0 (17.5&#x02013;75)</td></tr><tr><td align="left">Unifocal epilepsy</td><td align="left">26 (65.0%)</td><td align="left">15 (79.0%)</td><td align="left">7 (43.8%)</td><td align="left">4 (80.0%)</td></tr><tr><td align="left" colspan="5">Location of seizure onset, n (%)<sup>a</sup></td></tr><tr><td align="left">&#x02003;Temporal lobe</td><td align="left">26 (65.0%)</td><td align="left">11 (57.9%)</td><td align="left">11 (68.8%)</td><td align="left">4 (80.0%)</td></tr><tr><td align="left">&#x02003;- mesial</td><td align="left">7 (26.9%)</td><td align="left">3 (27.3%)</td><td align="left">2 (18.2%)</td><td align="left">2 (50.0%)</td></tr><tr><td align="left">&#x02003;- lateral</td><td align="left">3 (11.5%)</td><td align="left">2 (18.2%)</td><td align="left">1 (10.1%)</td><td align="left">0</td></tr><tr><td align="left">&#x02003;- mesio-lateral</td><td align="left">10 (38.5%)</td><td align="left">4 (36.4%)</td><td align="left">5 (45.5%)</td><td align="left">1 (25.0%)</td></tr><tr><td align="left">&#x02003;- bilateral</td><td align="left">6 (23.1%)</td><td align="left">2 (18.2%)</td><td align="left">3 (27.3%)</td><td align="left">1 (25.0%)</td></tr><tr><td align="left">&#x02003;Frontal lobe</td><td align="left">8 (20.0%)</td><td align="left">3 (15.8%)</td><td align="left">5 (31.3%)</td><td align="left">0</td></tr><tr><td align="left">&#x02003;Parietal lobe</td><td align="left">1 (2.5%)</td><td align="left">1 (5.3%)</td><td align="left">0</td><td align="left">0</td></tr><tr><td align="left">&#x02003;Occipital lobe</td><td align="left">5 (12.5%)</td><td align="left">3 (15.8%)</td><td align="left">2 (12.5%)</td><td align="left">0</td></tr><tr><td align="left">&#x02003;Diffuse or multifocal</td><td align="left">7 (17.5%)</td><td align="left">2 (10.5%)</td><td align="left">4 (25.0%)</td><td align="left">1 (20.0%)</td></tr><tr><td align="left" colspan="5">Seizure type, <italic>n</italic> (%)<sup>b</sup></td></tr><tr><td align="left">&#x02003;FAS</td><td align="left">7 (17.5%)</td><td align="left">3 (15.8%)</td><td align="left">4 (25.0%)</td><td align="left">0</td></tr><tr><td align="left">&#x02003;FIAS</td><td align="left">24 (60.0%)</td><td align="left">12 (63.2%)</td><td align="left">7 (43.8%)</td><td align="left">5 (100.0%)</td></tr><tr><td align="left">&#x02003;FBTCS</td><td align="left">29 (72.5%)</td><td align="left">11(57.9%)</td><td align="left">14 (87.5%)</td><td align="left">4 (80.0%)</td></tr><tr><td align="left">&#x02003;Generalized</td><td align="left">7 (17.5%)</td><td align="left">3 (15.8%)</td><td align="left">4 (25.0%)</td><td align="left">0</td></tr><tr><td align="left" colspan="5">Number of ASMs, <italic>n</italic> (%)</td></tr><tr><td align="left">&#x02003;1</td><td align="left">3 (7.5%)</td><td align="left">1 (5.3%)</td><td align="left">1 (6.3%)</td><td align="left">1 (20.0%)</td></tr><tr><td align="left">&#x02003;2</td><td align="left">11 (27.5%)</td><td align="left">5 (26.3%)</td><td align="left">5 (31.3%)</td><td align="left">1 (20.0%)</td></tr><tr><td align="left">&#x02003;3</td><td align="left">15 (37.5%)</td><td align="left">5 (23.3%)</td><td align="left">8 (50.0%)</td><td align="left">2 (40.0%)</td></tr><tr><td align="left">&#x02003;&#x02265;&#x02009;4</td><td align="left">11 (27.5%)</td><td align="left">8 (42.1%)</td><td align="left">2 (12.5%)</td><td align="left">1 (20.0%)</td></tr><tr><td align="left">LSSS</td><td align="left">26.7&#x02009;&#x000b1;&#x02009;5.2</td><td align="left">28.3&#x02009;&#x000b1;&#x02009;4.4</td><td align="left">24.0&#x02009;&#x000b1;&#x02009;5.2</td><td align="left">29.4&#x02009;&#x000b1;&#x02009;5.4</td></tr><tr><td align="left">QoLIE</td><td align="left">73.8&#x02009;&#x000b1;&#x02009;13.2</td><td align="left">77.8&#x02009;&#x000b1;&#x02009;9.7</td><td align="left">64.8&#x02009;&#x000b1;&#x02009;10.4</td><td align="left">87.8&#x02009;&#x000b1;&#x02009;14.6</td></tr><tr><td align="left">HAMA</td><td align="left">17.2&#x02009;&#x000b1;&#x02009;6.1</td><td align="left">17.6&#x02009;&#x000b1;&#x02009;6.0</td><td align="left">16.1&#x02009;&#x000b1;&#x02009;6.2</td><td align="left">19.4&#x02009;&#x000b1;&#x02009;6.7</td></tr><tr><td align="left">HAMD</td><td align="left">15.6&#x02009;&#x000b1;&#x02009;5.8</td><td align="left">15.4&#x02009;&#x000b1;&#x02009;6.0</td><td align="left">15.8&#x02009;&#x000b1;&#x02009;5.0</td><td align="left">15.4&#x02009;&#x000b1;&#x02009;8.4</td></tr><tr><td align="left">MMSE</td><td align="left">25.8&#x02009;&#x000b1;&#x02009;2.9</td><td align="left">25.4&#x02009;&#x000b1;&#x02009;3.0</td><td align="left">26.1&#x02009;&#x000b1;&#x02009;3.0</td><td align="left">26.2&#x02009;&#x000b1;&#x02009;2.8</td></tr><tr><td align="left">MoCA</td><td align="left">25.5&#x02009;&#x000b1;&#x02009;2.8</td><td align="left">25.4&#x02009;&#x000b1;&#x02009;2.7</td><td align="left">26.0&#x02009;&#x000b1;&#x02009;2.8</td><td align="left">24.4&#x02009;&#x000b1;&#x02009;2.7</td></tr><tr><td align="left">Follow-up (m)</td><td align="left">54.6&#x02009;&#x000b1;&#x02009;15.1</td><td align="left">53.7&#x02009;&#x000b1;&#x02009;14.6</td><td align="left">59.2&#x02009;&#x000b1;&#x02009;14.3</td><td align="left">43.4&#x02009;&#x000b1;&#x02009;15.6</td></tr><tr><td align="left" colspan="5">Coordinates of activated contacts in MNI space (mm)</td></tr><tr><td align="left">Right-side X</td><td align="left">5.3&#x02009;&#x000b1;&#x02009;1.4</td><td align="left">4.8&#x02009;&#x000b1;&#x02009;1.7</td><td align="left">5.7&#x02009;&#x000b1;&#x02009;0.9</td><td align="left">6.0&#x02009;&#x000b1;&#x02009;1.1</td></tr><tr><td align="left">Right-side Y</td><td align="left">&#x02212;7.1&#x02009;&#x000b1;&#x02009;1.5</td><td align="left">&#x02212;7.3&#x02009;&#x000b1;&#x02009;1.1</td><td align="left">&#x02212;7.2&#x02009;&#x000b1;&#x02009;1.7</td><td align="left">&#x02212;5.9&#x02009;&#x000b1;&#x02009;1.5</td></tr><tr><td align="left">Right-side Z</td><td align="left">10.2&#x02009;&#x000b1;&#x02009;2.6</td><td align="left">10.2&#x02009;&#x000b1;&#x02009;2.4</td><td align="left">10.0&#x02009;&#x000b1;&#x02009;2.1</td><td align="left">10.6&#x02009;&#x000b1;&#x02009;4.4</td></tr><tr><td align="left">Left-side X</td><td align="left">&#x02212;4.7&#x02009;&#x000b1;&#x02009;1.1</td><td align="left">&#x02212;4.7&#x02009;&#x000b1;&#x02009;1.2</td><td align="left">&#x02212;5.0&#x02009;&#x000b1;&#x02009;0.7</td><td align="left">&#x02212;3.6&#x02009;&#x000b1;&#x02009;1.5</td></tr><tr><td align="left">Left-side Y</td><td align="left">&#x02212;7.1&#x02009;&#x000b1;&#x02009;1.7</td><td align="left">&#x02212;7.3&#x02009;&#x000b1;&#x02009;1.5</td><td align="left">&#x02212;7.6&#x02009;&#x000b1;&#x02009;1.5</td><td align="left">&#x02212;5.1&#x02009;&#x000b1;&#x02009;1.5</td></tr><tr><td align="left">Left-side Z</td><td align="left">10.5&#x02009;&#x000b1;&#x02009;2.2</td><td align="left">10.5&#x02009;&#x000b1;&#x02009;2.3</td><td align="left">10.4&#x02009;&#x000b1;&#x02009;2.4</td><td align="left">10.6&#x02009;&#x000b1;&#x02009;1.9</td></tr><tr><td align="left" colspan="5">Stimulation parameters</td></tr><tr><td align="left">Amplitude (both sides, V)</td><td align="left">4.6&#x02009;&#x000b1;&#x02009;0.7</td><td align="left">4.3&#x02009;&#x000b1;&#x02009;0.9</td><td align="left">4.9&#x02009;&#x000b1;&#x02009;0.3</td><td align="left">5.0</td></tr><tr><td align="left">Pulse width (both sides, &#x000b5;sec)</td><td align="left">94.0&#x02009;&#x000b1;&#x02009;10.3</td><td align="left">94.2&#x02009;&#x000b1;&#x02009;13.9</td><td align="left">94.4&#x02009;&#x000b1;&#x02009;6.3</td><td align="left">92.0&#x02009;&#x000b1;&#x02009;4.5</td></tr><tr><td align="left">Frequency (both sides, Hz)</td><td align="left">89.1&#x02009;&#x000b1;&#x02009;69.6</td><td align="left">79.0&#x02009;&#x000b1;&#x02009;72.1</td><td align="left">83.8&#x02009;&#x000b1;&#x02009;71.7</td><td align="left">145.0</td></tr></tbody></table><table-wrap-foot><p>This table presents the baseline characteristics of all patients as well as patients from three separate epilepsy centers. The values are expressed as either mean&#x02009;&#x000b1;&#x02009;SD or as percentage proportions. Seizure frequency is presented as median (IQR). Higher scores on the LSSS, HAMA, and HAMD scales indicate more severe symptoms, while higher scores on the QoLIE-31, MMSE, and MoCA scales indicate better conditions</p><p><italic>BTH&#x000a0;</italic>Beijing Tiantan Hospital,&#x000a0;<italic>BFH&#x000a0;</italic>Beijing Fengtai Hospital,&#x000a0;<italic>FAH-AMU&#x000a0;</italic>First Affiliated Hospital of Anhui Medical University,&#x000a0;<italic>FAS&#x000a0;</italic>focal aware seizure,&#x000a0;<italic>FBTCS&#x000a0;</italic>focal to bilateral tonic&#x02013;clonic seizure,&#x000a0;<italic>FIAS&#x000a0;</italic>focal impaired awareness seizure,&#x000a0;<italic>ASM&#x000a0;</italic>anti-seizure medication,&#x000a0;<italic>LSSS&#x000a0;</italic>Liverpool Seizure Severity Scale,&#x000a0;<italic>QoLIE-31&#x000a0;</italic>31-item version Quality of Life in Epilepsy,&#x000a0;<italic>HAMA&#x000a0;</italic>Hamilton Anxiety Rating Scale,&#x000a0;<italic>HAMD&#x000a0;</italic>Hamilton Depression Rating Scale,&#x000a0;<italic>MMSE&#x000a0;</italic>Mini-Mental State Examination,&#x000a0;<italic>MoCA&#x000a0;</italic>Montreal Cognitive Assessment</p><p><sup>a</sup>Patients may experience seizures originating from more than one location</p><p><sup>b</sup>Patients may have more than one type of seizure</p></table-wrap-foot></table-wrap></p></sec><sec id="Sec9"><title>Electrode localization and stimulation parameters</title><p id="Par40">The locations of the electrodes and activated contacts are illustrated in Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>. One patient from the BTH center could not undergo electrode reconstruction due to missing imaging data. In summary, the activated contacts were positioned in the ventral and anterior regions of the ANT. The mean coordinates of the activated contacts in Montreal Neurological Institute (MNI) space were as follows: right hemisphere, <italic>X</italic>&#x02009;=&#x02009;5.3&#x02009;&#x000b1;&#x02009;1.4, <italic>Y</italic>&#x02009;= &#x02212;&#x02009;7.1&#x02009;&#x000b1;&#x02009;1.5, <italic>Z</italic>&#x02009;=&#x02009;10.2&#x02009;&#x000b1;&#x02009;2.6; left hemisphere, <italic>X</italic>&#x02009;= &#x02212;&#x02009;4.7&#x02009;&#x000b1;&#x02009;1.1, <italic>Y</italic>&#x02009;= &#x02212;&#x02009;7.1&#x02009;&#x000b1;&#x02009;1.7, <italic>Z</italic>&#x02009;=&#x02009;10.5&#x02009;&#x000b1;&#x02009;2.2 (Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>).<fig id="Fig2"><label>Fig.&#x000a0;2</label><caption><p>Electrode placements relative to the anterior nucleus of the thalamus across three cohorts. <bold>A</bold> Flow chart of patient inclusion and follow-up. <bold>B</bold>&#x02013;<bold>D</bold> DBS electrode placements are shown relative to a superior view of the ANT for patients from Beijing Tiantan Hospital (BTH, <bold>B</bold>), Beijing Fengtai Hospital (BFH, <bold>C</bold>), and the First Affiliated Hospital of Anhui Medical University (FAH-AMU, <bold>D</bold>). <bold>E</bold> Axial views show the DBS lead trajectories for all three cohorts, with colors corresponding to the respective cohorts. The ANT is delineated using the THOMAS atlas, and the background image is derived from a 7-T ex vivo 100-mm brain atlas. Active electrode contacts are highlighted in red</p></caption><graphic xlink:href="12916_2025_4465_Fig2_HTML" id="MO2"/></fig></p><p id="Par41">All 40 patients completed the 1-year follow-up, 38 completed the 2-year follow-up, 35 completed the 3-year follow-up, 33 completed the 4-year follow-up, and 30 completed the 5-year follow-up. At the last follow-up, monopolar stimulation mode was used for all patients, except for four, who received bipolar stimulation. The average stimulation parameters at the last follow-up were consistent bilaterally: amplitude 4.6&#x02009;&#x000b1;&#x02009;0.7&#x000a0;V, pulse width 94.0&#x02009;&#x000b1;&#x02009;10.3 &#x000b5;sec, and frequency 89.1&#x02009;&#x000b1;&#x02009;69.6&#x000a0;Hz (Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>) Subsequent analysis revealed inter-center differences, with BTH (4.3&#x02009;&#x000b1;&#x02009;0.9&#x000a0;V) exhibiting a significantly lower amplitude than BFH (4.9&#x02009;&#x000b1;&#x02009;0.3&#x000a0;V) and FAH-AMU (5.0&#x000a0;V) (<italic>p</italic>&#x02009;=&#x02009;0.022).</p></sec><sec id="Sec10"><title>Efficacy on seizure frequency</title><p id="Par42">As shown in Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>, the median monthly SF decreased from 15.0 (5.3&#x02013;30.0) to 6.5 (2.0&#x02013;12.0) over the 5-year follow-up, reflecting a reduction of 56.7% (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). The LSSS decreased from 26.7&#x02009;&#x000b1;&#x02009;5.2 to 17.9&#x02009;&#x000b1;&#x02009;8.6 at the last follow-up (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). Significant reductions were observed at the 1-year follow-up compared to baseline. A further decline was also observed at the 2-year follow-up, although not statistically significant. These findings align with the improvement noted throughout the study. The SF continued to decrease during subsequent follow-up periods, but the reduction was not statistically significant (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). For different seizure foci, patients with frontal lobe foci showed the most significant reduction (75.0%, <italic>p</italic>&#x02009;=&#x02009;0.017), followed by those with temporal lobe foci (63.0%, <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). No significant reduction was observed in patients with occipital lobe or diffuse epilepsy. Additionally, the median improvement for patients with mesial TLE, lateral TLE, mesio-lateral TLE, and bilateral TLE was 80.0%, 33.3%, 50.0%, and 76.2%, respectively. Reductions across different seizure types were also noted. The median frequency of FIAS (<italic>p</italic>&#x02009;=&#x02009;0.003), FBTCS (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001) and generalized seizures (<italic>p</italic>&#x02009;=&#x02009;0.016) decreased significantly, while FAS also showed a decline, but without statistical significance (Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>).<fig id="Fig3"><label>Fig.&#x000a0;3</label><caption><p>Reduction in seizure frequency and Liverpool Seizure Severity Scale scores after ANT-DBS. Box-and-whisker plots and dot-line plots depict these changes. In each box, the lower and upper borders represent the 25th and 75th percentiles, and the centerline indicates the median. Paired <italic>t</italic>-tests or non-parametric tests were performed, with <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.05 considered statistically significant. <bold>A</bold> Total SF at baseline versus the last follow-up; a significant reduction was observed. <bold>B</bold> LSSS scores decreased significantly from baseline to the last follow-up. <bold>C</bold> Annual SF from 1 to 5&#x000a0;years; significant decreases occurred in the first year. <bold>D</bold>&#x02013;<bold>G</bold>: SF reduction by seizure onset zone: significant reductions were seen in temporal (D) and frontal (<bold>E</bold>) onsets, but not in occipital (<bold>F)</bold> or diffused (<bold>G</bold>) onsets. <bold>H</bold>&#x02013;<bold>K</bold>: SF reduction by seizure semiology: focal impaired awareness seizures (FIAS) (<bold>I</bold>), focal bilateral tonic&#x02013;clonic seizures (FBTCS) (<bold>J</bold>) and general onset seizures (<bold>K</bold>) showed significant reduction, while focal aware seizures (FAS) (<bold>H</bold>) did not</p></caption><graphic xlink:href="12916_2025_4465_Fig3_HTML" id="MO3"/></fig><table-wrap id="Tab2"><label>Table 2</label><caption><p>Annual changes in seizure frequency and responder rate</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Variables</th><th align="left">Baseline</th><th align="left">1-y follow-up</th><th align="left">Reduction/<break/>proportion (%)</th><th align="left">P (1 y vs. baseline)</th><th align="left">2-y follow-up</th><th align="left">Reduction /<break/>proportion (%)</th><th align="left">P (2 y vs. 1 y)</th></tr></thead><tbody><tr><td align="left">Seizure Frequency <sup>a</sup></td><td align="left">15.0 (5.3&#x02013;30.0)</td><td align="left">10.0 (2.3&#x02013;17.5)</td><td align="left">33.3%</td><td align="left"><bold>&#x02009;&#x0003c;&#x02009;0.001</bold>*</td><td align="left">8.5 (1.8&#x02013;12.5)</td><td align="left">43.3%</td><td align="left">0.028</td></tr><tr><td align="left">Responders <sup>b</sup></td><td align="left">-</td><td align="left">21</td><td align="left">52.5%</td><td align="left"><bold>&#x02009;&#x0003c;&#x02009;0.001</bold>*</td><td align="left">25</td><td align="left">62.5%</td><td align="left">0.366</td></tr></tbody></table><table-wrap-foot><p><sup>a</sup>Wilcoxon Signed-Rank Test. Values are presented as median (IQR)</p><p><sup>b</sup>Chi-square test. Values are presented as percentage proportions</p><p>Responder: A patient with a reduction in seizure frequency of &#x02265;50%</p><p><italic>P</italic> value &#x0003c; 0.01 was considered statistically significant after Bonferroni correction</p></table-wrap-foot></table-wrap></p><p id="Par43">A total of 25 patients (62.5%) achieved responder status at the last follow-up, including 5 patients (12.5%) who became seizure-free for at least 6&#x000a0;months (Fig.&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>A). At the 1-year follow-up, 21 patients were responders, and 25 patients achieved responder status by the 2-year follow-up. No additional responders were observed in subsequent follow-up periods (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). Among the three centers, the number of patients who met the responder criteria was 12 (63.2%) at BTH, 8 (50.0%) at BFH, and 5 (100.0%) at FAH-AMU. Figure&#x000a0;<xref rid="Fig4" ref-type="fig">4</xref>B illustrates the time-dependent distribution of responders. The proportion of responders increased rapidly within the first 20&#x000a0;months and then plateaued, reaching its peak at 24&#x000a0;months postoperatively. The trends across the three centers were similar (Log-Rank test, <italic>p</italic>&#x02009;=&#x02009;0.290). Comparison of baseline characteristics between responders and non-responders identified that responders had a higher proportion of TLE (<italic>p</italic>&#x02009;=&#x02009;0.001) and greater stimulation amplitude (<italic>p</italic>&#x02009;=&#x02009;0.031) than the non-responders (Additional File 1: Table S1).<fig id="Fig4"><label>Fig.&#x000a0;4</label><caption><p>Distribution and time points of responders. <bold>A</bold> Percent change in total SF from baseline to the last follow-up. Patients with&#x02009;&#x02265;&#x02009;50% reduction in SF (green) were defined as responders, while those with&#x02009;&#x0003c;&#x02009;50% reduction (red) were considered non-responders. Five patients achieved seizure freedom. <bold>B</bold> Kaplan&#x02013;Meier analysis of responder rate (RR) across BTH, BFH, and FAH-AMU. All responders achieved their status within the first 24&#x000a0;months</p></caption><graphic xlink:href="12916_2025_4465_Fig4_HTML" id="MO4"/></fig></p></sec><sec id="Sec11"><title>Mood, cognition, and quality of life</title><p id="Par44">Improvements in emotional well-being, cognition and QoL were demonstrated in Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>. Depression and anxiety, assessed using HAMD (from 15.6&#x02009;&#x000b1;&#x02009;5.8 to 13.5&#x02009;&#x000b1;&#x02009;6.6, <italic>p</italic>&#x02009;=&#x02009;0.048) and HAMA (from 17.2&#x02009;&#x000b1;&#x02009;6.1 to 14.8&#x02009;&#x000b1;&#x02009;7.2, <italic>p</italic>&#x02009;=&#x02009;0.008), showed significant improvements. Cognitive assessments using the MMSE and MoCA did not show significant changes at the last follow-up compared to baseline. The QoLIE-31 total scores increased from 73.8&#x02009;&#x000b1;&#x02009;13.2 to 93.0&#x02009;&#x000b1;&#x02009;21.8 (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001). For the seven subscales, significant improvements were observed in Overall QoL (7.4&#x02009;&#x000b1;&#x02009;3.8 to 11.1&#x02009;&#x000b1;&#x02009;3.8, <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001), Emotional Well-being (11.0&#x02009;&#x000b1;&#x02009;4.7 to 14.1&#x02009;&#x000b1;&#x02009;5.7, <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001), Energy/Fatigue (11.1&#x02009;&#x000b1;&#x02009;5.6 to 18.8&#x02009;&#x000b1;&#x02009;7.8, <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001), and Social Functioning (11.4&#x02009;&#x000b1;&#x02009;5.3 to 14.6&#x02009;&#x000b1;&#x02009;6.0, <italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001) (Table&#x000a0;<xref rid="Tab3" ref-type="table">3</xref>). Moreover, the improvement rates in QoLIE-31 total scores (p&#x02009;&#x0003c;&#x02009;0.001), as well as Overall QoL (p&#x02009;=&#x02009;0.001), Emotional Well-being (<italic>p</italic>&#x02009;=&#x02009;0.004), Energy/Fatigue (<italic>p</italic>&#x02009;&#x0003c;&#x02009;0.001), and Social Functioning (<italic>p</italic>&#x02009;=&#x02009;0.002) were higher in responders compared to non-responders, while no significant differences were found in the remaining subscales (Additional File 1: Table S2).
<table-wrap id="Tab3"><label>Table 3</label><caption><p>Outcomes of quality of life, mood and cognitive status after ANT-DBS</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Variables</th><th align="left">Baseline</th><th align="left">Last follow-up</th><th align="left"><italic>P</italic> value</th></tr></thead><tbody><tr><td align="left">HAMD</td><td align="left">15.6&#x02009;&#x000b1;&#x02009;5.8</td><td align="left">13.5&#x02009;&#x000b1;&#x02009;6.6</td><td align="left"><bold>0.048</bold>*</td></tr><tr><td align="left">HAMA</td><td align="left">17.2&#x02009;&#x000b1;&#x02009;6.1</td><td align="left">14.8&#x02009;&#x000b1;&#x02009;7.2</td><td align="left"><bold>0.008</bold>*</td></tr><tr><td align="left">MMSE</td><td align="left">25.8&#x02009;&#x000b1;&#x02009;2.9</td><td align="left">26.1&#x02009;&#x000b1;&#x02009;2.7</td><td align="left">0.133</td></tr><tr><td align="left">MoCA</td><td align="left">25.5&#x02009;&#x000b1;&#x02009;2.8</td><td align="left">25.7&#x02009;&#x000b1;&#x02009;2.6</td><td align="left">0.544</td></tr><tr><td align="left">QoLIE-31 Total</td><td align="left">73.8&#x02009;&#x000b1;&#x02009;13.2</td><td align="left">93.0&#x02009;&#x000b1;&#x02009;21.8</td><td align="left"><bold>&#x02009;&#x0003c;&#x02009;0.001</bold>*</td></tr><tr><td align="left">&#x02003;-Seizure Worry</td><td align="left">11.9&#x02009;&#x000b1;&#x02009;4.9</td><td align="left">12.5&#x02009;&#x000b1;&#x02009;5.1</td><td align="left">0.061</td></tr><tr><td align="left">&#x02003;- Overall QOL</td><td align="left">7.4&#x02009;&#x000b1;&#x02009;3.8</td><td align="left">11.1&#x02009;&#x000b1;&#x02009;3.8</td><td align="left"><bold>&#x02009;&#x0003c;&#x02009;0.001</bold>*</td></tr><tr><td align="left">&#x02003;-Emotional Well-being</td><td align="left">11.0&#x02009;&#x000b1;&#x02009;4.7</td><td align="left">14.1&#x02009;&#x000b1;&#x02009;5.7</td><td align="left"><bold>&#x02009;&#x0003c;&#x02009;0.001</bold>*</td></tr><tr><td align="left">&#x02003;-Energy/Fatigue</td><td align="left">11.1&#x02009;&#x000b1;&#x02009;5.6</td><td align="left">18.8&#x02009;&#x000b1;&#x02009;7.8</td><td align="left"><bold>&#x02009;&#x0003c;&#x02009;0.001</bold>*</td></tr><tr><td align="left">&#x02003;-Cognitive Functioning</td><td align="left">12.5&#x02009;&#x000b1;&#x02009;5.2</td><td align="left">12.8&#x02009;&#x000b1;&#x02009;5.2</td><td align="left">0.394</td></tr><tr><td align="left">&#x02003;-Medication Effects</td><td align="left">8.7&#x02009;&#x000b1;&#x02009;3.3</td><td align="left">9.2&#x02009;&#x000b1;&#x02009;3.3</td><td align="left">0.055</td></tr><tr><td align="left">&#x02003;-Social Functioning</td><td align="left">11.4&#x02009;&#x000b1;&#x02009;5.3</td><td align="left">14.6&#x02009;&#x000b1;&#x02009;6.0</td><td align="left"><bold>&#x02009;&#x0003c;&#x02009;0.001</bold>*</td></tr></tbody></table><table-wrap-foot><p>This table presents the outcomes of mood, cognitive status and quality of life as well as its following subscales from baseline to the last follow-up after the implantation</p><p><italic>QoLIE-31&#x000a0;</italic>31-item version of the Quality of Life in Epilepsy,&#x000a0;<italic>HAMD&#x000a0;</italic>Hamilton Depression Rating Scale,&#x000a0;<italic>HAMA&#x000a0;</italic>Hamilton Anxiety Rating Scale,&#x000a0;<italic>MMSE&#x000a0;</italic>Mini-Mental State Examination,&#x000a0;<italic>MoCA&#x000a0;</italic>Montreal Cognitive Assessment</p><p><italic>P</italic> value&#x02009;&#x0003c;&#x02009;0.05 was considered statistically significant and marked with *</p></table-wrap-foot></table-wrap></p></sec><sec id="Sec12"><title>Predictors of seizure outcomes</title><p id="Par45">Multivariable logistic regression for responders and multivariable linear regression for the percentage of seizure reduction were conducted, including three factors with p-values&#x02009;&#x0003c;&#x02009;0.05 from univariable analysis: disease duration, TLE, and baseline LSSS scores. The stimulation amplitude was included as a covariate due to the observed differences in stimulation amplitude among the three centers. The logistic regression identified TLE (OR 8.3, 95% CI 1.5&#x02013;64.3, <italic>p</italic>&#x02009;=&#x02009;0.022) and amplitude (OR 4.2, 95% CI 1.3&#x02013;20.4, <italic>p</italic>&#x02009;=&#x02009;0.034) as independent predictors of responder status, with an area under the curve (AUC) of 0.891. The interaction effect between TLE and amplitude was not statistically significant (<italic>p</italic>&#x02009;=&#x02009;0.632). The linear regression identified TLE (standardized <italic>&#x003b2;</italic> 35.4, 95% CI 4.9&#x02013;65.9, <italic>p</italic>&#x02009;=&#x02009;0.024) and baseline LSSS scores (standardized <italic>&#x003b2;</italic> 3.5, 95% CI 0.7&#x02013;6.2, <italic>p</italic>&#x02009;=&#x02009;0.021) as independent predictors of seizure reduction, with an <italic>R</italic><sup>2</sup> value of 0.407. Interaction between TLE and LSSS was not significant (<italic>p</italic>&#x02009;=&#x02009;0.099) (Table&#x000a0;<xref rid="Tab4" ref-type="table">4</xref>).
<table-wrap id="Tab4"><label>Table 4</label><caption><p>Factors influencing the reduction of seizure frequency</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Variables</th><th align="left">Logistic regression</th><th align="left"/><th align="left"/><th align="left"/><th align="left">Liner regression</th><th align="left"/><th align="left"/><th align="left"/></tr><tr><th align="left"/><th align="left"><bold>Univariate</bold></th><th align="left"/><th align="left"><bold>Multivariate</bold></th><th align="left"/><th align="left"><bold>Univariate</bold></th><th align="left"/><th align="left"><bold>Multivariate</bold></th><th align="left"/></tr><tr><th align="left"/><th align="left"><bold>OR (95%CI)</bold></th><th align="left"><bold><italic>P</italic></bold><bold> value</bold></th><th align="left"><bold>OR (95%CI)</bold></th><th align="left"><bold><italic>P</italic></bold><bold> value</bold></th><th align="left"><bold>&#x00392; (95%CI)</bold></th><th align="left"><bold><italic>P</italic></bold><bold> value</bold></th><th align="left"><bold><italic>&#x00392;</italic></bold><bold> (95%CI)</bold></th><th align="left"><bold><italic>P</italic></bold><bold> value</bold></th></tr></thead><tbody><tr><td align="left" colspan="9">Gender</td></tr><tr><td align="left">&#x02003;Female</td><td align="left">Ref</td><td align="left"/><td align="left"/><td align="left"/><td align="left">Ref</td><td align="left"/><td align="left"/><td align="left"/></tr><tr><td align="left">&#x02003;Male</td><td align="left">0.5 (0.1&#x02013;2.2)</td><td align="left">0.390</td><td align="left"/><td align="left"/><td align="left">&#x02009;&#x02212;&#x02009;14.3 (&#x02212;&#x02009;47.0 to 18.4)</td><td align="left">0.382</td><td align="left"/><td align="left"/></tr><tr><td align="left">Age</td><td align="left">1.1 (1.0&#x02013;1.2)</td><td align="left">0.129</td><td align="left"/><td align="left"/><td align="left">0.9 (&#x02212;&#x02009;0.5 to 2.3)</td><td align="left">0.219</td><td align="left"/><td align="left"/></tr><tr><td align="left">Duration</td><td align="left">1.1 (1.0&#x02013;1.2)</td><td align="left"><bold>0.048</bold>*</td><td align="left">1.1 (1.0&#x02013;1.3)</td><td align="left">0.161</td><td align="left">1.6 (0.1&#x02013;3.1)</td><td align="left"><bold>0.035</bold>*</td><td align="left">1.2 (&#x02212;&#x02009;0.3 to 2.7)</td><td align="left">0.124</td></tr><tr><td align="left">Baseline seizure frequency</td><td align="left">1.0 (0.9&#x02013;1.0)</td><td align="left">0.581</td><td align="left"/><td align="left"/><td align="left">1.2 (&#x02212;&#x02009;0.3 to 0.7)</td><td align="left">0.469</td><td align="left"/><td align="left"/></tr><tr><td align="left">Number of ASMs</td><td align="left">1.0 (0.6&#x02013;1.8)</td><td align="left">0.923</td><td align="left"/><td align="left"/><td align="left">5.2 (&#x02212;&#x02009;7.4 to 17.8)</td><td align="left">0.409</td><td align="left"/><td align="left"/></tr><tr><td align="left">SOZ: Temporal lobe</td><td align="left">7.7 (1.9&#x02013;36.0)</td><td align="left"><bold>0.007</bold>*</td><td align="left">8.3 (1.5&#x02013;64.3)</td><td align="left"><bold>0.022</bold>*</td><td align="left">38.1 (8.9&#x02013;67.2)</td><td align="left"><bold>0.012</bold>*</td><td align="left">35.4 (4.9&#x02013;65.9)</td><td align="left"><bold>0.024</bold>*</td></tr><tr><td align="left">SOZ: Frontal lobe</td><td align="left">1.8 (0.4&#x02013;13.7)</td><td align="left">0.511</td><td align="left"/><td align="left"/><td align="left">25.4 (&#x02212;&#x02009;11.5 to 62.3)</td><td align="left">0.172</td><td align="left"/><td align="left"/></tr><tr><td align="left">Unifocal epilepsy</td><td align="left">1.7 (0.4&#x02013;6.6)</td><td align="left">0.446</td><td align="left"/><td align="left"/><td align="left">&#x02009;&#x02212;&#x02009;4.7 (&#x02212;&#x02009;36.4 to 27.0)</td><td align="left">0.767</td><td align="left"/><td align="left"/></tr><tr><td align="left">LSSS</td><td align="left">1.1 (1.0&#x02013;1.3)</td><td align="left">0.105</td><td align="left">1.1 (0.9&#x02013;1.3)</td><td align="left">0.237</td><td align="left">3.7 (1.0 to 6.3)</td><td align="left"><bold>0.008</bold>*</td><td align="left">3.5 (0.7&#x02013;6.2)</td><td align="left"><bold>0.016</bold>*</td></tr><tr><td align="left">HAMA</td><td align="left">1.0 (0.9&#x02013;1.1)</td><td align="left">0.777</td><td align="left"/><td align="left"/><td align="left">1.1 ( to 0.1 to 2.3)</td><td align="left">0.072</td><td align="left"/><td align="left"/></tr><tr><td align="left">HAMD</td><td align="left">1.0 (0.9&#x02013;1.1)</td><td align="left">0.774</td><td align="left"/><td align="left"/><td align="left">&#x02009;&#x02212;&#x02009;0.9 (&#x02212;&#x02009;3.4 to 1.6)</td><td align="left">0.448</td><td align="left"/><td align="left"/></tr><tr><td align="left">MMSE</td><td align="left">1.1 (0.9&#x02013;1.5)</td><td align="left">0.264</td><td align="left"/><td align="left"/><td align="left">&#x02009;&#x02212;&#x02009;0.4 (&#x02212;&#x02009;3.1 to 2.3)</td><td align="left">0.775</td><td align="left"/><td align="left"/></tr><tr><td align="left">MoCA</td><td align="left">1.1 (0.9&#x02013;1.4)</td><td align="left">0.416</td><td align="left"/><td align="left"/><td align="left">4.8 (&#x02212;&#x02009;0.2 to 9.8)</td><td align="left">0.061</td><td align="left"/><td align="left"/></tr><tr><td align="left">QoLIE</td><td align="left">1.1 (1.0&#x02013;1.1)</td><td align="left">0.118</td><td align="left"/><td align="left"/><td align="left">3.2 (&#x02212;&#x02009;2.3 to 8.7)</td><td align="left">0.251</td><td align="left"/><td align="left"/></tr><tr><td align="left">Amplitude (V)</td><td align="left">3.3 (1.3&#x02013;11.0)</td><td align="left"><bold>0.023</bold>*</td><td align="left">4.2 (1.3&#x02013;20.4)</td><td align="left"><bold>0.034</bold>*</td><td align="left">15.6 (&#x02212;&#x02009;4.7 to 35.8)</td><td align="left">0.129</td><td align="left">8.5 (&#x02212;&#x02009;11.0 to 28.0)</td><td align="left">0.380</td></tr></tbody></table><table-wrap-foot><p>Multivariable logistic regression of responder and liner regression of reduction of seizure frequency</p><p><italic>ASM </italic>anti-seizure medication, <italic>SOZ </italic>seizure onset zone, <italic>LSSS </italic>Liverpool Seizure Severity Scale, <italic>QoLIE-31 </italic>31-item version Quality of Life in Epilepsy, <italic>HAMA </italic>Hamilton Anxiety Rating Scale, <italic>HAMD </italic>Hamilton Depression Rating Scale, <italic>MMSE </italic>Mini-Mental State Examination, <italic>MoCA </italic>Montreal Cognitive Assessment</p><p><italic>P</italic> values&#x02009;&#x0003c;&#x02009;0.05 were considered statistically significant and marked with *</p><p><italic>OR&#x000a0;</italic>odd ratio,&#x000a0;<italic>CI&#x000a0;</italic>confidence interval,&#x000a0;<italic>&#x003b2;&#x000a0;</italic>standardized beta coefficient</p></table-wrap-foot></table-wrap></p></sec><sec id="Sec13"><title>Adverse events</title><p id="Par46">From implantation through the final follow-up, a total of 61 AEs were reported in 25 patients, categorized as surgery-related AEs (1 case), device-related AEs (7 cases), and stimulation-related AEs (53 cases). The single surgery-related AE was an intracranial infection. The 7 device-related AEs included pain at the implantation site (5 cases), infection at the IPG implantation site (1 case), and unexpected IPG shutdown due to inadequate recharging (1 case). The 53 stimulation-related AEs included status epilepticus (1 case), emergence of new seizure types (3 cases), significant increased SF (3 cases), headache (15 cases), memory impairment (6 cases), sleep disturbances (8 cases), irritability (5 cases), dizziness (9 cases), and fatigue (3 cases). By the 5-year follow-up, 88.5% (54/61) of these AEs had been resolved or alleviated (Additional File 1: Table S3).</p></sec></sec><sec id="Sec14"><title>Discussion</title><p id="Par47">This study represents the first 5-year retrospective multicenter investigation into the long-term efficacy of ANT-DBS for DRE in China, providing region-specific data that is crucial for understanding potential geographic and ethnic variations in response. Our findings demonstrate that ANT-DBS significantly and consistently reduces SF, alleviates mood disturbances, and improves QoL. Notably, we identify SOZ, preoperative epilepsy severity and stimulation amplitude as predictive factors for the long-term efficacy of ANT-DBS through logistic and linear regression analyses. These results reinforce the long-term efficacy of ANT-DBS and provide valuable insights into the selection of ideal candidates for clinical practice.</p><sec id="Sec15"><title>Long-term Efficacy of ANT-DBS in DRE</title><p id="Par48">In this study, we observed a significant reduction in SF, with reductions of 33.3%, 43.3%, and 56.7% at 1-year, 2-year, and 5-year follow-up, respectively. A total of 62.5% (26/40) of patients achieved responder status, with 5 patients achieving seizure-freedom. Our findings demonstrate a superior response compared to the MORE study, which reported a reduction of 28.3% at 1&#x000a0;year, 41.1% at 2&#x000a0;years, 56.1% at 5&#x000a0;years, and a RR of 40.6% [<xref ref-type="bibr" rid="CR11">11</xref>, <xref ref-type="bibr" rid="CR25">25</xref>]. However, these results are slightly lower than those reported in the SANTE study, which showed a 41.0% reduction at 1&#x000a0;year, 56.0% at 2&#x000a0;years, 69.0% at 5&#x000a0;years, and a responder rate (RR) of 68.0% [<xref ref-type="bibr" rid="CR13">13</xref>, <xref ref-type="bibr" rid="CR14">14</xref>]. Changes in the types of ASMs were observed in 3 patients (Additional File 1: Table S4). Given that DRE patients exhibit limited responsiveness to ASMs, modest changes in ASMs were considered to have minimal impact on the efficacy of ANT-DBS [<xref ref-type="bibr" rid="CR26">26</xref>]. Therefore, the impact of ASM adjustments on SF was not specifically controlled in the analysis. In addition, quality of life improved significantly after implantation&#x02014;particularly in Overall QOL, Emotional Well-being, Energy/Fatigue, and Social Functioning&#x02014;suggesting that, beyond reducing seizures, ANT-DBS enhances perceived well-being, alleviates psychological burden, and helps restore social functioning. Collectively, these results reinforce the significant and stable efficacy of ANT-DBS in patients with DRE. It is noteworthy that most existing studies on ANT-DBS, including ours, have employed bilateral ANT stimulation. One possible reason is that patients underwent ANT-DBS often present with complex epileptogenic networks, which may involve multifocal or bilateral SOZ. Consequently, bilateral stimulation is commonly used to maximize therapeutic coverage. However, the potential influence of stimulation laterality on treatment efficacy remains an open question. Future studies are warranted to evaluate whether ipsilateral or bilateral ANT stimulation yields differential outcomes.</p><p id="Par49">Interestingly, the reduction in SF plateaued at 24&#x000a0;months postoperatively. Although a continued decrease in SF was observed, no significant reduction occurred after this point. A similar trend, though not explicitly stated, can be observed in the SANTE and MORE studies [<xref ref-type="bibr" rid="CR14">14</xref>, <xref ref-type="bibr" rid="CR25">25</xref>]. The Kaplan&#x02013;Meier analysis further revealed that no additional patients met the responder criteria after 24&#x000a0;months of implantation. DBS is generally believed to exert its therapeutic effects through neural plasticity [<xref ref-type="bibr" rid="CR27">27</xref>, <xref ref-type="bibr" rid="CR28">28</xref>]. For movement disorders such as Parkinson&#x02019;s disease and dystonia, DBS typically achieves stable therapeutic outcomes within approximately 6&#x000a0;months [<xref ref-type="bibr" rid="CR29">29</xref>&#x02013;<xref ref-type="bibr" rid="CR33">33</xref>]. Based on this, we speculate that the neuroplastic effects of ANT-DBS on DRE may require up to 24&#x000a0;months to reach full efficacy. Decreased sensitivity of related structures to stimulation may lead to a reduction in therapeutic efficacy. Future longitudinal studies utilizing EEG, MEG, and functional MRI imaging should be applied to explore the related neuroplastic mechanisms to validate this hypothesis. Moreover, if a patient&#x02019;s seizure frequency does not significantly decline within 24&#x000a0;months post-implantation, it is crucial to reassess their treatment plan and consider more individualized approaches.</p><p id="Par50">In terms of outcomes based on different SOZs, we found that patients with TLE and FLE exhibited significant reductions in SF, while patients with other lateralized epilepsies or diffuse epilepsy demonstrated relatively poorer outcomes. Additionally, the RR was notably higher in patients with TLE (80.8%) and FLE (75.0%) compared to those with occipital (none) or diffuse epilepsy (28.6%). The RR varied across the three centers in our study. One potential explanation for the higher RR observed at FAH-AMU is the small sample size (5 patients), with 4 of them (80.0%) had TLE. Additionally, the stimulation amplitude at FAH-AMU was relatively higher than that at the other two centers. Given our findings suggesting a particularly favorable response to ANT-DBS among TLE patients and those receiving higher stimulation amplitude, the elevated RR may be attributable to both the higher proportion of TLE cases and the use of higher stimulation amplitude. This potential bias in patient selection highlights the importance of the multicenter design of our study.</p><p id="Par51">While the higher proportion of TLE and FLE patients in our cohort may have influenced the results, these differences are likely due to the direct involvement of the temporal and frontal lobes in the ANT-DBS modulation circuit [<xref ref-type="bibr" rid="CR34">34</xref>]. Previous studies have shown that ANT-DBS reduces seizures by modulating the Papez circuit [<xref ref-type="bibr" rid="CR35">35</xref>, <xref ref-type="bibr" rid="CR36">36</xref>], which includes the hippocampus, fornix, mammillary bodies, ANT, and cingulate gyrus [<xref ref-type="bibr" rid="CR37">37</xref>&#x02013;<xref ref-type="bibr" rid="CR39">39</xref>]. TLE primarily originates in the hippocampus, amygdala, and medial temporal lobe structures [<xref ref-type="bibr" rid="CR40">40</xref>], while the dorsolateral prefrontal cortex (DLPFC) and orbitofrontal cortex (OFC), both associated with FLE, have strong connections to the anterior cingulate cortex (ACC) [<xref ref-type="bibr" rid="CR41">41</xref>, <xref ref-type="bibr" rid="CR42">42</xref>]. These findings suggest that compared to epilepsy originating in other regions, the brain regions associated with TLE and FLE have direct or indirect projections to the ANT. As a result, ANT-DBS may modulate these structures, reducing the propagation of abnormal discharges, and thereby improving seizure control in TLE and FLE. Moreover, although the sample size was limited, patients with mesial TLE in our study exhibited a higher SF improvement compared to those with lateral, mesio-lateral, or bilateral TLE, and all mesial TLE patients achieved responder status (Additional File 1: Table S1). Given the closer anatomical relationship between mesial TLE and the Papez circuit, this finding may indirectly support the role of the Papez circuit in seizure control [<xref ref-type="bibr" rid="CR43">43</xref>, <xref ref-type="bibr" rid="CR44">44</xref>].</p></sec><sec id="Sec16"><title>Predictors of long-term outcome</title><p id="Par52">Selecting appropriate candidates for ANT-DBS implantation is crucial in clinical practice. Our study identifies SOZ as an independent predictor of seizure reduction and responder status following ANT-DBS, with TLE patients showing a better therapeutic response. The ANT, serving as a relay station within the Papez circuit, is closely linked to TLE-related brain regions, particularly the hippocampus [<xref ref-type="bibr" rid="CR45">45</xref>]. Studies have shown that high &#x003b2;-band synchronous oscillations occur between the hippocampus and ANT during seizure onset [<xref ref-type="bibr" rid="CR46">46</xref>]. Additionally, research using thalamic-hippocampal evoked potentials has confirmed effective bidirectional connectivity between the ANT and hippocampus, indicating that ANT stimulation can decouple large-scale neural activity involving the hippocampus and related cortical areas [<xref ref-type="bibr" rid="CR47">47</xref>]. In TLE patients, ANT-DBS has been reported to have efficacy comparable to direct temporal lobe stimulation [<xref ref-type="bibr" rid="CR48">48</xref>, <xref ref-type="bibr" rid="CR49">49</xref>]. Furthermore, &#x003b8;-band depolarization in the temporal lobe pathway may serve as a predictive physiological biomarker for ANT-DBS response, further supporting our findings [<xref ref-type="bibr" rid="CR50">50</xref>]. These results underline the importance of the neural network interactions between the ANT and TLE-related structures in determining the therapeutic success of ANT-DBS.</p><p id="Par53">It is worth noting that greater stimulation amplitudes demonstrate greater probabilities of becoming responders. This is a highly important finding for clinicians, as it suggests that higher stimulation amplitudes could be provided to patients to achieve better therapeutic outcomes, as long as no side effects occur. However, clinicians should be aware that excessive stimulation amplitudes may shorten the lifespan of the IPG. We also observed that a higher preoperative LSSS score correlated with a greater reduction in SF following ANT-DBS implantation. This suggests that the LSSS, as a comprehensive tool for assessing epilepsy severity, could serve as a useful preoperative evaluation metric in clinical practice for selecting suitable candidates for ANT-DBS.</p><p id="Par54">Additionally, due to the limited number of patients included in this study, other potentially relevant predictive factors might have been overlooked. Future studies with larger sample sizes are warranted to further explore and validate additional predictors.</p><sec id="Sec17"><title>Quality of life</title><p id="Par55">During the 5-year follow-up after implantation, patients had clinically meaningful improvements in QoL, which consistent with previous studies [<xref ref-type="bibr" rid="CR14">14</xref>, <xref ref-type="bibr" rid="CR25">25</xref>]. Interestingly, responders demonstrated significantly greater improvements in QoL compared with non-responders. This suggests that improvement in seizure control could optimize patients&#x02019; overall living condition. In addition, quality of life improved particularly in Overall QoL, Emotional Well-being, Energy/Fatigue, and Social Functioning. These results indicate that, beyond reducing seizures, ANT-DBS enhances patients perceived well-being, alleviates psychological burden, and helps restore social functioning. Therefore, ANT-DBS could provide patients with comprehensive benefits.</p></sec><sec id="Sec18"><title>Mood and cognition</title><p id="Par56">Mood and cognitive impairments are prevalent and detrimental in patients with DRE, and improving these symptoms is an important therapeutic goal. Our study found that ANT-DBS significantly improves mood conditions, consistent with the results of the SANTE and MORE studies, as well as several smaller studies [<xref ref-type="bibr" rid="CR13">13</xref>, <xref ref-type="bibr" rid="CR19">19</xref>, <xref ref-type="bibr" rid="CR25">25</xref>].&#x000a0;ANT-DBS likely enhances mood by modulating the ANT-limbic network within the Papez circuit, influencing the release of mood-related neurotransmitters [<xref ref-type="bibr" rid="CR37">37</xref>, <xref ref-type="bibr" rid="CR51">51</xref>]. Additionally, the reduction in SF may indirectly alleviate mood disturbances, contributing to the observed improvements in emotional well-being [<xref ref-type="bibr" rid="CR52">52</xref>].</p><p id="Par57">Regarding cognitive status, several studies have reported improvements in attention and executive function after ANT-DBS implantation, whereas our study did not observe a significant overall improvement in cognition [<xref ref-type="bibr" rid="CR25">25</xref>, <xref ref-type="bibr" rid="CR53">53</xref>]. One possible explanation is that the cognitive scales used in this study, MMSE and MoCA, may lack sensitivity for detecting subtle or domain-specific cognitive changes such as memory, attention, or executive function. It is worth noting that although some studies reported memory decline, prior research has shown that fornix stimulation, which also targets the Papez circuit, can improve memory in Alzheimer's disease (AD) [<xref ref-type="bibr" rid="CR14">14</xref>, <xref ref-type="bibr" rid="CR54">54</xref>]. Notably, the stimulation intensity used in fornix stimulation is generally lower than that used in ANT-DBS [<xref ref-type="bibr" rid="CR55">55</xref>], suggesting that the high-intensity stimulation in ANT-DBS may contribute to memory impairment.</p></sec></sec><sec id="Sec19"><title>Limitations</title><p id="Par58">Several limitations should be considered when interpreting the results of this study. First, despite the multicenter design, the retrospective nature of the study and the relatively small sample size inherently limit the strength of the evidence. The accuracy of the regression model requires further validation. Variations in the selection of stimulation parameters have existed across centers. Additionally, due to the annual follow-up assessments, the exact postoperative time point of treatment response could not be accurately determined at the monthly level. A prospective multicenter study with a larger sample size should be conducted in the future to address and harmonize these issues. Second, the primary outcome measure, SF reduction, was based on self-reported seizure diaries. While this method is widely used and accepted, subjectivity and recall bias may still occur, particularly in cases of nocturnal seizures or patients with postictal amnesia. Third, cognitive function was assessed using MoCA and MMSE, which are general screening tools and may lack sensitivity for detecting subtle or domain-specific cognitive changes. Future studies should incorporate more targeted cognitive assessments for specific domains.</p></sec></sec><sec id="Sec20"><title>Conclusions</title><p id="Par59">This multicenter study with long-term follow-up confirms that ANT-DBS significantly and consistently reduces SF in patients with DRE. Overall QoL, Emotional Well-being, Energy and Social Functioning also showed significant improvement. SOZ, preoperative seizure severity and stimulation amplitudes were identified as key predictors of treatment efficacy, which offers practical guidance for clinicians in selecting suitable patients and optimizing DBS parameters. Future research should focus on validating the use of preoperative assessment tools such as the LSSS and exploring further mechanisms underlying the effects of ANT-DBS on mood, cognition, and other neuropsychological symptoms.</p></sec><sec id="Sec21" sec-type="supplementary-material"><title>Supplementary Information</title><p>
<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="12916_2025_4465_MOESM1_ESM.docx"><caption><p>Additional file 1.</p></caption></media></supplementary-material></p></sec></body><back><glossary><title>Abbreviations</title><def-list><def-item><term>ANT</term><def><p id="Par5">Anterior nucleus of the thalamus</p></def></def-item><def-item><term>DBS</term><def><p id="Par6">Deep brain stimulation</p></def></def-item><def-item><term>SF</term><def><p id="Par7">Seizure frequency</p></def></def-item><def-item><term>DRE</term><def><p id="Par8">Drug-resistant epilepsy</p></def></def-item><def-item><term>RR</term><def><p id="Par9">Responder rate</p></def></def-item><def-item><term>ASM</term><def><p id="Par10">Anti-seizure medication</p></def></def-item><def-item><term>SOZ</term><def><p id="Par11">Seizure onset zones</p></def></def-item><def-item><term>IPG</term><def><p id="Par12">Implantable pulse generator</p></def></def-item><def-item><term>BTH</term><def><p id="Par13">Beijing Tiantan Hospital</p></def></def-item><def-item><term>BFH</term><def><p id="Par14">Beijing Fengtai Hospital</p></def></def-item><def-item><term>FAH-AMU</term><def><p id="Par15">First Affiliated Hospital of Anhui Medical University</p></def></def-item><def-item><term>TLE</term><def><p id="Par16">Temporal lobe epilepsy</p></def></def-item><def-item><term>FLE</term><def><p id="Par17">Frontal lobe epilepsy</p></def></def-item><def-item><term>FAS</term><def><p id="Par18">Focal aware seizure</p></def></def-item><def-item><term>FBTCS</term><def><p id="Par19">Focal to bilateral tonic&#x02013;clonic seizure</p></def></def-item><def-item><term>FIAS</term><def><p id="Par20">Focal impaired awareness seizure</p></def></def-item><def-item><term>LSSS</term><def><p id="Par21">Liverpool Seizure Severity Scale</p></def></def-item><def-item><term>QoLIE-31</term><def><p id="Par22">31-item version Quality of Life in Epilepsy</p></def></def-item><def-item><term>HAMA</term><def><p id="Par23">Hamilton Anxiety Rating Scale</p></def></def-item><def-item><term>HAMD</term><def><p id="Par24">Hamilton Depression Rating Scale</p></def></def-item><def-item><term>MMSE</term><def><p id="Par25">Mini-Mental State Examination</p></def></def-item><def-item><term>MoCA</term><def><p id="Par26">Montreal Cognitive Assessment</p></def></def-item></def-list></glossary><fn-group><fn><p><bold>Publisher&#x02019;s Note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn><fn><p>Tianqi Hu, Hutao Xie and Ming Shan contributed equally and share first authorship.</p></fn></fn-group><ack><title>Acknowledgements</title><p>Not applicable.</p></ack><notes notes-type="author-contribution"><title>Authors&#x02019; contributions
</title><p>Drafting of the manuscript: TH, HX and MS. Data collection: TH, HX, MS, LS, BY, QZ, DG, YJ, QG, SL, YW and XD. Analysis and interpretation: TH, HX, MS, QZ, AY, FM, KZ, JZ and HZ. Study concepts and design: TH, HX, MS, KZ, JZ and HZ. Critical revision of the manuscript: TH, HX, MS, AY, FM, KZ, JZ and HZ. All authors reviewed and approved the final manuscript.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>This study was supported by the National Natural Science Foundation of China (grant numbers 82171442,&#x000a0;82401713, 82301655, T2488101) and the Postdoctoral Fellowship Program of CPSF (grant number GZC20231742).</p></notes><notes notes-type="data-availability"><title>Data availability
</title><p>The datasets used and/or analyzed during the current study are available from the corresponding author on reasonable request.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par60">This study was approved by the institutional ethics committees of all participating hospitals: Beijing Tiantan Hospital, Beijing Fengtai Hospital (KY 2019&#x02013;020-01) and the First Affiliated Hospital of Anhui Medical University (2019H022) and conducted in accordance with the Declaration of Helsinki. Written informed consent was obtained from all patients or their legal guardians for the use of their medical data in research.</p></notes><notes id="FPar2"><title>Consent for publication</title><p id="Par61">Not applicable.</p></notes><notes id="FPar3" notes-type="COI-statement"><title>Competing interests
</title><p id="Par62">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References

</element-citation></ref><ref id="bib0003"><label>3</label><element-citation publication-type="book" id="sbref0003"><person-group person-group-type="author"><name><surname>Rodrigues</surname><given-names>M.B.</given-names></name><name><surname>White</surname><given-names>L.M.</given-names></name><name><surname>Knee</surname></name></person-group><person-group person-group-type="editor"><name><surname>Hodler</surname><given-names>J.</given-names></name><name><surname>Kubik-Huch</surname><given-names>R.A.</given-names></name><name><surname>von Schulthess</surname><given-names>G.K.</given-names></name></person-group><source>Musculoskeletal diseases 2021-2024: diagnostic imaging</source><year>2021</year><publisher-name>Springer</publisher-name><publisher-loc>Cham, Switzerland</publisher-loc><fpage>83</fpage><lpage>106</lpage></element-citation></ref><ref id="bib0004"><label>4</label><element-citation publication-type="journal" id="sbref0004"><person-group person-group-type="author"><name><surname>Schmidt</surname><given-names>J.E.</given-names></name><name><surname>Amrami</surname><given-names>K.K.</given-names></name><name><surname>Manduca</surname><given-names>A.</given-names></name><etal/></person-group><article-title>Semi-automated digital image analysis of joint space width in knee radiographs</article-title><source>Skelet. Radiol.</source><volume>34</volume><year>2005</year><fpage>639</fpage><lpage>643</lpage></element-citation></ref><ref id="bib0005"><label>5</label><element-citation publication-type="journal" id="sbref0005"><person-group person-group-type="author"><name><surname>Manikandaprabhu</surname><given-names>P.</given-names></name><name><surname>Thirumoorthi</surname><given-names>C.</given-names></name><name><surname>Batumalay</surname><given-names>M.</given-names></name><name><surname>Xu</surname><given-names>Z.</given-names></name></person-group><article-title>Combined fire fly &#x02013; Support vector machine digital radiography classification (FF-SVM-DRC) model for inferior alveolar nerve injury (IANI) identification</article-title><source>J. Appl. Data Sci.</source><volume>5</volume><issue>3</issue><year>2024</year><fpage>1363</fpage><lpage>1375</lpage></element-citation></ref><ref id="bib0006"><label>6</label><element-citation publication-type="journal" id="sbref0006"><person-group person-group-type="author"><name><surname>Verma</surname><given-names>S.</given-names></name><name><surname>Devarajan</surname><given-names>G.G.</given-names></name><name><surname>Sharma</surname><given-names>P.K.</given-names></name></person-group><article-title>iWBFCxr: improved weighted box fusion for analyzing chest X-ray images for enhancing thoracic abnormalities</article-title><source>Int. J. Inf. Technol.</source><volume>17</volume><year>2025</year><fpage>711</fpage><lpage>720</lpage></element-citation></ref><ref id="bib0007"><label>7</label><element-citation publication-type="journal" id="sbref0007"><person-group person-group-type="author"><name><surname>Kubi</surname><given-names>N.N.B.A.</given-names></name><name><surname>Nazir</surname><given-names>S.</given-names></name></person-group><article-title>Dementia prediction with multimodal clinical and imaging data</article-title><source>Int. J. Inf. Technol.</source><volume>17</volume><year>2025</year><fpage>5</fpage><lpage>16</lpage></element-citation></ref><ref id="bib0008"><label>8</label><element-citation publication-type="journal" id="sbref0008"><person-group person-group-type="author"><name><surname>Kim</surname><given-names>D.H.</given-names></name><name><surname>Lee</surname><given-names>K.J.</given-names></name><name><surname>Choi</surname><given-names>D.</given-names></name><name><surname>Lee</surname><given-names>J.I.</given-names></name><name><surname>Choi</surname><given-names>H.G.</given-names></name><name><surname>Lee</surname><given-names>Y.S.</given-names></name></person-group><article-title>Can additional patient information improve the diagnostic performance of deep learning for the interpretation of knee osteoarthritis severity</article-title><source>J. Clin. Med.</source><volume>9</volume><issue>10</issue><year>2020</year><fpage>3341</fpage><pub-id pub-id-type="pmid">33080993</pub-id>

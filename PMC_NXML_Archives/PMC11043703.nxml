<article-meta><article-id pub-id-type="pmid">38649279</article-id><article-id pub-id-type="pmc">11043703</article-id>
<article-id pub-id-type="publisher-id">jitc-2023-007628</article-id><article-id pub-id-type="doi">10.1136/jitc-2023-007628</article-id><article-categories><subj-group subj-group-type="heading"><subject>Immunotherapy Biomarkers</subject></subj-group><subj-group subj-group-type="hwp-journal-coll"><subject>1506</subject><subject>2437</subject></subj-group><series-title>Original research</series-title></article-categories><title-group><article-title>Total metabolic tumor volume on <sup>18</sup>F-FDG PET/CT is a game-changer for patients with metastatic lung cancer treated with immunotherapy</article-title></title-group><contrib-group><contrib id="author-109282612" contrib-type="author" corresp="yes"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0009-0008-0761-6795</contrib-id><name><surname>Tricarico</surname><given-names>Pierre</given-names></name><xref rid="aff1" ref-type="aff">1</xref></contrib><contrib id="author-109283449" contrib-type="author"><name><surname>Chardin</surname><given-names>David</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref></contrib><contrib id="author-75861078" contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0001-9084-9435</contrib-id><name><surname>Martin</surname><given-names>Nicolas</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-109283476" contrib-type="author"><contrib-id contrib-id-type="orcid" authenticated="false">http://orcid.org/0000-0001-9235-9675</contrib-id><name><surname>Contu</surname><given-names>Sara</given-names></name><xref rid="aff4" ref-type="aff">4</xref></contrib><contrib id="author-92138233" contrib-type="author"><name><surname>Hugonnet</surname><given-names>Florent</given-names></name><xref rid="aff5" ref-type="aff">5</xref></contrib><contrib id="author-75861104" contrib-type="author"><name><surname>Otto</surname><given-names>Josiane</given-names></name><xref rid="aff3" ref-type="aff">3</xref></contrib><contrib id="author-75861137" contrib-type="author"><name><surname>Humbert</surname><given-names>Olivier</given-names></name><xref rid="aff1" ref-type="aff">1</xref><xref rid="aff2" ref-type="aff">2</xref></contrib></contrib-group><aff id="aff1">

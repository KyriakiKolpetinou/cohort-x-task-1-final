<article-id pub-id-type="publisher-id">1197</article-id><article-id pub-id-type="doi">10.1007/s40123-025-01197-w</article-id><article-categories><subj-group subj-group-type="heading"><subject>Original Research</subject></subj-group></article-categories><title-group><article-title>Long-Term Efficacy and Safety of CT-P42 in Patients with Diabetic Macular Edema: 52-Week Results from a Phase 3 Randomized Clinical Trial</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Brown</surname><given-names>David M.</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Wolf</surname><given-names>Sebastian</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Veselovsky</surname><given-names>Milan</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Veith</surname><given-names>Miroslav</given-names></name><xref ref-type="aff" rid="Aff5">5</xref><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Papp</surname><given-names>Andras</given-names></name><xref ref-type="aff" rid="Aff7">7</xref></contrib><contrib contrib-type="author"><name><surname>Mange</surname><given-names>Shobhana</given-names></name><xref ref-type="aff" rid="Aff8">8</xref></contrib><contrib contrib-type="author"><name><surname>Mondal</surname><given-names>Lakshmi Kanta</given-names></name><xref ref-type="aff" rid="Aff9">9</xref></contrib><contrib contrib-type="author"><name><surname>Romanczak</surname><given-names>Dominika</given-names></name><xref ref-type="aff" rid="Aff10">10</xref></contrib><contrib contrib-type="author"><name><surname>Janco</surname><given-names>Ladislav</given-names></name><xref ref-type="aff" rid="Aff11">11</xref></contrib><contrib contrib-type="author"><name><surname>Chauhan</surname><given-names>Rohan</given-names></name><xref ref-type="aff" rid="Aff12">12</xref></contrib><contrib contrib-type="author"><name><surname>Romanowska-Dixon</surname><given-names>Bo&#x0017c;ena</given-names></name><xref ref-type="aff" rid="Aff13">13</xref></contrib><contrib contrib-type="author"><name><surname>Eremina</surname><given-names>Alena</given-names></name><xref ref-type="aff" rid="Aff14">14</xref></contrib><contrib contrib-type="author"><name><surname>Dusova</surname><given-names>Jaroslava</given-names></name><xref ref-type="aff" rid="Aff15">15</xref></contrib><contrib contrib-type="author"><name><surname>Sagong</surname><given-names>Min</given-names></name><xref ref-type="aff" rid="Aff16">16</xref></contrib><contrib contrib-type="author"><name><surname>Kim</surname><given-names>Sunghyun</given-names></name><xref ref-type="aff" rid="Aff17">17</xref></contrib><contrib contrib-type="author"><name><surname>Bae</surname><given-names>YunJu</given-names></name><xref ref-type="aff" rid="Aff17">17</xref></contrib><contrib contrib-type="author"><name><surname>Kim</surname><given-names>Suyoung</given-names></name><xref ref-type="aff" rid="Aff17">17</xref></contrib><contrib contrib-type="author"><name><surname>Bae</surname><given-names>Youngmin</given-names></name><xref ref-type="aff" rid="Aff17">17</xref></contrib><contrib contrib-type="author"><name><surname>Son</surname><given-names>Dain</given-names></name><xref ref-type="aff" rid="Aff17">17</xref></contrib><contrib contrib-type="author"><name><surname>Kang</surname><given-names>Hyejin</given-names></name><xref ref-type="aff" rid="Aff17">17</xref></contrib><contrib contrib-type="author"><name><surname>Choi</surname><given-names>Sujin</given-names></name><xref ref-type="aff" rid="Aff17">17</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Stanga</surname><given-names>Paulo-Eduardo</given-names></name><address><email>p.stanga@theretinacliniclondon.com</email></address><xref ref-type="aff" rid="Aff18">18</xref><xref ref-type="aff" rid="Aff19">19</xref></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/00j7qa995</institution-id><institution-id institution-id-type="GRID">grid.492921.5</institution-id><institution>Retina Consultants of Texas, </institution><institution>Retina Consultants of America, </institution></institution-wrap>Houston, TX USA </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01q9sj412</institution-id><institution-id institution-id-type="GRID">grid.411656.1</institution-id><institution-id institution-id-type="ISNI">0000 0004 0479 0855</institution-id><institution>Department of Ophthalmology, Inselspital, </institution><institution>Bern University Hospital, </institution></institution-wrap>Bern, Switzerland </aff><aff id="Aff3"><label>3</label>Department for BioMedical Research, Bern, Switzerland </aff><aff id="Aff4"><label>4</label>Ophthalmology Department, Faculty Hospital and Policlinic Zilina, Zilina, Slovakia </aff><aff id="Aff5"><label>5</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/04sg4ka71</institution-id><institution-id institution-id-type="GRID">grid.412819.7</institution-id><institution-id institution-id-type="ISNI">0000 0004 0611 1895</institution-id><institution>University Hospital Kr&#x000e1;lovsk&#x000e9; Vinohrady, </institution></institution-wrap>Prague, Czech Republic </aff><aff id="Aff6"><label>6</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/024d6js02</institution-id><institution-id institution-id-type="GRID">grid.4491.8</institution-id><institution-id institution-id-type="ISNI">0000 0004 1937 116X</institution-id><institution>Third Faculty of Medicine, </institution><institution>Charles University, </institution></institution-wrap>Prague, Czech Republic </aff><aff id="Aff7"><label>7</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01g9ty582</institution-id><institution-id institution-id-type="GRID">grid.11804.3c</institution-id><institution-id institution-id-type="ISNI">0000 0001 0942 9821</institution-id><institution>Department of Ophthalmology, </institution><institution>Semmelweis University, </institution></institution-wrap>Budapest, Hungary </aff><aff id="Aff8"><label>8</label>Shivam Retina Clinic and Eye Hospital, Surat, India </aff><aff id="Aff9"><label>9</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/021nb2v44</institution-id><institution-id institution-id-type="GRID">grid.413204.0</institution-id><institution-id institution-id-type="ISNI">0000 0004 1768 2335</institution-id><institution>Regional Institute of Ophthalmology, </institution></institution-wrap>Kolkata, India </aff><aff id="Aff10"><label>10</label>Centrum Zdrowia MDM, Warsaw, Poland </aff><aff id="Aff11"><label>11</label>II. Ocna Klinika SZU, F.D. Roosevelt Hospital, Banska Bystrica, Slovakia </aff><aff id="Aff12"><label>12</label>Rising Retina Clinic, Ahmedabad, India </aff><aff id="Aff13"><label>13</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/03bqmcz70</institution-id><institution-id institution-id-type="GRID">grid.5522.0</institution-id><institution-id institution-id-type="ISNI">0000 0001 2337 4740</institution-id><institution>University Hospital of Krak&#x000f3;w, </institution><institution>Jagiellonian University, </institution></institution-wrap>Krak&#x000f3;w, CM Poland </aff><aff id="Aff14"><label>14</label>Novosibirsk Branch of FBSI IRTC, Novosibirsk, Russia </aff><aff id="Aff15"><label>15</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/04wckhb82</institution-id><institution-id institution-id-type="GRID">grid.412539.8</institution-id><institution-id institution-id-type="ISNI">0000 0004 0609 2284</institution-id><institution>University Hospital Hradec Kr&#x000e1;lov&#x000e9;, </institution></institution-wrap>Hradec Kr&#x000e1;lov&#x000e9;, Czech Republic </aff><aff id="Aff16"><label>16</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05e6g0130</institution-id><institution-id institution-id-type="ISNI">0000 0004 0648 1052</institution-id><institution>Department of Ophthalmology, </institution><institution>Yeungnam University College of Medicine, </institution></institution-wrap>Daegu, Republic of Korea </aff><aff id="Aff17"><label>17</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/05k84m754</institution-id><institution-id institution-id-type="GRID">grid.459420.e</institution-id><institution-id institution-id-type="ISNI">0000 0004 4690 0995</institution-id><institution>Celltrion, Inc., </institution></institution-wrap>Incheon, Republic of Korea </aff><aff id="Aff18"><label>18</label>The Retina Clinic London, 24 Queen Anne Street, London, W1G 9AX UK </aff><aff id="Aff19"><label>19</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/02jx3x895</institution-id><institution-id institution-id-type="GRID">grid.83440.3b</institution-id><institution-id institution-id-type="ISNI">0000 0001 2190 1201</institution-id><institution>Institute of Ophthalmology, </institution><institution>University College London, </institution></institution-wrap>London, UK </aff></contrib-group><pub-date pub-type="epub"><day>29</day><month>8</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>29</day><month>8</month><year>2025</year></pub-date><pub-date pub-type="ppub"><month>11</month><year>2025</year></pub-date><volume>14</volume><issue>11</issue><fpage>2769</fpage><lpage>2783</lpage><history><date date-type="received"><day>16</day><month>4</month><year>2025</year></date><date date-type="accepted"><day>23</day><month>6</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbynclicense">https://creativecommons.org/licenses/by-nc/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial 4.0 International License, which permits any non-commercial use, sharing, adaptation, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if changes were made. The images or other third party material in this article are included in the article's Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article's Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc/4.0/">http://creativecommons.org/licenses/by-nc/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Introduction</title><p id="Par1">A 24-week phase 3 analysis previously demonstrated equivalent efficacy and comparable tolerability between candidate biosimilar CT-P42 and reference aflibercept in participants with diabetic macular edema. Here, we report long-term outcomes through week 52.</p></sec><sec><title>Methods</title><p id="Par2">This was a randomized, double-masked, active-controlled, phase 3 international trial, conducted at 83 study centers across Czech Republic, Estonia, Germany, Hungary, India, Latvia, Lithuania, Poland, Republic of Korea, Russia, Slovakia, Spain, and Ukraine. Adults (aged&#x02009;&#x02265;&#x02009;18 years) diagnosed with type 1 or 2 diabetes mellitus, with diabetic macular edema involving the center of the macula, were randomized (1:1) to receive CT-P42 or reference aflibercept (2&#x000a0;mg in 0.05 mL) by intravitreal injection every 4 weeks (five doses), then every 8 weeks (four doses), over a 52-week study period. Study data were collected from July 2021 to April 2023. Efficacy, safety, and immunogenicity of CT-P42 compared with reference aflibercept were evaluated until week 52.</p></sec><sec><title>Results</title><p id="Par3">Overall, 306 participants (CT-P42, 153; reference aflibercept, 153) completed the study through week 52. The primary efficacy endpoint of mean change from baseline in best corrected visual acuity through week 8 was reported previously. Improvements in best corrected visual acuity were maintained throughout and were similar between CT-P42 and reference aflibercept, with mean (standard deviation) change from baseline at week 52 of 12.1 (8.9) versus 11.1 (9.9) letters, respectively. Changes from baseline in central subfield thickness and other secondary efficacy endpoints as well as safety endpoints, including treatment-emergent adverse events and immunogenicity, were comparable between groups through week 52.</p></sec><sec><title>Conclusions</title><p id="Par4">Results through week 52 support the therapeutic equivalence between CT-P42 and reference aflibercept by demonstrating comparable long-term efficacy, safety, and immunogenicity.</p></sec><sec><title>Trial Registration</title><p id="Par5">ClinicalTrials.gov identifier: NCT04739306.</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1007/s40123-025-01197-w.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Aflibercept</kwd><kwd>Biosimilar</kwd><kwd>CT-P42</kwd><kwd>Diabetic macular edema</kwd><kwd>Efficacy</kwd><kwd>Safety</kwd></kwd-group><funding-group><award-group><funding-source><institution>Celltrion, Inc (Incheon, Republic of Korea)</institution></funding-source></award-group></funding-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; Springer Healthcare Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="d33e445"><title>Key Summary Points</title><p id="Par05">
<table-wrap id="Taba"><table frame="hsides" rules="groups"><tbody><tr><td align="left">
<bold><italic>Why carry out this study?</italic></bold>
</td></tr><tr><td align="left">Aflibercept, a monoclonal antibody that binds VEGF-A, VEGF-B, and PlGF, is approved for the treatment of diabetic macular edema.</td></tr><tr><td align="left">Targeted biological therapies improve clinical response but are costly, driving interest to developing more affordable biosimilar products.</td></tr><tr><td align="left">This study evaluated the long-term efficacy and safety of candidate biosimilar CT-P42 compared with reference aflibercept in patients with diabetic macular edema.</td></tr><tr><td align="left">
<bold><italic>What was learned from the study?</italic></bold>
</td></tr><tr><td align="left">In patients with diabetic macular edema, the efficacy and safety of CT-P42 were comparable to originator aflibercept up to week 52.</td></tr><tr><td align="left">Changes from baseline in central subfield thickness were comparable between CT-P42 and originator aflibercept through week 52.</td></tr><tr><td align="left">No notable issues or increased immunogenicity were observed in patients receiving CT-P42 compared to the originator aflibercept.</td></tr></tbody></table></table-wrap>
</p></sec><sec id="Sec1"><title>Introduction</title><p id="Par15">Diabetes mellitus (DM)-induced hyperglycemia causes widespread vascular damage [<xref ref-type="bibr" rid="CR1">1</xref>], with the retinal capillaries particularly susceptible. This damage can lead to capillary non-perfusion, ischemia, and the production of vasoactive cytokines including hypoxia-inducible factor, vascular endothelial growth factor (VEGF), erythropoietin, and placental growth factor (PlGF) [<xref ref-type="bibr" rid="CR1">1</xref>, <xref ref-type="bibr" rid="CR2">2</xref>]. These cytokines are responsible for the sight-threatening complications of proliferative diabetic retinopathy and diabetic macular edema (DME) [<xref ref-type="bibr" rid="CR3">3</xref>]. VEGF overexpression is a key factor in the pathophysiology of DME, by increasing retinal vascular permeability, resulting in the accumulation of extracellular fluid in the macula [<xref ref-type="bibr" rid="CR1">1</xref>&#x02013;<xref ref-type="bibr" rid="CR4">4</xref>].</p><p id="Par16">Aflibercept is a high-affinity recombinant fusion protein that binds VEGF-A, VEGF-B, and PlGF, promoting regression of proliferative diabetic retinopathy and alleviating DME [<xref ref-type="bibr" rid="CR5">5</xref>, <xref ref-type="bibr" rid="CR6">6</xref>]. Aflibercept, administered via intravitreal (IVT) injection, is approved by the European Medicines Agency (EMA) and the US Food and Drug Administration (FDA) for the treatment of DME [<xref ref-type="bibr" rid="CR7">7</xref>, <xref ref-type="bibr" rid="CR8">8</xref>]. Based on phase 3 clinical trials and real-world evidence studies, aflibercept is recommended as first-line therapy for patients presenting with severe macular edema [<xref ref-type="bibr" rid="CR6">6</xref>, <xref ref-type="bibr" rid="CR9">9</xref>&#x02013;<xref ref-type="bibr" rid="CR15">15</xref>].</p><p id="Par17">Given the chronic nature of DME, effective management demands ongoing treatment, which can impose a considerable financial strain on patients as well as healthcare systems [<xref ref-type="bibr" rid="CR16">16</xref>, <xref ref-type="bibr" rid="CR17">17</xref>]. While IVT VEGF-targeting therapy is broadly prescribed in high-income settings [<xref ref-type="bibr" rid="CR18">18</xref>], cost limits its use in low- or intermediate-income settings, despite DME potentially being more prevalent in these areas [<xref ref-type="bibr" rid="CR18">18</xref>&#x02013;<xref ref-type="bibr" rid="CR21">21</xref>]. As the prevalence of DME secondary to DM continues to rise globally, alternative, more affordable treatment options are needed [<xref ref-type="bibr" rid="CR21">21</xref>, <xref ref-type="bibr" rid="CR22">22</xref>]. Aflibercept biosimilars, recently approved by the FDA [<xref ref-type="bibr" rid="CR23">23</xref>, <xref ref-type="bibr" rid="CR24">24</xref>], offer a sustainable, cost-reducing solution for long-term DME management [<xref ref-type="bibr" rid="CR25">25</xref>].</p><p id="Par18">CT-P42, a candidate biosimilar of aflibercept, has received regulatory approval in several countries, including approval from the EMA [<xref ref-type="bibr" rid="CR26">26</xref>&#x02013;<xref ref-type="bibr" rid="CR28">28</xref>]. Findings have been reported through week 24 of an active-controlled, phase 3 trial comparing CT-P42 with European Union-approved reference aflibercept (&#x0201c;reference aflibercept&#x0201d;) (both given at a dose of 2 mg in 0.05&#x000a0;mL) in adults with DME [<xref ref-type="bibr" rid="CR29">29</xref>]. CT-P42 demonstrated equivalence to reference aflibercept in terms of the primary study endpoint: mean change from baseline to week 8 in best corrected visual acuity (BCVA) [<xref ref-type="bibr" rid="CR29">29</xref>]. It also demonstrated similar efficacy to reference aflibercept across many secondary study efficacy endpoints and had a comparable safety and immunogenicity profile through week 24 [<xref ref-type="bibr" rid="CR29">29</xref>]. Here, we report the 1-year (52-week) efficacy, safety, and immunogenicity findings of the phase 3 study.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>Study Design</title><p id="Par19">This 52-week, randomized, active-controlled, double-masked phase 3 study (NCT04739306) [<xref ref-type="bibr" rid="CR28">28</xref>] compared the efficacy and safety of CT-P42 with reference aflibercept. The full study design, masking, and randomization processes were as reported previously [<xref ref-type="bibr" rid="CR29">29</xref>].</p><p id="Par20">The study was performed in accordance with Good Clinical Practice, the principles of the Declaration of Helsinki, and relevant country-specific regulatory requirements. Independent ethics committees and institutional review boards at each site prospectively approved the study materials (Table <xref rid="MOESM1" ref-type="media">S1</xref> in Supplementary Material), and all patients provided written, informed consent for study participation.</p></sec><sec id="Sec4"><title>Patients</title><p id="Par21">Full inclusion and exclusion criteria have been reported previously [<xref ref-type="bibr" rid="CR29">29</xref>]. Briefly, eligible patients (&#x02265;&#x02009;18 years of age) had either type 1 or 2 DM, plus DME (secondary to DM) that involved the center of the macula. One eye was selected as the &#x0201c;study eye&#x0201d; for each eligible patient, and it was required to have a central subfield thickness (CST) of&#x02009;&#x02265;&#x02009;350&#x000a0;&#x000b5;m, as determined by optical coherence tomography (OCT) during screening. Additionally, a BCVA score of 73&#x02013;34 letters in the study eye, measured using the Early Treatment of Diabetic Retinopathy Study (ETDRS) chart (approximate Snellen equivalent of 20/40 to 20/200), was required from patients at both screening and day 1.</p><p id="Par22">Key exclusion criteria included patients with one functional eye, prior or ongoing treatment with aflibercept or potential biosimilars, prior treatment with ocular antiangiogenic agents in the study eye, and prior treatment of the fellow eye with systemic and/or ocular antiangiogenic agents within 180 days prior to receiving the first dose of the study drug.</p></sec><sec id="Sec5"><title>Study Endpoints and Assessments</title><p id="Par23">Efficacy endpoints were assessed throughout the 52-week study period and included mean change from baseline in BCVA, proportion of patients who gained or lost&#x02009;&#x02265;&#x02009;5,&#x02009;&#x02265;&#x02009;10, and&#x02009;&#x02265;&#x02009;15 ETDRS letters from baseline in BCVA, mean change from baseline in CST, and percentage of patients with a&#x02009;&#x02265;&#x02009;2-step improvement from baseline in the ETDRS Diabetic Retinopathy Severity Scale (DRSS) score as assessed by fundus photography (FP).</p><p id="Par24">Throughout the study, safety assessments were conducted including monitoring of treatment-emergent adverse events (TEAEs). TEAEs of special interest included arterial thromboembolic events (ATEs), based on the definition from the Antiplatelet Trialists&#x02019; Collaboration [<xref ref-type="bibr" rid="CR30">30</xref>], and TEAEs related to the IVT injection procedure. Immunogenicity assessments (antidrug antibody [ADA] and neutralizing antibody [NAb] testing) were carried out at day 1 and weeks 8, 16, 24, and 52.</p></sec><sec id="Sec6"><title>Statistical Assessments</title><p id="Par25">Sample size calculations and statistical analyses, including those for the primary study efficacy endpoint, were published previously [<xref ref-type="bibr" rid="CR29">29</xref>]. In brief, the full analysis set, defined as all patients who were randomly assigned and received at least one full dose of study drug during the main study period, was the primary analysis set for efficacy endpoint analyses. Safety was evaluated in the safety set, defined as all randomly assigned patients who received at least one full or partial dose of study drug in the main study period. Continuous data were summarized using the descriptive statistics of number of patients, mean, standard deviation (SD), minimum, median, and maximum, unless otherwise specified. Categorical data were summarized using frequency tables showing numbers and percentages of patients. Statistical analyses were performed using SAS 9.4 (SAS Institute Inc., Cary, NC, USA).</p></sec></sec><sec id="Sec7"><title>Results</title><sec id="Sec8"><title>Patient Disposition and Baseline Characteristics</title><p id="Par26">The first patient was randomized on July 22, 2021, and the end-of-study visit for the last patient was on April 24, 2023. Patient disposition is presented in Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>. In total, 484 patients were screened, 348 of whom were randomized to treatment (CT-P42, 173; reference aflibercept, 175). Of these, 306 (87.9%) patients completed the main 52-week study period (CT-P42, 153 [88.4%]; reference aflibercept, 153&#x000a0;[87.4%]). Twenty (11.6%) patients in the CT-P42 group and 22 (12.6%) patients in the reference aflibercept group discontinued participation in the study, with the primary reason being withdrawal by the patient (CT-P42, 8 [4.6%]; reference aflibercept, 6 [3.4%]). For patients who discontinued participation in the study early, the median (range) time on the study was 174.5 (27&#x02013;344) days in the CT-P42 group, and 136.5 (1&#x02013;359) days in the reference aflibercept group. Patient demographics and baseline characteristics, including mean baseline BCVA and mean baseline CST, were generally well balanced between the groups (Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>).<fig id="Fig1"><label>Fig.&#x000a0;1</label><caption><p>Summary of patient disposition. This figure was published in <italic>Ophthalmology Retina</italic>, S2468&#x02013;6530(24)00306&#x02013;3, Copyright Elsevier (2024). <italic>AE</italic> adverse event. CT-P42 and reference aflibercept were both administered at a dose of 2 mg. <sup>a</sup>Two patients (one in the CT-P42 group and one in the reference aflibercept group) were discontinued from the study since they were unable to attend visits due to the ongoing conflict in Ukraine</p></caption><graphic xlink:href="40123_2025_1197_Fig1_HTML" id="MO1"/></fig><table-wrap id="Tab1"><label>Table&#x000a0;1</label><caption><p>Baseline patient demographics and characteristics (intent-to-treat set)</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">CT-P42 (<italic>n</italic>&#x02009;=&#x02009;173)</th><th align="left">Reference aflibercept (<italic>n</italic>&#x02009;=&#x02009;175)</th></tr></thead><tbody><tr><td align="left">Age, median (range), years</td><td align="left">63.0 (32&#x02013;85)</td><td align="left">63.0 (25&#x02013;86)</td></tr><tr><td align="left" colspan="3">Sex, no. (%)</td></tr><tr><td align="left">&#x000a0;Female</td><td align="left">67 (38.7)</td><td align="left">78 (44.6)</td></tr><tr><td align="left">&#x000a0;Male</td><td align="left">106 (61.3)</td><td align="left">97 (55.4)</td></tr><tr><td align="left" colspan="3">Race, no. (%)</td></tr><tr><td align="left">&#x000a0;Asian</td><td align="left">61 (35.3)</td><td align="left">63 (36.0)</td></tr><tr><td align="left">&#x000a0;White</td><td align="left">112 (64.7)</td><td align="left">112 (64.0)</td></tr><tr><td align="left" colspan="3">Type of DM, no. (%)</td></tr><tr><td align="left">&#x000a0;Type 1</td><td align="left">14 (8.1)</td><td align="left">10 (5.7)</td></tr><tr><td align="left">&#x000a0;Type 2</td><td align="left">159 (91.9)</td><td align="left">165 (94.3)</td></tr><tr><td align="left" colspan="3">Baseline HbA1c, no. (%)<sup>a</sup></td></tr><tr><td align="left">&#x000a0;&#x02009;&#x02264;&#x02009;8%</td><td align="left">113 (65.3)</td><td align="left">116 (66.3)</td></tr><tr><td align="left">&#x000a0;&#x02009;&#x0003e;&#x02009;8%</td><td align="left">60 (34.7)</td><td align="left">57 (32.6)</td></tr><tr><td align="left">Baseline BCVA score, mean (SD)<sup>b</sup></td><td align="left">60.3 (9.7)</td><td align="left">60.4 (10.1)</td></tr><tr><td align="left" colspan="3">BCVA score using ETDRS chart on day 1, no. (%)<sup>b</sup></td></tr><tr><td align="left">&#x000a0;&#x02009;&#x0003c;&#x02009;55</td><td align="left">49 (28.3)</td><td align="left">46 (26.3)</td></tr><tr><td align="left">&#x000a0;&#x02009;&#x02265;&#x02009;55</td><td align="left">124 (71.7)</td><td align="left">129 (73.7)</td></tr><tr><td align="left" colspan="3">ETDRS DRSS score at baseline, no. (%)<sup>b</sup></td></tr><tr><td align="left">&#x000a0;10</td><td align="left">1 (0.6)</td><td align="left">2 (1.1)</td></tr><tr><td align="left">&#x000a0;20</td><td align="left">3 (1.7)</td><td align="left">1 (0.6)</td></tr><tr><td align="left">&#x000a0;35</td><td align="left">58 (33.5)</td><td align="left">60 (34.3)</td></tr><tr><td align="left">&#x000a0;43</td><td align="left">48 (27.7)</td><td align="left">48 (27.4)</td></tr><tr><td align="left">&#x000a0;47</td><td align="left">25 (14.5)</td><td align="left">21 (12.0)</td></tr><tr><td align="left">&#x000a0;53</td><td align="left">16 (9.2)</td><td align="left">18 (10.3)</td></tr><tr><td align="left">&#x000a0;61</td><td align="left">7 (4.0)</td><td align="left">5 (2.9)</td></tr><tr><td align="left">&#x000a0;65</td><td align="left">3 (1.7)</td><td align="left">4 (2.3)</td></tr><tr><td align="left">&#x000a0;71</td><td align="left">1 (0.6)</td><td align="left">5 (2.9)</td></tr><tr><td align="left">&#x000a0;75</td><td align="left">0</td><td align="left">0</td></tr><tr><td align="left">&#x000a0;81</td><td align="left">0</td><td align="left">0</td></tr><tr><td align="left">&#x000a0;85</td><td align="left">0</td><td align="left">0</td></tr><tr><td align="left">&#x000a0;90</td><td align="left">11 (6.4)</td><td align="left">11 (6.3)</td></tr><tr><td align="left">CST at baseline, mean (SD), &#x003bc;m<sup>b</sup></td><td align="left">499.3 (138.0)</td><td align="left">483.7 (111.5)</td></tr><tr><td align="left">Patients with subretinal fluid within 500 &#x003bc;m of the macular center at baseline, no. (%)<sup>b</sup></td><td align="left">82 (47.4)</td><td align="left">63 (36.0)</td></tr></tbody></table><table-wrap-foot><p>Intent-to-treat set was defined as all patients randomly assigned to receive either study drug, regardless of whether any study drug was administered</p><p><italic>BCVA</italic> best corrected visual acuity, <italic>CST</italic> central subfield thickness, <italic>DM</italic> diabetes mellitus, <italic>DRSS</italic> Diabetic Retinopathy Severity Scale, <italic>ETDRS</italic> Early Treatment of Diabetic Retinopathy Study, <italic>HbA1c</italic> hemoglobin A1c, <italic>SD</italic> standard deviation</p><p><sup>a</sup>Local laboratory data were used for two patients, due to the ongoing conflict in Ukraine (recorded as a protocol deviation)</p><p><sup>b</sup>Values are for the study eye</p></table-wrap-foot></table-wrap></p></sec><sec id="Sec9"><title>Efficacy</title><p id="Par27">In terms of secondary efficacy endpoints, the mean change in BCVA from baseline to week 52 across all post-baseline visits was generally consistent between treatment groups. The improvement observed in both groups from week 1 to week 16 was maintained through week 52, with a mean (SD) change from baseline at week 52 of 12.1 (8.9) letters for CT-P42 and 11.1 (9.9) letters for reference aflibercept (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>a). The proportions of patients gaining or losing&#x02009;&#x02265;&#x02009;5,&#x02009;&#x02265;&#x02009;10, and&#x02009;&#x02265;&#x02009;15 ETDRS letters from baseline to week 52 in BCVA across all post-baseline visits were similar between treatment groups (Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>b, c). Overall, the mean change from baseline in CST during the main study period was numerically greater in the CT-P42 group than in the reference aflibercept group, but the difference was not clinically significant (Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>a). A comparable increase in the proportion of patients with a&#x02009;&#x02265;&#x02009;2-step improvement in ETDRS DRSS score was observed between the 2 treatment groups at week 52 (41 [23.7%] and 38 [21.7%] patients in the CT-P42 and reference aflibercept groups, respectively; Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>b).<fig id="Fig2"><label>Fig.&#x000a0;2</label><caption><p>Secondary efficacy endpoints (full analysis set)&#x02014;1 of 2. <bold>a</bold> Change from baseline in BCVA through week 52, assessed using the ETDRS chart, and proportion of patients who <bold>b</bold> gained or <bold>c</bold> lost&#x02009;&#x02265;&#x02009;5,&#x02009;&#x02265;&#x02009;10, or&#x02009;&#x02265;&#x02009;15 ETDRS letters from baseline. The full analysis set was defined as all patients who were randomly assigned and received&#x02009;&#x02265;&#x02009;1 full dose of study drug during the main study period. CT-P42 and reference aflibercept were both administered at a dose of 2 mg. Data are mean&#x02009;&#x000b1;&#x02009;SD. <italic>BCVA</italic> best corrected visual acuity, <italic>ETDRS</italic> Early Treatment of Diabetic Retinopathy Study, <italic>SD</italic> standard deviation</p></caption><graphic xlink:href="40123_2025_1197_Fig2_HTML" id="MO2"/></fig><fig id="Fig3"><label>Fig.&#x000a0;3</label><caption><p>Secondary efficacy endpoints (full analysis set)&#x02014;2 of 2. <bold>a</bold> Change from baseline in CST, assessed by OCT, through week 52, and <bold>b</bold> proportion of patients with a&#x02009;&#x02265;&#x02009;2-step improvement from baseline in ETDRS DRSS score, assessed by FP. The full analysis set was defined as all patients who were randomly assigned and received&#x02009;&#x02265;&#x02009;1 full dose of study drug during the main study period. <italic>CST</italic> central subfield thickness, <italic>DRSS</italic> Diabetic Retinopathy Severity Scale, <italic>ETDRS</italic> Early Treatment of Diabetic Retinopathy Study, <italic>FP</italic> fundus photography, <italic>OCT</italic> optical coherence tomography, <italic>SD</italic> standard deviation</p></caption><graphic xlink:href="40123_2025_1197_Fig3_HTML" id="MO3"/></fig></p></sec><sec id="Sec10"><title>Safety</title><p id="Par28">The proportion of patients who experienced&#x02009;&#x02265;&#x02009;1 TEAE was similar between treatment groups, at 109 (62.6%) and 117 (67.2%) patients in the CT-P42 and the reference aflibercept groups, respectively. The majority of TEAEs were grade 1&#x02013;2 (mild-to-moderate) in intensity.</p><p id="Par29">The proportion of patients with&#x02009;&#x02265;&#x02009;1 ocular TEAE in the study eye was comparable between treatment groups (CT-P42, 31 [17.8%] patients; reference aflibercept, 38&#x000a0;[21.8%] patients; Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). The most frequently reported ocular TEAE that occurred in the study eye was intraocular pressure increased (CT-P42, 3 [1.7%] patients; reference aflibercept, 4 [2.3%] patients), followed by conjunctival hemorrhage (CT-P42, 2 [1.1%] patients; reference aflibercept, 4 [2.3%] patients; Table <xref rid="MOESM1" ref-type="media">S2</xref> in Supplementary Material). Ocular TEAEs in the study eye, which investigators considered to be related to the study drug, occurred in seven&#x000a0;(4.0%) and four (2.3%) patients in the CT-P42 and reference aflibercept groups, respectively (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). Adverse events of intraocular inflammation in the study eye were reported by one (0.6%) patient in the CT-P42 group (iridocyclitis) and two (1.1%) patients in the reference aflibercept group (one event each of iritis and ulcerative keratitis) (Table <xref rid="MOESM1" ref-type="media">S2</xref> in Supplementary Material).<table-wrap id="Tab2"><label>Table&#x000a0;2</label><caption><p>Summary of safety outcomes (safety set)</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left">CT-P42 (<italic>n</italic>&#x02009;=&#x02009;174)<sup>a</sup></th><th align="left">Reference aflibercept (<italic>n</italic>&#x02009;=&#x02009;174)<sup>a</sup></th></tr></thead><tbody><tr><td align="left">TEAEs, no.</td><td align="left">269</td><td align="left">318</td></tr><tr><td align="left">Non-ocular TEAEs, no.</td><td align="left">178</td><td align="left">214</td></tr><tr><td align="left">&#x000a0;Patients with&#x02009;&#x02265;&#x02009;1 non-ocular TEAE, no. (%)</td><td align="left">86 (49.4)</td><td align="left">93 (53.4)</td></tr><tr><td align="left">&#x000a0;Patients with&#x02009;&#x02265;&#x02009;1 non-ocular TEAE related to study drug, no. (%)</td><td align="left">1 (0.6)</td><td align="left">3 (1.7)</td></tr><tr><td align="left">Ocular TEAEs in the study eye, no.</td><td align="left">48</td><td align="left">61</td></tr><tr><td align="left">&#x000a0;Patients with&#x02009;&#x02265;&#x02009;1 ocular TEAE in the study eye, no. (%)</td><td align="left">31 (17.8)</td><td align="left">38 (21.8)</td></tr><tr><td align="left">&#x000a0;Patients with&#x02009;&#x02265;&#x02009;1 ocular TEAE related to study drug, no. (%)</td><td align="left">7 (4.0)</td><td align="left">4 (2.3)</td></tr><tr><td align="left">TESAEs, no.</td><td align="left">24</td><td align="left">28</td></tr><tr><td align="left">&#x000a0;Patients with&#x02009;&#x02265;&#x02009;1 TESAE, no. (%)</td><td align="left">19 (10.9)</td><td align="left">17 (9.8)</td></tr><tr><td align="left">&#x000a0;Patients with&#x02009;&#x02265;&#x02009;1 TESAE related to study drug, no. (%)</td><td align="left">1 (0.6)</td><td align="left">1 (0.6)</td></tr><tr><td align="left" colspan="3">TEAEs of special interest</td></tr><tr><td align="left">&#x000a0;Patients with&#x02009;&#x02265;&#x02009;1 TEAE classified as arterial thromboembolic event, no. (%)</td><td align="left">8 (4.6)</td><td align="left">8 (4.6)</td></tr><tr><td align="left">&#x000a0;Ocular events affecting study eye, no. (%)</td><td align="left">0</td><td align="left">0</td></tr><tr><td align="left">&#x000a0;Non-ocular events, no. (%)</td><td align="left">8 (4.6)</td><td align="left">8 (4.6)</td></tr><tr><td align="left">&#x000a0;Patients with&#x02009;&#x02265;&#x02009;1 TEAE related to injection procedure, no. (%)</td><td align="left">7 (4.0)</td><td align="left">16 (9.2)</td></tr><tr><td align="left">&#x000a0;Ocular events affecting study eye, no. (%)</td><td align="left">7 (4.0)</td><td align="left">15 (8.6)</td></tr><tr><td align="left">&#x000a0;Non-ocular events, no. (%)</td><td align="left">0</td><td align="left">1 (0.6)</td></tr><tr><td align="left" colspan="3">TEAEs leading to study drug discontinuation</td></tr><tr><td align="left">&#x000a0;Patients with&#x02009;&#x02265;&#x02009;1 TEAE leading to study discontinuation, no. (%)</td><td align="left">6 (3.4)</td><td align="left">6 (3.4)</td></tr><tr><td align="left">&#x000a0;Ocular events affecting study eye, no. (%)</td><td align="left">1 (0.6)</td><td align="left">1 (0.6)</td></tr><tr><td align="left">&#x000a0;Non-ocular events, no. (%)</td><td align="left">5 (2.9)</td><td align="left">5 (2.9)</td></tr></tbody></table><table-wrap-foot><p>The safety set was defined as all randomly assigned patients who received at least one full or partial dose of study drug in the main study period</p><p><italic>TEAE</italic> treatment-emergent adverse event, <italic>TESAE</italic> treatment-emergent serious adverse event</p><p>CT-P42 and reference aflibercept were both administered at a dose of 2 mg</p><p><sup>a</sup>One patient in the reference aflibercept group was administered CT-P42 during the trial and was therefore included in the CT-P42 safety set</p></table-wrap-foot></table-wrap></p><p id="Par30">The proportion of patients experiencing non-ocular TEAEs was comparable between groups (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). Similar proportions of patients experienced&#x02009;&#x02265;&#x02009;1 treatment-emergent serious adverse event (TESAE) in each treatment group (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). All TESAEs were non-ocular, and the majority were grade 3 (severe) in intensity. Two TESAEs were considered to be related to the study drug: one severe case of myocardial infarction in the CT-P42 group and one severe case of ischemic stroke in the reference aflibercept group.</p><p id="Par31">Eight (4.6%) patients in each group experienced at least one TEAE of special interest, classified as ATE (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). TEAEs relating to IVT injection were reported by seven (4.0%) patients in the CT-P42 group and 16 (9.2%) patients in the reference aflibercept group.</p><p id="Par32">Six (3.4%) patients in each group experienced TEAEs that led to study discontinuation (Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>). Of the 12 patients who discontinued due to TEAEs, five&#x000a0;(1.4%) had TEAEs that led to death during the study (Table <xref rid="MOESM1" ref-type="media">S2</xref> in Supplementary Material).</p></sec><sec id="Sec11"><title>Immunogenicity</title><p id="Par33">During the study period, incidence of treatment-induced ADAs was low (0.9&#x02013;1.4% at each post-treatment visit) and comparable between treatment groups. The proportion of patients reporting&#x02009;&#x02265;&#x02009;1 positive ADA result after the first study drug administration was similar between treatment groups (CT-P42, 3 [1.7%]; reference aflibercept, four&#x000a0;[2.3%]). All ADA titers of ADA-positive patients were 50 (the minimum required dilution), except for one patient in the reference aflibercept group. Two (1.1%) patients in each treatment group had NAb-positive results at post-treatment visits.</p></sec></sec><sec id="Sec12"><title>Discussion</title><p id="Par34">This phase 3, 52-week long-term study demonstrated comparable efficacy, safety, and immunogenicity of CT-P42 and reference aflibercept in patients with DME, reinforcing the therapeutic equivalence demonstrated at the primary study endpoint [<xref ref-type="bibr" rid="CR29">29</xref>].</p><p id="Par35">The mean change from baseline in BCVA increased at all visits through week 16 and was maintained through week 52 in both treatment groups. The total magnitude of visual improvement (mean change from baseline in BCVA letters at week 52) and proportions of patients who gained &#x02265; 15 ETDRS letters at week 52 were similar between CT-P42 and reference aflibercept, and with those reported in other trials of reference aflibercept [<xref ref-type="bibr" rid="CR6">6</xref>, <xref ref-type="bibr" rid="CR11">11</xref>, <xref ref-type="bibr" rid="CR31">31</xref>].</p><p id="Par36">In the current treatment landscape for DME, anti-VEGF therapies have demonstrated improvements in BCVA by week 52, as reported in key clinical trials [<xref ref-type="bibr" rid="CR31">31</xref>&#x02013;<xref ref-type="bibr" rid="CR34">34</xref>], including gains of 10.5 and 9.4 letters for reference aflibercept in the KESTREL and KITE studies, respectively [<xref ref-type="bibr" rid="CR31">31</xref>]. While the INSIGHT trial did not explicitly report week 52 BCVA results for reference aflibercept, graphical data on visual acuity letter scores suggest that the improvements were within a similar range to those observed in other trials [<xref ref-type="bibr" rid="CR32">32</xref>].</p><p id="Par37">Similarly, the proportion of patients who gained&#x02009;&#x02265;&#x02009;15 letters from baseline in BCVA with CT-P42 (34.7%) was aligned with outcomes reported for reference aflibercept in the KESTREL (39.0%) and KITE (37.6%) studies [<xref ref-type="bibr" rid="CR31">31</xref>], as well as in the INSIGHT trial (37.2%) [<xref ref-type="bibr" rid="CR32">32</xref>]. Additionally, the proportion of patients achieving a&#x02009;&#x02265;&#x02009;2-step improvement in the ETDRS DRSS score was comparable between CT-P42 (23.7%) and reference aflibercept in the KESTREL study (21.7%) [<xref ref-type="bibr" rid="CR31">31</xref>]. These results suggest that CT-P42 offers clinical outcomes comparable to those of other approved anti-VEGF therapies [<xref ref-type="bibr" rid="CR31">31</xref>, <xref ref-type="bibr" rid="CR32">32</xref>, <xref ref-type="bibr" rid="CR34">34</xref>].</p><p id="Par38">Patients in the CT-P42 group experienced a slightly greater mean decrease from baseline in CST, but this difference could be driven by unbalanced baseline CST and the presence of subretinal fluid at baseline [<xref ref-type="bibr" rid="CR35">35</xref>, <xref ref-type="bibr" rid="CR36">36</xref>]. More patients with severe edema (baseline CST&#x02009;&#x02265;&#x02009;700&#x000a0;&#x003bc;m) were enrolled in the CT-P42 group than in the reference aflibercept group (18/172 [10.5%] vs. 6/174 [3.4%]). Moreover, given the presence of subretinal fluid within 500 &#x000b5;m of the macular center at baseline (present in 82 [47.4%] and 63 [36.0%] patients in the CT-P42 and reference aflibercept groups, respectively) [<xref ref-type="bibr" rid="CR29">29</xref>], patients treated with CT-P42 may have been more prone to experiencing a larger reduction in CST than patients in the reference aflibercept group [<xref ref-type="bibr" rid="CR36">36</xref>].</p><p id="Par39">Over the 52-week study period, CT-P42 was well tolerated, with a comparable safety profile to that of reference aflibercept [<xref ref-type="bibr" rid="CR8">8</xref>]. Rates of ocular TEAEs, TEAEs of special interest, and immunogenicity were low and mirrored those from reference aflibercept trials [<xref ref-type="bibr" rid="CR6">6</xref>, <xref ref-type="bibr" rid="CR9">9</xref>&#x02013;<xref ref-type="bibr" rid="CR11">11</xref>, <xref ref-type="bibr" rid="CR31">31</xref>, <xref ref-type="bibr" rid="CR37">37</xref>].</p><p id="Par40">As was the case through 24 weeks, immunogenicity was low and comparable between the two treatment groups, and the majority of patients had negative ADA results throughout the 52-week period. Of note, both CT-P42 and reference aflibercept are fully human sequence proteins [<xref ref-type="bibr" rid="CR38">38</xref>, <xref ref-type="bibr" rid="CR39">39</xref>], and hence are designed to be inherently less immunogenic than other available DME therapies such as bevacizumab, ranibizumab, brolucizumab, and faricimab, which are derivatives of humanized protein sequences [<xref ref-type="bibr" rid="CR40">40</xref>, <xref ref-type="bibr" rid="CR41">41</xref>].</p><p id="Par41">The strengths of this clinical trial include the robust randomized, controlled, masked design, and the use of well-established endpoints to assess efficacy, safety, and immunogenicity. These trial results should reassure clinicians that intravitreal treatment with CT-P42 will provide similar safety and efficacy to reference aflibercept.</p><p id="Par42">The present study did not address switching between reference and biosimilar treatment. This might be perceived as a limitation but, given the growing evidence that there are no issues with switching between biologics and biosimilars, such studies are often not required by regulators and can be challenging to conduct [<xref ref-type="bibr" rid="CR42">42</xref>, <xref ref-type="bibr" rid="CR43">43</xref>].</p><p id="Par43">The approval and adoption of biosimilars in oncology and other fields has led to substantial overall cost savings for healthcare systems that may otherwise have been negatively affected by the high costs of originator biologic drug products [<xref ref-type="bibr" rid="CR44">44</xref>]. Biosimilars account for 20% of the treatment volume in some accessible biologics markets and have generated enormous savings from the reduced list and net prices of the originator medicines [<xref ref-type="bibr" rid="CR44">44</xref>]. Biosimilars are expected to generate cumulative savings of $285 billion US dollars globally by 2025 [<xref ref-type="bibr" rid="CR45">45</xref>], and it is hoped that the adoption of CT-P42 will lead to proportionate cost savings in the management of DME. Our results, therefore, add to the growing volume of supportive literature confirming that biosimilars such as CT-P42 offer a critical opportunity to address barriers to treatment access, especially in developing countries where socioeconomic factors including high costs and disparities in reimbursement policies may result in lack of access and/or treatment discontinuation [<xref ref-type="bibr" rid="CR19">19</xref>, <xref ref-type="bibr" rid="CR25">25</xref>].</p></sec><sec id="Sec13"><title>Conclusions</title><p id="Par44">The final results of this study suggest therapeutic equivalence between CT-P42 (2&#x000a0;mg in 0.05 mL) and reference aflibercept, with similar safety and tolerability profiles observed in patients with DME at week 8. The week 52 data further support the consistency of these outcomes over time.</p></sec><sec id="Sec14" sec-type="supplementary-material"><title>Supplementary Information</title><p>Below is the link to the electronic supplementary material.<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="40123_2025_1197_MOESM1_ESM.pdf"><caption><p>Supplementary file1 (PDF 197 KB)</p></caption></media></supplementary-material></p></sec></body><back><fn-group><fn><p><bold>Previous Presentation</bold> Selected data from these analyses were presented at the 2023 Annual Meeting of the Association for Research in Vision and Ophthalmology (ARVO; May 5&#x02013;9, 2024; Seattle, Washington) and the Annual Meeting of the European Society of Retina Specialists (EURETINA; September 19&#x02013;22, 2024; Barcelona, Spain).</p></fn></fn-group><ack><title>Acknowledgements</title><sec id="d33e1366"><title>Medical Writing/Editorial Assistance</title><p>We are grateful to all patients and investigators who were involved in the study. Medical writing support, which included creating a draft outline, refining subsequent drafts in collaboration with the authors, gathering author comments, copyediting, fact checking, and managing references, was provided by Samantha Booth at Aspire Scientific Limited (Bollington, UK). Funding for medical writing support for this article was provided by Celltrion, Inc. (Incheon, Republic of Korea).</p></sec></ack><notes notes-type="author-contribution"><title>Author Contributions</title><p>Paulo-Eduardo Stanga had full access to all of the data in the study and takes responsibility for the integrity of the data and the accuracy of the data analysis. <italic>Concept and design:</italic> David M. Brown, Sebastian Wolf, Sunghyun Kim, YunJu Bae, Suyoung Kim, Youngmin Bae, Dain Son, Hyejin Kang, Sujin Choi, Paulo-Eduardo Stanga. <italic>Acquisition, analysis, or interpretation:</italic> Milan Veselovsky, Miroslav Veith, Andras Papp, Shobhana Mange, Lakshmi Kanta Mondal, Dominika Romanczak, Ladislav Janco, Rohan Chauhan, Bo&#x0017c;ena Romanowska-Dixon, Alena Eremina, Jaroslava Dusova, Min Sagong, Sunghyun Kim, YunJu Bae, Suyoung Kim, Youngmin Bae, Dain Son, Hyejin Kang, Sujin Choi. <italic>Drafting of the manuscript:</italic> All authors. <italic>Critical review of the manuscript for important intellectual content:</italic> All authors. <italic>Statistical analysis:</italic> Hyejin Kang, Sujin Choi.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>Planning, conduct, and analysis of the study and preparation of manuscript were funded by Celltrion, Inc. (Incheon, Republic of Korea). The sponsor is funding the journal&#x02019;s Rapid Service Fee and Open Access Fees.</p></notes><notes notes-type="data-availability"><title>Data Availability</title><p>The datasets generated during and/or analyzed during the current study are not publicly available because CT-P42 is currently under regulatory approval review, and the research data are confidential at the time of writing.</p></notes><notes><title>Declarations</title><notes id="FPar1" notes-type="COI-statement"><title>Conflict of Interest</title><p id="Par45">David M. Brown reports consultancy fees/honoraria from AbbVie, Alexion, Annexon, Apellis, Bayer, Biogen, Boehringer Ingelheim, Celltrion, Clearside, Heidelberg, Kodiak, Kowa, Merit, Novartis, Ocular Therapeutix, Ocuphire, OPTOS, Ray Therapeutics, Regeneron, RetinAI, Samsung Bioepis, SciNeuro, Senju, Stealth, THEA, Topcon, Voiant, and Xequel; institutional research grants from AffaMed, Alcon, Alexion, Allergan, Amgen, Annexon, Apellis, Astellas, Bayer, BIRC, Boehringer Ingelheim, Chengdu Kanghong, Clearside, Eyebiotech, EyePoint, Roche, Gemini, Genentech, Graybug Vision, Gyroscope, Heidelberg, i-Lumen, IONIS, Kodiak, LumiThera, MeiraGTx, Mylan, NGM, Novartis, Ocular Therapeutix, Ocuphire, OcuTerra, Opthea, OPTOS, Outlook Therapeutics, OXULAR, Regeneron, RegenXBio, Rezolute, SamChunDang, Samsung, Sandoz, Santen, SciFluor, Senju, Shanghai Henlius, Stealth, Taiwan Liposome Company, ThromboGenics, Xbrane, and Zeiss; and stock options for Adverum, Clearside, and Ocuphire. Sebastian Wolf reports consultancy fees from BCN Peptides, Celltrion, La Science, Novartis, Oculis, and Priothera. Andras Papp is a consultant for Akceso Advisors, Apobiologix/Apotex, Bayer, Formycon, Novartis, Ocular Therapeutix, and Teva; has received travel grants from Novartis and Roche; and his department has been involved in the conduct of several studies sponsored by Allergan, Altos Biologics, Alvotech, Amgen, Bayer, Bioeq, Celltrion, Inc., Chengdu Kanghong, Clearside Biomedical, Eyebiotech Ltd, Genentech, Intas Pharmaceuticals, Novartis, Oculis, Ophthea, Ophthotech/Iveric Bio, Qilu, Regeneron, Roche, Sam Chun Dang Pharm. Co. Ltd., Samsung Bioepis, Shanghai Henlius Biotech, Inc., ThromboGenics, and Xbrane. Rohan Chauhan has received clinical research grants from Alvotech, Biocon, Intas Biopharma, Lambda Therapeutics, Lupin Ltd, Mylan (part of Viatris), Oculis Pharma, and Reliance Life Sciences. Min Sagong has been a consultant for and receives grant support and lecture fees from Alcon, Allergan/AbbVie, Bayer, Celltrion, Curacle, Novartis, PharmAbcine, Roche, and Samsung Bioepis; and receives grant support from Alteogen, Kyowa Kirin, Janssen, Johnson &#x00026; Johnson, Opthea Therapeutics, and Sam Chun Dang. Sunghyun Kim, YunJu Bae, and Suyoung Kim are employees of Celltrion, Inc. and hold stocks and stock options in Celltrion, Inc. Youngmin Bae, Dain Son, Hyejin&#x000a0;Kang, and Sujin Choi are employees of Celltrion, Inc. Paulo-Eduardo Stanga has a consultancy agreement with Celltrion, Inc. Milan Veselovsky, Miroslav Veith, Shobhana Mange, Lakshmi Kanta Mondal, Dominika Romanczak, Ladislav Janco, Bo&#x0017c;ena&#x000a0;Romanowska-Dixon, Alena Eremina, and Jaroslava Dusova have no conflicts of interest to disclose.</p></notes><notes id="FPar2"><title>Ethical Approval</title><p id="Par46">The study was performed in accordance with Good Clinical Practice, the principles of the Declaration of Helsinki, and relevant country-specific regulatory requirements. Independent ethics committees and institutional review boards at each site prospectively approved the study materials (Table <xref rid="MOESM1" ref-type="media">S1</xref> in Supplementary Material), and all patients provided written, informed consent for study participation.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Romero-Aroca</surname><given-names>P</given-names></name><name><surname>Baget-Bernaldiz</surname><given-names>M</given-names></name><name><surname>Pareja-Rios</surname><given-names>A</given-names></name><name><surname>Lopez-Galvez</surname><given-names>M</given-names></name><name><surname>Navarro-Gil</surname><given-names>R</given-names></name><name><surname>Verges</surname><given-names>R</given-names></name></person-group><article-title>Diabetic macular edema path
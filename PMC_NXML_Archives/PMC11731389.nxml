gue</bold></td></tr><tr><td align="left">&#x02002;Mean (SD)</td><td align="left">34.4 (10.3)</td><td align="left">34.3 (10.3)</td><td align="left">42.0 (7.48)</td><td align="left">32.4 (8.52)</td><td align="left">36.4 (10.5)</td><td align="left">33.5 (2.38)</td></tr><tr><td align="left">&#x02002;Median (min, max)</td><td align="left">30.3 (16.0, 48.0)</td><td align="left">37.0 (16.0, 43.0)</td><td align="left">44.0 (25.0, 49.0)</td><td align="left">30.0 (22.0, 46.0)</td><td align="left">39.0 (18.0, 51.0)</td><td align="left">32.5 (32.0, 37.0)</td></tr><tr><td align="left">&#x02002;Missing</td><td align="left">2 (15.4%)</td><td align="left">1 (14.3%)</td><td align="left">0 (0%)</td><td align="left">0 (0%)</td><td align="left">2 (15.4%)</td><td align="left">1 (20.0%)</td></tr><tr><td align="left" colspan="7"><bold>FACT-General</bold></td></tr><tr><td align="left">&#x02002;Mean (SD)</td><td align="left">85.6 (14.3)</td><td align="left">78.9 (15.8)</td><td align="left">89.6 (9.93)</td><td align="left">76.6 (13.4)</td><td align="left">81.8 (17.7)</td><td align="left">73.3 (9.45)</td></tr><tr><td align="left">&#x02002;Median (min, max)</td><td align="left">89.5 (53.7, 100)</td><td align="left">84.0 (52.0, 94.0)</td><td align="left">90.0 (74.0, 107)</td><td align="left">78.0 (60.0, 95.0)</td><td align="left">89.7 (37.2, 99.8)</td><td align="left">70.0 (66.0, 84.0)</td></tr><tr><td align="left">&#x02002;Missing</td><td align="left">1 (7.7%)</td><td align="left">1 (14.3%)</td><td align="left">3 (30.0%)</td><td align="left">2 (28.6%)</td><td align="left">2 (15.4%)</td><td align="left">2 (40.0%)</td></tr><tr><td align="left" colspan="7"><bold>FACT-Lymphoma</bold></td></tr><tr><td align="left">&#x02002;Mean (SD)</td><td align="left">132 (23.2)</td><td align="left">114 (30.8)</td><td align="left">138 (15.8)</td><td align="left">112 (19.3)</td><td align="left">126 (25.6)</td><td align="left">116 (13.2)</td></tr><tr><td align="left">&#x02002;Median (min, max)</td><td align="left">
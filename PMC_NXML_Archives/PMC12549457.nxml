<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="review-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Eur Radiol Exp</journal-id><journal-id journal-id-type="iso-abbrev">Eur Radiol Exp</journal-id><journal-title-group><journal-title>European Radiology Experimental</journal-title></journal-title-group><issn pub-type="epub">2509-9280</issn><publisher><publisher-name>Springer Vienna</publisher-name><publisher-loc>Vienna</publisher-loc></publisher></journal-meta>

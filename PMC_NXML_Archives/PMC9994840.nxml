ontrib contrib-type="author"><name><surname>Zhang</surname><given-names>Xiao-Yan</given-names></name><degrees>MD</degrees><xref rid="aff2" ref-type="aff">&#x02020;</xref><email>370493077@qq.com</email></contrib><contrib contrib-type="author"><name><surname>Zhao</surname><given-names>Yi-Ming</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">*</xref><email>iammike0721@sina.com</email></contrib><contrib contrib-type="author"><name><surname>Li</surname><given-names>Shi-Jie</given-names></name><degrees>MD</degrees><xref rid="aff3" ref-type="aff">&#x02021;</xref><email>ourhere@126.com</email></contrib><contrib contrib-type="author"><name><surname>Li</surname><given-names>Zhong-Wu</given-names></name><degrees>MD</degrees><xref rid="aff4" ref-type="aff">&#x000a7;</xref><email>zhwuli@hotmail.com</email></contrib><contrib contrib-type="author"><name><surname>Sun</surname><given-names>Ying-Shi</given-names></name><degrees>MD</degrees><xref rid="aff2" ref-type="aff">&#x02020;</xref><email>sunysabc@163.com</email></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Wang</surname><given-names>Wei-Hu</given-names></name><degrees>MD</degrees><email>wangweihu88@163.com</email><xref rid="aff5" ref-type="aff">&#x02225;</xref></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Wu</surname><given-names>Ai-Wen</given-names></name><degrees>MD</degrees><xref rid="aff1" ref-type="aff">*</xref><email>zlwanglin@foxmail.com</email></contrib><on-behalf-of>on behalf of The Rectal Cancer Cooperative Group of Peking University Cancer Hospital</on-behalf-of></contrib-group><aff id="aff1">

</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;0</td><td align="center" rowspan="1" colspan="1">4 (10.8)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;1/2/3</td><td align="center" rowspan="1" colspan="1">8 (21.6)/18 (48.6)/3 (8.1)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;4</td><td align="center" rowspan="1" colspan="1">4 (10.8)</td></tr><tr><td align="left" rowspan="1" colspan="1">

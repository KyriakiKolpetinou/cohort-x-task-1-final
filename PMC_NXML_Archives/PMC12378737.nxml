</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Europe</td><td align="center" rowspan="1" colspan="1">21 (56.8)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Sub-Saharan Africa or French Antilles</td><td align="center" rowspan="1" colspan="1">10 (27.0)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Maghreb region</td><td align="center" rowspan="1" colspan="1">5 (13.5)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Asia</td><td align="center" rowspan="1" colspan="1">1 (2.7)</td></tr><tr><td align="left" rowspan="1" colspan="1">

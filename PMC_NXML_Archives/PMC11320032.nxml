</td><td align="left" colspan="1" rowspan="1" valign="top">
<bold>1</bold>
</td><td align="left" colspan="1" rowspan="1" valign="top">
<bold>1.5</bold>
</td><td align="left" colspan="1" rowspan="1" valign="top">
<bold>2</bold>
</td><td align="left" colspan="1" rowspan="1" valign="top">
<bold>2.5</bold>
</td><td align="left" colspan="1" rowspan="1" valign="top">

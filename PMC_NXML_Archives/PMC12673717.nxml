<article-id pub-id-type="publisher-id">5747</article-id><article-id pub-id-type="doi">10.1186/s13054-025-05747-3</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research</subject></subj-group></article-categories><title-group><article-title>Site-specific complications of central venous catheterization under systematic ultrasound guidance: a target trial emulation revisiting the 3SITES study</article-title></title-group><contrib-group><contrib contrib-type="author" corresp="yes"><name><surname>Boulet</surname><given-names>Nicolas</given-names></name><address><email>nicolas.boulet@chu-nimes.fr</email></address><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Gavoille</surname><given-names>Antoine</given-names></name><xref ref-type="aff" rid="Aff2">2</xref><xref ref-type="aff" rid="Aff3">3</xref></contrib><contrib contrib-type="author"><name><surname>Iachkine</surname><given-names>Jeanne</given-names></name><xref ref-type="aff" rid="Aff4">4</xref></contrib><contrib contrib-type="author"><name><surname>Louart</surname><given-names>Benjamin</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>de Grooth</surname><given-names>Harm&#x02011;Jan</given-names></name><xref ref-type="aff" rid="Aff5">5</xref></contrib><contrib contrib-type="author"><name><surname>Du Cheyron</surname><given-names>Damien</given-names></name><xref ref-type="aff" rid="Aff6">6</xref></contrib><contrib contrib-type="author"><name><surname>Roger</surname><given-names>Claire</given-names></name><xref ref-type="aff" rid="Aff1">1</xref></contrib><contrib contrib-type="author"><name><surname>Parienti</surname><given-names>Jean-Jacques</given-names></name><xref ref-type="aff" rid="Aff7">7</xref></contrib><contrib contrib-type="author"><collab>3SITES Study Group<contrib-group><contrib contrib-type="author"><name><surname>Mongardon</surname><given-names>Nicolas</given-names></name></contrib><contrib contrib-type="author"><name><surname>M&#x000e9;garbane</surname><given-names>Bruno</given-names></name></contrib><contrib contrib-type="author"><name><surname>Mira</surname><given-names>Jean-Paul</given-names></name></contrib><contrib contrib-type="author"><name><surname>Kalfon</surname><given-names>Pierre</given-names></name></contrib><contrib contrib-type="author"><name><surname>Gros</surname><given-names>Antoine</given-names></name></contrib><contrib contrib-type="author"><name><surname>Marqu&#x000e9;</surname><given-names>Sophie</given-names></name></contrib><contrib contrib-type="author"><name><surname>Thuong</surname><given-names>Marie</given-names></name></contrib><contrib contrib-type="author"><name><surname>Pottier</surname><given-names>V&#x000e9;ronique</given-names></name></contrib><contrib contrib-type="author"><name><surname>Ramakers</surname><given-names>Michel</given-names></name></contrib><contrib contrib-type="author"><name><surname>Savary</surname><given-names>Benoit</given-names></name></contrib><contrib contrib-type="author"><name><surname>Seguin</surname><given-names>Am&#x000e9;lie</given-names></name></contrib><contrib contrib-type="author"><name><surname>Valette</surname><given-names>Xavier</given-names></name></contrib><contrib contrib-type="author"><name><surname>Terzi</surname><given-names>Nicolas</given-names></name></contrib><contrib contrib-type="author"><name><surname>Sauneuf</surname><given-names>Bertrand</given-names></name></contrib><contrib contrib-type="author"><name><surname>Cattoir</surname><given-names>Vincent</given-names></name></contrib><contrib contrib-type="author"><name><surname>Mermel</surname><given-names>Leonard A</given-names></name></contrib></contrib-group></collab></contrib><aff id="Aff1"><label>1</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0275ye937</institution-id><institution-id institution-id-type="GRID">grid.411165.6</institution-id><institution-id institution-id-type="ISNI">0000 0004 0593 8241</institution-id><institution>UR-UM103 IMAGINE, Univ Montpellier, Intensive Care Unit, Department of Anesthesiology, Critical Care, Pain and Emergency Medicine, </institution><institution>N&#x000ee;mes University Hospital, </institution></institution-wrap>Place du Professeur Debr&#x000e9;, 30900 N&#x000ee;mes, Gard France </aff><aff id="Aff2"><label>2</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/029brtt94</institution-id><institution-id institution-id-type="GRID">grid.7849.2</institution-id><institution-id institution-id-type="ISNI">0000 0001 2150 7757</institution-id><institution>Laboratoire de Biom&#x000e9;trie Et Biologie &#x000c9;volutive UMR 5558, </institution><institution>Universit&#x000e9; de Lyon, Universit&#x000e9; Lyon 1, CNRS, </institution></institution-wrap>69100 Villeurbanne, France </aff><aff id="Aff3"><label>3</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/01502ca60</institution-id><institution-id institution-id-type="GRID">grid.413852.9</institution-id><institution-id institution-id-type="ISNI">0000 0001 2163 3825</institution-id><institution>Service de Biostatistique-Bioinformatique, Hospices Civils de Lyon, </institution></institution-wrap>69003 Lyon, France </aff><aff id="Aff4"><label>4</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/027arzy69</institution-id><institution-id institution-id-type="GRID">grid.411149.8</institution-id><institution-id institution-id-type="ISNI">0000 0004 0472 0160</institution-id><institution>Department of Intensive Care Medicine, </institution><institution>Caen University Hospital, </institution></institution-wrap>Caen, France </aff><aff id="Aff5"><label>5</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/0575yy874</institution-id><institution-id institution-id-type="GRID">grid.7692.a</institution-id><institution-id institution-id-type="ISNI">0000 0000 9012 6352</institution-id><institution>Intensive Care Center, </institution><institution>UMC Utrecht, </institution></institution-wrap>Utrecht, The Netherlands </aff><aff id="Aff6"><label>6</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/051kpcy16</institution-id><institution-id institution-id-type="GRID">grid.412043.0</institution-id><institution-id institution-id-type="ISNI">0000 0001 2186 4076</institution-id><institution>Normandie Univ, UNICAEN, CHU de Caen Normandie, M&#x000e9;decine Intensive Et R&#x000e9;animation, </institution></institution-wrap>14000 Caen, France </aff><aff id="Aff7"><label>7</label><institution-wrap><institution-id institution-id-type="ROR">https://ror.org/051kpcy16</institution-id><institution-id institution-id-type="GRID">grid.412043.0</institution-id><institution-id institution-id-type="ISNI">0000 0001 2186 4076</institution-id><institution>Department of Clinical Research and Biostatistics, </institution><institution>Caen University Hospital; Caen Normandy University Inserm U1311 DYNAMICURE, Caen Normandy University, </institution></institution-wrap>Caen, France </aff></contrib-group><pub-date pub-type="epub"><day>2</day><month>12</month><year>2025</year></pub-date><pub-date pub-type="pmc-release"><day>2</day><month>12</month><year>2025</year></pub-date><pub-date pub-type="collection"><year>2025</year></pub-date><volume>29</volume><elocation-id>513</elocation-id><history><date date-type="received"><day>26</day><month>9</month><year>2025</year></date><date date-type="accepted"><day>27</day><month>10</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9; The Author(s) 2025</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p><bold>Open Access</bold> This article is licensed under a Creative Commons Attribution-NonCommercial-NoDerivatives 4.0 International License, which permits any non-commercial use, sharing, distribution and reproduction in any medium or format, as long as you give appropriate credit to the original author(s) and the source, provide a link to the Creative Commons licence, and indicate if you modified the licensed material. You do not have permission under this licence to share adapted material derived from this article or parts of it. The images or other third party material in this article are included in the article&#x02019;s Creative Commons licence, unless indicated otherwise in a credit line to the material. If material is not included in the article&#x02019;s Creative Commons licence and your intended use is not permitted by statutory regulation or exceeds the permitted use, you will need to obtain permission directly from the copyright holder. To view a copy of this licence, visit <ext-link ext-link-type="uri" xlink:href="https://creativecommons.org/licenses/by-nc-nd/4.0/">http://creativecommons.org/licenses/by-nc-nd/4.0/</ext-link>.</license-p></license></permissions><abstract id="Abs1"><sec><title>Background</title><p id="Par1">Central venous catheterization is the most common invasive procedure in intensive care units but remains burdened by infectious, thrombotic, and mechanical complications. Although real-time ultrasound guidance is now widely adopted, its effect on site-specific differences in overall complication rates has not been established. The 3SITES randomized clinical trial previously demonstrated lower infection and thrombosis rates with subclavian access but higher mechanical complications. However, as only a third of its procedures were ultrasound-guided in this study, these findings may not apply to current practice. The objective of the study was to compare complication rates across these three sites under a counterfactual framework assuming universal ultrasound guidance.</p></sec><sec><title>Methods</title><p id="Par2">This study was an emulated a target trial using the 3SITES dataset. Inverse probability weighting was applied to adjust for confounders of site assignment and ultrasound guidance. Weighted outcomes across catheter sites were compared under a counterfactual framework assuming universal ultrasound guidance. The primary outcome was a composite of time to catheter-related bloodstream infection or symptomatic deep-vein thrombosis. Secondary outcomes included each component separately, asymptomatic thrombosis, and major mechanical complications.</p></sec><sec><title>Results</title><p id="Par3">A total of 3409 catheters were included: 1153 in the femoral, 1267 in the internal jugular, and 989 in the subclavian site. Subclavian site showed a lower incidence of the primary outcome compared with femoral (<italic>P</italic>&#x02009;=&#x02009;<italic>.02</italic>) and jugular (<italic>P</italic>&#x02009;=&#x02009;<italic>.001</italic>) sites. The primary composite outcome did not differ between internal jugular and femoral sites (<italic>P</italic>&#x02009;=&#x02009;<italic>.97</italic>). Catheter-related bloodstream infections were significantly fewer with subclavian versus jugular access (<italic>P</italic>&#x02009;=&#x02009;<italic>.001</italic>). Asymptomatic thrombosis was more frequent at femoral and jugular sites. Major mechanical complications were rare and did not differ significantly across sites.</p></sec><sec><title>Conclusion</title><p id="Par4">Assuming universal real-time ultrasound-guided central venous catheterization, subclavian access retains lower infectious and thrombotic risk without an observed increase in mechanical complications, supporting its preferential use in intensive care units.</p></sec><sec><title>Supplementary Information</title><p>The online version contains supplementary material available at 10.1186/s13054-025-05747-3.</p></sec></abstract><kwd-group xml:lang="en"><title>Keywords</title><kwd>Catheterization</kwd><kwd>Central venous</kwd><kwd>Central venous catheters</kwd><kwd>Vascular Access Devices</kwd><kwd>Ultrasound guidance</kwd><kwd>Ultrasonography</kwd><kwd>Catheter-related infections</kwd><kwd>Catheter-related thrombosis</kwd><kwd>Venous Thrombosis</kwd><kwd>Catheter-related complications</kwd></kwd-group><custom-meta-group><custom-meta><meta-name>issue-copyright-statement</meta-name><meta-value>&#x000a9; BioMed Central Ltd., part of Springer Nature 2025</meta-value></custom-meta></custom-meta-group></article-meta></front><body><sec id="Sec1"><title>Introduction</title><p id="Par7">Central venous catheterization is the most frequently performed invasive procedure in intensive care units (ICUs), yet remains associated with infectious, thrombotic, and mechanical complications [<xref ref-type="bibr" rid="CR1">1</xref>]. Although the absolute risk is low, the clinical consequences can be serious [<xref ref-type="bibr" rid="CR2">2</xref>].</p><p id="Par8">Real-time ultrasound guidance has become the standard approach in many settings, due to its well-documented benefits in reducing mechanical complications [<xref ref-type="bibr" rid="CR3">3</xref>, <xref ref-type="bibr" rid="CR4">4</xref>], and its strong endorsement by international guidelines [<xref ref-type="bibr" rid="CR5">5</xref>&#x02013;<xref ref-type="bibr" rid="CR8">8</xref>]. Emerging evidence also suggests a potential reduction in infection risk [<xref ref-type="bibr" rid="CR9">9</xref>]. However, it remains unclear whether the systematic use of ultrasonography mitigates the differences in complication rates between insertion sites, or whether these differences persist despite ultrasound guidance [<xref ref-type="bibr" rid="CR10">10</xref>].</p><p id="Par9">The 3SITES randomized controlled trial compared complication rates across internal jugular, femoral, and subclavian catheter insertions [<xref ref-type="bibr" rid="CR11">11</xref>]. Subclavian access was associated with a lower incidence of bloodstream infection and deep-vein thrombosis, but a higher rate of mechanical complications. These findings led to guideline recommendations favoring the subclavian site to minimize infectious risks [<xref ref-type="bibr" rid="CR5">5</xref>]. Yet only one-third of patients in 3SITES underwent ultrasound-guided insertion, as this technique was not yet widely implemented. Today, ultrasound guidance is used in most central line insertions, particularly for jugular and femoral access. As a result, the relative risk profile across sites may differ from that observed in the original trial, which was suggested in a recent large observational study [<xref ref-type="bibr" rid="CR12">12</xref>, <xref ref-type="bibr" rid="CR13">13</xref>]. Conversely, a recent study, albeit with a low rate of ultrasound guidance, also highlighted the superiority of the subclavian site in terms of thrombotic risks compared to other insertion sites [<xref ref-type="bibr" rid="CR14">14</xref>].</p><p id="Par10">To reassess these risks in light of current practices, a post hoc emulation of a target trial using data from 3SITES was conducted [<xref ref-type="bibr" rid="CR15">15</xref>, <xref ref-type="bibr" rid="CR16">16</xref>]. This dataset offers several advantages over administrative sources, including prospectively collected baseline characteristics, standardized outcome definitions, and blinded adjudication of complications. The main hypothesis was that the use of real-time ultrasound guidance might eliminate the differences in complication rates between insertion sites. The objective was to compare the incidence of catheter-related complications across internal jugular, femoral, and subclavian sites under the hypothetical scenario in which all catheters were inserted with real-time ultrasound guidance.</p></sec><sec id="Sec2"><title>Methods</title><sec id="Sec3"><title>The original 3SITES trial</title><p id="Par11">The 3SITES trial was a multicenter randomized controlled trial conducted in 10 French ICUs across 9 hospitals, from December 2011 to June 2014 [<xref ref-type="bibr" rid="CR11">11</xref>]. Patients aged&#x02009;&#x02265;&#x02009;18&#x000a0;years admitted to the ICU and requiring a new nontunneled central line were included, provided the clinician deemed at least two of the three access sites (internal jugular, femoral, and subclavian) suitable for insertion. Multiple catheters per patient were allowed. When all three sites were deemed suitable, procedure site was randomized in a 1:1:1 ratio. If a site was unsuitable bilaterally, then randomization occurred in a 1:1 ratio for the remaining two sites (selective randomization). The determination that a venous access site was suitable (or usable) for catheterization was based on clinician judgment. Catheter insertion was performed using the Seldinger technique, using either anatomical landmarks, ultrasound location, or real-time ultrasound guidance, at the clinician's discretion. Operator's experience was defined as follows: a "resident" had performed less than 50 catheterizations at the specific insertion site, a "senior" had performed 50 or more, and an "ultrasound guidance expert senior" was a senior physician also recognized as a local expert or trainer in ultrasound-guided techniques.</p><p id="Par12">Outcomes were collected during catheter insertion and until 48&#x000a0;h after catheter removal, ICU discharge or death. These included incidence of catheter-related bloodstream infection, symptomatic deep-vein thrombosis, asymptomatic deep-vein thrombosis and major mechanical complications (defined as pneumothorax, arterial injury, hematoma or hemorrhage, grade 3 or higher). Catheter-related bloodstream infection was diagnosed when the same phenotypic microorganism was isolated from both the catheter tip (&#x02265;&#x02009;1000 colony-forming units/mL) and peripheral blood cultures (or two in cases involving potential skin contaminants). An adjudication committee that was unaware of the study-group assignments reviewed all suspected cases of catheter-related bloodstream infection.</p><p id="Par13">If symptomatic deep-vein thrombosis was suspected, the diagnosis was confirmed using compression ultrasonography. For the primary endpoint, deep vein thrombosis was defined as a diagnosis confirmed by ultrasound. In addition, if the patient was available, systematic ultrasonography of the insertion site was performed within 2&#x000a0;days after catheter removal to either confirm symptomatic deep-vein thrombosis or detect asymptomatic cases.</p></sec></sec><sec id="Sec4"><title>Target trial emulation</title><sec id="Sec5"><title>Study design</title><p id="Par14">A post-hoc causal inference analysis using a target trial emulation framework was conducted to compare nontunneled catheter-related complications across different insertion sites (internal jugular, femoral, and subclavian) in adult ICU patients, under the hypothetical scenario in which all patients would have undergone real-time ultrasound-guided procedure.</p><p id="Par15">Because real-time ultrasound guidance was not randomized in the original trial, the counterfactual outcomes were statistically estimated as if ultrasound guidance had been uniformly applied to all the patients included in the original randomized controlled trial, by adjusting for potential confounding factors associated with the likelihood of receiving ultrasound guidance.</p><p id="Par16">The manuscript is compliant with the TARGET Statement, for Transparent Reporting of Observational Studies Emulating a Target Trial [<xref ref-type="bibr" rid="CR17">17</xref>].</p></sec><sec id="Sec6"><title>Data collection</title><p id="Par17">Data were extracted from all patients of the 3SITES study database. Demographic (age, sex, body mass index, ICU center), clinical (use of real-time ultrasound guidance, type of antiseptic detersion, catheter rank, operator experience, catheter duration, patient medical comorbidities, anticoagulant therapies, Simplified Acute Physiology Score II (SAPS II), outcomes), biological (hemostasis disorders) and other (selective randomization and excluded site, time from ICU admission to catheter placement) data were collected.</p></sec><sec id="Sec7"><title>Patients</title><p id="Par18">The target population consisted of all patients originally enrolled in the 3SITES trial, including those who did not receive ultrasound guidance. Patients initially excluded from a specific comparison due to selective randomization were also included, in order to maximize statistical power, and because site exclusion in the original trial was left to the discretion of the physician, most often due to relative contraindications potentially associated with the lack of ultrasound guidance use, rather than absolute ones in the target population. Therefore, the analyses also adjusted for potential confounding factors associated with selective catheter site exclusion. In addition, we performed two sensitivity analyses on specific subgroups: one restricted to patients eligible for catheterization at all three sites or at both sites being compared, and the other using only each patient's first central venous catheter, specifically to assess the potential impact of intra-patient correlation.</p></sec><sec id="Sec8"><title>Intervention</title><p id="Par19">The risk of complication was compared between the three catheter sites in an intention-to-treat setting, considering catheters according to their randomized site assignment regardless of their actual insertion site.</p></sec><sec id="Sec9"><title>Outcomes</title><p id="Par20">The primary outcome measure was a composite of time to catheter-related bloodstream infection or symptomatic deep-vein thrombosis (whichever occurred first). Secondary outcomes were time to catheter-related bloodstream infection, symptomatic deep-vein thrombosis, asymptomatic deep-vein thrombosis (among patients who underwent ultrasonography examination) and a composite outcome of major mechanical complications (defined as pneumothorax, arterial injury, hematoma or hemorrhage, grade 3 or higher). For pneumothorax, diagnosis was made by systematic post-procedural chest radiography for all jugular and subclavian catheterizations, and the event was counted as a major complication only if it required chest-tube insertion or resulted in a specific clinical consequence (respiratory distress, hypoxemia) necessitating therapeutic intervention other than simple observation.</p></sec><sec id="Sec10"><title>Covariables</title><p id="Par21">Potential confounding factors were selected a priori based on clinical expertise and summarized in the directed acyclic graphs (DAGs) presented in the Supplementary Fig.&#x000a0;4. They could vary across comparisons, depending on the underlying causal assumptions. For the ultrasound guidance choice, confounding factors were: age, sex, body mass index, SAPS II, ICU center, antiseptic detersion type, cancer, neutropenia, chronic obstructive pulmonary disease, hemostasis disorders or anticoagulant treatments, catheter rank, and operator's experience. For the exclusion of a specific site, confounding factors were: age, sex, body mass index, SAPS II, ICU center, time from ICU admission to catheter placement, cancer, neutropenia, chronic obstructive pulmonary disease, hemostasis disorders or anticoagulant treatments, and catheter rank.</p></sec><sec id="Sec11"><title>Missing data</title><p id="Par22">Catheters with missing data for the use of ultrasonography use and catheter duration were excluded from the study. Regarding confounding factors, missing data for categorical covariates were recoded into a "missing" category, and missing data for continuous variables (body mass index and SAPS II) were imputed using a regression-based single imputation method.</p></sec><sec id="Sec12"><title>Statistical analysis</title><p id="Par23">Outcomes were compared between catheter sites in three pairwise comparisons: internal jugular versus femoral, subclavian versus femoral, and subclavian versus internal jugular. Causal effects of the catheter site choice adjusted for confounding factors were estimated using an inverse probability weighting stabilized estimator, based on the product of two logistic propensity-score models for each pairwise comparison [<xref ref-type="bibr" rid="CR18">18</xref>]:</p><p id="Par24">(i) "Catheter site" models estimating each patient's probability of being allocated to their respective arm of catheter site (Supplementary Table&#x000a0;3).</p><p id="Par25">(ii) "Ultrasound guidance" models estimating the probability of receiving real-time ultrasound-guided central venous catheterization (Supplementary Table&#x000a0;4).</p><p id="Par26">These two models were logistic regressions, adjusted for confounding factors listed above according to the two catheter sites being compared. For each of the three pairwise comparisons, potential confounding factors were first selected based on a specific causal model (Supplementary Fig.&#x000a0;4). The final set of covariates for each model was adapted from the theoretical DAGs to ensure model stability and avoid issues of quasi-complete separation for variables with low prevalence in a specific pairwise comparison. In addition, "Ultrasound guidance" models were weighted by the inverse probability of being allocated to the observed catheter site. Standardized mean differences were used to assess covariate balance between exposure groups before and after IP-weighting. Due to the small sample size, an absolute standardized mean difference below 0.2 was considered indicative of good covariate balance [<xref ref-type="bibr" rid="CR19">19</xref>].</p><p id="Par27">Weighted outcomes across catheter sites were compared under a counterfactual framework assuming universal ultrasound guidance. Time to primary composite outcome, catheter-related bloodstream infection, symptomatic deep-vein thrombosis, and asymptomatic deep-vein thrombosis were analyzed using weighted survival curves estimated using the Kaplan'Meier method, and statistical significance was assessed using weighted log-rank tests. Hazard ratios were estimated using weighted Cox proportional hazards models, except when no event were observed in one group. The composite secondary outcome of major mechanical complications was analyzed using a weighted logistic regression model.</p><p id="Par28">Full details of the statistical analyses are provided in the Supplementary Material. P values below 0.05 were considered significant. All analyses were conducted using R software (version 4.4.2).</p></sec></sec><sec id="Sec13"><title>Results</title><p id="Par29">A total of 3409 catheters from 2,989 patients were included (324 (10.8%) patients had more than one catheter): 1153 in the femoral, 1267 in the internal jugular, and 989 in the subclavian site (Fig.&#x000a0;<xref rid="Fig1" ref-type="fig">1</xref>). Of these, 967 (28.4%) were real-time ultrasound-guided: 196 (17.0%) in the femoral, 721 (56.9%) in the internal jugular, and 50 (5.1%) in the subclavian site.<fig id="Fig1"><label>Fig.&#x000a0;1</label><caption><p>Study Flow Chart. IJV: internal jugular vein; FV: femoral vein; SCV: subclavian vein; US: ultrasound</p></caption><graphic xlink:href="13054_2025_5747_Fig1_HTML" id="MO1"/></fig></p><p id="Par30">The mean age was 62.8&#x000a0;years (standard deviation&#x02009;&#x000b1;&#x02009;15.7), and 64.9% (2211 of 3409) of patients were male (Table&#x000a0;<xref rid="Tab1" ref-type="table">1</xref>). After regression-based single imputation, the mean body mass index was 26.4&#x000a0;kg/m<sup>2</sup> (&#x000b1;&#x02009;6.2), and mean SAPS II score was 56.7 (&#x000b1;&#x02009;20.0) (Supplementary Table&#x000a0;5). Most catheters analyzed were the first inserted during the ICU stay (2,982 of 3,409; 87.5%). The mean catheter dwell time was 6.5&#x000a0;days (&#x000b1;&#x02009;5.4).<table-wrap id="Tab1"><label>Table 1</label><caption><p>Characteristics of initial population</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left" rowspan="2">Real-time ultrasound guidance</th><th align="left" rowspan="2"/><th align="left" colspan="2">Femoral site<break/>(n&#x02009;=&#x02009;1,153)</th><th align="left" colspan="2">Internal jugular site<break/>(n&#x02009;=&#x02009;1,267)</th><th align="left" colspan="2">Subclavian site<break/>(n&#x02009;=&#x02009;989)</th></tr><tr><th align="left">No (n&#x02009;=&#x02009;957<italic>)</italic></th><th align="left">Yes (n&#x02009;=&#x02009;196)</th><th align="left">No (n&#x02009;=&#x02009;546)</th><th align="left">Yes (n&#x02009;=&#x02009;721)</th><th align="left">No (n&#x02009;=&#x02009;939)</th><th align="left">Yes (n&#x02009;=&#x02009;50)</th></tr></thead><tbody><tr><td align="left">Selective randomization</td><td align="left">No</td><td align="left">702 (73.4)</td><td align="left">128 (65.3)</td><td align="left">386 (70.7)</td><td align="left">448 (62.1)</td><td align="left">779 (83.0)</td><td align="left">46 (92.0)</td></tr><tr><td align="left"/><td align="left">Yes</td><td align="left">255 (26.6)</td><td align="left">68 (34.7)</td><td align="left">160 (29.3)</td><td align="left">273 (37.9)</td><td align="left">160 (17.0)</td><td align="left">4 (8.0)</td></tr><tr><td align="left">Catheter rank</td><td align="left">1</td><td align="left">846 (88.4)</td><td align="left">176 (89.8)</td><td align="left">471 (86.3)</td><td align="left">633 (87.8)</td><td align="left">815 (86.8)</td><td align="left">41 (82.0)</td></tr><tr><td align="left"/><td align="left">2</td><td align="left">85 (8.9)</td><td align="left">15 (7.7)</td><td align="left">54 (9.9)</td><td align="left">72 (10.0)</td><td align="left">87 (9.3)</td><td align="left">9 (18.0)</td></tr><tr><td align="left"/><td align="left">&#x02009;&#x02265;&#x02009;3</td><td align="left">26 (2.7)</td><td align="left">5 (2.6)</td><td align="left">21 (3.8)</td><td align="left">16 (2.2)</td><td align="left">37 (3.9)</td><td align="left">0 (0.0)</td></tr><tr><td align="left">Age</td><td align="left">Mean (SD)</td><td align="left">62.7 (15.5)</td><td align="left">63.7 (14.0)</td><td align="left">62.1 (15.3)</td><td align="left">63.8 (16.6)</td><td align="left">62.1 (15.9)</td><td align="left">67.3 (13.8)</td></tr><tr><td align="left">Sex</td><td align="left">Female</td><td align="left">319 (33.3)</td><td align="left">72 (36.7)</td><td align="left">207 (37.9)</td><td align="left">258 (35.8)</td><td align="left">327 (34.8)</td><td align="left">15 (30.0)</td></tr><tr><td align="left"/><td align="left">Male</td><td align="left">638 (66.7)</td><td align="left">124 (63.3)</td><td align="left">339 (62.1)</td><td align="left">463 (64.2)</td><td align="left">612 (65.2)</td><td align="left">35 (70.0)</td></tr><tr><td align="left">Body mass index</td><td align="left">Mean (SD)</td><td align="left">26.0 (5.8)</td><td align="left">26.8 (7.4)</td><td align="left">26.1 (6.1)</td><td align="left">26.6 (6.2)</td><td align="left">26.6 (6.2)</td><td align="left">26.3 (5.3)</td></tr><tr><td align="left"/><td align="left">Missing</td><td align="left">68 (7.1)</td><td align="left">3 (1.5)</td><td align="left">33 (6.0)</td><td align="left">39 (5.4)</td><td align="left">56 (6.0)</td><td align="left">2 (4.0)</td></tr><tr><td align="left">COPD</td><td align="left">No</td><td align="left">832 (86.9)</td><td align="left">164 (83.7)</td><td align="left">487 (89.2)</td><td align="left">608 (84.3)</td><td align="left">812 (86.5)</td><td align="left">47 (94.0)</td></tr><tr><td align="left"/><td align="left">Yes</td><td align="left">122 (12.7)</td><td align="left">32 (16.3)</td><td align="left">59 (10.8)</td><td align="left">113 (15.7)</td><td align="left">124 (13.2)</td><td align="left">3 (6.0)</td></tr><tr><td align="left"/><td align="left">Missing</td><td align="left">3 (0.3)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">3 (0.3)</td><td align="left">0 (0.0)</td></tr><tr><td align="left">SAPS II</td><td align="left">Mean (SD)</td><td align="left">57.3 (19.8)</td><td align="left">57.0 (19.8)</td><td align="left">56.3 (19.4)</td><td align="left">58.2 (20.8)</td><td align="left">55.1 (20.0)</td><td align="left">54.9 (20.0)</td></tr><tr><td align="left"/><td align="left">Missing</td><td align="left">36 (3.8)</td><td align="left">2 (1.0)</td><td align="left">20 (3.7)</td><td align="left">10 (1.4)</td><td align="left">33 (3.5)</td><td align="left">1 (2.0)</td></tr><tr><td align="left">Hemostasis disorders or anticoagulant treatments</td><td align="left">No</td><td align="left">545 (56.9)</td><td align="left">89 (45.4)</td><td align="left">311 (57.0)</td><td align="left">401 (55.6)</td><td align="left">596 (63.5)</td><td align="left">29 (58.0)</td></tr><tr><td align="left"/><td align="left">Yes</td><td align="left">382 (39.9)</td><td align="left">102 (52.0)</td><td align="left">215 (39.4)</td><td align="left">306 (42.4)</td><td align="left">298 (31.7)</td><td align="left">17 (34.0)</td></tr><tr><td align="left"/><td align="left">Missing</td><td align="left">30 (3.1)</td><td align="left">5 (2.6)</td><td align="left">20 (3.7)</td><td align="left">14 (1.9)</td><td align="left">45 (4.8)</td><td align="left">4 (8.0)</td></tr><tr><td align="left">Immuno-suppression</td><td align="left">No</td><td align="left">729 (76.2)</td><td align="left">146 (74.5)</td><td align="left">416 (76.2)</td><td align="left">574 (79.6)</td><td align="left">776 (82.6)</td><td align="left">35 (70.0)</td></tr><tr><td align="left"/><td align="left">Yes</td><td align="left">227 (23.7)</td><td align="left">50 (25.5)</td><td align="left">130 (23.8)</td><td align="left">147 (20.4)</td><td align="left">163 (17.4)</td><td align="left">15 (30.0)</td></tr><tr><td align="left"/><td align="left">Missing</td><td align="left">1 (0.1)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td></tr><tr><td align="left">Neutrophil count&#x02009;&#x0003c;&#x02009;500/mm<sup>3</sup></td><td align="left">No</td><td align="left">938 (98.0)</td><td align="left">188 (95.9)</td><td align="left">527 (96.5)</td><td align="left">703 (97.5)</td><td align="left">933 (99.4)</td><td align="left">48 (96.0)</td></tr><tr><td align="left"/><td align="left">Yes</td><td align="left">18 (1.9)</td><td align="left">8 (4.1)</td><td align="left">19 (3.5)</td><td align="left">18 (2.5)</td><td align="left">4 (0.4)</td><td align="left">2 (4.0)</td></tr><tr><td align="left"/><td align="left">Missing</td><td align="left">1 (0.1)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">2 (0.2)</td><td align="left">0 (0.0)</td></tr><tr><td align="left">AIDS</td><td align="left">No</td><td align="left">945 (98.7)</td><td align="left">195 (99.5)</td><td align="left">539 (98.7)</td><td align="left">713 (98.9)</td><td align="left">925 (98.5)</td><td align="left">48 (96.0)</td></tr><tr><td align="left"/><td align="left">Yes</td><td align="left">11 (1.1)</td><td align="left">1 (0.5)</td><td align="left">7 (1.3)</td><td align="left">8 (1.1)</td><td align="left">13 (1.4)</td><td align="left">2 (4.0)</td></tr><tr><td align="left"/><td align="left">Missing</td><td align="left">1 (0.1)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">1 (0.1)</td><td align="left">0 (0.0)</td></tr><tr><td align="left">Cancer</td><td align="left">No</td><td align="left">844 (88.2)</td><td align="left">168 (85.7)</td><td align="left">480 (87.9)</td><td align="left">664 (92.1)</td><td align="left">861 (91.7)</td><td align="left">43 (86.0)</td></tr><tr><td align="left"/><td align="left">Yes</td><td align="left">112 (11.7)</td><td align="left">28 (14.3)</td><td align="left">66 (12.1)</td><td align="left">57 (7.9)</td><td align="left">78 (8.3)</td><td align="left">7 (14.0)</td></tr><tr><td align="left"/><td align="left">Missing</td><td align="left">1 (0.1)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td></tr><tr><td align="left">Catheter duration (days)</td><td align="left">Mean (SD)</td><td align="left">5.8 (4.6)</td><td align="left">6.1 (5.1)</td><td align="left">7.3 (6.0)</td><td align="left">6.3 (5.4)</td><td align="left">6.9 (5.8)</td><td align="left">7.4 (5.0)</td></tr><tr><td align="left">Operator's experience</td><td align="left">Resident</td><td align="left">682 (71.3)</td><td align="left">138 (70.4)</td><td align="left">364 (66.7)</td><td align="left">522 (72.4)</td><td align="left">610 (65.0)</td><td align="left">21 (42.0)</td></tr><tr><td align="left"/><td align="left">Senior</td><td align="left">232 (24.2)</td><td align="left">48 (24.5)</td><td align="left">155 (28.4)</td><td align="left">170 (23.6)</td><td align="left">279 (29.7)</td><td align="left">13 (26.0)</td></tr><tr><td align="left"/><td align="left">Ultrasound guidance expert Senior</td><td align="left">43 (4.5)</td><td align="left">10 (5.1)</td><td align="left">27 (4.9)</td><td align="left">29 (4.0)</td><td align="left">49 (5.2)</td><td align="left">16 (32.0)</td></tr><tr><td align="left"/><td align="left">Missing</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td><td align="left">1 (0.1)</td><td align="left">0 (0.0)</td></tr><tr><td align="left" rowspan="3">Type of antiseptic detersion</td><td align="left">Alcoholic-chlorhexidine</td><td align="left">412 (43.1)</td><td align="left">81 (41.3)</td><td align="left">198 (36.3)</td><td align="left">371 (51.5)</td><td align="left">420 (44.7)</td><td align="left">32 (64.0)</td></tr><tr><td align="left">Other</td><td align="left">541 (56.5)</td><td align="left">114 (58.2)</td><td align="left">346 (63.4)</td><td align="left">349 (48.4)</td><td align="left">519 (55.3)</td><td align="left">18 (36.0)</td></tr><tr><td align="left">Missing</td><td align="left">4 (0.4)</td><td align="left">1 (0.5)</td><td align="left">2 (0.4)</td><td align="left">1 (0.1)</td><td align="left">0 (0.0)</td><td align="left">0 (0.0)</td></tr><tr><td align="left">Time from ICU admission to catheter placement</td><td align="left">Day 0 (admission)</td><td align="left">544 (56.8)</td><td align="left">109 (55.6)</td><td align="left">307 (56.2)</td><td align="left">421 (58.4)</td><td align="left">489 (52.1)</td><td align="left">24 (48.0)</td></tr><tr><td align="left"/><td align="left">After Day 0</td><td align="left">413 (43.2)</td><td align="left">87 (44.4)</td><td align="left">239 (43.8)</td><td align="left">300 (41.6)</td><td align="left">450 (47.9)</td><td align="left">26 (52.0)</td></tr></tbody></table><table-wrap-foot><p><italic>AIDS: acquired immunodeficiency syndrome; COPD: chronic obstructive pulmonary disease; ICU: intensive care unit; SD: standard deviation; SAPS II: Simplified Acute Physiology Score II</italic></p></table-wrap-foot></table-wrap></p><p id="Par31">After applying inverse probability weighting (model results are detailed in Supplementary Tables 6&#x02013;7), covariate balance between compared sites was substantially improved, with standardized mean differences below 0.2 for most of the variables, indicating good balance, except for age in both pairwise comparisons with subclavian and chronic obstructive pulmonary disease in the subclavian vs femoral comparison, whose standardized mean differences were between 0.2 and 0.3 (Supplementary Table&#x000a0;8).</p></sec><sec id="Sec14"><title>Late complications</title><sec id="Sec15"><title>Internal jugular versus femoral comparison</title><p id="Par32">No significant differences were observed for time to the primary outcome (weighted log-rank <italic>P</italic>&#x02009;=&#x02009;<italic>0.97</italic>; Table&#x000a0;<xref rid="Tab2" ref-type="table">2</xref>, Fig.&#x000a0;<xref rid="Fig2" ref-type="fig">2</xref>), catheter-related bloodstream infection, symptomatic deep-vein thrombosis, or asymptomatic deep-vein thrombosis (Supplementary Figs.&#x000a0;5&#x02013;7).<table-wrap id="Tab2"><label>Table 2</label><caption><p>weighted pairwise comparison of complication risk by insertion site</p></caption><table frame="hsides" rules="groups"><thead><tr><th align="left">Outcome</th><th align="left" colspan="4">"IJV versus FV" comparison</th><th align="left" colspan="4">"SCV versus FV" comparison</th><th align="left" colspan="4">"SCV versus IJV" comparison</th></tr><tr><th align="left" rowspan="2"/><th align="left" colspan="2">Weighted incidence rates per 1000 catheter-days</th><th align="left" rowspan="2">Hazard Ratio<break/>[95% CI]</th><th align="left" rowspan="2">Weighted log-rank <italic>P value</italic></th><th align="left" colspan="2">Weighted incidence rates per 1000 catheter-days</th><th align="left" rowspan="2">Hazard Ratio<break/>[95% CI]</th><th align="left" rowspan="2">Weighted log-rank <italic>P value</italic></th><th align="left" colspan="2">Weighted incidence rates per 1000 catheter-days</th><th align="left" rowspan="2">Hazard Ratio<break/>[95% CI]</th><th align="left" rowspan="2">Weighted log-rank <italic>P value</italic></th></tr><tr><th align="left"><italic>IJV</italic></th><th align="left"><italic>FV</italic></th><th align="left"><italic>SCV</italic></th><th align="left"><italic>FV</italic></th><th align="left"><italic>SCV</italic></th><th align="left"><italic>IJV</italic></th></tr></thead><tbody><tr><td align="left"><bold>CRBSI or symptomatic DVT</bold></td><td align="left">4.10</td><td align="left">4.02</td><td align="left"><p>0.98</p><p>[0.37; 2.57]</p></td><td align="left"><italic>.97</italic></td><td align="left">0</td><td align="left">3.91</td><td align="left">NA<sup>a</sup></td><td align="left"><bold><italic>.02</italic></bold></td><td align="left">0</td><td char="." align="char">4.15</td><td align="left">NA<sup>a</sup></td><td align="left"><bold><italic>.001</italic></bold></td></tr><tr><td align="left"><bold>CRBSI</bold></td><td align="left">2.66</td><td align="left">2.66</td><td align="left"><p>0.97</p><p>[0.32; 3.00]</p></td><td align="left"><italic>.96</italic></td><td align="left">0</td><td align="left">2.41</td><td align="left">NA<sup>a</sup></td><td align="left"><italic>.06</italic></td><td align="left">0</td><td char="." align="char">2.59</td><td align="left">NA<sup>a</sup></td><td align="left"><bold><italic>.001</italic></bold></td></tr><tr><td align="left"><bold>Symptomatic DVT</bold></td><td align="left">1.44</td><td align="left">2.38</td><td align="left"><p>0.58</p><p>[0.13; 2.67]</p></td><td align="left"><italic>.52</italic></td><td align="left">0</td><td align="left">2.56</td><td align="left">NA<sup>a</sup></td><td align="left"><italic>.09</italic></td><td align="left">0</td><td char="." align="char">1.55</td><td align="left">NA<sup>a</sup></td><td align="left"><italic>.09</italic></td></tr><tr><td align="left"><bold>Asymptomatic DVT</bold>
<sup>b</sup></td><td align="left">11.1</td><td align="left">9.82</td><td align="left"><p>0.97</p><p>[0.50; 1.89]</p></td><td align="left"><italic>.94</italic></td><td align="left">0</td><td align="left">10.3</td><td align="left">NA<sup>a</sup></td><td align="left"><bold><italic>.004</italic></bold></td><td align="left">0</td><td char="." align="char">11.8</td><td align="left">NA<sup>a</sup></td><td align="left"><bold>&#x02009;&#x0003c;&#x02009;</bold><bold><italic>.001</italic></bold></td></tr></tbody></table><table frame="hsides" rules="groups"><thead><tr><th align="left"/><th align="left" colspan="2"><bold>n (%)</bold></th><th align="left"><bold>Odd ratio</bold><break/><bold>[95% CI]</bold></th><th align="left"><bold><italic>P value</italic></bold></th><th align="left" colspan="2"><bold>n (%)</bold></th><th align="left"><bold>Odd ratio</bold><break/><bold>[95% CI]</bold></th><th align="left"><bold><italic>P value</italic></bold></th><th align="left" colspan="2"><bold>n (%)</bold></th><th align="left"><bold>Odd ratio</bold><break/><bold>[95% CI]</bold></th><th align="left"><bold><italic>P value</italic></bold></th></tr></thead><tbody><tr><td align="left"><bold>Major mechanical complications</bold></td><td align="left">9 (0.7%)</td><td align="left">12 (1.0%)</td><td align="left"><p>0.71</p><p>[0.17; 2.91]</p></td><td align="left"><italic>.64</italic></td><td align="left">11 (1.3%)</td><td align="left">11 (0.9%)</td><td align="left"><p>1.44</p><p>[0.15; 14.3]</p></td><td align="left"><italic>.76</italic></td><td align="left">11 (1.3%)</td><td char="." align="char">9 (0.7%)</td><td align="left"><p>1.87</p><p>[0.22; 16.14]</p></td><td align="left"><italic>.57</italic></td></tr></tbody></table><table-wrap-foot><p><sup>a</sup>Hazard ratios were not calculated because no events occurred in the subclavian site</p><p><sup>b</sup>Systematic compression ultrasonography screening was performed in 277 (38.4%) of patients in the internal jugular site, 67 (34.2%) in the femoral site, and 18 (36.0%) in the subclavian site</p><p><italic>CI: confidence interval; CRBSI: catheter-related bloodstream infections; DVT: deep-vein thrombosis; IJV: internal jugular vein; FV: femoral vein; NA: not applicable; SCV: subclavian vein</italic></p></table-wrap-foot></table-wrap><fig id="Fig2"><label>Fig.&#x000a0;2</label><caption><p>Weighted survival curves for the primary composite outcome (catheter-related bloodstream infection or symptomatic deep-vein thrombosis). IJV: internal jugular vein; FV: femoral vein; SCV: subclavian vein; N: number</p></caption><graphic xlink:href="13054_2025_5747_Fig2_HTML" id="MO2"/></fig></p></sec><sec id="Sec16"><title>Subclavian versus femoral comparison</title><p id="Par33">The cumulative incidence of the primary outcome was significantly higher at the femoral site compared to the subclavian site (weighted log-rank <italic>P</italic>&#x02009;=&#x02009;<italic>0.02</italic>). When analyzed separately, catheter-related bloodstream infection tended to occur less frequently in the subclavian site, while the difference was not statistically significant (weighted log-rank <italic>P</italic>&#x02009;=&#x02009;<italic>0.06</italic>), and no significant difference was found for symptomatic deep-vein thrombosis (<italic>P</italic>&#x02009;=&#x02009;<italic>0.09</italic>). Asymptomatic deep-vein thrombosis occurred significantly more frequently at the femoral site (weighted log-rank <italic>P</italic>&#x02009;=&#x02009;<italic>0.004</italic>).</p></sec><sec id="Sec17"><title>Subclavian versus internal jugular comparison</title><p id="Par34">The cumulative incidence of the primary outcome was significantly higher at the internal jugular site compared to the subclavian site (weighted log-rank <italic>P</italic>&#x02009;=&#x02009;<italic>0.001</italic>). When analyzed separately, catheter-related bloodstream infection occurred less frequently in the subclavian site (<italic>P</italic>&#x02009;=&#x02009;<italic>0.001</italic>), while no significant difference was found for symptomatic deep-vein thrombosis (<italic>P</italic>&#x02009;=&#x02009;<italic>0.09</italic>). Asymptomatic deep-vein thrombosis occurred significantly more frequently at the internal jugular site (weighted log-rank <italic>P</italic>&#x02009;&#x0003c;&#x02009;<italic>0.001</italic>).</p></sec></sec><sec id="Sec18"><title>Major mechanical complications</title><p id="Par35">The risk of major mechanical complications was low and showed no significant differences across the three pairwise site comparisons (Fig.&#x000a0;<xref rid="Fig3" ref-type="fig">3</xref>).<fig id="Fig3"><label>Fig.&#x000a0;3</label><caption><p>Complication rate according to insertion site (pairwise comparisons). CRBSI: catheter-related bloodstream infections; DVT: deep-vein thrombosis; IJV: internal jugular vein; FV: femoral vein; SCV: subclavian vein. The primary composite outcome of catheter-related bloodstream infection or symptomatic deep-vein thrombosis differed significantly between the subclavian insertion-site and the femoral and internal jugular insertion-sites (weighted log-rank P&#x02009;=.02 and.001, respectively). The risk of major mechanical complications did not differ statistically between the three pairwise comparisons</p></caption><graphic xlink:href="13054_2025_5747_Fig3_HTML" id="MO3"/></fig></p></sec><sec id="Sec19"><title>Sensitivity analyses</title><p id="Par36">The results of the two sensitivity analyses, restricted to patients eligible for catheterization at all three sites or at the two sites under comparison, or using only each patient's first central venous catheter, were consistent with the primary analysis (Supplementary Tables 9 and 10).</p></sec><sec id="Sec20"><title>Discussion</title><p id="Par37">This emulation of a target trial using data from 3SITES compared catheter-related complication across the internal jugular, subclavian, and femoral insertion sites. A target trial was emulated using inverse probability weighting under the hypothetical scenario in which all patients from the 3SITES trial would have undergone real-time ultrasound-guided central venous catheterization.</p><p id="Par38">Contrary to the main hypothesis formulated by the authors, differences in the risk of catheter-related bloodstream infection or symptomatic deep-vein thrombosis persisted across insertion sites. The subclavian site remained associated with a lower incidence of these intravascular complications compared to the internal jugular and femoral sites. In contrast, the incidence of major mechanical complications was markedly lower than in the original trial, particularly for subclavian and internal jugular access, as previously suggested [<xref ref-type="bibr" rid="CR20">20</xref>]. No significant differences in mechanical complication rates were observed across sites, suggesting improved procedural safety in the era of universal ultrasound guidance. These updated findings are consistent with the original 3SITES trial, which established the subclavian site as favorable for reducing infectious and thrombotic risks [<xref ref-type="bibr" rid="CR11">11</xref>]. However, this target trial emulation suggests that, in current practice, this advantage is no longer offset by a higher risk of mechanical complications, historically a major limitation to broader use of the subclavian approach.</p><p id="Par39">The original 3SITES study was designed in response to growing evidence suggesting the superiority of the subclavian insertion site in reducing infectious complications [<xref ref-type="bibr" rid="CR21">21</xref>&#x02013;<xref ref-type="bibr" rid="CR23">23</xref>]. These data were later supported by a large meta-analysis [<xref ref-type="bibr" rid="CR24">24</xref>] and a subsequent scientific discussion that included a meta-analytic re-interpretation of the evidence [<xref ref-type="bibr" rid="CR25">25</xref>], leading international guidelines to strongly recommend the subclavian site as the first-line choice for central venous catheters [<xref ref-type="bibr" rid="CR5">5</xref>]. In contrast, a recent observational study conducted using a large French ICU database reported no significant difference in catheter-related bloodstream infection rates between insertion sites [<xref ref-type="bibr" rid="CR12">12</xref>]. There could be several reasons for these differences in results. First, this study lacked adjustment for key confounders of both catheter site selection and ultrasound guidance, as performed in the present target trial emulation, increasing the risk of confounding. Second, the reliance on a complete-case analysis in the Cosme et al. study, which excluded over half of the available catheters, introduces a significant risk of selection bias that is mitigated in the present approach [<xref ref-type="bibr" rid="CR26">26</xref>]. Finally, catheter-related bloodstream infection incidence in their cohort was substantially lower than in this study, possibly reflecting differences in population, quality data, practices, or surveillance strategies.</p><p id="Par40">These findings are consistent with the existing literature supporting the systematic use of ultrasound guidance for central venous catheterization [<xref ref-type="bibr" rid="CR6">6</xref>, <xref ref-type="bibr" rid="CR7">7</xref>]. Numerous studies have demonstrated the positive impact of ultrasound guidance across all insertion sites, on both the efficacy and safety of the procedure, particularly in reducing short-term complications [<xref ref-type="bibr" rid="CR27">27</xref>, <xref ref-type="bibr" rid="CR28">28</xref>]. More recently, evidence has emerged that it also contributes to a reduction in late infectious complications. Indeed, the authors conducted a systematic review, meta-analysis, meta-regression and trial sequential analysis, which showed that real-time ultrasound guidance significantly reduces catheter-related infection risk compared to the anatomical landmark technique (relative risk&#x02009;=&#x02009;0.68, 95% confidence interval 0.53&#x02013;0.88.53.88) [<xref ref-type="bibr" rid="CR9">9</xref>]. The conclusiveness of this evidence, as confirmed by the trial sequential analysis, establishes universal ultrasound guidance as the current standard of care and provides the methodological rationale for the decision to emulate a target trial under this specific scenario. A plausible mechanism is that ultrasound guidance reduces the number of skin punctures, procedure failures, damage to surrounding structures (such as arteries, veins, nerves, and lymphatic vessels) and the formation of local hematomas [<xref ref-type="bibr" rid="CR27">27</xref>, <xref ref-type="bibr" rid="CR28">28</xref>], all of which may have a direct or indirect impact on the risk of infection. Multiple skin punctures attempts may promote catheter contamination by skin-resident microorganisms [<xref ref-type="bibr" rid="CR29">29</xref>, <xref ref-type="bibr" rid="CR30">30</xref>], as coagulase-negative staphylococci are the predominant causative agents of ICU-acquired catheter-related bloodstream infection [<xref ref-type="bibr" rid="CR31">31</xref>]. Moreover, repeated catheter insertion failures may increase the risk of breaches in aseptic technique, thereby further contributing to infectious complications.</p><p id="Par41">Despite strong evidence supporting the safety and effectiveness of ultrasound guidance for subclavian catheterization [<xref ref-type="bibr" rid="CR32">32</xref>, <xref ref-type="bibr" rid="CR33">33</xref>], its use remains lower than for internal jugular and femoral access [<xref ref-type="bibr" rid="CR34">34</xref>, <xref ref-type="bibr" rid="CR35">35</xref>]. This underuse likely reflects technical challenges and limited operator confidence resulting from difficulties with ultrasound visualization. Targeted training programs [<xref ref-type="bibr" rid="CR6">6</xref>, <xref ref-type="bibr" rid="CR36">36</xref>, <xref ref-type="bibr" rid="CR37">37</xref>] and emerging ultrasound guidance technologies [<xref ref-type="bibr" rid="CR38">38</xref>] are key to supporting broader adoption of ultrasound-guided subclavian catheterization. Crucially, the benefits of ultrasound guidance are highly operator-dependent [<xref ref-type="bibr" rid="CR9">9</xref>]. Therefore, skill deficits from improper technique, often leading to multiple puncture attempts and hematoma formation, can directly negate the safety advantages of ultrasound guidance. By addressing the training gap explicitly, future work can move beyond showing what's possible to ensuring that it becomes standard practice in ICUs globally.</p></sec><sec id="Sec21"><title>Limitations</title><p id="Par42">This study has some limitations. Although data from an initially randomized study were used, catheter sites that included selective site exclusions based on clinician judgment were analyzed, potentially introducing site selection bias that randomization might not fully mitigate. To address this, a propensity score model to balance the probability of assignment across catheter sites and reduce potential imbalances arising from non-random site selection was applied. Moreover, these results remain robust in sensitivity analyses restricted to patients who were eligible for catheterization at all three sites or at the two sites under comparison. Then, despite the application of causal inference methods, residual unmeasured confounding cannot be excluded. Furthermore, the diagnosis of asymptomatic deep-vein thrombosis depended on the sensitivity of compression ultrasonography, particularly for the subclavian site. It is therefore possible that the incidence of asymptomatic thrombotic events was underestimated in the original 3SITES trial. However, as this diagnostic protocol was applied systematically, the comparison between sites remains pertinent and informative. Finally, the relatively low proportion of real-time ultrasound-guided subclavian catheterization reduced the number of catheters and events in this group, which have limited the number of confounding factors included in adjustment models and decreased the statistical power. For instance, the absence of infectious or thrombotic events in the subclavian group precluded hazard ratio calculation. Similarly, the non-significant difference in major mechanical complications should be interpreted cautiously, as the low overall event rate may have underpowered the analysis to detect a subtle but relevant difference. However, baseline characteristics appeared reasonably balanced across groups, mitigating concerns about major confounding bias. Notably, patients in the subclavian group were on average 4&#x000a0;years older, which would tend to attenuate the observed difference, suggesting that the true effect might actually be greater. Since older age is a risk factor for infectious complications [<xref ref-type="bibr" rid="CR39">39</xref>, <xref ref-type="bibr" rid="CR40">40</xref>], this residual imbalance would tend to bias the results against the subclavian site. The observed benefit for the subclavian approach is therefore likely a conservative estimate.</p></sec><sec id="Sec22"><title>Conclusion</title><p id="Par43">This post hoc emulation of a target trial using data from 3SITES under contemporary conditions of systematic ultrasound guidance provides additional support for the preferential use of the subclavian site for central venous catheterization.</p><p id="Par44">However, translating this evidence into safe, standard clinical practice requires addressing the well-documented training gap in ultrasound-guided subclavian access. Future efforts should therefore focus on implementing systematic training programs and competency assessments to ensure that clinicians can reliably leverage the safety benefits of this approach in ICUs globally.</p><p id="Par45">While this provides a strong, evidence-based hypothesis for re-evaluating clinical practice, the inherent limitations, including low event counts, call for a cautious interpretation. Future large-scale clinical trials are warranted to definitively confirm these findings and further refine site selection strategies.</p></sec><sec id="Sec23" sec-type="supplementary-material"><title>Supplementary Information</title><p>
<supplementary-material content-type="local-data" id="MOESM1"><media xlink:href="13054_2025_5747_MOESM1_ESM.docx"><caption><p>Additional file 1</p></caption></media></supplementary-material>
</p></sec></body><back><glossary><title>Abbreviations</title><def-list><def-item><term>ICU</term><def><p id="Par5">Intensive care unit</p></def></def-item><def-item><term>SAPS II</term><def><p id="Par6">Simplified Acute Physiology Score II</p></def></def-item></def-list></glossary><fn-group><fn><p><bold>Publisher's Note</bold></p><p>Springer Nature remains neutral with regard to jurisdictional claims in published maps and institutional affiliations.</p></fn></fn-group><ack><title>Acknowledgements</title><p>We thank all the nurses, clinical research teams and physicians in the participating centers. We would also like to thank the 3SITES Study Group for their indirect participation in this study: Jean-Jacques Parienti, Nicolas Mongardon, Bruno M&#x000e9;garbane, Jean-Paul Mira, Pierre Kalfon, Antoine Gros, Sophie Marqu&#x000e9;, Marie Thuong, V&#x000e9;ronique Pottier, Michel Ramakers, Benoit Savary, Am&#x000e9;lie Seguin, Xavier Valette, Nicolas Terzi, Bertrand Sauneuf, Vincent Cattoir, Leonard A. Mermel, Damien du Cheyron.</p></ack><notes notes-type="author-contribution"><title>Author contributions</title><p>NB: Conceptualization, Methodology, Formal analysis, Data Curation, Writing-Original Draft. AG: Conceptualization, Methodology, Formal analysis, Writing-Original Draft. JI: Conceptualization, Writing-Review &#x00026; Editing, Data Curation. BL: Conceptualization, Methodology, Writing-Review &#x00026; Editing. HJDG: Conceptualization, Writing-Review &#x00026; Editing DDC: Conceptualization, Writing-Review &#x00026; Editing CR: Conceptualization, Methodology, Writing-Review &#x00026; Editing, Supervision. JJP: Conceptualization, Methodology, Writing-Review &#x00026; Editing, Supervision.</p></notes><notes notes-type="funding-information"><title>Funding</title><p>The original 3SITES study was supported by a grant (PHRC-N 2010, 06-03) from the Hospital Program for Clinical Research, French Ministry of Health. The present study did not receive any additional funding.</p></notes><notes notes-type="data-availability"><title>Data availability</title><p>The datasets used and analyzed during the current study are available from the last author on reasonable request.</p></notes><notes><title>Declarations</title><notes id="FPar1"><title>Ethics approval and consent to participate</title><p id="Par46">The original 3SITES study was approved by the research ethics committee at Caen University. Written informed consent was obtained from all participants or from their proxies in cases of impaired decision-making capacity at the time of enrollment.</p></notes><notes id="FPar2" notes-type="COI-statement"><title>Competing interests</title><p id="Par47">The authors declare no competing interests.</p></notes></notes><ref-list id="Bib1"><title>References</title><ref id="CR1"><label>1.</label><citation-alternatives><element-citation id="ec-CR1" publication-type="journal"><person-group person-group-type="author"><name><surname>Woodfall</surname><given-names>K</given-names></name><name><surname>van Zundert</surname><given-names>A</given-names></name></person-group><article-title>Central venous access: an update on modern techniques to avoid complications</article-title><source>Healthcare</source><year>2025</year><volume>13</volume><issue>10</issue><fpage>1168</fpage><pub-id pub-id-type="doi">10.3390/healthcare13101168</pub-id><pub-id pub-id-type="pmid">40428004</pub-id>

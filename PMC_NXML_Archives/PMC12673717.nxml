</mixed-citation></citation-alternatives></ref><ref id="CR7"><label>7.</label><mixed-citation publication-type="other">Practice Guidelines for Central Venous Access 2020: An Updated Report by the American Society of Anesthesiologists Task Force on Central Venous Access. Anesthesiology. janv 2020;132(1):8&#x02011;43.</mixed-citation></ref><ref id="CR8"><label>8.</label><citation-alternatives><element-citation id="ec-CR8" publication-type="journal"><person-group person-group-type="author"><name><surname>Buetti</surname><given-names>N</given-names></name><name><surname>Marschall</surname><given-names>J</given-names></name><name><surname>Drees</surname><given-names>M</given-names></name><name><surname>Fakih</surname><given-names>MG</given-names></name><name><surname>Hadaway</surname><given-names>L</given-names></name><name><surname>Maragakis</surname><given-names>LL</given-names></name><etal/></person-group><article-title>Strategies to prevent central line-associated bloodstream infections in acute-care hospitals: 2022 update</article-title><source>Infect Control Hosp Epidemiol mai</source><year>2022</year><volume>43</volume><issue>5</issue><fpage>553</fpage><lpage>569</lpage><pub-id pub-id-type="doi">10.1017/ice.2022.87</pub-id></element-citation><mixed-citation id="mc-CR8" publication-type="journal">Buetti N, Marschall J, Drees M, Fakih MG, Hadaway L, Maragakis LL, et al. Strategies to prevent central line-associated bloodstream infections in acute-care hospitals: 2022 update. Infect Control Hosp Epidemiol mai. 2022;43(5):553&#x02013;69.</mixed-citation></citation-alternatives></ref><ref id="CR9"><label>9.</label><citation-alternatives><element-citation id="ec-CR9" publication-type="journal"><person-group person-group-type="author"><name><surname>Boulet</surname><given-names>N</given-names></name><name><surname>Pensier</surname><given-names>J</given-names></name><name><surname>Occean</surname><given-names>BV</given-names></name><name><surname>Peray</surname><given-nam
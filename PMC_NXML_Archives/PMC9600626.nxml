</person-group><article-title>Radiology practices in emergency departments associated with pediatric residency training programs</article-title><source>Pediatr. Emerg. Care</source><year>1995</year><volume>11</volume><fpage>78</fpage><lpage>82</lpage><pub-id pub-id-type="doi">10.1097/00006565-199504000-00005</pub-id><pub-id pub-id-type="pmid">7596882</pub-id></element-citation></ref><ref id="B4-children-09-01496"><label>4.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name><surname>Fleisher</surname><given-names>G.</given-names></name>

<article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="review-article" dtd-version="1.3"><?properties open_access?><processing-meta base-tagset="archiving" mathml-version="3.0" table-model="xhtml" tagset-family="jats"><restricted-by>pmc</restricted-by></processing-meta><front><journal-meta><journal-id journal-id-type="nlm-ta">Curr Cardiol Rep</journal-id><journal-id journal-id-type="iso-abbrev">Curr Cardiol Rep</journal-id><journal-title-group><journal-title>Current Cardiology Reports</journal-title></journal-title-group><issn pub-type="ppub">1523-3782</issn><issn pub-type="epub">1534-3170</issn><publisher><publisher-name>Springer US</publisher-name><publisher-loc>New York</publisher-loc></publisher></journal-meta>

<article-id pub-id-type="doi">10.21873/invivo.14067</article-id><article-categories><subj-group subj-group-type="heading"><subject>Research Article</subject></subj-group></article-categories><title-group><article-title>Development and Characterization of a Murine Lung Adenocarcinoma Cell Line With High Thoracic Pleural Metastatic Potential</article-title></title-group><contrib-group><contrib contrib-type="author" equal-contrib="yes"><name><surname>LIAO</surname><given-names>LIWEI</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>XU</surname><given-names>WEIDONG</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>LI</surname><given-names>JIA</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>LI</surname><given-names>JIAYE</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author" equal-contrib="yes"><name><surname>LI</surname><given-names>RUI</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>LI</surname><given-names>RUIXIA</given-names></name><xref rid="A1" ref-type="aff">1</xref><xref rid="A2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>LI</surname><given-names>CHANG</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>ZHENG</surname><given-names>ZIWEN</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>DENG</surname><given-names>MINGMING</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>MIAO</surname><given-names>JINRUI</given-names></name><xref rid="A1" ref-type="aff">1</xref><xref rid="A2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>WANG</surname><given-names>ZILIN</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>ZHANG</surname><given-names>QIN</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>BIAN</surname><given-names>YIDING</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>WANG</surname><given-names>KAI</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><contrib contrib-type="author"><name><surname>WANG</surname><given-names>HAN</given-names></name><xref rid="A1" ref-type="aff">1</xref><xref rid="A2" ref-type="aff">2</xref></contrib><contrib contrib-type="author"><name><surname>HOU</surname><given-names>GANG</given-names></name><xref rid="A1" ref-type="aff">1</xref></contrib><aff id="A1">
<label>1</label>National Center for Respiratory Medicine, State Key Laboratory of Respiratory Health and Multimorbidity, National Clinical Research Center for Respiratory Diseases, Institute of Respiratory Medicine, Chinese Academy of Medical Sciences, Department of Pulmonary and Critical Care Medicine, China-Japan Friendship Hospital, Beijing, P.R. China</aff><aff id="A2">
<label>2</label>Department of Pulmonary and Critical Care Medicine, Second Affiliated Hospital of Harbin Medical University, Harbin, P.R. China</aff></contrib-group><author-notes><corresp id="cor1">Gang Hou, China Japan Friendship Hospital, No.2 Yinghua East Street, Chaoyang District, Beijing, China. Tel: +86 13840065481, e-mail: <email>hougangcmu@163.com</email>
</corresp></author-notes><pub-date pub-type="epub"><day>28</day><month>8</month><year>2025</year></pub-date><pub-date pub-type="collection"><season>Sep-Oct</season><year>2025</year></pub-date><volume>39</volume><issue>5</issue><fpage>2669</fpage><lpage>2680</lpage><history><date date-type="received"><day>10</day><month>4</month><year>2025</year></date><date date-type="rev-recd"><day>15</day><month>5</month><year>2025</year></date><date date-type="accepted"><day>26</day><month>5</month><year>2025</year></date></history><permissions><copyright-statement>&#x000a9;2025 The Author(s). Published by the International Institute of Anticancer Research.</copyright-statement><copyright-year>2025</copyright-year><license><ali:license_ref xmlns:ali="http://www.niso.org/schemas/ali/1.0/" specific-use="textmining" content-type="ccbyncndlicense">https://creativecommons.org/licenses/by-nc-nd/4.0/</ali:license_ref><license-p>This article is an open access article distributed under the terms and conditions of the Creative Commons Attribution (CC BY-NC-ND) 4.0 international license</license-p></license></permissions><abstract><sec><title>Background/Aim</title><p>Pleural metastasis and malignant pleural effusion (MPE) are common complications of lung adenocarcinoma. Patients with MPE have poor outcomes, with overall survival ranging from 5 to 11.4 months. The lack of established cell lines and stable animal models of pleural metastasis has limited studies on the underlying mechanisms of MPE development. In this study, we aimed to develop a murine lung adenocarcinoma cell line with high thoracic pleural metastatic potential.</p></sec><sec><title>Materials and Methods</title><p>Luciferase-tagged Lewis lung carcinoma (LLC) cells were implanted into the pleural cavity of C57bl/6 mice, with five rounds of subsequent extraction from pleural foci and reinjection into the pleural cavity. The metastatic properties of the established cell line were verified <italic toggle="yes">in vivo</italic> by evaluating the metastatic burden and MPE volume (n=5). <italic toggle="yes">In vitro</italic>, the metastatic ability of cell lines was assessed by scratch assay, transwell migration assay, cell-matrix adhesion assay and cell-cell adhesion assay (3-5 replicates). The transcription profile was characterized by mRNA sequencing. Differential analysis and KEGG enrichment were performed to show their distinctions. Differential genes were verified by quantitative real-time PCR (qPCR).</p></sec><sec><title>Results</title><p>An LLC subpopulation with high thoracic pleural metastatic potential was generated and named LLC-PLM. <italic toggle="yes">In vivo</italic>, compared with parental LLC (LLC-P), LLC-PLM demonstrated a greater incidence of MPE and greater MPE volumes. <italic toggle="yes">In vitro</italic>, LLC-PLM demonstrated increased metastatic capacity and augmented adhesion capacities, compared to LLC-P. Transcriptomic analysis revealed that pathways related to adhesion, migration, and membrane signaling were notably enriched and activated in LLC-PLM cells. Relative genes were obviously activated, including Lamc2, Col4a3, Col6a3, Col1a1, Itga2 and Itga1.</p></sec><sec><title>Conclusion</title><p>We successfully established a murine cell line LLC-PLM that can serve as a valuable tool for studying pleural metastasis and MPE.</p></sec></abstract><kwd-group><kwd>Lung adenocarcinoma</kwd><kwd>pleural metastasis</kwd><kwd>malignant pleural effusion (MPE)</kwd><kwd>murine tumor model</kwd><kwd>Lewis lung carcinoma (LLC)</kwd></kwd-group></article-meta></front><body><sec><title>Introduction</title><p>Lung cancer is the leading cause of cancer mortality worldwide, with a global incidence of 2.2 million cases and 1.8 million deaths in 2020, representing 14.3% (1.4 million) and 8.4% (0.8 million) of all new cancer diagnoses among male and female patients, respectively (<xref rid="R1" ref-type="bibr">1</xref>). At the time of the initial diagnosis, 60% of patients present with distant metastases (<xref rid="R2" ref-type="bibr">2</xref>), and the most common metastatic sites are the brain, thoracic pleura, liver and bone (<xref rid="R3" ref-type="bibr">3</xref>). Patients with pleural metastases always complain of chest pain and shortness of breath, which are common initial symptoms of lung cancer. Furthermore, approximately 50% of patients with pleural metastases present with malignant pleural effusion (MPE) (<xref rid="R4" ref-type="bibr">4</xref>,<xref rid="R5" ref-type="bibr">5</xref>). Patients with MPE have extremely poor survival, with the overall survival (OS) ranging from 5 to 11.4 months (<xref rid="R6" ref-type="bibr">6</xref>,<xref rid="R7" ref-type="bibr">7</xref>). Nevertheless, treatment options for these patients are relatively limited; thus, more efforts should be made to explore novel therapeutic targets and strategies (<xref rid="R8" ref-type="bibr">8</xref>,<xref rid="R9" ref-type="bibr">9</xref>).</p><p>Previously, cancer cells were injected into the pleural cavity to form pleural metastases and MPE (<xref rid="R10" ref-type="bibr">10</xref>,<xref rid="R11" ref-type="bibr">11</xref>). However, this <italic toggle="yes">in vivo</italic> model is not consistent in the production of MPE. The biological behaviors of pleural metastatic cells or MPE cells often exhibit enhanced invasiveness and greater resistance to anticancer treatments, which differ significantly from those of primary tumor cells. Consequently, there is an urgent need for a robust and consistent animal model, as well as an accessible cell line for <italic toggle="yes">in vitro</italic> investigations into novel mechanisms and therapeutic targets.</p><p>Therefore, this study aims to establish a novel <italic toggle="yes">in vitro</italic> model with high pleural metastatic potential and malignant pleural effusion-forming capacity, to provide a useful model for studies on pleural metastasis and MPE. The model was developed using the Lewis lung carcinoma (LLC) cell line, a widely utilized murine lung adeno-carcinoma cell line, as the parental cells, implanted into the pleural cavity of male C57BL/6 mice. To ensure the reliability and feasibility of the established cell line, comprehensive evaluations of its pleural metastatic ability were conducted through <italic toggle="yes">in vitro</italic> and <italic toggle="yes">in vivo</italic> experiments, with comparisons against the parental cells.</p></sec><sec><title>Materials and Methods</title><p><italic toggle="yes">Cell preparation.</italic> LLC cells were cultured at 37&#x002da;C with 5% CO<sub>2</sub>. Roswell Park Memorial Institute 1640 medium (1640) (Gibco Life Technologies, Carlsbad, CA, USA) containing 10% fetal bovine serum was used for LLC cell culture. When the LLC cell confluence ratio reached 80%, the cells were digested, centrifuged, and resuspended in PBS to prepare a cell suspension. The cell concentration was adjusted to 3&#x000d7;10<sup>6</sup> for injection. The cell suspension was kept on ice until implantation.</p><p><italic toggle="yes">Cell injection. </italic>Male C57BL/6 mice (Beijing HFK Bioscience Co., Ltd, Beijing, PR China), aged 6-8 weeks, were purchased and allowed to adapt to the living conditions for 7 days prior to the experiment, during which no additional treatments were administered. The mice were anesthetized by the intraperitoneal injection of 300 &#x000b5;l of tribromoethanol solution. Two to three min later, the right lower thoracic cavity of each mouse was prepared and disinfected, and 50 &#x000b5;l of the cell suspension was vertically injected into the intercostal space between the 7th and 8th ribs at a depth of approximately 0.5 cm. After the injection, the mice were placed on a heating pad and allowed to recover.</p><p><italic toggle="yes">Primary cell extraction. </italic>A tissue sample of pleural metastases from mice was obtained and cut into pieces of approximately 1 mm<sup>3</sup>. The tissue pieces were washed with phosphate-buffered saline (PBS) to remove blood and residual cell debris. Collagenase I (Beijing Solarbio Science &#x00026; Technology Co., Ltd, Beijing, PR China) was used to digest the washed tumor tissue pieces for approximately 40 min. The tumor cells were then centrifuged, resuspended and plated in culture dishes with fresh DMEM.</p><p><italic toggle="yes">Bioluminescent imaging (BLI).</italic> To detect and compare the tumor burdens of mice, noninvasive, whole-body BLI was performed by using a BLT AniView100 system (Guangzhou Biolight Biotechnology Co., Ltd, Guangzhou, PR China) on days 0, 3, 7, and 10. After anesthesia, the mice were injected with luciferin (GlpBio Technology. Co., Ltd, Jinan, PR China) in Dulbecco's phosphate-buffered saline. Skin preparation on the front chest was performed. After 10 min, the mice were placed in the AniView system for a 50-s exposure.</p><p><italic toggle="yes">Scratch assay.</italic> LLC-P and LLC-PLM cells were digested and seeded into six-well plates. When the cell confluence reached approximately 95% or greater, the cells were ready for scratching. A 10-&#x003bc;l pipette tip was used to draw 3-4 parallel lines along a ruler. The plate was washed twice with PBS to remove the detached cells, and then fresh RPMI 1640 medium that contained only 2% serum was added. The scratches were observed and photographed under an inverted microscope at 0 and 24 h after scratching. The scratch width was measured by the ImageJ software. The cell migration rate was calculated as follows: (average width at 0 h - average final scratch width)/average final scratch width.</p><p><italic toggle="yes">Transwell invasion assay. </italic>Matrigel (Corning Incorporated Co., Ltd, Corning, NY, USA) was added to each Transwell insert in advance. The cells were digested and resuspended in serum-free RPMI 1640 medium. Fresh RPMI 1640 medium containing 10% serum was added to each well of a 24-well plate. The inserts were then placed into the 24-well plate. Two hundred microliters of the cell suspension was added to the upper chamber. After 24 h of incubation, the inserts were collected, fixed in methanol for approximately 20 min and washed with PBS. After the cells were stained with crystal violet, the number of migrating cells was calculated under a microscope.</p><p><italic toggle="yes">Cell-matrix adhesion assay. </italic>A 96-well plate was coated with collagen I (Corning Incorporated Co., Ltd.). The cells were digested and resuspended in 1640 medium. A 100-&#x003bc;l cell suspension was added to the precoated 96-well plate for cell adhesion. After incubation for 1 h, the plate was removed from the incubator, and the wells were washed three times with sterile PBS to remove nonadherent cells. The adherent cells were stained with crystal violet and assessed under a microscope.</p><p><italic toggle="yes">Cell-cell adhesion assay. </italic>LLC-P and LLC-PLM cells were digested and resuspended in 1640 medium. A 10-cm culture dish was prepared, with its lid inverted. Twenty-five-microliter droplets of the suspension were placed on the lid, ensuring that they were spaced apart. Five milliliters of the PBS solution was added to the dish to prevent evaporation of the droplets. The lid was carefully closed, allowing the droplets to hang from the lid. Finally, the dish was sealed with parafilm and gently placed in the cell incubator. The formation of cell spheroids was observed under a microscope 24 h later.</p><p><italic toggle="yes">Drug sensitivity evaluation. </italic>LLC-P and LLC-PLM cells were plated in a 96-well plate. After adhesion, DMEM containing 0, 1, 2, or 4 &#x003bc;g/ml cisplatin was added, and the cells were cultured for 2 days. Afterward, 10 &#x000b5;l of the Cell Counting Kit-8 (CCK-8; Dojindo Laboratories Co., Ltd, Kumamoto, Japan) solution was added to each well of the plate. After incubation with the CCK-8 reagent for 2 h, the absorbance was measured with a microplate reader at a wavelength of 450 nm.</p><p><italic toggle="yes">Quantitative polymerase chain reaction (qPCR).</italic> qPCR was performed to measure the mRNA levels of Lamc2, Col4a3, Col6a3, Col1a1, Itga2 and Itga1 in LLC-P and LLC-PLM cells. The primers used were from Sangon Biotech (Shanghai, PR China). qPCR was performed using TB Green Premix Ex Taq II (Takara Holdings Inc, Kusatsu City, Shiga, Japan) in a 10 &#x003bc;l reaction volume containing 5 &#x003bc;l master mix, 0.5 &#x003bc;l each of forward/reverse primers (10 &#x003bc;M), 2 &#x003bc;l cDNA template, and 2 &#x003bc;l nuclease-free water. Amplification was conducted as follows: 95&#x002da;C for 30 s, 40 cycles of 95&#x002da;C for 5 s and 60&#x002da;C for 30 s, followed by melt curve analysis. Data were analyzed using the 2<sup>&#x02212;</sup><sup>&#x00394;&#x00394;Ct </sup>method with three technical replicates per sample.</p><p><italic toggle="yes">Transcriptome sequencing and bioinformatic analysis. </italic>Transcriptome sequencing of LLC-P and LLC-PLM cells was performed by APTBIO Company (Shanghai, PR China). Principal component analysis (PCA), differential analysis, protein-protein network construction, and KEGG and GO enrichment analyses were performed by the Sangerbox platform.</p><p><italic toggle="yes">Statistical analysis. </italic>Continuous data presented as mean&#x000b1;SD. All <italic toggle="yes">in vitro</italic> experiments were performed with a minimum of three biological replicates, while <italic toggle="yes">in vivo</italic> studies utilized groups of five mice per experimental condition. Data analyses were performed with the GraphPad Prism 9 software. Histograms, the Shapiro-Wilk test and the Q-Q (quantile-quantile) test were used to assess the normality of the data distribution. The two groups were compared by <italic toggle="yes">t</italic>-test (normally distributed data) or Mann-Whitney test (nonnormally distributed data). Differences with a <italic toggle="yes">p</italic>-value of &#x0003c;0.05 were considered statistically significant.</p></sec><sec><title>Results</title><p><italic toggle="yes">Establishment and morphological characterization of the LLC-PLM cell line</italic>. To establish a cell line suitable for immunocompetent mice, murine LLC cells were chosen as the parental cell line (LLC-P). Luciferase-labeled LLC cells were implanted into the mouse pleural cavity. Two weeks later, thoracic metastatic foci were harvested from the lung cavity for primary tumor cell extraction. The extracted cells were subsequently reinjected into the pleural cavity. After 5 cycles of extraction and reinjection, a highly efficient murine model of pleural metastasis and MPE was established, providing a suitable tool for the <italic toggle="yes">in vivo</italic> study of MPE. This LLC cell line was named &#x0201c;LLC with high thoracic pleural metastatic ability&#x0201d; (LLC-PLM) (<xref rid="F1" ref-type="fig">Figure 1</xref>). LLC-PLM was deposited in the China Center for Type Culture Collection (CCTCC No. C202487).</p><fig position="float" id="F1"><label>Figure 1</label><caption><p>Process of the construction of a murine lung adenocarcinoma cell line with high thoracic pleural metastatic potential (LLC-PLM).</p></caption><graphic xlink:href="in_vivo-39-2673-g0001" position="float"/></fig><p><italic toggle="yes">Assessment of the thoracic pleural metastatic ability of LLC-PLM in vivo. </italic>To assess the pleural metastatic potential of LLC-PLM <italic toggle="yes">in vivo</italic>, 1&#x000d7;10<sup>5</sup> LLC-P or LLC-PLM cells were injected into the thoracic cavities of 8-10-week-old C57BL/6 mice. Bioluminescent imaging was performed at 0, 3, 7, and 10 days after implantation. At 10 days post-implantation, LLC-PLM yielded a pleural metastasis formation rate of 100% and an MPE rate of 100%, whereas LLC-P presented a pleural metastasis formation rate of 60% and an MPE rate of 40%. Statistical analysis revealed that LLC-PLM markedly increased the tumor burden (<xref rid="F2" ref-type="fig">Figure 2</xref>A-C). The mice were sacrificed on day 14 post-implantation. The tumor volume in the LLC-PLM group was significantly greater than that in the control group (Figure 2D). The pleural effusion (MPE) was aspirated from the thoracic cavity before tumor dissection. MPE production in the LLC-PLM group was obviously greater than that in the LLC-P group (Figure 2E). The primary tumor cells extracted from the lesions were confirmed to have the characteristics of LLC cells by light microscopy (Figure 2F). Taken together, these results revealed the high thoracic pleural metastatic capacity of LLC-PLM cells <italic toggle="yes">in vivo</italic>.</p><fig position="float" id="F2"><label>Figure 2</label><caption><p>Assessment of the thoracic pleural metastatic ability of Lewis lung carcinoma cells with high thoracic pleural metastatic ability (LLC-PLM) in vivo. (A) In vivo bioluminescence-based imaging of pleural metastases formed by LLC-P and LLC-PLM cells. (B) Metastatic growth curve determined by in vivo imaging. (C) Comparison of the tumor burdens after 10 days of LLC-P and LLC-PLM implantation (values represent mean&#x000b1;SD, n=5). (D) Gross image of pleural metastatic lesions (The white dashed curve delineates the MPE, and the white arrow highlights the pleural metastatic lesions). (E) Comparison of the MPE volumes 10 days after implantation of LLC-P and LLC-PLM cells (values represent mean&#x000b1;SD, n=5). (F) Morphology of LLC-P and LLC-PLM cells under optical microscopy.</p></caption><graphic xlink:href="in_vivo-39-2674-g0001" position="float"/></fig><p><italic toggle="yes">Assessment of the metastatic ability of LLC-PLM in vitro. </italic>To assess the pleural metastatic potential of LLC-PLM <italic toggle="yes">in vitro</italic>, scratch and Transwell assays were performed. The results showed that the scratch migration rate and the number of migrating cells in the Transwell chamber were significantly greater in the LLC-PLM group than in the LLC-P group (<xref rid="F3" ref-type="fig">Figure 3</xref>A-D). Therefore, LLC-PLM presented a stronger metastatic ability <italic toggle="yes">in vitro</italic>, compared to LLC-P cells.</p><fig position="float" id="F3"><label>Figure 3</label><caption><p>Assessment of the metastatic and adhesive abilities of LLC-PLM in vitro. (A, B) Representative images and the quantified results (mean&#x000b1;SD, n=3) of the scratch assay with LLC-P and LLC-PLM cells. (C, D) Representative images and the quantified results (mean&#x000b1;SD, n=5) of the transwell assay of LLC-P and LLC-PLM cells. (E, F) Representative images and the quantified results (mean&#x000b1;SD, n=3) of the cell&#x02013;matrix adhesion assay of LLC-P and LLC-PLM cells. (G, H) Representative images and the quantified results (mean&#x000b1;SD, n=3) of the cell-cell adhesion assay for LLC-P and LLC-PLM cells.</p></caption><graphic xlink:href="in_vivo-39-2675-g0001" position="float"/></fig><p><italic toggle="yes">Assessment of the adhesive ability of LLC-PLM in vitro. </italic>Migration of cancer cells relies on cell adhesion interactions, including cell-matrix and cell-cell adhesion. In cell-matrix adhesion assay, there were significantly more remaining LLC-PLM cells than LLC-P cells (Figure 3E, F). In the cell-cell adhesion assay, the LLC-PLM spheroids were obviously denser and rounder than the LLC-P spheroids, suggesting that LLC-PLM had a greater ability to form spheroids (Figure 3G, H). Thus, LLC-PLM exhibited highly adhesive characteristics, with stronger cell-matrix and cell-cell adhesion.</p><p><italic toggle="yes">Assessment of the drug sensitivity of LLC-PLM in vitro. </italic>Although no therapies were applied during the establishment of LLC-PLM, drug treatment is vital in studies on mechanisms of cancer. To perform a more comprehensive evaluation of LLC-PLM, we tested the sensitivity of LLC-PLM and LLC-P to cisplatin, the most commonly used chemotherapy drug for MPE (<xref rid="F4" ref-type="fig">Figure 4</xref>A, B). The results showed no difference between LLC-PLM and LLC-P cells in their sensitivity to cisplatin treatment.</p><fig position="float" id="F4"><label>Figure 4</label><caption><p>Cisplatin sensitivity of LLC-PLM cells. (A) Activity of LLC-PLM and LLC-P cells treated with 0, 1, 2, or 4 &#x003bc;g/ml cisplatin for 2 days. (B) Comparisons of activities of LLC-PLM and LLC-P cells treated with 0 cisplatin for 2 days (data presented as mean&#x000b1;SD, n=3).</p></caption><graphic xlink:href="in_vivo-39-2676-g0001" position="float"/></fig><p><italic toggle="yes">Transcriptomic characterization of LLC-PLM. </italic>As LLC-PLM and LLC-P had the same DNA background but distinct biological behaviors, we explored the differences between the two cell lines at the transcript level via mRNA sequencing. PCA revealed different transcript profiles between LLC-PLM and LLC-P cells (<xref rid="F5" ref-type="fig">Figure 5</xref>A). Differential expression analysis revealed 1100 upregulated and 563 downregulated genes in LLC-PLM (Figure 5B, C). To elucidate the reasons for the functional differences between LLC-PLM and LLC-P, a protein-protein interaction network was constructed (Figure 5D), and KEGG pathway enrichment analysis was performed on the differentially expressed genes (Figure 5E). The results showed that numerous metastatic pathways were enriched, including &#x0201c;cell adhesion molecules&#x0201d;, &#x0201c;ECM-receptor interaction&#x0201d;, &#x0201c;focal adhesion&#x0201d;, &#x0201c;PI3K/Akt signaling pathway&#x0201d;, &#x0201c;calcium signaling pathway&#x0201d; and &#x0201c;JAK/STAT signaling pathway&#x0201d;. Moreover, Gene Ontology (GO) enrichment analysis was performed to further explore gene functions. In the biological process category, &#x0201c;cell adhesion&#x0201d; and &#x0201c;biological adhesion&#x0201d; were significantly enriched, suggesting obvious changes in the adhesion characteristics of LLC-PLM cells (Figure 5F). In the cellular component category, various membrane-associated pathways were enriched, including &#x0201c;cell periphery&#x0201d;, &#x0201c;plasma membrane&#x0201d;, &#x0201c;intrinsic component of the plasma membrane&#x0201d;, &#x0201c;integral component of the plasma membrane&#x0201d;, &#x0201c;intrinsic component of the membrane&#x0201d;, &#x0201c;integral component of the membrane&#x0201d; and &#x0201c;cell surface&#x0201d;, suggesting differences in cell membrane characteristics (Figure 5G). In the molecular function category, pathways related to membrane signaling, including &#x0201c;signaling receptor binding&#x0201d;, &#x0201c;signaling receptor activity&#x0201d;, &#x0201c;transmembrane signaling receptor activity&#x0201d; and &#x0201c;signaling receptor regulator activity&#x0201d;, were enriched (Figure 5H). By overlapping genes related to &#x0201c;cell adhesion molecules&#x0201d;, &#x0201c;ECM-receptor interaction&#x0201d;, and &#x0201c;focal adhesion&#x0201d;, we identified Lamc2, Col4a3, Col6a3, Col1a1, Itga2 and Itga1 as key adhesion-related genes. qRT-PCR confirmed the increased expression levels of these genes in the LLC-PLM cells compared to the LLC-P cells (<xref rid="F6" ref-type="fig">Figure 6</xref>A, B). Therefore, compared to LLC-P, LLC-PLM presented a transcriptome with an activated metastatic signature. Thus, LLC-PLM could be an ideal cell line for studying the molecular mechanisms involved in the pleural metastasis of NSCLC.</p><fig position="float" id="F5"><label>Figure 5</label><caption><p>Transcriptomic characterization of LLC-PLM. (A) PCA of the transcriptomes of LLC-P and LLC-PLM. (B) Volcano plot of identified genes. (C) Differentially expressed genes between LLC-P and LLC-PLM. (D) Protein-protein network of the differentially expressed genes. (E) KEGG pathway enrichment of DEGs between LLC-P and LLC-PLM. (F, H) Gene Ontology enrichment analysis of DEGs between LLC-P and LLC-PLM, involving biological process, cellular component, and molecular function categories.</p></caption><graphic xlink:href="in_vivo-39-2677-g0001" position="float"/></fig><fig position="float" id="F6"><label>Figure 6</label><caption><p>Activation of adhesion-related signaling in LLC-PLM. (A) Activation of adhesion-related signaling in LLC-PLM cells, as revealed by mRNA sequencing. (B) Upregulation of adhesion-related genes in LLC-PLM cells, as measured by qRT-PCR.</p></caption><graphic xlink:href="in_vivo-39-2678-g0001" position="float"/></fig></sec><sec><title>Discussion</title><p>Despite the development of various anticancer therapies, the overall survival of patients with advanced lung adenocarcinoma remains low. The thoracic pleura is a common site of metastasis for lung adenocarcinoma, and MPE is a frequent symptom of pleural metastasis. Once pleural metastasis occurs, patients are diagnosed with advanced lung adenocarcinoma and become ineligible for surgery, transitioning directly to receiving palliative care. In addition, these patients have poor prognosis, with a median survival of only 5-11.4 months. First, MPE always causes dyspnea and chest pain (<xref rid="R12" ref-type="bibr">12</xref>,<xref rid="R13" ref-type="bibr">13</xref>). Second, MPE can lead to progressive protein loss and the development of tumor cachexia (<xref rid="R14" ref-type="bibr">14</xref>,<xref rid="R15" ref-type="bibr">15</xref>). More importantly, due to their unique tumor microenvironment and biological characteristics, the tumor cells in MPE have a high risk of leading to progression and recurrence (<xref rid="R16" ref-type="bibr">16</xref>,<xref rid="R17" ref-type="bibr">17</xref>). Therefore, further studies on pleural metastasis of lung adenocarcinoma should be conducted, and stable <italic toggle="yes">in vitro</italic> and <italic toggle="yes">in vivo</italic> models are urgently needed.</p><p>Previous studies have employed various strategies to establish animal models of pleural metastasis and MPE. With respect to the selection of hosts, human cancer cells have been utilized in severe combined immunodeficient (SCID) mice and athymic (nude) mice with natural cytotoxicity receptor (NCR) deficiencies. These models are advantageous for characterizing human cell lines, particularly patient-derived cancer cells, in the pleural space (<xref rid="R18" ref-type="bibr">18</xref>,<xref rid="R19" ref-type="bibr">19</xref>). However, these models fail to represent the immune micro-environment of the pleural cavity. Immunocompetent hosts, such as New Zealand White (NZW) rabbits and C57BL/6 mice, offer alternatives. The VX2 tumor has been used in NZW rabbits; however, the induction of MPE is suboptimal (<xref rid="R20" ref-type="bibr">20</xref>,<xref rid="R21" ref-type="bibr">21</xref>). In C57BL/6 mice, the LLC cell line is the most commonly used murine lung adenocarcinoma cell line (<xref rid="R22" ref-type="bibr">22</xref>). Therefore, C57BL/6 mice are a suitable host to establish an MPE model relevant to real human status.</p><p>Pleural metastasis models can be established through several methods. One approach involves implantation of a primary tumor in the lung, followed by natural progression to pleural metastasis. While this method more closely mirrors the real metastatic process, it is characterized by a prolonged modeling period and unpredictable metastasis sites, complicating the establishment of models with consistent tumor burdens. An alternative method is direct implantation into the pleural cavity, which ensures the precise delivery of tumor cells and mitigates the risk of random metastases. Traditionally, in this method, an incision is made in the chest wall, and a cell suspension is injected into the lung cavity through this incision (<xref rid="R11" ref-type="bibr">11</xref>). This operation demands operator proficiency and carries risks such as tumor cell dissemination along the wound, pneumothorax, or infection. In our study, we injected tumor cells directly through the intercostal space into the lung cavity (<xref rid="R23" ref-type="bibr">23</xref>), which offers a less invasive, more precise and more convenient method for constructing a murine pleural metastasis/MPE model.</p><p>However, there is no lung adenocarcinoma cell line with high pleural metastatic potential. <italic toggle="yes">In vivo</italic> selection is an effective way to screen for a cancer cell subpopulation. <italic toggle="yes">In vitro</italic>, the selected subpopulation can present distinct biological characteristics from those of its parental cells. Multiple extractions and injections of cells from metastatic foci constitute the mainstream method for constructing highly metastatic cell lines for specific organs. Luminescence imaging is a common noninvasive method for assessing the tumor burden. In this study, luciferase-expressing LLC cells were used as the parental cell line. After five cycles of tumor implantation into the pleural cavity, primary culture, and reinjection, a LLC cell line with a high pleural metastatic ability, LLC-PLM, was ultimately established. Compared with parental LLC-P cells, LLC-PLM cells effectively and stably formed pleural metastases or MPE in an <italic toggle="yes">in vivo</italic> model. Moreover, this cell line had an increased metastatic ability <italic toggle="yes">in vitro</italic> and can serve as an excellent model for <italic toggle="yes">in vitro</italic> experiments.</p><p>In this study, we used a series of <italic toggle="yes">in vitro</italic> experiments including transcriptomic sequencing to explore the reasons for the heightened metastatic potential of LLC-PLM cells. Tumor cell migration relies on the interaction between cells and their microenvironment, which is often mediated by adhesive properties of cells (<xref rid="R24" ref-type="bibr">24</xref>-<xref rid="R26" ref-type="bibr">26</xref>). Critically, the detachment of individual tumor cells commonly activates their apoptosis, thereby inhibiting the proliferation and colonization. Consequently, cells must sustain the activation of survival pathways, such as PI3K signaling, through cell-cell or cell-extracellular matrix interactions (<xref rid="R27" ref-type="bibr">27</xref>,<xref rid="R28" ref-type="bibr">28</xref>). In the thoracic cavity, tumor cells require strong matrix adhesion capabilities or cell-cell adhesion to better colonize the pleura or survive in pleural effusion. Transcriptomic sequencing revealed that LLC-P and LLC-PLM exhibited different transcriptomic profiles. Genes in pathways related to adhesion, migration, and membrane signaling were significantly enriched among the genes differentially expressed between the two lines, confirming our experimental findings. The elevated molecular signals and biomarkers in LLC-PLM warrant further investigation.</p><p>The present study provides a useful tool for studying driver genes and mechanisms of pleural metastasis and MPE. Moreover, LLC-PLM is suitable for identifying the interactions between cancer cells and the pleural microenvironment. Nevertheless, our study has several limitations. First, both the host and the cell line employed in this research were derived from murine strains. Although this combination allows for the construction of a pleural metastasis model in an immunocompetent environment, there is still a gap between this model and real clinical conditions. Second, there is a discrepancy between our model and the natural metastatic process. Under natural conditions, lung adenocarcinoma cells do not enter the pleural cavity directly; rather, they must first invade the blood or lymphatic vessels before migrating to the pleura. Therefore, this model is not suitable for characterizing the initial process of pleural metastasis. Third, no differences in intrinsic cisplatin sensitivity were detected between LLC and LLC-PLM cells. During our establishment of LLC-PLM, no forms of treatment were applied. Without consistent exposure to chemotherapy, cancer cells rarely present drug resistance (<xref rid="R29" ref-type="bibr">29</xref>,<xref rid="R30" ref-type="bibr">30</xref>). Therefore, another limitation of our study is that LLC-PLM may not be appropriate for studies on drug resistance.</p></sec><sec><title>Conclusion</title><p>We developed a murine lung adenocarcinoma cell line, LLC-PLM, with high potential for thoracic pleural metastasis. LLC-PLM may serve as a useful tool for studies on pleural metastases and MPE.</p></sec><sec sec-type="COI-statement"><title>Conflicts of Interest</title><p>The Authors declared no potential conflicts of interest with respect to the research, authorship, and/or publication of this article.</p></sec><sec><title>Authors&#x02019; Contributions</title><p>L.L., W.X, J.L., J.L., R.L., and G.H. conceived and designed the study. L.L., W.X, J.L., R.L., C.L., Z.Z., and M.D. collected samples as well as clinical information. L.L., W.X, J.L., R.L., C.L., J.M., Z.W., J.L., Q.Z., Y.B., H.W., and K.W. performed the experiments. L.L., W.X, J.L., and R.L. analyzed the data. L.L., W.X, J.L., J.L., and R.L. wrote the manuscript. L.L., and G.H. provided intellectual discussions and ideas regarding the content of the manuscript. L.L., and G.H. supervised the study. All Authors read and approved the final version to be published.</p></sec><sec><title>Funding</title><p>This research was supported by National Natural Science Foundation of China (No. 82400041, No. 82400042, No. 82300053), Key Research and Development Program of Heilongjiang (No. 2024ZX12C20), National High Level Hospital Clinical Research Funding (No. 2024-NHLHCRF-JBGS-WZ-05), the Non-profit Central Research Institute Fund of Chinese Academy of Medical Science (No. 2020-PT320-005), CAMS Institute of Respiratory Medicine Grant for Young Scholars (2023-ZF-74).</p></sec><sec><title>Artificial Intelligence (AI) Disclosure</title><p>No artificial intelligence tools, including large language models or machine learning software, were used in the preparation, analysis, or presentation of this manuscript.</p></sec></body><back><ref-list><ref id="R1"><label>1</label><element-citation publication-type="journal" publication-format="print"><person-group person-group-type="author">

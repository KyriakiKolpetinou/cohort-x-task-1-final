<institution content-type="department">Edinburgh Imaging Facility, Queens Medical Research Institute</institution>, <institution specific-use="Ringgold_3124">The University of Edinburgh</institution>, <addr-line content-type="city">Edinburgh</addr-line>, <country>UK</country>

<article xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:mml="http://www.w3.org/1998/Math/MathML" article-type="protocol"><?properties open_access?><front><journal-meta><journal-id journal-id-type="nlm-ta">BMJ Open</journal-id><journal-id journal-id-type="iso-abbrev">BMJ Open</journal-id><journal-id journal-id-type="hwp">bmjopen</journal-id><journal-id journal-id-type="publisher-id">bmjopen</journal-id><journal-title-group><journal-title>BMJ Open</journal-title></journal-title-group><issn pub-type="epub">2044-6055</issn><publisher><publisher-name>BMJ Publishing Group</publisher-name><publisher-loc>BMA House, Tavistock Square, London, WC1H 9JR</publisher-loc></publisher></journal-meta><article-meta><article-id pub-id-type="pmid">31420379</article-id><article-id pub-id-type="pmc">6701577</article-id><article-id pub-id-type="publisher-id">bmjopen-2018-025661</article-id><article-id pub-id-type="doi">10.1136/bmjopen-2018-025661</article-id><article-categories><subj-group subj-group-type="heading"><subject>Radiology and Imaging</subject><subj-group><subject>Protocol</subject></subj-group></subj-group><subj-group subj-group-type="hwp-journal-coll"><subject>1506</subject><subject>1726</subject></subj-group></article-categories><title-group><article-title>Detection of pulmonary nodules: a clinical study protocol to compare ultra-low dose chest CT and standard low-dose CT using ASIR-V</article-title></title-group><contrib-group><contrib id="author-63572211" contrib-type="author"><name><surname>Ludwig</surname><given-names>Marie</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib id="author-64004359" contrib-type="author"><name><surname>Chipon</surname><given-names>Emilie</given-names></name><xref ref-type="aff" rid="aff3">3</xref><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib id="author-64004380" contrib-type="author"><name><surname>Cohen</surname><given-names>Julien</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib id="author-64004391" contrib-type="author"><name><surname>Reymond</surname><given-names>Emilie</given-names></name><xref ref-type="aff" rid="aff1">1</xref></contrib><contrib id="author-64004424" contrib-type="author"><name><surname>Medici</surname><given-names>Maud</given-names></name><xref ref-type="aff" rid="aff3">3</xref><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib id="author-64004440" contrib-type="author"><name><surname>Cole</surname><given-names>Anthony</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib><contrib id="author-64004477" contrib-type="author"><name><surname>Moreau Gaudry</surname><given-names>Alexandre</given-names></name><xref ref-type="aff" rid="aff3">3</xref><xref ref-type="aff" rid="aff4">4</xref></contrib><contrib id="author-64004504" contrib-type="author"><name><surname>Ferretti</surname><given-names>Gilbert</given-names></name><xref ref-type="aff" rid="aff1">1</xref><xref ref-type="aff" rid="aff2">2</xref></contrib></contrib-group><aff id="aff1">
<label>1</label>
<institution content-type="department">Service de radiologie et imagerie m&#x000e9;dicale, p&#x000f4;le imagerie</institution>, <institution>Centre Hospitalier Universitaire Grenoble Alpes</institution>, <addr-line content-type="city">Grenoble</addr-line>, <country>France</country>

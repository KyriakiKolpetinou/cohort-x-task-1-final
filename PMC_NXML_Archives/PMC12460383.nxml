</mixed-citation></citation-alternatives></ref><ref id="CR5"><label>5.</label><citation-alternatives><element-citation id="ec-CR5" publication-type="journal"><person-group person-group-type="author"><name><surname>Carneiro</surname><given-names>BC</given-names></name><name><surname>Rizzetto</surname><given-names>TA</given-names></name><name><surname>Silva</surname><given-names>FD</given-names></name><name><surname>Da Cruz</surname><given-names>IAN</given-names></name><name><surname>Guimar&#x000e3;es</surname><given-names>JB</given-names></name><name><surname>Ormond Filho</surname><given-names>AG</given-names></name><etal/></person-group><article-title>Sacroiliac joint beyond sacroiliitis&#x02014;further insights and old concepts on magnetic resonance imaging</article-title><source>Skeletal Radiol</source><year>2022</year><volume>51</volume><issue>10</issue><fpage>1923</fpage><lpage>1935</lpage><pub-id pub-id-type="doi">10.1007/s00256-022-04067-9</pub-id><pub-id pub-id-type="pmid">35556157</pub-id>
</element-citation><mixed-citation id="mc-CR5" publication-type="journal">Carneiro BC, Rizzetto TA, Silva FD, Da Cruz IAN, Guimar&#x000e3;es JB, Ormond Filho AG, et al. Sacroiliac joint beyond sacroiliitis&#x02014;further insights and old concepts on magnetic resonance imaging. Skeletal Radiol. 2022;51(10):1923&#x02013;35.<pub-id pub-id-type="pmid">35556157</pub-id>
</mixed-citation></citation-alternatives></ref><ref id="CR6"><label>6.</label><citation-alternatives><element-citation id="ec-CR6" publication-type="journal"><person-group person-group-type="author"><name><surname>Egund</surname><given-names>N</given-names></name><name><surname>Jurik</surname><given-names>A</given-names></name></person-group><article-title>Anatomy and histology of the sacroiliac joints</article-title><source>Semin Musculoskelet Radiol</source><year>2014</year><volume>18</volume><issue>03</issue><fpage>332</fpage><lpage>340</lpage><pub-id pub-id-type="doi">10.1055/s-0034-1375574</pub-id><pub-id pub-id-type="pmid">24896748</pub-id>

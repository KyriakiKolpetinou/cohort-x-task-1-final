</mixed-citation></citation-alternatives></ref><ref id="CR9"><label>9.</label><mixed-citation publication-type="other">Bahadoram S, Davoodi M, Hassanzadeh S, Bahadoram M, Barahman M, Mafakher L. Renal cell carcinoma: an overview of the epidemiology, diagnosis, and treatment. G Ital Nefrol. 2022;39(3).</mixed-citation></ref><ref id="CR10"><label>10.</label><citation-alternatives><element-citation id="ec-CR10" publication-type="journal"><person-group person-group-type="author"><name><surname>Znaor</surname><given-names>A</given-names></name><name><surname>Lortet-Tieulent</surname><given-names>J</given-names></name><name><surname>Laversanne</surname><given-names>M</given-names></name><name><surname>Jemal</surname><given-names>A</given-names></name><name><surname>Bray</surname><given-names>F</given-names></name></person-group><article-title>International variations and trends in renal cell carcinoma incidence and mortality</article-title><source>Eur Urol</source><year>2015</year><volume>67</volume><issue>3</issue><fpage>519</fpage><lpage>530</lpage><pub-id pub-id-type="doi">10.1016/j.eururo.2014.10.002</pub-id><pub-id pub-id-type="pmid">25449206</pub-id>

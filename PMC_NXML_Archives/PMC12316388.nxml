d><td align="left" rowspan="1" colspan="1">230 (43.2)</td></tr><tr><td align="left" rowspan="1" colspan="1">TST performed</td><td align="left" rowspan="1" colspan="1">1,019 (64.1)</td><td align="left" rowspan="1" colspan="1">453 (95.6)</td><td align="left" rowspan="1" colspan="1">563 (96.6)</td><td align="left" rowspan="1" colspan="1">3 (0.6)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Result: 0&#x02013;4 mm</td><td align="left" rowspan="1" colspan="1">436 (42.8)</td><td align="left" rowspan="1" colspan="1">192 (42.4)</td><td align="left" rowspan="1" colspan="1">243 (43.2)</td><td align="left" rowspan="1" colspan="1">1 (33.3)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;5&#x02013;9 mm</td><td align="left" rowspan="1" colspan="1">190 (18.6)</td><td align="left" rowspan="1" colspan="1">79 (17.4)</td><td align="left" rowspan="1" colspan="1">110 (19.5)</td><td align="left" rowspan="1" colspan="1">1 (33.3)</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;&#x02265;10 mm</td><td align="left" rowspan="1" colspan="1">393 (38.6)</td><td align="left" rowspan="1" colspan="1">182 (40.2)</td><td align="left" rowspan="1" colspan="1">210 (37.3)</td><td align="left" rowspan="1" colspan="1">1 (33.3)</td></tr></tbody></table></alternatives><table-wrap-foot><fn id="t001fn001"><p>* Ever smoker includes current and ex-smokers.</p></fn><fn id="t001fn002"><p><italic toggle="yes">Abbreviations:</italic> BMI, body mass index; IQR, inter-quartile range; TST, tuberculin skin test.</p></fn></table-wrap-foot></table-wrap><table-wrap position="float" id="pmed.1004666.t002"><object-id pub-id-type="doi">10.1371/journal.pmed.1004666.t002</object-id><label>Table 2</label><caption><title>Main outcomes: completing investigations, diagnoses, and TPT initiation.</title></caption><alternatives><graphic xlink:href="pmed.1004666.t002" id="pmed.1004666.t002g" position="float"/><table frame="hsides" rules="groups"><colgroup span="1"><col align="left" valign="
source>J Cardiovasc Comput Tomogr</source><year>2016</year><volume>10</volume><issue>5</issue><fpage>384</fpage><lpage>385</lpage><pub-id pub-id-type="doi">10.1016/j.jcct.2016.07.017</pub-id><pub-id pub-id-type="pmid">27495380</pub-id></element-citation></ref><ref id="CR13"><label>13.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Schmermund</surname><given-names>A</given-names></name><name><surname>Eckert</surname><given-names>J</given-names></name><name><surname>Schmidt</surname><given-names>M</given-names></name><name><surname>Magedanz</surname><given-names>A</given-names></name><name><surname>Voigtl&#x000e4;nder</surname><given-names>T</given-names></name></person-group><article-title>Coronary computed tomography angiography: a method coming of age</article-title><source>Clin Res Cardiol</source><year>2018</year><volume>107</volume><issue>2</issue><fpage>40</fpage><lpage>48</lpage><pub-id pub-id-type="doi">10.1007/s00392-018-1320-5</pub-id><pub-id pub-id-type="pmid">29974195</pub-id></element-citation></ref><ref id="CR14"><label>14.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Werner</surname><given-names>N</given-names></name><name><surname>Nickenig</surname><given-names>G</given-names></name><name><surname>Sinning</surname><given-names>JM</given-names></name></person-group><article-title>Complex PCI procedures: challenges for the interventional cardiologist</article-title><source>Clin Res Cardiol</source><year>2018</year><volume>107</volume><issue>2</issue><fpage>64</fpage><lpage>73</lpage><pub-id pub-id-type="doi">10.1007/s00392-018-1316-1</pub-id><pub-id pub-id-type="pmid">29978353</pub-id></element-citation></ref><ref id="CR15"><label>15.</label><element-citation publication-type="journal"><person-group person-group-type="author"><name><surname>Dou</surname><given-names>K</given-names></name><name><surname>Zhang</surname><given-names>D
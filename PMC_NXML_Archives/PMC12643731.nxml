pan="1">104 (92, 120)</td><td align="center" rowspan="1" colspan="1">106.5 (97, 120)</td><td align="center" rowspan="1" colspan="1">.17</td></tr><tr><td align="left" rowspan="1" colspan="1">Systolic blood pressure (mm Hg), Median (Q1, Q3)</td><td align="center" rowspan="1" colspan="1">96 (89, 109)</td><td align="center" rowspan="1" colspan="1">100 (90, 112)</td><td align="center" rowspan="1" colspan="1">91 (87, 100)</td><td align="center" rowspan="1" colspan="1">&#x0003c;.001</td></tr><tr><td align="left" rowspan="1" colspan="1">Diastolic pressure (mm Hg), Median (Q1, Q3)</td><td align="center" rowspan="1" colspan="1">55 (48, 63)</td><td align="center" rowspan="1" colspan="1">57 (50, 65.25)</td><td align="center" rowspan="1" colspan="1">52 (47, 59)</td><td align="center" rowspan="1" colspan="1">&#x0003c;.001</td></tr><tr><td align="left" rowspan="1" colspan="1">Headache, n (%)</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">1</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;No</td><td align="center" rowspan="1" colspan="1">505 (98.6)</td><td align="center" rowspan="1" colspan="1">347 (98.6)</td><td align="center" rowspan="1" colspan="1">158 (98.8)</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;Yes</td><td align="center" rowspan="1" colspan="1">7 (1.4)</td><td align="center" rowspan="1" colspan="1">5 (1.4)</td><td align="center" rowspan="1" colspan="1">2 (1.2)</td><td align="center" rowspan="1" colspan="1"/></tr><tr><td align="left" rowspan="1" colspan="1">Dizziness, n (%)</td><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1"/><td align="center" rowspan="1" colspan="1">.565</td></tr><tr><td align="left" rowspan="1" colspan="1">&#x02003;No</td><td align="center" rowspan="1" colspan="1">4
ar="(" rowspan="1" colspan="1">31 (31)</td><td align="char" char="(" rowspan="1" colspan="1">61 (31)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;T4</td><td align="char" char="(" rowspan="1" colspan="1">5 (5)</td><td align="char" char="(" rowspan="1" colspan="1">14 (7)</td></tr><tr><td rowspan="1" colspan="1">N-classification, No. (%)</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;N0</td><td align="char" char="(" rowspan="1" colspan="1">62 (63)</td><td align="char" char="(" rowspan="1" colspan="1">123 (63)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;N1</td><td align="char" char="(" rowspan="1" colspan="1">15 (15)</td><td align="char" char="(" rowspan="1" colspan="1">38 (19)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;N2</td><td align="char" char="(" rowspan="1" colspan="1">22 (22)</td><td align="char" char="(" rowspan="1" colspan="1">35 (18)</td></tr><tr><td rowspan="1" colspan="1">Stage</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;II</td><td align="char" char="(" rowspan="1" colspan="1">32 (32)</td><td align="char" char="(" rowspan="1" colspan="1">74 (38)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;III</td><td align="char" char="(" rowspan="1" colspan="1">40 (41)</td><td align="char" char="(" rowspan="1" colspan="1">78 (40)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;IV</td><td align="char" char="(" rowspan="1" colspan="1">27 (27)</td><td align="char" char="(" rowspan="1" colspan="1">44 (22)</td></tr><tr><td rowspan="1" colspan="1">Primary tumor size, cc</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;GTVp, cc (IQR; range)</td><td align="char" char="(" rowspan="1" colspan="1">7.1 (4.2-13.2; 0.8-41)</td><td align="char" char="(" rowspan="1" colspan="1">6.1 (3.4-10.8; 0.5-82)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;BTVp, cc (IQR; range)</td><td align="char" char="(" rowspan="1" colspan="1">7.4 (3.5-15.9; 0.5-56)</td><td align="char" char="(" rowspan="1" colspan="1">6.4 (3.6-11.8; 0.5-70)</td></tr><tr><td rowspan="1" colspan="1">Fractionation schedule</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;33 fractions in 5 weeks, No. (%)</td><td align="char" char="(" rowspan="1" colspan="1">15 (15)</td><td align="char" char="(" rowspan="1" colspan="1">23 (12)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;OTT, days (95% CI)</td><td align="char" char="(" rowspan="1" colspan="1">32.2 (30.1 to 34.3)</td><td align="char" char="(" rowspan="1" colspan="1">32.0 (32.0 to 32.0)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;34 fractions in 5.5 weeks, No. (%)</td><td align="char" char="(" rowspan="1" colspan="1">84 (85)</td><td align="char" char="(" rowspan="1" colspan="1">173 (88)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;OTT, days (95% CI)</td><td align="char" char="(" rowspan="1" colspan="1">36.0 (30.1 to 41.9)</td><td align="char" char="(" rowspan="1" colspan="1">36.3 (34.8 to 37.8)</td></tr><tr><td rowspan="1" colspan="1">PTV low-risk (elective nodes)</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;Dmean, Gy (95% CI)</td><td align="char" char="(" rowspan="1" colspan="1">51.1 (48.6 to 53.5)</td><td align="char" char="(" rowspan="1" colspan="1">44.9 (42.8 to 47.1)</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Coverage V95%, % (95% CI)</td><td align="char" char="(" rowspan="1" colspan="1">98.8 (96.6 to 100)</td><td align="char" char="(" rowspan="1" colspan="1">99.0 (98.0 to 100)</td></tr></tbody></table><table-wrap-foot><fn fn-type="abbr"><p>Abbreviations: BTVp, biological target volume of primary tumor; GTVp, gross tumor volume of primary tumor; HPV, human papilloma virus; OTT, overall treatment time; PTV, planning target volume.</p></fn></table-wrap-foot></table-wrap><table-wrap position="float" id="tbl2"><label>TABLE 2.</label><caption><p>Main Outcome Results</p></caption><table frame="hsides" rules="groups"><thead valign="bottom"><tr><th rowspan="1" colspan="1">Primary Outcome</th><th align="center" rowspan="1" colspan="1">Control Group (n = 73)</th><th align="center" rowspan="1" colspan="1">Dose Reduction Group (n = 146)</th><th align="center" rowspan="1" colspan="1">Mean Difference (95% CI)</th><th align="center" rowspan="1" colspan="1">
<italic toggle="yes">P</italic>
</th></tr></thead><tbody valign="top"><tr><td rowspan="1" colspan="1">Normalcy of diet score of PSS-HN, mean score at 1 year (95% CI)</td><td align="char" char="(" rowspan="1" colspan="1">92.6 (88.2 to 97.1)</td><td align="char" char="(" rowspan="1" colspan="1">91.6 (88.5 to 94.7)</td><td align="char" char="(" rowspan="1" colspan="1">&#x02013;1.07 (&#x02013;6.48 to 4.35)</td><td align="char" char="." rowspan="1" colspan="1">.698</td></tr><tr><td rowspan="1" colspan="1">Secondary outcome</td><td align="center" rowspan="1" colspan="1">n = 99</td><td align="center" rowspan="1" colspan="1">n = 196</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;Recurrence in electively irradiated nodes, 2-year rate (upper-bound one-sided 95% CI)</td><td align="char" char="(" rowspan="1" colspan="1">4.3 (7.7)<xref rid="tblfn1" ref-type="table-fn"><sup>a</sup></xref></td><td align="char" char="(" rowspan="1" colspan="1">4.9 (7.5)<xref rid="tblfn1" ref-type="table-fn"><sup>a</sup></xref></td><td rowspan="1" colspan="1"/><td align="char" char="." rowspan="1" colspan="1">.005<xref rid="tblfn1" ref-type="table-fn"><sup>a</sup></xref></td></tr><tr><td rowspan="1" colspan="1">Exploratory outcomes</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">Control of disease and survival, 2-year rate (95% CI)</td><td align="center" rowspan="1" colspan="1">n = 99</td><td align="center" rowspan="1" colspan="1">n = 196</td><td align="center" rowspan="1" colspan="1">HR (95% CI)</td><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;Local control (primary tumor)</td><td align="char" char="(" rowspan="1" colspan="1">84.5 (77.4 to 92.3)</td><td align="char" char="(" rowspan="1" colspan="1">81.4 (76.0 to 87.2)</td><td align="char" char="(" rowspan="1" colspan="1">1.28 (0.69 to 2.40)</td><td align="char" char="." rowspan="1" colspan="1">.433</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Regional control (overall)<xref rid="tblfn2" ref-type="table-fn"><sup>b</sup></xref></td><td align="char" char="(" rowspan="1" colspan="1">91.5 (86.0 to 97.3)</td><td align="char" char="(" rowspan="1" colspan="1">90.4 (86.3 to 94.8)</td><td align="char" char="(" rowspan="1" colspan="1">1.10 (0.48 to 2.50)</td><td align="char" char="." rowspan="1" colspan="1">.819</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Regional control (intermediate-risk nodes)<xref rid="tblfn3" ref-type="table-fn"><sup>c</sup></xref></td><td align="center" rowspan="1" colspan="1">NA</td><td align="char" char="(" rowspan="1" colspan="1">94.5 (87.1 to 100)</td><td align="center" rowspan="1" colspan="1">NA</td><td align="center" rowspan="1" colspan="1">NA</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Regional control (elective nodes)</td><td align="char" char="(" rowspan="1" colspan="1">95.7 (91.6 to 99.9)</td><td align="char" char="(" rowspan="1" colspan="1">95.1 (92.0 to 98.3)</td><td align="char" char="(" rowspan="1" colspan="1">1.11 (0.34 to 3.60)</td><td align="char" char="." rowspan="1" colspan="1">.865</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Distant control</td><td align="char" char="(" rowspan="1" colspan="1">91.4 (85.9 to 97.3)</td><td align="char" char="(" rowspan="1" colspan="1">91.0 (87.0 to 95.2)</td><td align="char" char="(" rowspan="1" colspan="1">1.06 (0.46 to 2.40)</td><td align="char" char="." rowspan="1" colspan="1">.899</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Recurrence-free survival</td><td align="char" char="(" rowspan="1" colspan="1">77.5 (69.5 to 86.5)</td><td align="char" char="(" rowspan="1" colspan="1">73.4 (67.4 to 80.0)</td><td align="char" char="(" rowspan="1" colspan="1">1.23 (0.74 to 2.00)</td><td align="char" char="." rowspan="1" colspan="1">.425</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Overall survival</td><td align="char" char="(" rowspan="1" colspan="1">78.7 (71.0 to 87.2)</td><td align="char" char="(" rowspan="1" colspan="1">83.3 (78.1 to 88.7)</td><td align="char" char="(" rowspan="1" colspan="1">0.83 (0.49 to 1.40)</td><td align="char" char="." rowspan="1" colspan="1">.483</td></tr><tr><td rowspan="1" colspan="1">Acute toxicity (grade &#x02265; 3), %</td><td align="center" rowspan="1" colspan="1">n = 99</td><td align="center" rowspan="1" colspan="1">n = 196</td><td align="center" rowspan="1" colspan="1">RR (95% CI)</td><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;Dermatitis</td><td align="center" rowspan="1" colspan="1">7.1</td><td align="center" rowspan="1" colspan="1">6.6</td><td align="char" char="(" rowspan="1" colspan="1">0.94 (0.39 to 2.28)</td><td align="char" char="." rowspan="1" colspan="1">.888</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Mucositis</td><td align="center" rowspan="1" colspan="1">65.7</td><td align="center" rowspan="1" colspan="1">62.2</td><td align="char" char="(" rowspan="1" colspan="1">0.95 (0.79 to 1.13)</td><td align="char" char="." rowspan="1" colspan="1">.560</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Dysphagia (requiring tube feeding)</td><td align="center" rowspan="1" colspan="1">19.2</td><td align="center" rowspan="1" colspan="1">10.7</td><td align="char" char="(" rowspan="1" colspan="1">0.56 (0.32 to 0.98)</td><td align="char" char="." rowspan="1" colspan="1">.046</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Any of above</td><td align="center" rowspan="1" colspan="1">68.7</td><td align="center" rowspan="1" colspan="1">67.3</td><td align="char" char="(" rowspan="1" colspan="1">0.98 (0.83 to 1.16)</td><td align="char" char="." rowspan="1" colspan="1">.815</td></tr><tr><td rowspan="1" colspan="1">Late toxicity (grade &#x02265; 3), 2-year rate (95% CI)</td><td align="center" rowspan="1" colspan="1">n = 99</td><td align="center" rowspan="1" colspan="1">n = 196</td><td align="center" rowspan="1" colspan="1">HR (95% CI)</td><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;Mucosal ulceration</td><td align="char" char="(" rowspan="1" colspan="1">4.6 (0.3 to 8.9)</td><td align="char" char="(" rowspan="1" colspan="1">4.8 (1.7 to 7.9)</td><td align="char" char="(" rowspan="1" colspan="1">1.06 (0.33 to 3.44)</td><td align="char" char="." rowspan="1" colspan="1">.923</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Laryngeal chondronecrosis</td><td align="char" char="(" rowspan="1" colspan="1">2.3 (0.0 to 5.4)</td><td align="char" char="(" rowspan="1" colspan="1">1.1 (0.0 to 2.7)</td><td align="char" char="(" rowspan="1" colspan="1">0.48 (0.10 to 2.39)</td><td align="char" char="." rowspan="1" colspan="1">.371</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Mandibular osteonecrosis</td><td align="char" char="(" rowspan="1" colspan="1">1.1 (0.0 to 3.3)</td><td align="char" char="(" rowspan="1" colspan="1">1.0 (0.0 to 2.4)</td><td align="char" char="(" rowspan="1" colspan="1">0.98 (0.09 to 10.8)</td><td align="char" char="." rowspan="1" colspan="1">.985</td></tr><tr><td rowspan="1" colspan="1">&#x02003;Any of above</td><td align="char" char="(" rowspan="1" colspan="1">6.6 (1.5 to 11.7)</td><td align="char" char="(" rowspan="1" colspan="1">6.3 (2.8 to 9.8)</td><td align="char" char="(" rowspan="1" colspan="1">0.97 (0.37 to 2.59)</td><td align="char" char="." rowspan="1" colspan="1">.957</td></tr></tbody></table><table-wrap-foot><fn fn-type="abbr"><p>Abbreviations: HR, hazard ratio; NA, not applicable; PSS-HN, Performance Status Scale for Head and Neck; RR, relative risk.</p></fn><fn id="tblfn1" fn-type="other"><label>
<sup>a</sup>
</label><p><italic toggle="yes">P</italic> value indicates statistically significantly lower recurrence rate in the dose reduction group compared with the prespecified boundary for acceptability of 9% and thus is considered safe. Estimate for the control group was also reported for completeness, but was not part of the secondary outcome.</p></fn><fn id="tblfn2" fn-type="other"><label>
<sup>b</sup>
</label><p>Overall regional control includes all regional recurrences as events (ie, independent of nodal risk classification).</p></fn><fn id="tblfn3" fn-type="other"><label>
<sup>c</sup>
</label><p>Regional control in intermediate-risk lymph nodes was calculated in the 39 patients who had intermediate-risk nodes.</p></fn></table-wrap-foot></table-wrap><p>The mean normalcy of diet score (primary outcome) at 1 year was 91.6 (95% CI, 88.5 to 94.7) in the dose reduction group and 92.6 (95% CI, 88.2 to 97.1) in the control group (mean difference, &#x02013;1.1 [95% CI, &#x02013;6.5 to 4.4]). The 2-year recurrence rate in electively irradiated LNs (secondary outcome) was 4.9% (upper-bound one-sided 95% CI, 7.5%) in the dose reduction group. The upper-bound one-sided 95% CI did not exceed the prespecified boundary for acceptability (9%), thus confirming reduced dose is safe. In the control group, this was 4.3% (upper bound one-sided 95% CI, 7.7%). Comparison between groups demonstrated an HR of 1.11 (95% CI, 0.34 to 3.60; Fig <xref rid="fig2" ref-type="fig">2</xref>A). Characteristics of cases with recurrence in electively irradiated LNs are shown in Table <xref rid="tbl3" ref-type="table">3</xref>. The majority of these recurrences occurred synchronously with recurrence in the gross primary tumor (GTV; ie, primary tumor and/or high-risk LNs; HR, 25.8 [95% CI, 5.7 to 116], <italic toggle="yes">P</italic> &#x0003c; .001). Results of other recurrence and survival analysis are shown in Figure <xref rid="fig2" ref-type="fig">2</xref>.</p><fig position="float" id="fig2" fig-type="figure"><label>FIG 2.</label><caption><p>Control of disease and survival. <sup>a</sup>Overall regional control includes all regional recurrences as events (ie, independent of nodal risk classification). HR, hazard ratio.</p></caption><graphic xlink:href="jco-43-2583-g002" position="float"/></fig><table-wrap position="float" id="tbl3"><label>TABLE 3.</label><caption><p>Characteristics of Cases With Recurrence in Electively Irradiated Nodes</p></caption><table frame="hsides" rules="groups"><thead valign="bottom"><tr><th rowspan="2" colspan="1">Sex (age, years), Tumor Site and Stage</th><th rowspan="2" align="center" colspan="1">Synchronous Recurrence in GTV</th><th colspan="5" align="center" rowspan="1">Pretreatment Characteristics of Electively Irradiated Lymph Nodes in Which Recurrences Occurred<xref rid="tblfn4" ref-type="table-fn"><sup>a</sup></xref></th></tr><tr><th align="center" rowspan="1" colspan="1">Neck Level</th><th align="center" rowspan="1" colspan="1">Summed Diameter, mm (short- and long-axis diameter)</th><th align="center" rowspan="1" colspan="1">Volume, cc</th><th align="center" rowspan="1" colspan="1">Tumor to Background Ratio on FDG-PET</th><th align="center" rowspan="1" colspan="1">Dmean, Gy</th></tr></thead><tbody valign="top"><tr><td rowspan="1" colspan="1">Control group</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="4" colspan="1">&#x02003;M (72), hypopharynx, T2N2b</td><td rowspan="4" colspan="1">Yes (primary)</td><td rowspan="1" colspan="1">IV</td><td align="char" char="(" rowspan="1" colspan="1">6 (3 &#x000d7; 3)</td><td align="char" char="." rowspan="1" colspan="1">0.05</td><td align="char" char="." rowspan="1" colspan="1">0.48</td><td align="char" char="." rowspan="1" colspan="1">48.1</td></tr><tr><td rowspan="1" colspan="1">IV</td><td align="char" char="(" rowspan="1" colspan="1">9 (3 &#x000d7; 6)</td><td align="char" char="." rowspan="1" colspan="1">0.17</td><td align="char" char="." rowspan="1" colspan="1">0.49</td><td align="char" char="." rowspan="1" colspan="1">48.5</td></tr><tr><td rowspan="1" colspan="1">VIa</td><td align="char" char="(" rowspan="1" colspan="1">8 (3 &#x000d7; 5)</td><td align="char" char="." rowspan="1" colspan="1">0.06</td><td align="char" char="." rowspan="1" colspan="1">0.81</td><td align="char" char="." rowspan="1" colspan="1">51.7</td></tr><tr><td rowspan="1" colspan="1">VIb</td><td align="char" char="(" rowspan="1" colspan="1">14 (5 &#x000d7; 9)</td><td align="char" char="." rowspan="1" colspan="1">0.68</td><td align="char" char="." rowspan="1" colspan="1">0.73</td><td align="char" char="." rowspan="1" colspan="1">47.7</td></tr><tr><td rowspan="1" colspan="1">&#x02003;F (72), oropharynx, T3N2c (HPV+)</td><td rowspan="1" colspan="1">Yes (primary and node)</td><td rowspan="1" colspan="1">IV</td><td align="char" char="(" rowspan="1" colspan="1">12 (6 &#x000d7; 6)</td><td align="char" char="." rowspan="1" colspan="1">0.30</td><td align="char" char="." rowspan="1" colspan="1">1.14</td><td align="char" char="." rowspan="1" colspan="1">50.8</td></tr><tr><td rowspan="1" colspan="1">&#x02003;M (57), oropharynx, T2N2b (HPV+)</td><td rowspan="1" colspan="1">Yes (primary)</td><td rowspan="1" colspan="1">II</td><td align="char" char="(" rowspan="1" colspan="1">15 (7 &#x000d7; 8)</td><td align="char" char="." rowspan="1" colspan="1">0.95</td><td align="char" char="." rowspan="1" colspan="1">1.54</td><td align="char" char="." rowspan="1" colspan="1">50.6</td></tr><tr><td rowspan="1" colspan="1">&#x02003;M (71), oropharynx, T2N2c (HPV+)</td><td rowspan="1" colspan="1">Yes (node)</td><td rowspan="1" colspan="1">III</td><td align="char" char="(" rowspan="1" colspan="1">10 (3 &#x000d7; 7)</td><td align="char" char="." rowspan="1" colspan="1">0.21</td><td align="char" char="." rowspan="1" colspan="1">0.99</td><td align="char" char="." rowspan="1" colspan="1">51.3</td></tr><tr><td rowspan="1" colspan="1">Dose reduction group</td><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/><td rowspan="1" colspan="1"/></tr><tr><td rowspan="1" colspan="1">&#x02003;F (67), larynx, T2N1</td><td rowspan="1" colspan="1">No</td><td rowspan="1" colspan="1">II</td><td align="char" char="(" rowspan="1" colspan="1">18 (6 &#x000d7; 12)</td><td align="char" char="." rowspan="1" colspan="1">0.93</td><td align="char" char="." rowspan="1" colspan="1">1.15</td><td align="char" char="." rowspan="1" colspan="1">45.0</td></tr><tr><td rowspan="1" colspan="1">&#x02003;M (79), oropharynx, T2N0 (HPV+)</td><td rowspan="1" colspan="1">No (synchronous new oral cancer)<xref rid="tblfn5" ref-type="table-fn"><sup>b</sup></xref></td><td rowspan="1" colspan="1">II</td><td align="char" char="(" rowspan="1" colspan="1">13 (4 &#x000d7; 9)</td><td align="char" char="." rowspan="1" colspan="1">0.50</td><td align="char" char="." rowspan="1" colspan="1">0.78</td><td align="char" char="." rowspan="1" colspan="1">42.7</td></tr><tr><td rowspan="2" colspan="1">&#x02003;M (68), larynx, T2N2c</td><td rowspan="2" colspan="1">Yes (node)</td><td rowspan="1" colspan="1">II</td><td align="char" char="(" rowspan="1" colspan="1">10 (5 &#x000d7; 5)</td><td align="char" char="." rowspan="1" colspan="1">0.15</td><td align="char" char="." rowspan="1" colspan="1">0.79</td><td align="char" char="." rowspan="1" colspan="1">45.4</td></tr><tr><td rowspan="1" colspan="1">VIa</td><td align="char" char="(" rowspan="1" colspan="1">10 (4 &#x000d7; 6)</td><td align="char" char="." rowspan="1" colspan="1">0.08</td><td align="char" char="." rowspan="1" colspan="1">0.69</td><td align="char" char="." rowspan="1" colspan="1">53.8</td></tr><tr><td rowspan="1" colspan="1">&#x02003;M (82), oropharynx, T3N1 (HPV+)</td><td rowspan="1" colspan="1">Yes (primary and node)</td><td rowspan="1" colspan="1">II</td><td align="char" char="(" rowspan="1" colspan="1">14 (4 &#x000d7; 10)</td><td align="char" char="." rowspan="1" colspan="1">0.51</td><td align="char" char="." rowspan="1" colspan="1">1.65</td><td align="char" char="." rowspan="1" colspan="1">47.1</td></tr><tr><td rowspan="2" colspan="1">&#x02003;M (75), larynx, T3N0</td><td rowspan="2" colspan="1">Yes (primary)</td><td rowspan="1" colspan="1">II</td><td align="char" char="(" rowspan="1" colspan="1">9 (3 &#x000d7; 6)</td><td align="char" char="." rowspan="1" colspan="1">0.13</td><td align="char" char="." rowspan="1" colspan="1">1.18</td><td align="char" char="." rowspan="1" colspan="1">49.2</td></tr><tr><td rowspan="1" colspan="1">III</td><td align="char" char="(" rowspan="1" colspan="1">7 (3 &#x000d7; 4)</td><td align="char" char="." rowspan="1" colspan="1">0.10</td><td align="char" char="." rowspan="1" colspan="1">0.99</td><td align="char" char="." rowspan="1" colspan="1">42.3</td></tr><tr><td rowspan="1" colspan="1">&#x02003;F (59), larynx, T2N0</td><td rowspan="1" colspan="1">Yes (primary)</td><td rowspan="1" colspan="1">II</td><td align="char" char="(" rowspan="1" colspan="1">14 (5 &#x000d7; 9)</td><td align="char" char="." rowspan="1" colspan="1">0.86</td><td align="char" char="." rowspan="1" colspan="1">1.07</td><td align="char" char="." rowspan="1" colspan="1">44.7</td></tr><tr><td rowspan="2" colspan="1">&#x02003;M (71), hypopharynx, T2N2b</td><td rowspan="2" colspan="1">No</td><td rowspan="1" colspan="1">III</td><td align="char" char="(" rowspan="1" colspan="1">13 (4 &#x000d7; 9)</td><td align="char" char="." rowspan="1" colspan="1">0.40</td><td align="char" char="." rowspan="1" colspan="1">1.00</td><td align="char" char="." rowspan="1" colspan="1">54.5</td></tr><tr><td rowspan="1" colspan="1">Va</td><td align="char" char="(" rowspan="1" colspan="1">7 (3 &#x000d7; 4)</td><td align="char" char="." rowspan="1" colspan="1">0.06</td><td align="char" char="." rowspan="1" colspan="1">0.60</td><td align="char" char="." rowspan="1" colspan="1">45.1</td></tr><tr><td rowspan="2" colspan="1">&#x02003;M (72), larynx, T3N0</td><td rowspan="2" colspan="1">Yes (primary)</td><td rowspan="1" colspan="1">II</td><td align="char" char="(" rowspan="1" colspan="1">5 (2 &#x000d7; 3)</td><td align="char" char="." rowspan="1" colspan="1">0.05</td><td align="char" char="." rowspan="1" colspan="1">0.85</td><td align="char" char="." rowspan="1" colspan="1">42.9</td></tr><tr><td rowspan="1" colspan="1">III</td><td align="char" char="(" rowspan="1" colspan="1">12 (5 &#x000d7; 7)</td><td align="char" char="." rowspan="1" colspan="1">0.59</td><td align="char" char="." rowspan="1" colspan="1">1.51</td><td align="char" char="." rowspan="1" colspan="1">57.4</td></tr><tr><td rowspan="1" colspan="1">&#x02003;M (90), oropharynx, T4N1 (HPV&#x02013;)</td><td rowspan="1" colspan="1">Yes (node)</td><td rowspan="1" colspan="1">IV</td><td align="char" char="(" rowspan="1" colspan="1">11 (4 &#x000d7; 7)</td><td align="char" char="." rowspan="1" colspan="1">0.32</td><td align="char" char="." rowspan="1" colspan="1">0.88</td><td align="char" char="." rowspan="1" colspan="1">43.1</td></tr></tbody></table><table-wrap-foot><fn fn-type="abbr"><p>Abbreviations: F, female; FDG-PET, fluorodeoxyglucose positron emission tomography; GTV, gross tumor volume; HPV, human papilloma virus; M, Male.</p></fn><fn id="tblfn4" fn-type="other"><label>
<sup>a</sup>
</label><p>The exact sites of the recurrences were reconstructed and projected on the initial radiation treatment plan and planning PET/computed tomography scan by performing rigid coregistration with diagnostic imaging of the recurrence. Pretreatment characteristics of the electively irradiated nodes that were identified at the exact site of recurrence are reported.</p></fn><fn id="tblfn5" fn-type="other"><label>
<sup>b</sup>
</label><p>Occurred synchronously with a second primary oral cancer. The origin of the regional recurrence could not be established as different mutations in the P53 tumor suppressor gene in all three histologic specimen were demonstrated (ie, initial primary tumor, regional recurrence, and second primary oral cancer).</p></fn></table-wrap-foot></table-wrap><p>In the dose reduction group, 63 intermediate-risk LNs were identified in 39 (19.9%) of 196 patients and were mainly located in neck levels II (43/63) and III (14/63). Two patients had recurrence in intermediate-risk LNs. The review of RT treatment plans demonstrated that nodal risk assessment was performed per protocol in 94% (184/196) of patients. Nine LNs were assigned to a lower dose level than should have, but none recurred.</p><p>Exploratory analysis of acute and late toxicity is shown in Table <xref rid="tbl2" ref-type="table">2</xref>. There was less acute dysphagia grade &#x02265;3 (requiring tube feeding) in the dose reduction group (RR, 0.56 [95% CI, 0.32 to 0.98], <italic toggle="yes">P</italic> = .046). Severe late laryngeal toxicity (grade &#x02265;3) occurred significantly more often when treated with 33 fractions (in 5 weeks) compared with 34 fractions (in 5.5 weeks) in patients with laryngeal/hypopharyngeal cancers (HR, 7.9 [95% CI, 1.8 to 35], <italic toggle="yes">P</italic> = .007) with 2-year rates of 12.5% (95% CI, 0% to 25.8%) versus 2.1% (95% CI, 0% to 4.5%).</p><p>Assessments of the PSS-HN were available over a 2-year follow-up for 82.7% (767 of 928 expected) and 81.5% (375 of 460 expected) in the dose reduction and control group. No statistically significant differences between groups were observed for any of the subscales and time points (Fig <xref rid="fig3" ref-type="fig">3</xref>). The EORTC QLQ-C30 and H&#x00026;N35 QoL questionnaires were available over a 2-year follow-up for 88.9% (1,648 of 1,854 expected) and 89.5% (823 of 920 expected) in the dose reduction and control group. The QLQ-H&#x00026;N35 symptom items dry mouth, coughing, and use of nutritional supplements were statistically significant and clinically meaningful better in the dose reduction group at 3 months after treatment (Fig <xref rid="fig4" ref-type="fig">4</xref>). For dry mouth, 46% (80/175) and 60% (51/85) of the patients reported moderate to severe symptoms in the dose reduction and control group (RR, 0.76 [95% CI, 0.60 to 0.97], <italic toggle="yes">P</italic> = .025). For other items and scales, no clinically meaningful differences between groups were observed over time (Data Supplement).</p><fig position="float" id="fig3" fig-type="figure"><label>FIG 3.</label><caption><p>Functional performance outcomes (PSS-HN). PSS-HN, Performance Status Scale for Head and Neck.</p></caption><graphic xlink:href="jco-43-2583-g003" position="float"/></fig><fig position="float" id="fig4" fig-type="figure"><label>FIG 4.</label><caption><p>Quality of life outcomes (EORTC QLQ-H&#x00026;N35). EORTC, European Organisation for Research and Treatment of Cancer.</p></caption><graphic xlink:href="jco-43-2583-g004" position="float"/></fig></sec><sec sec-type="discussion"><title>DISCUSSION</title><p>In this randomized trial, the clinical benefit and safety of definitive RT with reduced versus standard elective dose in patients with laryngeal and pharyngeal cancers were investigated. Treatment with reduced elective dose was demonstrated to be safe but did not improve the normalcy of diet. Exploratory analyses demonstrate less acute dysphagia grade &#x02265;3 and better xerostomia-related QoL.</p><p>Strengths of the current study are high-quality treatment planning with standardized dose fractionation, minimized interobserver variability using a standardized risk assessment algorithm to guide nodal dose prescription, and excellent compliance with the study protocol including QoL data collection. Participants were accrued in only five centers, minimizing the risk for overly restrictive recruitment and thus selection bias.<sup><xref rid="b22" ref-type="bibr">22</xref></sup> Although the majority of current dose de-escalation studies are restricted to HPV-associated oropharyngeal cancers, the current study included laryngeal and pharyngeal cancers irrespective of HPV status. The rationale for dose de-escalation was not based on higher radiosensitivity of HPV-associated cancers but on decreased nodal tumor volume as a consequence of improved detection with modern diagnostic imaging.<sup><xref rid="b3" ref-type="bibr">3</xref>,<xref rid="b4" ref-type="bibr">4</xref></sup> Therefore, this trial addresses a different fundamental question with respect to the validity of dose de-escalation and is applicable to a wider population.</p><p>Albeit no improvement in normalcy of diet was observed, nearly 90% of the participants had unrestricted full diet at 1- and 2-year follow-up, leaving virtually no possibility for improvement. In a recent randomized trial evaluating dysphagia-optimized (C)RT in 112 patients with mainly stage III to IV oropharyngeal cancers, unrestricted full diet was seen in 70% and 50% of the patients at 2-year follow-up in the interventional and control group.<sup><xref rid="b23" ref-type="bibr">23</xref></sup> In the subgroup of patients with stage III to IV disease in the current trial, this was 85%. In the Netherlands, head and neck cancer care is centralized in 14 hospitals only. High priority is given to xerostomia- and dysphagia-optimized dose planning. Recurring nationwide dose planning exercises with benchmarking of normal tissue dose are performed to improve plans and to reduce variation between centers and may have contributed to the excellent outcomes in this trial.<sup><xref rid="b24" ref-type="bibr">24</xref></sup></p><p>The most important finding in this trial is that treatment with reduced elective dose is safe. The prescribed dose was de-escalated from 50 Gy to 43 Gy. When corrected for fraction dose and overall treatment time, the isoeffective dose in 2 Gy fractions (EQD2) was de-escalated from &#x000b1;44 Gy to &#x000b1;34 Gy. One other randomized trial from Belgium investigated the safety of reduced elective dose (EQD2 50 <italic toggle="yes">v</italic> 40 Gy) in 200 patients receiving definitive (C)RT for head and neck SCC.<sup><xref rid="b25" ref-type="bibr">25</xref></sup> With a median follow-up of 7.6 years, recurrence in electively irradiated LNs occurred in four patients (two per group). A remarkable finding is that the vast majority of these recurrences occurred synchronously with recurrence in the GTV. In the current trial this was 77% (10/13), in the Belgian trial 50% (2/4), and in another study 78% (7/9).<sup><xref rid="b25" ref-type="bibr">25</xref>,<xref rid="b26" ref-type="bibr">26</xref></sup> Similar results were found in retrospective studies.<sup><xref rid="b14" ref-type="bibr">14</xref>,<xref rid="b19" ref-type="bibr">19</xref></sup> It raises the question whether occult metastasis was already present at the time of initial treatment or whether these LNs became secondarily metastasized. If the latter is true, the failure rate of ENI is even lower and should therefore be considered as a worst-case scenario.<sup><xref rid="b14" ref-type="bibr">14</xref>,<xref rid="b19" ref-type="bibr">19</xref></sup></p><p>It should be noted that in the current study 64% of the population had stage III to IV disease while all were treated with accelerated RT alone. In the Netherlands, concomitant chemotherapy is more restricted than in some other countries. Following European consensus guidelines, accelerated RT alone is a valid option for T3N0-1 laryngeal cancers (23% of study population), and patients age &#x02265;70 years do not qualify for concurrent chemotherapy (40% of study population).<sup><xref rid="b1" ref-type="bibr">1</xref></sup> Nevertheless, the 2-year overall survival rate was 82% (95% CI, 77% to 86%) which is excellent in such population. The results of this trial do not directly apply to patients receiving standard 7-week course chemoradiation because this was an RT-only study. However, it can be argued that the radiosensitizing effect of chemotherapy is also effective for subclinical disease and thus might allow a lower radiation dose with chemoradiation as well.<sup><xref rid="b27" ref-type="bibr">27</xref></sup> This is backed by the results of the previously mentioned Belgian study, where 68% of the study population received concurrent chemotherapy for locally advanced disease.<sup><xref rid="b25" ref-type="bibr">25</xref>,<xref rid="b26" ref-type="bibr">26</xref></sup></p><p>In conclusion, this is the second randomized trial demonstrating that reduced elective dose is safe in definitive RT for oropharyngeal, laryngeal, and hypopharyngeal SCC.</p></sec></body><back><fn-group content-type="disclaimer"><title>DISCLAIMER</title><fn specific-use="disclaimer" fn-type="other"><p>The funder had no role in the study design, data collection, data analysis, data interpretation or writing of the manuscripts.</p></fn></fn-group><fn-group content-type="presented-at"><title>PRIOR PRESENTATION</title><fn specific-use="presented-at" fn-type="presented-at"><p>Presented at the European Society for Radiotherapy and Oncology Annual Meeting, Vienna, Austria, May 12-16, 2023; at the European Society for Radiotherapy and Oncology Annual Meeting, Glasgow, United Kingdom, May 3-7, 2024.</p></fn></fn-group><fn-group content-type="supported-by"><title>SUPPORT</title><fn specific-use="supported-by" fn-type="supported-by"><p>Supported by the Dutch Cancer Society (KWF) under grant number KUN 2015-7714.</p></fn></fn-group><fn-group content-type="trial"><title>CLINICAL TRIAL INFORMATION</title><fn specific-use="trial" fn-type="other"><p><ext-link xlink:href="https://www.clinicaltrials.gov/ct2/show/NCT02442375" ext-link-type="uri">NCT02442375</ext-link> (UPGRADE-RT)</p></fn></fn-group><sec sec-type="data-availability"><title>DATA SHARING STATEMENT</title><p>A data sharing statement provided by the authors is available with this article at DOI <ext-link xlink:href="https://ascopubs.org/doi/full/10.1200/JCO-24-02194" ext-link-type="uri">https://doi.org/10.1200/JCO-24-02194</ext-link>.</p></sec><sec sec-type="contributed"><title>AUTHOR CONTRIBUTIONS</title><p><bold>Conception and design:</bold> Sven van den Bosch, Patricia A.H. Doornaert, Tim Dijkema, Johannes H.A.M. Kaanders</p><p><bold>Administrative support:</bold> Bas Kreike</p><p><bold>Provision of study materials or patients:</bold> Patricia A.H. Doornaert, Frank J.P. Hoebers, Bas Kreike, Marije R. Vergeer, Ellen M. Zwijnenburg, Tim Dijkema, Johannes H.A.M. Kaanders</p><p><bold>Collection and assembly of data:</bold> Sven van den Bosch, Patricia A.H. Doornaert, Frank J.P. Hoebers, Bas Kreike, Ellen M. Zwijnenburg, Maurice C. Cox, Gerjon Hannink, Tim Dijkema, Johannes H.A.M. Kaanders</p><p><bold>Data analysis and interpretation:</bold> Sven van den Bosch, Marije R. Vergeer, Maurice C. Cox, Gerjon Hannink, Johannes H.A.M. Kaanders</p><p><bold>Manuscript writing:</bold> All authors</p><p><bold>Final approval of manuscript:</bold> All authors</p><p><bold>Accountable for all aspects of the work:</bold> All authors</p></sec><sec sec-type="COI-statement"><title>AUTHORS' DISCLOSURES OF POTENTIAL CONFLICTS OF INTEREST</title><sec><title>Clinical Benefit and Safety of Reduced Elective Dose in Definitive Radiotherapy for Head and Neck Squamous Cell Carcinoma: The UPGRADE-RT Multicenter Randomized Controlled Trial</title><p>The following represents disclosure information provided by authors of this manuscript. All relationships are considered compensated unless otherwise noted. Relationships are self-held unless noted. I = Immediate Family Member, Inst = My Institution. Relationships may not relate to the subject matter of this manuscript. For more information about ASCO's conflict of interest policy, please refer to <ext-link xlink:href="http://www.asco.org/rwc" ext-link-type="uri">www.asco.org/rwc</ext-link> or <ext-link xlink:href="https://ascopubs.org/jco/authors/author-center" ext-link-type="uri">ascopubs.org/jco/authors/author-center</ext-link>.</p><p>Open Payments is a public database containing information reported by companies about payments made to US-licensed physicians (<ext-link xlink:href="https://openpaymentsdata.cms.gov/" ext-link-type="uri">Open Payments</ext-link>).</p><p>No potential conflicts of interest were reported.</p></sec></sec><ref-list><title>REFERENCES</title><ref id="b1"><label>1.</label><mixed-citation publication-type="journal">
